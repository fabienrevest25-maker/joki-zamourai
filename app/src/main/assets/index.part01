<!doctype html>
<html lang="fr"><head><meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover,user-scalable=no">
<title>Jōki Zamurai</title>
<link rel="preconnect" href="https://fonts.googleapis.com"><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Kaisei+Decol:wght@400;500;700&family=Cinzel:wght@600&display=swap" rel="stylesheet" media="print" onload="this.media='all'">
<link rel="stylesheet" href="fonts/kaisei/400.css"><link rel="stylesheet" href="fonts/kaisei/500.css"><link rel="stylesheet" href="fonts/kaisei/700.css"><link rel="stylesheet" href="fonts/cinzel/600.css">
<style>.apk #kDemon{display:none!important}html,body{overscroll-behavior:none;-webkit-user-select:none;user-select:none;-webkit-touch-callout:none}</style>
<script>
/* Pont Android : reconnaissance vocale native, bouton Retour */
(function(){
 if(!window.AndroidTTS)return;document.documentElement.classList.add('apk');
 if(window.AndroidSTT&&!window.SpeechRecognition&&!window.webkitSpeechRecognition){
  var cur=null;
  function SR(){this.lang='ja-JP';this.maxAlternatives=1;this.interimResults=false;this.onresult=null;this.onerror=null;this.onend=null}
  SR.prototype.start=function(){cur=this;AndroidSTT.start(this.lang||'ja-JP')};
  SR.prototype.stop=function(){AndroidSTT.stop()};
  SR.prototype.abort=function(){var s=this;AndroidSTT.abort();if(cur===s){cur=null;if(s.onend)s.onend()}};
  window.__stt=function(kind,arg){var s=cur;if(!s)return;
   if(kind==='result'&&s.onresult){var alts=(arg||[]).map(function(t){return{transcript:t,confidence:0}});s.onresult({results:[alts]})}
   else if(kind==='error'&&s.onerror)s.onerror({error:arg});
   else if(kind==='end'){cur=null;if(s.onend)s.onend()}};
  window.SpeechRecognition=SR}
 window.__androidBack=function(){try{
   if(typeof UI!=='undefined'&&UI.cur==='menu'){document.getElementById('mClose').click();return true}
   if(typeof Input!=='undefined'&&Input.onB){Input.onB();return true}
  }catch(e){}return false};
})();
</script>
<style>:root{--u:1.6px;--ink:#1c2038;--navy:#20283c;--navy2:#2c3652;--paper:#f8f4e4;--line:#39415f;--red:#d84a4a;--teal:#2fa8b8;--gold:#e8b848;--green:#48b060;--mut:#8a90a8;
 --px:'DotGothic16','Hiragino Kaku Gothic ProN','Yu Gothic','Noto Sans JP','Meiryo',system-ui,sans-serif}
*{box-sizing:border-box;-webkit-tap-highlight-color:transparent}
html,body{margin:0;height:100%;background:#0c0f18;color:var(--paper);font-family:var(--px);overscroll-behavior:none}
body{display:flex;justify-content:center;user-select:none;-webkit-user-select:none;touch-action:manipulation}
button{font:inherit;color:inherit;cursor:pointer;border:0;background:none;padding:0}
.hidden{display:none!important}
#app{position:relative;width:100%;max-width:520px;height:100vh;height:100dvh;display:flex;flex-direction:column;background:var(--navy);overflow:hidden}
#top{flex:none;background:#000;display:flex;justify-content:center;border-bottom:calc(2*var(--u)) solid #10131f}
#scrw{position:relative;width:calc(240*var(--u));height:calc(192*var(--u));overflow:hidden;background:#000}
#scr{position:absolute;inset:0;width:100%;height:100%;image-rendering:pixelated;image-rendering:crisp-edges;touch-action:none}
#scr{image-rendering:pixelated}
/* ---- boîtes façon GBA ---- */
.gbox{background:#f8f8f0;color:#283040;border:calc(2*var(--u)) solid #5868a0;border-radius:calc(5*var(--u));box-shadow:inset 0 0 0 calc(1*var(--u)) #a8b8e0,0 calc(1*var(--u)) 0 calc(1*var(--u)) #283048}
#dlg{position:absolute;left:calc(3*var(--u));right:calc(3*var(--u));bottom:calc(3*var(--u));height:calc(50*var(--u));padding:calc(5*var(--u)) calc(8*var(--u));font-size:calc(10.5*var(--u));line-height:1.32;z-index:26}
#dlg.jp #dlgT{font-size:calc(13*var(--u));line-height:1.75;padding-top:calc(3*var(--u))}
#dlgT rt{font-size:calc(6*var(--u));color:#6070a8}
#dlgN{position:absolute;left:calc(6*var(--u));top:calc(-11*var(--u));background:#5868a0;color:#fff;font-size:calc(8*var(--u));padding:calc(1*var(--u)) calc(6*var(--u));border-radius:calc(3*var(--u)) calc(3*var(--u)) 0 0}
#dlgN:empty{display:none}
#dlgA{position:absolute;right:calc(6*var(--u));bottom:calc(2*var(--u));font-style:normal;color:#d84a4a;font-size:calc(9*var(--u));animation:bob .6s steps(2) infinite}
#dlg.typing #dlgA,#dlg.noarr #dlgA{visibility:hidden}
@keyframes bob{50%{transform:translateY(calc(2*var(--u)))}}
#choice{position:absolute;right:calc(3*var(--u));bottom:calc(56*var(--u));min-width:calc(70*var(--u));padding:calc(4*var(--u)) calc(6*var(--u));z-index:27;display:flex;flex-direction:column;gap:calc(2*var(--u))}
#choice button{font-size:calc(10*var(--u));text-align:left;padding:calc(2*var(--u)) calc(4*var(--u)) calc(2*var(--u)) calc(11*var(--u));position:relative;color:#283040}
#choice button:before{content:'▶';position:absolute;left:0;font-size:calc(8*var(--u));top:calc(3*var(--u));color:#d84a4a;opacity:0}
#choice button.on:before,#choice button:active:before{opacity:1}
#banner{position:absolute;left:0;top:calc(8*var(--u));padding:calc(3*var(--u)) calc(12*var(--u)) calc(3*var(--u)) calc(8*var(--u));background:#f8f8f0;color:#283040;border:calc(2*var(--u)) solid #5868a0;border-left:0;border-radius:0 calc(6*var(--u)) calc(6*var(--u)) 0;z-index:4;transform:translateX(-110%);transition:transform .35s steps(8)}
#banner.on{transform:none}
#banner b{display:block;font-size:calc(12*var(--u));font-weight:400;line-height:1.7}#banner rt{font-size:calc(5.5*var(--u));color:#6070a8}
#banner span{display:block;font-size:calc(7.5*var(--u));color:#5868a0}
#fade{position:absolute;inset:0;background:#000;opacity:0;pointer-events:none;z-index:20;transition:opacity .22s linear}
#fade.w{background:#fff}
.hpb{position:absolute;z-index:5;padding:calc(3*var(--u)) calc(6*var(--u));font-size:calc(8*var(--u));width:calc(112*var(--u))}
#hpE{left:calc(4*var(--u));top:calc(8*var(--u));border-radius:calc(3*var(--u)) calc(3*var(--u)) calc(3*var(--u)) calc(12*var(--u))}
#hpM{right:calc(4*var(--u));top:calc(86*var(--u));border-radius:calc(3*var(--u)) calc(12*var(--u)) calc(3*var(--u)) calc(3*var(--u))}
.hpb .nm{display:flex;justify-content:space-between;gap:calc(4*var(--u));white-space:nowrap}
.hpb .nm b{font-weight:400;overflow:hidden;text-overflow:ellipsis}.hpb .nm i{font-style:normal;color:#5868a0;flex:none}
.hpb .sub{font-size:calc(6.5*var(--u));color:#6070a8;line-height:1.5;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.hpb .sub rt{display:none}
.hpl{display:flex;align-items:center;gap:calc(3*var(--u));margin-top:calc(2*var(--u))}
.hpl em{font-style:normal;font-size:calc(6.5*var(--u));color:#e8a020;font-weight:700}
.hpt{flex:1;height:calc(5*var(--u));background:#404860;border:calc(1*var(--u)) solid #283040;border-radius:calc(3*var(--u));overflow:hidden}
.hpt i{display:block;height:100%;background:#48c868;width:100%}
.hpt i.mid{background:#e8c030}.hpt i.low{background:#e04838}
.hpn{text-align:right;font-size:calc(7.5*var(--u));margin-top:calc(1*var(--u))}
.xpt{height:calc(3*var(--u));background:#404860;margin-top:calc(2*var(--u));border-radius:calc(2*var(--u));overflow:hidden}.xpt i{display:block;height:100%;background:#48a8e8;width:0}
#board{position:absolute;left:calc(74*var(--u));top:calc(22*var(--u));width:calc(150*var(--u));height:calc(84*var(--u));z-index:3;color:#f4fff4;display:flex;flex-direction:column;align-items:center;justify-content:center;text-align:center;padding:calc(4*var(--u))}
#board b{font-weight:400;font-size:calc(13*var(--u));line-height:1.35}#board span{font-size:calc(7.5*var(--u));color:#b8e8c0;margin-top:calc(4*var(--u))}
#board.sm b{font-size:calc(9.5*var(--u))}
#board.b3 b{font-size:calc(10.5*var(--u))}#board.b3.sm b{font-size:calc(8*var(--u))}#board.b3 span{font-size:calc(6.5*var(--u))}
#board.b2{left:calc(96*var(--u));top:calc(41*var(--u));width:calc(136*var(--u));height:calc(68*var(--u))}#board.b2 b{font-size:calc(11.5*var(--u))}#board.b2.sm b{font-size:calc(8.5*var(--u))}
#tit{position:absolute;inset:0;z-index:3;display:flex;flex-direction:column;align-items:center;text-align:center;color:#fff;pointer-events:none}
#tit .jp{font-size:calc(34*var(--u));margin-top:calc(26*var(--u));letter-spacing:calc(4*var(--u));color:#fff;text-shadow:calc(2*var(--u)) calc(2*var(--u)) 0 #1c2450,calc(-1*var(--u)) calc(-1*var(--u)) 0 #1c2450,calc(1*var(--u)) calc(-1*var(--u)) 0 #1c2450,calc(-1*var(--u)) calc(1*var(--u)) 0 #1c2450}
#tit .en{font-size:calc(11*var(--u));letter-spacing:calc(3*var(--u));color:#f8e070;text-shadow:calc(1*var(--u)) calc(1*var(--u)) 0 #1c2450}
#tit .ps{margin-top:auto;margin-bottom:calc(14*var(--u));font-size:calc(9*var(--u));text-shadow:calc(1*var(--u)) calc(1*var(--u)) 0 #1c2450;animation:blink 1s steps(2) infinite}
@keyframes blink{50%{opacity:0}}
/* ---- écran du bas ---- */
#bot{flex:1;min-height:0;position:relative;background:linear-gradient(#262f48,#1b2236)}
.pan{position:absolute;inset:0;display:flex;flex-direction:column;padding:10px 12px calc(10px + env(safe-area-inset-bottom,0px));gap:8px;overflow:hidden}
.card{background:var(--paper);color:var(--ink);border:3px solid var(--line);border-radius:10px;box-shadow:0 3px 0 #10131f;padding:10px 12px}
.btn{background:var(--paper);color:var(--ink);border:3px solid var(--line);border-radius:10px;box-shadow:0 3px 0 #10131f;padding:10px 12px;font-size:17px;min-height:48px;text-align:center}
.btn:active{transform:translateY(2px);box-shadow:0 1px 0 #10131f}
.btn.pri{background:var(--gold);border-color:#7a5a18}.btn.red{background:var(--red);color:#fff;border-color:#7a2020}.btn.dark{background:var(--navy2);color:var(--paper);border-color:#4a5578}
.btn:disabled,.btn.off{opacity:.45}
.btn small{display:block;font-size:12px;opacity:.75;margin-top:1px}
rt{font-size:.5em;color:#5868a0;font-weight:400}
/* manette */
.stat{display:flex;gap:10px;align-items:center}
.stat img{width:52px;height:52px;border-radius:8px;border:3px solid var(--line);object-fit:cover;object-position:50% 16%;background:#000;flex:none}
.stat .in{flex:1;min-width:0;font-size:14px}.stat .in b{font-weight:400}.stat .in span{color:var(--gold);margin-left:6px}
.bar{height:9px;background:#141a2a;border:2px solid #454f72;border-radius:6px;overflow:hidden;margin-top:3px}.bar i{display:block;height:100%;width:50%;background:var(--green);transition:width .3s}.bar.xp{height:6px}.bar.xp i{background:#48a8e8}
.stat small{font-size:11px;color:var(--mut)}
#obj{font-size:13px;color:#cdd3e8;background:#161c2e;border:2px solid #39415f;border-radius:8px;padding:6px 10px;line-height:1.3}
#obj b{color:var(--gold);font-weight:400}
.pad{flex:1;display:flex;align-items:center;justify-content:space-between;min-height:0;padding:0 4px}
.dpad{display:grid;grid-template:repeat(3,minmax(40px,58px))/repeat(3,minmax(40px,58px));touch-action:none}
.dpad button{background:#3a4566;border:3px solid #141a2a;color:#cdd3e8;font-size:20px;touch-action:none}
.dpad button.on,.ab button.on{background:#5a6a9a;transform:translateY(1px)}
.dpad .u{grid-area:1/2;border-radius:12px 12px 0 0;border-bottom:0}.dpad .d{grid-area:3/2;border-radius:0 0 12px 12px;border-top:0}.dpad .l{grid-area:2/1;border-radius:12px 0 0 12px;border-right:0}.dpad .r{grid-area:2/3;border-radius:0 12px 12px 0;border-left:0}
.dpad .c{grid-area:2/2;background:#3a4566;border:0}
.ab{display:grid;grid-template:auto auto/auto auto;gap:6px 10px;align-items:center}
.ab button{width:66px;height:66px;border-radius:50%;border:3px solid #141a2a;font-size:24px;color:#fff;box-shadow:0 4px 0 #10131f;touch-action:none}
.ab .a{background:var(--red);grid-area:1/2}.ab .b{background:#4a78c8;grid-area:2/1;margin-top:-22px}
.ab small{grid-area:2/2;font-size:11px;color:var(--mut);text-align:center;line-height:1.2}
.padf{display:flex;gap:8px;justify-content:center}.padf button{font-size:12px;letter-spacing:1px;background:#3a4566;border:2px solid #141a2a;border-radius:14px;padding:6px 18px;color:#cdd3e8}
/* dialogue : fiche d'étude */
#study{display:flex;flex-direction:column;gap:4px;min-height:0;overflow:auto}
#study .jp{font-size:26px;line-height:1.9}#study .kana{font-size:15px;color:#5868a0}#study .ro{font-size:13px;color:#8a90a8;font-style:italic}#study .fr{font-size:17px;margin-top:4px}
#study .x{font-size:13px;color:#5868a0;border-top:2px dashed #c8c0a8;margin-top:6px;padding-top:6px}
#study .new{align-self:flex-start;font-size:11px;background:var(--teal);color:#fff;border-radius:6px;padding:1px 7px}
.spk{width:48px;height:48px;border-radius:50%;background:var(--teal);border:3px solid #156a78;color:#fff;font-size:20px;box-shadow:0 3px 0 #10131f;flex:none}
.row{display:flex;gap:8px;align-items:center}.grow{flex:1;min-height:0}
#study,#dCh{display:none}
#pPad.jpl .stat,#pPad.jpl #obj,#pPad.jpl .padf{display:none}#pPad.jpl #study{display:flex;flex:none;max-height:46%}
#pPad.ask .pad,#pPad.ask .padf{display:none}#pPad.ask #dCh{display:flex;flex-direction:column;gap:8px;margin-top:auto;margin-bottom:auto}
#pPad.wait .ab .a{animation:pulse .7s steps(2) infinite}
@keyframes pulse{50%{filter:brightness(1.35)}}
/* combat */
.cmd{display:grid;grid-template-columns:1fr 1fr;gap:8px}
.cmd .btn{font-size:22px;padding:12px 6px;min-height:74px}.cmd .btn small{font-size:12px}
.cmd .c1{background:#f0a868;border-color:#8a4a18}.cmd .c2{background:#78c8e0;border-color:#1c5a78}.cmd .c3{background:#98d878;border-color:#2a6a2a}.cmd .c4{background:#c8c8d8;border-color:#5a5a70}
#bInfo{font-size:13px;color:#cdd3e8;line-height:1.35;min-height:34px}
#bInfo b{color:var(--gold);font-weight:400}
.list{display:grid;grid-template-columns:1fr 1fr;gap:8px;overflow:auto;min-height:0;align-content:start}
.sp{display:flex;align-items:center;gap:8px;text-align:left;padding:8px 10px}
.sp .k{font-size:32px;line-height:1;width:36px;text-align:center}.sp .d{font-size:12px;line-height:1.25;min-width:0}.sp .d b{display:block;font-size:14px;font-weight:400}
.sp i{font-style:normal;color:#c89018}.sp.lock{opacity:.4}
.ty{display:inline-block;font-size:10px;color:#fff;border-radius:5px;padding:0 5px;margin-right:4px}
/* tracé */
.thead{display:flex;align-items:center;gap:10px}.thead .k{font-size:38px;line-height:1}.thead .i{flex:1;font-size:13px;line-height:1.3;color:#cdd3e8}.thead .i b{font-size:16px;color:var(--paper);font-weight:400}
.prog{display:flex;gap:4px}.prog i{width:12px;height:6px;border-radius:3px;background:#454f72}.prog i.on{background:var(--teal)}.prog i.cur{background:var(--gold)}
.boardw{flex:1;min-height:0;display:flex;align-items:center;justify-content:center}
#cv{background:#f8f4e4;border:4px solid var(--line);border-radius:12px;touch-action:none;box-shadow:0 3px 0 #10131f}
#tMsg{text-align:center;font-size:14px;min-height:20px;color:#cdd3e8}
/* exercices */
.exq{font-size:15px;color:#cdd3e8;line-height:1.3}.exq b{color:var(--gold);font-weight:400}
.exjp{font-size:24px;line-height:2;text-align:center;min-height:56px}
.exfr{font-size:19px;text-align:center}
.slots{min-height:58px;border-bottom:3px dashed #8a90a8;display:flex;flex-wrap:wrap;gap:6px;padding:6px 2px;align-items:flex-end}
.tiles{display:flex;flex-wrap:wrap;gap:8px;justify-content:center}
.tile{background:var(--paper);color:var(--ink);border:3px solid var(--line);border-radius:9px;box-shadow:0 3px 0 #10131f;padding:5px 11px;font-size:21px;line-height:1.75;min-width:44px;text-align:center}
.tile.used{visibility:hidden}
.opts{display:grid;gap:8px}.opts.two{grid-template-columns:1fr 1fr}
.opts .btn{font-size:19px;line-height:1.5}.opts .btn.txt{font-size:15px;line-height:1.3}
.opts .btn.big{font-size:34px;line-height:1.3}
.opts .btn.txt.jpo{font-size:18px;line-height:1.5}
.btn.ok{background:#8fe0a0;border-color:#1c6a30}.btn.ko{background:#f0a0a0;border-color:#7a2020}
.fb{border-radius:10px;padding:8px 12px;font-size:14px;line-height:1.35}.fb.ok{background:#1c4a30;border:2px solid #48b060}.fb.ko{background:#4a1c24;border:2px solid #d84a4a}
.fb b{font-weight:400;font-size:16px}.fb .jp{font-size:19px;line-height:1.9;display:block}
.timer{height:8px;background:#141a2a;border:2px solid #454f72;border-radius:6px;overflow:hidden}.timer i{display:block;height:100%;background:var(--gold);width:100%}
/* leçon */
.lh{display:flex;align-items:center;gap:8px;font-size:13px;color:#cdd3e8}.lh .dots{display:flex;gap:4px;margin-left:auto}.lh .dots i{width:16px;height:6px;border-radius:3px;background:#454f72}.lh .dots i.on{background:var(--gold)}
.lcard{flex:1;min-height:0;overflow:auto}.lcard h3{margin:0 0 4px;font-size:19px;font-weight:400;color:#a83030}
.lcard .f{font-size:21px;background:#283048;color:#f4fff4;border-radius:8px;padding:6px 10px;text-align:center;margin:6px 0;line-height:1.5}
.lcard p{margin:6px 0;font-size:15px;line-height:1.45;font-family:system-ui,'Noto Sans JP',sans-serif}.lcard p b{color:#a83030}
.exl{display:flex;gap:8px;align-items:center;border-top:2px dashed #c8c0a8;padding:6px 0}.exl .t{flex:1}.exl .jp{font-size:20px;line-height:1.9}.exl .fr{font-size:14px;color:#4a5578}.exl .ro{font-size:12px;color:#8a90a8;font-style:italic}
.exl .spk{width:40px;height:40px;font-size:16px}
/* menu */
.tabs{display:flex;gap:4px}.tabs button{flex:1;font-size:13px;padding:8px 2px;background:#2c3652;border:2px solid #454f72;border-bottom:0;border-radius:8px 8px 0 0;color:#aab2cc;line-height:1.2}
.tabs button.on{background:var(--paper);color:var(--ink);border-color:var(--line)}
.mbody{flex:1;min-height:0;overflow:auto;background:var(--paper);color:var(--ink);border:3px solid var(--line);border-radius:0 0 10px 10px;margin-top:-8px;padding:8px 10px}
.mi{display:flex;gap:10px;align-items:center;padding:8px 0;border-bottom:2px dashed #c8c0a8}.mi:last-child{border:0}
.mi .k{font-size:34px;width:44px;text-align:center;line-height:1}.mi .t{flex:1;min-width:0;font-size:13px;line-height:1.35}.mi .t b{font-size:16px;font-weight:400;display:block}
.mi img{width:64px;height:64px;object-fit:contain;background:#283048;border-radius:8px;flex:none}
.mi .jp{font-size:19px;line-height:1.9}
.mi .go{font-size:13px;background:var(--gold);border:2px solid #7a5a18;border-radius:8px;padding:6px 10px;white-space:nowrap}
.mi.lock{opacity:.45}
.sw{display:flex;justify-content:space-between;align-items:center;padding:10px 0;border-bottom:2px dashed #c8c0a8;font-size:15px}
.sw button{min-width:64px;background:#2c3652;color:#fff;border-radius:8px;padding:6px 10px;border:2px solid #10131f}.sw button.on{background:var(--green)}
/* titre */
#pTitle{justify-content:flex-end}
#pTitle .cov{flex:1;min-height:0;border:3px solid var(--line);border-radius:10px;background-size:cover;background-position:88% 30%;box-shadow:0 3px 0 #10131f}
#pTitle p{margin:0;font-size:12px;color:var(--mut);text-align:center}
/* évolution */
.evo{flex:1;min-height:0;display:flex;align-items:center;justify-content:center;gap:10px}.evo img{height:100%;max-height:260px;max-width:44%;object-fit:cover;object-position:50% 12%;border:3px solid var(--line);border-radius:10px}
.evo span{font-size:28px;color:var(--gold)}
#toast{position:absolute;left:50%;top:calc(196*var(--u));transform:translateX(-50%);background:#10131f;color:#fff;border:2px solid var(--gold);border-radius:10px;padding:8px 14px;font-size:14px;z-index:60;max-width:90%;text-align:center;pointer-events:none}
@media (prefers-reduced-motion:reduce){#dlgA,#tit .ps{animation:none}}

/* ================= thème D : laiton et vapeur ================= */
:root{--px:'Kaisei Decol','Hiragino Mincho ProN','Yu Mincho','Noto Serif JP',serif;--paper:#1d2540;--ink:#f2ead6;--line:#c08a3e;--brass:#c08a3e;--brass2:#e0b062;--cy:#58e0ec;--sub:#9ab0c8}
body{font-weight:500}
rt,#dlgT rt,#banner rt{color:var(--cy)}
.gbox{background:linear-gradient(#1d2540,#12182c);color:#f2ead6;border:calc(2*var(--u)) solid var(--brass);border-radius:calc(3*var(--u));box-shadow:inset 0 0 0 calc(1*var(--u)) #6a4a20,0 0 0 calc(1*var(--u)) #2a1c0c,0 calc(2*var(--u)) calc(5*var(--u)) rgba(0,0,0,.5)}
#dlg:before,#dlg:after{content:'';position:absolute;top:calc(2*var(--u));width:calc(3*var(--u));height:calc(3*var(--u));border-radius:50%;background:radial-gradient(#f6d58a,#8a5a20)}
#dlg:before{left:calc(2*var(--u))}#dlg:after{right:calc(2*var(--u))}
#dlgN{top:calc(-12*var(--u));background:linear-gradient(#e0b062,#a87430);color:#1a1208;font-weight:700;border:calc(1*var(--u)) solid #2a1c0c;border-radius:calc(2*var(--u))}
#dlgA{color:var(--cy);text-shadow:0 0 calc(4*var(--u)) var(--cy)}
#choice button{color:#f2ead6}#choice button:before{color:var(--cy)}
#banner{background:linear-gradient(#1d2540,#12182c);color:#f2ead6;border-color:var(--brass)}#banner span{color:var(--sub)}
.hpb .nm i,.hpb .sub{color:var(--sub)}.hpl em{color:var(--brass2)}
#hpE,#hpM{border-radius:calc(3*var(--u))}
.card,.btn,.tile,.mbody{background:linear-gradient(#222b48,#1a2138);color:var(--ink);border-color:var(--brass);box-shadow:inset 0 0 0 1px #6a4a20,0 3px 0 #0a0d18}
.btn.pri,.mi .go{background:linear-gradient(#e0b062,#a87430);color:#1a1208;border-color:#6a4a20;font-weight:700}
.btn.dark{background:#141a2c;border-color:#4a5578;color:#cdd3e8;box-shadow:0 3px 0 #0a0d18}
.btn.ok{background:#1c5a34;color:#eafff0;border-color:#48b060}.btn.ko{background:#6a1c24;color:#ffecec;border-color:#d84a4a}
.cmd .btn{color:#1a1208;box-shadow:0 3px 0 #0a0d18}
.cmd .c1{background:#f0a868;border-color:#8a4a18}.cmd .c2{background:#78c8e0;border-color:#1c5a78}.cmd .c3{background:#98d878;border-color:#2a6a2a}.cmd .c4{background:#c8c8d8;border-color:#5a5a70}
.tabs button.on{background:#222b48;color:var(--ink);border-color:var(--brass)}
#study .kana,#study .x,#study .ro,.exl .fr,.exl .ro{color:var(--sub)}
#study .x,.exl,.mi,.sw{border-color:#3a4566}
.lcard h3{color:var(--brass2)}.lcard p{font-family:var(--px)}.lcard p b{color:var(--cy)}.lcard .f{background:#0e1322;border:1px solid #6a4a20;color:var(--cy)}
.exfr.card{color:var(--ink)}
.sw button{border-color:#0a0d18}
.qt{align-self:flex-start;font-size:12px;color:#cdd3e8;background:#141a2c;border:2px solid #4a5578;border-radius:8px;padding:4px 10px;flex:none}
.lh .qt{margin-right:4px}
#cv{border-color:var(--brass)}
html,body{color:#eef0f8}.thead .i b,.stat .in b{color:#eef0f8}

/* discussion avec le démon */
.clist{flex:1;min-height:0;overflow:auto;display:flex;flex-direction:column;gap:8px;padding:2px}
.msg{max-width:88%;border-radius:12px;padding:8px 10px;font-size:14px;line-height:1.4}
.msg.d{align-self:flex-start;background:linear-gradient(#2a2248,#1c1834);border:2px solid #8a58c8;color:#f2ead6}
.msg.me{align-self:flex-end;background:#243248;border:2px solid #4a5578;color:#eef0f8}
.msg .jp{font-size:19px;line-height:1.9}.msg .fr{color:var(--sub);font-size:13px}.msg .fr.hid{filter:blur(5px);cursor:pointer}
.msg .fix{margin-top:6px;padding-top:6px;border-top:1px dashed #6a5a98;font-size:13px;color:#ffd9a0}.msg .nw{font-size:12px;color:var(--cy);margin-top:4px}
.msg .act{display:flex;gap:6px;margin-top:6px}.msg .act button{font-size:12px;border:1px solid #6a5a98;border-radius:8px;padding:3px 8px;color:#d8ccf4;background:#1a1630}
.msg.sys{align-self:center;color:var(--sub);font-size:13px;text-align:center;border:0;background:none}
.chips{display:flex;flex-direction:column;gap:5px}.chips button{text-align:left;font-size:15px;line-height:1.7;border:2px solid #4a5578;border-radius:10px;padding:3px 10px;background:#141a2c;color:#eef0f8}
.chips button small{color:var(--sub);font-size:12px;margin-left:6px}
#cIn{flex:1;min-width:0;font:inherit;font-size:16px;padding:10px;border-radius:10px;border:2px solid var(--brass);background:#0e1322;color:#f2ead6}
#cSend{min-width:64px}
.padf #kDemon{background:#3a2a5c;border-color:#8a58c8;color:#e8dcff}

/* ================= plein écran : commandes en surimpression ================= */
#top{flex:1;min-height:0;border:0}
#scrw{width:100%;height:100%}
#scr{height:auto;inset:0 auto auto 0;width:100%}
#bot{position:absolute;inset:0;background:none;pointer-events:none;z-index:10}
.pan{top:calc(192*var(--u));pointer-events:auto;background:linear-gradient(#262f48,#1b2236);border-top:calc(2*var(--u)) solid #10131f}
#pTrace{top:0;border:0}
#pPad{top:0;background:none;border:0;pointer-events:none;padding:calc(8px + env(safe-area-inset-top,0px)) 10px calc(14px + env(safe-area-inset-bottom,0px))}
#pPad>*{pointer-events:auto}
#pPad .hud{position:absolute;left:8px;top:calc(8px + env(safe-area-inset-top,0px));width:min(60%,250px);display:flex;flex-direction:column;gap:4px;background:rgba(14,18,34,.62);border:1px solid rgba(192,138,62,.6);border-radius:10px;padding:6px 8px;pointer-events:none}
#pPad .stat{gap:7px}#pPad .stat img{width:34px;height:34px;border-width:2px}#pPad .stat .in{font-size:12px}
#pPad #obj{background:none;border:0;padding:0;font-size:11px;line-height:1.25}
#pPad .padf{position:absolute;right:8px;top:calc(8px + env(safe-area-inset-top,0px));display:flex;flex-direction:column;gap:6px;align-items:stretch}
#pPad .padf button{background:rgba(58,69,102,.72);padding:7px 12px}
#pPad .padf #kDemon{background:rgba(58,42,92,.78)}
#pPad .pad{position:absolute;left:12px;right:12px;bottom:calc(18px + env(safe-area-inset-bottom,0px));flex:none;opacity:.5;pointer-events:none;align-items:flex-end}
#pPad .pad>*{pointer-events:auto}
#pPad .dpad{grid-template:repeat(3,54px)/repeat(3,54px)}
#pPad .ab{grid-template:auto auto/auto auto;gap:4px 12px}
#pPad.wait .pad,#pPad.ask .pad,#pPad.wait .padf,#pPad.ask .padf,#pPad.wait .hud,#pPad.ask .hud{display:none}
#pPad.jpl .stat,#pPad.jpl #obj{display:flex}#pPad.jpl #obj{display:block}
#pPad #study{position:absolute;left:10px;right:10px;bottom:calc(60*var(--u) + 6px);max-height:42%;display:none}
#pPad.jpl #study{display:flex}
#pPad #dCh{position:absolute;left:10px;right:10px;bottom:calc(60*var(--u) + 6px);display:none;flex-direction:column;gap:8px;margin:0}
#pPad.ask #dCh{display:flex}#pPad.ask #study{display:none}
#choice{display:none}
#app.sheet #dlg{top:calc(139*var(--u));bottom:auto}
#dlg{bottom:calc(4*var(--u) + env(safe-area-inset-bottom,0px))}
#banner{top:calc(58*var(--u))}
#app.sheet #banner{display:none}
#toast{top:40%}
/* tracé : grande feuille */
#pTrace{padding-top:calc(12px + env(safe-area-inset-top,0px));background:linear-gradient(#20283e,#141a2c)}
#pTrace .thead .k{font-size:54px}
#banner{top:calc(92*var(--u))}
#pPad .stat .in{font-size:13px}#pPad #obj{font-size:12px}

/* ================= combat illustré ================= */
#bscene{position:absolute;left:0;right:0;top:0;height:calc(var(--bh)*var(--u));overflow:hidden;z-index:2;background:#000}
#bscene .bg{position:absolute;inset:-4%;width:108%;height:108%;object-fit:cover;object-position:50% 60%;animation:bgdrift 14s ease-in-out infinite alternate;filter:brightness(.82)}
#bscene .bg.boss{object-position:50% 22%;filter:none;animation:bossb 5s ease-in-out infinite}
#bscene .bg.night{filter:brightness(.42) saturate(.6) hue-rotate(200deg)}
@keyframes bgdrift{from{transform:scale(1) translateX(-1.5%)}to{transform:scale(1.06) translateX(1.5%)}}
@keyframes bossb{50%{transform:scale(1.035) translateY(-1%)}}
#bscene .en{position:absolute;right:4%;bottom:calc(30*var(--u));height:74%;max-width:62%;object-fit:contain;object-position:50% 100%;filter:drop-shadow(0 calc(4*var(--u)) calc(3*var(--u)) rgba(0,0,0,.55));animation:idle 3.2s ease-in-out infinite;transition:transform .65s cubic-bezier(.2,.9,.3,1),opacity .4s}
#bscene .en.px{image-rendering:pixelated;height:46%;right:14%;bottom:calc(60*var(--u))}
#bscene .en.in{transform:translateX(130%);animation:none}
#bscene .me{position:absolute;left:-2%;bottom:calc(44*var(--u));height:52%;object-fit:contain;filter:drop-shadow(0 calc(3*var(--u)) calc(2*var(--u)) rgba(0,0,0,.6));transform:scaleX(-1);transition:transform .65s cubic-bezier(.2,.9,.3,1)}
#bscene .me.in{transform:scaleX(-1) translateX(130%)}
@keyframes idle{50%{transform:translateY(-2.5%) rotate(-.6deg)}}
#bscene .en.hit,#bscene .bg.hit{animation:ehit .55s}
@keyframes ehit{0%,100%{filter:none}15%{filter:brightness(4) saturate(0);transform:translateX(4%)}35%{transform:translateX(-4%)}50%{filter:brightness(1.8) sepia(1) hue-rotate(-40deg) saturate(4)}65%{transform:translateX(2.5%)}}
#bscene .en.atk{animation:eatk .45s}#bscene .bg.atk{animation:batk .45s}
@keyframes eatk{40%{transform:translate(-22%,8%) scale(1.22)}}
@keyframes batk{40%{transform:scale(1.18)}}
#bscene .en.dead,#bscene .bg.dead{animation:edead 1s forwards}
@keyframes edead{30%{filter:brightness(3) saturate(0)}100%{filter:grayscale(1) brightness(.3);transform:translateY(22%) scale(.9);opacity:0}}
#bscene .bg.dead{animation:bdead 1.2s forwards}
@keyframes bdead{30%{filter:brightness(3) saturate(0)}100%{filter:grayscale(1) brightness(.25)}}
#bscene .me.atk{animation:matk .4s}
@keyframes matk{45%{transform:scaleX(-1) translate(-14%,-6%) scale(1.08)}}
#bscene .me.hit{animation:mhit .55s}
@keyframes mhit{0%,100%{filter:none}20%{filter:brightness(1.6) sepia(1) hue-rotate(-50deg) saturate(5);transform:scaleX(-1) translateX(5%)}45%{transform:scaleX(-1) translateX(-4%)}70%{transform:scaleX(-1) translateX(2%)}}
#bscene .me.dead{animation:mdead .7s forwards}
@keyframes mdead{100%{transform:scaleX(-1) translateY(40%) rotate(14deg);filter:grayscale(1) brightness(.4);opacity:.2}}
#bscene .cut{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;object-position:50% 38%;opacity:0;pointer-events:none}
#bscene .cut.go{animation:cut 1.3s ease-out}
@keyframes cut{0%{opacity:0;transform:scale(1.35)}12%{opacity:1}80%{opacity:1;transform:scale(1.02)}100%{opacity:0;transform:scale(1)}}
#bscene .kj{position:absolute;left:6%;top:6%;font-size:calc(70*var(--u));line-height:1;opacity:0;text-shadow:0 0 calc(6*var(--u)) #fff,calc(2*var(--u)) calc(2*var(--u)) 0 #000;pointer-events:none}
#bscene .kj.go{animation:kj 1.3s ease-out}
@keyframes kj{0%{opacity:0;transform:scale(2.6) rotate(-14deg)}18%{opacity:1;transform:scale(1) rotate(-6deg)}80%{opacity:1}100%{opacity:0;transform:scale(1.15) rotate(-6deg)}}
#bscene .fl{position:absolute;inset:0;background:#fff;opacity:0;pointer-events:none}#bscene .fl.go{animation:fl .5s}
@keyframes fl{15%{opacity:.9}100%{opacity:0}}
#app.battle .pan{top:calc(var(--bh)*var(--u))}#app.battle #pTrace{top:0}
#app.battle #dlg{top:calc((var(--bh) - 53)*var(--u))}
#app.battle #hpM{top:calc((var(--bh) - 98)*var(--u))}
@media (prefers-reduced-motion:reduce){#bscene .bg,#bscene .en{animation:none}}
/* ================= démon : grande zone de lecture ================= */
#pChat{top:0;border:0;padding-top:calc(10px + env(safe-area-inset-top,0px));background:linear-gradient(#1a1430,#120e24)}
#pChat .lh img{width:40px;height:44px;image-rendering:pixelated;flex:none}
.msg{max-width:96%;font-size:15px;padding:10px 12px}
.msg .jp{font-size:25px;line-height:2}
.msg .kn{font-size:17px;color:#d8ccf4;line-height:1.6}.msg .ro{font-size:15px;color:#9ad8e0;font-style:italic;line-height:1.5}
.msg .fr{font-size:15px;margin-top:4px}.msg .fix{font-size:14px}.msg .nw{font-size:13px}
.msg.me{font-size:18px}
.msg .act button{font-size:13px;padding:5px 10px}
.chips{flex-direction:row;overflow-x:auto;gap:6px;flex:none;padding-bottom:2px;scrollbar-width:none}
.chips::-webkit-scrollbar{display:none}
.chips button{flex:none;white-space:nowrap;font-size:14px;line-height:1.4;padding:5px 10px;display:flex;flex-direction:column;align-items:flex-start}
.chips button rt{display:none}.chips button small{margin:0;font-size:11px}
.chips button{display:block;text-align:left}.chips button small{display:block}

#dlgP{display:none;position:absolute;left:calc(-2*var(--u));bottom:calc(100% + 2*var(--u));width:calc(46*var(--u));height:calc(46*var(--u));object-fit:cover;border:calc(2*var(--u)) solid var(--brass);border-radius:calc(3*var(--u));box-shadow:0 0 0 calc(1*var(--u)) #2a1c0c;image-rendering:pixelated;background:#12182c}
#dlg.hasp #dlgP{display:block}#dlg.hasp #dlgN{left:calc(50*var(--u))}
#pPad .stat img{image-rendering:pixelated;object-position:50% 30%}
#app.hasp #pPad #study,#app.hasp #pPad #dCh{bottom:calc(110*var(--u) + 6px)}

.cmd .c5{grid-column:1/3;min-height:0;padding:7px 6px;font-size:19px;background:#d8b4ec;border-color:#5a2a78}
.cmd .btn{min-height:64px;padding:8px 6px}
.lis{display:flex;gap:8px}.lis .btn{flex:1;font-size:18px;padding:12px 6px}.lis.card{padding:10px}
#spZone{display:flex;flex-direction:column}

#scr{filter:saturate(.88)}

#pPad .hud{width:min(60%,245px);padding:5px 7px;gap:3px}
#pPad #obj{pointer-events:auto;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;padding-right:2px;cursor:pointer}
#pPad #obj:not(.open) br{display:none}
#pPad #obj::before{content:'▸ ';color:var(--gold)}
#pPad #obj.open{white-space:normal;overflow:visible}#pPad #obj.open::before{content:'▾ '}

#pChat.hd{background-color:#07070f;background-size:cover,cover;background-position:top center;background-repeat:no-repeat}
#pChat.hd .lh img{width:38px;height:38px;object-fit:cover;object-position:50% 30%;border-radius:50%;border:2px solid #8a58c8;background:#120e24}
#cStage{flex:none;height:min(23vh,168px);display:flex;align-items:flex-end;justify-content:center;position:relative;pointer-events:none}
#cFace{height:100%;image-rendering:pixelated;filter:drop-shadow(0 0 14px rgba(150,100,230,.55));animation:kfloat 4.5s ease-in-out infinite}
#cFace.pop{animation:kpop .28s ease-out,kfloat 4.5s ease-in-out .28s infinite}
@keyframes kfloat{0%,100%{transform:translateY(0)}50%{transform:translateY(-5px)}}
@keyframes kpop{0%{transform:scale(.93)}60%{transform:scale(1.04)}100%{transform:scale(1)}}
#cStage i{display:none;position:absolute;bottom:6px;width:7px;height:7px;border-radius:50%;background:#e8dcff;animation:kdot 1s infinite}
#cStage.think i{display:block}#cStage i:nth-of-type(1){left:calc(50% + 62px)}#cStage i:nth-of-type(2){left:calc(50% + 76px);animation-delay:.18s}#cStage i:nth-of-type(3){left:calc(50% + 90px);animation-delay:.36s}
@keyframes kdot{0%,100%{opacity:.25;transform:translateY(0)}40%{opacity:1;transform:translateY(-5px)}}
#pChat.hd .msg.d{background:rgba(26,22,48,.86)}#pChat.hd .msg.sys{background:rgba(10,10,22,.6)}
@media (prefers-reduced-motion:reduce){#cFace,#cFace.pop,#cStage i{animation:none}}
#pChat.hd .lh img,#pChat.hd .lh>span{display:none}

#bscene .en.hd{image-rendering:pixelated;height:50%;right:9%;bottom:calc(46*var(--u));max-width:50%}
#bscene .me.hd{image-rendering:pixelated;height:46%;left:7%;bottom:calc(30*var(--u));transform:none}
#bscene .me.hd.in{transform:translateX(-160%)}
#bscene .kj{left:0;right:0;top:14%;text-align:center;font-size:calc(96*var(--u))}
.evo img{image-rendering:pixelated;object-fit:contain}
#bscene .me.hd.atk{animation:matk2 .4s}@keyframes matk2{45%{transform:translate(16%,-7%) scale(1.08)}}
#bscene .me.hd.hit{animation:mhit2 .55s}@keyframes mhit2{0%,100%{filter:none}20%{filter:brightness(1.6) sepia(1) hue-rotate(-50deg) saturate(5);transform:translateX(-5%)}45%{transform:translateX(4%)}70%{transform:translateX(-2%)}}
#bscene .me.hd.dead{animation:mdead2 .7s forwards}@keyframes mdead2{100%{transform:translateY(40%) rotate(-14deg);filter:grayscale(1) brightness(.4);opacity:.2}}

#bscene .bg{object-position:50% 70%;filter:brightness(.9)}
#bscene .en.hd{height:42%;right:10%;bottom:calc(70*var(--u))}
#bscene .en.hd.big{height:58%;right:0;bottom:calc(64*var(--u));max-width:64%}
#bscene .me.hd{height:44%;left:6%;bottom:calc(26*var(--u))}
#bscene .en.hd{height:35%;right:11%;bottom:calc(103*var(--u))}
#bscene .en.hd.big{height:47%;right:1%;bottom:calc(100*var(--u));max-width:62%}
#bscene .me.hd{height:38%;left:7%;bottom:calc(56*var(--u))}
#bscene .bg{object-position:50% 55%}

#tit{background-size:cover;background-position:38% 50%;image-rendering:pixelated}
#tit .ring{position:relative;display:grid;place-items:center;margin-top:calc(2*var(--u));image-rendering:auto}
#tit .ring svg{position:absolute;width:calc(60*var(--u));height:calc(60*var(--u));opacity:.9;animation:tspin 40s linear infinite}
#tit .jp{position:relative;margin-top:0;font-weight:700;font-size:calc(33*var(--u));line-height:1.85;letter-spacing:.14em;margin-right:-.14em;color:#fff;text-shadow:0 0 calc(3*var(--u)) #fff,0 0 calc(9*var(--u)) #ffd9a0,0 calc(1.2*var(--u)) 0 #5a3418}
#tit .en{font-family:'Cinzel','Times New Roman',serif;font-weight:600;font-size:calc(8*var(--u));letter-spacing:.7em;margin-right:-.7em;color:#fff;text-shadow:0 calc(.8*var(--u)) 0 #5a3418,0 0 calc(5*var(--u)) rgba(90,52,24,.8);margin-top:calc(-5*var(--u));border-top:calc(.8*var(--u)) solid #fff;padding-top:calc(3*var(--u));image-rendering:auto}
#pTitle .cov{display:none}#pTitle{justify-content:center}
@keyframes tspin{to{transform:rotate(360deg)}}
@media (prefers-reduced-motion:reduce){#tit .ring svg{animation:none}}
#tit{background-size:100% auto;background-position:top center;background-repeat:no-repeat;background-color:#1c2238}
#tit .ps{display:none}
#pTitle{justify-content:flex-start;padding-top:calc(6*var(--u))}

#tit{background-size:100% 100%,100% auto;background-position:top center,center top;background-repeat:no-repeat}
#tit .ring{margin-top:calc(6*var(--u))}
#pTitle{top:58%;background:none;border:0;box-shadow:none;justify-content:flex-end;padding-top:0;padding-bottom:calc(22px + env(safe-area-inset-bottom,0px))}

#bscene .en.hd.mini{height:27%;right:15%}

#tit .ring svg{opacity:.85;filter:drop-shadow(0 0 calc(3*var(--u)) #58e0ec)}
#tit .jp{text-shadow:0 0 calc(2*var(--u)) #fff,0 0 calc(7*var(--u)) #58e0ec,0 0 calc(15*var(--u)) rgba(88,224,236,.75),0 calc(1.2*var(--u)) 0 #0e4458;animation:tglow 3.6s ease-in-out infinite}
#tit .en{border-top-color:#9af4fa;text-shadow:0 calc(.8*var(--u)) 0 #0e4458,0 0 calc(5*var(--u)) rgba(88,224,236,.9)}
@keyframes tglow{50%{text-shadow:0 0 calc(3*var(--u)) #fff,0 0 calc(11*var(--u)) #58e0ec,0 0 calc(24*var(--u)) rgba(88,224,236,.95),0 calc(1.2*var(--u)) 0 #0e4458}}
@media (prefers-reduced-motion:reduce){#tit .jp{animation:none}}
#tBw{background:#0c1226}

/* ----- menu de combat : roue de kanji steampunk ----- */
#pBat{--q:min(1vw,.5vh)}
#bCmd.cmd{display:block;position:relative;width:calc(86*var(--q));height:calc(74*var(--q));margin:auto;isolation:isolate;background:url("data:image/svg+xml,%3Csvg%20xmlns%3D%22http%3A//www.w3.org/2000/svg%22%20viewBox%3D%220%200%2086%2074%22%3E%3Cline%20x1%3D%2243%22%20y1%3D%2237%22%20x2%3D%2213.5%22%20y2%3D%2213.5%22%20stroke%3D%22%234a2c10%22%20stroke-width%3D%224.4%22/%3E%3Cline%20x1%3D%2243%22%20y1%3D%2237%22%20x2%3D%2213.5%22%20y2%3D%2213.5%22%20stroke%3D%22%23a8743a%22%20stroke-width%3D%223%22/%3E%3Cline%20x1%3D%2243%22%20y1%3D%2237%22%20x2%3D%2213.5%22%20y2%3D%2213.5%22%20stroke%3D%22%23e9c476%22%20stroke-width%3D%22.8%22/%3E%3Cline%20x1%3D%2243%22%20y1%3D%2237%22%20x2%3D%2272.5%22%20y2%3D%2213.5%22%20stroke%3D%22%234a2c10%22%20stroke-width%3D%224.4%22/%3E%3Cline%20x1%3D%2243%22%20y1%3D%2237%22%20x2%3D%2272.5%22%20y2%3D%2213.5%22%20stroke%3D%22%23a8743a%22%20stroke-width%3D%223%22/%3E%3Cline%20x1%3D%2243%22%20y1%3D%2237%22%20x2%3D%2272.5%22%20y2%3D%2213.5%22%20stroke%3D%22%23e9c476%22%20stroke-width%3D%22.8%22/%3E%3Cline%20x1%3D%2243%22%20y1%3D%2237%22%20x2%3D%2213.5%22%20y2%3D%2260.5%22%20stroke%3D%22%234a2c10%22%20stroke-width%3D%224.4%22/%3E%3Cline%20x1%3D%2243%22%20y1%3D%2237%22%20x2%3D%2213.5%22%20y2%3D%2260.5%22%20stroke%3D%22%23a8743a%22%20stroke-width%3D%223%22/%3E%3Cline%20x1%3D%2243%22%20y1%3D%2237%22%20x2%3D%2213.5%22%20y2%3D%2260.5%22%20stroke%3D%22%23e9c476%22%20stroke-width%3D%22.8%22/%3E%3Cline%20x1%3D%2243%22%20y1%3D%2237%22%20x2%3D%2272.5%22%20y2%3D%2260.5%22%20stroke%3D%22%234a2c10%22%20stroke-width%3D%224.4%22/%3E%3Cline%20x1%3D%2243%22%20y1%3D%2237%22%20x2%3D%2272.5%22%20y2%3D%2260.5%22%20stroke%3D%22%23a8743a%22%20stroke-width%3D%223%22/%3E%3Cline%20x1%3D%2243%22%20y1%3D%2237%22%20x2%3D%2272.5%22%20y2%3D%2260.5%22%20stroke%3D%22%23e9c476%22%20stroke-width%3D%22.8%22/%3E%3Ccircle%20cx%3D%2228.25%22%20cy%3D%2225.25%22%20r%3D%223.2%22%20fill%3D%22%23b8813a%22%20stroke%3D%22%234a2c10%22%20stroke-width%3D%221%22/%3E%3Ccircle%20cx%3D%2228.25%22%20cy%3D%2225.25%22%20r%3D%221%22%20fill%3D%22%23ffe9b0%22/%3E%3Ccircle%20cx%3D%2257.75%22%20cy%3D%2225.25%22%20r%3D%223.2%22%20fill%3D%22%23b8813a%22%20stroke%3D%22%234a2c10%22%20stroke-width%3D%221%22/%3E%3Ccircle%20cx%3D%2257.75%22%20cy%3D%2225.25%22%20r%3D%221%22%20fill%3D%22%23ffe9b0%22/%3E%3Ccircle%20cx%3D%2228.25%22%20cy%3D%2248.75%22%20r%3D%223.2%22%20fill%3D%22%23b8813a%22%20stroke%3D%22%234a2c10%22%20stroke-width%3D%221%22/%3E%3Ccircle%20cx%3D%2228.25%22%20cy%3D%2248.75%22%20r%3D%221%22%20fill%3D%22%23ffe9b0%22/%3E%3Ccircle%20cx%3D%2257.75%22%20cy%3D%2248.75%22%20r%3D%223.2%22%20fill%3D%22%23b8813a%22%20stroke%3D%22%234a2c10%22%20stroke-width%3D%221%22/%3E%3Ccircle%20cx%3D%2257.75%22%20cy%3D%2248.75%22%20r%3D%221%22%20fill%3D%22%23ffe9b0%22/%3E%3C/svg%3E") center/100% 100% no-repeat}
#bCmd.cmd.hidden{display:none}
#bCmd.cmd .btn{position:absolute;width:calc(27*var(--q));height:calc(27*var(--q));min-height:0;padding:0;border:0;border-radius:50%;background:none;box-shadow:none;isolation:isolate;display:flex;flex-direction:column;align-items:center;justify-content:center;font-size:calc(7.4*var(--q));line-height:1.1;color:var(--c);text-shadow:0 0 calc(2*var(--q)) var(--c),0 calc(.4*var(--q)) 0 #000;grid-column:auto}
#bCmd.cmd .btn small{font-size:calc(2.7*var(--q));line-height:1.25;color:#c9cfe6;text-shadow:none;margin-top:calc(.4*var(--q))}
#bCmd.cmd .btn::before{content:'';position:absolute;inset:-9%;z-index:-2;background:url("data:image/svg+xml,%3Csvg%20xmlns%3D%22http%3A//www.w3.org/2000/svg%22%20viewBox%3D%22-52%20-52%20104%20104%22%3E%3Cg%20fill%3D%22%23b8813a%22%20stroke%3D%22%234a2c10%22%20stroke-width%3D%222%22%3E%3Crect%20x%3D%22-6.5%22%20y%3D%22-50%22%20width%3D%2213%22%20height%3D%2214%22%20rx%3D%221.5%22%20transform%3D%22rotate%280%29%22/%3E%3Crect%20x%3D%22-6.5%22%20y%3D%22-50%22%20width%3D%2213%22%20height%3D%2214%22%20rx%3D%221.5%22%20transform%3D%22rotate%2830%29%22/%3E%3Crect%20x%3D%22-6.5%22%20y%3D%22-50%22%20width%3D%2213%22%20height%3D%2214%22%20rx%3D%221.5%22%20transform%3D%22rotate%2860%29%22/%3E%3Crect%20x%3D%22-6.5%22%20y%3D%22-50%22%20width%3D%2213%22%20height%3D%2214%22%20rx%3D%221.5%22%20transform%3D%22rotate%2890%29%22/%3E%3Crect%20x%3D%22-6.5%22%20y%3D%22-50%22%20width%3D%2213%22%20height%3D%2214%22%20rx%3D%221.5%22%20transform%3D%22rotate%28120%29%22/%3E%3Crect%20x%3D%22-6.5%22%20y%3D%22-50%22%20width%3D%2213%22%20height%3D%2214%22%20rx%3D%221.5%22%20transform%3D%22rotate%28150%29%22/%3E%3Crect%20x%3D%22-6.5%22%20y%3D%22-50%22%20width%3D%2213%22%20height%3D%2214%22%20rx%3D%221.5%22%20transform%3D%22rotate%28180%29%22/%3E%3Crect%20x%3D%22-6.5%22%20y%3D%22-50%22%20width%3D%2213%22%20height%3D%2214%22%20rx%3D%221.5%22%20transform%3D%22rotate%28210%29%22/%3E%3Crect%20x%3D%22-6.5%22%20y%3D%22-50%22%20width%3D%2213%22%20height%3D%2214%22%20rx%3D%221.5%22%20transform%3D%22rotate%28240%29%22/%3E%3Crect%20x%3D%22-6.5%22%20y%3D%22-50%22%20width%3D%2213%22%20height%3D%2214%22%20rx%3D%221.5%22%20transform%3D%22rotate%28270%29%22/%3E%3Crect%20x%3D%22-6.5%22%20y%3D%22-50%22%20width%3D%2213%22%20height%3D%2214%22%20rx%3D%221.5%22%20transform%3D%22rotate%28300%29%22/%3E%3Crect%20x%3D%22-6.5%22%20y%3D%22-50%22%20width%3D%2213%22%20height%3D%2214%22%20rx%3D%221.5%22%20transform%3D%22rotate%28330%29%22/%3E%3Ccircle%20r%3D%2240%22/%3E%3C/g%3E%3Ccircle%20r%3D%2240%22%20fill%3D%22none%22%20stroke%3D%22%23e9c476%22%20stroke-width%3D%221.5%22/%3E%3C/svg%3E") center/contain no-repeat;animation:gspin 18s linear infinite;filter:drop-shadow(0 calc(1*var(--q)) 0 #0a0d18)}
#bCmd.cmd .btn::after{content:'';position:absolute;inset:7%;z-index:-1;border-radius:50%;background:radial-gradient(circle at 35% 28%,#34406c,#141a2e 70%);border:calc(.7*var(--q)) solid var(--c);box-shadow:inset 0 0 0 calc(.5*var(--q)) #0a0d18,inset 0 0 calc(4*var(--q)) rgba(0,0,0,.6),0 0 calc(3*var(--q)) -1px var(--c)}
#bCmd.cmd .c1{--c:#ffb070;left:50%;top:50%;width:calc(35*var(--q));height:calc(35*var(--q));margin:calc(-17.5*var(--q)) 0 0 calc(-17.5*var(--q));font-size:calc(13*var(--q))}
#bCmd.cmd .c1::before{animation-duration:26s;animation-direction:reverse}
#bCmd.cmd .c2{--c:#7ad4ec;left:0;top:0}#bCmd.cmd .c3{--c:#a4e484;right:0;top:0}#bCmd.cmd .c4{--c:#d4d4e4;left:0;bottom:0;font-size:calc(6*var(--q))}#bCmd.cmd .c5{--c:#e0bcf4;right:0;bottom:0}
#bCmd.cmd .c3::before,#bCmd.cmd .c4::before{animation-direction:reverse}
#bCmd.cmd .btn:active::after{background:radial-gradient(circle at 35% 28%,#4a5a92,#1c2440 70%)}
#bCmd.cmd .btn.off{opacity:.45}
@keyframes gspin{to{transform:rotate(360deg)}}
@media (prefers-reduced-motion:reduce){#bCmd.cmd .btn::before{animation:none}}

img.ic{height:1.15em;width:auto;vertical-align:-.22em;image-rendering:pixelated;border:0!important;border-radius:0!important;background:none!important}img.ic.big{height:34px;width:auto;vertical-align:middle}
#pPad .stat img.ic,.stat img.ic{width:auto;height:1.15em;flex:none;display:inline;object-fit:contain}

#bsFx{position:absolute;inset:0;width:100%;height:100%;image-rendering:pixelated;pointer-events:none;z-index:1}
#bscene .kj,#bscene .fl{z-index:2}

/* --- textes qui dépassaient des cadres --- */
#dlg{height:auto;min-height:calc(50*var(--u));padding-bottom:calc(7*var(--u))}
#dlg.jp #dlgT{font-size:calc(12*var(--u));line-height:1.7}
#app.battle #dlg{top:auto;bottom:calc(100% - (var(--bh) - 3)*var(--u))}
#app.sheet:not(.battle) #dlg{top:auto;bottom:calc(100% - 189*var(--u))}
#app.battle #hpM{top:auto;bottom:calc(100% - (var(--bh) - 56)*var(--u))}
.hpb{padding-bottom:calc(4*var(--u))}
#bscene .bg{inset:0;left:0;top:0;width:100%;height:100%;animation:none;transform:none}
#bscene .bg.hit{animation:bhit .5s}@keyframes bhit{0%,100%{filter:brightness(.9)}15%{filter:brightness(2.2)}}
#bscene .bg.atk{animation:none}#bscene .bg.dead{animation:bdead 1.2s forwards}
.sp{overflow:hidden;padding:7px 8px;gap:7px;min-width:0}
.sp .k{font-size:28px;width:30px;flex:none}
.sp .d{flex:1;min-width:0;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.sp .d b{font-size:13px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.sp .d .ty{font-size:10px}
#bCmd.cmd .btn{font-size:calc(6.6*var(--q))}
#bCmd.cmd .btn small{font-size:calc(2.3*var(--q));line-height:1.2;text-align:center}
#bCmd.cmd .c1{font-size:calc(12*var(--q))}#bCmd.cmd .c1 small{font-size:calc(2.8*var(--q))}
#bCmd.cmd .c4{font-size:calc(5.2*var(--q))}
#bInfo{overflow-wrap:anywhere}

.tabs{flex-wrap:wrap;gap:3px}.tabs button{flex:1 0 22%;border-bottom:2px solid #454f72;border-radius:8px;padding:5px 2px;font-size:13px}
.mbody textarea{box-sizing:border-box}
/* onglets du menu : plaques de laiton rivetées, deux rangées (5 + 4), filet cyan sur l'onglet actif */
#mTabs{display:grid;grid-template-columns:repeat(10,1fr);gap:5px;margin-bottom:8px}
#mTabs button{grid-column:span 2;flex:none;min-width:0;position:relative;display:flex;flex-direction:column;align-items:center;justify-content:center;padding:5px 2px 8px;font-size:17px;line-height:1.1;color:#3a2608;border:1px solid #7a5420;border-radius:4px;background:linear-gradient(180deg,#e2b65a 0%,#c8973a 45%,#a87a2a 100%);box-shadow:inset 0 1px 0 rgba(255,240,190,.7),inset 0 -2px 0 rgba(70,40,5,.45),0 2px 0 #0d1020}

#mTabs button br{display:none}
#mTabs button small{font-size:10px;color:#5a3c10;white-space:nowrap}
#mTabs button::before{content:"";position:absolute;top:3px;left:3px;right:3px;height:3px;background:radial-gradient(circle at 1.5px 1.5px,#6a4612 1.4px,transparent 1.6px) left/3px 3px no-repeat,radial-gradient(circle at 1.5px 1.5px,#6a4612 1.4px,transparent 1.6px) right/3px 3px no-repeat}
#mTabs button::after{content:"";position:absolute;left:24%;right:24%;bottom:3px;height:2px;border-radius:2px;background:#7a5420}
#mTabs button.on{color:#2a1a04;border-color:#f0cf7a;background:linear-gradient(180deg,#fff0b8 0%,#f0cf7a 50%,#d8a848 100%);box-shadow:inset 0 1px 0 #fff,0 2px 0 #0d1020}
#mTabs button.on::after{left:10%;right:10%;height:3px;background:#58e0ec;box-shadow:0 0 8px #58e0ec,0 0 2px #0e4458}

@keyframes jzIdle{0%,100%{translate:0 0}50%{translate:0 -3px}}
#bsEn{animation:jzIdle 2.2s ease-in-out infinite}

@keyframes jzDlg{from{translate:0 12px;opacity:0}to{translate:0 0;opacity:1}}
#dlg:not(.hidden){animation:jzDlg .16s ease-out}
#choice:not(.hidden){animation:jzDlg .18s ease-out}
@keyframes jzShake{0%,100%{translate:0 0}20%{translate:-5px 2px}40%{translate:5px -3px}60%{translate:-4px -2px}80%{translate:3px 2px}}
#bscene:has(#bsFl.go){animation:jzShake .32s}
@keyframes jzPop{0%{scale:.92;opacity:0}100%{scale:1;opacity:1}}
.hpb:not(.hidden){animation:jzPop .25s ease-out}
/* le menu occupe tout l'écran : kanji, carte et jeux y sont plus lisibles */
#pMenu{top:0!important;z-index:40;border-top:0;padding-top:calc(12px + env(safe-area-inset-top,0px))}

/* ---------- fenêtres de réponse ---------- */
#pPad .padf #kRev{background:rgba(20,74,84,.8);border-color:#19b6c9;color:#d8fbff}
.fb{position:relative;border-radius:10px;padding:0;font-size:14px;line-height:1.35;overflow:hidden;transform-origin:50% 0}
.fb .fbh{display:flex;align-items:center;gap:10px;padding:8px 12px}.fb .fbh b{display:block;font-weight:700;font-size:17px;letter-spacing:1px}.fb .fbh span{font-size:13px;opacity:.9}
.fb .fbi{flex:none;width:38px;height:38px;display:flex;align-items:center;justify-content:center;font-style:normal;font-size:22px;font-weight:700;border-radius:50%}
.fb .fbb{padding:6px 12px 9px}.fb .fbb .jp{font-size:19px;line-height:1.9;display:block}
/* 1 · plaque de laiton rivetée, voyant vert ou rouge */
.fb.s1{background:linear-gradient(180deg,#e2b65a,#b88a34 55%,#8a6424);border:2px solid #5a3c10;color:#1c1408;box-shadow:inset 0 1px 0 rgba(255,240,190,.8),0 4px 0 #0a0d18;animation:fbDrop .55s cubic-bezier(.3,1.5,.5,1) both}
.fb.s1::before,.fb.s1::after{content:"";position:absolute;top:5px;width:6px;height:6px;border-radius:50%;background:radial-gradient(circle at 35% 30%,#fff3c0,#6a4612);box-shadow:0 calc(100% + 0px) 0 transparent}.fb.s1::before{left:5px}.fb.s1::after{right:5px}
.fb.s1 .fbh{padding-left:18px}.fb.s1 .fbi{color:#fff;border:2px solid #3a2608;animation:fbGlow 1.1s ease-out both}.fb.s1.ok .fbi{background:radial-gradient(circle at 35% 30%,#b8ffcf,#1f9a4c 60%,#0d5a2a)}.fb.s1.ko .fbi{background:radial-gradient(circle at 35% 30%,#ffc4b8,#c8322a 60%,#6a1410)}
.fb.s1 .fbb{background:#1b2236;color:#e8ecf8;margin:0 6px 6px;border-radius:6px;border:1px solid #3a2608}
/* 2 · papier washi et tampon rouge */
.fb.s2{background:#f4ead0;border:1px solid #c9b88a;color:#2a2018;box-shadow:0 3px 0 #0a0d18,inset 0 0 0 3px #f9f2df;animation:fbFade .25s ease-out both}
.fb.s2 .fbi{width:44px;height:44px;border-radius:8px;border:3px solid currentColor;font-size:25px;background:transparent;transform:rotate(-9deg);animation:fbStamp .45s cubic-bezier(.2,.9,.3,1.25) .08s both}.fb.s2.ok .fbi{color:#c8281e}.fb.s2.ko .fbi{color:#3a4a78;animation:fbStamp .45s cubic-bezier(.2,.9,.3,1.25) .08s both,fbShake .4s .5s}
.fb.s2 .fbb{border-top:1px dashed #c9b88a}
/* 3 · manomètre à vapeur : l'aiguille file dans le vert ou retombe dans le rouge */
.fb.s3{background:linear-gradient(180deg,#232c46,#161c30);border:2px solid #a87a2a;color:#e8ecf8;box-shadow:0 3px 0 #0a0d18;animation:fbSlide .4s cubic-bezier(.2,.9,.3,1.1) both}
.fb.s3 .fbi{width:46px;height:46px;position:relative;border:3px solid #c8973a;background:conic-gradient(from 225deg,#c8322a 0 90deg,#d8a030 90deg 180deg,#2aa85a 180deg 270deg,#1b2236 270deg);box-shadow:inset 0 0 0 9px #f4ead0}
.fb.s3 .fbi u{position:absolute;left:50%;bottom:50%;width:3px;height:17px;margin-left:-1.5px;background:#1b1418;border-radius:2px;transform-origin:50% 100%;text-decoration:none}.fb.s3 .fbi::after{content:"";position:absolute;left:50%;top:50%;width:8px;height:8px;margin:-4px;border-radius:50%;background:#c8973a}
.fb.s3.ok .fbi u{animation:fbNeedleOk .9s cubic-bezier(.3,1.6,.5,1) both}.fb.s3.ko .fbi u{animation:fbNeedleKo .9s cubic-bezier(.3,1.6,.5,1) both}.fb.s3.ok{border-color:#48b060}.fb.s3.ko{border-color:#d84a4a}
.fb.s3 .fbb{border-top:1px solid rgba(200,151,58,.4)}
/* 4 · rouleau qui se déroule */
.fb.s4{background:linear-gradient(180deg,#efe3c2,#f7efd8 12%,#f7efd8 88%,#e5d6ac);color:#2a2018;border-left:1px solid #c9b88a;border-right:1px solid #c9b88a;border-radius:3px;overflow:visible;margin:7px 0;animation:fbUnroll .5s cubic-bezier(.2,.8,.3,1) both}
.fb.s4::before,.fb.s4::after{content:"";position:absolute;left:-6px;right:-6px;height:8px;border-radius:4px;background:linear-gradient(180deg,#8a5a30,#4a2c14);box-shadow:0 2px 0 rgba(0,0,0,.35)}.fb.s4::before{top:-6px}.fb.s4::after{bottom:-6px}
.fb.s4 .fbi{width:42px;height:42px;font-size:27px;border-radius:0;font-family:serif;animation:fbInk .6s .25s both}.fb.s4.ok .fbi{color:#b07a10}.fb.s4.ko .fbi{color:#3a4a78}
.fb.s4 .fbh b{border-bottom:3px solid currentColor;border-image:linear-gradient(90deg,currentColor,transparent) 1;padding-bottom:1px}.fb.s4.ok .fbh b{color:#8a5a08}.fb.s4.ko .fbh b{color:#2e3c66}
.fb.s4 .fbb{border-top:1px dashed #c9b88a}
@keyframes fbDrop{0%{transform:translateY(-34px) rotate(-3deg);opacity:0}60%{opacity:1}100%{transform:none;opacity:1}}
@keyframes fbGlow{0%{box-shadow:0 0 0 0 rgba(255,255,255,.9)}100%{box-shadow:0 0 0 16px rgba(255,255,255,0)}}
@keyframes fbFade{from{opacity:0;transform:translateY(8px)}to{opacity:1;transform:none}}
@keyframes fbStamp{0%{transform:scale(2.8) rotate(-24deg);opacity:0}70%{opacity:1}100%{transform:scale(1) rotate(-9deg);opacity:1}}
@keyframes fbShake{0%,100%{margin-left:0}25%{margin-left:-4px}75%{margin-left:4px}}
@keyframes fbSlide{from{transform:translateX(60px);opacity:0}to{transform:none;opacity:1}}
@keyframes fbNeedleOk{0%{transform:rotate(-125deg)}100%{transform:rotate(95deg)}}
@keyframes fbNeedleKo{0%{transform:rotate(20deg)}100%{transform:rotate(-100deg)}}
@keyframes fbUnroll{from{transform:scaleY(.06);opacity:.4}to{transform:none;opacity:1}}
@keyframes fbInk{from{opacity:0;filter:blur(3px);transform:scale(1.5)}to{opacity:1;filter:none;transform:none}}
@media (prefers-reduced-motion:reduce){.fb,.fb *{animation-duration:.01s!important}}
.fb.s2 rt,.fb.s4 rt{color:#8a5a20}
.fb.s2.ok .fbi{color:#1f8a4a}.fb.s2.ko .fbi{color:#c8281e}
.fb .fbh{position:relative}.fb .fbk{margin-left:auto;height:54px;width:auto;margin-top:-4px;margin-bottom:-4px;image-rendering:pixelated;animation:fbFade .35s .2s both}
.fb.s2 .fbi{filter:url(#stampfx);border-width:3.5px;border-radius:7px 9px 6px 10px;font-family:serif;font-weight:900}
.fb.s2 .fbi{font-size:27px;-webkit-text-stroke:1.1px currentColor}

ruby.fx{border-bottom:1.5px dotted #58e0ec;cursor:help}ruby.fx.on{border-bottom-color:transparent}.fb.s2 ruby.fx,.rdt ruby.fx{border-bottom-color:#b07a10}.rdt rt{color:#8a5a20}
#app.tz1 #dlg{font-size:calc(12*var(--u))}#app.tz1 #dlg.jp #dlgT{font-size:calc(14.6*var(--u))}#app.tz1 .mbody,#app.tz1 #pEx,#app.tz1 #pLes{zoom:1.12}
#app.tz2 #dlg{font-size:calc(13.4*var(--u))}#app.tz2 #dlg.jp #dlgT{font-size:calc(16.2*var(--u))}#app.tz2 .mbody,#app.tz2 #pEx,#app.tz2 #pLes{zoom:1.25}

.phfx{position:absolute;left:0;right:0;top:34%;z-index:30;text-align:center;pointer-events:none;white-space:nowrap;font-size:calc(17*var(--u));font-weight:700;color:#fff8dc;text-shadow:0 0 6px #58e0ec,0 0 14px #19b6c9,0 2px 0 #0e4458}
.phfx i{display:inline-block;font-style:normal;opacity:0;animation:phIn .9s cubic-bezier(.2,.8,.2,1) both}
.phfx b{position:absolute;left:0;right:0;top:50%;height:3px;background:linear-gradient(90deg,transparent,#fff,#58e0ec,transparent);transform:scaleX(0);animation:phCut .35s .5s ease-out both}
@keyframes phIn{0%{opacity:0;transform:translate(-90px,14px) scale(.4) rotate(-20deg)}35%{opacity:1;transform:translate(0,0) scale(1.25)}60%{opacity:1;transform:scale(1)}100%{opacity:0;transform:translate(110px,-30px) scale(1.6)}}
@keyframes phCut{0%{transform:scaleX(0);opacity:1}100%{transform:scaleX(1.2);opacity:0}}
.icb{display:inline-flex;align-items:center;justify-content:center;gap:8px}.icb img{width:42px;height:42px;margin:-6px 0;image-rendering:auto}
#dlgVI{position:absolute;left:50%;bottom:calc(60*var(--u) + env(safe-area-inset-bottom,0px));transform:translateX(-50%);width:calc(62*var(--u));height:calc(62*var(--u));object-fit:contain;z-index:27;background:radial-gradient(circle,#f4ead0 0 62%,rgba(244,234,208,0) 70%);border-radius:50%;padding:calc(6*var(--u));image-rendering:auto;animation:fbStamp .4s both;pointer-events:none}
#study .vimg{flex:none;width:calc(54*var(--u));height:calc(54*var(--u));object-fit:contain;margin:0 calc(6*var(--u));align-self:center;background:#f4ead0;border:2px solid var(--brass);border-radius:8px;padding:calc(3*var(--u));animation:fbFade .3s both}

.gp{color:#4fb6e8;border-bottom:2px solid rgba(79,182,232,.5);cursor:help}.gv{color:#f0a040}.glg{font-size:12px;margin:4px 0 6px;display:flex;gap:10px;flex-wrap:wrap;align-items:center}.glg small{opacity:.7}
#lCard .rcp{margin:6px 0 10px;padding-left:18px;line-height:1.7}#lCard .rcp b{color:#c8401f}
#xFb.fb{flex:none;max-height:58%;overflow-y:auto;-webkit-overflow-scrolling:touch}#xBody{min-height:64px}

.brg{position:absolute;inset:0;z-index:80;overflow:hidden;display:flex;align-items:center;justify-content:center;animation:brgShake 3.4s both}
.brg-bg{position:absolute;inset:0;background:radial-gradient(circle at 50% 45%,#5a0c08 0,#1a0606 60%,#000 100%);animation:brgPulse .5s 4 alternate}
.brg-a,.brg-b{position:absolute;top:22%;width:78%;max-width:420px;image-rendering:pixelated}
.brg-a{animation:brgA 1.6s both}.brg-b{opacity:0;animation:brgB 2s 1.5s both}
.brg-f{position:absolute;inset:0;background:#fff;opacity:0;animation:brgF .5s 1.4s both}
.brg-w i{position:absolute;left:50%;top:42%;font-style:normal;font-size:22px;font-weight:700;color:#ffe0a0;text-shadow:0 0 8px #ff5020;opacity:0;animation:brgW 1.4s both}
.brg-t{position:absolute;bottom:16%;left:0;right:0;text-align:center;color:#ffd27a;opacity:0;animation:brgT .6s 2.1s both}.brg-t b{display:block;font-size:34px;letter-spacing:6px;text-shadow:0 0 14px #ff3010,0 3px 0 #000}.brg-t span{font-size:15px;color:#ffe8c8}
@keyframes brgShake{0%,40%{transform:none}42%,52%,62%,72%{transform:translate(-6px,3px)}47%,57%,67%,77%{transform:translate(6px,-3px)}85%,100%{transform:none}}
@keyframes brgPulse{to{filter:brightness(1.6)}}
@keyframes brgA{0%{transform:scale(1);filter:none}30%{transform:translateX(-3px)}35%{transform:translateX(3px)}60%{transform:scale(1.04) translateX(-5px);filter:brightness(1.4) sepia(1) hue-rotate(-30deg) saturate(4)}75%{transform:scale(1.06) translateX(5px);filter:brightness(2) sepia(1) hue-rotate(-30deg) saturate(5)}100%{transform:scale(1.1);filter:brightness(3);opacity:0}}
@keyframes brgF{0%{opacity:0}20%{opacity:1}100%{opacity:0}}
@keyframes brgB{0%{opacity:0;transform:scale(.55)}25%{opacity:1;transform:scale(1.25)}40%{transform:scale(.95)}55%{transform:scale(1.05)}70%,100%{opacity:1;transform:scale(1)}}
@keyframes brgW{0%{opacity:0;transform:translate(-50%,-50%) scale(.3)}15%{opacity:1}100%{opacity:0;transform:translate(calc(-50% + var(--x)),calc(-50% + var(--y))) rotate(var(--r)) scale(1.4)}}
@keyframes brgT{0%{opacity:0;transform:scale(2.2)}60%{opacity:1;transform:scale(.95)}100%{opacity:1;transform:none}}
</style></head><body>
<div id="boot" style="position:fixed;inset:0;z-index:99;display:grid;place-items:center;background:#1c2238;color:#9af4fa;font:18px serif;letter-spacing:.2em">蒸気侍 · chargement…</div>
<div id="app">
 <div id="top"><div id="scrw">
  <canvas id="scr" width="240" height="192"></canvas>
  <div id="bscene" class="hidden"><img class="bg" id="bsBg" alt=""><img class="en" id="bsEn" alt=""><img class="me" id="bsMe" alt=""><img class="cut" id="bsCut" alt=""><canvas id="bsFx"></canvas><div class="kj" id="bsKj"></div><div class="fl" id="bsFl"></div></div>
  <div id="tit" class="hidden"><div class="ring"><svg viewBox="-50 -50 100 100" aria-hidden="true"><g fill="none" stroke="#9af4fa" stroke-width="3"><circle r="30"/><circle r="12"/></g><g fill="#9af4fa"><rect x="-3.5" y="-40" width="7" height="10" transform="rotate(0)"/><rect x="-3.5" y="-40" width="7" height="10" transform="rotate(30)"/><rect x="-3.5" y="-40" width="7" height="10" transform="rotate(60)"/><rect x="-3.5" y="-40" width="7" height="10" transform="rotate(90)"/><rect x="-3.5" y="-40" width="7" height="10" transform="rotate(120)"/><rect x="-3.5" y="-40" width="7" height="10" transform="rotate(150)"/><rect x="-3.5" y="-40" width="7" height="10" transform="rotate(180)"/><rect x="-3.5" y="-40" width="7" height="10" transform="rotate(210)"/><rect x="-3.5" y="-40" width="7" height="10" transform="rotate(240)"/><rect x="-3.5" y="-40" width="7" height="10" transform="rotate(270)"/><rect x="-3.5" y="-40" width="7" height="10" transform="rotate(300)"/><rect x="-3.5" y="-40" width="7" height="10" transform="rotate(330)"/></g></svg><div class="jp">蒸気侍</div></div><div class="en">JŌKI ZAMURAI</div><div class="ps">▼</div></div>
  <div id="banner"><b></b><span></span></div>
  <div id="hpE" class="hpb gbox hidden"><div class="nm"><b id="eNm"></b><i id="eLv"></i></div><div class="sub" id="eSub"></div><div class="hpl"><em>PV</em><div class="hpt"><i id="eHp"></i></div></div></div>
  <div id="hpM" class="hpb gbox hidden"><div class="nm"><b id="mNm"></b><i id="mLv"></i></div><div class="hpl"><em>PV</em><div class="hpt"><i id="mHp"></i></div></div><div class="hpn" id="mHpN"></div><div class="xpt"><i id="mXp"></i></div></div>
  <div id="board" class="hidden"><b></b><span></span></div>
  <div id="choice" class="gbox hidden"></div>
  <div id="dlg" class="gbox hidden"><img id="dlgP" alt=""><div id="dlgN"></div><div id="dlgT"></div><i id="dlgA">▼</i></div>
  <div id="fade"></div>
 </div></div>
 <div id="bot">
  <section id="pTitle" class="pan hidden"><div class="cov" id="cov"></div><button class="btn pri" id="bCont">つづきから<small>Continuer</small></button><button class="btn" id="bNew">はじめから<small>Nouvelle partie</small></button><p>Apprends le japonais en traçant des kanji et en construisant des phrases.</p></section>
  <section id="pPad" class="pan hidden">
   <div class="hud"><div class="stat"><img id="stAv" alt=""><div class="in"><div><b id="stNm"></b><span id="stLv"></span></div><div class="bar"><i id="stHp"></i></div><small id="stHpT"></small><div class="bar xp"><i id="stXp"></i></div></div></div>
   <div id="obj"></div></div>
   <div id="study" class="card"></div><div id="dCh"></div>
   <div class="pad"><div class="dpad" id="dpad"><button class="u" data-d="1" aria-label="Haut">▲</button><button class="l" data-d="2" aria-label="Gauche">◀</button><div class="c"></div><button class="r" data-d="3" aria-label="Droite">▶</button><button class="d" data-d="0" aria-label="Bas">▼</button></div>
    <div class="ab"><button class="a" id="kA">A</button><button class="b" id="kB">B</button></div></div>
   <div class="padf"><button id="kStart">MENU</button><button id="kRev">復 Révision</button><button id="kDemon">影 Démon</button></div>
  </section>
  <section id="pBat" class="pan hidden"><div id="bInfo"></div><div class="cmd" id="bCmd">
    <button class="btn c1" data-c="spell">術<small>じゅつ<br>Sort</small></button><button class="btn c2" data-c="phrase">言葉<small>ことば<br>Phrase</small></button>
    <button class="btn c3" data-c="item">道具<small>どうぐ<br>Sac</small></button><button class="btn c4" data-c="run">逃げる<small>にげる<br>Fuir</small></button><button class="btn c5" data-c="listen">聞く<small>きく<br>Écouter</small></button></div>
   <div class="list hidden" id="bList"></div><button class="btn dark hidden" id="bBack">◀ Retour</button></section>
  <section id="pTrace" class="pan hidden"><div class="thead"><div class="k" id="tK"></div><div class="i"><b id="tName"></b><br><span id="tRead"></span></div><div class="prog" id="tProg"></div></div>
   <div class="boardw" id="tBw"><canvas id="cv"></canvas></div><div id="tMsg"></div>
   <div class="row"><button class="btn dark" id="tQuit" style="flex:1">◀ Annuler</button><button class="btn" id="tHint" style="flex:1">Aide <small>−1 ★</small></button></div></section>
  <section id="pEx" class="pan hidden"><button class="qt hidden" id="xQuit">✕ Quitter</button><div class="timer hidden" id="xTm"><i></i></div><div class="exq" id="xQ"></div><div id="xBody" class="grow" style="display:flex;flex-direction:column;gap:10px;overflow:auto"></div><div id="xFb"></div><button class="btn pri" id="xOk">Valider</button></section>
  <section id="pLes" class="pan hidden"><div class="lh"><button class="qt" id="lQuit">✕ Quitter</button><span id="lT"></span><div class="dots" id="lDots"></div></div><div class="card lcard" id="lCard"></div><div class="row"><button class="btn dark" id="lPrev">◀</button><button class="btn pri" id="lNext" style="flex:1">Suivant ▶</button></div></section>
  <section id="pMenu" class="pan hidden"><div class="tabs" id="mTabs"></div><div class="mbody" id="mBody"></div><button class="btn dark" id="mClose">◀ Retour au jeu</button></section>
  <section id="pChat" class="pan hidden"><div class="lh"><button class="qt" id="cQuit">✕ Fermer</button><img id="cAv" alt=""><span>影 · la voix au fond de toi</span><button class="qt" id="cNew" style="margin-left:auto">Nouveau sujet</button></div><div class="clist" id="cList"></div><div class="chips" id="cHints"></div><form class="row" id="cForm"><input id="cIn" type="text" autocomplete="off" autocapitalize="off" placeholder="Réponds en japonais, en rōmaji ou en français" aria-label="Ton message"><button class="btn pri" id="cSend" type="submit">送る</button></form></section>
  <section id="pEvo" class="pan hidden"><div class="evo"><img id="evA" alt=""><span>▶</span><img id="evB" alt=""></div><button class="btn dark" id="evNext">▼ Suite</button></section>
 </div>
 <div id="toast" class="hidden"></div>
</div>
