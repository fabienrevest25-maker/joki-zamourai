 {id:'tanu',spr:'tanu',x:11,y:3551,ev:'tanu',wander:1},{id:'jii',spr:'jii',x:5,y:3551,ev:'jii',wander:2},{id:'kid',spr:'kid',x:15,y:3551,ev:'kid',wander:2},
 {id:'fisher',spr:'fisher',x:15,y:3557,ev:'fisher',dir:3},{id:'hana',spr:'hana',x:5,y:3557,ev:'hana',wander:1},{id:'girl',spr:'girl',x:11,y:3542,ev:'girl',dir:2},
