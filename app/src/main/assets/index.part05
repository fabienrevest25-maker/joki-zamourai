";
I18N.Z=I18N.Z||{};I18N.Z.de="";
/* moteur de traduction : modèles, préfixes, segments */
(function(){const C={},K={};const esc=s=>s.replace(/[.*+?^${}()|[\]\\]/g,'\\$&');const FRW=/[éèêàçùœ]|\b(le|la|les|des|du|une|un|est|pas|tu|ton|ta|tes|pour|avec|dans|sur|qui|que|et|au|aux|ce|cette|mon|ma|de|jour)\b/i;
function pats(L){if(C[L])return C[L];if(I18N.Z&&I18N.Z[L])return [];const out=[],d=I18N[L]||{};const add=(fr,t,aff)=>{const lit=fr.replace(/\{\}/g,'');if(aff&&!/[A-Za-zÀ-ÿ]{2}/.test(lit))return;if(!lit.trim())return;out.push([new RegExp('^'+fr.split('{}').map(esc).join('([\\s\\S]*?)')+'$'),t,lit.length,aff,fr])};
for(const[f,t]of(I18N.T&&I18N.T[L])||[])add(f,t,0);
for(const k in d){if(k.length<3||!/[A-Za-zÀ-ÿ]{2}/.test(k))continue;if(/[\s:：]$/.test(k)&&!/^\s/.test(k))add(k+'{}',d[k]+'{}',1);else if(/^\s/.test(k)&&!/\s$/.test(k))add('{}'+k,'{}'+d[k],1)}
out.sort((a,b)=>b[2]-a[2]);return C[L]=out}
function X(s,L,dp){if(I18N.Z&&I18N.Z[L])return null;const d=I18N[L];if(!d||typeof s!=='string')return null;const k=s.trim();if(!k)return null;if(d[s])return d[s];if(d[k])return s.replace(k,d[k]);{const c0=k.charAt(0),lc=c0.toLowerCase()+k.slice(1);if(lc!==k&&d[lc]){const t=d[lc];return s.replace(k,t.charAt(0).toUpperCase()+t.slice(1))}}const ck=K[L]||(K[L]=new Map());if(ck.has(s))return ck.get(s);let r=null;dp=dp|0;if(dp<4){const m1=k.match(/^([—·•✓✕▶◀▼★☆→:]+\s*)([\s\S]*[A-Za-zÀ-ÿ][\s\S]*)$/);if(m1){const y=X(m1[2],L,dp+1);if(y!=null)r=s.replace(k,m1[1]+y)}if(r==null){const m2=k.match(/^([\s\S]*?[A-Za-zÀ-ÿ.…?!)»])(\s*[✓✕★☆]+)$/);if(m2){const y=X(m2[1],L,dp+1);if(y!=null)r=s.replace(k,y+m2[2])}}if(r!=null){if(ck.size<20000)ck.set(s,r);return r}}
if(dp<4){for(const[re,t,lit,aff]of pats(L)){const m=k.match(re);if(!m)continue;let bad=0;const a=m.slice(1).map(v=>{if(!/[A-Za-zÀ-ÿ]{2}/.test(v))return v;const y=X(v,L,dp+1);if(y!=null)return y;if(FRW.test(v))bad=1;return v});if(bad&&(aff||lit<.4*k.length))continue;let i=0;r=s.replace(k,t.replace(/\{(\d*)\}/g,(q,n)=>n!==''?(a[+n]??''):(a[i++]??'')));break}
if(r==null){for(const sep of[' · ','\n',' — ',' : ']){if(!k.includes(sep))continue;let ch=0;const p=k.split(sep).map(v=>{const y=X(v,L,dp+1);if(y!=null){ch=1;return y}return v});if(ch){r=s.replace(k,p.join(sep===' : '?': ':sep));break}}}}
if(ck.size<20000)ck.set(s,r);return r}
window.I18X=X;
/* modèles contenant des balises seulement : sûrs pour traduire un bloc entier (objectif, carnet) */
window.I18XT=function(s,L){if(I18N.Z&&I18N.Z[L])return null;if(typeof s!=='string')return null;const k=s.trim();if(!k||k.indexOf('<')<0)return null;for(const[re,t,,aff,fr]of pats(L)){if(!fr||fr.indexOf('<')<0)continue;const m=k.match(re);if(!m)continue;let i=0;const a=m.slice(1).map(v=>{if(!/[A-Za-zÀ-ÿ]{2}/.test(v))return v;const y=X(v,L,1);return y!=null?y:v});return s.replace(k,t.replace(/\{(\d*)\}/g,(q,n)=>n!==''?(a[+n]??''):(a[i++]??'')))}return null};
async function dec(L,b64){const b=Uint8Array.from(atob(b64.trim()),c=>c.charCodeAt(0));const txt=await new Response(new Blob([b]).stream().pipeThrough(new DecompressionStream('gzip'))).text();const o=JSON.parse(txt);Object.assign(I18N[L]||(I18N[L]={}),o.d);I18N.T=I18N.T||{};I18N.T[L]=o.T;if(I18N.Z)delete I18N.Z[L];delete C[L];delete K[L];I18N.OK=I18N.OK||{};I18N.OK[L]=1;try{I18D.dirty=1;if(typeof UI!=='undefined'&&UI.stat)UI.stat()}catch(e){}}
const busy={};
window.I18LOAD=async function(L){try{if(!L||L==='fr'||(I18N.OK&&I18N.OK[L])||busy[L])return;busy[L]=1;if(I18N.Z&&I18N.Z[L])await dec(L,I18N.Z[L]);else{const r=await fetch('i18n_'+L+'.txt');if(r.ok)await dec(L,await r.text())}}catch(e){console.warn('i18n',e)}busy[L]=0};
(async function(){try{for(const L in (I18N.Z||{}))await window.I18LOAD(L)}catch(e){}let n=0;const t=setInterval(()=>{n++;try{if(typeof S!=='undefined'&&S.lang&&S.lang!=='fr'){window.I18LOAD(S.lang)}}catch(e){}if(n>20)clearInterval(t)},700)})();
})();
window.trH=function(h){if(typeof h!=='string'||typeof S==='undefined'||!S.lang||S.lang==='fr')return h;const L=S.lang,d=I18N[L]||{};if(d[h])return d[h];if(!/<[^>]+>/.test(h)){const w=I18X(h,L);return w==null?h:w}const seg=x=>{const q=x.trim();if(!q)return x;if(d[q])return x.replace(q,d[q]);const t=window.I18XT&&I18XT(q,L);if(t!=null)return x.replace(q,t);return x.split(/(<[^>]+>)/).map(p=>{if(!p||p[0]==='<'||!/[A-Za-zÀ-ÿ]{2}/.test(p))return p;const y=I18X(p,L);return y==null?p:y}).join('')};return h.split(/(<br\s*\/?>)/i).map(x=>/^<br/i.test(x)?x:seg(x)).join('')};
if(typeof objective==='function'){const _o=objective;objective=function(){return trH(_o.apply(this,arguments))}}


/* ---------- audit : une case par personnage, et les seuils restent libres ---------- */
(()=>{try{const M=MAPS.world,WP=M.warps||[],occ=new Set(),k=(x,y)=>x+','+y;
 const ok=(x,y,z)=>{const r=M.rows[y];if(!r)return false;const c=r[x];if(c===undefined||SOLID.includes(c)||'G^~w'.includes(c))return false;if(M.zone(y)!==z||occ.has(k(x,y)))return false;return !WP.some(w=>w.x===x&&(w.y===y||w.y+1===y))};
 const move=o=>{const z=M.zone(o.y);for(let r=1;r<8;r++)for(let dy=-r;dy<=r;dy++)for(let dx=-r;dx<=r;dx++){if(Math.max(Math.abs(dx),Math.abs(dy))!==r)continue;if(ok(o.x+dx,o.y+dy,z)){o.x+=dx;o.y+=dy;return}}};
 ITEMS.forEach(i=>{if(i.m==='world')occ.add(k(i.x,i.y))});
 if(typeof HIDS!=='undefined')HIDS.forEach(h=>occ.add(k(h.x,h.y)));
 GUARD.forEach(g=>occ.add(k(g.x,g.y)));
 const N=NPCS.world.filter(n=>!n.cond&&!/^pro_/.test(n.id||''));
 for(const n of N.filter(n=>!/^x\d/.test(n.id||'')).concat(N.filter(n=>/^x\d/.test(n.id||'')))){if(occ.has(k(n.x,n.y))||WP.some(w=>w.x===n.x&&w.y===n.y))move(n);occ.add(k(n.x,n.y))}
 for(const A of [typeof ROVERS!=='undefined'?ROVERS:[],typeof ELITES!=='undefined'?ELITES:[]])for(const g of A){if(occ.has(k(g.x,g.y)))move(g);occ.add(k(g.x,g.y))}
}catch(e){console.warn('sep',e)}})();
/* ---------- boucle principale + écran-titre ---------- */
let lastTs=0;
function frame(ts){requestAnimationFrame(frame);const dt=Math.min(.05,(ts-lastTs)/1000||.016);lastTs=ts;G.t+=dt;
 try{
 if(G.scene==='world'){W.step(dt);W.draw(G.t);W.grade()}
 else if(G.scene==='title'){g.fillStyle='#1c2238';g.fillRect(0,0,SW,SH)}
 else if(G.scene==='battle')Battle.drawScene(G.t);
 else if(G.scene==='lesson')Lesson.drawScene(G.t);
 else if(G.scene==='evo')Evo.drawScene(G.t);
 else if(G.scene==='chat')Chat.drawScene(G.t);
 else{g.fillStyle='#000';g.fillRect(0,0,SW,SH)}
 }catch(e){frame.err=(frame.err||0)+1;if(frame.err<4){console.error(e);try{if(G.scene==='world'&&W.reset)W.reset()}catch(x){}}}
 if(G.scene==='world'&&UI.cur==='pad'&&Math.floor(G.t*2)!==frame.o){frame.o=Math.floor(G.t*2);UI.stat()}}
function title(){G.scene='title';G.busy=true;{const l=$('#boot');if(l)l.remove()}$('#banner').classList.remove('on');$('#tit').classList.remove('hidden');UI.panel('title');$('#tit').style.backgroundImage=`linear-gradient(rgba(28,34,56,0) 60%,#1c2238 72%),url(${IM.TITLE})`;
 const has=hasSave()&&S.fl.intro;$('#bCont').classList.toggle('hidden',!has);music('title');$('#tit').addEventListener('pointerdown',()=>{try{au()}catch(e){}},{once:true});let armed=false;
 $('#bCont').onclick=async()=>{au();music('village');sfx('sel');await UI.fade(1,300);$('#tit').classList.add('hidden');let p=S.pos||{m:'world',x:3,y:OY+87,d:0};W.load(p.m,p.x,p.y,p.d);if(W.solid(p.x,p.y)){p=S.heal&&S.heal.m==='world'?{m:'world',x:S.heal.x,y:S.heal.y,d:0}:{m:'world',x:3,y:OY+87,d:0};W.load(p.m,p.x,p.y,0);if(W.solid(p.x,p.y)){p={m:'world',x:3,y:OY+87,d:0};S.heal=null;W.load(p.m,p.x,p.y,0)}S.pos=p}G.scene='world';G.busy=false;UI.panel('pad');await UI.fade(0,300)};
 $('#bNew').onclick=async()=>{au();if(has&&!armed){armed=true;$('#bNew').innerHTML='Effacer la partie en cours ?<small>Touche encore pour confirmer</small>';return}
  sfx('sel');const keep={snd:S.snd,mus:S.mus,furi:S.furi,roma:S.roma};try{localStorage.removeItem('jz3')}catch(e){}loadS();Object.assign(S,keep);S.hp=maxHp();
  await UI.fade(1,400);$('#tit').classList.add('hidden');G.scene='black';await More.welcome();if(PART===34&&window.Act3)return Act3.start();if(PART===4&&window.Act4&&Act4.boot)return Act4.boot();music('village');intro()}}
/* si la carte a grandi depuis la sauvegarde (nouvelles zones au nord), on décale les positions au lieu de renvoyer à la maison */
{const h=MAPS.world.h,zt=[];let pz=-1;for(let y=0;y<h;y++){const z=MAPS.world.zone(y);if(z!==pz){zt.push([z,y]);pz=z}}
 const LEG={1019:[[11,0],[10,102],[9,203],[8,307],[7,405],[6,503],[5,601],[4,657],[3,739],[2,821],[1,929],[0,997]]},old=S.zt||LEG[S.mh];
 if(S.mh&&(S.mh!==h||(S.zt&&JSON.stringify(S.zt)!==JSON.stringify(zt)))){const dy=h-S.mh,band=(t,y,H_)=>{for(let i=t.length-1;i>=0;i--)if(y>=t[i][1])return{z:t[i][0],top:t[i][1],len:(i+1<t.length?t[i+1][1]:H_)-t[i][1]};return null};
  ['pos','heal','ret'].forEach(k=>{const p=S[k];if(!p||typeof p.y!=='number'||(p.m&&p.m!=='world'))return;const a=old&&band(old,p.y,S.mh),nb=a&&zt.find(q=>q[0]===a.z);
   if(!a||!nb){p.y+=dy;return}const b=band(zt,nb[1],h),hm=HAMS.find(q=>q.z===a.z),route=hm?hm.y0-b.top:b.len,off=p.y-a.top;p.y=a.z===0?p.y+dy:off<route?b.top+off:b.top+b.len-(a.len-off)})}
 if(S.mh!==h||JSON.stringify(S.zt||0)!==JSON.stringify(zt)){S.mh=h;S.zt=zt;save()}
 /* une position tombée dans un mur après un agrandissement de la carte : on cherche la case libre la plus proche */
 {const RW=MAPS.world.rows,ok=(x,y)=>RW[y]&&RW[y][x]&&!SOLID.includes(RW[y][x]);['pos','heal','ret'].forEach(k=>{const p=S[k];if(!p||(p.m&&p.m!=='world')||typeof p.y!=='number'||ok(p.x,p.y))return;
  for(let r=1;r<30;r++)for(let dy=-r;dy<=r;dy++)for(let dx=-r;dx<=r;dx++)if(Math.max(Math.abs(dx),Math.abs(dy))===r&&ok(p.x+dx,p.y+dy)){p.x+=dx;p.y+=dy;return}})}}
{UI.fit();title();const bs=[$('#bCont'),$('#bNew')],lb=bs.map(b=>b.innerHTML);bs.forEach(b=>{b.disabled=true;b.style.opacity=.45});bs[1].innerHTML='Chargement des images…';
 XREADY.then(()=>{bs.forEach((b,i)=>{b.disabled=false;b.style.opacity='';b.innerHTML=lb[i]});requestAnimationFrame(frame);
  /* reprise automatique : si la page a été rechargée par le téléphone en pleine partie, on saute l'écran-titre */
  let hb=0;try{hb=+localStorage.getItem('jz_hb')||0}catch(e){}
  if(hasSave()&&S.fl.intro&&Date.now()-hb<15*60*1000){$('#bCont').click();setTimeout(()=>{try{UI.toast('Partie reprise là où tu t\'étais arrêté.')}catch(e){}},900)}
  setInterval(()=>{try{if(G.scene==='title'||!S.fl.intro)return;if(document.hidden)return;if(G.scene==='world'&&W.map==='world'&&!G.busy&&!W.H.mv){S.pos={m:W.map,x:W.H.x,y:W.H.y,d:W.H.dir};save()}localStorage.setItem('jz_hb',Date.now())}catch(e){}},4000)})}

/* temple (zone 21) : l'herbe est posée par blocs de 4×4 cases retournés au hasard (plus de motif qui se répète),
   et des arbres bordent les allées du jardin */
(()=>{const h=HAMS.find(q=>q.z===21),M=MAPS.world;if(!h||!ZT[21]||!ZP[21])return;const T=16,ok=k=>XI[k]&&XI[k].width,
 hb=(a,b)=>{let x=(a*374761393+b*668265263)>>>0;x=((x^(x>>>13))*1274126177)>>>0;return(x^(x>>>16))>>>0},at=(x,y)=>{const r=M.rows[y];return r?r[x]:'T'},
 tex=(X,x,y)=>{const f=hb(x>>2,y>>2)&3,fx=f&1,fy=f>>1,sx=fx?3-(x&3):x&3,sy=fy?3-(y&3):y&3;X.save();X.translate(x*T+(fx?T:0),y*T+(fy?T:0));X.scale(fx?-1:1,fy?-1:1);X.drawImage(XI.T_TE2_2,sx*48,sy*48,48,48,0,0,T,T);X.restore()};
 const o=ZT[21];ZT[21]=(X,c,x,y,hh)=>{if(ok('T_TE2_2')){
   if(y>=32&&y<=h.y0-3&&'.sw,lZ'.includes(c)){tex(X,x,y);return c==='.'||c==='s'}
   if(y>=h.y0&&y<=h.y1){if('.,sw'.includes(c)){tex(X,x,y);return true}if('lbcoSJ'.includes(c)){if(o&&o(X,c,x,y,hh))return true;tex(X,x,y);return true}}}
  return o?o(X,c,x,y,hh):false};
 let TD=0;const trees=()=>{if(TD)return;TD=1;const TR=['X_B21_CEDAR','X_B21_CEDAR','X_B21_SAKURA','X_GT2','X_GT0','X_GT3'].filter(ok);if(!TR.length)return;
  const occ=new Set();for(const b of ((window.PEAKS21&&PEAKS21())||[]))for(let i=-1;i<=b.w;i++)for(let j=-1;j<=b.h;j++)occ.add((b.x+i)+','+(b.y+j));
  const C=[],pl=[];for(let y=33;y<=h.y0-4;y++)for(let x=31;x<80;x++){if(at(x,y)!=='T'||occ.has(x+','+y))continue;let n=0;for(let a=-1;a<=1;a++)for(let b=-1;b<=1;b++)if(at(x+a,y+b)!=='T')n++;if(n)C.push([x,y,hb(x*7+1,y*13+5)])}
  C.sort((a,b)=>a[2]-b[2]);for(const[x,y,r]of C){if(pl.some(([u,v])=>Math.abs(u-x)<2&&Math.abs(v-y)<2))continue;pl.push([x,y]);
   (M.bld||(M.bld=[])).push({k:'city',x,y,w:1,h:1,im:TR[r%TR.length],flip:(r>>4)&1,tint:'',sc:.85+(r>>5)%4*.05})}};
 const of=ZP[21].f;ZP[21].f=(...a)=>{const r=of(...a);trees();return r};
})();
</script>
</body></html>
