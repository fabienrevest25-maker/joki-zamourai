 {id:'eng',spr:'eng',x:68,y:3156,ev:'eng',dir:2},{id:'worker1',spr:'worker',x:62,y:3154,ev:'worker1',wander:1},{id:'worker',spr:'worker',x:40,y:2991,ev:'worker',dir:2},
 {id:'h20',spr:'jii',x:60,y:3384,ev:'say',wander:1,nm:'Vieil homme',jp:['竹|たけ','の','子|こ','は','おいしい','です','よ','。'],fr:'Les pousses de bambou sont délicieuses, tu sais.',xx:'竹の子 (たけのこ) = pousse de bambou · よ = « je t\'assure »',t2:'Pour la grammaire, cherche le gros tanuki dans la rue. Pour les kanji, la forge. Pour l\'oreille, le toit bleu. On est bien organisés, par ici.'},
 {id:'h21',spr:'girl',x:71,y:3393,ev:'say',wander:1,nm:'Villageoise',jp:['夜|よる','は','森|もり','に','入らないで|はいらないで','ください','。'],fr:'N\'entre pas dans la forêt la nuit, s\'il te plaît.',xx:'〜ないでください = « ne fais pas…, s\'il te plaît »',t2:''},
 {id:'h30',spr:'worker',x:49,y:3187,ev:'say',wander:1,nm:'Ouvrier',jp:['毎日|まいにち','、','朝|あさ','から','晩|ばん','まで','働きます|はたらきます','。'],fr:'Chaque jour, je travaille du matin au soir.',xx:'から … まで = « de … à »',t2:'Le seigneur Tetsu ne paie qu\'en bons d\'usine. On ne sort jamais d\'ici.'},
 {id:'h31',spr:'kid',x:62,y:3197,ev:'say',wander:1,nm:'Enfant',jp:['お父さん|おとうさん','は','工場|こうじょう','に','います','。'],fr:'Papa est à l\'usine.',xx:'工場 (こうじょう) = usine · に います = « se trouve à »',t2:''},
 {id:'h40',spr:'fisher',x:52,y:3021,ev:'say',wander:1,nm:'Vieux pêcheur',jp:['ここ','の','水|みず','は','飲めません|のめません','。'],fr:'L\'eau d\'ici n\'est pas potable.',xx:'飲めます → 飲めません : « pouvoir boire », à la forme négative',t2:''},
 {id:'h41',spr:'girl',x:59,y:3031,ev:'say',wander:1,nm:'Habitante',jp:['機械|きかい','の','音|おと','が','うるさい','です','ね','。'],fr:'Le bruit des machines est assourdissant, hein.',xx:'機械 (きかい) = machine · うるさい = bruyant',t2:'Le grondement vient du nord, du côté du vieux puits.'},
 {id:'h50',spr:'jii',x:7,y:2871,ev:'say',wander:1,nm:'Vieil homme',jp:['むかし','、','ここ','は','きれい','な','村|むら','でした','。'],fr:'Autrefois, c\'était un joli village.',xx:'でした = le passé de です',t2:'Depuis que le puits s\'est réveillé, il ne reste que la cendre. Fais attention, mon garçon.'},
 {id:'h60',spr:'fisher',x:21,y:2778,ev:'say',wander:1,nm:'Porteur',jp:['雪|ゆき','が','たくさん','降りました|ふりました','。'],fr:'Il a beaucoup neigé.',xx:'降ります (ふります) = tomber (pluie, neige) · たくさん = beaucoup',t2:'Le col est fermé plus haut. La dame blanche ne laisse passer personne, et elle a très mauvais caractère pour une machine.'},
 {id:'h61',spr:'girl',x:34,y:2786,ev:'say',wander:1,nm:'Voyageuse',jp:['温かい|あたたかい','お茶|おちゃ','は','いかが','です','か','。'],fr:'Voulez-vous un thé chaud ?',xx:'いかがですか = « que diriez-vous de… ? », très poli',t2:''},
 {id:'h70',spr:'okami',x:50,y:2597,ev:'say',wander:1,nm:'Aubergiste',jp:['いらっしゃいませ','。','お泊まり|おとまり','です','か','。'],fr:'Bienvenue. C\'est pour la nuit ?',xx:'いらっしゃいませ = bienvenue (dans un commerce) · 泊まります (とまります) = passer la nuit',t2:'La chambre donne sur la grand-route. On y entend les coursiers automates toute la nuit. C\'est compris dans le prix.'},
 {id:'h71',spr:'sekiban',x:61,y:2606,ev:'say',wander:1,nm:'Garde du relais',jp:['手形|てがた','を','見せて|みせて','ください','。'],fr:'Montre-moi ton laissez-passer, s\'il te plaît.',xx:'手形 (てがた) = laissez-passer · 見せます (みせます) = montrer',t2:'Tu n\'en as pas ? Moi non plus. Le mur du nord ne me laisse pas passer, et c\'est moi qui travaille ici.'},
 {id:'h80',spr:'sendo',x:40,y:2424,ev:'say',wander:1,nm:'Vieux passeur',jp:['船|ふね','は','出ません|でません','。'],fr:'Le bateau ne part pas.',xx:'船 (ふね) = bateau · 出ます (でます) = partir, sortir',t2:'Pas tant que la grosse tête noire est dans l\'eau. Elle m\'a déjà cassé trois barques. La quatrième, je l\'ai cassée tout seul, de colère.'},
 {id:'h81',spr:'fishw',x:51,y:2433,ev:'say',wander:1,nm:'Poissonnière',jp:['今日|きょう','の','魚|さかな','は','新しい|あたらしい','です','よ','。'],fr:'Le poisson du jour est frais, tu sais.',xx:'新しい (あたらしい) = neuf, frais',t2:'Pêché ce matin. Enfin, ramassé. Depuis que le fleuve est hanté, ils sautent sur la berge tout seuls.'},
 {id:'h90',spr:'junsa',x:52,y:2237,ev:'say',wander:1,nm:'Agent de ville',jp:['夜|よる','は','走らないで|はしらないで','ください','。'],fr:'Ne courez pas la nuit, s\'il vous plaît.',xx:'〜ないでください = « ne faites pas…, s\'il vous plaît »',t2:'Ici, il fait toujours nuit. Donc on ne court jamais. C\'est le règlement, et c\'est aussi mon rythme naturel.'},
 {id:'h91',spr:'shinbun',x:59,y:2247,ev:'say',wander:1,nm:'Petit crieur',jp:['新聞|しんぶん','！','新聞|しんぶん','は','いかが','です','か','！'],fr:'Le journal ! Qui veut le journal ?',xx:'新聞 (しんぶん) = journal',t2:'À la une : « Une roue en feu contrôle les billets du funiculaire. » En page deux : « Personne n\'a de billet. »'},
 {id:'h100',spr:'gakusei',x:21,y:2059,ev:'say',wander:1,nm:'Étudiant',jp:['試験|しけん','の','前|まえ','に','寝ません|ねません','。'],fr:'Avant l\'examen, je ne dors pas.',xx:'試験 (しけん) = examen · 〜の前に = avant…',t2:'Après l\'examen non plus, remarque. Je dors pendant. C\'est pour ça que je le repasse depuis six ans.'},
 {id:'h101',spr:'shodo',x:34,y:2069,ev:'say',wander:1,nm:'Petite calligraphe',jp:['この','筆|ふで','は','先生|せんせい','に','もらいました','。'],fr:'Ce pinceau, je l\'ai reçu du professeur.',xx:'筆 (ふで) = pinceau · もらいます = recevoir',t2:'Il est trop grand pour moi. Le professeur dit que c\'est moi qui suis trop petite pour lui. On attend de voir qui cède.'},
 {id:'h110',spr:'imoji',x:35,y:1891,ev:'say',wander:1,nm:'Fondeur',jp:['今日|きょう','も','千|せん','本|ぼん','、','作りました|つくりました','。'],fr:'Aujourd\'hui encore, j\'en ai fabriqué mille.',xx:'千 (せん) = mille · 本 (ほん/ぼん) : pour compter les objets longs',t2:'Mille tuyaux. On ne sait pas où ils vont. On sait juste qu\'ils partent tous vers la grande halle, et qu\'aucun n\'en revient.'},
 {id:'h111',spr:'sekitan',x:50,y:1901,ev:'say',wander:1,nm:'Petit porteur',jp:['これ','は','百|ひゃく','円|えん','です','！'],fr:'Ça, c\'est cent yens !',xx:'百円 (ひゃくえん) = cent yens',t2:'Un panier de charbon, cent yens. Enfin, cent bons d\'usine. Ça ne s\'achète qu\'à la cantine. La cantine est à Tetsu. C\'est bien fichu, hein ?'},
 {id:'h120',spr:'meca',x:50,y:1697,ev:'say',wander:1,nm:'Mécanicienne',jp:['この','船|ふね','は','空|そら','を','飛びます|とびます','。'],fr:'Ce bateau-là vole dans le ciel.',xx:'空 (そら) = ciel · 飛びます (とびます) = voler',t2:'Enfin, il volait. Depuis que la bête du toit a mangé les mots des pilotes, plus personne ne sait dire « décollage ». On reste au sol. Au sol des nuages, je veux dire.'},
 {id:'h121',spr:'ekichou',x:61,y:1706,ev:'say',wander:1,nm:'Chef de gare',jp:['次|つぎ','の','船|ふね','は','何時|なんじ','です','か','。'],fr:'À quelle heure part le prochain dirigeable ?',xx:'次 (つぎ) = suivant · 何時 (なんじ) = quelle heure',t2:'C\'est moi qui pose la question. Tout le monde me la pose, alors je la pose aussi. Personne n\'a la réponse. C\'est très reposant.'},
 {id:'h130',spr:'doyen',x:49,y:1518,ev:'say',wander:1,nm:'Doyenne des renards',jp:['人間|にんげん','は','ここ','に','来ません|きません','。'],fr:'Les humains ne viennent pas ici.',xx:'人間 (にんげん) = être humain',t2:'Enfin, ils ne venaient pas. Toi, tu es tombé du ciel avec un tanuki et un démon dans la poitrine. Techniquement, ça ne compte pas comme une visite.'},
 {id:'h131',spr:'messa',x:62,y:1526,ev:'say',wander:1,nm:'Messagère renarde',jp:['手紙|てがみ','を','持って|もって','います','。'],fr:'J\'ai des lettres sur moi.',xx:'持っています (もっています) = avoir sur soi',t2:'Je les porte de terrier en terrier. Personne n\'a d\'adresse, alors je les distribue au flair. Ça marche à peu près une fois sur deux.'},
 {id:'h140',spr:'tokei',x:24,y:1337,ev:'say',wander:1,nm:'Maîtresse Tokei',jp:['この','時計|とけい','は','古い|ふるい','です','が','、','正しい|ただしい','です','。'],fr:'Cette horloge est vieille, mais elle est juste.',xx:'古い (ふるい) = vieux · 正しい (ただしい) = juste, exact',t2:'C\'est la seule de l\'île. Je l\'ai cachée sous mon lit quand Tetsu a pris le mot « maintenant ». Elle tique en secret. Ne le dis à personne.'},
 {id:'h141',spr:'byoshin',x:31,y:1347,ev:'say',wander:1,nm:'Byōshin',jp:['ぼく','は','時計|とけい','が','大好き|だいすき','です','！'],fr:'Moi, j\'adore les horloges !',xx:'大好き (だいすき) = adorer',t2:'Mais elles ne m\'aiment pas. Chaque fois que j\'en répare une, elle se met à tourner à l\'envers. Maîtresse Tokei dit que c\'est un don.'},
 {id:'h150',spr:'fumi',x:60,y:1154,ev:'say',wander:1,nm:'Fumi l\'aiguilleuse',jp:['東|ひがし','の','電車|でんしゃ','は','右|みぎ','です','。'],fr:'Le train de l\'est, c\'est à droite.',xx:'東 (ひがし) = est · 右 (みぎ) = droite',t2:'Enfin, c\'était à droite. Depuis que Tetsu a pris le mot « chemin », les aiguillages tournent tout seuls. Ce matin, le train de l\'est est parti vers l\'ouest. Les passagers ont dit merci quand même.'},
 {id:'h151',spr:'gonta',x:71,y:1163,ev:'say',wander:1,nm:'Gonta le cheminot',jp:['この','レール','は','とても','重い|おもい','です','。'],fr:'Ce rail est très lourd.',xx:'重い (おもい) = lourd',t2:'Je le porte depuis trois jours. Je ne sais plus où le poser. Avant, je savais : il y avait des chemins. Maintenant il y a juste moi et ce rail.'},
 {id:'h160',spr:'sumi',x:49,y:949,ev:'say',wander:1,nm:'Sumi la copiste',jp:['私|わたし','の','名前|なまえ','は','…','何|なん','でした','か','。'],fr:'Mon nom, c\'était… quoi, déjà ?',xx:'名前 (なまえ) = nom · でした = le passé de です',t2:'Je recopie mille noms par jour. Les noms des autres. Le mien, Tetsu l\'a rangé quelque part dans la grande bibliothèque, entre deux inconnus. Si tu le trouves, dis-le-moi doucement.'},
 {id:'h161',spr:'hon',x:62,y:959,ev:'say',wander:1,nm:'Grand-père Hon',jp:['この','本|ほん','は','白い|しろい','です','。'],fr:'Ce livre est blanc.',xx:'本 (ほん) = livre · 白い (しろい) = blanc',t2:'Toutes les pages sont vides. Avant, c\'était mon journal. Quarante ans de souvenirs. Tetsu l\'a lu, puis il l\'a vidé. Il paraît que mes souvenirs sont maintenant dans le sien. Il doit bien s\'ennuyer.'},
 {id:'h170',spr:'sango',x:50,y:754,ev:'say',wander:1,nm:'Sango',jp:['この','瓶|びん','に','名前|なまえ','が','あります','。'],fr:'Il y a un nom dans cette bouteille.',xx:'瓶 (びん) = bouteille · 名前 (なまえ) = nom',t2:'J\'en ai ramassé deux cent douze. Je les range par ordre alphabétique. En hiragana. Ça m\'occupe jusqu\'au goûter.'},
 {id:'h171',spr:'fishw',x:61,y:763,ev:'say',wander:1,nm:'Pêcheuse',jp:['魚|さかな','が','ぜんぜん','いません','。'],fr:'Il n\'y a pas du tout de poisson.',xx:'ぜんぜん + négatif = pas du tout',t2:'Ils sont là, hein. Mais on a oublié leurs noms. Alors on dit « truc ». Les poissons ne répondent pas à « truc ». Je les comprends.'},
 {id:'h180',spr:'okayu',x:49,y:576,ev:'say',wander:1,nm:'Okayu',jp:['スープ','が','金|きん','に','なりました','。'],fr:'Ma soupe est devenue de l\'or.',xx:'〜になりました = est devenu',t2:'On ne peut pas manger de l\'or. J\'ai essayé. J\'ai perdu une dent. Elle est en or maintenant, remarque.'},
 {id:'h181',spr:'pika',x:62,y:586,ev:'say',wander:1,nm:'Pika',jp:['毎日|まいにち','、','町|まち','を','磨きます|みがきます','。'],fr:'Chaque jour, je fais briller la ville.',xx:'磨きます (みがきます) = polir, faire briller',t2:'Tout ce qui brille, c\'est moi. Sauf l\'Empereur. Lui, il brille tout seul. C\'est vexant.'}],
 keiko:[{id:'kotoba',spr:'kotoba',x:5,y:3,ev:'keiko',dir:0}],
 dojo:[{id:'master',spr:'master',x:5,y:3,ev:'master',dir:0}],
 atelier:[{id:'forg',spr:'forg',x:3,y:2,ev:'forg',dir:0}]};
const GUARD=[{id:'toad',x:18,y:2895},{id:'smoke',x:46,y:3060},{id:'karakasa',x:74,y:3224},{id:'kakashi',x:46,y:3415},{id:'yuki',x:46,y:2635},{id:'nuri',x:74,y:2455},{id:'umi',x:46,y:2275},{id:'wanyudo',x:18,y:2095},{id:'kyorin',x:46,y:1915},{id:'baku',x:74,y:1735},{id:'nue',x:37,y:1555},{id:'yamabiko',x:9,y:1375},{id:'ungai',x:47,y:1195},{id:'kaze',x:75,y:995},{id:'tetsu',x:74,y:805},{id:'ushioni',x:46,y:612},{id:'kinko',x:46,y:432},{id:'daitengu',x:55,y:298},{id:'mukade',x:55,y:147},{id:'tetsuf',x:55,y:17}];
const EN={
 kakashi:{id:'kakashi',img:'E_KAKASHI',bt:'doro2',n:'Seigneur de boue',t:['泥田坊|どろたぼう'],lv:5,hp:110,dmg:18,weak:'火',res:'土',gives:'木',xp:40,atk:'Coup de piquet',clue:'De la boue, des tuyaux percés et un œil jaune qui compte ses rizières.',cry:['私|わたし','の','田|た','です','！'],cryFr:'C\'est MA rizière !'},
 karakasa:{id:'karakasa',img:'E_KARAKASA',bt:'chochin2',n:'Lanterne de fête',t:['提灯|ちょうちん','お化け|おばけ'],lv:9,hp:150,dmg:21,trait:'words',weak:'木',res:'水',gives:'水',xp:50,atk:'Coup de langue brûlant',clue:'Du papier rouge huilé, du laiton poli et une langue beaucoup trop longue.',cry:['祭り|まつり','が','好き|すき','です','か','？'],cryFr:'Tu aimes les fêtes ?'},
 smoke:{id:'smoke',img:'E_SMOKE',bt:'karakuri2',n:'Poupée de cérémonie',t:['からくり','人形|にんぎょう'],lv:13,hp:175,dmg:24,trait:'mimic',weak:'水',res:'風',gives:'風',xp:60,atk:'Pile de tasses',clue:'De la laque noire, des rouages, et un sourire qui ne s\'arrête jamais.',cry:['お茶|おちゃ','は','いかが','です','か','…'],cryFr:'Voulez-vous du thé…'},
 toad:{id:'toad',img:'E_TOAD',bt:'kamado2',n:'Grand fourneau',t:['大|おお','かまど'],lv:16,hp:210,dmg:27,trait:'fog',weak:'風',res:'雷',gives:'雷',xp:70,atk:'Retour de flamme',clue:'Sa pression est dans le rouge, et son humeur aussi.',cry:['熱い|あつい','！','熱い|あつい','！'],cryFr:'C\'est brûlant ! Brûlant !'},
 boss:{id:'boss',img:'BOSS',n:'Oni Locomotive',t:['古井戸|ふるいど','の','鬼|おに'],lv:20,hp:440,dmg:32,weak:'水',res:'火',xp:150,atk:'Charge à vapeur',clue:'Une fournaise rugit dans son ventre.',cry:['私|わたし','は','古井戸|ふるいど','の','鬼|おに','だ','！'],cryFr:'Je suis le démon du vieux puits !'},
 yuki:{id:'yuki',n:'Yuki-onna mécanique',t:['雪女|ゆきおんな'],lv:26,hp:320,dmg:30,trait:'frost',weak:'火',res:'水',xp:110,atk:'Souffle de givre',clue:'De la porcelaine fêlée, des rouages, et un froid qui vient de l\'intérieur.',cry:['寒い|さむい','です','か','。','もっと','寒く|さむく','なります','よ','。'],cryFr:'Tu as froid ? Il va faire plus froid encore.'},
 nuri:{id:'nuri',img:'E_NURI',bt:'nuri2',n:'Grand Nurikabe douanier',t:['塗り壁|ぬりかべ'],lv:30,hp:380,dmg:32,trait:'stiff',weak:'水',res:'土',xp:130,atk:'Fermeture administrative',clue:'Du plâtre, des tuiles, un portail clouté et une patience de mur.',cry:['ここ','を','通って|とおって','は','いけません','。'],cryFr:'Il est interdit de passer par ici.'},
 umi:{id:'umi',img:'E_UMI',bt:'umi2',n:'Umibōzu de vapeur',t:['海坊主|うみぼうず'],lv:34,hp:440,dmg:34,trait:'ear',weak:'雷',res:'水',xp:150,atk:'Barque fracassée',clue:'Une tête lisse et noire, deux yeux cyan, et un col de scaphandre qui fuit.',cry:['船|ふね','は','出ません|でません','。'],cryFr:'Aucun bateau ne partira.'},
 wanyudo:{id:'wanyudo',img:'E_WANYUDO',bt:'wanyudo3',n:'Wanyūdō contrôleur',t:['輪入道|わにゅうどう'],lv:38,hp:500,dmg:36,trait:'burn',weak:'水',res:'火',xp:170,atk:'Poinçon brûlant',clue:'Une roue de tramway rouillée, des flammes bleues, une tête de moine au milieu, et un képi.',cry:['切符|きっぷ','を','見せて|みせて','ください','。'],cryFr:'Votre billet, s\'il vous plaît.'},
 kyorin:{id:'kyorin',img:'E_KYORIN',bt:'kyorin2',n:'Kyōrinrin, l\'examinateur',t:['経凛々|きょうりんりん'],lv:42,hp:560,dmg:38,trait:'words',weak:'火',res:'風',xp:190,atk:'Correction au pinceau rouge',clue:'Un tas de rouleaux que personne n\'a lus, avec un bec, une cloche et un pinceau rouge.',cry:['試験|しけん','を','始めます|はじめます','。'],cryFr:'L\'examen commence.'},
 baku:{id:'baku',img:'E_BAKU',bt:'baku',n:'Baku de fer',t:['獏|ばく'],lv:46,hp:560,dmg:38,trait:'words',weak:'雷',res:'火',xp:120,atk:'Aspiration',clue:'Un Baku de fonte et de laiton. Il ne mange plus les rêves : il avale les mots.',cry:['言葉|ことば','を','ください','。'],cryFr:'Donnez-moi des mots.'},
 baku2:{id:'baku2',bt:'baku2',n:'Baku de fer déchaîné',t:['獏|ばく'],lv:48,hp:480,dmg:42,trait:'burn',weak:'水',res:'火',xp:260,atk:'Tempête de feuillets',clue:'La cuve est fendue. Tout ce qu\'il a avalé ressort d\'un coup.',cry:['もっと','！','もっと','！'],cryFr:'Encore ! Encore !'},
 nue:{id:'nue',bt:'nue',n:'Nue des nuages',t:['鵺|ぬえ'],lv:50,hp:600,dmg:41,trait:'ear',weak:'風',res:'雷',xp:220,atk:'Cri de la nuit',clue:'Tête de singe, corps de tanuki, pattes de tigre, queue de serpent, et une hélice de laiton dans le dos.',cry:['ヒョー','、','ヒョー','…'],cryFr:'Hyoo… hyoo…',mus:'nue',bg:'B_PORT',big:1},
 tetsu:{id:'tetsu',bt:'tetsu',n:'Tetsu, seigneur de fer',t:['鉄|てつ'],lv:66,hp:760,dmg:49,trait:'words',weak:'火',res:'水',xp:320,atk:'Trait de pinceau-lance',clue:'Le seigneur de fer, dans son armure de calligraphe. Son pinceau-lance efface les mots. Au cou, une petite amulette rouge d\'enfant.',cry:['名前|なまえ','を','消せ|けせ','。'],cryFr:'Efface ton nom.',mus:'tetsu',bg:'B_LIBRARY',big:1},
 tetsu2:{id:'tetsu2',bt:'tetsu2',n:'Tetsu, l\'encre déchaînée',t:['鉄|てつ'],lv:70,hp:820,dmg:53,trait:'fog',weak:'火',res:'水',xp:380,atk:'Ailes d\'encre',clue:'L\'armure a éclaté. L\'encre ne lui obéit plus : c\'est elle qui le porte. Seule l\'amulette rouge brille encore.',cry:['返さない|かえさない','！'],cryFr:'Je ne rendrai rien !',mus:'tetsu',bg:'B_THRONE2',big:1},
 kaze:{id:'kaze',bt:'kaze',n:'Kaze-no-kami à vapeur',t:['風の神|かぜのかみ'],lv:62,hp:720,dmg:47,trait:'fog',weak:'土',res:'風',xp:280,atk:'Bourrasque du soufflet',clue:'Un ogre vert aux cheveux blancs, un soufflet géant sur le dos. Dans les légendes, c\'est le mauvais vent qui rôde sur les routes et égare les voyageurs.',cry:['ヒュー','…','ヒュー','…'],cryFr:'Hyuu… hyuu…',mus:'nue',bg:'B_CROSS',big:1},
 ungai:{id:'ungai',bt:'ungai',n:'Ungaikyō d\'horlogerie',t:['雲外鏡|うんがいきょう'],lv:58,hp:680,dmg:45,trait:'frost',weak:'土',res:'雷',xp:260,atk:'Coup de balancier',clue:'Une horloge de laque noire, un miroir à la place du cadran. Il montre le vrai visage des choses, même celles qu\'on cache.',cry:['本当|ほんとう','の','顔|かお','を','見せて|みせて','。'],cryFr:'Montre ton vrai visage.',mus:'baku',bg:'B_GARDEN',big:1},
 yamabiko:{id:'yamabiko',bt:'yamabiko',n:'Yamabiko de fer',t:['山彦|やまびこ'],lv:54,hp:640,dmg:43,trait:'mimic',weak:'火',res:'木',xp:240,atk:'Écho assourdissant',clue:'Un grand singe de mousse, la tête hérissée de pavillons de gramophone. Il répète tout ce qu\'on dit. De travers.',cry:['ヤッホー','…','ホー','…','ー'],cryFr:'Yahoo… hoo… oo…',mus:'yama',bg:'B_FOREST',big:1},
 yoma0:{id:'yoma0',n:'Kage-yōma',t:['影|かげ','の','妖魔|ようま'],lv:2,hp:38,dmg:4,weak:'火',res:'土',xp:20,atk:'Griffe d\'ombre',clue:'Une ombre vivante.',cry:['シャアア','…','！'],cryFr:'Chhhaaa… !'}};
Object.values(EN).forEach(e=>{e.spr=()=>e.id==='yoma0'||!BSPR[e.id]?bspr('wisp','#8a58c8'):bspr(e.id)});
