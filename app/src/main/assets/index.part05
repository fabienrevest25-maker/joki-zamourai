   /* champ lissé aux 9 centres voisins */
   const F=[];for(let b=-1;b<=1;b++){F.push([]);for(let a=-1;a<=1;a++)F[b+1].push(field(at,x+a,y+b))}
   const mk=scr('mk',T,T),mg=mk.g,id=mg.createImageData(T,T);
   for(let py=0;py<T;py++)for(let px=0;px<T;px++){const u=(px+.5)/T-.5,v=(py+.5)/T-.5,ax=u<0?0:1,ay=v<0?0:1,tx=u<0?u+1:u,ty=v<0?v+1:v;
    const f00=F[ay][ax],f10=F[ay][ax+1],f01=F[ay+1][ax],f11=F[ay+1][ax+1],f=(f00*(1-tx)+f10*tx)*(1-ty)+(f01*(1-tx)+f11*tx)*ty;
    const gx=x*T+px,gy=y*T+py,wob=.09*Math.sin(gx*.075+gy*.031)+.06*Math.sin(gy*.063-gx*.042+1.7);if(f>.5+wob)id.data[(py*T+px)*4+3]=255}
   mg.putImageData(id,0,0);
   const tmp=scr('tmp',Math.round(T*sc),Math.round(T*sc)),tg=tmp.g;tg.globalCompositeOperation='source-over';tg.clearRect(0,0,tmp.width,tmp.height);tg.imageSmoothingEnabled=false;
   if(wi&&wi.width===192)tg.drawImage(wi,(x%4)*48,(y%4)*48,48,48,0,0,tmp.width,tmp.height);else if(wi)tg.drawImage(wi,0,0,tmp.width,tmp.height);else tg.drawImage(AT.A,...AT.at(wq),0,0,tmp.width,tmp.height);
   tg.globalCompositeOperation='destination-in';tg.drawImage(mk,0,0,tmp.width,tmp.height);
   X.save();X.imageSmoothingEnabled=false;X.drawImage(AT.A,...AT.at(sl),x*T,y*T,T,T);X.drawImage(tmp,x*T,y*T,T,T);
   /* liseré de berge : un pixel sombre côté terre */
   const ed=mg.createImageData(T,T);for(let py=0;py<T;py++)for(let px=0;px<T;px++){const k=(py*T+px)*4+3;if(id.data[k])continue;let n=0;for(const[a,b]of[[1,0],[-1,0],[0,1],[0,-1]]){const qx=px+a,qy=py+b;if(qx<0||qy<0||qx>=T||qy>=T)continue;if(id.data[(qy*T+qx)*4+3])n=1}if(n){ed.data[k-3]=26;ed.data[k-2]=40;ed.data[k-1]=24;ed.data[k]=120}}
   const ec=scr('ec',T,T);ec.g.putImageData(ed,0,0);X.drawImage(ec,x*T,y*T,T,T);X.restore();
   /* l'eau animée de cette case gardera la même forme arrondie (masque conservé, une petite toile par case d'eau) */
   if(W_(c)){const k_=x+','+y;let mm=MK.get(k_);if(!mm){mm=document.createElement('canvas');mm.width=mm.height=T;MK.set(k_,mm)}const g_=mm.getContext('2d');g_.clearRect(0,0,T,T);g_.putImageData(id,0,0)}}}
  /* 2e passe, près de l'eau : le sentier et l'herbe se rejoignent aussi en courbe (plus de damier) */
  if(window.__noP2)return;const PT=k=>k==='_'||k==='=',nearW=(x,y)=>{for(let b=-3;b<=3;b++)for(let a=-3;a<=3;a++)if(W_(at(x+a,y+b)))return true;return false};
  const P2=[],need2=new Map();
