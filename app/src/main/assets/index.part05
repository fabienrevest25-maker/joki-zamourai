(()=>{
 const J=(n,jp,fr,x)=>({n,jp,fr,x}),T_=(n,t)=>({n,t}),KG='影',KA='Kaito',TN=NPN.tanu,TK='Maîtresse Tokei',UG='Ungaikyō d\'horlogerie',HL='Mot de Hana',OPP=[1,0,3,2];
 Object.assign(PORT,{[TK]:'PX_tokei','Byōshin':'PX_byoshin','Moine jardinier':'PX_jardin','Karakuri-san':'PX_karak',[UG]:'PX_gungai',[HL]:'PX_hana'});
 const H14=()=>HAMS.find(h=>h.z===14),H13=()=>HAMS.find(h=>h.z===13);
 /* arrivée en nacelle */
 async function arrive14(){const h=H14();S.fl.arr14=1;save();W.load('world',NAC.B.out[0],NAC.B.out[1],0);W.H.cd=3;
  await Cine.say('N_S13',["La nacelle se pose sur une terrasse de pierre. Partout, entre les bonsaïs et les glycines, des horloges de laiton tournent. Grandes, petites, en piles, accrochées aux arbres.",
   T_(TN,"Regarde-les, Kaito. Aucune n'indique la même heure."),T_(KG,"Tetsu a pris le mot « maintenant ». 今. Sans lui, personne ne peut dire quelle heure il est. Le temps continue, mais personne ne sait où il en est."),
   J(KA,['今|いま','、','何時|なんじ','です','か','。'],'Quelle heure est-il, maintenant ?','今 (いま) = maintenant'),T_(TN,"Personne ne le sait, mon grand. C'est bien le problème. Allez, viens : au-delà des nuages, c'est la citadelle.")]);
  await UI.fade(0,300);music(ZONES[14].mus);W.refreshZone();save()}
 /* l'épingle de Hana, sous le Jizō */
 {const oJ=STORY.jizo;STORY.jizo=async e=>{if(W.zone()===14&&!S.fl.pin14){S.fl.pin14=1;sfx('item');
   await Cine.say('N_S14',["Au pied du Jizō, entre deux fleurs, une petite épingle rouge décorée d'une fleur de cerisier. Et un papier plié, minuscule.",
    J(HL,['お兄ちゃん|おにいちゃん','、','私|わたし','は','元気|げんき','です','。'],'Grand frère, je vais bien.','元気 (げんき) = en forme'),
    J(HL,['テツ','の','時計|とけい','を','直して|なおして','います','。','でも','、','まちがえて','います','。'],"Je répare les horloges de Tetsu. Mais je me trompe.",'直します (なおします) = réparer · まちがえます = se tromper'),
    J(HL,['わざと','です','。'],'Exprès.','わざと = exprès'),
    T_(KG,"… Ta sœur sabote l'empire de Tetsu avec un tournevis. Je l'adore."),T_(KA,"Moi aussi."),T_(KG,"Je n'ai rien dit. Range l'épingle. Près du cœur. Non, l'autre côté : là, c'est moi.")]);save()}return oJ(e)}}
 /* passage entre la forêt et les jardins : la nacelle fait l'aller-retour */
 async function hop14(up){music(null);await UI.fade(1,300);const R=Act3.ride(7,!up);await UI.fade(0,250);sfx('door');await Promise.race([R.done,wait(8000)]);await UI.fade(1,300);R.end();Cine.hide();
  if(up)W.load('world',NAC.B.out[0],NAC.B.out[1],0);else W.load('world',NAC.A.out[0],NAC.A.out[1],0);W.H.cd=3;await UI.fade(0,300);music(ZONES[up?14:13].mus);W.refreshZone();save();
  UI.toast(up?'La nacelle te dépose dans les jardins.':'La nacelle te ramène à la forêt.',2400)}
 {const o=STORY.triggers;STORY.triggers=(x,y)=>{if(W.map==='world'&&!S.fl.noscn){const z=W.zone(),h=H14();
   if(z===14&&h&&NAC.isDoor(NAC.B,x,y)&&S.fl.arr14)return()=>hop14(false);
}
  return o(x,y)}}
 /* le gardien : l'Ungaikyō d'horlogerie */
 const PRE=["Devant le pont du nord, une haute horloge de laque noire se redresse sur des pattes de laiton. À la place du cadran, un miroir rond.",
  "Dans le miroir, tu ne te vois pas. Tu vois un grand garçon, très fatigué, et derrière lui une ombre immense avec des yeux de renard.",
  J(UG,['本当|ほんとう','の','顔|かお','を','見せて|みせて','。'],'Montre ton vrai visage.','本当 (ほんとう) = vrai · 顔 (かお) = visage'),
  T_(KG,"Ne le regarde pas trop longtemps, Kaito. Il ne ment pas. C'est ça qui est dangereux."),T_(UG,"Tetsu m'a placé ici pour que personne ne passe sans se regarder en face. La plupart repartent en courant. Toi, tu restes. Intéressant.")];
 const POST=["Le miroir se fend en étoile. Dans chaque éclat, un bout du ciel bleu.",J(UG,['あなた','は','強い|つよい','と','思います|おもいます','。'],'Je pense que tu es fort.','〜と思います = je pense que…'),
  T_(UG,"Fort, pas parce que tu frappes. Parce que tu ne détournes pas les yeux. Passe. Le pont du nord t'attend."),"Le balancier s'arrête. Pour la première fois depuis longtemps, l'horloge noire indique une heure. Une seule."];
 {const oG=STORY.guard;STORY.guard=async(e,seen)=>{if(e.rov||e.id!=='ungai'||!Gates.meets('ungai'))return oG(e,seen);const H=W.H;W.faceTo(e,H);
  if(!S.fl.gp_ungai){S.fl.gp_ungai=1;await D.say(PRE)}else await D.say(J(UG,['本当|ほんとう','の','顔|かお','を','見せて|みせて','。'],'Montre ton vrai visage.'));
  const r=S.fl.visit?(await D.say('(Mode visite : le miroir te laisse passer sans combat.)'),'win'):await Battle.start(EN.ungai,{zone:14});
  if(r!=='win'){delete S.wins.ungai;if(r==='lose')await D.say('Tu reprends tes esprits… Tes PV sont restaurés. Le miroir garde ton reflet. Révise et reviens le reprendre.');else{await W.walk(H,OPP[H.dir],.2);H.cd=6}save();return}
  S.wins.ungai=1;W.remove(e);save();await D.say(POST);sfx('door')}}
 Object.assign(window.Act3,{arrive14,hop14});
})();

