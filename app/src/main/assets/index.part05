  {const bm=Math.round(Math.sin(t*1.6)*1.2);if(XI.BOAT)g.drawImage(XI.BOAT,17*T-8-X,(OY+86)*T-2-Y+bm,32,32);else g.drawImage(boatI||(boatI=boat()),16*T-X,(OY+85)*T-Y+bm)}}
