  return MC[n]=c}
 function cell(n,src,x,y){const k=n+'_'+((x%N+N)%N)+'_'+((y%N+N)%N);if(cellC[k])return cellC[k];const m=macro(n,src),t=src.width,c=document.createElement('canvas');c.width=t;c.height=t;
  c.getContext('2d').drawImage(m,((x%N+N)%N)*t,((y%N+N)%N)*t,t,t,0,0,t,t);return cellC[k]=c}
 function flip(im){let f=FL.get?FL.get(im):null;if(f)return f;const c=document.createElement('canvas');c.width=im.width;c.height=im.height;const g=c.getContext('2d');g.translate(im.width,0);g.scale(-1,1);g.drawImage(im,0,0);FL.set(im,c);return c}
 const hs=(x,y)=>{let h=(x*374761393+y*668265263)>>>0;h=(h^(h>>>13))*1274126177>>>0;return h^(h>>>16)};
 const wrap=()=>{const old=window.DJTILE;if(!old||old.__v)return!!old;
  const nw=(M,c,x,y)=>{const im=old(M,c,x,y);const n=M.dj,s=M.src,o=s&&s[y]&&s[y][x];if(!im||o!=='#'||n===2)return im;
   const dn=s[y+1]&&s[y+1][x];if(dn&&dn!=='#'){const f=XI['T_DJ'+(n===4?1:n)+'_10'];if(f&&im===f&&hs(x,y)%2)return flip(im);return im}
   return cell(n,im,x,y)};
