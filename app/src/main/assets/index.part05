 @keyframes mPress{0%{scale:.92;filter:brightness(1.6)}100%{scale:1;filter:none}}
 html.skin #pBat{background:linear-gradient(rgba(10,14,30,.15),rgba(0,0,8,.45)),var(--uiX) 0 0/430px auto repeat,#161d38!important;border-top:0!important;
  border-image:var(--uiF) 36 0 0 0 / calc(4*var(--u)) 0 0 0 stretch!important;border-style:solid!important;border-width:calc(4*var(--u)) 0 0 0!important;box-shadow:inset 0 calc(4*var(--u)) calc(8*var(--u)) rgba(0,0,8,.55)!important}
 html.skin #bInfo{background:rgba(6,9,22,.45);border-radius:6px;padding:4px 8px;box-shadow:inset 0 0 0 1px rgba(200,150,70,.25)}
 #bCmd.cmd .btn::before{transition:rotate .25s cubic-bezier(.3,1.6,.5,1);filter:drop-shadow(0 calc(.8*var(--q)) calc(.6*var(--q)) rgba(0,0,0,.55))}
 #bCmd.cmd .btn::after{transition:box-shadow .2s}
 @media (prefers-reduced-motion:no-preference){
  #bCmd.cmd .btn:not(.off)::before{animation:gTick 3.2s cubic-bezier(.4,1.8,.6,1) infinite!important}
  #bCmd.cmd .c1:not(.off)::before{animation-name:gTickR!important}
  #bCmd.cmd .btn:not(.off)::after{animation:gGlow 2.6s ease-in-out infinite}
  #bCmd.cmd .c2::after{animation-delay:-.5s!important}#bCmd.cmd .c3::after{animation-delay:-1s!important}#bCmd.cmd .c4::after{animation-delay:-1.5s!important}#bCmd.cmd .c5::after{animation-delay:-2s!important}
  #bCmd.cmd.gIn .btn{animation:gRoll .5s cubic-bezier(.2,.9,.3,1.25) both}
  #bCmd.cmd.gIn .c1{animation:gSpin .55s cubic-bezier(.2,.9,.3,1.3) both}
  #bCmd.cmd.gIn .c2{--gx:85%;--gy:70%;animation-delay:.08s}#bCmd.cmd.gIn .c3{--gx:-85%;--gy:70%;animation-delay:.13s}
  #bCmd.cmd.gIn .c4{--gx:85%;--gy:-70%;animation-delay:.18s}#bCmd.cmd.gIn .c5{--gx:-85%;--gy:-70%;animation-delay:.23s}
  #bCmd.cmd .btn.gHit{animation:gHit .38s ease-out}
  #bCmd.cmd .btn.gHit::before{rotate:60deg;animation:none!important}
  #bCmd.cmd .c1.gHit::before{rotate:-60deg}}
 @keyframes gTick{0%,78%{rotate:0deg}100%{rotate:30deg}}
 @keyframes gTickR{0%,78%{rotate:0deg}100%{rotate:-30deg}}
 /* engrenages dessinés (planche gears_v1) : 16 dents, donc un cran = 22,5° */
