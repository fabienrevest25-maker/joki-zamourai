let CLOUD=null;function cloudSpr(){if(CLOUD)return CLOUD;const mkc=col=>{const c=document.createElement('canvas');c.width=300;c.height=150;const x=c.getContext('2d');for(const[cx2,cy2,r]of[[90,85,55],[150,70,65],[205,88,52],[125,100,45],[180,105,40],[60,98,34],[240,100,30]]){const gr=x.createRadialGradient(cx2,cy2,r*.25,cx2,cy2,r);gr.addColorStop(0,`rgba(${col},1)`);gr.addColorStop(.7,`rgba(${col},.8)`);gr.addColorStop(1,`rgba(${col},0)`);x.fillStyle=gr;x.beginPath();x.arc(cx2,cy2,r,0,7);x.fill()}return c};return CLOUD={wh:mkc('255,255,255'),sh:mkc('20,30,60')}}
let ZBAND=null;const SMKC={};function smokeSpr(col){if(SMKC[col])return SMKC[col];const mkc=(w,h)=>{const c=document.createElement('canvas');c.width=w;c.height=h;return c};
 const p=mkc(99,66),x=p.getContext('2d'),r=30;x.fillStyle=`rgb(${col})`;x.beginPath();x.arc(42,33,r,0,7);x.arc(42+r*.8,33-r*.35,r*.7,0,7);x.arc(42-r*.7,33+r*.2,r*.6,0,7);x.fill();
 const b=mkc(140,42),y=b.getContext('2d'),gr=y.createRadialGradient(70,70,2,70,70,70);gr.addColorStop(0,`rgba(${col},1)`);gr.addColorStop(1,`rgba(${col},0)`);y.scale(1,.3);y.fillStyle=gr;y.beginPath();y.arc(70,70,70,0,7);y.fill();
 return SMKC[col]={puff:p,band:b}}
const BHR=window.__BHR={"X_H_TOWER": 2.6,"X_K_WRECK": 1.902,"X_P_HANGAR": 1.902, "X_P_SHIP": 1.902, "X_C_TRAM": 1.902, "X_G_GATE": 1.902, "X_F_HALL": 1.902, "X_R_FERRY": 1.902, "X_A_SEKI": 1.902, "X_DOJO": 1.748, "X_FORGE": 1.5, "X_F_BARR": 1.901, "X_F_WARE": 1.3, "X_F_PUMP": 1.299, "X_F_CANT": 1.299, "X_R_0": 1.251, "X_R_1": 1.248, "X_R_2": 1.25, "X_R_3": 1.302, "X_H_FARM": 1.199};
function drawBld(X,b,ox,oy){let im=XI[b.im];if(!im||!im.width)return;if(b.tint)im=tintImg(im,b.tint);const sc=(b.sc||1)/(BHR[b.im]||1),w=im.width/3*sc,h=im.height/3*sc,cxm=b.x*T+b.w*T/2+(b.ddx||0)-ox,by=(b.y+b.h)*T+2-oy;const up_=(b.sc||1)/(BHR[b.im]||1)>1.05,sm_=X.imageSmoothingEnabled;if(up_){X.imageSmoothingEnabled=true;X.imageSmoothingQuality='high'}if(b.flip){X.save();X.translate(Math.round(cxm),0);X.scale(-1,1);X.drawImage(im,-w/2,Math.round(by-h),w,h);X.restore()}else X.drawImage(im,Math.round(cxm-w/2),Math.round(by-h),w,h);if(up_)X.imageSmoothingEnabled=sm_}
function solid(x,y){if(window.XSOLID&&XSOLID(MID,x,y))return true;const c=at(x,y);if(M.bld)for(const b of M.bld)if(x>=b.x&&x<b.x+b.w&&y>=bldWall(b)&&y<b.y+b.h)return !(M.warps||[]).some(w=>w.x===x&&w.y===y)&&!(MID==='world'&&window.BFREE&&BFREE.has(x+','+y));if(c==='G')return gateClosed(x,y);return SOLID.includes(c)&&!(MID==='world'&&window.XFREE&&XFREE(x,y,c))}
function blocked(x,y,ex){return solid(x,y)||!!entAt(x,y,ex)||(ex!==H&&H.x===x&&H.y===y)}
function startMove(e,d,dur,hop){const[dx,dy]=DIRS[d];e.dir=d;e.mv={fx:e.x,fy:e.y,tx:e.x+dx*(hop?2:1),ty:e.y+dy*(hop?2:1),p:0,dur:dur*(hop?1.7:1),hop:!!hop};e.x=e.mv.tx;e.y=e.mv.ty;e.stepN++}
function advance(e,dt){const m=e.mv;if(!m)return false;m.p+=dt/m.dur;const p=Math.min(1,m.p);e.px=m.fx+(m.tx-m.fx)*p;e.py=m.fy+(m.ty-m.fy)*p;e.fr=(p>.2&&p<.8)?(e.stepN%2?1:2):0;if(m.p>=1){e.over=(m.p-1)*m.dur;e.px=e.x;e.py=e.y;e.mv=null;e.fr=0;return true}return false}
function bfs(tx,ty,adj){const key=(x,y)=>y*M.w+x,prev=new Map(),q=[[H.x,H.y]];prev.set(key(H.x,H.y),null);let best=null,bd=1e9,n=0;
 while(q.length&&n++<3000){const[x,y]=q.shift(),d=Math.abs(x-tx)+Math.abs(y-ty);if(d<bd&&!(adj&&d===0)){bd=d;best=[x,y]}if(d===(adj?1:0))break;
  for(let i=0;i<4;i++){const nx=x+DIRS[i][0],ny=y+DIRS[i][1],k=key(nx,ny);if(prev.has(k)||nx<0||ny<0||nx>=M.w||ny>=M.h)continue;const c=at(nx,ny);
   if(c==='^'){if(i!==0||blocked(nx,ny+1))continue;prev.set(key(nx,ny+1),[x,y]);prev.set(k,[x,y]);q.push([nx,ny+1]);continue}
   if(blocked(nx,ny))continue;prev.set(k,[x,y]);q.push([nx,ny])}}
 const p=[];let c=best;while(c&&!(c[0]===H.x&&c[1]===H.y)){p.unshift(c);c=prev.get(key(c[0],c[1]))}return p}
/* --- chargement --- */
function load(id,x,y,dir){ents.forEach(e=>{if(e.onArr&&e.onArr.w){e.mv=null;e.onArr()}});MID=id;M=MAPS[id];if(id==='world'){const ok=(a,b)=>M.rows[b]&&M.rows[b][a]&&!SOLID.includes(M.rows[b][a]);if(!ok(x,y)){let f=null;for(let r=1;r<24&&!f;r++)for(let dy=-r;dy<=r&&!f;dy++)for(let dx=-r;dx<=r;dx++)if(Math.max(Math.abs(dx),Math.abs(dy))===r&&ok(x+dx,y+dy)){f=[x+dx,y+dy];break}if(f){x=f[0];y=f[1]}}}{const P_=window.__SPL||(window.__SPL={});for(const s_ of [...STR.values(),...SFREE]){if(s_&&s_.c){const a_=P_[s_.c.width]||(P_[s_.c.width]=[]);if(a_.length<5&&!a_.includes(s_))a_.push(s_)}}SFREE=P_[M.w*T*3]||[];P_[M.w*T*3]=[]}if(window.WAN)WAN.reset();STR=new Map();SDONE=[];ANI=[];BAMF=[];SROW={};TGF={};ents=[];fx=[];emo=null;
 (NPCS[id]||[]).forEach(n=>{if(n.cond&&!n.cond())return;ents.push(mkEnt(Object.assign({npc:1},n)))});
 if(id==='world'&&!window.PRO){GUARD.forEach(gd=>{if(!S.wins[gd.id])ents.push(mkEnt(Object.assign({guard:1},gd)))});
  ITEMS.forEach(it=>{if(it.m===id&&!S.fl[it.id])ents.push(mkEnt(Object.assign({item:1},it)))});
  ROVERS.forEach((r,ri)=>{if(ri%5!==4&&!ROVD.has(r.id))ents.push(mkEnt(Object.assign({guard:1,rov:1},r,{k:r.k==='yoma'&&zoneAt(r.y)===1?'tayoma':r.k})))});
  ELITES.forEach(r=>{if(zoneCleared(r.z)&&!ROVD.has(r.id))ents.push(mkEnt({guard:1,rov:1,el:1,id:r.id,x:r.x,y:r.y,k:r.k+'2'}))});
  HIDS.forEach(h=>{if(!S.fl[h.id])ents.push(mkEnt({item:1,hid:1,id:h.id,x:h.x,y:h.y,z:h.z}))});
  ents.push(mkEnt({boss:1,big:1,x:9,y:Y5+4,id:'boss'}));
  for(let yy=0;yy<M.h;yy++)for(let xx=0;xx<M.w;xx++)if(at(xx,yy)==='J')ents.push(mkEnt({jizo:1,x:xx,y:yy}))}
 H.x=x;H.y=y;H.px=x;H.py=y;H.mv=null;H.path=[];H.pend=null;if(dir!==undefined)H.dir=dir;lastZone=-1;camera(true);zoneCheck(true)}
function zoneCheck(quiet){const z=M.inside?100:zoneAt(H.y);if(z===lastZone)return;lastZone=z;const nm=M.inside?{jp:M.name[0].split?[M.name[0]]:M.name[0],fr:M.name[1]}:ZONES[z];
 music(M.inside?M.music:ZONES[z].mus);UI.banner(nm.jp,nm.fr)}
function camera(){const vw=160,vh=Math.ceil(SH*2/3),mw=M.w*T,mh=M.h*T,hx=H.px*T+8,hy=H.py*T+8;
 cx=mw<=vw?-(vw-mw)/2:clamp(Math.round(hx-vw/2),0,mw-vw);cy=mh<=vh?-(vh-mh)/2:clamp(Math.round(hy-vh/2),0,mh-vh);if(G.busy&&mh>vh){let f=null,bd=9;for(const e of ents){if(!(e.guard||e.rov||e.boss))continue;const d=Math.abs(e.x-H.x)+Math.abs(e.y-H.y);if(d<=4&&d<bd&&e.y<=H.y){bd=d;f=e}}
  /* pendant une rencontre, le gardien ou le yōkai ne reste pas caché sous le bandeau du haut et les boutons */
  if(f){const ey=f.py*T,top=Math.round(vh*.36);if(ey-cy<top)cy=clamp(Math.round(ey-top),0,mh-vh);if(hy+8-cy>vh-T)cy=clamp(Math.round(hy+8-vh+T),0,mh-vh)}}
 if(MID==='world'&&window.CAMCLAMP)cy=CAMCLAMP(cy,vh,H.py);cx=Math.round(cx);cy=Math.round(cy)}
window.CAMXY=()=>[cx,cy];
/* --- évènements --- */
async function ev(fn){if(G.busy)return;G.busy=true;H.path=[];H.pend=null;Input.dir=-1;try{await fn()}catch(e){console.error(e)}finally{G.busy=false;if(G.scene==='world')UI.panel('pad')}}
function faceTo(a,b){const dx=b.x-a.x,dy=b.y-a.y;a.dir=Math.abs(dx)>Math.abs(dy)?(dx<0?2:3):(dy<0?1:0)}
function emote(e,ms){return new Promise(r=>{emo={e,t:0};sfx('alert');setTimeout(()=>{emo=null;r()},ms||650)})}
function walk(e,d,dur){return new Promise(r=>{if(e!==H&&!ents.includes(e))return r(false);if(blocked(e.x+DIRS[d][0],e.y+DIRS[d][1],e)){e.dir=d;return r(false)}startMove(e,d,dur||.26);const f=()=>{e.onArr=null;r(true)};f.w=1;e.onArr=f})}
async function walkNear(e,t){for(let i=0;i<14;i++){const dx=t.x-e.x,dy=t.y-e.y;if(Math.abs(dx)+Math.abs(dy)<=1)break;const d=Math.abs(dy)>=Math.abs(dx)?(dy>0?0:1):(dx<0?2:3);if(!(await walk(e,d,.2))){const d2=Math.abs(dy)>=Math.abs(dx)?(dx<0?2:3):(dy>0?0:1);if(!(await walk(e,d2,.2)))break}}faceTo(e,t);faceTo(t,e)}
function interactAt(x,y){const e=entAt(x,y);
 if(e){if(e.npc){faceTo(e,H);return ev(()=>STORY[e.ev](e))}if(e.guard)return ev(()=>STORY.guard(e));if(e.item)return ev(()=>STORY.item(e));if(e.jizo)return ev(()=>STORY.jizo(e));if(e.boss)return ev(()=>STORY.well(e))}
 if(window.XINT){const f=XINT(MID,x,y);if(f)return ev(f)}
 const c=at(x,y);if(MID==='world'&&(c==='Q'||c==='Z')&&window.PUZI)return ev(()=>PUZI(x,y,c));if(c==='S'){const s=SIGNS[MID+':'+x+','+y];if(s)return ev(()=>STORY.sign(s))}
 if(c==='y'){const e2=entAt(x+DIRS[H.dir][0],y+DIRS[H.dir][1]);if(e2&&e2.npc)return ev(()=>STORY[e2.ev](e2))}
 if(c==='R')return ev(()=>STORY.scroll());if(c==='q')return ev(()=>STORY.rack());if(c==='g')return ev(()=>STORY.forge());if(c==='G'&&gateClosed(x,y))return ev(()=>STORY.gate(M.gates.find(q=>q.y===y)));
 if(MID==='world'&&x===3&&y===OY+86)return ev(()=>STORY.home());}
function interact(){if(G.busy||H.mv)return;const[dx,dy]=DIRS[H.dir];interactAt(H.x+dx,H.y+dy)}
function arrive(){if(window.XARR&&XARR(MID,H.x,H.y,!!Input.run))return;
 const c=at(H.x,H.y);if(c==='w'){sfx('grass');fx.push({k:'rustle',x:H.x,y:H.y,t:0})}else{sfx('step');fx.push({k:'dust',x:H.px,y:H.py,t:0});if(Input.run||Input.b)fx.push({k:'dust',x:H.px-DIRS[H.dir][0]*.4,y:H.py-DIRS[H.dir][1]*.4,t:-.08})}
 S.steps=(S.steps||0)+1;sinceEnc++;
 const wp=(M.warps||[]).find(w=>w.x===H.x&&w.y===H.y);if(wp){H.path=[];return ev(()=>warp(wp))}
 zoneCheck();
 if(MID!=='world'&&window.ITRIG){const tr=ITRIG(MID,H.x,H.y);if(tr){H.path=[];return ev(tr)}}if(MID==='world'){S.pos={m:MID,x:H.x,y:H.y,d:H.dir};const tr=STORY.triggers(H.x,H.y);if(tr){H.path=[];return ev(tr)}
  if(losCheck())return;
  if((c==='w'||c==='s')&&!S.fl.visit&&sinceEnc>2&&Math.random()<(MID==='world'&&window.PUZCALM&&PUZCALM(H.y)?.08:.25)*(window.ENCMUL?ENCMUL():1)){sinceEnc=0;H.path=[];return ev(()=>STORY.wild(zoneAt(H.y)))}}
 if(H.pend&&!H.path.length){const t=H.pend,e=t[2];if(e&&!e.gone){t[0]=e.x;t[1]=e.y}if(Math.abs(t[0]-H.x)+Math.abs(t[1]-H.y)===1){H.pend=null;faceTo(H,{x:t[0],y:t[1]});interactAt(t[0],t[1])}else if(e&&(t[3]=(t[3]||0)+1)<4){H.path=bfs(t[0],t[1],true)}else H.pend=null}}
async function warp(wp){sfx('door');let tx=wp.tx,ty=wp.ty;if(MID==='world')S.ret={x:wp.x,y:wp.y+1};if(wp.ret){const r=S.ret||{x:3,y:OY+87};tx=r.x;ty=r.y}await UI.fade(1,220);load(wp.to,tx,ty,wp.to==='world'?0:1);S.pos=wp.to==='world'?{m:'world',x:tx,y:ty,d:0}:S.pos;await UI.fade(0,220)}
function losCheck(){if(S.fl.visit)return false;for(const e of ents){if(!e.guard||e.gone||e.mv||H.cd>0)continue;const dx=H.x-e.x,dy=H.y-e.y,ad=Math.abs(dx)+Math.abs(dy);let see=Math.hypot(dx,dy)<=1.9&&zoneAt(H.y)===zoneAt(e.hy);
  if(!see&&(dx===0||dy===0)&&ad<=3){const d=dx===0?(dy>0?0:1):(dx<0?2:3);if(d===e.dir){see=true;for(let k=1;k<ad;k++)if(solid(e.x+DIRS[d][0]*k,e.y+DIRS[d][1]*k))see=false}}
  if(see){H.path=[];ev(()=>STORY.guard(e,true));return true}}return false}
/* --- boucle --- */
function step(dt){H.over=0;
 if(shakeT>0)shakeT-=dt;if(H.cd>0)H.cd-=dt;
 fx.forEach(f=>f.t+=dt);fx=fx.filter(f=>f.t<.4);if(emo)emo.t+=dt;
 for(const e of ents){if(e.mv){if(advance(e,dt)&&e.onArr)e.onArr();continue}
  if(G.busy||e.item||e.jizo||e.boss)continue;
  if(e.guard||e.wander){e.t-=dt;if(e.t<=0){e.t=(e.guard?1.1:.5)+Math.random()*(e.guard?1.9:2.4);const d=rnd(4),nx=e.x+DIRS[d][0],ny=e.y+DIRS[d][1],r=e.guard?2:e.wander;
   if(e.guard&&losCheck())return;
   if(Math.random()<.35){e.dir=d;if(e.guard&&losCheck())return}
   else if(Math.abs(nx-e.hx)<=r&&Math.abs(ny-e.hy)<=r&&!blocked(nx,ny,e)&&!'w^sG'.includes(at(nx,ny))&&zoneAt(ny)===zoneAt(e.hy)){startMove(e,d,e.guard?.34:.4);e.onArr=()=>{e.onArr=null;if(e.guard)losCheck()}}}}}
 if(H.mv){if(advance(H,dt)){if(H.onArr){const f=H.onArr;H.onArr=null;f()}else arrive()}camera();if(H.mv)return}
 camera();if(G.busy)return;
 let d=-1;
 if(Input.dir>=0){d=Input.dir;H.path=[];H.pend=null;if(H.dir!==d&&turnT<=0){H.dir=d;turnT=.09;return}if(turnT>0){turnT-=dt;return}}
 else{turnT=0;if(H.path.length){const n=H.path[0];let k=-1;for(let i=0;i<4;i++)if(H.x+DIRS[i][0]===n[0]&&H.y+DIRS[i][1]===n[1])k=i;
   if(k<0&&H.x===n[0]&&H.y+2===n[1]&&at(H.x,H.y+1)==='^')k=0;if(k<0){H.path=[]}else{d=k;H.path.shift()}}}
 if(d<0)return;
 const nx=H.x+DIRS[d][0],ny=H.y+DIRS[d][1],c=at(nx,ny);H.dir=d;
 if(c==='^'){if(d===0&&!blocked(nx,ny+1)){sfx('hop');startMove(H,0,.2,true)}else if(Input.dir>=0&&!H.bump){H.bump=1;sfx('bump');setTimeout(()=>H.bump=0,300)}return}
 if(blocked(nx,ny)){if(window.XPUSH&&XPUSH(MID,nx,ny,DIRS[d][0],DIRS[d][1],d)){H.path=[];return}H.path=[];if(Input.dir>=0&&!H.bump){H.bump=1;sfx('bump');setTimeout(()=>H.bump=0,300)}return}
 const ov_=H.over;startMove(H,d,Input.run&&Input.dir>=0?.13:.22);if(ov_>0&&H.mv){advance(H,Math.min(ov_,.05));camera()}}
const CHN={hana:'hana',kakashi:'doro',karakasa:'chochin',smoke:'karakuri',toad:'kamado',nuri:'nuri',wanyudo:'wanyudog'},GTINT={kakashi:'dark',karakasa:'r',smoke:'ink',toad:'warm'},GSC={nuri:1.15,umi:1.5,wanyudo:1.35,kyorin:1.3,baku:1.7};
/* variations d'habits : on tourne la teinte des tissus colorés, sans toucher à la peau ni aux gris */
const CLOC=new Map();function clothImg(im,k){let m=CLOC.get(im);if(!m)CLOC.set(im,m={});if(m[k])return m[k];const c=document.createElement('canvas');c.width=im.width;c.height=im.height;const x=c.getContext('2d');x.drawImage(im,0,0);
 const rot=[0,65,130,195,250,300,160][k%7]/360,dk=k===6?.8:1;
 try{const id=x.getImageData(0,0,c.width,c.height),d=id.data;for(let i=0;i<d.length;i+=4){if(d[i+3]<20)continue;const r=d[i]/255,g=d[i+1]/255,b=d[i+2]/255,mx=Math.max(r,g,b),mn=Math.min(r,g,b),l=(mx+mn)/2,dd=mx-mn;if(dd<.12)continue;
  const s_=dd/(1-Math.abs(2*l-1));let h=mx===r?((g-b)/dd+6)%6:mx===g?(b-r)/dd+2:(r-g)/dd+4;h/=6;
  if((h<.15||h>.96)&&l>.28)continue;/* peau */
  h=(h+rot)%1;const q=l<.5?l*(1+s_):l+s_-l*s_,p=2*l-q,f=t=>{t=(t+1)%1;return t<1/6?p+(q-p)*6*t:t<.5?q:t<2/3?p+(q-p)*(2/3-t)*6:p};
  d[i]=f(h+1/3)*255*dk;d[i+1]=f(h)*255*dk;d[i+2]=f(h-1/3)*255*dk}x.putImageData(id,0,0)}catch(e){}c.hd=1;return m[k]=c}
function hdc_(n,d,f){const i=XI['C_'+n+'_'+d+(f||0)];return i&&i.width?i:null}
const isHD=im=>im instanceof HTMLImageElement||!!im.hd;
function spr(e){if(e.img)return e.img;if(e===H){const n=(window.PROHERO&&PROHERO())||STG[stage(S.xp)],i=hdc_(n,H.dir,H.fr)||hdc_(n,H.dir,0)||hdc_(n,0,0);return i&&S.fl&&S.fl.yukataOn?clothImg(i,2):i&&S.fl&&S.fl.legend&&S.fl.legendOn?clothImg(i,5):i}if(e.npc){const i=hdc_(e.spr,e.dir,e.fr)||hdc_(e.spr,e.dir,0)||hdc_(e.spr,0,0);return i&&e.cl?clothImg(i,e.cl):i}if(e.rov){const K=RKIND[e.k],im=hdc_(K.s,e.dir,e.fr)||hdc_(K.s,e.dir,0);return im?(K.tint?tintImg(im,K.tint):im):miniWisp('#8a58c8')}if(e.guard){const im=hdc_(CHN[e.id]||e.id,e.dir,e.fr)||hdc_(CHN[e.id]||e.id,e.dir,0);if(im)return GTINT[e.id]?tintImg(im,GTINT[e.id]):im;return typeof ESP[e.id]==='function'?(ESC[e.id]||(ESC[e.id]=ESP[e.id]())):null}if(e.item){if(e.hid)return hidSpark(e);return okI('X_BUNDLE')?XI.X_BUNDLE:tl('bd',bundle)}if(e.jizo)return JZI[zoneAt(e.y)]&&okI(JZI[zoneAt(e.y)])?XI[JZI[zoneAt(e.y)]]:zoneAt(e.y)===8&&okI('X_RJIZO')?XI.X_RJIZO:zoneAt(e.y)===7&&okI('X_AJIZO')?XI.X_AJIZO:zoneAt(e.y)===6&&okI('X_SJIZO')?XI.X_SJIZO:XI.X_JIZO;return null}
