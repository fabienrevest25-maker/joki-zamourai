 if(!wrap()){let n=0;const iv=setInterval(()=>{if(wrap()||++n>200)clearInterval(iv)},50)}})();
/* ---------- fenêtres habillées et animées ----------
   Habillage : cadre de laiton de la planche (UI_FRAME, en 9 morceaux), fond en papier washi indigo (UI_TEX1, répété),
   plaque de nom en laiton (UI_PLATE), triangle « suite » (UI_TRI) et flèche de choix (UI_ARR). En ligne, ces images arrivent avec fx_img.txt :
   l'habillage se met en place dès qu'elles sont là. Animations : ouverture (la fenêtre se déplie avec un éclat du laiton), fermeture (elle se replie),
   enchaînement (si elle se rouvre aussitôt, seul le texte glisse), plaque de nom qui tombe en place, choix qui arrivent un par un,
   panneaux de PV qui glissent depuis les côtés. Rien n'est dessiné : ce sont des transformations des fenêtres elles-mêmes. */
window.UIS=(()=>{
 const css=`html.skin .gbox{border-style:solid!important;border-width:calc(3*var(--u))!important;border-color:transparent!important;
  border-image:var(--uiF) 66 / calc(9.2*var(--u)) / calc(2*var(--u)) stretch!important;border-radius:0!important;
  background:linear-gradient(rgba(150,170,255,.05),rgba(0,0,10,.22)),var(--uiX) 0 0/calc(var(--uiW)*var(--u)) auto repeat,#161d38!important;background-clip:padding-box!important;
  box-shadow:inset 0 0 calc(6*var(--u)) rgba(0,0,8,.6),0 calc(2*var(--u)) calc(5*var(--u)) rgba(0,0,0,.45)!important}
 html.skin #dlg:before,html.skin #dlg:after{display:none!important}
 html.skin #dlgN{background:none!important;border-style:solid!important;border-color:transparent!important;border-width:0 calc(3.6*var(--u))!important;border-radius:0!important;
  border-image:var(--uiP) 0 26 fill / 0 calc(3.6*var(--u)) stretch!important;padding:calc(1.4*var(--u)) calc(1.5*var(--u))!important;color:#2a1806!important;text-shadow:0 1px 0 rgba(255,236,190,.55)!important;top:calc(-13.5*var(--u))!important;box-shadow:0 calc(1*var(--u)) calc(2*var(--u)) rgba(0,0,0,.45)}
 html.skin #dlgA{color:transparent!important;text-shadow:none!important;background:var(--uiT) center/contain no-repeat;width:calc(7*var(--u));height:calc(6*var(--u));filter:drop-shadow(0 0 calc(1.5*var(--u)) rgba(255,200,90,.55))}
 html.skin #choice button:before{content:''!important;background:var(--uiA) center/contain no-repeat;width:calc(5*var(--u));height:calc(6.5*var(--u));top:calc(2.5*var(--u))!important;filter:drop-shadow(0 0 calc(1*var(--u)) rgba(255,200,90,.6))}
 html.skin .gbox:not(.hidden){animation:none}
 html.skin #study,html.skin #banner{border-style:solid!important;border-color:transparent!important;border-width:8px!important;border-image:var(--uiF) 66 / 19px / 4px stretch!important;border-radius:0!important;
  background:linear-gradient(rgba(150,170,255,.05),rgba(0,0,10,.22)),var(--uiX) 0 0/440px auto repeat,#161d38!important;background-clip:padding-box!important;box-shadow:inset 0 0 16px rgba(0,0,8,.6),0 3px 6px rgba(0,0,0,.4)!important}
 html.skin #banner{border-width:calc(3*var(--u))!important;border-image:var(--uiF) 66 / calc(8*var(--u)) / calc(1.5*var(--u)) stretch!important}
 /* écran-titre : boutons de laiton (planche), « Continuer » en plaque de laiton qui brille, logo qui s'installe, engrenage qui avance cran par cran */
 /* boutons : le cadre des fenêtres (double filet de laiton, coins ornés) et le fond en papier washi. Le bouton principal est réchauffé (lueur de laiton, texte doré). */
 html.skin #pTitle .btn,html.skin #mTabs button,html.skin #mGrp button,html.skin #mClose,html.skin #mHome,html.skin #kStart,html.skin #dCh .btn{border-style:solid!important;border-color:transparent!important;border-radius:0!important;
  background:linear-gradient(rgba(150,170,255,.07),rgba(0,0,10,.26)),var(--uiX) 0 0/300px auto repeat,#161d38!important;background-clip:padding-box!important;color:#efe9d8!important;text-shadow:0 1px 0 #000!important;position:relative}
 html.skin #pTitle .btn,html.skin #dCh .btn{border-width:5px!important;border-image:var(--uiF) 66 / 16px / 3px stretch!important;box-shadow:inset 0 0 12px rgba(0,0,8,.6),0 3px 6px rgba(0,0,0,.45)!important;overflow:visible}
 html.skin #mTabs button,html.skin #mGrp button,html.skin #mClose,html.skin #mHome,html.skin #kStart{border-width:4px!important;border-image:var(--uiF) 66 / 11px / 2px stretch!important;box-shadow:inset 0 0 8px rgba(0,0,8,.55),0 2px 4px rgba(0,0,0,.4)!important}
 html.skin #pTitle .btn small,html.skin #mTabs button small{color:#cbbf98!important;opacity:1!important}
 /* bouton principal et onglet ouvert : plaque de laiton massif, avec un reflet qui la traverse */
 html.skin #pTitle .btn.pri,html.skin #mTabs button.on,html.skin #mGrp button.on{background:none!important;border-image:var(--uiP) 0 26 fill / 0 18px stretch!important;border-width:0 18px!important;
  color:#2a1806!important;text-shadow:0 1px 0 rgba(255,236,190,.6)!important;box-shadow:0 0 10px rgba(255,200,100,.3),0 3px 6px rgba(0,0,0,.45)!important;overflow:hidden}
 html.skin #pTitle .btn.pri{padding-block:15px!important}
 html.skin #mTabs button.on,html.skin #mGrp button.on{border-image-width:0 12px!important;border-width:0 12px!important;padding-block:9px!important}
 html.skin #pTitle .btn.pri small,html.skin #mTabs button.on small{color:#4a3010!important}
 html.skin #mTabs button.on::after{background:#7a5420!important;box-shadow:none!important}
 html.skin #pTitle .btn.pri::before,html.skin #mTabs button.on::before,html.skin #mGrp button.on::before{content:''!important;position:absolute;top:-30%;bottom:-30%;left:-45%;right:auto;height:auto;width:28%;background:linear-gradient(100deg,transparent,rgba(255,250,220,.65),transparent)!important;pointer-events:none;animation:tShine 4.8s ease-in-out infinite}
 html.skin #mTabs button.on::before{animation-duration:5.6s}html.skin #mGrp button.on::before{animation-duration:6.4s;animation-delay:-2s}
 html.skin #pTitle .btn:active,html.skin #mTabs button:active,html.skin #mGrp button:active,html.skin #mClose:active,html.skin #mHome:active,html.skin #kStart:active,html.skin #dCh .btn:active{filter:brightness(1.25);translate:0 1px}
 html.skin #pTitle p{color:#b9b39e!important;text-shadow:0 1px 2px #000}
 /* menu du jeu : panneau washi, page encadrée */
 html.skin #pMenu{background:linear-gradient(rgba(10,14,30,.1),rgba(0,0,8,.42)),var(--uiX) 0 0/430px auto repeat,#161d38!important;border-style:solid!important;border-color:transparent!important;border-width:calc(4*var(--u)) 0 0 0!important;border-image:var(--uiF) 36 0 0 0 / calc(4*var(--u)) 0 0 0 stretch!important}
 html.skin #mBody{border-style:solid!important;border-color:transparent!important;border-width:12px!important;border-image:var(--uiF) 66 / 24px / 3px stretch!important;border-radius:0!important;background:linear-gradient(rgba(150,170,255,.04),rgba(0,0,10,.2)),var(--uiX) 0 0/430px auto repeat,#161d38!important;background-clip:padding-box!important;box-shadow:inset 0 0 18px rgba(0,0,8,.55)!important;margin-top:4px!important}
 html.skin #pPad .hud{border-style:solid!important;border-color:transparent!important;border-width:7px!important;border-image:var(--uiF) 66 / 17px / 2px stretch!important;border-radius:0!important;background-clip:padding-box!important}
 @media (prefers-reduced-motion:no-preference){
  html.skin #tit.tIn .ring{animation:tLogo 1.1s cubic-bezier(.2,.8,.3,1.2) both}
  html.skin #tit.tIn .en{animation:tEn 1s .45s ease-out both}
  html.skin #tit .ring svg{animation:tTick 2.8s cubic-bezier(.4,1.8,.6,1) infinite!important}
  html.skin #tit .jp{animation:tGlow 4.2s ease-in-out infinite!important}
  html.skin #pTitle.tIn .btn{animation:tUp .55s cubic-bezier(.2,.8,.3,1.25) both}
  html.skin #pTitle.tIn .btn:nth-of-type(1){animation-delay:.75s}html.skin #pTitle.tIn .btn:nth-of-type(2){animation-delay:.88s}
  html.skin #pTitle.tIn .btn:nth-of-type(3){animation-delay:1.01s}html.skin #pTitle.tIn .btn:nth-of-type(4){animation-delay:1.14s}
  html.skin #pTitle.tIn p{animation:uiTxt 1.4s 1.2s both}
  html.skin #pMenu.mIn{animation:mSlide .36s cubic-bezier(.2,.8,.3,1.08) both}
  html.skin #pMenu.mIn #mGrp button,html.skin #pMenu.mIn #mTabs button{animation:mDrop .4s cubic-bezier(.3,.7,.3,1.3) both}
  html.skin #pMenu.mIn #mGrp button:nth-child(2),html.skin #pMenu.mIn #mTabs button:nth-child(2){animation-delay:.05s}
  html.skin #pMenu.mIn #mGrp button:nth-child(3),html.skin #pMenu.mIn #mTabs button:nth-child(3){animation-delay:.1s}
  html.skin #pMenu.mIn #mTabs button:nth-child(4){animation-delay:.15s}html.skin #pMenu.mIn #mTabs button:nth-child(5){animation-delay:.2s}html.skin #pMenu.mIn #mTabs button:nth-child(n+6){animation-delay:.25s}
  html.skin #pMenu.mIn #mBody{transform-origin:50% 0;animation:uiOpen .42s .12s cubic-bezier(.2,.8,.3,1.1) both}
  html.skin #pMenu.mIn #mClose,html.skin #pMenu.mIn #mHome{animation:tUp .4s .2s ease-out both}
  html.skin #mBody.uiS>*{animation:mPage .28s ease-out both}
  html.skin #mTabs button.on,html.skin #mGrp button.on{animation:mPress .3s ease-out}}
 @keyframes tLogo{0%{opacity:0;scale:.55;filter:brightness(3) blur(2px)}60%{opacity:1;scale:1.06;filter:brightness(1.5)}100%{scale:1;filter:none}}
