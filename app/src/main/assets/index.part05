/* ---------- leçons de grammaire, suite (Maître Kotoba, dojos des mots) ---------- */
{const NEW=[
{id:'l9',zone:2,who:'kotoba',xp:35,title:"〜てください",sub:"Demander poliment : la forme en て",
 cards:[
 {h:"La forme en て",f:"食べる → 食べて",x:"La forme en <b>て</b> sert à relier les verbes et à demander quelque chose. Pour les verbes du type 食べる ou 見る, on remplace る par <b>て</b>. Avec <b>ください</b>, on obtient « …, s'il te plaît ».",
  ex:[{t:['見て|みて','ください','。'],fr:"Regarde, s'il te plaît."},{t:['食べて|たべて','ください','。'],fr:"Mange, s'il te plaît."}]},
 {h:"Les autres verbes",f:"書く → 書いて · 飲む → 飲んで",x:"Pour les autres verbes, la fin change : <b>く → いて</b>, <b>む・ぶ・ぬ → んで</b>, <b>う・つ・る → って</b>, <b>す → して</b>. Une exception : 行く → 行って.",
  ex:[{t:['名前|なまえ','を','書いて|かいて','ください','。'],fr:"Écris ton nom, s'il te plaît."},{t:['水|みず','を','飲んで|のんで','ください','。'],fr:"Bois de l'eau, s'il te plaît."},{t:['ちょっと','待って|まって','ください','。'],fr:"Attends un instant, s'il te plaît."}]},
 {h:"Demander de ne pas faire",f:"〜ないでください",x:"Pour demander de <b>ne pas</b> faire quelque chose : forme négative courte + <b>でください</b>. 入る → 入らないでください.",
  ex:[{t:['ここ','に','入らないで|はいらないで','ください','。'],fr:"N'entre pas ici, s'il te plaît."},{t:['忘れないで|わすれないで','ください','。'],fr:"N'oublie pas, s'il te plaît."}]}],
 ex:[
 {q:'gap',fr:"Attends, s'il te plaît.",t:['＿','ください','。'],a:'待って',o:['待って','待ちて','待つて','待んで'],why:"待つ → 待って (つ → って)."},
 {q:'gap',fr:"Écris ici, s'il te plaît.",t:['ここ','に','＿','ください','。'],a:'書いて',o:['書いて','書って','書きて','書んで'],why:"書く → 書いて (く → いて)."},
 {q:'mcq',p:"Quelle est la forme en て de 飲む (boire) ?",a:'飲んで',o:['飲んで','飲いて','飲って','飲して'],why:"む → んで."},
 {q:'ord',fr:"Regarde ceci, s'il te plaît.",t:['これ','を','見て|みて','ください'],x:['見る|みる']},
 {q:'ord',fr:"Ne mange pas ça, s'il te plaît.",t:['それ','を','食べないで|たべないで','ください'],x:['食べて|たべて']},
 {q:'mcq',p:"Que veut dire cette phrase ?",t:['もう','一度|いちど','言って|いって','ください','。'],a:"Répète encore une fois, s'il te plaît.",o:["Répète encore une fois, s'il te plaît.","Ne le dis plus, s'il te plaît.","Je le dis encore une fois.","Dis-le une seule fois."],why:"言う → 言って. もう一度 = encore une fois."}]},
{id:'l10',zone:3,who:'kotoba',xp:35,title:"〜かったです",sub:"Les adjectifs au passé",
 cards:[
 {h:"Adjectifs en い",f:"おいしい → おいしかったです",x:"On remplace le <b>い</b> final par <b>かった</b>. Au négatif passé : <b>くなかった</b>. Attention, いい est irrégulier : <b>よかった</b>.",
  ex:[{t:['昨日|きのう','は','寒かった|さむかった','です','。'],fr:"Hier, il faisait froid."},{t:['映画|えいが','は','面白かった|おもしろかった','です','。'],fr:"Le film était intéressant."},{t:['高く|たかく','なかった','です','。'],fr:"Ce n'était pas cher."}]},
 {h:"Adjectifs en な et noms",f:"しずか → しずかでした",x:"Avec les adjectifs en な et les noms, c'est です qui passe au passé : <b>でした</b>. Au négatif : <b>じゃなかったです</b>.",
  ex:[{t:['町|まち','は','静か|しずか','でした','。'],fr:"La ville était calme."},{t:['昨日|きのう','は','休み|やすみ','でした','。'],fr:"Hier, c'était congé."},{t:['元気|げんき','じゃなかった','です','。'],fr:"Je n'étais pas en forme."}]}],
 ex:[
 {q:'gap',fr:"Le repas était délicieux.",t:['ごはん','は','＿','です','。'],a:'おいしかった',o:['おいしかった','おいしいでした','おいしくて','おいしだった'],why:"い → かった."},
 {q:'gap',fr:"Le voyage était bien.",t:['旅行|りょこう','は','＿','です','。'],a:'よかった',o:['よかった','いかった','いいでした','よいかった'],why:"いい est irrégulier : よかった."},
 {q:'gap',fr:"Le parc était calme.",t:['公園|こうえん','は','静か|しずか','＿','。'],a:'でした',o:['でした','かったです','くなかった','います'],why:"Adjectif en な : でした."},
 {q:'ord',fr:"Hier, il faisait chaud.",t:['昨日|きのう','は','暑かった|あつかった','です'],x:['暑い|あつい']},
 {q:'mcq',p:"Comment dit-on « Ce n'était pas difficile. » ?",a:'難しくなかったです。',o:['難しくなかったです。','難しいじゃなかったです。','難しかったです。','難しくないでした。'],why:"い → くなかった."},
 {q:'ord',fr:"L'examen était facile.",t:['テスト','は','簡単|かんたん','でした'],x:['かった']}]},
{id:'l11',zone:3,who:'kotoba',xp:35,title:"〜たいです",sub:"Dire ce qu'on veut faire",
 cards:[
 {h:"Vouloir faire",f:"行きます → 行きたいです",x:"On remplace <b>ます</b> par <b>たいです</b>. On l'emploie pour soi-même, ou dans une question posée à quelqu'un.",
  ex:[{t:['日本|にほん','に','行きたい|いきたい','です','。'],fr:"Je veux aller au Japon."},{t:['何|なに','を','食べたい|たべたい','です','か','。'],fr:"Que veux-tu manger ?"},{t:['水|みず','が','飲みたい|のみたい','です','。'],fr:"Je veux boire de l'eau."}]},
 {h:"Ne pas vouloir",f:"〜たくないです",x:"たい se conjugue comme un adjectif en い : <b>たくない</b> (ne pas vouloir), <b>たかった</b> (voulait).",
  ex:[{t:['今日|きょう','は','働きたくない|はたらきたくない','です','。'],fr:"Aujourd'hui, je ne veux pas travailler."},{t:['もっと','寝たかった|ねたかった','です','。'],fr:"Je voulais dormir plus."}]},
 {h:"Vouloir une chose",f:"〜がほしいです",x:"Pour vouloir un <b>objet</b>, on utilise <b>ほしい</b>, avec la particule が.",
  ex:[{t:['新しい|あたらしい','刀|かたな','が','ほしい','です','。'],fr:"Je veux un nouveau sabre."}]}],
 ex:[
 {q:'gap',fr:"Je veux voir un film.",t:['映画|えいが','を','＿','です','。'],a:'見たい',o:['見たい','見ます','見て','見たく'],why:"見ます → 見たい."},
 {q:'gap',fr:"Je ne veux pas rentrer.",t:['＿','です','。'],a:'帰りたくない',o:['帰りたくない','帰りたいない','帰らたくない','帰りたくて'],why:"たい → たくない."},
 {q:'ord',fr:"Je veux manger des sushis.",t:['すし','を','食べたい|たべたい','です'],x:['食べます|たべます']},
 {q:'mcq',p:"Que veut dire cette phrase ?",t:['どこ','に','行きたい|いきたい','です','か','。'],a:"Où veux-tu aller ?",o:["Où veux-tu aller ?","Où es-tu allé ?","Où vas-tu ?","Tu ne veux aller nulle part ?"],why:"行きたい = vouloir aller."},
 {q:'gap',fr:"Je veux de l'eau.",t:['水|みず','が','＿','です','。'],a:'ほしい',o:['ほしい','たい','すき','あります'],why:"Pour un objet : ほしい."},
 {q:'ord',fr:"Je voulais acheter un livre.",t:['本|ほん','を','買いたかった|かいたかった','です'],x:['買いたい|かいたい']}]},
{id:'l12',zone:4,who:'kotoba',xp:35,title:"A は B より",sub:"Comparer",
 cards:[
 {h:"Plus… que",f:"A は B より 大きいです",x:"<b>より</b> correspond au « que » d'une comparaison. Il se place juste après l'élément auquel on compare. L'adjectif ne change pas.",
  ex:[{t:['山|やま','は','町|まち','より','静か|しずか','です','。'],fr:"La montagne est plus calme que la ville."},{t:['肉|にく','は','魚|さかな','より','高い|たかい','です','。'],fr:"La viande est plus chère que le poisson."}]},
 {h:"Lequel des deux ?",f:"A と B と、どちらが…",x:"Pour demander : <b>A と B と、どちらが</b>… ? Pour répondre : <b>A のほうが</b>… (« c'est plutôt A »).",
  ex:[{t:['犬|いぬ','と','猫|ねこ','と','、','どちら','が','好き|すき','です','か','。'],fr:"Entre les chiens et les chats, que préfères-tu ?"},{t:['猫|ねこ','の','ほう','が','好き|すき','です','。'],fr:"Je préfère les chats."}]},
 {h:"Le plus…",f:"一番",x:"<b>一番</b> (いちばん, « numéro un ») devant un adjectif signifie « le plus ».",
  ex:[{t:['これ','が','一番|いちばん','おいしい','です','。'],fr:"C'est celui-ci le plus délicieux."}]}],
 ex:[
 {q:'gap',fr:"Le train est plus rapide que le bus.",t:['電車|でんしゃ','は','バス','＿','速い|はやい','です','。'],a:'より',o:['より','ほう','と','が'],why:"B より = « que B »."},
 {q:'gap',fr:"Je préfère le thé.",t:['お茶|おちゃ','の','＿','が','好き|すき','です','。'],a:'ほう',o:['ほう','より','一番','どちら'],why:"A のほうが = c'est plutôt A."},
 {q:'ord',fr:"Aujourd'hui, il fait plus chaud qu'hier.",t:['今日|きょう','は','昨日|きのう','より','暑い|あつい','です'],x:['ほう']},
 {q:'mcq',p:"Que veut dire cette phrase ?",t:['夏|なつ','と','冬|ふゆ','と','、','どちら','が','好き|すき','です','か','。'],a:"Entre l'été et l'hiver, lequel préfères-tu ?",o:["Entre l'été et l'hiver, lequel préfères-tu ?","Tu aimes l'été et l'hiver ?","L'été est plus chaud que l'hiver ?","Tu n'aimes ni l'été ni l'hiver ?"],why:"どちら = lequel des deux."},
 {q:'gap',fr:"C'est la montagne la plus haute.",t:['これ','は','＿','高い|たかい','山|やま','です','。'],a:'一番',o:['一番','より','ほう','もっと'],why:"一番 (いちばん) = le plus."},
 {q:'ord',fr:"Je préfère le poisson.",t:['魚|さかな','の','ほう','が','好き|すき','です'],x:['より']}]},
{id:'l13',zone:4,who:'kotoba',xp:35,title:"一つ、一人、一本",sub:"Compter les choses",
 cards:[
 {h:"Le compteur universel",f:"ひとつ、ふたつ、みっつ",x:"Pour les objets en général : <b>一つ</b> (ひとつ), <b>二つ</b> (ふたつ), <b>三つ</b> (みっつ), 四つ (よっつ), 五つ (いつつ). Le nombre vient <b>après</b> l'objet et sa particule.",
  ex:[{t:['りんご','を','二つ|ふたつ','ください','。'],fr:"Deux pommes, s'il vous plaît."},{t:['いす','が','三つ|みっつ','あります','。'],fr:"Il y a trois chaises."}]},
 {h:"Les personnes",f:"ひとり、ふたり、さんにん",x:"Pour les gens : <b>一人</b> (ひとり) et <b>二人</b> (ふたり) sont irréguliers, puis nombre + <b>人</b> (にん) : 三人, 四人 (よにん).",
  ex:[{t:['子ども|こども','が','三人|さんにん','います','。'],fr:"Il y a trois enfants."},{t:['一人|ひとり','で','行きます|いきます','。'],fr:"J'y vais seul."}]},
 {h:"Objets longs, objets plats",f:"〜本 · 〜枚",x:"<b>本</b> (ほん) compte les objets longs : bouteilles, sabres, arbres. Le son change : 一本 (いっぽん), 二本 (にほん), 三本 (さんぼん). <b>枚</b> (まい) compte les objets plats : feuilles, billets, assiettes.",
  ex:[{t:['刀|かたな','が','二本|にほん','あります','。'],fr:"Il y a deux sabres."},{t:['紙|かみ','を','一枚|いちまい','ください','。'],fr:"Une feuille de papier, s'il vous plaît."}]},
 {h:"Demander combien",f:"いくつ · 何人 · いくら",x:"<b>いくつ</b> = combien d'objets, <b>何人</b> (なんにん) = combien de personnes, <b>いくら</b> = combien ça coûte.",
  ex:[{t:['これ','は','いくら','です','か','。'],fr:"Combien coûte ceci ?"},{t:['おにぎり','は','いくつ','あります','か','。'],fr:"Combien y a-t-il d'onigiri ?"}]}],
 ex:[
 {q:'mcq',p:"Comment se lit 二つ ?",a:'ふたつ',o:['ふたつ','につ','ふつ','にこ'],why:"一つ ひとつ · 二つ ふたつ · 三つ みっつ."},
 {q:'gap',fr:"Trois onigiri, s'il vous plaît.",t:['おにぎり','を','＿','ください','。'],a:'三つ',o:['三つ','三人','三枚','三本'],why:"Objets en général : つ."},
 {q:'gap',fr:"Il y a deux personnes.",t:['人|ひと','が','＿','います','。'],a:'二人',o:['二人','二つ','二本','二枚'],why:"Les personnes : 二人 (ふたり)."},
 {q:'gap',fr:"Il y a un sabre.",t:['刀|かたな','が','＿','あります','。'],a:'一本',o:['一本','一人','一枚','一冊'],why:"Objet long : 本. 一本 se lit いっぽん."},
 {q:'ord',fr:"Deux thés, s'il vous plaît.",t:['お茶|おちゃ','を','二つ|ふたつ','ください'],x:['二人|ふたり']},
 {q:'mcq',p:"Comment demande-t-on « Combien ça coûte ? »",a:'いくらですか。',o:['いくらですか。','いくつですか。','何人ですか。','どこですか。'],why:"いくら = quel prix."}]}];
 NEW.forEach(L=>{L.ex.forEach((e,i)=>{e.id=L.id+'.'+i;e.les=L.id});L.cards.forEach(c=>c.ex.forEach(e=>phrAdd(e.t,e.fr,L.id)));LESSONS.push(L)})}

/* ---------- leçons de grammaire : conjugaisons et phrases longues (Maître Kotoba) ---------- */
{const NEW=[
{id:'l14',zone:2,who:'kotoba',xp:40,title:"辞書形",sub:"La forme du dictionnaire, et « savoir faire »",
 cards:[
 {h:"Verbes en る",f:"食べます → 食べる",x:"La <b>forme du dictionnaire</b> est celle qu'on trouve dans le dictionnaire et qu'on emploie entre proches. Pour les verbes comme 食べます ou 見ます, on remplace <b>ます</b> par <b>る</b>.",
  ex:[{t:['毎日|まいにち','米|こめ','を','食べる|たべる','。'],fr:"Je mange du riz tous les jours."},{t:['夜|よる','、','月|つき','を','見る|みる','。'],fr:"La nuit, je regarde la lune."}]},
 {h:"Les autres verbes",f:"飲みます → 飲む · 書きます → 書く",x:"Le son en <b>i</b> placé avant ます devient un son en <b>u</b> : み → む, き → く, い → う, り → る, し → す. Deux irréguliers : します → <b>する</b>, 来ます → <b>来る</b> (くる).",
  ex:[{t:['水|みず','を','飲む|のむ','。'],fr:"Je bois de l'eau."},{t:['手紙|てがみ','を','書く|かく','。'],fr:"J'écris une lettre."},{t:['毎朝|まいあさ','、','勉強|べんきょう','する','。'],fr:"Chaque matin, j'étudie."}]},
 {h:"Savoir faire",f:"forme du dictionnaire + ことができます",x:"Pour dire qu'on <b>sait</b> ou qu'on <b>peut</b> faire quelque chose : verbe à la forme du dictionnaire + <b>ことができます</b>. Au négatif : ことができません.",
  ex:[{t:['漢字|かんじ','を','書く|かく','こと','が','できます','。'],fr:"Je sais écrire les kanji."},{t:['日本語|にほんご','を','話す|はなす','こと','が','できます','。'],fr:"Je sais parler japonais."}]}],
 ex:[
 {q:'mcq',p:"Quelle est la forme du dictionnaire de 飲みます (boire) ?",a:'飲む',o:['飲む','飲る','飲みる','飲う'],why:"み → む."},
 {q:'mcq',p:"Quelle est la forme du dictionnaire de 食べます (manger) ?",a:'食べる',o:['食べる','食ぶ','食べう','食べむ'],why:"Verbe en る : on remplace ます par る."},
 {q:'mcq',p:"Quelle est la forme du dictionnaire de します (faire) ?",a:'する',o:['する','しる','す','しむ'],why:"Irrégulier : します → する."},
 {q:'gap',fr:"Je sais lire les kanji.",t:['漢字|かんじ','を','＿','こと','が','できます','。'],a:'読む',o:['読む','読みます','読んで','読み'],why:"Forme du dictionnaire + ことができます. 読みます → 読む."},
 {q:'ord',fr:"Je sais parler japonais.",t:['日本語|にほんご','を','話す|はなす','こと','が','できます'],x:['話します|はなします']},
 {q:'ord',fr:"Je ne sais pas nager.",t:['泳ぐ|およぐ','こと','が','できません'],x:['泳ぎます|およぎます']}]},
{id:'l15',zone:3,who:'kotoba',xp:40,title:"〜たことがあります",sub:"Le passé familier et l'expérience",
 cards:[
 {h:"La forme た",f:"食べて → 食べた · 飲んで → 飲んだ",x:"La forme <b>た</b> est le passé familier. Elle se fabrique comme la forme て : on remplace <b>て</b> par <b>た</b>, et <b>で</b> par <b>だ</b>.",
  ex:[{t:['昨日|きのう','、','魚|さかな','を','食べた|たべた','。'],fr:"Hier, j'ai mangé du poisson."},{t:['お茶|おちゃ','を','飲んだ|のんだ','。'],fr:"J'ai bu du thé."},{t:['町|まち','に','行った|いった','。'],fr:"Je suis allé en ville."}]},
 {h:"Avoir déjà fait",f:"〜たことがあります",x:"Forme た + <b>ことがあります</b> : « il m'est déjà arrivé de… ». Au négatif, <b>ことがありません</b> : « je n'ai jamais… ».",
  ex:[{t:['京都|きょうと','に','行った|いった','こと','が','あります','。'],fr:"Je suis déjà allé à Kyōto."},{t:['すし','を','食べた|たべた','こと','が','ありません','。'],fr:"Je n'ai jamais mangé de sushi."},{t:['妖魔|ようま','を','見た|みた','こと','が','あります','か','。'],fr:"As-tu déjà vu un Yōma ?"}]}],
 ex:[
 {q:'mcq',p:"Quelle est la forme た de 書く (écrire) ?",a:'書いた',o:['書いた','書った','書きた','書んだ'],why:"書く → 書いて → 書いた."},
 {q:'mcq',p:"Quelle est la forme た de 読む (lire) ?",a:'読んだ',o:['読んだ','読いた','読った','読みた'],why:"む → んで → んだ."},
 {q:'gap',fr:"Je suis déjà allé dans la forêt.",t:['森|もり','に','＿','こと','が','あります','。'],a:'行った',o:['行った','行って','行く','行きます'],why:"Forme た + ことがあります. 行く → 行った."},
 {q:'gap',fr:"Je n'ai jamais vu la mer.",t:['海|うみ','を','見た|みた','こと','が','＿','。'],a:'ありません',o:['ありません','あります','いません','できません'],why:"« Jamais » : ことがありません."},
 {q:'ord',fr:"As-tu déjà bu du thé ?",t:['お茶|おちゃ','を','飲んだ|のんだ','こと','が','あります','か'],x:['飲む|のむ']},
 {q:'mcq',p:"Que veut dire cette phrase ?",t:['この','本|ほん','を','読んだ|よんだ','こと','が','あります','。'],a:"J'ai déjà lu ce livre.",o:["J'ai déjà lu ce livre.","Je veux lire ce livre.","Je sais lire ce livre.","Je n'ai jamais lu ce livre."],why:"読んだことがあります = avoir déjà lu."}]},
{id:'l16',zone:4,who:'kotoba',xp:40,title:"〜て、〜て",sub:"Enchaîner les actions dans une longue phrase",
 cards:[
 {h:"Relier les actions",f:"A て、B て、C ます",x:"Pour raconter plusieurs actions à la suite, on met tous les verbes à la forme <b>て</b>, sauf le dernier. C'est le dernier verbe qui donne le temps de toute la phrase.",
  ex:[{t:['朝|あさ','、','起きて|おきて','、','ごはん','を','食べて|たべて','、','学校|がっこう','に','行きます|いきます','。'],fr:"Le matin, je me lève, je mange et je vais à l'école."},{t:['店|みせ','に','行って|いって','、','お茶|おちゃ','を','買いました|かいました','。'],fr:"Je suis allé au magasin et j'ai acheté du thé."}]},
 {h:"Après avoir…",f:"A てから、B",x:"<b>てから</b> insiste sur l'ordre : « après avoir fait A, je fais B ».",
  ex:[{t:['手|て','を','洗って|あらって','から','、','食べます|たべます','。'],fr:"Je mange après m'être lavé les mains."},{t:['漢字|かんじ','を','書いて|かいて','から','、','寝ます|ねます','。'],fr:"Je dors après avoir écrit des kanji."}]},
 {h:"Avant de…",f:"forme du dictionnaire + 前に",x:"« Avant de faire A » : verbe à la forme du dictionnaire + <b>前に</b> (まえに).",
  ex:[{t:['寝る|ねる','前|まえ','に','、','本|ほん','を','読みます|よみます','。'],fr:"Avant de dormir, je lis un livre."},{t:['食べる|たべる','前|まえ','に','、','手|て','を','洗います|あらいます','。'],fr:"Avant de manger, je me lave les mains."}]}],
 ex:[
 {q:'gap',fr:"Le matin, je me lève et je bois de l'eau.",t:['朝|あさ','＿','、','水|みず','を','飲みます|のみます','。'],a:'起きて',o:['起きて','起きます','起きた','起きる'],why:"Tous les verbes sauf le dernier se mettent à la forme て."},
 {q:'ord',fr:"Je rentre à la maison et je mange.",t:['家|いえ','に','帰って|かえって','ごはん','を','食べます|たべます'],x:['帰ります|かえります']},
 {q:'gap',fr:"Je dors après avoir étudié.",t:['勉強|べんきょう','して','＿','、','寝ます|ねます','。'],a:'から',o:['から','まえに','まで','より'],why:"てから = après avoir fait."},
 {q:'gap',fr:"Avant de manger, je me lave les mains.",t:['＿','前|まえ','に','、','手|て','を','洗います|あらいます','。'],a:'食べる',o:['食べる','食べて','食べた','食べます'],why:"Devant 前に, le verbe est à la forme du dictionnaire."},
 {q:'ord',fr:"Je suis allé en ville et j'ai acheté un livre.",t:['町|まち','に','行って|いって','本|ほん','を','買いました|かいました'],x:['行きます|いきます']},
 {q:'mcq',p:"Que veut dire cette phrase ?",t:['手紙|てがみ','を','書いて|かいて','から','、','寝ました|ねました','。'],a:"J'ai dormi après avoir écrit une lettre.",o:["J'ai dormi après avoir écrit une lettre.","J'ai écrit une lettre avant de me lever.","J'écris une lettre parce que je dors.","Je veux écrire une lettre et dormir."],why:"書いてから = après avoir écrit."}]},
{id:'l17',zone:4,who:'kotoba',xp:40,title:"〜と思います",sub:"Donner son avis, rapporter des paroles",
 cards:[
 {h:"Je pense que…",f:"phrase simple + と思います",x:"On termine la phrase à la forme simple (dictionnaire, た, ou adjectif en い tel quel), puis on ajoute <b>と思います</b> (とおもいます). Après un nom ou un adjectif en な, on intercale <b>だ</b>.",
  ex:[{t:['明日|あした','は','雨|あめ','が','降る|ふる','と','思います|おもいます','。'],fr:"Je pense qu'il pleuvra demain."},{t:['この','道|みち','は','危ない|あぶない','と','思います|おもいます','。'],fr:"Je pense que ce chemin est dangereux."},{t:['あの','人|ひと','は','先生|せんせい','だ','と','思います|おもいます','。'],fr:"Je pense que cette personne est professeur."}]},
 {h:"Il a dit que…",f:"phrase simple + と言いました",x:"Même construction avec <b>言いました</b> (いいました), « a dit ». C'est le と des citations.",
  ex:[{t:['先生|せんせい','は','明日|あした','来る|くる','と','言いました|いいました','。'],fr:"Le professeur a dit qu'il viendrait demain."},{t:['父|ちち','は','忙しい|いそがしい','と','言いました|いいました','。'],fr:"Mon père a dit qu'il était occupé."}]}],
 ex:[
 {q:'gap',fr:"Je pense qu'il fera froid demain.",t:['明日|あした','は','寒い|さむい','＿','思います|おもいます','。'],a:'と',o:['と','を','に','が'],why:"と introduit ce que l'on pense."},
 {q:'gap',fr:"Je pense que cette ville est calme.",t:['この','町|まち','は','静か|しずか','＿','と','思います|おもいます','。'],a:'だ',o:['だ','です','な','い'],why:"Adjectif en な ou nom : だ avant と."},
 {q:'ord',fr:"Je pense que ce livre est intéressant.",t:['この','本|ほん','は','面白い|おもしろい','と','思います|おもいます'],x:['です']},
 {q:'ord',fr:"Hana a dit qu'elle irait au village.",t:['はな','は','村|むら','に','行く|いく','と','言いました|いいました'],x:['行きます|いきます']},
 {q:'mcq',p:"Que veut dire cette phrase ?",t:['あの','人|ひと','は','もう','帰った|かえった','と','思います|おもいます','。'],a:"Je pense que cette personne est déjà rentrée.",o:["Je pense que cette personne est déjà rentrée.","Je pense que cette personne va rentrer.","Cette personne a dit qu'elle rentrait.","Je veux que cette personne rentre."],why:"帰った = est rentré (passé) · もう = déjà."},
 {q:'mcq',p:"Comment dit-on « Je pense que c'est cher. » ?",a:'高いと思います。',o:['高いと思います。','高いだと思います。','高くて思います。','高いを思います。'],why:"Adjectif en い : pas de だ avant と."}]}];
 NEW.forEach(L=>{L.ex.forEach((e,i)=>{e.id=L.id+'.'+i;e.les=L.id});L.cards.forEach(c=>c.ex.forEach(e=>phrAdd(e.t,e.fr,L.id)));LESSONS.push(L)})}

/* ---------- acte II — leçons du col des Brumes (Maître Kotoba) ---------- */
{const NEW=[
{id:'l18',zone:6,who:'kotoba',xp:40,title:"へ・から・まで",sub:"D'où, vers où, jusqu'où",
 cards:[
 {h:"La direction : へ",f:"lieu + へ + 行きます",x:"<b>へ</b> (qu'on prononce « e ») indique la direction d'un déplacement. On peut presque toujours le remplacer par に, qui insiste plutôt sur l'arrivée.",
  ex:[{t:['北|きた','へ','行きます|いきます','。'],fr:"Je vais vers le nord."},{t:['家|いえ','へ','帰ります|かえります','。'],fr:"Je rentre à la maison."}]},
 {h:"Le point de départ : から",f:"A から 来ました",x:"<b>から</b> marque le point de départ, dans l'espace comme dans le temps.",
  ex:[{t:['村|むら','から','来ました|きました','。'],fr:"Je viens du village."},{t:['九時|くじ','から','働きます|はたらきます','。'],fr:"Je travaille à partir de neuf heures."}]},
 {h:"La limite : まで",f:"A から B まで",x:"<b>まで</b> marque la limite : « jusqu'à ». Avec から, on encadre un trajet ou une durée.",
  ex:[{t:['駅|えき','まで','歩きます|あるきます','。'],fr:"Je marche jusqu'à la gare."},{t:['朝|あさ','から','晩|ばん','まで','雪|ゆき','が','降りました|ふりました','。'],fr:"Il a neigé du matin au soir."}]}],
 ex:[
 {q:'gap',fr:"Je vais vers le sud.",t:['南|みなみ','＿','行きます|いきます','。'],a:'へ',o:['へ','を','が','で'],why:"へ indique la direction."},
 {q:'gap',fr:"Je viens de la ville.",t:['町|まち','＿','来ました|きました','。'],a:'から',o:['から','まで','へ','を'],why:"から = depuis, de."},
 {q:'gap',fr:"Je marche jusqu'à la montagne.",t:['山|やま','＿','歩きます|あるきます','。'],a:'まで',o:['まで','から','が','も'],why:"まで = jusqu'à."},
 {q:'ord',fr:"Je travaille de neuf heures à cinq heures.",t:['九時|くじ','から','五時|ごじ','まで','働きます|はたらきます'],x:['へ']},
 {q:'ord',fr:"Je rentre au village.",t:['村|むら','へ','帰ります|かえります'],x:['から']},
 {q:'mcq',p:"Que veut dire cette phrase ?",t:['駅|えき','から','家|いえ','まで','十分|じゅっぷん','です','。'],a:"De la gare à la maison, il y a dix minutes.",o:["De la gare à la maison, il y a dix minutes.","Je vais à la gare dans dix minutes.","La maison est à dix minutes de l'école.","Il est dix heures à la gare."],why:"A から B まで = de A à B."}]},
{id:'l19',zone:6,who:'kotoba',xp:40,title:"何時ですか",sub:"Dire l'heure",
 cards:[
 {h:"Les heures",f:"nombre + 時",x:"On ajoute <b>時</b> (じ) au nombre. Trois lectures irrégulières : 四時 <b>よじ</b>, 七時 <b>しちじ</b>, 九時 <b>くじ</b>.",
  ex:[{t:['今|いま','、','何時|なんじ','です','か','。'],fr:"Quelle heure est-il ?"},{t:['四時|よじ','です','。'],fr:"Il est quatre heures."},{t:['七時|しちじ','に','起きます|おきます','。'],fr:"Je me lève à sept heures."}]},
 {h:"Les minutes et la demie",f:"〜分 · 〜時半",x:"Les minutes se disent <b>分</b> : ふん ou ぷん selon le chiffre (五分 ごふん, 十分 じゅっぷん). La demie se dit <b>半</b> (はん), placée après l'heure.",
  ex:[{t:['三時|さんじ','半|はん','です','。'],fr:"Il est trois heures et demie."},{t:['六時|ろくじ','十分|じゅっぷん','です','。'],fr:"Il est six heures dix."}]},
 {h:"Matin et après-midi",f:"午前 · 午後",x:"<b>午前</b> (ごぜん) pour le matin, <b>午後</b> (ごご) pour l'après-midi. Ils se placent avant l'heure. Pour un rendez-vous, l'heure prend la particule に.",
  ex:[{t:['午前|ごぜん','九時|くじ','に','会いましょう|あいましょう','。'],fr:"Retrouvons-nous à neuf heures du matin."},{t:['午後|ごご','二時|にじ','から','休みます|やすみます','。'],fr:"Je me repose à partir de deux heures de l'après-midi."}]}],
 ex:[
 {q:'mcq',p:"Comment lit-on 四時 ?",a:'よじ',o:['よじ','よんじ','しじ','よっじ'],why:"Lecture irrégulière : よじ."},
 {q:'mcq',p:"Comment lit-on 九時 ?",a:'くじ',o:['くじ','きゅうじ','ここのじ','くうじ'],why:"Lecture irrégulière : くじ."},
 {q:'gap',fr:"Il est cinq heures et demie.",t:['五時|ごじ','＿','です','。'],a:'半',o:['半','分','前','間'],why:"半 (はん) = et demie."},
 {q:'gap',fr:"Je me lève à six heures.",t:['六時|ろくじ','＿','起きます|おきます','。'],a:'に',o:['に','を','で','が'],why:"Une heure précise prend に."},
 {q:'ord',fr:"Quelle heure est-il maintenant ?",t:['今|いま','何時|なんじ','です','か'],x:['何|なに']},
 {q:'mcq',p:"Que veut dire cette phrase ?",t:['午後|ごご','三時|さんじ','半|はん','に','来て|きて','ください','。'],a:"Viens à trois heures et demie de l'après-midi, s'il te plaît.",o:["Viens à trois heures et demie de l'après-midi, s'il te plaît.","Viens à trois heures du matin, s'il te plaît.","Il est trois heures et demie de l'après-midi.","Je viendrai dans trois heures et demie."],why:"午後 = après-midi · 半 = et demie · 来てください = viens, s'il te plaît."}]}];
 NEW.forEach(L=>{L.ex.forEach((e,i)=>{e.id=L.id+'.'+i;e.les=L.id});L.cards.forEach(c=>c.ex.forEach(e=>phrAdd(e.t,e.fr,L.id)));LESSONS.push(L)})}

/* ---------- acte II — leçons du Relais de la Grand-Route (Maître Kotoba) ---------- */
{const NEW=[
{id:'l20',zone:7,who:'kotoba',xp:40,title:"いくらですか",sub:"Les prix et les grands nombres",
 cards:[
 {h:"Cent, mille, dix mille",f:"百 · 千 · 万",x:"On empile : 二百 (にひゃく), 五千 (ごせん), 三万 (さんまん). Quelques lectures changent : 三百 <b>さんびゃく</b>, 六百 <b>ろっぴゃく</b>, 八百 <b>はっぴゃく</b>, 三千 <b>さんぜん</b>, 八千 <b>はっせん</b>. Et le japonais compte par dix-milliers : 10 000 se dit <b>一万</b>, 20 000 <b>二万</b>.",
  ex:[{t:['三百円|さんびゃくえん','です','。'],fr:"C'est trois cents yens."},{t:['一万円|いちまんえん','は','高い|たかい','です','。'],fr:"Dix mille yens, c'est cher."}]},
 {h:"Demander le prix",f:"〜は いくらですか",x:"<b>いくら</b> = combien, pour un prix. On répond avec le prix suivi de <b>円</b> (えん) et de です.",
  ex:[{t:['この','かさ','は','いくら','です','か','。'],fr:"Combien coûte ce parapluie ?"},{t:['八百円|はっぴゃくえん','です','。'],fr:"Huit cents yens."}]},
 {h:"Acheter",f:"〜を ください",x:"Dans une boutique : la chose + を + <b>ください</b>. Encore plus poli : を <b>お願いします</b> (おねがいします). Pour dire combien on en veut, le nombre se glisse après を.",
  ex:[{t:['お茶|おちゃ','を','ください','。'],fr:"Un thé, s'il vous plaît."},{t:['これ','を','二つ|ふたつ','ください','。'],fr:"Donnez-m'en deux, s'il vous plaît."},{t:['もう','少し|すこし','安い|やすい','の','は','あります','か','。'],fr:"Vous en avez un peu moins cher ?"}]}],
 ex:[
 {q:'gap',fr:"Combien coûte ceci ?",t:['これ','は','＿','です','か','。'],a:'いくら',o:['いくら','いくつ','どこ','だれ'],why:"いくら = combien, pour un prix. いくつ = combien de choses."},
 {q:'mcq',p:"Comment lit-on 三百 ?",a:'さんびゃく',o:['さんびゃく','さんひゃく','さんぴゃく','みひゃく'],why:"Après 三, ひゃく devient びゃく."},
 {q:'mcq',p:"Comment lit-on 八百 ?",a:'はっぴゃく',o:['はっぴゃく','はちひゃく','はちびゃく','やひゃく'],why:"八百 se lit はっぴゃく."},
 {q:'mcq',p:"Comment écrit-on 20 000 ?",a:'二万',o:['二万','二十千','二千','二百'],why:"Le japonais compte par 万 (10 000) : 20 000 = 二万."},
 {q:'gap',fr:"Un thé, s'il vous plaît.",t:['お茶|おちゃ','＿','ください','。'],a:'を',o:['を','は','に','で'],why:"chose + を + ください."},
 {q:'ord',fr:"Combien coûte ce chapeau ?",t:['この','帽子|ぼうし','は','いくら','です','か'],x:['どこ']},
 {q:'ord',fr:"Donnez-m'en deux, s'il vous plaît.",t:['これ','を','二つ|ふたつ','ください'],x:['に']},
 {q:'mcq',p:"Que veut dire cette phrase ?",t:['この','かさ','は','千五百円|せんごひゃくえん','です','。'],a:"Ce parapluie coûte mille cinq cents yens.",o:["Ce parapluie coûte mille cinq cents yens.","Ce parapluie coûte quinze mille yens.","Ce parapluie coûte cent cinquante yens.","J'ai acheté ce parapluie mille cinq cents yens."],why:"千 = 1 000 · 五百 = 500."}]},
{id:'l21',zone:7,who:'kotoba',xp:40,title:"〜てもいいですか",sub:"Demander la permission, interdire",
 cards:[
 {h:"Demander la permission",f:"forme て + も いいですか",x:"On prend la forme en て du verbe et on ajoute <b>もいいですか</b> : « est-ce que je peux… ? ». Pour accepter : はい、どうぞ. Pour refuser en douceur : すみません、ちょっと…",
  ex:[{t:['ここ','を','通って|とおって','も','いい','です','か','。'],fr:"Est-ce que je peux passer par ici ?"},{t:['はい','、','どうぞ','。'],fr:"Oui, je vous en prie."},{t:['ここ','に','座って|すわって','も','いい','です','か','。'],fr:"Je peux m'asseoir ici ?"}]},
 {h:"Interdire",f:"forme て + は いけません",x:"<b>〜てはいけません</b> = « il ne faut pas, il est interdit de ». C'est la formule des panneaux et des gardiens. Ce は se prononce « wa ».",
  ex:[{t:['ここ','に','入って|はいって','は','いけません','。'],fr:"Il est interdit d'entrer ici."},{t:['夜|よる','、','この','道|みち','を','歩いて|あるいて','は','いけません','。'],fr:"Il ne faut pas marcher sur cette route la nuit."}]},
 {h:"Demander de ne pas faire",f:"〜ないでください",x:"Plus doux qu'une interdiction : la forme négative en ない + <b>でください</b>, « ne fais pas…, s'il te plaît ». 行く → 行かない → 行かないでください.",
  ex:[{t:['まだ','行かないで|いかないで','ください','。'],fr:"Ne pars pas encore, s'il te plaît."},{t:['ここ','に','入らないで|はいらないで','ください','。'],fr:"N'entrez pas ici, s'il vous plaît."}]}],
 ex:[
 {q:'gap',fr:"Est-ce que je peux boire ce thé ?",t:['この','お茶|おちゃ','を','飲んで|のんで','＿','いい','です','か','。'],a:'も',o:['も','は','を','に'],why:"〜てもいいですか : la permission se construit avec も."},
 {q:'gap',fr:"Il est interdit d'entrer ici.",t:['ここ','に','入って|はいって','＿','いけません','。'],a:'は',o:['は','も','が','で'],why:"〜てはいけません : l'interdiction se construit avec は."},
 {q:'mcq',p:"Quelle est la forme en て de 通る (passer) ?",a:'通って',o:['通って','通りて','通んで','通いて'],why:"Verbe en る du premier groupe : る → って."},
 {q:'ord',fr:"Est-ce que je peux m'asseoir ici ?",t:['ここ','に','座って|すわって','も','いい','です','か'],x:['は']},
 {q:'ord',fr:"Il ne faut pas marcher ici la nuit.",t:['夜|よる','ここ','を','歩いて|あるいて','は','いけません'],x:['も']},
 {q:'mcq',p:"Comment dit-on « N'entre pas, s'il te plaît » ?",a:'入らないでください',o:['入らないでください','入ってください','入ってもいいです','入りませんでした'],why:"Forme en ない + でください."},
 {q:'mcq',p:"Que veut dire cette phrase ?",t:['この','道|みち','を','通って|とおって','は','いけません','。'],a:"Il est interdit de passer par cette route.",o:["Il est interdit de passer par cette route.","Est-ce que je peux passer par cette route ?","Passe par cette route, s'il te plaît.","Je ne suis pas passé par cette route."],why:"〜てはいけません = il est interdit de…"}]}];
 NEW.forEach(L=>{L.ex.forEach((e,i)=>{e.id=L.id+'.'+i;e.les=L.id});L.cards.forEach(c=>c.ex.forEach(e=>phrAdd(e.t,e.fr,L.id)));LESSONS.push(L)})}

/* ---------- acte II — leçons du Grand Fleuve (Maître Kotoba) ---------- */
{const NEW=[
{id:'l22',zone:8,who:'kotoba',xp:40,title:"〜ています",sub:"Ce qui est en train de se passer",
 cards:[
 {h:"L'action en cours",f:"forme て + います",x:"La forme en て suivie de <b>います</b> décrit une action en train de se faire : « être en train de ».",
  ex:[{t:['雨|あめ','が','降って|ふって','います','。'],fr:"Il pleut (en ce moment)."},{t:['船|ふね','を','待って|まって','います','。'],fr:"J'attends le bateau."}]},
 {h:"L'état qui dure",f:"forme て + います",x:"La même forme décrit aussi un état installé : habiter, être marié, savoir. <b>住んでいます</b> = j'habite ; <b>知っています</b> = je sais. Attention : « je ne sais pas » se dit <b>知りません</b>.",
  ex:[{t:['川|かわ','の','近く|ちかく','に','住んで|すんで','います','。'],fr:"J'habite près du fleuve."},{t:['その','人|ひと','を','知って|しって','います','か','。'],fr:"Tu connais cette personne ?"},{t:['いいえ','、','知りません|しりません','。'],fr:"Non, je ne la connais pas."}]},
 {h:"Négatif et passé",f:"〜ていません · 〜ていました",x:"<b>〜ていません</b> : ne pas être en train de, ou « pas encore » avec まだ. <b>〜ていました</b> : était en train de.",
  ex:[{t:['まだ','食べて|たべて','いません','。'],fr:"Je n'ai pas encore mangé."},{t:['朝|あさ','、','霧|きり','が','出て|でて','いました','。'],fr:"Ce matin, il y avait de la brume."}]}],
 ex:[
 {q:'gap',fr:"Il pleut en ce moment.",t:['雨|あめ','が','降って|ふって','＿','。'],a:'います',o:['います','あります','です','ました'],why:"forme て + います = action en cours."},
 {q:'mcq',p:"Quelle est la forme en て de 待つ (attendre) ?",a:'待って',o:['待って','待ちて','待んで','待いて'],why:"つ → って."},
 {q:'mcq',p:"Comment dit-on « je ne sais pas » ?",a:'知りません',o:['知りません','知っていません','知ってありません','知らないです'],why:"Le négatif de 知っています est 知りません."},
 {q:'gap',fr:"J'habite près du fleuve.",t:['川|かわ','の','近く|ちかく','＿','住んで|すんで','います','。'],a:'に',o:['に','を','で','へ'],why:"住んでいます prend に pour le lieu."},
 {q:'ord',fr:"J'attends le bateau.",t:['船|ふね','を','待って|まって','います'],x:['が']},
 {q:'ord',fr:"Je n'ai pas encore mangé.",t:['まだ','食べて|たべて','いません'],x:['もう']},
 {q:'mcq',p:"Que veut dire cette phrase ?",t:['今|いま','、','何|なに','を','して','います','か','。'],a:"Qu'est-ce que tu es en train de faire ?",o:["Qu'est-ce que tu es en train de faire ?","Qu'est-ce que tu as fait ?","Qu'est-ce que tu veux faire ?","Où es-tu maintenant ?"],why:"しています = être en train de faire."}]},
{id:'l23',zone:8,who:'kotoba',xp:40,title:"何曜日ですか",sub:"Les jours de la semaine et les rendez-vous",
 cards:[
 {h:"Les sept jours",f:"〜曜日",x:"Chaque jour porte un élément : <b>月</b>曜日 (げつ, lundi), <b>火</b>曜日 (か, mardi), <b>水</b>曜日 (すい, mercredi), <b>木</b>曜日 (もく, jeudi), <b>金</b>曜日 (きん, vendredi), <b>土</b>曜日 (ど, samedi), <b>日</b>曜日 (にち, dimanche).",
  ex:[{t:['今日|きょう','は','何曜日|なんようび','です','か','。'],fr:"Quel jour sommes-nous ?"},{t:['金曜日|きんようび','です','。'],fr:"C'est vendredi."}]},
 {h:"Dire quand",f:"jour + に",x:"Un jour précis prend <b>に</b>, comme une heure. Pas de に avec 今日, 明日, 毎日.",
  ex:[{t:['土曜日|どようび','に','船|ふね','が','出ます|でます','。'],fr:"Le bateau part samedi."},{t:['明日|あした','行きます|いきます','。'],fr:"J'y vais demain."}]},
 {h:"De tel jour à tel jour",f:"A から B まで",x:"On retrouve から et まで. Et pour demander « quand » : <b>いつ</b>.",
  ex:[{t:['月曜日|げつようび','から','金曜日|きんようび','まで','働きます|はたらきます','。'],fr:"Je travaille du lundi au vendredi."},{t:['次|つぎ','の','船|ふね','は','いつ','です','か','。'],fr:"Quand est le prochain bateau ?"}]}],
 ex:[
 {q:'mcq',p:"Comment lit-on 月曜日 ?",a:'げつようび',o:['げつようび','つきようび','がつようび','げつにち'],why:"月 se lit げつ dans 月曜日."},
 {q:'mcq',p:"Quel jour est 木曜日 ?",a:'jeudi',o:['jeudi','mardi','mercredi','samedi'],why:"木 (arbre, もく) = jeudi."},
 {q:'mcq',p:"Comment lit-on 土曜日 ?",a:'どようび',o:['どようび','つちようび','とようび','どうようび'],why:"土 se lit ど dans 土曜日."},
 {q:'gap',fr:"Le bateau part samedi.",t:['土曜日|どようび','＿','船|ふね','が','出ます|でます','。'],a:'に',o:['に','を','で','は'],why:"Un jour précis prend に."},
 {q:'gap',fr:"Quand est le prochain bateau ?",t:['次|つぎ','の','船|ふね','は','＿','です','か','。'],a:'いつ',o:['いつ','どこ','だれ','いくら'],why:"いつ = quand."},
 {q:'ord',fr:"Je travaille du lundi au vendredi.",t:['月曜日|げつようび','から','金曜日|きんようび','まで','働きます|はたらきます'],x:['に']},
 {q:'mcq',p:"Que veut dire cette phrase ?",t:['日曜日|にちようび','は','休み|やすみ','です','。'],a:"Le dimanche, c'est repos.",o:["Le dimanche, c'est repos.","Je me repose aujourd'hui.","Le lundi, c'est repos.","Je travaille le dimanche."],why:"日曜日 = dimanche · 休み = repos."}]}];
 NEW.forEach(L=>{L.ex.forEach((e,i)=>{e.id=L.id+'.'+i;e.les=L.id});L.cards.forEach(c=>c.ex.forEach(e=>phrAdd(e.t,e.fr,L.id)));LESSONS.push(L)})}

/* ---------- acte II — leçons de la ville basse de Kurogane (Maître Tanuki) ---------- */
{const NEW=[
{id:'l24',zone:9,who:'kotoba',xp:40,title:"どこにありますか",sub:"Trouver son chemin : devant, derrière, à côté",
 cards:[
 {h:"Le lieu, puis la chose",f:"lieu + に + chose + が あります",x:"Pour dire où se trouve quelque chose : le lieu prend <b>に</b>, la chose prend <b>が</b>, puis <b>あります</b> (objets) ou <b>います</b> (personnes, animaux).",
  ex:[{t:['橋|はし','の','近く|ちかく','に','銭湯|せんとう','が','あります','。'],fr:"Il y a un bain public près du pont."},{t:['屋根|やね','の','上|うえ','に','猫|ねこ','が','います','。'],fr:"Il y a un chat sur le toit."}]},
 {h:"Les mots de position",f:"nom + の + position",x:"La position se colle au nom avec <b>の</b> : <b>前</b> (まえ, devant), <b>後ろ</b> (うしろ, derrière), <b>隣</b> (となり, à côté), <b>中</b> (なか, dans), <b>上</b> (うえ, sur), <b>下</b> (した, sous), <b>間</b> (あいだ, entre).",
  ex:[{t:['店|みせ','の','前|まえ'],fr:"devant la boutique"},{t:['銭湯|せんとう','の','隣|となり'],fr:"à côté du bain public"},{t:['橋|はし','の','下|した'],fr:"sous le pont"}]},
 {h:"Demander son chemin",f:"〜は どこに ありますか",x:"On pose la chose en thème avec <b>は</b>, puis <b>どこに ありますか</b>. La réponse reprend la même structure.",
  ex:[{t:['駅|えき','は','どこ','に','あります','か','。'],fr:"Où se trouve la station ?"},{t:['交番|こうばん','の','後ろ|うしろ','に','あります','。'],fr:"Elle est derrière le poste de police."}]}],
 ex:[
 {q:'gap',fr:"Il y a un chat sur le toit.",t:['屋根|やね','の','上|うえ','に','猫|ねこ','が','＿','。'],a:'います',o:['います','あります','です','します'],why:"Un animal est vivant : います."},
 {q:'gap',fr:"devant la boutique",t:['店|みせ','＿','前|まえ'],a:'の',o:['の','に','を','が'],why:"nom + の + position."},
 {q:'mcq',p:"Comment dit-on « à côté » ?",a:'隣（となり）',o:['隣（となり）','後ろ（うしろ）','間（あいだ）','下（した）'],why:"隣 (となり) = à côté, voisin."},
 {q:'mcq',p:"Que veut dire 後ろ (うしろ) ?",a:'derrière',o:['derrière','devant','dessous','entre'],why:"後ろ = derrière ; 前 = devant."},
 {q:'gap',fr:"Où se trouve la station ?",t:['駅|えき','は','どこ','＿','あります','か','。'],a:'に',o:['に','を','で','へ'],why:"Le lieu où une chose se trouve prend に."},
 {q:'ord',fr:"Il y a un bain public près du pont.",t:['橋|はし','の','近く|ちかく','に','銭湯|せんとう','が','あります'],x:['を']},
 {q:'ord',fr:"Elle est derrière le poste de police.",t:['交番|こうばん','の','後ろ|うしろ','に','あります'],x:['で']},
 {q:'mcq',p:"Que veut dire cette phrase ?",t:['橋|はし','の','下|した','に','何|なに','が','います','か','。'],a:"Qu'est-ce qu'il y a sous le pont ? (un être vivant)",o:["Qu'est-ce qu'il y a sous le pont ? (un être vivant)","Où est le pont ?","Qui est sur le pont ?","Qu'est-ce qu'il y a devant le pont ? (un objet)"],why:"下 = sous · います : on parle d'un être vivant."}]},
{id:'l25',zone:9,who:'kotoba',xp:40,title:"〜から",sub:"Donner une raison : parce que",
 cards:[
 {h:"La raison d'abord",f:"raison + から、 résultat",x:"En japonais, la raison vient <b>avant</b>. On termine la phrase de raison par <b>から</b>, puis on donne la suite. C'est l'inverse du français.",
  ex:[{t:['雨|あめ','です','から','、','行きません|いきません','。'],fr:"Comme il pleut, je n'y vais pas."},{t:['安い|やすい','です','から','、','買います|かいます','。'],fr:"Je l'achète parce que ce n'est pas cher."}]},
 {h:"Demander pourquoi",f:"どうして 〜か · 〜からです",x:"<b>どうして</b> = pourquoi. On répond en finissant par <b>からです</b> : « c'est parce que… ».",
  ex:[{t:['どうして','走って|はしって','います','か','。'],fr:"Pourquoi est-ce que tu cours ?"},{t:['電車|でんしゃ','が','来ます|きます','から','です','。'],fr:"Parce que le tramway arrive."}]},
 {h:"Ne pas confondre",f:"lieu + から ≠ phrase + から",x:"Après un <b>nom de lieu ou de temps</b>, から veut dire « depuis, à partir de ». Après une <b>phrase</b>, il veut dire « parce que ».",
  ex:[{t:['駅|えき','から','歩きます|あるきます','。'],fr:"Je marche depuis la station."},{t:['遠い|とおい','です','から','、','電車|でんしゃ','に','乗ります|のります','。'],fr:"Comme c'est loin, je prends le tramway."}]}],
 ex:[
 {q:'gap',fr:"Comme il pleut, je n'y vais pas.",t:['雨|あめ','です','＿','、','行きません|いきません','。'],a:'から',o:['から','まで','より','ので'],why:"phrase + から = parce que."},
 {q:'mcq',p:"Comment dit-on « pourquoi » ?",a:'どうして',o:['どうして','どこ','いつ','いくら'],why:"どうして = pourquoi."},
 {q:'mcq',p:"Dans 駅から歩きます, que veut dire から ?",a:'depuis',o:['depuis','parce que','jusqu\'à','vers'],why:"Après un nom de lieu, から = depuis."},
 {q:'gap',fr:"Parce que le tramway arrive.",t:['電車|でんしゃ','が','来ます|きます','から','＿','。'],a:'です',o:['です','ます','か','ね'],why:"La réponse à どうして se termine par からです."},
 {q:'ord',fr:"Je l'achète parce que ce n'est pas cher.",t:['安い|やすい','です','から','買います|かいます'],x:['まで']},
 {q:'ord',fr:"Comme c'est loin, je prends le tramway.",t:['遠い|とおい','です','から','電車|でんしゃ','に','乗ります|のります'],x:['を']},
 {q:'mcq',p:"Que veut dire cette phrase ?",t:['人|ひと','が','多い|おおい','です','から','、','ゆっくり','歩きます|あるきます','。'],a:"Comme il y a beaucoup de monde, je marche lentement.",o:["Comme il y a beaucoup de monde, je marche lentement.","Je marche lentement depuis la foule.","Il y a beaucoup de monde parce que je marche lentement.","Je marche vite parce qu'il y a du monde."],why:"La raison (人が多いです) vient avant から."}]}];
 NEW.forEach(L=>{L.ex.forEach((e,i)=>{e.id=L.id+'.'+i;e.les=L.id});L.cards.forEach(c=>c.ex.forEach(e=>phrAdd(e.t,e.fr,L.id)));LESSONS.push(L)})}

/* ---------- acte II — leçons de l'Académie des sceaux (Maître Tanuki) ---------- */
{const NEW=[
{id:'l26',zone:10,who:'kotoba',xp:40,title:"〜前に・〜後で",sub:"Avant de faire, après avoir fait",
 cards:[
 {h:"Avant de…",f:"verbe (dictionnaire) + 前に",x:"Devant <b>前に</b> (まえに), le verbe reste toujours à la <b>forme du dictionnaire</b>, même si on parle du passé.",
  ex:[{t:['寝る|ねる','前|まえ','に','、','本|ほん','を','読みます|よみます','。'],fr:"Avant de dormir, je lis un livre."},{t:['食べる|たべる','前|まえ','に','、','手|て','を','洗いました|あらいました','。'],fr:"Avant de manger, je me suis lavé les mains."}]},
 {h:"Après avoir…",f:"verbe en た + 後で",x:"Devant <b>後で</b> (あとで), le verbe se met à la <b>forme en た</b> : l'action est déjà finie quand la suivante commence.",
  ex:[{t:['授業|じゅぎょう','が','終わった|おわった','後|あと','で','、','帰ります|かえります','。'],fr:"Après la fin du cours, je rentre."},{t:['読んだ|よんだ','後|あと','で','、','返して|かえして','ください','。'],fr:"Rends-le après l'avoir lu."}]},
 {h:"Avec un nom",f:"nom + の + 前に / 後で",x:"Avec un nom, on passe par <b>の</b> : 試験の前に (avant l'examen), 授業の後で (après le cours).",
  ex:[{t:['試験|しけん','の','前|まえ','に','、','練習|れんしゅう','します','。'],fr:"Avant l'examen, je m'exerce."},{t:['授業|じゅぎょう','の','後|あと','で','、','質問|しつもん','が','あります','。'],fr:"Après le cours, j'ai une question."}]}],
 ex:[
 {q:'gap',fr:"Avant de dormir, je lis un livre.",t:['＿','前|まえ','に','、','本|ほん','を','読みます|よみます','。'],a:'寝る',o:['寝る','寝た','寝て','寝ます'],why:"Devant 前に : forme du dictionnaire."},
 {q:'gap',fr:"Rends-le après l'avoir lu.",t:['＿','後|あと','で','、','返して|かえして','ください','。'],a:'読んだ',o:['読んだ','読む','読んで','読みます'],why:"Devant 後で : forme en た."},
 {q:'gap',fr:"Avant l'examen, je m'exerce.",t:['試験|しけん','＿','前|まえ','に','、','練習|れんしゅう','します','。'],a:'の',o:['の','を','に','が'],why:"nom + の + 前に."},
 {q:'mcq',p:"Quelle forme du verbe met-on devant 後で ?",a:'la forme en た',o:['la forme en た','la forme du dictionnaire','la forme en て','la forme en ます'],why:"L'action est terminée : forme en た."},
 {q:'ord',fr:"Avant de manger, je me suis lavé les mains.",t:['食べる|たべる','前|まえ','に','手|て','を','洗いました|あらいました'],x:['で']},
 {q:'ord',fr:"Après le cours, j'ai une question.",t:['授業|じゅぎょう','の','後|あと','で','質問|しつもん','が','あります'],x:['に']},
 {q:'mcq',p:"Que veut dire cette phrase ?",t:['書く|かく','前|まえ','に','、','よく','考えて|かんがえて','ください','。'],a:"Réfléchis bien avant d'écrire.",o:["Réfléchis bien avant d'écrire.","Écris après avoir bien réfléchi au professeur.","Réfléchis bien après avoir écrit.","Écris bien avant de réfléchir."],why:"書く前に = avant d'écrire."}]},
{id:'l27',zone:10,who:'kotoba',xp:40,title:"あげます・もらいます",sub:"Donner et recevoir",
 cards:[
 {h:"Donner",f:"A は B に 〜を あげます",x:"<b>あげます</b> : quelqu'un donne à quelqu'un d'autre. Celui qui reçoit prend <b>に</b>.",
  ex:[{t:['友達|ともだち','に','本|ほん','を','あげます','。'],fr:"Je donne un livre à un ami."},{t:['先生|せんせい','は','学生|がくせい','に','紙|かみ','を','あげました','。'],fr:"Le professeur a donné du papier à l'étudiant."}]},
 {h:"Recevoir",f:"A は B に 〜を もらいます",x:"<b>もらいます</b> : on se place du côté de celui qui reçoit. Celui qui donne prend <b>に</b> (ou から).",
  ex:[{t:['先生|せんせい','に','辞書|じしょ','を','もらいました','。'],fr:"J'ai reçu un dictionnaire du professeur."},{t:['だれ','に','もらいました','か','。'],fr:"De qui l'as-tu reçu ?"}]},
 {h:"On me donne",f:"A は 私に 〜を くれます",x:"Quand c'est <b>à moi</b> (ou à mes proches) qu'on donne, on dit <b>くれます</b>, jamais あげます.",
  ex:[{t:['妹|いもうと','が','手紙|てがみ','を','くれました','。'],fr:"Ma petite sœur m'a donné une lettre."},{t:['友達|ともだち','が','筆|ふで','を','くれました','。'],fr:"Un ami m'a donné un pinceau."}]}],
 ex:[
 {q:'gap',fr:"Je donne un livre à un ami.",t:['友達|ともだち','＿','本|ほん','を','あげます','。'],a:'に',o:['に','を','が','で'],why:"Celui qui reçoit prend に."},
 {q:'gap',fr:"J'ai reçu un dictionnaire du professeur.",t:['先生|せんせい','に','辞書|じしょ','を','＿','。'],a:'もらいました',o:['もらいました','あげました','くれました','かしました'],why:"Je reçois : もらいます."},
 {q:'gap',fr:"Un ami m'a donné un pinceau.",t:['友達|ともだち','が','筆|ふで','を','＿','。'],a:'くれました',o:['くれました','あげました','もらいました','かえしました'],why:"On me donne, à moi : くれます."},
 {q:'mcq',p:"« Ma sœur m'a donné une lettre » : quel verbe ?",a:'くれました',o:['くれました','あげました','もらいました','おくりました'],why:"Quelqu'un donne à moi : くれます."},
 {q:'ord',fr:"Le professeur a donné du papier à l'étudiant.",t:['先生|せんせい','は','学生|がくせい','に','紙|かみ','を','あげました'],x:['が']},
 {q:'ord',fr:"De qui l'as-tu reçu ?",t:['だれ','に','もらいました','か'],x:['を']},
 {q:'mcq',p:"Que veut dire cette phrase ?",t:['母|はは','に','お金|おかね','を','もらいました','。'],a:"J'ai reçu de l'argent de ma mère.",o:["J'ai reçu de l'argent de ma mère.","J'ai donné de l'argent à ma mère.","Ma mère a reçu de l'argent.","J'ai prêté de l'argent à ma mère."],why:"もらいました : c'est moi qui reçois ; 母に = de ma mère."}]}];
 NEW.forEach(L=>{L.ex.forEach((e,i)=>{e.id=L.id+'.'+i;e.les=L.id});L.cards.forEach(c=>c.ex.forEach(e=>phrAdd(e.t,e.fr,L.id)));LESSONS.push(L)})}

/* ---------- acte III — leçon du village des renards et des tanuki (Maître Tanuki) ---------- */
{const NEW=[
{id:'l28',zone:13,who:'tanu',xp:40,title:"〜くなる・〜になる",sub:"Dire que quelque chose change",
 cards:[
 {h:"Devenir (adjectif en い)",f:"〜い → 〜くなります",x:"On remplace le <b>い</b> final par <b>く</b>, puis on ajoute <b>なります</b> : 寒い → <b>寒くなります</b> (il commence à faire froid). Au passé : <b>寒くなりました</b>.",
  ex:[{t:['寒く|さむく','なりました','ね','。'],fr:"Il s'est mis à faire froid, hein."},{t:['空|そら','が','暗く|くらく','なりました','。'],fr:"Le ciel est devenu sombre."}]},
 {h:"Devenir (adjectif en な, nom)",f:"〜に なります",x:"Avec un adjectif en な ou un nom, on met <b>に</b> : 元気 → <b>元気になります</b>, 先生 → <b>先生になります</b>.",
  ex:[{t:['町|まち','が','静か|しずか','に','なりました','。'],fr:"La ville est devenue calme."},{t:['弟|おとうと','は','医者|いしゃ','に','なりたい','です','。'],fr:"Mon petit frère veut devenir médecin."}]},
 {h:"Attention à いい",f:"いい → よくなります",x:"<b>いい</b> devient toujours <b>よ</b> quand on le conjugue : <b>よくなりました</b> (ça s'est arrangé).",
  ex:[{t:['天気|てんき','が','よく','なりました','。'],fr:"Le temps s'est amélioré."}]}],
 ex:[
 {q:'gap',fr:"Il s'est mis à faire froid.",t:['＿','なりました','。'],a:'寒く',o:['寒く','寒い','寒に','寒くて'],why:"寒い → 寒く + なります."},
 {q:'gap',fr:"La ville est devenue calme.",t:['町|まち','が','静か|しずか','＿','なりました','。'],a:'に',o:['に','く','が','を'],why:"Adjectif en な + に なります."},
 {q:'gap',fr:"Le temps s'est amélioré.",t:['天気|てんき','が','＿','なりました','。'],a:'よく',o:['よく','いく','いいに','よい'],why:"いい → よく."},
 {q:'mcq',p:"« Je veux devenir médecin. »",a:'医者になりたいです。',o:['医者になりたいです。','医者くなりたいです。','医者がなりたいです。','医者になりますたい。'],why:"Nom + に なります, puis なり + たい."},
 {q:'mcq',p:"Que veut dire « 空が暗くなりました » ?",a:"Le ciel est devenu sombre.",o:["Le ciel est devenu sombre.","Le ciel est sombre.","Le ciel n'est pas sombre.","Le ciel deviendra clair."],why:"暗い → 暗くなりました : il a changé."},
 {q:'ord',fr:"Il s'est mis à faire froid, hein.",t:['寒く|さむく','なりました','ね'],x:['に']}]},
{id:'l29',zone:14,who:'tanu',xp:40,title:"〜より〜のほうが",sub:"Comparer deux choses",
 cards:[
 {h:"A est plus … que B",f:"A は B より 〜です",x:"<b>より</b> se place après ce à quoi on compare : « plus que B ». L'adjectif ne change pas : 大きい reste 大きい.",
  ex:[{t:['塔|とう','は','家|いえ','より','高い|たかい','です','。'],fr:"La tour est plus haute que la maison."},{t:['今日|きょう','は','昨日|きのう','より','寒い|さむい','です','。'],fr:"Aujourd'hui, il fait plus froid qu'hier."}]},
 {h:"Lequel est le plus… ?",f:"A と B と どちらが 〜ですか",x:"Pour demander entre deux choses : <b>どちら</b> (lequel des deux). On répond avec <b>〜のほうが</b> : « c'est plutôt… ».",
  ex:[{t:['お茶|おちゃ','と','水|みず','と','どちら','が','好き|すき','です','か','。'],fr:"Entre le thé et l'eau, lequel préfères-tu ?"},{t:['お茶|おちゃ','の','ほう','が','好き|すき','です','。'],fr:"Je préfère le thé."}]},
 {h:"Le plus de tous",f:"〜の中で 〜が いちばん 〜です",x:"Avec trois choses ou plus : <b>いちばん</b> (numéro un, le plus).",
  ex:[{t:['この','町|まち','の','中|なか','で','、','あの','時計|とけい','が','いちばん','大きい|おおきい','です','。'],fr:"Dans cette ville, cette horloge est la plus grande."}]}],
 ex:[
 {q:'gap',fr:"La tour est plus haute que la maison.",t:['塔|とう','は','家|いえ','＿','高い|たかい','です','。'],a:'より',o:['より','から','まで','ので'],why:"Plus que : より."},
 {q:'gap',fr:"Je préfère le thé.",t:['お茶|おちゃ','の','＿','が','好き|すき','です','。'],a:'ほう',o:['ほう','より','中','どちら'],why:"〜のほうが : c'est plutôt…"},
 {q:'gap',fr:"Lequel préfères-tu ?",t:['＿','が','好き|すき','です','か','。'],a:'どちら',o:['どちら','どこ','だれ','いつ'],why:"Entre deux choses : どちら."},
 {q:'mcq',p:"« Cette horloge est la plus grande »",a:'この時計がいちばん大きいです。',o:['この時計がいちばん大きいです。','この時計より大きいです。','この時計のほうです。','この時計は大きくないです。'],why:"Le plus : いちばん."},
 {q:'ord',fr:"Aujourd'hui, il fait plus froid qu'hier.",t:['今日|きょう','は','昨日|きのう','より','寒い|さむい','です'],x:['から']},
 {q:'mcq',p:"Que veut dire cette phrase ?",t:['犬|いぬ','より','猫|ねこ','の','ほう','が','好き|すき','です','。'],a:"Je préfère les chats aux chiens.",o:["Je préfère les chats aux chiens.","Je préfère les chiens aux chats.","J'aime les chiens et les chats.","Les chats aiment les chiens."],why:"犬より : plus que les chiens ; 猫のほうが : plutôt les chats."}]},
{id:'l30',zone:14,who:'tanu',xp:40,title:"〜とき",sub:"Dire « quand… »",
 cards:[
 {h:"Quand je fais…",f:"verbe (forme du dictionnaire) + とき",x:"<b>とき</b> veut dire « le moment où ». On le met après un verbe à la forme du dictionnaire : <b>寝るとき</b> (quand je me couche), <b>出かけるとき</b> (quand je sors).",
  ex:[{t:['寝る|ねる','とき','、','電気|でんき','を','消します|けします','。'],fr:"Quand je me couche, j'éteins la lumière."},{t:['出かける|でかける','とき','、','かぎ','を','持ちます|もちます','。'],fr:"Quand je sors, je prends la clé."}]},
 {h:"Quand c'est… (adjectifs, noms)",f:"〜い とき · 〜な とき · 名詞 の とき",x:"Après un adjectif en い, rien à changer : <b>暑いとき</b>. Adjectif en な : <b>ひまなとき</b>. Nom : <b>子供のとき</b> (quand j'étais enfant).",
  ex:[{t:['暑い|あつい','とき','は','海|うみ','に','行きます|いきます','。'],fr:"Quand il fait chaud, je vais à la mer."},{t:['子供|こども','の','とき','、','犬|いぬ','が','好き|すき','でした','。'],fr:"Quand j'étais enfant, j'aimais les chiens."}]}],
 ex:[
 {q:'gap',fr:"Quand je me couche, j'éteins la lumière.",t:['寝る|ねる','＿','、','電気|でんき','を','消します|けします','。'],a:'とき',o:['とき','から','まで','より'],why:"寝る + とき = quand je me couche."},
 {q:'gap',fr:"Quand j'étais enfant, j'aimais les chiens.",t:['子供|こども','＿','とき','、','犬|いぬ','が','好き|すき','でした','。'],a:'の',o:['の','な','に','が'],why:"Nom + の + とき."},
 {q:'gap',fr:"Quand j'ai du temps libre, je lis.",t:['ひま','＿','とき','、','本|ほん','を','読みます|よみます','。'],a:'な',o:['な','の','に','だ'],why:"Adjectif en な + な + とき."},
 {q:'mcq',p:"« Quand il fait chaud, je vais à la mer. »",a:'暑いとき、海に行きます。',o:['暑いとき、海に行きます。','暑いのとき、海に行きます。','暑くとき、海に行きます。','暑いなとき、海に行きます。'],why:"Adjectif en い + とき, sans rien ajouter."},
 {q:'mcq',p:"Que veut dire « 出かけるとき、かぎを持ちます » ?",a:"Quand je sors, je prends la clé.",o:["Quand je sors, je prends la clé.","Après être sorti, je prends la clé.","Je sors sans la clé.","Je cherche la clé pour sortir."],why:"とき = au moment où."},
 {q:'ord',fr:"Quand je sors, je prends la clé.",t:['出かける|でかける','とき','かぎ','を','持ちます|もちます'],x:['から']}]},
{id:'l31',zone:15,who:'tanu',xp:40,title:"まっすぐ行って、右に曲がって",sub:"Indiquer le chemin",
 cards:[
 {h:"Tout droit, à droite, à gauche",f:"まっすぐ 行きます · 右に 曲がります · 左に 曲がります",x:"<b>まっすぐ</b> : tout droit. <b>曲がります</b> (まがります) : tourner. On tourne <b>に</b> un côté : <b>右に</b> (à droite), <b>左に</b> (à gauche).",
  ex:[{t:['まっすぐ','行って|いって','ください','。'],fr:"Allez tout droit, s'il vous plaît."},{t:['右|みぎ','に','曲がって|まがって','ください','。'],fr:"Tournez à droite, s'il vous plaît."}]},
 {h:"Enchaîner les indications",f:"〜て、〜て ください",x:"Avec la forme て, on enchaîne les étapes dans l'ordre : <b>まっすぐ行って、右に曲がってください</b>. Seul le dernier verbe porte ください.",
  ex:[{t:['まっすぐ','行って|いって','、','左|ひだり','に','曲がって|まがって','ください','。'],fr:"Allez tout droit, puis tournez à gauche."},{t:['橋|はし','を','渡って|わたって','、','右|みぎ','に','曲がって|まがって','ください','。'],fr:"Traversez le pont, puis tournez à droite."}]},
 {h:"Demander son chemin",f:"〜は どこですか · 〜は どちらですか",x:"<b>どこ</b> : où. <b>どちら</b> : de quel côté (plus poli). Les points cardinaux : <b>東</b> (ひがし) est, <b>西</b> (にし) ouest, <b>南</b> (みなみ) sud, <b>北</b> (きた) nord.",
  ex:[{t:['駅|えき','は','どちら','です','か','。'],fr:"La gare, c'est de quel côté ?"},{t:['北|きた','は','あちら','です','。'],fr:"Le nord, c'est par là."}]}],
 ex:[
 {q:'gap',fr:"Allez tout droit, s'il vous plaît.",t:['＿','行って|いって','ください','。'],a:'まっすぐ',o:['まっすぐ','右に','どこ','北'],why:"Tout droit : まっすぐ."},
 {q:'gap',fr:"Tournez à droite, s'il vous plaît.",t:['右|みぎ','＿','曲がって|まがって','ください','。'],a:'に',o:['に','を','が','で'],why:"On tourne に un côté : 右に."},
 {q:'gap',fr:"Allez tout droit, puis tournez à gauche.",t:['まっすぐ','＿','、','左|ひだり','に','曲がって|まがって','ください','。'],a:'行って',o:['行って','行きます','行く','行った'],why:"Pour enchaîner : la forme て."},
 {q:'mcq',p:"« La gare, c'est de quel côté ? »",a:'駅はどちらですか。',o:['駅はどちらですか。','駅はだれですか。','駅はいつですか。','駅はいくらですか。'],why:"De quel côté : どちら."},
 {q:'mcq',p:"Le soleil se lève à…",t:['東|ひがし'],a:"l'est",o:["l'est","l'ouest","le nord","le sud"],why:"東 (ひがし) : l'est."},
 {q:'ord',fr:"Traversez le pont, puis tournez à droite.",t:['橋|はし','を','渡って|わたって','右|みぎ','に','曲がって|まがって','ください'],x:['が']},
 {q:'mcq',p:"Que veut dire cette phrase ?",t:['北|きた','は','あちら','です','。'],a:"Le nord, c'est par là.",o:["Le nord, c'est par là.","Le sud, c'est ici.","Va vers le nord.","Le nord est loin."],why:"北 : nord · あちら : par là."}]},
{id:'l32',zone:15,who:'tanu',xp:40,title:"〜ないでください",sub:"Demander de ne pas faire",
 cards:[
 {h:"La forme en ない",f:"行きます → 行かない · 食べます → 食べない",x:"Pour dire « ne pas » en langage simple, on met le verbe à la forme <b>ない</b>. Verbes en <b>-ます</b> avec <b>e</b> ou <b>i</b> (食べます, 見ます) : on remplace ます par <b>ない</b>. Les autres : le son en <b>-i</b> devient <b>-a</b> + ない (行き → 行か<b>ない</b>, 飲み → 飲ま<b>ない</b>). Attention : 来ます → <b>来ない</b> (こない), します → <b>しない</b>.",
  ex:[{t:['行かない|いかない'],fr:"ne pas aller"},{t:['食べない|たべない'],fr:"ne pas manger"},{t:['しない'],fr:"ne pas faire"}]},
 {h:"Ne fais pas…, s'il te plaît",f:"〜ないで ください",x:"<b>ない</b> + <b>で ください</b> : une demande polie de ne pas faire quelque chose.",
  ex:[{t:['ここ','で','走らないで|はしらないで','ください','。'],fr:"Ne courez pas ici, s'il vous plaît."},{t:['北|きた','へ','行かないで|いかないで','ください','。'],fr:"N'allez pas au nord, s'il vous plaît."}]},
 {h:"Entre amis",f:"〜ないで。",x:"Entre proches, on garde juste <b>〜ないで</b> : <b>行かないで</b>, « ne pars pas ».",
  ex:[{t:['心配|しんぱい','しないで','。'],fr:"Ne t'inquiète pas."},{t:['忘れないで|わすれないで','。'],fr:"Ne m'oublie pas."}]}],
 ex:[
 {q:'gap',fr:"Ne courez pas ici, s'il vous plaît.",t:['ここ','で','走らないで|はしらないで','＿','。'],a:'ください',o:['ください','です','ます','ない'],why:"〜ないでください : la demande polie."},
 {q:'gap',fr:"N'allez pas au nord, s'il vous plaît.",t:['北|きた','へ','＿','ください','。'],a:'行かないで',o:['行かないで','行って','行きます','行かない'],why:"Ne pas aller : 行かないで ください."},
 {q:'mcq',p:"La forme ない de 食べます",a:'食べない',o:['食べない','食べらない','食ばない','食べかない'],why:"食べます → 食べない : on remplace ます par ない."},
 {q:'mcq',p:"La forme ない de 来ます",a:'こない',o:['こない','きない','くない','きまない'],why:"来ます est irrégulier : 来ない (こない)."},
 {q:'mcq',p:"« Ne t'inquiète pas. »",a:'心配しないで。',o:['心配しないで。','心配してください。','心配します。','心配でした。'],why:"Ne pas faire : しないで."},
 {q:'ord',fr:"Ne coupez pas les câbles, s'il vous plaît.",t:['線|せん','を','切らないで|きらないで','ください'],x:['に']},
 {q:'mcq',p:"Que veut dire cette phrase ?",t:['忘れないで|わすれないで','。'],a:"Ne m'oublie pas.",o:["Ne m'oublie pas.","Je n'oublie pas.","Tu as oublié.","Oublie-moi."],why:"忘れます : oublier · 〜ないで : ne… pas."}]},
{id:'l33',zone:16,who:'tanu',xp:40,title:"〜がほしいです",sub:"Dire ce qu'on veut avoir",
 cards:[
 {h:"Je veux… (une chose)",f:"〜が ほしいです",x:"<b>ほしい</b> : vouloir AVOIR quelque chose. La chose voulue prend <b>が</b>. Pour vouloir FAIRE, c'est 〜たい (la leçon d'avant).",
  ex:[{t:['新しい|あたらしい','本|ほん','が','ほしい','です','。'],fr:"Je veux un nouveau livre."},{t:['友達|ともだち','が','ほしい','です','。'],fr:"Je voudrais des amis."}]},
 {h:"Je ne veux pas",f:"〜は ほしくないです",x:"ほしい est un adjectif en い : au négatif, <b>ほしくないです</b>. On met souvent <b>は</b> à la place de が.",
  ex:[{t:['お金|おかね','は','ほしくない','です','。'],fr:"Je ne veux pas d'argent."}]},
 {h:"Tu veux quoi ?",f:"何が ほしいですか",x:"Pour demander : <b>何がほしいですか</b>. Attention : on ne dit pas « il veut » avec ほしい, seulement « je veux » et « tu veux ? ».",
  ex:[{t:['誕生日|たんじょうび','に','何|なに','が','ほしい','です','か','。'],fr:"Qu'est-ce que tu veux pour ton anniversaire ?"}]}],
 ex:[
 {q:'gap',fr:"Je veux un nouveau livre.",t:['新しい|あたらしい','本|ほん','＿','ほしい','です','。'],a:'が',o:['が','を','に','で'],why:"La chose voulue prend が."},
 {q:'gap',fr:"Je ne veux pas d'argent.",t:['お金|おかね','は','＿','です','。'],a:'ほしくない',o:['ほしくない','ほしい','ほしかった','ほしいない'],why:"Négatif d'un adjectif en い : 〜くない."},
 {q:'mcq',p:"« Qu'est-ce que tu veux ? »",a:'何がほしいですか。',o:['何がほしいですか。','何をしますか。','何ですか。','何がありますか。'],why:"Vouloir avoir : ほしい."},
 {q:'mcq',p:"Vouloir FAIRE (manger) se dit…",a:'食べたいです',o:['食べたいです','食べほしいです','食べがほしいです','食べないです'],why:"Pour une action : 〜たい ; pour une chose : ほしい."},
 {q:'ord',fr:"Je voudrais des amis.",t:['友達|ともだち','が','ほしい','です'],x:['を']},
 {q:'mcq',p:"Que veut dire cette phrase ?",t:['大きい|おおきい','かばん','が','ほしい','です','。'],a:"Je veux un grand sac.",o:["Je veux un grand sac.","J'ai un grand sac.","Le sac est grand.","Je n'aime pas les grands sacs."],why:"〜がほしいです : je veux (avoir)."}]},
{id:'l34',zone:16,who:'tanu',xp:40,title:"もう・まだ",sub:"Déjà, pas encore",
 cards:[
 {h:"Déjà",f:"もう 〜ました",x:"<b>もう</b> + verbe au passé : c'est <b>déjà</b> fait.",
  ex:[{t:['もう','食べました|たべました','。'],fr:"J'ai déjà mangé."},{t:['花|はな','は','もう','起きました|おきました','。'],fr:"Hana est déjà réveillée."}]},
 {h:"Pas encore",f:"まだ 〜ていません",x:"<b>まだ</b> + forme <b>〜ていません</b> : ce n'est <b>pas encore</b> fait (mais ça viendra). On ne dit pas まだ〜ませんでした.",
  ex:[{t:['まだ','食べて|たべて','いません','。'],fr:"Je n'ai pas encore mangé."},{t:['宿題|しゅくだい','は','まだ','して','いません','。'],fr:"Je n'ai pas encore fait mes devoirs."}]},
 {h:"Répondre vite",f:"もう〜ましたか · はい、もう · いいえ、まだです",x:"À la question <b>もう〜ましたか</b> (« tu as déjà… ? »), on répond <b>はい、もう〜ました</b> ou simplement <b>いいえ、まだです</b>.",
  ex:[{t:['もう','会いました|あいました','か','。'],fr:"Vous vous êtes déjà rencontrés ?"},{t:['いいえ','、','まだ','です','。'],fr:"Non, pas encore."}]}],
 ex:[
 {q:'gap',fr:"J'ai déjà mangé.",t:['＿','食べました|たべました','。'],a:'もう',o:['もう','まだ','いつも','よく'],why:"Déjà : もう + passé."},
 {q:'gap',fr:"Je n'ai pas encore mangé.",t:['まだ','食べて|たべて','＿','。'],a:'いません',o:['いません','いました','ません','でした'],why:"Pas encore : まだ〜ていません."},
 {q:'mcq',p:"« Tu as déjà lu ce livre ? » — « Non, pas encore. »",a:'いいえ、まだです。',o:['いいえ、まだです。','いいえ、もうです。','はい、まだです。','いいえ、読みました。'],why:"Pas encore : まだです."},
 {q:'mcq',p:"Que veut dire もう起きました ?",a:"Je suis déjà levé.",o:["Je suis déjà levé.","Je ne suis pas encore levé.","Je me lève bientôt.","Je me lève toujours tôt."],why:"もう + passé : déjà."},
 {q:'ord',fr:"Je n'ai pas encore fait mes devoirs.",t:['宿題|しゅくだい','は','まだ','して','いません'],x:['もう']},
 {q:'mcq',p:"Que veut dire cette phrase ?",t:['テツ','は','まだ','名前|なまえ','を','返して|かえして','いません','。'],a:"Tetsu n'a pas encore rendu les noms.",o:["Tetsu n'a pas encore rendu les noms.","Tetsu a déjà rendu les noms.","Tetsu ne rendra jamais les noms.","Tetsu rend les noms."],why:"まだ〜ていません : pas encore."}]}];
 NEW.forEach(L=>{L.ex.forEach((e,i)=>{e.id=L.id+'.'+i;e.les=L.id});L.cards.forEach(c=>c.ex.forEach(e=>phrAdd(e.t,e.fr,L.id)));LESSONS.push(L)})}

/* ---------- acte IV — leçons de la plage des naufragés (Maître Tanuki, trempé) ---------- */
{const NEW=[
{id:'l35',zone:17,who:'tanu',xp:45,title:"〜ない",sub:"La forme négative familière",
 cards:[
 {h:"Entre amis : ne… pas",f:"〜ません → 〜ない",x:"Entre amis, on ne dit pas <b>食べません</b> mais <b>食べない</b>. Pour les verbes en る (食べる, 見る), on enlève <b>る</b> et on ajoute <b>ない</b>.",
  ex:[{t:['今日|きょう','は','食べない|たべない','。'],fr:"Aujourd'hui, je ne mange pas."},{t:['テレビ','は','見ない','。'],fr:"Je ne regarde pas la télé."}]},
 {h:"Les autres verbes",f:"行く → 行かない · 飲む → 飲まない",x:"Pour les autres verbes, le dernier son passe en <b>あ</b> : 行<b>く</b> → 行<b>か</b>ない, 飲<b>む</b> → 飲<b>ま</b>ない, 話<b>す</b> → 話<b>さ</b>ない. Attention : 会<b>う</b> → 会<b>わ</b>ない.",
  ex:[{t:['海|うみ','に','行かない|いかない','。'],fr:"Je ne vais pas à la mer."},{t:['お酒|おさけ','は','飲まない|のまない','。'],fr:"Je ne bois pas d'alcool."}]},
 {h:"Les deux irréguliers",f:"する → しない · 来る → 来ない (こない)",x:"<b>する</b> devient <b>しない</b>, <b>来る</b> devient <b>来ない</b> (こない). Et <b>ある</b> devient… <b>ない</b> tout court !",
  ex:[{t:['宿題|しゅくだい','を','しない','。'],fr:"Je ne fais pas mes devoirs."},{t:['お金|おかね','が','ない','。'],fr:"Je n'ai pas d'argent."}]}],
 ex:[
 {q:'gap',fr:"Je ne mange pas.",t:['食べ','＿','。'],a:'ない',o:['ない','ません','なく','だ'],why:"食べる : on enlève る et on ajoute ない."},
 {q:'gap',fr:"Je ne vais pas à la mer.",t:['海|うみ','に','＿','。'],a:'行かない',o:['行かない','行きない','行くない','行けない'],why:"行く → 行か + ない (く devient か)."},
 {q:'gap',fr:"Je ne bois pas d'alcool.",t:['お酒|おさけ','は','＿','。'],a:'飲まない',o:['飲まない','飲みない','飲むない','飲めない'],why:"飲む → 飲ま + ない."},
 {q:'mcq',p:"La forme en ない de する est…",a:'しない',o:['しない','すない','さない','せない'],why:"する est irrégulier : しない."},
 {q:'mcq',p:"« Je n'ai pas d'argent » (familier)",a:'お金がない。',o:['お金がない。','お金があらない。','お金がありない。','お金がしない。'],why:"ある → ない, tout court."},
 {q:'mcq',p:"La forme en ない de 会う (rencontrer) est…",a:'会わない',o:['会わない','会あない','会うない','会いない'],why:"Les verbes en う font わない."},
 {q:'ord',fr:"Je ne regarde pas la télé.",t:['テレビ','は','見ない'],x:['ません']}]},
{id:'l36',zone:17,who:'tanu',xp:45,title:"あまり・ぜんぜん",sub:"Pas beaucoup, pas du tout",
 cards:[
 {h:"Pas beaucoup",f:"あまり + négatif",x:"<b>あまり</b> s'emploie toujours avec un verbe ou un adjectif au <b>négatif</b> : « pas beaucoup, pas très ».",
  ex:[{t:['魚|さかな','は','あまり','好き|すき','じゃない','。'],fr:"Je n'aime pas trop le poisson."},{t:['今日|きょう','は','あまり','暑く|あつく','ない','です','。'],fr:"Aujourd'hui, il ne fait pas très chaud."}]},
 {h:"Pas du tout",f:"ぜんぜん + négatif",x:"<b>ぜんぜん</b> : « pas du tout ». Lui aussi demande le négatif.",
  ex:[{t:['魚|さかな','が','ぜんぜん','いません','。'],fr:"Il n'y a pas du tout de poisson."},{t:['ぜんぜん','わかりません','。'],fr:"Je ne comprends rien du tout."}]},
 {h:"Toujours au négatif",f:"✗ あまり好きです · ✓ あまり好きじゃないです",x:"Même si la phrase française n'a pas de « ne », la phrase japonaise avec あまり ou ぜんぜん est <b>toujours</b> négative.",
  ex:[{t:['海|うみ','は','ぜんぜん','こわくない','です','。'],fr:"La mer, ça ne me fait pas peur du tout."}]}],
 ex:[
 {q:'gap',fr:"Il n'y a pas du tout de poisson.",t:['魚|さかな','が','＿','いません','。'],a:'ぜんぜん',o:['ぜんぜん','とても','たくさん','よく'],why:"Pas du tout : ぜんぜん + négatif."},
 {q:'gap',fr:"Je n'aime pas trop le poisson.",t:['魚|さかな','は','あまり','好き|すき','＿','。'],a:'じゃない',o:['じゃない','です','だ','でした'],why:"あまり demande le négatif."},
 {q:'mcq',p:"« Je ne comprends rien du tout. »",a:'ぜんぜんわかりません。',o:['ぜんぜんわかりません。','ぜんぜんわかります。','あまりわかります。','とてもわかりません。'],why:"ぜんぜん + négatif."},
 {q:'mcq',p:"Quelle phrase est correcte ?",a:'あまり暑くないです。',o:['あまり暑くないです。','あまり暑いです。','ぜんぜん暑いです。','とても暑くないです。'],why:"あまり va toujours avec un négatif."},
 {q:'ord',fr:"Aujourd'hui, il ne fait pas très chaud.",t:['今日|きょう','は','あまり','暑く|あつく','ない','です'],x:['とても']},
 {q:'mcq',p:"Que veut dire cette phrase ?",t:['海|うみ','は','ぜんぜん','こわくない','です','。'],a:"La mer ne me fait pas peur du tout.",o:["La mer ne me fait pas peur du tout.","La mer me fait très peur.","La mer me fait un peu peur.","Je n'aime pas la mer."],why:"ぜんぜん + négatif : pas du tout."}]},
{id:'l37',zone:18,who:'tanu',xp:45,title:"〜なければなりません",sub:"Dire ce qu'il faut faire",
 cards:[
 {h:"Il faut…",f:"forme en ない sans い + ければなりません",x:"On part de la forme en ない : 食べ<b>ない</b> → 食べ<b>なければなりません</b> (il faut manger). Littéralement : « si on ne mange pas, ça ne va pas ».",
  ex:[{t:['毎日|まいにち','勉強|べんきょう','しなければ','なりません','。'],fr:"Il faut étudier tous les jours."},{t:['七時|しちじ','に','起きなければ|おきなければ','なりません','。'],fr:"Je dois me lever à sept heures."}]},
 {h:"Les autres verbes",f:"行かない → 行かなければなりません",x:"Même chose pour tous les verbes : 行か<b>ない</b> → 行か<b>なければなりません</b>, 払わない → 払わなければなりません. する → <b>しなければなりません</b>, 来る → <b>来なければなりません</b> (こなければ).",
  ex:[{t:['もう','帰らなければ|かえらなければ','なりません','。'],fr:"Je dois déjà rentrer."},{t:['薬|くすり','を','飲まなければ|のまなければ','なりません','。'],fr:"Il faut prendre le médicament."}]},
 {h:"Les lois de l'Empereur",f:"〜は〜なければなりません",x:"C'est la forme des règles et des obligations. L'Empereur Kinmaru l'adore : <b>火曜日は歩かなければなりません</b>. (« Le mardi, il faut marcher. » Les autres jours, on fait ce qu'on veut.)",
  ex:[{t:['火曜日|かようび','は','歩かなければ|あるかなければ','なりません','。'],fr:"Le mardi, il faut marcher."}]}],
 ex:[
 {q:'gap',fr:"Il faut étudier tous les jours.",t:['毎日|まいにち','勉強|べんきょう','＿','なりません','。'],a:'しなければ',o:['しなければ','しないで','します','すれば'],why:"する → しない → しなければなりません."},
 {q:'gap',fr:"Je dois me lever à sept heures.",t:['七時|しちじ','に','＿','なりません','。'],a:'起きなければ',o:['起きなければ','起きないで','起きて','起きない'],why:"起きない → 起きなければ."},
 {q:'gap',fr:"Il faut prendre le médicament.",t:['薬|くすり','を','＿','なりません','。'],a:'飲まなければ',o:['飲まなければ','飲みなければ','飲むなければ','飲まないで'],why:"飲む → 飲まない → 飲まなければ."},
 {q:'mcq',p:"« Je dois déjà rentrer. »",a:'もう帰らなければなりません。',o:['もう帰らなければなりません。','もう帰ってください。','もう帰りません。','もう帰りたいです。'],why:"帰る → 帰らない → 帰らなければなりません."},
 {q:'mcq',p:"Que veut dire « 火曜日は歩かなければなりません » ?",a:"Le mardi, il faut marcher.",o:["Le mardi, il faut marcher.","Le mardi, on ne marche pas.","Le mardi, je veux marcher.","Le mardi, on peut marcher."],why:"〜なければなりません = il faut."},
 {q:'ord',fr:"Il faut étudier tous les jours.",t:['毎日|まいにち','勉強|べんきょう','しなければ','なりません'],x:['ないで']}]},
{id:'l38',zone:18,who:'tanu',xp:45,title:"A や B",sub:"Énumérer : « … et … (entre autres) »",
 cards:[
 {h:"Et… entre autres",f:"A や B",x:"<b>と</b> donne une liste complète : 「パンと卵」 = du pain et des œufs (c'est tout). <b>や</b> donne quelques exemples : 「パンや卵」 = du pain, des œufs… (et d'autres choses).",
  ex:[{t:['デパート','で','ネクタイ','や','洋服|ようふく','を','買いました|かいました','。'],fr:"Au grand magasin, j'ai acheté des cravates, des vêtements, etc."},{t:['机|つくえ','の','上|うえ','に','本|ほん','や','ペン','が','あります','。'],fr:"Sur le bureau, il y a des livres, des stylos…"}]},
 {h:"Et cetera",f:"A や B など",x:"On ajoute souvent <b>など</b> à la fin pour dire « etc. » : 「りんごやみかんなど」.",
  ex:[{t:['りんご','や','みかん','など','が','好き|すき','です','。'],fr:"J'aime les pommes, les mandarines, etc."}]}],
 ex:[
 {q:'gap',fr:"J'ai acheté des cravates, des vêtements, etc.",t:['ネクタイ','＿','洋服|ようふく','を','買いました|かいました','。'],a:'や',o:['や','を','に','で'],why:"や : on cite quelques exemples."},
 {q:'gap',fr:"Il y a des livres, des stylos… sur le bureau.",t:['机|つくえ','の','上|うえ','に','本|ほん','＿','ペン','が','あります','。'],a:'や',o:['や','は','が','の'],why:"や = « … et … (entre autres) »."},
 {q:'mcq',p:"Laquelle donne une liste COMPLÈTE ?",a:'パンと卵を食べました。',o:['パンと卵を食べました。','パンや卵を食べました。','パンや卵などを食べました。','パンも卵も食べません。'],why:"と = liste complète ; や = quelques exemples."},
 {q:'mcq',p:"« J'aime les pommes, les mandarines, etc. »",a:'りんごやみかんなどが好きです。',o:['りんごやみかんなどが好きです。','りんごをみかんが好きです。','りんごにみかんが好きです。','りんごでみかんが好きです。'],why:"A や B など = A, B, etc."},
 {q:'ord',fr:"Au grand magasin, j'ai acheté des cravates, des vêtements, etc.",t:['デパート','で','ネクタイ','や','洋服|ようふく','を','買いました|かいました'],x:['と']}]},
{id:'l39',zone:19,who:'tanu',xp:45,title:"〜ながら",sub:"Faire deux choses en même temps",
 cards:[
 {h:"En même temps",f:"verbe en ます sans ます + ながら",x:"On prend la forme en ます et on enlève ます : 飲み<b>ます</b> → 飲み<b>ながら</b>. Ça veut dire « en buvant ». L'action <b>importante</b> vient à la fin de la phrase.",
  ex:[{t:['音楽|おんがく','を','聞きながら|ききながら','勉強します|べんきょうします','。'],fr:"J'étudie en écoutant de la musique."},{t:['お茶|おちゃ','を','飲みながら|のみながら','話しました|はなしました','。'],fr:"Nous avons parlé en buvant du thé."}]},
 {h:"Une seule personne",f:"A ながら B",x:"Les deux actions sont faites par <b>la même personne</b>. Le temps (passé, présent) se met seulement sur le dernier verbe : 「歌いながら歩きました」 = j'ai marché en chantant.",
  ex:[{t:['山|やま','に','登りながら|のぼりながら','歌いました|うたいました','。'],fr:"J'ai chanté en montant la montagne."}]}],
 ex:[
 {q:'gap',fr:"J'étudie en écoutant de la musique.",t:['音楽|おんがく','を','聞き|きき','＿','勉強します|べんきょうします','。'],a:'ながら',o:['ながら','たり','から','まで'],why:"radical en ます + ながら = en faisant…"},
 {q:'mcq',p:"« en buvant du thé »",a:'お茶を飲みながら',o:['お茶を飲みながら','お茶を飲んだり','お茶を飲みますながら','お茶を飲むながら'],why:"飲みます → 飲み + ながら."},
 {q:'mcq',p:"「歩きながら話しました。」 veut dire :",a:"Nous avons parlé en marchant.",o:["Nous avons parlé en marchant.","Nous avons marché, puis parlé.","Nous avons parlé de la marche.","Nous ne marchons pas en parlant."],why:"〜ながら : les deux actions en même temps."},
 {q:'gap',fr:"Il regarde la montagne en buvant du thé.",t:['お茶|おちゃ','を','＿','山|やま','を','見ます|みます','。'],a:'飲みながら',o:['飲みながら','飲んだり','飲みます','飲んで'],why:"飲みます → 飲みながら."},
 {q:'ord',fr:"J'ai chanté en montant la montagne.",t:['山|やま','に','登りながら|のぼりながら','歌いました|うたいました'],x:['たり']}]},
{id:'l40',zone:19,who:'tanu',xp:45,title:"〜たり〜たりします",sub:"Des actions parmi d'autres",
 cards:[
 {h:"Je fais ceci, cela…",f:"forme en た + り … たりします",x:"On prend la forme en た et on ajoute <b>り</b> : 読ん<b>だ</b> → 読ん<b>だり</b>. On cite deux actions en exemple, <b>parmi d'autres</b>. À la fin, on met <b>します</b> (ou した, しました…).",
  ex:[{t:['日曜日|にちようび','は','本|ほん','を','読んだり|よんだり','テレビ','を','見たり|みたり','します','。'],fr:"Le dimanche, je lis, je regarde la télé, ce genre de choses."},{t:['山|やま','で','写真|しゃしん','を','撮ったり|とったり','歌ったり|うたったり','しました','。'],fr:"À la montagne, on a pris des photos, chanté, etc."}]},
 {h:"Comme や, mais pour les verbes",f:"A たり B たり",x:"<b>や</b> donne quelques exemples de choses ; <b>〜たり〜たり</b> donne quelques exemples d'actions. L'ordre n'a pas d'importance.",
  ex:[{t:['お風呂|おふろ','に','入ったり|はいったり','寝たり|ねたり','したい','です','。'],fr:"J'ai envie de prendre un bain, de dormir, ce genre de choses."}]}],
 ex:[
 {q:'gap',fr:"Le dimanche, je lis, je regarde la télé, etc.",t:['日曜日|にちようび','は','本|ほん','を','読んだり|よんだり','テレビ','を','見|み','＿','します','。'],a:'たり',o:['たり','ながら','て','から'],why:"〜たり〜たりします = des actions parmi d'autres."},
 {q:'mcq',p:"Quelle phrase est correcte ?",a:'写真を撮ったり、歌ったりしました。',o:['写真を撮ったり、歌ったりしました。','写真を撮りたり、歌いたりしました。','写真を撮ったり、歌ったしました。','写真を撮ったり、歌いながらしました。'],why:"forme en た + り, deux fois, puis します / しました."},
 {q:'mcq',p:"「掃除したり洗濯したりします。」 veut dire :",a:"Je fais le ménage, la lessive, ce genre de choses.",o:["Je fais le ménage, la lessive, ce genre de choses.","Je fais le ménage en faisant la lessive.","Je ne fais ni le ménage ni la lessive.","Je fais d'abord le ménage, et seulement ensuite la lessive."],why:"〜たり〜たり : des exemples d'actions, sans ordre."},
 {q:'gap',fr:"J'ai envie de prendre un bain, de dormir, etc.",t:['お風呂|おふろ','に','＿','寝たり|ねたり','したい','です','。'],a:'入ったり',o:['入ったり','入りながら','入って','入ります'],why:"入ります → 入った → 入ったり."},
 {q:'ord',fr:"À la montagne, on a pris des photos, chanté, etc.",t:['山|やま','で','写真|しゃしん','を','撮ったり|とったり','歌ったり|うたったり','しました'],x:['ながら']}]},
{id:'l41',zone:20,who:'tanu',xp:45,title:"〜でしょう",sub:"Dire ce qui va « sans doute » arriver",
 cards:[
 {h:"Sans doute…",f:"phrase simple + でしょう",x:"On met <b>でしょう</b> après un verbe à la forme simple (降る), un adjectif en い (暑い), ou un nom / adjectif en な (雨, 静か). C'est une <b>supposition</b> : la météo, l'avenir, ce qu'on ne sait pas sûrement.",
  ex:[{t:['明日|あした','は','雨|あめ','でしょう','。'],fr:"Demain, il pleuvra sans doute."},{t:['山|やま','の','上|うえ','は','寒い|さむい','でしょう','。'],fr:"En haut de la montagne, il fera sans doute froid."}]},
 {h:"Une question polie",f:"〜でしょう か",x:"Avec <b>か</b>, ça devient une question très polie : 「駅はどこでしょうか」 = « Où peut bien être la gare ? ». Plus doux que 「どこですか」.",
  ex:[{t:['トイレ','は','どこ','でしょう','か','。'],fr:"Où sont les toilettes, s'il vous plaît ?"}]}],
 ex:[
 {q:'gap',fr:"Demain, il pleuvra sans doute.",t:['明日|あした','は','雨|あめ','＿','。'],a:'でしょう',o:['でしょう','ました','ません','たい'],why:"でしょう = sans doute (supposition)."},
 {q:'mcq',p:"« En haut de la montagne, il fera sans doute froid. »",a:'山の上は寒いでしょう。',o:['山の上は寒いでしょう。','山の上は寒かったです。','山の上は寒くないです。','山の上は寒いですか。'],why:"adjectif en い + でしょう."},
 {q:'mcq',p:"「駅はどこでしょうか。」 c'est :",a:"une question très polie",o:["une question très polie","un ordre","une phrase au passé","une interdiction"],why:"〜でしょうか = question douce et polie."},
 {q:'gap',fr:"Ce soir, ce sera sans doute calme.",t:['今晩|こんばん','は','静か|しずか','＿','。'],a:'でしょう',o:['でしょう','だった','な','に'],why:"adjectif en な (sans な) + でしょう."},
 {q:'ord',fr:"Demain aussi, il fera sans doute chaud.",t:['明日|あした','も','暑い|あつい','でしょう'],x:['ました']}]},
{id:'l42',zone:20,who:'tanu',xp:45,title:"〜ほうがいいです",sub:"Donner un conseil : « il vaut mieux… »",
 cards:[
 {h:"Il vaut mieux faire…",f:"forme en た + ほうがいいです",x:"Pour conseiller de <b>faire</b> quelque chose, on prend la forme en た : 休ん<b>だ</b> → 休ん<b>だほうがいいです</b> = « tu ferais mieux de te reposer ».",
  ex:[{t:['早く|はやく','寝た|ねた','ほう','が','いい','です','。'],fr:"Tu ferais mieux de te coucher tôt."},{t:['ヘルメット','を','かぶった','ほう','が','いい','です','よ','。'],fr:"Tu ferais mieux de mettre un casque."}]},
 {h:"Il vaut mieux ne pas…",f:"forme en ない + ほうがいいです",x:"Pour conseiller de <b>ne pas</b> faire, on garde la forme en ない : 走ら<b>ない</b>ほうがいいです = « il vaut mieux ne pas courir ».",
  ex:[{t:['暗い|くらい','から','走らない|はしらない','ほう','が','いい','です','。'],fr:"Il fait sombre, il vaut mieux ne pas courir."}]}],
 ex:[
 {q:'gap',fr:"Tu ferais mieux de te reposer.",t:['休んだ|やすんだ','＿','が','いい','です','。'],a:'ほう',o:['ほう','から','まで','より'],why:"forme en た + ほうがいいです."},
 {q:'mcq',p:"« Il vaut mieux ne pas courir. »",a:'走らないほうがいいです。',o:['走らないほうがいいです。','走ったほうがいいです。','走るほうがいいでした。','走らないでほうがいいです。'],why:"forme en ない + ほうがいい."},
 {q:'mcq',p:"「薬を飲んだほうがいいです。」 veut dire :",a:"Tu ferais mieux de prendre le médicament.",o:["Tu ferais mieux de prendre le médicament.","J'ai pris le médicament.","Il ne faut pas prendre de médicament.","Je veux prendre le médicament."],why:"〜たほうがいい = conseil."},
 {q:'gap',fr:"Tu ferais mieux de mettre un casque.",t:['ヘルメット','を','＿','ほう','が','いい','です','。'],a:'かぶった',o:['かぶった','かぶります','かぶって','かぶりたい'],why:"かぶります → かぶった + ほうがいい."},
 {q:'ord',fr:"Il fait sombre, il vaut mieux ne pas courir.",t:['暗い|くらい','から','走らない|はしらない','ほう','が','いい','です'],x:['たり']}]},
{id:'l43',zone:21,who:'tanu',xp:50,title:"〜つもりです",sub:"Dire ce qu'on a l'intention de faire",
 cards:[
 {h:"J'ai l'intention de…",f:"verbe au dictionnaire + つもりです",x:"On met <b>つもりです</b> après la forme du dictionnaire : 帰<b>る</b>つもりです = « j'ai l'intention de rentrer ». C'est un projet décidé, plus ferme que 〜たいです (« j'ai envie »).",
  ex:[{t:['明日|あした','国|くに','へ','帰る|かえる','つもり','です','。'],fr:"Demain, j'ai l'intention de rentrer dans mon pays."},{t:['日本語|にほんご','を','毎日|まいにち','勉強する|べんきょうする','つもり','です','。'],fr:"Je compte étudier le japonais tous les jours."}]},
 {h:"Je n'ai pas l'intention de…",f:"forme en ない + つもりです",x:"Pour dire qu'on ne compte <b>pas</b> faire quelque chose : 行か<b>ない</b>つもりです = « je ne compte pas y aller ».",
  ex:[{t:['もう','負けない|まけない','つもり','です','。'],fr:"Je n'ai pas l'intention de perdre encore."}]}],
 ex:[
 {q:'gap',fr:"Demain, j'ai l'intention de rentrer.",t:['明日|あした','帰る|かえる','＿','です','。'],a:'つもり',o:['つもり','たい','ながら','ほう'],why:"forme du dictionnaire + つもりです = intention."},
 {q:'mcq',p:"« Je compte étudier tous les jours. »",a:'毎日勉強するつもりです。',o:['毎日勉強するつもりです。','毎日勉強したつもりです。','毎日勉強しますつもりです。','毎日勉強してつもりです。'],why:"する (dictionnaire) + つもりです."},
 {q:'mcq',p:"「行かないつもりです。」 veut dire :",a:"Je n'ai pas l'intention d'y aller.",o:["Je n'ai pas l'intention d'y aller.","Je veux y aller.","Il vaut mieux ne pas y aller.","Je n'y suis pas allé."],why:"forme en ない + つもりです."},
 {q:'gap',fr:"Je n'ai pas l'intention de perdre encore.",t:['もう','＿','つもり','です','。'],a:'負けない',o:['負けない','負けて','負けた','負けます'],why:"負けます → 負けない + つもり."},
 {q:'ord',fr:"Demain, j'ai l'intention de rentrer dans mon pays.",t:['明日|あした','国|くに','へ','帰る|かえる','つもり','です'],x:['たい']}]},
{id:'l44',zone:21,who:'tanu',xp:50,title:"〜のが好きです",sub:"Aimer faire quelque chose",
 cards:[
 {h:"Faire, c'est un nom",f:"verbe au dictionnaire + の",x:"Avec <b>の</b>, un verbe devient une chose : 読む<b>の</b> = « le fait de lire ». On peut alors dire qu'on l'aime : 本を読む<b>のが好きです</b> = « j'aime lire des livres ».",
  ex:[{t:['本|ほん','を','読む|よむ','の','が','好き|すき','です','。'],fr:"J'aime lire des livres."},{t:['歌う|うたう','の','が','上手|じょうず','です','。'],fr:"Il chante bien (il est doué pour chanter)."}]},
 {h:"Aimer, détester, savoir faire",f:"〜のが 好き・嫌い・上手・下手です",x:"La même construction marche avec <b>嫌い</b> (détester), <b>上手</b> (doué) et <b>下手</b> (pas doué) : 料理を作る<b>のが下手です</b> = « je cuisine mal ».",
  ex:[{t:['朝|あさ','早く|はやく','起きる|おきる','の','が','嫌い|きらい','です','。'],fr:"Je déteste me lever tôt le matin."}]}],
 ex:[
 {q:'gap',fr:"J'aime lire des livres.",t:['本|ほん','を','読む|よむ','＿','が','好き|すき','です','。'],a:'の',o:['の','を','に','で'],why:"verbe + の = « le fait de… »."},
 {q:'mcq',p:"« Il chante bien. »",a:'歌うのが上手です。',o:['歌うのが上手です。','歌うが上手です。','歌いのが上手です。','歌ってが上手です。'],why:"forme du dictionnaire + のが上手です."},
 {q:'mcq',p:"「起きるのが嫌いです。」 veut dire :",a:"Je déteste me lever.",o:["Je déteste me lever.","Je me lève tôt.","Je ne me suis pas levé.","Il vaut mieux se lever."],why:"〜のが嫌いです = détester faire…"},
 {q:'gap',fr:"Je cuisine mal.",t:['料理|りょうり','を','作る|つくる','の','が','＿','です','。'],a:'下手',o:['下手','上手','好き','大きい'],why:"下手 (へた) = pas doué."},
 {q:'ord',fr:"J'aime lire des livres.",t:['本|ほん','を','読む|よむ','の','が','好き|すき','です'],x:['に']}]}

];
 NEW.forEach(L=>{L.ex.forEach((e,i)=>{e.id=L.id+'.'+i;e.les=L.id});L.cards.forEach(c=>c.ex.forEach(e=>phrAdd(e.t,e.fr,L.id)));LESSONS.push(L)})}

const O='#2a1f3a';
const hash=(x,y)=>{let h=(x*374761393+y*668265263)|0;h=(h^(h>>>13))*1274126177|0;return(h^(h>>>16))>>>0};
function mk(w,h){const c=document.createElement('canvas');c.width=w;c.height=h;const x=c.getContext('2d');x.imageSmoothingEnabled=false;return{c,x,R:(a,b,cw,ch,col)=>{x.fillStyle=col;x.fillRect(a,b,cw,ch)},P:(a,b,col)=>{x.fillStyle=col;x.fillRect(a,b,1,1)},
 C:(px,py,r,col)=>{x.fillStyle=col;for(let j=-r;j<=r;j++)for(let i=-r;i<=r;i++)if(i*i+j*j<=r*r+r*.6)x.fillRect(px+i,py+j,1,1)}}}
/* ---------- palettes de sol ---------- */
const shade=(h,f)=>{const n=parseInt(h.slice(1),16);const c=v=>Math.max(0,Math.min(255,Math.round(v*f)));return '#'+((1<<24)|(c((n>>16)&255)<<16)|(c((n>>8)&255)<<8)|c(n&255)).toString(16).slice(1)};
const PAL={
 gr:{a:'#78c850',b:'#58a838',c:'#a0e070',p:'#e8d098',q:'#c8a868',h:'#f4e4b4'},
 ba:{a:'#4a9a58',b:'#2e7a48',c:'#78c078',p:'#d8c088',q:'#b89858',h:'#ecd8a0'},
 me:{a:'#8890a8',b:'#6a7090',c:'#a8b0c8',p:'#c09860',q:'#987040',h:'#d8b880'},
 as:{a:'#6a5058',b:'#4a3440',c:'#8a6a68',p:'#a07868',q:'#7a5448',h:'#c09888'}};
function flower(p,x,y,c1,c2){p(x,y,c2);p(x-1,y,c1);p(x+1,y,c1);p(x,y-1,c1);p(x,y+1,c1)}
function ground(P,v){const s=mk(T,T),{R,P:p}=s;R(0,0,T,T,P.a);
 [[2,3],[9,1],[5,9],[13,7],[1,13],[10,13],[14,3]].forEach(([x,y])=>p(x,y,P.b));
 [[6,5],[14,11],[3,7],[8,14]].forEach(([x,y])=>p(x,y,P.c));
 if(v===1){[[3,4],[11,7],[6,12]].forEach(([x,y])=>{p(x,y,P.b);p(x-1,y+1,P.b);p(x+1,y+1,P.b);p(x,y+1,P.b);p(x,y-1,P.c)})}
 if(v===2){flower(p,4,4,'#fff','#f8d848');flower(p,11,10,'#f8a0c8','#fff')}
 if(v===3){[[2,2],[10,5],[5,10],[12,12]].forEach(([x,y])=>{p(x,y,P.c);p(x+1,y,P.c);p(x,y+1,P.b);p(x+1,y+1,P.b)})}
 return s.c}
function dirt(P,v){const s=mk(T,T),{R,P:p}=s;R(0,0,T,T,P.p);
 [[2,2],[9,1],[5,6],[13,7],[1,11],[8,12],[12,14],[14,3]].forEach(([x,y],i)=>{if(v===0||i%2===v%2){R(x,y,2,1,P.q);p(x,y+1,P.q);p(x+1,y-1<0?0:y-1,P.h)}});
 [[6,3],[3,9],[11,10],[7,14]].forEach(([x,y])=>p(x,y,P.h));return s.c}
function metal(v){const s=mk(T,T),{R,P:p}=s,M=PAL.me;R(0,0,T,T,M.a);R(0,0,T,1,M.c);R(0,T-1,T,1,M.b);R(0,0,1,T,M.c);R(T-1,0,1,T,M.b);[[2,2],[13,2],[2,13],[13,13]].forEach(([x,y])=>{p(x,y,M.b);p(x-1<0?0:x-1,y-1<0?0:y-1,M.c)});R(4,4,8,1,M.b);R(4,11,8,1,M.c);if(v){R(5,6,6,4,M.b);R(5,6,6,1,M.c);p(8,8,'#40f0ff')}return s.c}
function rail(){const s=mk(T,T),{R}=s,M=PAL.me;R(0,0,T,T,M.a);R(0,0,T,1,M.c);[1,5,9,13].forEach(y=>{R(0,y,T,2,'#6a4a30');R(0,y,T,1,'#8a6a44')});R(3,0,2,T,'#c8d0e0');R(3,0,1,T,'#fff');R(4,0,1,T,'#8890a8');R(11,0,2,T,'#c8d0e0');R(11,0,1,T,'#fff');R(12,0,1,T,'#8890a8');return s.c}
function leafDots(s,cx,cy,r,seed,cols){for(let i=0;i<r*3;i++){const h=hash(i,seed),a=(h%628)/100,d=(h>>>8)%100/100*r*.8;s.P(Math.round(cx+Math.cos(a)*d),Math.round(cy+Math.sin(a)*d),cols[h%cols.length])}}
function tree(){const s=mk(T,T),{R,C,P}=s;R(3,13,10,3,'#58a838');R(6,11,4,5,O);R(7,11,2,5,'#6a4028');R(7,11,1,5,'#8a5a38');C(8,7,7,O);C(8,7,6,'#2e7a3a');C(7,6,5,'#3e9444');C(6,5,3,'#5cb858');leafDots(s,8,7,6,7,['#5cb858','#2e7a3a','#78d060','#3e9444']);R(4,3,2,1,'#a8e878');P(6,2,'#a8e878');R(9,12,3,1,'#1e5a2c');R(5,11,3,1,'#1e5a2c');return s.c}
function treeBig(){const s=mk(32,32),{R,C,P}=s;R(0,0,32,32,'rgba(0,0,0,0)');s.x.clearRect(0,0,32,32);R(5,28,22,4,'rgba(60,120,40,.7)');R(13,22,6,10,O);R(14,22,4,10,'#6a4028');R(14,22,1,10,'#8a5a38');C(16,14,15,O);C(16,14,14,'#2e7a3a');C(14,12,10,'#3e9444');C(11,9,6,'#5cb858');C(21,19,5,'#2a6c34');leafDots(s,16,14,13,11,['#5cb858','#2e7a3a','#78d060','#3e9444','#1e5a2c']);R(7,6,4,1,'#a8e878');R(9,5,2,1,'#a8e878');R(12,4,3,1,'#a8e878');R(18,24,6,1,'#1e5a2c');return s.c}
function sakura(){const s=mk(T,T),{R,C,P}=s;R(3,13,10,3,'#58a838');R(6,11,4,5,O);R(7,11,2,5,'#6a4028');C(8,7,7,O);C(8,7,6,'#e878a8');C(7,6,5,'#f090b8');C(6,5,3,'#ffc0d8');leafDots(s,8,7,6,3,['#ffd8e8','#e878a8','#f8a8c8','#d85888']);R(4,3,2,1,'#fff0f6');P(6,2,'#fff0f6');return s.c}
function paddy(f,bank){const s=mk(T,T),{R,P}=s;R(0,0,T,T,'#6ab0a8');R(0,0,T,1,'#4a8880');R(0,T-1,T,1,'#5a9a92');for(let r=0;r<3;r++){const y=2+r*5;for(let x=(r%2)*2;x<T;x+=4){R(x,y+1,2,3,'#3e9a3c');R(x,y,2,1,'#78c850');R(x+1,y+1,1,2,'#58b048');P(x,y-1<0?0:y-1,'#a0e070')}}if(f){R(3,14,3,1,'#c8f0e8');R(10,9,3,1,'#c8f0e8')}
 if(bank==='R'){R(T-3,0,3,T,'#a07838');R(T-3,0,1,T,'#d8b068');R(T-1,0,1,T,'#6a4a28')}if(bank==='L'){R(0,0,3,T,'#a07838');R(2,0,1,T,'#d8b068');R(0,0,1,T,'#6a4a28')}return s.c}
function bamboo(v){const s=mk(T,T),{R,P}=s;R(0,0,T,T,'#2e6a48');R(0,0,T,3,'#245a3c');[1+v,7,12-v].forEach((x,i)=>{R(x,0,4,T,O);R(x+1,0,2,T,'#78c850');R(x+1,0,1,T,'#b8e878');R(x+3,0,1,T,'#2e7a40');for(let y=2+i*3;y<T;y+=7){R(x,y,4,1,O);R(x+1,y-1,2,1,'#4a9a3c')}});P(5,5,'#40f0ff');P(10,12,'#40f0ff');P(9,2,'#40f0ff');return s.c}
function wall(v){const s=mk(T,T),{R,P}=s;R(0,0,T,T,'#3c4058');R(0,0,T,1,'#5a6080');R(0,T-1,T,1,'#2a2c40');
 if(v===0){R(0,4,T,6,O);R(0,5,T,4,'#c08840');R(0,5,T,1,'#f0c068');R(0,8,T,1,'#8a5a28');[2,7,12].forEach(x=>{R(x,4,3,6,'#a06a30');P(x+1,6,'#f0c068')});P(1,13,'#40f0ff');P(14,2,'#40f0ff')}
 if(v===1){R(2,2,12,12,O);R(3,3,10,10,'#6a7090');R(3,3,10,1,'#a8b0c8');for(let y=5;y<13;y+=3){R(4,y,8,1,'#40f0ff');R(4,y+1,8,1,'#3a8a98')}R(2,2,12,1,'#f0c068')}
 if(v===2){R(7,0,3,T,O);R(8,0,1,T,'#c08840');R(9,0,1,T,'#8a5a28');R(0,7,T,3,O);R(0,8,T,1,'#c08840');P(2,2,'#f0c068');P(12,12,'#f0c068');P(2,12,'#f0c068');P(12,2,'#f0c068')}
 return s.c}
function rock(){const s=mk(T,T),{R,P}=s;R(0,0,T,T,'#3a2a38');R(0,0,T,2,'#5a4050');R(0,2,T,1,'#4a3444');R(2,6,5,1,'#e04820');R(7,7,3,1,'#f8a030');R(9,11,4,1,'#e04820');R(1,13,T-2,2,'#2a1c28');P(12,4,'#5a4050');P(4,10,'#5a4050');return s.c}
