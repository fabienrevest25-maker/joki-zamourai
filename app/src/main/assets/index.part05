   else if(B.bento){B.bento=0;sfx('ok');await msg('Le coup glisse : tu avais bien mangé. Aucun dégât.',{auto:1100})}
   else{const d=Math.round((def.dmg+rnd(5))*(stiff?1.8:1)*(B.rage?1.35:1));await hitM(d);await msg(`Touché ! Tu perds ${B.ld} PV.`,{auto:800})}
   if(S.hp<=0){sfx('faint');(window.BFX&&BFX.pose(2)),$('#bsMe').classList.add('dead');await tween(500,p=>{B.down=p});await msg([jl(['目|め','の','前|まえ','が','まっくら','に','なった','…'],'Tout devient noir…')],{auto:1500});out='lose';break}}
  // --- fin ---
  let old=S.xp;
  if(out==='win'){Quest.add('win');Quests.onWin(def);jingle('victory');{const gd=def.gold||(def.wild?4+def.lv:def.id==='boss'?150:45);S.gold=(S.gold||0)+gd;def._gold=gd}music(null);if(!IM.A_victory)sfx('win');const first=!S.wins[def.id],xp=def.wild?def.xp:(first?def.xp:10);S.xp+=xp;if(!def.wild)S.wins[def.id]=1;S.wild=(S.wild||0)+(def.wild?1:0);
   await msg(`Tu gagnes ${xp} points d'expérience et ${def._gold} 円 !`,{auto:1300});sfx('xp');await tween(500,p=>{$('#mXp').style.width=((old%30)+(Math.min(xp,30-old%30))*p)/30*100+'%'});
   if(level(S.xp)>level(old)){sfx('lvl');$('#mLv').textContent='Nv '+level(S.xp);await msg([jl(['レベル','アップ','！'],`Niveau ${level(S.xp)} !`)],{auto:1300})}
   if(def.word)await msg([{jp:def.word.t,fr:`Mot libéré : ${def.word.fr}`}],{auto:1500})}
  save();D.hide();await UI.fade(1,260);$('#hpE').classList.add('hidden');$('#hpM').classList.add('hidden');$('#bscene').classList.add('hidden');$('#app').classList.remove('battle');B=null;G.scene='world';music(pm);if(out==='lose')respawnNow();
  if(out==='win'&&!window.PRO&&stage(S.xp)>stage(old)){await Evo.run(stage(old),stage(S.xp))}
  UI.panel('pad');await UI.fade(0,260);return out}
 return{start,drawScene,get on(){return !!B},dbg:()=>B}})();

/* ---------- évolution ---------- */
const Evo=(()=>{let E=null;
 function drawScene(t){if(!E)return;g.fillStyle='#181c30';g.fillRect(0,0,SW,SH);
  for(let i=0;i<14;i++){const a=i/14*Math.PI*2+t*.6;g.fillStyle=i%2?'rgba(120,200,255,.16)':'rgba(255,230,140,.16)';for(let r=20;r<160;r+=6)g.fillRect(Math.round(120+Math.cos(a)*r)-2,Math.round(80+Math.sin(a)*r)-2,4+r/30,4+r/30)}
  const sw=E.mix<0?false:E.mix>=1?true:(Math.floor(t*(4+E.mix*26))%2===1),nm=STG[sw?E.b:E.a],hi=XI['C_'+nm+'_00'];
  for(let r=64;r>14;r-=10){g.fillStyle=`rgba(88,224,236,${.035+(64-r)*.003})`;g.beginPath();g.arc(120,92,r+Math.sin(t*2.5)*3,0,7);g.fill()}
  if(hi&&hi.width){const h=112,w=hi.width*h/hi.height,bob=Math.sin(t*2)*2;if(E.white){const q=mk(hi.width,hi.height);q.x.drawImage(hi,0,0);q.x.globalCompositeOperation='source-atop';q.x.fillStyle='#eaffff';q.x.fillRect(0,0,hi.width,hi.height);g.drawImage(q.c,120-w/2,30+bob,w,h)}else g.drawImage(hi,120-w/2,30+bob,w,h)}
  }
 async function run(a,b){E={a,b,mix:-1,white:false};G.scene='evo';UI.panel('evo');$('#evA').src=IM['C_'+STG[a]+'_00'];$('#evB').src=IM['C_'+STG[b]+'_00'];$('#evB').style.filter='brightness(0)';$('#evNext').classList.add('hidden');music(null);await UI.fade(0,260);
  const m=(t,o)=>D.say(t,Object.assign({panel:false,auto:1200,keep:1},o));
  await m([{jp:['おや','…','？'],fr:`Quoi ? ${STAGES[a].name} évolue !`}]);E.white=true;sfx('evo');const t0=performance.now();await new Promise(r=>{const f=()=>{const p=(performance.now()-t0)/3200;E.mix=Math.min(.999,p);p<1?requestAnimationFrame(f):r()};f()});
  E.mix=1;E.white=false;sfx('lvl');$('#evB').style.filter='';await UI.fade(1,90,true);await UI.fade(0,200,true);
  await m([{jp:['おめでとう','！'],fr:`Félicitations ! Tu deviens ${STAGES[b].name} !`}],{auto:1800});
  S.hp=maxHp();save();D.hide();await UI.fade(1,260);E=null;G.scene='world'}
 return{run,drawScene}})();
async function afterXp(old){if(stage(S.xp)>stage(old)){await Evo.run(stage(old),stage(S.xp));UI.panel('pad');await UI.fade(0,260)}}

/* ---------- effets de sorts dessinés (canvas basse résolution posé sur la scène de combat) ---------- */
const SpellFx=(()=>{
 const cv=$('#bsFx'),x=cv.getContext('2d');let W_=240,H_=200,raf=0;
 const rs=n=>{let s=n*9301+49297;return()=>{s=(s*9301+49297)%233280;return s/233280}};
 const ez=t=>1-(1-t)*(1-t),cl=(v,a,b)=>Math.max(a,Math.min(b,v));
 const C=(px,py,r,c,a)=>{x.globalAlpha=a==null?1:a;x.fillStyle=c;x.beginPath();x.arc(px,py,Math.max(.5,r),0,7);x.fill();x.globalAlpha=1};
 const R=(px,py,w,h,c,a)=>{x.globalAlpha=a==null?1:a;x.fillStyle=c;x.fillRect(Math.round(px),Math.round(py),Math.max(1,Math.round(w)),Math.max(1,Math.round(h)));x.globalAlpha=1};
 const FX={
  '火'(t,E,M){const r=rs(7);
   if(t<.4){const p=t/.4,px=M.x+(E.x-M.x)*p,py=M.y+(E.y-M.y)*p-Math.sin(p*3.14)*26;for(let i=0;i<9;i++){const q=i/9;C(px-q*22*(1-p*.3)+r()*4,py+q*8+r()*4-2,6-q*5,i%2?'#ffb030':'#e04818',.8-q*.6)}C(px,py,9,'#e04818');C(px,py,6.5,'#ffb030');C(px,py,3.5,'#fff3a0')}
   else{const p=(t-.4)/.6,f=1-p;C(E.x,E.y,30*ez(p),'#ffb030',f*.5);C(E.x,E.y,20*ez(p),'#fff3a0',f*.6);
    for(let i=0;i<16;i++){const a=i/16*6.28+r(),d=10+ez(p)*(22+r()*20);C(E.x+Math.cos(a)*d,E.y+Math.sin(a)*d*.8,5*f+1,i%3?'#e04818':'#ffb030',f)}
    for(let i=0;i<14;i++){const fx=E.x-26+i*4,h=(14+r()*22)*Math.sin(Math.min(1,p*2.2)*1.57)*(.6+.4*Math.sin(t*40+i)),c=['#e04818','#ff7a1a','#ffb030','#fff3a0'];for(let k=0;k<4;k++)R(fx+k*.4,E.y+24-h*(1-k*.22),3.2-k*.5,h*(1-k*.22),c[k],f)}}},
  '水'(t,E,M){const r=rs(11),p=ez(t),front=M.x+20+(E.x-M.x+40)*p;
   for(let i=0;i<34;i++){const wx=front-i*3.2,h=(16+10*Math.sin(i*.5+t*18))*Math.max(0,1-i/34)*(t<.75?1:(1-t)*4);if(wx<M.x)continue;R(wx,E.y+22-h,3.4,h,i<3?'#eaf6ff':i%4?'#3a8ad8':'#5aa8f0',.9);if(i<6)R(wx,E.y+20-h-2,3.4,3,'#fff',.9)}
   if(t>.45)for(let i=0;i<22;i++){const q=(t-.45)/.55,a=-1.57+(r()-.5)*2.4,v=30+r()*40;C(E.x+Math.cos(a)*v*q,E.y+10+Math.sin(a)*v*q+60*q*q,1.6+r()*1.6,i%3?'#5aa8f0':'#eaf6ff',1-q)}},
  '木'(t,E,M){const r=rs(5),g=Math.min(1,t/.6),f=t>.8?(1-t)*5:1;
   for(let v=0;v<6;v++){const bx=E.x-24+v*9.5+r()*4,top=(30+r()*26)*ez(g),ph=r()*6;let lx=bx,ly=E.y+26;
    for(let s=0;s<top;s+=2){const nx=bx+Math.sin(s*.16+ph)*6,ny=E.y+26-s;R(nx-1.5,ny,3.4,2.4,'#6a4a22',f);R(nx-.6,ny,1.4,2.4,'#9a7438',f);lx=nx;ly=ny}
    if(g>.5){const k=(g-.5)*2;for(let l=0;l<3;l++){const a=l*2.1+ph;x.globalAlpha=f;x.fillStyle=l%2?'#3e9a48':'#78d060';x.beginPath();x.ellipse(lx+Math.cos(a)*5*k,ly+Math.sin(a)*4*k,4.5*k,2.2*k,a,0,7);x.fill();x.globalAlpha=1}}}
   if(t>.5)for(let i=0;i<10;i++){const q=(t-.5)*2;R(E.x-30+r()*60+Math.sin(q*6+i)*5,E.y-30+r()*30+q*30,2.5,1.6,i%2?'#78d060':'#3e9a48',1-q)}},
  '土'(t,E,M){const r=rs(3),g=Math.min(1,t/.35),f=t>.75?(1-t)*4:1;
   for(let i=0;i<5;i++){const bx=E.x-26+i*13+r()*4,h=(22+r()*24)*ez(g),w=9+r()*4;x.globalAlpha=f;x.fillStyle='#7a5028';x.beginPath();x.moveTo(bx-w/2,E.y+26);x.lineTo(bx+r()*3,E.y+26-h);x.lineTo(bx+w/2,E.y+26);x.fill();x.fillStyle='#c89858';x.beginPath();x.moveTo(bx-w/2,E.y+26);x.lineTo(bx+r()*3-1,E.y+26-h);x.lineTo(bx-w/6,E.y+26);x.fill();x.globalAlpha=1}
   for(let i=0;i<14;i++){const a=-1.57+(r()-.5)*2.6,v=24+r()*34,q=t;R(E.x+Math.cos(a)*v*q,E.y+18+Math.sin(a)*v*q+50*q*q,2+r()*3,2+r()*3,i%2?'#a8743a':'#5a3c1c',1-q)}
   for(let i=0;i<8;i++)C(E.x-30+i*8.5,E.y+24-t*8,5+t*7,'#c8b090',(1-t)*.5)},
  '山'(t,E,M){const p=Math.min(1,t/.4),y=-30+(E.y+30)*p*p,q=t>.4?(t-.4)/.6:0;const by=q?E.y-Math.abs(Math.sin(q*6))*8*(1-q):y;
   C(E.x,by,17,'#5a5a70',q?1-q*q:1);C(E.x-3,by-3,13,'#8a8aa0',q?1-q*q:1);C(E.x-6,by-7,5,'#b8b8cc',q?1-q*q:1);
   if(q)for(let i=0;i<10;i++){C(E.x-40+i*9,E.y+24-q*6,5+q*9,'#c8c0b0',(1-q)*.55)}},
  '風'(t,E,M){const r=rs(9);
   for(let s=0;s<3;s++){const p=cl((t-s*.18)/.4,0,1);if(p<=0||p>=1)continue;const a0=[-2.4,-.4,-1.4][s],cx0=E.x+[-6,6,0][s],cy0=E.y+[4,-2,8][s],rad=30+s*4;x.lineCap='round';
    for(const[c,w,a]of[['#a8e8e0',6,.5],['#e8ffff',3,.95]]){x.globalAlpha=a*(1-p*p);x.strokeStyle=c;x.lineWidth=w*(1-p*.5);x.beginPath();x.arc(cx0,cy0,rad,a0+p*2.6-.9,a0+p*2.6);x.stroke()}x.globalAlpha=1}
   for(let i=0;i<12;i++){const p=(t*1.6+r())%1,y=E.y-34+r()*64;R(M.x+30+(E.x-M.x+50)*p,y,10+r()*14,1.4,i%2?'#e8ffff':'#a8e8e0',.75*(1-p))}},
  '雷'(t,E,M){const fl=Math.floor(t*14);if(fl%3===0&&t<.7)R(0,0,W_,H_,'#fff',.35);
   if(t<.75)for(let b=0;b<2;b++){const r=rs(fl*7+b);let px=E.x-10+b*18+r()*8,py=0;x.lineJoin='miter';for(const[c,w]of[['#8fe8ff',4.5],['#fff',1.8]]){const q=rs(fl*7+b);let ax=px,ay=0;x.strokeStyle=c;x.lineWidth=w;x.beginPath();x.moveTo(ax,ay);while(ay<E.y+16){ax+=(q()-.5)*20;ay+=7+q()*9;x.lineTo(ax+(E.x-ax)*.25,ay)}x.stroke()}}
   C(E.x,E.y+8,26*(1-t)+6,'#8fe8ff',(1-t)*.5);const r2=rs(2);for(let i=0;i<10;i++){const a=r2()*6.28,d=10+t*46;R(E.x+Math.cos(a)*d,E.y+6+Math.sin(a)*d*.7,2.4,2.4,i%2?'#fff':'#fff080',1-t)}},
  '人'(t,E,M){for(let k=0;k<3;k++){const p=cl(t*1.5-k*.2,0,1);if(!p||p>=1)continue;x.globalAlpha=1-p;x.strokeStyle=k%2?'#fff':'#ffd84a';x.lineWidth=4*(1-p)+1;x.beginPath();x.arc(E.x,E.y,8+p*38,0,7);x.stroke();x.globalAlpha=1}
   const f=1-t;for(let i=0;i<12;i++){const a=i/12*6.28,d0=6+t*18,d1=14+ez(t)*40;x.globalAlpha=f;x.strokeStyle=i%2?'#ffd84a':'#fff';x.lineWidth=2.4;x.beginPath();x.moveTo(E.x+Math.cos(a)*d0,E.y+Math.sin(a)*d0);x.lineTo(E.x+Math.cos(a)*d1,E.y+Math.sin(a)*d1);x.stroke();x.globalAlpha=1}}};
 /* kanji des thèmes : le caractère file vers l'ennemi puis éclate en éclats cyan */
 function neutral(k){return(t,E,M)=>{const r=rs(k.charCodeAt(0));
  if(t<.45){const p=ez(t/.45),px=M.x+(E.x-M.x)*p,py=M.y-10+(E.y-M.y+10)*p;x.font=`${22+p*14}px "Kaisei Decol","Hiragino Mincho ProN","Yu Mincho",serif`;x.textAlign='center';x.textBaseline='middle';x.shadowColor='#58e0ec';x.shadowBlur=10;x.fillStyle='#eaffff';x.fillText(k,px,py);x.shadowBlur=0;for(let i=0;i<6;i++)R(px-10-r()*26*p,py-8+r()*16,2,2,'#58e0ec',.7)}
  else{const q=(t-.45)/.55;C(E.x,E.y,10+q*30,'#58e0ec',(1-q)*.45);for(let i=0;i<26;i++){const a=r()*6.28,d=ez(q)*(14+r()*38);R(E.x+Math.cos(a)*d,E.y+Math.sin(a)*d*.85+q*q*14,3*(1-q)+1,3*(1-q)+1,i%3?'#58e0ec':'#fff',1-q)}}}}
 function play(k,ms){return new Promise(res=>{cancelAnimationFrame(raf);const b=$('#bscene').getBoundingClientRect();W_=240;H_=Math.max(120,Math.round(240*b.height/Math.max(1,b.width)));cv.width=W_;cv.height=H_;x.imageSmoothingEnabled=false;
  const f=FX[k]||neutral(k),E={x:W_*.79,y:H_*.44},M={x:W_*.24,y:H_*.66},t0=performance.now(),dur=ms||(k==='雷'?800:1000);
  const loop=()=>{const t=(performance.now()-t0)/dur;x.clearRect(0,0,W_,H_);if(t>=1){res();return}try{f(t,E,M)}catch(e){}raf=requestAnimationFrame(loop)};loop()})}
 return{play}})();

/* ---------- personnages, gardiens, scripts ---------- */
const NPN={kotoba:'Maître Kotoba',tanu:'Maître Tanuki',baa:'Grand-mère Ume',bozu:'Moine Jaku',eng:'Ingénieure Rin',worker:'Contremaître Gonta',forg:'Forgeronne Hagane',master:'Maître Genzō'};
