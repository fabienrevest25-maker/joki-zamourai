 @keyframes gTick16{0%,78%{rotate:0deg}100%{rotate:22.5deg}}
 @keyframes gTick16R{0%,78%{rotate:0deg}100%{rotate:-22.5deg}}
 @keyframes gGlow{0%,100%{box-shadow:inset 0 0 0 calc(.5*var(--q)) #0a0d18,inset 0 0 calc(4*var(--q)) rgba(0,0,0,.6),0 0 calc(1*var(--q)) var(--c)}50%{box-shadow:inset 0 0 0 calc(.5*var(--q)) #0a0d18,inset 0 0 calc(4*var(--q)) rgba(0,0,0,.6),0 0 calc(4*var(--q)) var(--c)}}
 @keyframes gRoll{0%{opacity:0;translate:var(--gx,0) var(--gy,0);scale:.35;rotate:-160deg}70%{opacity:1;scale:1.06}100%{translate:0 0;scale:1;rotate:0deg}}
 @keyframes gSpin{0%{opacity:0;scale:.2;rotate:200deg;filter:brightness(2)}65%{opacity:1;scale:1.08;filter:brightness(1.3)}100%{scale:1;rotate:0deg;filter:none}}
 @keyframes gHit{0%{scale:1;filter:brightness(1)}30%{scale:.9;filter:brightness(1.7)}100%{scale:1;filter:brightness(1)}}
 @media (prefers-reduced-motion:no-preference){
  html.skin #dCh.uiO .btn{animation:uiItem .26s ease-out both}html.skin #dCh.uiO .btn:nth-child(2){animation-delay:.06s}html.skin #dCh.uiO .btn:nth-child(3){animation-delay:.12s}html.skin #dCh.uiO .btn:nth-child(n+4){animation-delay:.18s}
  html.skin #study.uiS>*{animation:uiSwap .22s ease-out both}}
 @media (prefers-reduced-motion:no-preference){
  html.skin .gbox.uiO{animation:uiOpen .3s cubic-bezier(.2,.8,.3,1.2) both!important}
  html.skin #dlg.uiO{transform-origin:50% 100%}
  html.skin .gbox.uiC{animation:uiClose .18s ease-in both!important;pointer-events:none}
  html.skin #hpE.uiO{animation:uiSlideL .42s cubic-bezier(.2,.8,.3,1.15) both!important}
  html.skin #hpM.uiO{animation:uiSlideR .42s cubic-bezier(.2,.8,.3,1.15) both!important}
  html.skin .gbox.uiS>*{animation:uiSwap .2s ease-out both}
  html.skin .gbox.uiO>*:not(#dlgN){animation:uiTxt .32s ease-out both}
  html.skin #dlgN.uiP{animation:uiPlate .42s cubic-bezier(.3,.7,.3,1.3) both}
  html.skin #choice.uiO button{animation:uiItem .26s ease-out both}
  html.skin #choice.uiO button:nth-child(2){animation-delay:.06s}html.skin #choice.uiO button:nth-child(3){animation-delay:.12s}
  html.skin #choice.uiO button:nth-child(4){animation-delay:.18s}html.skin #choice.uiO button:nth-child(n+5){animation-delay:.24s}}
 @keyframes uiOpen{0%{opacity:0;scale:.97 .12;filter:brightness(2.4) saturate(.6)}55%{opacity:1;scale:1.01 1.05;filter:brightness(1.35)}100%{opacity:1;scale:1 1;filter:none}}
 @keyframes uiClose{0%{opacity:1;scale:1 1}100%{opacity:0;scale:.97 .1;filter:brightness(1.9)}}
 @keyframes uiSlideL{0%{opacity:0;translate:-115% 0;filter:brightness(2)}70%{opacity:1;translate:3% 0;filter:brightness(1.2)}100%{translate:0 0;filter:none}}
 @keyframes uiSlideR{0%{opacity:0;translate:115% 0;filter:brightness(2)}70%{opacity:1;translate:-3% 0;filter:brightness(1.2)}100%{translate:0 0;filter:none}}
 @keyframes uiSwap{0%{opacity:.2;translate:0 calc(2.5*var(--u))}100%{opacity:1;translate:0 0}}
 @keyframes uiTxt{0%,35%{opacity:0}100%{opacity:1}}
 @keyframes uiPlate{0%{opacity:0;translate:0 -90%;rotate:-7deg}60%{opacity:1;translate:0 10%;rotate:2deg}100%{translate:0 0;rotate:0deg}}
 @keyframes uiItem{0%{opacity:0;translate:calc(7*var(--u)) 0}100%{opacity:1;translate:0 0}}`;
 let on=false;const TEX=()=>IM.UI_TEX1?['UI_TEX1',143]:['UI_TEX2',140];
 function apply(){if(on)return true;if(typeof IM==='undefined'||!IM.UI_FRAME||!IM.UI_PLATE||!(IM.UI_TEX1||IM.UI_TEX2))return false;
  const r=document.documentElement.style,[tk,tw]=TEX();r.setProperty('--uiF',`url(${IM.UI_FRAME})`);r.setProperty('--uiP',`url(${IM.UI_PLATE})`);r.setProperty('--uiT',`url(${IM.UI_TRI})`);r.setProperty('--uiA',`url(${IM.UI_ARR})`);if(IM.UI_BTN){r.setProperty('--uiB',`url(${IM.UI_BTN})`);r.setProperty('--uiBP',`url(${IM.UI_BTNP||IM.UI_BTN})`)}
  if(IM.UI_GEAR1&&IM.UI_GEAR2&&IM.UI_ROD){r.setProperty('--uiG1',`url(${IM.UI_GEAR1})`);r.setProperty('--uiG2',`url(${IM.UI_GEAR2})`);
   /* bielles : la bielle de la planche, en 3 morceaux (bouts à rivet gardés, barre étirée), posée du centre vers chaque engrenage */
   const ri=new Image();ri.onload=()=>{try{const K=10,c=document.createElement('canvas');c.width=86*K;c.height=74*K;const g=c.getContext('2d');g.imageSmoothingEnabled=false;
     const W=ri.width,H=ri.height,cap=Math.round(H),th=6.2*K,sc=th/H,ce=[43*K,37*K];
     for(const [x,y] of [[13.5,13.5],[72.5,13.5],[13.5,60.5],[72.5,60.5]]){const dx=x*K-ce[0],dy=y*K-ce[1],L=Math.hypot(dx,dy)+H*.5*sc*2*.98;
