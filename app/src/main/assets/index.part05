/* ---------- grands sprites de combat : formes + contour + ombrage automatiques ---------- */
function BIG(w,h,fn){const s=mk(w,h);
 const E=(cx,cy,rx,ry)=>(x,y)=>{const dx=(x+.5-cx)/rx,dy=(y+.5-cy)/ry;return dx*dx+dy*dy<=1};
 const Rc=(x0,y0,ww,hh)=>(x,y)=>x>=x0&&x<x0+ww&&y>=y0&&y<y0+hh;
 const Po=pts=>(x,y)=>{let c=false;const px=x+.5,py=y+.5;for(let i=0,j=pts.length-1;i<pts.length;j=i++){const[xi,yi]=pts[i],[xj,yj]=pts[j];if((yi>py)!==(yj>py)&&px<(xj-xi)*(py-yi)/(yj-yi)+xi)c=!c}return c};
 const Ln=(x1,y1,x2,y2,th)=>(x,y)=>{const px=x+.5,py=y+.5,dx=x2-x1,dy=y2-y1,l=dx*dx+dy*dy||1;let t=((px-x1)*dx+(py-y1)*dy)/l;t=Math.max(0,Math.min(1,t));return Math.hypot(px-x1-dx*t,py-y1-dy*t)<=th/2};
 const U=(...m)=>(x,y)=>m.some(f=>f(x,y));
 const Sub=(a,b)=>(x,y)=>a(x,y)&&!b(x,y);
 const And=(a,b)=>(x,y)=>a(x,y)&&b(x,y);
 function shape(m,col,o){o=o||{};const sh=o.sh===undefined?2:o.sh,dk=shade(col,o.dk||.7),lt=shade(col,o.lt||1.22);
  if(o.ol!==0){for(let y=0;y<h;y++)for(let x=0;x<w;x++){if(m(x,y))continue;if(m(x-1,y)||m(x+1,y)||m(x,y-1)||m(x,y+1))s.P(x,y,o.olc||OL)}}
  for(let y=0;y<h;y++)for(let x=0;x<w;x++){if(!m(x,y))continue;let c=col;
   if(sh){let d=false;for(let k=1;k<=sh;k++)if(!m(x+k,y+k)){d=true;break}if(d)c=dk;else if(!m(x-1,y-1))c=lt}
   s.P(x,y,c)}}
 fn({s,E,R:Rc,Po,Ln,U,Sub,And,shape,px:s.P,rect:s.R,w,h});return s.c}
const CY='#48e8f8',CY2='#c8ffff',BR='#c08840',BR2='#f0c468',BR3='#8a5a28';
const BSPR={
kakashi:()=>BIG(64,64,({E,R,Po,Ln,U,shape,px,rect})=>{
 shape(R(30,36,5,26),'#9a7040');shape(R(24,60,17,3),'#7a5a30');                       // poteau
 shape(Ln(6,27,58,27,5),'#a07848');                                                 // traverse
 shape(Po([[4,22],[12,24],[10,38],[3,34]]),'#7a6a58');shape(Po([[52,24],[60,22],[61,34],[54,38]]),'#7a6a58'); // manches
 [[3,25],[61,25]].forEach(([x,y])=>{shape(E(x,y,4,5),'#e0c868');for(let i=-2;i<3;i++)rect(x+i*1.5|0,y+4,1,4+Math.abs(i)%2,'#c8a848')});
