(()=>{const M=MAPS.world,h=HAMS.find(q=>q.z===21);if(!h)return;const at=(x,y)=>(M.rows[y]||'')[x],set=(x,y,c)=>{const r=M.rows[y];M.rows[y]=r.slice(0,x)+c+r.slice(x+1)},free=c=>c==='.'||c==='w'||c===',';
 for(let y=26;y<=h.y0;y++)for(let x=1;x<M.w-1;x++){if(at(x,y)!=='_'||(x>=31&&x<=56&&y>=37&&y<=49))continue;
  if(at(x-1,y)!=='_'&&at(x+1,y)!=='_'){if(free(at(x+1,y)))set(x+1,y,'_');else if(free(at(x-1,y)))set(x-1,y,'_')}
  if(at(x,y-1)!=='_'&&at(x,y+1)!=='_'){if(free(at(x,y+1)))set(x,y+1,'_');else if(free(at(x,y-1)))set(x,y-1,'_')}}})();
