/* ---- liste finale : panneaux drôles + astuce de la lanterne rouge ---- */
(()=>{
 const J=[
  [['ここ','に','いぬ','は','いません','。','ねこ','も','いません','。','たぶん','。'],'Ici, il n\'y a pas de chien. Pas de chat non plus. Probablement.','いません = il n\'y a pas (êtres vivants) · たぶん = probablement'],
  [['これ','を','よまないで','ください','。'],'Ne lisez pas ceci.','〜ないで ください = s\'il vous plaît, ne … pas'],
  [['たぬき','に','お金|おかね','を','あげないで','ください','。'],'Ne donnez pas d\'argent au tanuki.','お金 (おかね) = argent · あげる = donner'],
  [['ここ','から','三|さん','ぷん','。','たぶん','十|じゅっ','ぷん','。'],'À 3 minutes d\'ici. Peut-être 10.','〜ぷん / 〜ふん = minutes · から = depuis'],
  [['はしらないで','ください','。','あるいて','ください','。','もっと','ゆっくり','。'],'Ne courez pas. Marchez. Plus lentement.','はしる = courir · あるく = marcher · ゆっくり = lentement'],
  [['よる','、','ここ','で','うた','を','うたわないで','ください','。'],'La nuit, merci de ne pas chanter ici.','よる = la nuit · うた を うたう = chanter une chanson'],
  [['この','みち','は','ながい','です','。','がんばって','！'],'Ce chemin est long. Courage !','ながい = long · がんばって = courage, accroche-toi'],
  [['やすみ','ましょう','。','あなた','は','つかれて','います','。'],'Reposons-nous. Tu as l\'air fatigué.','〜ましょう = faisons … · つかれる = être fatigué'],
  [['てつ','は','わるい','人|ひと','です','。','でも','、','ひげ','は','りっぱ','です','。'],'Tetsu est méchant. Mais il a une belle moustache.','わるい = mauvais · でも = mais · りっぱ = magnifique'],
  [['ここ','で','ねないで','ください','。','とくに','あなた','。'],'Ne dormez pas ici. Surtout toi.','ねる = dormir · とくに = surtout'],
  [['みず','は','のめません','。','おちゃ','も','のめません','。','ざんねん','。'],'L\'eau n\'est pas potable. Le thé non plus. Dommage.','のめません = on ne peut pas boire · ざんねん = dommage'],
  [['右|みぎ','？','左|ひだり','？','わかりません','。'],'À droite ? À gauche ? Je ne sais pas.','右 (みぎ) = droite · 左 (ひだり) = gauche · わかりません = je ne sais pas'],
 ];
 const pick=()=>{S.fl.sgn=((S.fl.sgn||0)+1)%J.length;const j=J[S.fl.sgn];return{n:'Gribouillé en dessous',jp:j[0],fr:j[1],x:j[2]}};
 const oS=STORY.sign;STORY.sign=async s=>{if(s)await oS(s);await D.say([pick()])};
 const oI=window.XINT;window.XINT=(m,x,y,p)=>{if(m==='world'){const r=MAPS.world.rows[y];if(r&&r[x]==='S'&&!SIGNS['world:'+x+','+y])return p||(()=>STORY.sign(null))}return oI?oI(m,x,y,p):null};
 /* la lanterne rouge : une fois, quand on passe près d'une maison où l'on peut entrer */
 const oT=STORY.triggers;STORY.triggers=(x,y)=>{if(W.map==='world'&&S.fl&&S.fl.intro&&!S.fl.lanTip){const w=(MAPS.world.warps||[]).find(q=>q.to==='maison'&&Math.abs(q.x-x)+Math.abs(q.y-y)<=3);
   if(w)return async()=>{S.fl.lanTip=1;await D.say([{n:'Astuce',t:'Tu vois la petite lanterne rouge allumée à côté de cette porte ?'},{n:'Astuce',t:'Elle veut dire : « ici, on peut entrer ». Approche-toi de la porte pour visiter la maison. Les habitants ont souvent quelque chose à t\'apprendre… ou un objet à te donner.'}]);try{save()}catch(e){}}}
  return oT(x,y)};
})();
/* ---- Kome un peu plus grand : le village s'élargit de 8 colonnes vers l'est ---- */
(()=>{const M=MAPS.world;let y0=-1;for(let y=M.h-1;y>=0;y--)if(M.zone(y)===0)y0=y;else if(y0>=0)break;
 if(y0<0||M.rows[y0][18]!=='K')return;
 const put=(y,x,s)=>{const r=M.rows[y];M.rows[y]=r.slice(0,x)+s+r.slice(x+s.length)};
 for(let y=y0;y<y0+13;y++){const r=M.rows[y];
  if(y===y0){put(y,18,'FFFFFFFFKK');continue}
  if(r[18]==='K'&&r[19]==='K')put(y,18,'::::::::KK');
  else if(r[19]==='K')put(y,19,':::::::KK')}
 /* la grand-rue continue jusqu'au bout */
