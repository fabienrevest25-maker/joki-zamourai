/* explication des lectures, montrée la première fois */
window.KREAD_INTRO=["Un kanji a souvent plusieurs lectures.","訓読み (kun-yomi) : la lecture japonaise. On l'utilise surtout quand le kanji est seul, ou suivi de hiragana : 山 (やま), 食べる (たべる).","音読み (on-yomi) : la lecture venue du chinois. On l'utilise surtout dans les mots de deux kanji ou plus : 富士山 (ふじさん), 食事 (しょくじ).","Dans les fiches, la lecture kun est écrite en hiragana, la lecture on en katakana."];
window.KUNX={'一':'ひと(つ)','二':'ふた(つ)','三':'みっ(つ)','五':'いつ(つ)','六':'むっ(つ)','七':'なな(つ)','八':'やっ(つ)','九':'ここの(つ)','十':'とお','千':'ち','天':'あめ','円':'まる(い)','午':'うま','曜':'','週':'','電':'','駅':'','校':'','百':'','万':''};
window.KCARD=async function(q){q=Object.assign({},q);const M=KMEMO[q.k];if(!M)return;const d=MiniUI.open();const hira=s=>[...(s||'')].map(c=>{const x=c.charCodeAt(0);return x>=0x30A1&&x<=0x30F6?String.fromCharCode(x-96):c}).join('');
 const rm=s=>{try{return romaji([s.replace(/[()]/g,'')])}catch(e){return ''}};const onH=hira(q.on);if(q.kun===onH&&KUNX[q.k]!==undefined)q.kun=KUNX[q.k]||onH;
 const T_=x=>typeof tr==='function'?tr(x):x;const ex=[T_(M[1]),T_(M[2])].concat(q.w?[q.w+'|'+T_(q.wf||'')]:[]).map(e=>e.split('|')).filter((e,i,a)=>a.findIndex(x=>x[0]===e[0])===i);
 const lab=e=>e[1]&&onH&&e[1].includes(onH)?'<span style="color:#7ec8f0">音 on</span>':'<span style="color:#f0b060">訓 kun</span>';
 let im=IM['MN_'+q.k];if(!im&&location.protocol!=='file:'&&!window.__MNT){window.__MNT=1;try{const r=await fetch('kmemo_img.txt');if(r.ok)Object.assign(IM,await r.json())}catch(e){}im=IM['MN_'+q.k]}if(!window.KREAD&&location.protocol!=='file:'){try{const r=await fetch('kread.txt');if(r.ok)window.KREAD=await r.json()}catch(e){}}const RD=(window.KREAD||{})[q.k];const CL={kun:['訓 kun','#d8892a'],on:['音 on','#3b8fc4'],sp:['特 '+T_('spéciale'),'#9a5ab8']};const LG={kun:'訓 kun : lecture japonaise, pour un kanji seul ou suivi de hiragana.',on:'音 on : lecture venue du chinois, surtout dans les mots de plusieurs kanji.',sp:'特 spéciale : le mot entier se lit d\'une façon à part, à apprendre tel quel.'};const rr=r=>{const h=hira(r[1]).replace(/[()]/g,'');if(!/っ$/.test(h))return rm(h);const i=r[3].indexOf(h),nx=i>=0?r[3][i+h.length]:'';if(!nx)return rm(h);const f=rm(r[3].slice(0,i+h.length+1)),t=rm(nx);return f.slice(0,f.length-t.length)};const hl=w=>esc(w).split(q.k).join(`<b style="color:#b0401a">${q.k}</b>`);const first=!(S.fl&&S.fl.kreadIntro);
 d.innerHTML=`<div style="background:#fbf6ea;color:#2a1a0a;border-radius:18px;padding:14px 14px 10px;width:92%;max-width:420px;max-height:88vh;overflow:auto;text-align:center;box-shadow:0 6px 24px rgba(0,0,0,.5)">
  <div style="font-size:13px;letter-spacing:2px;color:#8a6a3a">覚えよう · Mémorise ce kanji</div>
  <div style="font-size:86px;line-height:1.1;font-family:'Hiragino Mincho ProN','Yu Mincho','Noto Serif JP',serif">${q.k}</div>
  <div style="font-size:19px;font-weight:bold;margin-bottom:6px">${esc(T_(q.fr))}</div>
  ${im?`<div style="position:relative;width:62%;max-width:220px;margin:4px auto"><img src="${im}" alt="" style="width:100%;display:block;border-radius:12px"></div>`:''}
  <div style="font-size:16px;font-style:italic;margin:8px 4px">${esc(T_(M[0]))}</div>
  ${RD?`<div style="text-align:left;background:#efe4c8;border-radius:10px;padding:8px 10px;font-size:14px">
   <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:4px"><b style="font-size:15px">${esc(T_('Les lectures'))}</b><button data-help="1" style="border:1px solid #8a6a3a;background:#fff;border-radius:14px;padding:2px 9px;font-size:12px;color:#2a1a0a">${esc(T_('Comment lire un kanji ?'))}</button></div>
   ${RD.map(r=>{const c=CL[r[0]];return `<div style="border-top:1px solid #d8c8a0;padding:6px 0"><div style="display:flex;align-items:center;gap:6px;flex-wrap:wrap"><span style="background:${c[1]};color:#fff;border-radius:8px;padding:1px 7px;font-size:12px;font-weight:bold">${c[0]}</span><button data-say="${esc(/っ$/.test(hira(r[1]))?r[3]:hira(r[1]).replace(/[()]/g,''))}" style="border:2px solid ${c[1]};background:#fff;border-radius:16px;padding:2px 10px;font-size:16px;color:#2a1a0a">${esc(r[1])} · ${esc(rr(r))} 🔊</button></div>
    <div style="margin:4px 0 0 4px"><button data-say="${esc(r[3])}" style="border:0;background:none;padding:0;font-size:17px;color:#2a1a0a">${hl(r[2])}</button> <span style="color:#6a5030">(${esc(r[3])})</span> — ${esc(T_(r[4]))}</div>${r[5]?`<div style="margin:2px 0 0 4px;font-size:12px;font-style:italic;color:#7a5a2a">${esc(T_(r[5]))}</div>`:''}</div>`}).join('')}
   <div style="border-top:1px solid #d8c8a0;padding-top:5px;font-size:11.5px;color:#6a5030">${[...new Set(RD.map(r=>r[0]))].map(t=>`<div>${esc(T_(LG[t]))}</div>`).join('')}</div></div>`:
  `<div style="text-align:left;background:#efe4c8;border-radius:10px;padding:8px 10px;font-size:14px">${ex.map(e=>`<div style="margin:3px 0">${lab(e)} · <b style="font-size:17px">${esc(e[0])}</b> (${esc(e[1])}) — ${esc(e[2]||'')}</div>`).join('')}</div>`}
  <div id="kintro" style="text-align:left;font-size:13px;margin-top:8px;background:#e6f0f6;border-radius:10px;padding:8px 10px" ${first?'':'hidden'}>${KREAD_INTRO.map(t=>`<div style="margin:2px 0">${esc(T_(t))}</div>`).join('')}</div>
  <button class="btn" data-ok="1" style="margin-top:10px;width:100%">Je l'ai mémorisé ▶</button></div>`;
 try{say(RD?hira(RD[0][1]).replace(/[()]/g,''):(q.kun||onH).replace(/[()]/g,''))}catch(e){}
 const cv=d.querySelector('#kmc');let anim=0;const play=()=>{if(!cv||!q.s)return;const g=cv.getContext('2d'),W=cv.width,id=++anim,L=q.s.map(st=>{let l=0;for(let i=1;i<st.length;i++)l+=Math.hypot(st[i][0]-st[i-1][0],st[i][1]-st[i-1][1]);return l});const T0=performance.now(),per=520;
  const fr=()=>{if(id!==anim||!cv.isConnected)return;const t=performance.now()-T0;g.clearRect(0,0,W,W);g.lineCap='round';g.lineJoin='round';g.strokeStyle='rgba(30,18,8,.62)';g.lineWidth=W*.075;
   q.s.forEach((st,k)=>{const f=Math.max(0,Math.min(1,(t-k*per)/per));if(f<=0)return;let rem=f*L[k];g.beginPath();g.moveTo(st[0][0]*W/100,st[0][1]*W/100);for(let i=1;i<st.length&&rem>0;i++){const a=st[i-1],b=st[i],sl=Math.hypot(b[0]-a[0],b[1]-a[1]),u=Math.min(1,rem/sl);g.lineTo((a[0]+(b[0]-a[0])*u)*W/100,(a[1]+(b[1]-a[1])*u)*W/100);rem-=sl}g.stroke()});
   if(t<q.s.length*per+200)requestAnimationFrame(fr)};requestAnimationFrame(fr)};setTimeout(play,500);
 for(;;){const b=await MiniUI.wait(d,'[data-say],[data-ok],[data-replay],[data-help]');if(b.dataset.ok)break;if(b.dataset.help){const ki=d.querySelector('#kintro');ki.hidden=!ki.hidden;if(!ki.hidden)ki.scrollIntoView({behavior:'smooth',block:'nearest'});continue}if(b.dataset.replay){play();continue}try{say(b.dataset.say)}catch(e){}}
 if(first){S.fl.kreadIntro=1;try{save()}catch(e){}}MiniUI.close()};

window.KREAD={"一":[["kun","ひと(つ)","一つ","ひとつ","un (objet)",""],["on","イチ","一月","いちがつ","janvier",""],["sp","ひとり","一人","ひとり","une personne, seul",""],["sp","ついたち","一日","ついたち","le 1er du mois",""]],"二":[["kun","ふた(つ)","二つ","ふたつ","deux (objets)",""],["on","ニ","二月","にがつ","février",""],["sp","ふたり","二人","ふたり","deux personnes",""],["kun","ふつ","二日","ふつか","le 2 du mois",""]],"三":[["kun","みっ(つ)","三つ","みっつ","trois (objets)",""],["on","サン","三月","さんがつ","mars",""],["kun","み","三日","みっか","le 3 du mois",""]],"四":[["kun","よん","四","よん","quatre","La lecture la plus courante pour compter."],["kun","よっ(つ)","四つ","よっつ","quatre (objets)",""],["on","シ","四月","しがつ","avril","Évitée seule : し se prononce comme 死, la mort."]],"五":[["kun","いつ(つ)","五つ","いつつ","cinq (objets)",""],["on","ゴ","五月","ごがつ","mai",""]],"六":[["kun","むっ(つ)","六つ","むっつ","six (objets)",""],["on","ロク","六月","ろくがつ","juin",""],["on","ロッ","六百","ろっぴゃく","six cents","Le son change devant certains mots."]],"七":[["kun","なな","七","なな","sept","La lecture la plus courante pour compter."],["kun","なな(つ)","七つ","ななつ","sept (objets)",""],["on","シチ","七月","しちがつ","juillet",""]],"八":[["kun","やっ(つ)","八つ","やっつ","huit (objets)",""],["on","ハチ","八月","はちがつ","août",""],["on","ハッ","八百","はっぴゃく","huit cents","Le son change devant certains mots."]],"九":[["on","キュウ","九","きゅう","neuf","La lecture la plus courante pour compter."],["kun","ここの(つ)","九つ","ここのつ","neuf (objets)",""],["on","ク","九月","くがつ","septembre","く se prononce comme 苦, la souffrance : on préfère きゅう."]],"十":[["on","ジュウ","十月","じゅうがつ","octobre",""],["kun","とお","十","とお","dix (objets)",""],["kun","とお","十日","とおか","le 10 du mois",""]],"上":[["kun","うえ","上","うえ","dessus, en haut",""],["kun","あ(がる)","上がる","あがる","monter",""],["on","ジョウ","上手","じょうず","habile",""]],"下":[["kun","した","下","した","dessous, en bas",""],["kun","くだ(さい)","下さい","ください","donnez-moi, s'il vous plaît",""],["on","カ","地下鉄","ちかてつ","métro",""],["sp","へた","下手","へた","maladroit",""]],"左":[["kun","ひだり","左","ひだり","gauche",""],["on","サ","左右","さゆう","gauche et 