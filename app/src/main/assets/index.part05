const dist=(a,b)=>Math.hypot(a[0]-b[0],a[1]-b[1]);
function len(p){let L=0;for(let i=1;i<p.length;i++)L+=dist(p[i-1],p[i]);return L}
function resamp(p,n){const L=len(p);if(L===0)return p.slice();const out=[p[0]];let acc=0,i=1,prev=p[0];const step=L/(n-1);let need=step;while(out.length<n-1&&i<p.length){const d=dist(prev,p[i]);if(acc+d>=need){const r=(need-acc)/d;const q=[prev[0]+(p[i][0]-prev[0])*r,prev[1]+(p[i][1]-prev[1])*r];out.push(q);prev=q;acc=0;need=step}else{acc+=d;prev=p[i];i++}}out.push(p[p.length-1]);return out}
function chamfer(A,B){const m=(P,Q)=>P.reduce((s,p)=>s+Math.min(...Q.map(q=>dist(p,q))),0)/P.length;return(m(A,B)+m(B,A))/2}
function judge(user,guide,f){f=f||1;if(user.length<4)return false;const U=resamp(user,24),G=resamp(guide,24),gl=len(guide),ul=len(user);
 if(ul<gl*.68||ul>gl*1.45+5)return false;if(dist(U[0],G[0])>15*f)return false;if(dist(U[23],G[23])>17*f)return false;
 let mx=0;for(let i=0;i<24;i++)mx=Math.max(mx,dist(U[i],G[i]));if(mx>19*f)return false;return chamfer(U,G)<7.5*f}

/* ---------- leçons de grammaire (niveau débutant consolidé → A2) ----------
   jetons : "漢字|かな". Exercices : ord (remettre en ordre), gap (compléter), mcq (choisir). */
const LESSONS=[
{id:'l1',zone:0,who:'tanu',xp:30,title:'A は B です',sub:'Dire « c\'est… », « je suis… »',
 cards:[
 {h:'C\'est… / Je suis…',f:'A は B です',x:'<b>は</b> (prononcé <b>wa</b>) marque le thème : « quant à A… ». <b>です</b> est le verbe « être » poli, toujours à la fin de la phrase.',
  ex:[{t:['私|わたし','は','学生|がくせい','です','。'],fr:'Je suis étudiant(e).'},{t:['これ','は','水|みず','です','。'],fr:'C\'est de l\'eau.'},{t:['田中|たなか','さん','は','先生|せんせい','です','。'],fr:'M. Tanaka est professeur.'}]},
 {h:'Poser une question',f:'〜ですか',x:'Ajoute <b>か</b> à la fin : inutile de mettre un point d\'interrogation. <b>何</b> (なん) veut dire « quoi ».',
  ex:[{t:['これ','は','何|なん','です','か','。'],fr:'Qu\'est-ce que c\'est ?'},{t:['はい','、','そう','です','。'],fr:'Oui, c\'est ça.'},{t:['いいえ','、','ちがいます','。'],fr:'Non, ce n\'est pas ça.'}]},
 {h:'La négation',f:'〜じゃないです',x:'Remplace です par <b>じゃないです</b>. En plus soutenu, on dit <b>ではありません</b>.',
  ex:[{t:['私|わたし','は','先生|せんせい','じゃないです','。'],fr:'Je ne suis pas professeur.'},{t:['これ','は','お茶|おちゃ','じゃないです','。'],fr:'Ce n\'est pas du thé.'}]}],
 ex:[
 {q:'ord',fr:'Je suis étudiant.',t:['私|わたし','は','学生|がくせい','です'],x:['を']},
 {q:'gap',fr:'C\'est de l\'eau.',t:['これ','＿','水|みず','です','。'],a:'は',o:['は','を','に','で'],why:'は marque le thème : « ceci, c\'est… ».'},
 {q:'mcq',p:'Que veut dire cette phrase ?',t:['これ','は','何|なん','です','か','。'],a:'Qu\'est-ce que c\'est ?',o:['Qu\'est-ce que c\'est ?','Où est-ce ?','C\'est de l\'eau.','Qui est-ce ?'],why:'何 (なん) = quoi, か = question.'},
 {q:'ord',fr:'Ça, c\'est du thé ?',t:['それ','は','お茶|おちゃ','です','か'],x:['の']},
 {q:'gap',fr:'Je ne suis pas professeur.',t:['私|わたし','は','先生|せんせい','＿','。'],a:'じゃないです',o:['じゃないです','です','ですか','でした'],why:'La négation de です est じゃないです.'},
 {q:'mcq',p:'Comment dit-on « Oui, c\'est ça. » ?',a:'はい、そうです。',o:['はい、そうです。','いいえ、ちがいます。','これは何ですか。','ありがとうございます。'],why:'はい = oui, そうです = c\'est ainsi.'},
 {q:'ord',fr:'M. Tanaka est-il professeur ?',t:['田中|たなか','さん','は','先生|せんせい','です','か']},
 {q:'mcq',p:'Que veut dire cette phrase ?',t:['いいえ','、','ちがいます','。'],a:'Non, ce n\'est pas ça.',o:['Non, ce n\'est pas ça.','Oui, c\'est ça.','Je ne sais pas.','Non merci.'],why:'ちがいます = « c\'est différent », donc « ce n\'est pas ça ».'}]},

{id:'l2',zone:0,who:'tanu',xp:30,title:'を・に・で',sub:'Les particules de l\'action',
 cards:[
 {h:'Le verbe à la fin',f:'[objet] を [verbe]ます',x:'Le verbe se place toujours en dernier. <b>を</b> (prononcé <b>o</b>) marque ce que l\'on mange, boit, lit… La forme <b>〜ます</b> est polie ; elle sert pour le présent et le futur.',
  ex:[{t:['水|みず','を','飲みます|のみます','。'],fr:'Je bois de l\'eau.'},{t:['ごはん','を','食べます|たべます','。'],fr:'Je mange (un repas).'},{t:['本|ほん','を','読みます|よみます','。'],fr:'Je lis un livre.'}]},
 {h:'Où l\'on va, et quand',f:'[lieu / heure] に',x:'<b>に</b> indique la destination, ou le moment précis.',
  ex:[{t:['学校|がっこう','に','行きます|いきます','。'],fr:'Je vais à l\'école.'},{t:['七時|しちじ','に','起きます|おきます','。'],fr:'Je me lève à sept heures.'},{t:['家|いえ','に','帰ります|かえります','。'],fr:'Je rentre à la maison.'}]},
 {h:'Où l\'on agit, et avec quoi',f:'[lieu / moyen] で',x:'<b>で</b> indique le lieu où se passe l\'action, ou le moyen utilisé.',
  ex:[{t:['家|いえ','で','食べます|たべます','。'],fr:'Je mange à la maison.'},{t:['電車|でんしゃ','で','行きます|いきます','。'],fr:'J\'y vais en train.'},{t:['はし','で','食べます|たべます','。'],fr:'Je mange avec des baguettes.'}]},
 {h:'Dire non',f:'〜ます → 〜ません',x:'Pour la négation, remplace ます par <b>ません</b>.',
  ex:[{t:['肉|にく','を','食べません|たべません','。'],fr:'Je ne mange pas de viande.'},{t:['お酒|おさけ','を','飲みません|のみません','。'],fr:'Je ne bois pas d\'alcool.'}]}],
 ex:[
 {q:'gap',fr:'Je mange du pain.',t:['パン','＿','食べます|たべます','。'],a:'を',o:['を','に','で','は'],why:'を marque l\'objet de l\'action : ce que l\'on mange.'},
 {q:'gap',fr:'Je vais à Tōkyō.',t:['東京|とうきょう','＿','行きます|いきます','。'],a:'に',o:['に','を','で','の'],why:'に marque la destination.'},
 {q:'gap',fr:'Je lis un livre à la bibliothèque.',t:['図書館|としょかん','＿','本|ほん','を','読みます|よみます','。'],a:'で',o:['で','に','を','が'],why:'で marque le lieu où l\'action se déroule.'},
 {q:'gap',fr:'J\'y vais en bus.',t:['バス','＿','行きます|いきます','。'],a:'で',o:['で','に','を','は'],why:'で marque aussi le moyen de transport.'},
 {q:'ord',fr:'Je bois du café tous les jours.',t:['毎日|まいにち','コーヒー','を','飲みます|のみます'],x:['に'],alt:['コーヒーを毎日飲みます']},
 {q:'ord',fr:'Je me lève à sept heures.',t:['七時|しちじ','に','起きます|おきます'],x:['で','を']},
 {q:'mcq',p:'Que veut dire cette phrase ?',t:['肉|にく','を','食べません|たべません','。'],a:'Je ne mange pas de viande.',o:['Je ne mange pas de viande.','Je mange de la viande.','J\'ai mangé de la viande.','Mangeons de la viande.'],why:'〜ません est la forme négative de 〜ます.'},
 {q:'ord',fr:'Je mange à la maison.',t:['家|いえ','で','ごはん','を','食べます|たべます'],alt:['ごはんを家で食べます']}]},

{id:'l3',zone:1,who:'baa',xp:30,title:'あります・います',sub:'Dire « il y a » et « de »',
 cards:[
 {h:'Il y a… (choses)',f:'[chose] が あります',x:'<b>あります</b> s\'emploie pour les objets, les plantes, les lieux. <b>が</b> marque ce qui existe. Sert aussi à dire « avoir ».',
  ex:[{t:['水|みず','が','あります','。'],fr:'Il y a de l\'eau.'},{t:['時間|じかん','が','あります','。'],fr:'J\'ai du temps.'}]},
 {h:'Il y a… (êtres vivants)',f:'[être vivant] が います',x:'<b>います</b> s\'emploie pour les personnes et les animaux.',
  ex:[{t:['猫|ねこ','が','います','。'],fr:'Il y a un chat.'},{t:['先生|せんせい','が','います','。'],fr:'Le professeur est là.'}]},
 {h:'Dire où',f:'[lieu] に 〜が あります',x:'Le lieu vient en premier, suivi de <b>に</b>. Négation : <b>ありません</b> / <b>いません</b>.',
  ex:[{t:['村|むら','に','寺|てら','が','あります','。'],fr:'Il y a un temple dans le village.'},{t:['公園|こうえん','に','犬|いぬ','が','います','。'],fr:'Il y a un chien dans le parc.'},{t:['お金|おかね','が','ありません','。'],fr:'Je n\'ai pas d\'argent.'}]},
 {h:'Le petit の',f:'A の B',x:'<b>の</b> relie deux noms : « B de A ». Attention, l\'ordre est inversé par rapport au français !',
  ex:[{t:['私|わたし','の','本|ほん'],fr:'mon livre'},{t:['先生|せんせい','の','名前|なまえ'],fr:'le nom du professeur'},{t:['日本語|にほんご','の','本|ほん'],fr:'un livre de japonais'}]}],
 ex:[
 {q:'gap',fr:'Il y a un chat.',t:['猫|ねこ','が','＿','。'],a:'います',o:['います','あります','です','行きます'],why:'Un chat est vivant : います.'},
 {q:'gap',fr:'Il y a un livre.',t:['本|ほん','が','＿','。'],a:'あります',o:['あります','います','飲みます','ですか'],why:'Un livre est un objet : あります.'},
 {q:'gap',fr:'Il y a un chien dans le parc.',t:['公園|こうえん','＿','犬|いぬ','が','います','。'],a:'に',o:['に','を','は','の'],why:'Le lieu où quelque chose se trouve est marqué par に.'},
 {q:'gap',fr:'C\'est mon livre.',t:['これ','は','私|わたし','＿','本|ほん','です','。'],a:'の',o:['の','が','を','に'],why:'の = « de » : 私の本, le livre de moi.'},
 {q:'ord',fr:'Il y a un temple dans le village.',t:['村|むら','に','寺|てら','が','あります'],x:['います'],alt:['寺が村にあります']},
 {q:'ord',fr:'Quel est le nom du professeur ?',t:['先生|せんせい','の','名前|なまえ','は','何|なん','です','か']},
 {q:'mcq',p:'Que veut dire cette phrase ?',t:['お金|おかね','が','ありません','。'],a:'Je n\'ai pas d\'argent.',o:['Je n\'ai pas d\'argent.','J\'ai de l\'argent.','Il n\'y a personne.','C\'est de l\'argent.'],why:'ありません est la négation de あります.'},
 {q:'gap',fr:'Il y a des enfants.',t:['子ども|こども','＿','います','。'],a:'が',o:['が','を','で','の'],why:'が marque ce qui existe.'}]},

{id:'l4',zone:1,who:'baa',xp:30,title:'Les adjectifs',sub:'Décrire avec 〜い et 〜な',
 cards:[
 {h:'Adjectifs en い',f:'〜い + nom　／　〜いです',x:'Ils se terminent par <b>い</b> et se placent directement devant le nom.',
  ex:[{t:['大きい|おおきい','犬|いぬ'],fr:'un grand chien'},{t:['この','山|やま','は','高い|たかい','です','。'],fr:'Cette montagne est haute.'},{t:['この','お茶|おちゃ','は','おいしい','です','。'],fr:'Ce thé est délicieux.'}]},
 {h:'Négation des adjectifs en い',f:'〜い → 〜くないです',x:'On enlève le <b>い</b> final et on ajoute <b>くない</b>. Exception : いい (bien) devient <b>よくない</b>.',
  ex:[{t:['高くない|たかくない','です','。'],fr:'Ce n\'est pas cher.'},{t:['今日|きょう','は','寒くない|さむくない','です','。'],fr:'Il ne fait pas froid aujourd\'hui.'},{t:['よくない','です','。'],fr:'Ce n\'est pas bien.'}]},
 {h:'Adjectifs en な',f:'〜な + nom　／　〜です',x:'Devant un nom, ils prennent <b>な</b>. En fin de phrase, pas de な. Négation : <b>じゃないです</b>.',
  ex:[{t:['静か|しずか','な','村|むら'],fr:'un village calme'},{t:['この','村|むら','は','静か|しずか','です','。'],fr:'Ce village est calme.'},{t:['元気|げんき','じゃないです','。'],fr:'Je ne vais pas bien.'}]},
 {h:'Aimer : 好き',f:'A は B が 好きです',x:'<b>好き</b> (すき) est un adjectif en な. Ce qu\'on aime est marqué par <b>が</b>, pas par を !',
  ex:[{t:['私|わたし','は','猫|ねこ','が','好き|すき','です','。'],fr:'J\'aime les chats.'},{t:['魚|さかな','が','好き|すき','じゃないです','。'],fr:'Je n\'aime pas le poisson.'}]}],
 ex:[
 {q:'mcq',p:'Comment dit-on « Ce n\'est pas cher. » ?',a:'高くないです。',o:['高くないです。','高いじゃないです。','高いです。','高かったです。'],why:'Adjectif en い : 高い → 高くない.'},
 {q:'gap',fr:'un village calme',t:['静か|しずか','＿','村|むら'],a:'な',o:['な','い','の','に'],why:'静か est un adjectif en な.'},
 {q:'gap',fr:'J\'aime les chats.',t:['私|わたし','は','猫|ねこ','＿','好き|すき','です','。'],a:'が',o:['が','を','に','で'],why:'Avec 好き, ce qu\'on aime prend が.'},
 {q:'ord',fr:'Cette montagne est haute.',t:['この','山|やま','は','高い|たかい','です'],x:['な']},
 {q:'ord',fr:'Il y a un grand chien.',t:['大きい|おおきい','犬|いぬ','が','います'],x:['あります']},
 {q:'mcq',p:'Quelle est la négation de いいです ?',a:'よくないです',o:['よくないです','いくないです','いいじゃないです','よいないです'],why:'いい est irrégulier : よくない.'},
 {q:'mcq',p:'Que veut dire cette phrase ?',t:['今日|きょう','は','寒くない|さむくない','です','。'],a:'Il ne fait pas froid aujourd\'hui.',o:['Il ne fait pas froid aujourd\'hui.','Il fait froid aujourd\'hui.','Il faisait froid hier.','Il fait chaud aujourd\'hui.'],why:'寒い (froid) → 寒くない (pas froid).'},
 {q:'ord',fr:'Ce village est calme.',t:['この','村|むら','は','静か|しずか','です'],x:['な']}]},

{id:'l5',zone:2,who:'bozu',xp:30,title:'Le passé',sub:'〜ました・でした・〜かった',
 cards:[
 {h:'Le passé des verbes',f:'〜ます → 〜ました',x:'Au négatif, le passé devient <b>〜ませんでした</b>.',
  ex:[{t:['昨日|きのう','、','すし','を','食べました|たべました','。'],fr:'Hier, j\'ai mangé des sushis.'},{t:['学校|がっこう','に','行きました|いきました','。'],fr:'Je suis allé à l\'école.'},{t:['何も|なにも','食べませんでした|たべませんでした','。'],fr:'Je n\'ai rien mangé.'}]},
 {h:'Le passé de です',f:'です → でした',x:'Pour les noms et les adjectifs en な. Au négatif : <b>じゃなかったです</b>.',
  ex:[{t:['昨日|きのう','は','雨|あめ','でした','。'],fr:'Hier, il a plu.'},{t:['静か|しずか','でした','。'],fr:'C\'était calme.'},{t:['休み|やすみ','じゃなかったです','。'],fr:'Ce n\'était pas un jour de repos.'}]},
 {h:'Le passé des adjectifs en い',f:'〜い → 〜かったです',x:'L\'adjectif lui-même se conjugue ! Au négatif : <b>〜くなかったです</b>. Et いい devient <b>よかった</b>.',
  ex:[{t:['楽しかった|たのしかった','です','。'],fr:'C\'était amusant.'},{t:['暑かった|あつかった','です','。'],fr:'Il faisait chaud.'},{t:['おいしくなかった','です','。'],fr:'Ce n\'était pas bon.'},{t:['よかった','！'],fr:'Tant mieux !'}]}],
 ex:[
 {q:'mcq',p:'Quel est le passé de 食べます ?',a:'食べました',o:['食べました','食べます','食べません','食べましょう'],why:'ます → ました.'},
 {q:'mcq',p:'Comment dit-on « C\'était amusant. » ?',a:'楽しかったです。',o:['楽しかったです。','楽しいでした。','楽しいです。','楽しくないです。'],why:'Adjectif en い : 楽しい → 楽しかった. On ne dit jamais いでした.'},
 {q:'gap',fr:'Hier, il a plu.',t:['昨日|きのう','は','雨|あめ','＿','。'],a:'でした',o:['でした','です','ました','かった'],why:'雨 est un nom : です → でした.'},
 {q:'ord',fr:'Hier, j\'ai mangé des sushis.',t:['昨日|きのう','すし','を','食べました|たべました'],x:['食べます|たべます']},
 {q:'mcq',p:'Que veut dire cette phrase ?',t:['何も|なにも','食べませんでした|たべませんでした','。'],a:'Je n\'ai rien mangé.',o:['Je n\'ai rien mangé.','Je ne mange rien.','J\'ai tout mangé.','Qu\'as-tu mangé ?'],why:'何も + négatif = « rien » ; ませんでした = passé négatif.'},
 {q:'mcq',p:'Quel est le passé de いいです ?',a:'よかったです',o:['よかったです','いかったです','いいでした','よいでした'],why:'いい est irrégulier : よかった.'},
 {q:'ord',fr:'Le film était amusant.',t:['映画|えいが','は','楽しかった|たのしかった','です'],x:['でした']},
 {q:'gap',fr:'La semaine dernière, je suis allé à Kyōto.',t:['先週|せんしゅう','、','京都|きょうと','に','行き|いき','＿','。'],a:'ました',o:['ました','ます','ません','でした'],why:'Verbe au passé : 行きます → 行きました.'}]},

{id:'l6',zone:2,who:'bozu',xp:30,title:'Envies et invitations',sub:'〜たい・〜ましょう・〜ませんか',
 cards:[
 {h:'Avoir envie de…',f:'radical + たいです',x:'Prends le verbe en ます, enlève ます, ajoute <b>たい</b> : 食べ<s>ます</s> → 食べたい. Au négatif : <b>〜たくないです</b>.',
  ex:[{t:['すし','を','食べたい|たべたい','です','。'],fr:'Je veux manger des sushis.'},{t:['日本|にほん','に','行きたい|いきたい','です','。'],fr:'Je veux aller au Japon.'},{t:['何も|なにも','飲みたくない|のみたくない','です','。'],fr:'Je ne veux rien boire.'}]},
 {h:'Allons-y !',f:'〜ましょう',x:'Remplace ます par <b>ましょう</b> pour proposer de faire quelque chose ensemble.',
  ex:[{t:['行きましょう|いきましょう','！'],fr:'Allons-y !'},{t:['一緒に|いっしょに','食べましょう|たべましょう','。'],fr:'Mangeons ensemble.'},{t:['休みましょう|やすみましょう','。'],fr:'Faisons une pause.'}]},
 {h:'Inviter poliment',f:'〜ませんか',x:'Une question à la forme négative est une invitation douce. Pour accepter : <b>いいですね！</b> Pour refuser sans froisser : <b>すみません、ちょっと…</b>',
  ex:[{t:['一緒に|いっしょに','お茶|おちゃ','を','飲みませんか|のみませんか','。'],fr:'On prendrait un thé ensemble ?'},{t:['いい','です','ね','！'],fr:'Bonne idée !'},{t:['すみません','、','ちょっと','…'],fr:'Désolé, c\'est un peu…'}]}],
 ex:[
 {q:'mcq',p:'Comment dit-on « Je veux aller au Japon. » ?',a:'日本に行きたいです。',o:['日本に行きたいです。','日本に行きます。','日本に行きました。','日本に行きましょう。'],why:'行き + たい = avoir envie d\'aller.'},
 {q:'mcq',p:'« Avoir envie de manger » : quelle forme ?',a:'食べたい',o:['食べたい','食べるたい','食べますたい','食べてたい'],why:'On enlève ます et on ajoute たい.'},
 {q:'ord',fr:'On boirait un thé ?',t:['お茶|おちゃ','を','飲みません|のみません','か'],x:['に']},
 {q:'mcq',p:'Que veut dire cette phrase ?',t:['行きましょう|いきましょう','！'],a:'Allons-y !',o:['Allons-y !','J\'y suis allé.','Je veux y aller.','N\'y va pas !'],why:'〜ましょう = « faisons… ».'},
 {q:'mcq',p:'Comment refuser poliment une invitation ?',a:'すみません、ちょっと…',o:['すみません、ちょっと…','いいですね！','行きましょう！','はい、そうです。'],why:'On ne dit presque jamais « non » directement : ちょっと… suffit.'},
 {q:'ord',fr:'Je veux manger des sushis.',t:['すし','を','食べたい|たべたい','です'],x:['食べます|たべます']},
 {q:'gap',fr:'Je veux boire de l\'eau.',t:['水|みず','を','飲み|のみ','＿','です','。'],a:'たい',o:['たい','ます','ました','ましょう'],why:'飲み + たい + です.'},
 {q:'mcq',p:'Que veut dire cette phrase ?',t:['何も|なにも','飲みたくない|のみたくない','です','。'],a:'Je ne veux rien boire.',o:['Je ne veux rien boire.','Je veux boire quelque chose.','Je n\'ai rien bu.','Buvons quelque chose.'],why:'〜たくない = ne pas avoir envie de.'}]},

{id:'l7',zone:3,who:'eng',xp:30,title:'La forme て',sub:'〜てください・〜ています',
 cards:[
 {h:'Forme て : verbes du groupe 2',f:'食べます → 食べて',x:'La forme て sert à demander, à relier des actions, à décrire une action en cours. Pour les verbes du groupe 2, remplace simplement ます par <b>て</b>.',
  ex:[{t:['食べます|たべます','→','食べて|たべて'],fr:'manger'},{t:['見ます|みます','→','見て|みて'],fr:'regarder'},{t:['起きます|おきます','→','起きて|おきて'],fr:'se lever'}]},
 {h:'Forme て : verbes du groupe 1',f:'い・ち・り → って　み・び・に → んで　き → いて　し → して',x:'Regarde la syllabe juste avant ます :<br>買<b>い</b>ます → 買<b>って</b> · 待<b>ち</b>ます → 待<b>って</b> · 飲<b>み</b>ます → 飲<b>んで</b> · 書<b>き</b>ます → 書<b>いて</b> · 話<b>し</b>ます → 話<b>して</b>.<br>Irréguliers : します → <b>して</b>, 来ます → <b>来て</b>, 行きます → <b>行って</b>.',
  ex:[{t:['飲みます|のみます','→','飲んで|のんで'],fr:'boire'},{t:['書きます|かきます','→','書いて|かいて'],fr:'écrire'},{t:['行きます|いきます','→','行って|いって'],fr:'aller (irrégulier)'}]},
 {h:'Demander poliment',f:'〜てください',x:'Forme て + <b>ください</b> = « s\'il vous plaît, faites… ».',
  ex:[{t:['待って|まって','ください','。'],fr:'Attendez, s\'il vous plaît.'},{t:['見て|みて','ください','。'],fr:'Regardez, s\'il vous plaît.'},{t:['ここ','に','書いて|かいて','ください','。'],fr:'Écrivez ici, s\'il vous plaît.'}]},
 {h:'En train de…',f:'〜ています',x:'Forme て + <b>います</b> = une action en cours.',
  ex:[{t:['今|いま','、','本|ほん','を','読んで|よんで','います','。'],fr:'En ce moment, je lis un livre.'},{t:['雨|あめ','が','降って|ふって','います','。'],fr:'Il pleut.'},{t:['何|なに','を','して','います','か','。'],fr:'Que fais-tu ?'}]}],
 ex:[
 {q:'mcq',p:'Quelle est la forme て de 飲みます ?',a:'飲んで',o:['飲んで','飲みて','飲って','飲いて'],why:'み → んで.'},
 {q:'mcq',p:'Quelle est la forme て de 書きます ?',a:'書いて',o:['書いて','書って','書きて','書んで'],why:'き → いて.'},
 {q:'mcq',p:'Quelle est la forme て de 行きます ?',a:'行って',o:['行って','行いて','行きて','行んで'],why:'行きます est irrégulier : 行って.'},
 {q:'ord',fr:'Attendez un instant, s\'il vous plaît.',t:['ちょっと','待って|まって','ください'],x:['います']},
 {q:'ord',fr:'En ce moment, je lis un livre.',t:['今|いま','本|ほん','を','読んで|よんで','います'],x:['ください']},
 {q:'mcq',p:'Que veut dire cette phrase ?',t:['雨|あめ','が','降って|ふって','います','。'],a:'Il pleut (en ce moment).',o:['Il pleut (en ce moment).','Il a plu hier.','Il ne pleut pas.','J\'aime la pluie.'],why:'〜ています = action en cours.'},
 {q:'gap',fr:'Écrivez ici, s\'il vous plaît.',t:['ここ','に','書い|かい','＿','ください','。'],a:'て',o:['て','で','た','に'],why:'書きます → 書いて + ください.'},
 {q:'mcq',p:'Comment dit-on « Que fais-tu ? » ?',a:'何をしていますか。',o:['何をしていますか。','何を食べますか。','何ですか。','どこに行きますか。'],why:'します → して + います.'}]},

{id:'l8',zone:4,who:'worker',xp:30,title:'Relier ses idées',sub:'から・けど・も・と',
 cards:[
 {h:'Parce que : から',f:'[raison] から、[résultat]',x:'<b>から</b> se place <u>après</u> la raison. L\'ordre est l\'inverse du français : d\'abord la cause, ensuite la conséquence.',
  ex:[{t:['暑い|あつい','です','から','、','水|みず','を','飲みます|のみます','。'],fr:'Comme il fait chaud, je bois de l\'eau.'},{t:['時間|じかん','が','ありません','から','、','行きません|いきません','。'],fr:'Je n\'ai pas le temps, donc je n\'y vais pas.'}]},
 {h:'Mais : けど / が',f:'A けど、B',x:'<b>けど</b> (courant) et <b>が</b> (plus soutenu) opposent deux idées.',
  ex:[{t:['高い|たかい','です','けど','、','おいしい','です','。'],fr:'C\'est cher, mais c\'est bon.'},{t:['行きたい|いきたい','です','が','、','時間|じかん','が','ありません','。'],fr:'J\'aimerais y aller, mais je n\'ai pas le temps.'}]},
 {h:'Aussi et avec : も / と',f:'A も　／　A と B',x:'<b>も</b> remplace は, が ou を pour dire « aussi ». <b>と</b> relie deux noms (« et ») ou signifie « avec ».',
  ex:[{t:['私|わたし','も','行きます|いきます','。'],fr:'Moi aussi, j\'y vais.'},{t:['パン','と','卵|たまご','を','食べます|たべます','。'],fr:'Je mange du pain et des œufs.'},{t:['友だち|ともだち','と','行きます|いきます','。'],fr:'J\'y vais avec un ami.'}]}],
 ex:[
 {q:'gap',fr:'Comme il fait chaud, je bois de l\'eau.',t:['暑い|あつい','です','＿','、','水|みず','を','飲みます|のみます','。'],a:'から',o:['から','けど','と','も'],why:'から suit la raison.'},
 {q:'gap',fr:'C\'est cher, mais c\'est bon.',t:['高い|たかい','です','＿','、','おいしい','です','。'],a:'けど',o:['けど','から','も','を'],why:'けど = mais.'},
 {q:'gap',fr:'Moi aussi, j\'y vais.',t:['私|わたし','＿','行きます|いきます','。'],a:'も',o:['も','は','を','と'],why:'も = aussi ; il remplace は.'},
 {q:'gap',fr:'J\'y vais avec un ami.',t:['友だち|ともだち','＿','行きます|いきます','。'],a:'と',o:['と','を','が','も'],why:'と = avec.'},
 {q:'ord',fr:'Je mange du pain et des œufs.',t:['パン','と','卵|たまご','を','食べます|たべます'],alt:['卵とパンを食べます'],x:['も']},
 {q:'mcq',p:'Que veut dire cette phrase ?',t:['時間|じかん','が','ありません','から','、','行きません|いきません','。'],a:'Je n\'ai pas le temps, donc je n\'y vais pas.',o:['Je n\'ai pas le temps, donc je n\'y vais pas.','J\'ai le temps, mais je n\'y vais pas.','Je n\'y vais pas, j\'ai le temps.','J\'y vais quand j\'ai le temps.'],why:'Raison + から, puis conséquence.'},
 {q:'ord',fr:'C\'est cher, mais c\'est bon.',t:['高い|たかい','です','けど','おいしい','です'],x:['から']},
 {q:'mcq',p:'Comment dit-on « Comme il pleut, je reste à la maison. » ?',a:'雨ですから、家にいます。',o:['雨ですから、家にいます。','雨ですけど、家にいます。','雨と家にいます。','雨も家にいます。'],why:'から exprime la cause.'}]}
];
LESSONS.forEach(L=>L.ex.forEach((e,i)=>{e.id=L.id+'.'+i;e.les=L.id}));
const LES=id=>LESSONS.find(l=>l.id===id);
const lessonsDone=()=>LESSONS.filter(l=>S.les[l.id]);
/* choisit un exercice parmi les leçons apprises : les moins maîtrisés d'abord */
function pickEx(filter){const pool=[];(window.EXREC?lessonsDone().slice(-3):lessonsDone()).forEach(L=>L.ex.forEach(e=>{if(!filter||filter(e))pool.push(e)}));if(!pool.length)return null;
 const sc=e=>{const r=S.sr[e.id]||{c:0,w:0};return r.c-r.w*2+Math.random()*1.5};return pool.sort((a,b)=>sc(a)-sc(b))[rnd(Math.min(4,pool.length))]}
function markEx(e,ok){const r=S.sr[e.id]||(S.sr[e.id]={c:0,w:0});ok?r.c++:r.w++}

/* ---------- carnet de phrases : toutes les phrases rencontrées ---------- */
const PHR={};
function phrAdd(t,fr,src){const k=jpText(t);if(!PHR[k])PHR[k]={t,fr,src}}
LESSONS.forEach(L=>L.cards.forEach(c=>c.ex.forEach(e=>{if(e.t.indexOf('→')<0)phrAdd(e.t,e.fr,L.id)})));
function learnPhr(t,fr){const k=jpText(t);phrAdd(t,fr,'monde');if(!S.ph[k]){S.ph[k]=1;return true}return false}

