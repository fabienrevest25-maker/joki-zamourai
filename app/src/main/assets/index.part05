   /* bords organiques : l'herbe voisine déborde sur les dalles en petites touffes irrégulières */
   const M=MAPS.world,g=(a,b)=>{const r=M.rows[y+b],k=r&&r[x+a];return k&&M.zone(y+b)===14&&!'=GTu~ '.includes(k)};
   [[0,-1],[0,1],[-1,0],[1,0]].forEach(([a,b],d)=>{if(!g(a,b))return;const R=i=>hash(x*31+d*7+i*13,y*17+i*5+d*3)%100/100;X.save();X.beginPath();
