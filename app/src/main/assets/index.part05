};
 /* l'eau animée ne se dessine que dans sa forme arrondie */
 const tmp=document.createElement('canvas');tmp.width=tmp.height=16;const tg=tmp.getContext('2d');
 window.wAni=(g,x,y,px,py,im)=>{const mk=MK.get(x+','+y);if(!mk)return false;tg.globalCompositeOperation='source-over';tg.clearRect(0,0,16,16);tg.drawImage(im,0,0,16,16);
