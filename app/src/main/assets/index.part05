/* ================= v333 : retours de jeu (coffres, flaques, portes, fumées, lanternes, analyse des phrases, écran-titre) ================= */
(()=>{
 const T=16,WM=()=>MAPS.world;
 /* ---- 1. les coffres ne se cachent plus sous les hautes herbes : pas de touffe sur la case du coffre, ni sur celles qui le couvrent ---- */
 const GRK=/^X_(HG\d+_\d+|TG\d|AG\d|SG\d|GT\d|RREED\d|SU\d|GIRIS|TR[0-2])$/;let GSET=null,CHT=null;
 const gset=()=>{if(GSET)return GSET;GSET=new Set();for(const k in XI)if(GRK.test(k)&&XI[k])GSET.add(XI[k]);return GSET};
 const chests=()=>{if(CHT)return CHT;CHT=new Set();try{for(const it of (typeof ITEMS!=='undefined'?ITEMS:[]))if(it.m==='world')CHT.add(it.x+','+it.y);for(const h of (typeof HIDS!=='undefined'?HIDS:[]))CHT.add(h.x+','+h.y)}catch(e){}return CHT};
 window.NOGRASS=(x,y,im)=>{if(!im||!gset().has(im))return false;const C=chests();return C.has(x+','+y)||C.has(x+','+(y-1))||C.has((x-1)+','+y)||C.has((x+1)+','+y)||C.has(x+','+(y-2))};
 /* ---- 2. flaques et vapeurs de la ville basse : jamais par-dessus un bâtiment ---- */
 const PH=new Map();
 const bRect=b=>{const im=XI[b.im];if(!im||!im.width)return null;const sc=(b.sc||1)/((typeof BHR!=='undefined'&&BHR[b.im])||1),w=im.width/3*sc,h=im.height/3*sc,cx=b.x*T+b.w*T/2+(b.ddx||0),by=(b.y+b.h)*T+2;return[cx-w/2,by-h,cx+w/2,by]};
 window.PUDHID=(x,y)=>{const k=x+','+y;if(PH.has(k))return PH.get(k);let r=false;const px=x*T+8,py=y*T+9;for(const b of (WM().bld||[])){if(Math.abs(b.y-y)>14||Math.abs(b.x-x)>14)continue;const R=bRect(b);if(!R)continue;if(px>=R[0]-5&&px<=R[2]+5&&py>=R[1]&&py<=R[3]+3){r=true;break}}PH.set(k,r);return r};
 /* ---- 3. la porte dessinée sur la case d'entrée : chaque bâtiment est décalé (au plus 12 px) pour que sa porte tombe pile sur la case où l'on entre ---- */
 const DOOR={X_V_CT0:.47,X_V_CW0:.49,X_V_DJ17:.49,X_V_DO0:.51,X_V_IN0:.48,X_V_IN19:.56,X_V_MINE20:.51,X_V_ST0:.51,X_V_TK0:.51,X_V_ZB0:.44,X_V_ZC0:.49,X_V_ZD0:.58,X_V_ZE0:.51,
  X_V_ZJ0:.48,X_V_ZK0:.47,X_V_ZL0:.49,X_V_ZM0:.52,X_V_ZR0:.51,X_V_ZS0:.35,X_V_ZS2:.52,X_V_ZS3:.46,X_V_ZS5:.51,X_V_ZS7:.52,X_V_ZS8:.54,X_V_ZT0:.32,X_V_ZT2:.52,X_V_ZT3:.66,X_V_ZT4:.39,X_V_ZT5:.74};
 const doors=()=>{const M=WM();if(!M||!M.bld||M.__ddx)return;M.__ddx=1;for(const w of (M.warps||[])){const b=M.bld.find(q=>w.x>=q.x&&w.x<q.x+q.w&&w.y>=q.y&&w.y<=q.y+q.h);if(!b||b.ddx!=null)continue;const im=XI[b.im];if(!im||!im.width)continue;
   const sc=(b.sc||1)/((typeof BHR!=='undefined'&&BHR[b.im])||1),Wd=im.width/3*sc,f=DOOR[b.im]!=null?DOOR[b.im]:.5,door=(f-.5)*Wd*(b.flip?-1:1),wc=(w.x-b.x+.5)*T-b.w*T/2;b.ddx=Math.max(-12,Math.min(12,Math.round(wc-door)))}};
 /* ---- 4. fumées : seules les vraies cheminées fument (avant, une lanterne ou un ornement de toit pouvait être pris pour une cheminée, et le gris du toit autour était effacé) ---- */
 const CHOK=new Set(['X_V_ZB0','X_V_ZB1','X_V_ZB3','X_V_ZB4','X_V_ZB6','X_V_ZB8','X_V_ZB9','X_V_ZF0','X_V_ZF1','X_V_ZF2','X_V_ZF3','X_V_ZF5','X_V_ZF6','X_V_ZF7','X_V_ZF8',
  'X_V_ZQ1','X_V_ZQ3','X_V_ZQ4','X_V_ZQ6','X_V_ZQ8','X_V_ZQ9','X_V_CT1','X_V_CT3','X_V_FG17','X_V_FG19','X_V_SH19','X_V_FG20','X_V_ZS0','X_V_DJ19','X_V_DJ1']);
 if(window.chimOf){const o=window.chimOf,K=new Map();for(const k of CHOK)K.set(k,1);window.chimOf=(im,key)=>{let k=key;if(!k){for(const n of CHOK)if(XI[n]===im){k=n;break}}return k&&K.has(k)?o(im,key):null}}
 /* ---- 5. le bourg de la Grand-Route (bourg d'automne) : davantage de lanternes de pierre le long des rues ---- */
 const lanterns=()=>{const M=WM();if(!M||M.__l7||typeof HAMS==='undefined')return;M.__l7=1;const h=HAMS.find(q=>q.z===7);if(!h)return;const R=M.rows,at=(x,y)=>(R[y]||'')[x]||' ';
  const inB=(x,y)=>(M.bld||[]).some(b=>x>=b.x-1&&x<b.x+b.w+1&&y>=b.y-1&&y<=b.y+b.h);const nearW=(x,y)=>(M.warps||[]).some(w=>Math.abs(w.x-x)<=2&&Math.abs(w.y-y)<=2);
  const npc=(x,y)=>(typeof NPCS!=='undefined'?NPCS.world:[]).some(n=>Math.abs(n.x-x)<=1&&Math.abs(n.y-y)<=1);
  const L=[];for(let y=h.y0;y<=h.y1;y++)for(let x=0;x<(R[y]||'').length;x++)if(at(x,y)==='l')L.push([x,y]);
  const set=(x,y,c)=>{R[y]=R[y].slice(0,x)+c+R[y].slice(x+1)};let n=0;
  for(let y=h.y0+2;y<=h.y1-2&&n<14;y++)for(let x=2;x<(R[y]||'').length-2&&n<14;x++){if(at(x,y)!=='.')continue;
   const path=['=','_'].includes(at(x-1,y))||['=','_'].includes(at(x+1,y))||['=','_'].includes(at(x,y+1));if(!path)continue;
   let ok=true;for(let b=-1;b<=1&&ok;b++)for(let a=-1;a<=1;a++){const c=at(x+a,y+b);if('DlJSWG#T'.includes(c)&&!(a===0&&b===0))ok=false}
   if(!ok||inB(x,y)||nearW(x,y)||npc(x,y)||L.some(([u,v])=>Math.max(Math.abs(u-x),Math.abs(v-y))<6))continue;
   if(['=','_'].includes(at(x,y-1))&&['=','_'].includes(at(x,y+1)))continue;
   set(x,y,'l');L.push([x,y]);n++}
  window.__L7=n};
 /* on applique ce qui touche à la carte dès qu'elle existe, avant le premier dessin */
 try{lanterns()}catch(e){console.error(e)}
 const tryDoors=()=>{try{if(typeof MAPS!=='undefined'&&MAPS.world&&typeof XI!=='undefined'&&XI.X_V_ZB0&&XI.X_V_ZB0.width){doors();return true}}catch(e){console.error(e)}return false};
 if(typeof XREADY!=='undefined'&&XREADY.then)XREADY.then(()=>{if(!tryDoors()){const iv=setInterval(()=>{if(tryDoors())clearInterval(iv)},100)}});else if(!tryDoors()){const iv=setInterval(()=>{if(tryDoors())clearInterval(iv)},100)}
 window.addEventListener('jz-reset',()=>{PH.clear();CHT=null});

 /* ---- 6. toucher une phrase japonaise d'un personnage : l'analyse mot par mot (sens, particules, conjugaison, structure) ---- */
 const PART={'は':['Thème','particule du thème (se lit « wa ») : ce dont on parle'],'が':['Sujet','particule du sujet : qui agit, ce qui existe, ce qu\'on aime ou veut'],'を':['Objet','particule du complément d\'objet (se lit « o ») : ce qu\'on mange, voit, achète…'],
  'に':['Destination','particule de lieu (où l\'on est, où l\'on va), de moment précis, ou de destinataire'],'へ':['Direction','particule de direction (se lit « e ») : vers…'],'で':['Lieu / moyen','particule du lieu où se passe l\'action, ou du moyen : à, en, avec'],
  'と':['Avec / et','« et » entre deux noms, « avec » quelqu\'un, ou pour citer des paroles'],'も':['Aussi','« aussi », « non plus » : remplace は ou が'],'の':['Complément du nom','relie deux noms : possession ou précision (le … de …)'],
  'から':['Depuis / parce que','« depuis », « à partir de » ; après une phrase : « parce que »'],'まで':['Jusqu\'à','« jusqu\'à »'],'か':['Question','fin de phrase : c\'est une question (le point d\'interrogation parlé)'],
  'よ':['Affirmation','fin de phrase : on affirme, on apprend quelque chose à l\'autre'],'ね':['Accord','fin de phrase : « hein ? », « n\'est-ce pas ? »'],'や':['Liste','« et » dans une liste incomplète (… et d\'autres)'],'より':['Comparaison','« que » dans une comparaison'],
  'けど':['Opposition','« mais », « pourtant »'],'ので':['Cause','« comme », « parce que »'],'ぐらい':['Environ','« environ »'],'くらい':['Environ','« environ »'],'だけ':['Seulement','« seulement »'],'ごろ':['Vers','« vers » (une heure)']};
 const COP={'です':'« c\'est », « être » (forme polie)','でした':'« c\'était » (passé poli)','じゃない':'« ce n\'est pas » (familier)','じゃありません':'« ce n\'est pas » (poli)','ではありません':'« ce n\'est pas » (poli, écrit)','じゃないです':'« ce n\'est pas » (poli)',
  'だ':'« c\'est » (familier)','だった':'« c\'était » (familier)','でしょう':'« sans doute », « n\'est-ce pas »','じゃなかった':'« ce n\'était pas »'};
 const ENDV=[['ないでください','demande de ne pas faire : « ne … pas, s\'il vous plaît »','ない'],['てください','demande polie : « … s\'il vous plaît » (forme en て + ください)','て'],['でください','demande polie : « … s\'il vous plaît » (forme en て + ください)','て'],
  ['ませんでした','verbe au passé négatif poli : « je n\'ai pas … »','ます'],['ましょうか','proposition : « voulez-vous que je … ? », « et si on … ? »','ます'],['ましょう','proposition : « faisons … », « allons … »','ます'],['ました','verbe au passé poli : « j\'ai … »','ます'],
  ['ません','verbe au négatif poli : « je ne … pas »','ます'],['ます','verbe au présent poli : habitude ou futur proche','ます'],['ていました','action qui durait, ou état passé (forme en て + いました)','て'],['ています','action en cours, ou état qui dure (forme en て + います)','て'],
  ['でいます','action en cours, ou état qui dure (forme en て + います)','て'],['たいです','« vouloir … » (forme en たい + です)','たい'],['たかった','« je voulais … » (passé de たい)','たい'],['たくない','« ne pas vouloir … »','たい'],['たい','« vouloir … »','たい'],
  ['なかった','négatif au passé, forme familière','ない'],['ません','',''],['くなかった','adjectif en い au passé négatif','adj'],['くないです','adjectif en い au négatif (poli)','adj'],['くない','adjectif en い au négatif','adj'],['かったです','adjectif en い au passé (poli)','adj'],['かった','adjectif en い au passé','adj']];
 let DIC=null;
 const sf=t=>String(t).split('|')[0],rd=t=>{const p=String(t).split('|');return p[1]||p[0]};
 const dic=()=>{if(DIC)return DIC;DIC=new Map();const put=(w,f)=>{if(!w||!f)return;const a=sf(w),b=rd(w);if(!DIC.has(a))DIC.set(a,f);if(!DIC.has(b))DIC.set(b,f)};
  try{for(const d of (typeof VDECKS!=='undefined'?VDECKS:[]))for(const [w,f] of (d.w||[]))put(w,f)}catch(e){}
  try{for(const L of (typeof VOC!=='undefined'?VOC:[]))if(L)for(const [w,f] of L)put(w,f)}catch(e){}
  try{for(const th of (typeof THEMES!=='undefined'?THEMES:[]))for(const q of (th.k||[])){put(q.k+'|'+(q.kun||q.on||''),q.fr);if(q.w)put(q.w,q.wf)}}catch(e){}
  try{for(const k in (typeof PHR!=='undefined'?PHR:{})){const p=PHR[k];if(p&&p.t&&p.t.length===1&&p.fr)put(p.t[0],p.fr)}}catch(e){}
  return DIC};
 const PUN=/^[。、！？!?…「」『』（）()・\s〜ー]+$/;
 const note=x=>{const o=new Map();String(x||'').split(/\s*·\s*/).forEach(seg=>{const m=seg.match(/^([^\s=()]+)\s*(?:\(([^)]+)\))?\s*=\s*(.+)$/);if(m){o.set(m[1],m[3]);if(m[2])o.set(m[2],m[3])}});return o};
 function anaTok(t,N){const s=sf(t),r=rd(t),D=dic();if(PUN.test(s))return null;
  const g=w=>N.get(w)||D.get(w);
  if(PART[s])return{t,cat:'Particule',role:PART[s][0],ex:PART[s][1],p:1};
  if(COP[s])return{t,cat:'Copule',role:'Prédicat',ex:COP[s],v:1};
  let f=g(s)||g(r);if(f){const v=/ます$/.test(r)?'verbe (forme polie en ます)':/い$/.test(r)&&!/(きれい|きらい|ゆうめい|とけい|せんせい|えいが|ていねい)$/.test(r)?'adjectif en い':/(ください|ありがとう|すみません|ごめんなさい|おはよう|こんにちは|こんばんは|さようなら|はい|いいえ|いただきます|ごちそうさま)/.test(r)?'expression':null;
   return{t,cat:v||'Mot',role:v&&v.startsWith('verbe')?'Verbe':v==='adjectif en い'?'Description':'',ex:f,v:v&&v.startsWith('verbe')}}
  for(const[e,ex,kind]of ENDV){if(!ex)continue;for(const w of [s,r]){if(!w.endsWith(e)||w.length===e.length)continue;const stem=w.slice(0,-e.length);
    const cands=kind==='ます'?[stem+'ます']:kind==='adj'?[stem+'い']:kind==='て'?[stem+'ます',stem.replace(/(っ|ん|い)$/,'')+'ます']:kind==='たい'||kind==='ない'?[stem+'ます']:[stem];
    let base=null;for(const c of cands){const q=g(c);if(q){base=[c,q];break}}
    return{t,cat:kind==='adj'?'Adjectif':'Verbe',role:kind==='adj'?'Description':'Verbe',ex:(base?`${base[1]} — `:'')+ex,base:base&&base[0],v:kind!=='adj'}}}
  return{t,cat:'Mot',role:'',ex:'mot pas encore dans le dictionnaire du jeu'}}
 function analyse(l){const N=note(l.x),toks=(l.jp||[]).map(t=>anaTok(t,N)).filter(Boolean);
  /* structure : le mot qui précède une particule prend le rôle de la particule */
  const st=[];let buf=[];for(const a of toks){if(a.p){st.push({w:buf.map(b=>sf(b.t)).join('')+'・'+sf(a.t),r:a.role});buf=[]}else buf.push(a)}
  if(buf.length)st.push({w:buf.map(b=>sf(b.t)).join(''),r:buf.some(b=>b.v)?'Prédicat (verbe)':buf.some(b=>b.cat==='Copule')?'Prédicat':buf.some(b=>b.cat==='Adjectif'||b.role==='Description')?'Prédicat (description)':'Fin de phrase'});
  return{toks,st:st.filter(x=>x.w.replace('・','').length)}}
 const css=`#gram{position:fixed;inset:0;z-index:9500;background:rgba(6,8,18,.72);display:flex;align-items:center;justify-content:center;padding:14px}
  #gram .gc{background:#141a2e;border:2px solid #c9a24a;border-radius:10px;box-shadow:0 0 0 2px #3a2a10,0 10px 40px rgba(0,0,0,.6);max-width:420px;width:100%;max-height:86vh;overflow:auto;color:#e8e2d0;padding:12px 14px;font-size:14px}
  #gram h3{margin:0 0 6px;color:#f0c860;font:600 16px Georgia,serif;letter-spacing:.5px}#gram .gs{font-size:26px;line-height:1.7;text-align:center;margin:4px 0}#gram .gf{text-align:center;color:#b9c0d8;margin-bottom:8px}
  #gram .gst{display:flex;flex-wrap:wrap;gap:4px;justify-content:center;margin:6px 0 10px}#gram .gst span{background:#24304e;border:1px solid #4a5a88;border-radius:6px;padding:2px 6px;font-size:12px}#gram .gst b{display:block;font-size:15px;color:#fff;font-weight:600}
  #gram table{width:100%;border-collapse:collapse}#gram td{border-top:1px solid #2c3554;padding:5px 4px;vertical-align:top}#gram td.j{font-size:19px;white-space:nowrap;color:#fff}#gram td.c{color:#f0c860;font-size:11px;white-space:nowrap}#gram .gx{margin-top:8px;color:#9fd8c0;font-size:13px}
  #gram .gb{display:flex;gap:8px;margin-top:10px}#gram .gb button{flex:1;padding:8px;border-radius:8px;border:1px solid #c9a24a;background:#2a2410;color:#f0d890;font:600 14px Georgia,serif}
  #study .gramb{position:absolute;right:6px;top:4px;font-size:11px;padding:1px 6px;border-radius:6px;border:1px solid #c9a24a;background:rgba(40,32,10,.85);color:#f0d890;z-index:2}#study{position:relative}#study .jp{cursor:pointer}`;
 const st_=document.createElement('style');st_.textContent=css;document.head.appendChild(st_);
 function openGram(l){if(!l||!l.jp)return;const A=analyse(l);const d=document.createElement('div');d.id='gram';
  d.innerHTML=`<div class="gc"><h3>文法 · La phrase, mot par mot</h3><div class="gs">${jpHtml(l.jp)}</div>${l.fr?`<div class="gf">${esc(l.fr)}</div>`:''}
   ${A.st.length>1?`<div class="gst">${A.st.map(x=>`<span><b>${esc(x.w)}</b>${esc(x.r)}</span>`).join('<span style="background:none;border:0;padding:8px 0">→</span>')}</div>`:''}
   <table>${A.toks.map(a=>`<tr><td class="j">${rubyTok(a.t)}</td><td><div class="c">${esc(a.cat)}${a.role&&a.role!==a.cat?' · '+esc(a.role):''}</div>${esc(a.ex)}${a.base?`<div class="c" style="color:#8fa0c8">forme de base : ${esc(a.base)}</div>`:''}</td></tr>`).join('')}</table>
   ${l.x?`<div class="gx">💡 ${esc(l.x)}</div>`:''}<div class="gb"><button data-g="s">🔊 Écouter</button><button data-g="c">Fermer</button></div></div>`;
  const stop=e=>{e.stopPropagation()};['pointerdown','pointerup','touchstart','touchend','mousedown','mouseup'].forEach(ev=>d.addEventListener(ev,stop));
  d.addEventListener('click',e=>{e.stopPropagation();const b=e.target.closest('button');if(b&&b.dataset.g==='s'){try{say(jpText(l.jp))}catch(x){}return}if(b&&b.dataset.g==='c'||e.target===d){try{sfx('back')}catch(x){}d.remove()}});
  document.body.appendChild(d);try{sfx('sel')}catch(x){}}
 window.GRAM={open:openGram,analyse};
 const hook=()=>{const st=document.getElementById('study');if(!st){setTimeout(hook,500);return}
  const add=()=>{if(!st.querySelector('.jp')||st.querySelector('.gramb'))return;const b=document.createElement('button');b.className='gramb';b.textContent='文法 ?';st.appendChild(b)};
  new MutationObserver(add).observe(st,{childList:true});add();
  st.addEventListener('click',e=>{if(e.target.closest('.spk'))return;if(!e.target.closest('.jp,.gramb,.kana'))return;e.stopPropagation();e.preventDefault();openGram(window.__CURL)},true)};
 hook();

 /* ---- 7. menu : revenir à l'écran-titre (et de là, au prologue) ---- */
 const home=()=>{const c=document.getElementById('mClose');if(!c){setTimeout(home,500);return}if(document.getElementById('mHome'))return;
  const L0='⌂ Titre<br><small style="opacity:.75;font-size:.72em">prologue</small>';
  const f=document.createElement('div');f.id='mFoot';f.style.cssText='display:flex;gap:6px;align-items:stretch';c.insertAdjacentElement('beforebegin',f);f.appendChild(c);c.style.flex='2.2';c.style.minWidth='0';
  const b=document.createElement('button');b.className='btn dark';b.id='mHome';b.innerHTML=L0;b.style.cssText='flex:1;min-width:0;line-height:1.1';f.appendChild(b);
  let armed=0;b.onclick=()=>{if(!armed){armed=1;b.innerHTML='Sûr ?<br><small style="font-size:.72em">touche encore</small>';setTimeout(()=>{armed=0;b.innerHTML=L0},4000);return}
   try{if(G.scene==='world'&&W.map&&!window.PRO)S.pos={m:W.map,x:W.H.x,y:W.H.y,d:W.H.dir};save()}catch(e){}try{localStorage.setItem('jz_hb','0')}catch(e){}location.reload()}};
 home();
})();


/* ================= v334 : retours de jeu (quitter un mini-jeu, bouton de Kage, fontaine et monuments, chemins, gare des jardins,
   PNJ cachés, foule du palais, guirlandes du relais, stands du festival) ================= */
(()=>{
 const T=16,WM=()=>MAPS.world;
 const at=(x,y)=>{const r=WM().rows[y];return r?r[x]:undefined};
 const set=(x,y,c)=>{const M=WM(),r=M.rows[y];if(r==null)return;M.rows[y]=(typeof r==='string')?r.slice(0,x)+c+r.slice(x+1):(r[x]=c,r)};
 const ok=k=>typeof XI!=='undefined'&&XI[k]&&XI[k].width;

 /* ---- 1. chemins : la ruelle vers le funiculaire (ville basse) se refermait en entonnoir, à deux cases du reste de la ville ---- */
 const carve=(cells,need)=>{if(need.some(([x,y])=>at(x,y)==null||at(x,y)==='T'))return 0;let n=0;for(const[x,y]of cells)if(at(x,y)==='T'){set(x,y,'.');n++}return n};
 try{window.__CARVE=[carve([[22,2160],[22,2161]],[[22,2159],[22,2162]])]}catch(e){console.error(e)}

 /* ---- 2. monuments des places : la fontaine de la ville basse, les tampons de l'Académie et l'arbre des renards retrouvent une vraie taille ---- */
 const PLB={X_PL9:{sc:1.45,w:6},X_PL10:{sc:1.5,w:6},X_PL13:{sc:1.5,w:6}};
 try{for(const b of WM().bld||[]){const q=PLB[b.im];if(!q||b.big)continue;const c2=b.x*2+b.w;b.sc=q.sc;b.w=q.w;b.x=Math.round((c2-q.w)/2);b.big=1;b.small=1}}catch(e){console.error(e)}

 /* ---- 3. jardins des horlogers : la station de la nacelle ne chevauche plus la maison voisine, et elle est posée sur un dallage ---- */
 window.NACPAVE=(x,y)=>{const B=window.NAC&&NAC.B;return !!B&&y>=B.y-2&&y<=B.y&&x>=B.x-2&&x<=B.x+2};
 try{const B=window.NAC&&NAC.B;if(B){const Lx=B.x-1.75-.2,Rx=B.x+2.75+.2;for(const b of WM().bld||[]){if(b.y>B.y||b.y+b.h<B.y-1||Math.abs(b.x-B.x)>12)continue;
   const hw=(b.sc||1)*84/32,cx=b.x+b.w/2;let dx=0;if(cx<=B.x&&cx+hw>Lx)dx=-Math.ceil(cx+hw-Lx);else if(cx>B.x&&cx-hw<Rx)dx=Math.ceil(Rx-(cx-hw));if(!dx)continue;
   for(let y=b.y;y<b.y+b.h;y++)for(let x=Math.min(b.x,b.x+dx);x<Math.max(b.x+b.w,b.x+b.w+dx);x++)if(at(x,y)==='D')set(x,y,'.');b.x+=dx;(window.__NACMOVE=window.__NACMOVE||[]).push([b.im,dx])}}}catch(e){console.error(e)}

 /* ---- 4. PNJ cachés derrière un toit (forge, dojo, tour…) : on les pousse sur la case libre la plus proche ---- */
 const bR=b=>{const im=XI[b.im];if(!im||!im.width)return null;const sc=(b.sc||1)/((typeof BHR!=='undefined'&&BHR[b.im])||1),w=im.width/3*sc,h=im.height/3*sc,cx=b.x*T+b.w*T/2+(b.ddx||0),by=(b.y+b.h)*T+2;return[cx-w/2,by-h,cx+w/2,by]};
 const inFoot=(x,y)=>(WM().bld||[]).some(b=>x>=b.x&&x<b.x+b.w&&y>=b.y-1&&y<b.y+b.h);
 const hidden=(x,y)=>{const px=x*T+8,py=(y+1)*T,top=py-22;for(const b of WM().bld||[]){if(Math.abs(b.y-y)>16||Math.abs(b.x-x)>16)continue;const R=bR(b);if(!R)continue;if(py<R[3]-2&&px>R[0]+5&&px<R[2]-5&&top>R[1]+6)return true}return false};
 const walk=(x,y)=>{const c=at(x,y);return c!=null&&!(typeof SOLID!=='undefined'?SOLID.includes(c)||c==='G':'TGHh#~'.includes(c))&&!(window.XSOLID&&XSOLID('world',x,y))};
 const npcAt=(x,y,me)=>NPCS.world.some(n=>n!==me&&n.x===x&&n.y===y);
 const relocate=()=>{const moved=[];for(const n of NPCS.world){if(n.cond||n.guard)continue;if(!hidden(n.x,n.y)&&!inFoot(n.x,n.y))continue;
   let best=null;for(let r=1;r<=6&&!best;r++)for(let dy=-r;dy<=r&&!best;dy++)for(let dx=-r;dx<=r;dx++){if(Math.max(Math.abs(dx),Math.abs(dy))!==r)continue;const x=n.x+dx,y=n.y+dy;
    if(WM().zone(y)!==WM().zone(n.y)||!walk(x,y)||!walk(x,y+1)||inFoot(x,y)||hidden(x,y)||npcAt(x,y,n))continue;if((WM().warps||[]).some(w=>Math.abs(w.x-x)+Math.abs(w.y-y)<=1))continue;best=[x,y];break}
   if(best){moved.push([n.id,n.x,n.y,best[0],best[1]]);n.x=best[0];n.y=best[1];if(n.hx!=null){n.hx=best[0];n.hy=best[1]}
    try{for(const e of W.ents)if(e.id===n.id){e.x=e.hx=best[0];e.y=e.hy=best[1];e.px=best[0];e.py=best[1]}}catch(e){}}}
  window.__NPCMOVE=moved};
 const tryRel=()=>{try{if(typeof MAPS!=='undefined'&&MAPS.world&&ok('X_FORGE')&&ok('X_DOJO')){relocate();return true}}catch(e){console.error(e)}return false};
 if(typeof XREADY!=='undefined'&&XREADY.then)XREADY.then(()=>{if(!tryRel()){const iv=setInterval(()=>{if(tryRel())clearInterval(iv)},150)}});else{const iv=setInterval(()=>{if(tryRel())clearInterval(iv)},150)}

 /* ---- 5. quitter un mini-jeu à tout moment : un bouton ✕ par-dessus l'écran du jeu ---- */
 const st=document.createElement('style');st.textContent=`#miniQ{position:fixed;z-index:63;top:calc(8px + env(safe-area-inset-top,0px));right:calc(8px + env(safe-area-inset-right,0px));display:none;
  background:rgba(20,16,34,.88);color:#f4eeff;border:2px solid #b58cff;border-radius:999px;padding:6px 12px;font:inherit;font-size:14px;line-height:1;cursor:pointer}
 #mini{padding-top:calc(44px + env(safe-area-inset-top,0px))!important}
 #mini .fz{position:relative;width:min(96%,380px);margin:2px auto 4px;display:flex;flex-direction:column;align-items:center}
 #mini .fzc{image-rendering:pixelated;flex:none;background-repeat:no-repeat}
 #mini .fzL{position:absolute;top:0;width:24px;height:36px;image-rendering:pixelated;background-size:100% 100%;transform-origin:50% 0;animation:fzLant 2.6s ease-in-out infinite}
 @keyframes fzLant{0%,100%{transform:rotate(-5deg)}50%{transform:rotate(5deg)}}
 @keyframes fzSway{0%,100%{transform:translateX(-9px)}50%{transform:translateX(9px)}}
 @keyframes fzFall{0%{transform:none}30%{transform:translateY(-6px) rotate(-8deg)}100%{transform:translateY(40px) rotate(70deg);opacity:0}}
 @keyframes fzNo{0%,100%{transform:translateX(0)}25%{transform:translateX(-6px)}75%{transform:translateX(6px)}}
 @keyframes fzRec{0%{transform:none}25%{transform:translateY(7px) rotate(-7deg)}100%{transform:none}}
 @keyframes fzBox{0%,100%{transform:rotate(0)}15%{transform:rotate(-16deg)}35%{transform:rotate(14deg)}55%{transform:rotate(-12deg)}75%{transform:rotate(9deg)}}
 @keyframes fzUnf{from{transform:scaleY(.04);opacity:.2}to{transform:scaleY(1);opacity:1}}
 @keyframes fzPop{0%{transform:scale(.4);opacity:0}60%{transform:scale(1.15);opacity:1}100%{transform:scale(1)}}
 @keyframes fzStick{0%{transform:translate(-50%,10px);opacity:0}100%{transform:translate(-50%,-34px);opacity:1}}
 @keyframes fzFloat{0%,100%{transform:translateY(0)}50%{transform:translateY(-3px)}}
 #mini .fzT{width:64px;height:64px;border-radius:50%;border:0;padding:0;font-size:27px;font-weight:700;color:#1c2038;cursor:pointer;
  background:radial-gradient(circle,#fffaf0 0 31%,#d8432a 32% 45%,#fffaf0 46% 59%,#d8432a 60% 74%,#fffaf0 75%);box-shadow:0 4px 0 #5a3418,0 0 0 3px #3a2414}
 #mini .fzT.hit{animation:fzFall .6s ease-in forwards}#mini .fzT.no{animation:fzNo .35s}
 #mini .fzP{position:relative;width:340px;max-width:94vw;height:236px;border-radius:18px;overflow:hidden;border:9px solid #4f86b8;box-shadow:inset 0 0 0 3px #2c5378,0 5px 0 #24405c;background-repeat:no-repeat}
 #mini .fzF{position:absolute;left:0;top:0;cursor:pointer;will-change:transform}
 #mini .fzF img{display:block;width:62px;image-rendering:pixelated;pointer-events:none}
 #mini .fzF b{position:absolute;left:50%;top:-16px;transform:translateX(-50%);white-space:nowrap;font-size:15px;color:#fff;text-shadow:0 0 3px #000,0 0 3px #000,0 1px 2px #000;pointer-events:none}
 #mini .fzF b rt{font-size:9px}
 #mini .fzSlip{width:150px;padding:10px 8px 12px;background:#fbf6e6;color:#2a1c10;border:2px solid #b89a62;border-radius:4px;box-shadow:0 3px 8px rgba(0,0,0,.5);transform-origin:50% 0;animation:fzUnf .7s ease-out;text-align:center}
 #mini .fzSlip .lk{font-size:40px;color:#b8241c;font-weight:700;line-height:1.1}`;
 document.head.appendChild(st);
 const MU=window.MiniUI;
 if(MU){const o0=MU.open.bind(MU),c0=MU.close.bind(MU),w0=MU.wait.bind(MU);let rej=null,quit=false;
  const q=document.createElement('button');q.id='miniQ';q.type='button';q.textContent='✕ Quitter';document.body.appendChild(q);
  MU.open=()=>{quit=false;const d=o0();q.style.display='block';return d};
  MU.close=()=>{q.style.display='none';return c0()};
  MU.wait=(d,sel)=>new Promise((res,rj)=>{if(quit){const e=new Error('MINIQUIT');e.name='MiniQuit';return rj(e)}rej=rj;w0(d,sel).then(b=>{if(rej===rj)rej=null;res(b)})});
  MU.abort=()=>{quit=true;try{sfx('back')}catch(e){}c0();q.style.display='none';if(rej){const r=rej;rej=null;const e=new Error('MINIQUIT');e.name='MiniQuit';r(e)}};
  q.onclick=e=>{e.stopPropagation();MU.abort()};
  window.addEventListener('unhandledrejection',e=>{if(e.reason&&e.reason.name==='MiniQuit')e.preventDefault()})}

 /* ---- 6. le bouton des mini-jeux de Kage : un nom clair, et une entrée dans le menu ---- */
 const kage=()=>{const b=document.getElementById('kDemon');if(!b){setTimeout(kage,500);return}b.textContent='影 Mini-jeux';b.title='Les mini-jeux de Kage';
  const add=()=>{const f=document.getElementById('mFoot');if(!f){setTimeout(add,500);return}if(document.getElementById('mKage'))return;
   const k=document.createElement('button');k.className='btn dark';k.id='mKage';k.innerHTML='影 Kage<br><small style="opacity:.75;font-size:.72em">mini-jeux</small>';k.style.cssText='flex:1;min-width:0;line-height:1.1;border-color:#8a58c8';
   f.insertBefore(k,document.getElementById('mHome'));k.onclick=async()=>{try{Menu.close()}catch(e){}await wait(220);if(window.KEIKO)KEIKO.open()}};add()};
 kage();

 /* ---- 7. la salle du trône : une vraie foule de courtisans, qui s'agite ---- */
 try{const P=NPCS.palais18;if(P&&!P.some(n=>n.id==='spec18_14')){
  const LN=[[['どこ','です','か','。'],'C\'est où ?',"Je cherche l'Empereur depuis ce matin. On m'a dit « au fond, tout droit ». Le fond, c'est loin quand tout est en or."],
   [['すみません','、','見えません|みえません','。'],'Pardon, je ne vois rien.',"Le chapeau devant moi fait deux mètres. À la cour, plus on est important, plus on bouche la vue."],
   [['足|あし','が','痛い|いたい','です','。'],'J\'ai mal aux pieds.',"Il est interdit de s'asseoir pendant les lois. C'est la loi n° 12. On l'a votée debout."],
   [['お腹|おなか','が','すきました','。'],'J\'ai faim.',"Le banquet, c'est après la loi n° 5 000. On en est à 4 211. J'ai des biscuits dans ma manche. Chut."],
   [['静か|しずか','に','して','ください','。'],'Du calme, s\'il vous plaît.',"Je dis ça à tout le monde. C'est mon travail. Personne ne m'écoute. Ça aussi, c'est mon travail."],
   [['今日|きょう','は','暑い|あつい','です','ね','。'],'Il fait chaud aujourd\'hui, hein.',"Vingt-six courtisans, et tout cet or. L'or garde la chaleur. Comme l'Empereur garde les impôts."]];
  const PS=[[1,8],[1,10],[2,11],[4,6],[4,8],[4,10],[12,9],[12,11],[11,11],[8,6],[8,8],[8,10]];
  PS.forEach(([x,y],i)=>{const l=LN[i%LN.length];P.push({id:'spec18_'+(14+i),spr:'court'+(i%6),x,y,ev:'say',dir:x<6?3:2,wander:0,nm:'Courtisan',jp:l[0],fr:l[1],xx:'',t2:l[2]})})}}catch(e){console.error(e)}
 const AN=new Map();let lastT=0;
 const oStep=W.step;W.step=dt=>{const r=oStep(dt);try{if(W.map==='palais18'){const t=performance.now()/1000;if(t-lastT>.08){lastT=t;
   for(const e of W.ents){if(!/^spec18_/.test(e.id||'')||e.mv)continue;let a=AN.get(e);if(!a){a={n:t+1+Math.random()*3,k:0,b:0,d0:e.dir};AN.set(e,a)}
    if(a.k>0){if(t>=a.b){a.k--;a.b=t+.16;e.fr=a.k>0?(a.k%2?1:2):0}continue}
    if(t>=a.n){const r_=Math.random();if(r_<.5){a.k=4+2*Math.floor(Math.random()*3);a.b=t}else{const H=W.H,dx=H.x-e.x,dy=H.y-e.y;
      e.dir=r_<.7?(Math.abs(dx)>Math.abs(dy)?(dx<0?2:3):(dy<0?1:0)):r_<.85?1:a.d0}a.n=t+1.6+Math.random()*3.4}}}}else if(AN.size)AN.clear()}catch(e){}return r};

 /* ---- 8. guirlandes de lanternes dans tout le relais (bourg 7), qui ne clignotent plus quand on marche ---- */
 window.FESTV2=1;
 const oN=W.setNight;W.setNight=v=>{window.__NIGHT=!!v;return oN(v)};
 let FR=null;const H7=()=>(typeof HAMS!=='undefined'&&Object.values(HAMS).find(h=>h.z===7))||null;
 const rows=()=>{if(FR)return FR;const h=H7();FR=[];if(!h)return FR;for(let y=h.y0+4;y<=h.y1-3;y+=6){let a=-1,b=-1;for(let x=h.x0;x<WM().w;x++)if(at(x,y)!=null&&at(x,y)!=='T'){if(a<0)a=x;b=x}if(a>=0&&b-a>=8)FR.push([y,a,b])}return FR};
 const oD=window.XDRAW;window.XDRAW=(m,L,g,X,Y,VW,VH)=>{oD&&oD(m,L,g,X,Y,VW,VH);if(m!=='world')return;const h=H7();if(!h||Y+VH<h.y0*T-40||Y>(h.y1+2)*T)return;
  const R=rows(),tt=performance.now()/1000,night=!!window.__NIGHT&&S.fl.matsuri===1,lit=night||S.fl.matsuri===1;
  L.push({y:1e9,f:()=>{if(night)window.FESTL=[];for(let ri=0;ri<R.length;ri++){const[ry,a,b]=R[ri],yy=ry*T-Y-6;if(yy<-24||yy>VH+24)continue;
    const xa=a*T,xb=(b+1)*T,X0=Math.max(xa,X-20),X1=Math.min(xb,X+VW+20);if(X1<=X0)continue;
    const yw=wx=>yy+Math.sin(wx/40+ri)*5+Math.sin(tt*.9+wx*.01)*.8;
    g.strokeStyle='rgba(40,20,10,.75)';g.lineWidth=1;g.beginPath();for(let wx=X0;wx<=X1;wx+=8){const y2=yw(wx);wx===X0?g.moveTo(wx-X,y2):g.lineTo(wx-X,y2)}g.stroke();
    for(let wx=Math.ceil((X0-16)/32)*32+16;wx<=X1;wx+=32){if(wx<xa+8||wx>xb-8)continue;const x=wx-X,y2=yw(wx)+3,li=((wx>>5)+ri)%3,im=XI['X_FEST'+li],k=.8+.2*Math.sin(tt*2.4+wx*.37+ri*1.3);
     if(lit){const col=['255,110,60','255,200,90','255,170,110'][li],gr=g.createRadialGradient(x,y2+6,1,x,y2+6,16*k);gr.addColorStop(0,`rgba(${col},${(night?.55:.22)*k})`);gr.addColorStop(1,`rgba(${col},0)`);g.fillStyle=gr;g.fillRect(x-17,y2-11,34,34);if(night)window.FESTL.push([x,y2+7,li,wx])}
     const sw=Math.sin(tt*1.6+wx*.11)*.12;g.save();g.translate(x,y2);g.rotate(sw);if(im&&im.width){const w=im.width/3,hh=im.height/3;g.drawImage(im,Math.round(-w/2),0,w,hh)}else{g.fillStyle=li?'#f0d040':'#e8402a';g.beginPath();g.ellipse(0,4,4,5,0,0,7);g.fill()}g.restore()}}}})};

 /* ---- 9. les stands du festival : fond de fête, lanternes qui se balancent, cibles, bassin aux poissons, boîte à omikuji ---- */
 const T_=(n,t)=>({n,t});
 const shuf=a=>{for(let i=a.length-1;i>0;i--){const j=Math.floor(Math.random()*(i+1));[a[i],a[j]]=[a[j],a[i]]}return a};
 const lab=w=>{const[k,r]=String(w).split('|');return r&&r!==k?`<ruby>${esc(k)}<rt>${esc(r)}</rt></ruby>`:esc(k)};
 const U=k=>IM[k]||'';
 const crop=(k,x0,y0,w,h,s,W0,H0,ex)=>`<div class="fzc" style="width:${Math.round(w*s)}px;height:${Math.round(h*s)}px;background-image:url(${U(k)});background-position:${-x0*s}px ${-y0*s}px;background-size:${W0*s}px ${H0*s}px;${ex||''}"></div>`;
 const lants=()=>`<div class="fzL" style="left:-4px;background-image:url(${U('X_FEST0')})"></div><div class="fzL" style="right:-4px;background-image:url(${U('X_FEST2')});animation-delay:-1.3s"></div>`;
 const bg=d=>{try{MINIBG(d,'TAIKO')}catch(e){}};
 const FEST2={
  async shoot(KANA){const d=MiniUI.open();bg(d);let sc=0;
   for(let r=0;r<6;r++){const k=KANA[Math.floor(Math.random()*KANA.length)],o=shuf([k,...shuf(KANA.filter(c=>c!==k)).slice(0,3)]);
    d.innerHTML=`<h3>射的 · Le tir aux kana</h3><p class="sub">Écoute le son, puis vise la bonne cible. Manche ${r+1} / 6 · Score ${sc}</p>
     <div class="fz">${lants()}${crop('X_STALL0',8,33,134,46,2.55,150,228)}
      <div style="position:relative">${crop('X_STALL0',27,77,95,52,3.6,150,228)}
       <div style="position:absolute;inset:0;display:flex;align-items:center;justify-content:space-around;padding:0 6px">${o.map((c,i)=>`<button class="fzT" data-i="${i}" style="animation:fzSway ${(2.2+i*.37).toFixed(2)}s ease-in-out ${(-i*.6).toFixed(1)}s infinite">${c}</button>`).join('')}</div></div>
      <div style="display:flex;align-items:center;gap:12px;margin-top:6px"><div class="big" style="margin:0;animation:fzFloat 1.6s ease-in-out infinite">${S.snd?'🔊':esc(RM&&RM[k]?RM[k]:k)}</div>
       <div id="fzGun">${crop('X_STALL0',35,150,62,23,2.4,150,228)}</div></div></div>
     <div class="row"><button class="btn" data-s="1">Réécouter</button></div>`;
    await wait(300);say(k,.8);let b;for(;;){b=await MiniUI.wait(d,'[data-i],[data-s]');if(b.dataset.s){say(k,.8);continue}break}
    const gun=d.querySelector('#fzGun');if(gun)gun.style.animation='fzRec .3s';
    if(o[+b.dataset.i]===k){sc++;sfx('hit');b.style.animation='fzFall .6s ease-in forwards'}else{sfx('wrong');b.style.animation='fzNo .35s';const g_=[...d.querySelectorAll('.fzT')].find(x=>o[+x.dataset.i]===k);if(g_)g_.style.boxShadow='0 4px 0 #5a3418,0 0 0 4px #ffd34a'}
    await wait(650)}
   MiniUI.close();return sc},
  async kingyo(){const d=MiniUI.open();bg(d);let sc=0;const pool=[];for(let k=1;k<=7;k++)if(VOC[k])pool.push(...VOC[k]);
   const FI=[U('X_AN_KOI1'),U('X_AN_KOI3')],GO=U('X_FISH0'),SP=['MG_SPL_0','MG_SPL_1','MG_SPL_2'].map(U);
   for(let r=0;r<5;r++){const w=pool[Math.floor(Math.random()*pool.length)],o=shuf([w,...shuf(pool.filter(v=>v[1]!==w[1])).slice(0,3)]);
    d.innerHTML=`<h3>金魚すくい · Les poissons rouges</h3><p class="sub">Attrape le poisson qui porte le mot « ${esc(w[1])} ». Manche ${r+1} / 5 · Score ${sc}</p>
     <div class="fz">${lants()}<div class="fzP" id="fzP" style="background-image:url(${U('BG_PECHE')});background-size:420px 752px;background-position:-60px -500px">
      ${o.map((v,i)=>`<div class="fzF" data-i="${i}"><b>${lab(v[0])}</b><img src="${i%2?GO:FI[0]}" alt=""></div>`).join('')}<img id="fzS" alt="" style="position:absolute;width:84px;display:none;image-rendering:pixelated;pointer-events:none"></div>
      <div class="bar" style="width:300px;max-width:90vw;margin-top:8px"><i id="fzB" style="width:100%"></i></div></div>`;
    const P_=d.querySelector('#fzP'),F=[...d.querySelectorAll('.fzF')],t0=performance.now(),Wp=()=>P_.clientWidth||322,lanes=[28,78,128,178].sort(()=>Math.random()-.5);
    const M=F.map((el,i)=>({el,img:el.querySelector('img'),y:lanes[i],sp:(36+Math.random()*30)*(Math.random()<.5?-1:1),x:Math.random()*240,ph:Math.random()*6,gold:i%2===1,caught:0}));let raf=0;
    const tick=()=>{const t=(performance.now()-t0)/1000,W_=Wp();for(const m of M){if(m.caught)continue;m.x+=m.sp/60;if(m.x<-10){m.x=-10;m.sp=Math.abs(m.sp)}if(m.x>W_-58){m.x=W_-58;m.sp=-Math.abs(m.sp)}
      const yy=m.y+Math.sin(t*1.7+m.ph)*7,fl=m.sp<0?-1:1;m.el.style.transform=`translate(${m.x.toFixed(1)}px,${yy.toFixed(1)}px)`;m.img.style.transform=`scaleX(${fl})`+(m.gold?` skewY(${(Math.sin(t*9+m.ph)*4).toFixed(1)}deg)`:'');if(!m.gold)m.img.src=FI[Math.floor(t*6+m.ph)%2]}
     const bar=d.querySelector('#fzB');if(bar)bar.style.width=Math.max(0,100-(performance.now()-t0)/70)+'%';raf=requestAnimationFrame(tick)};tick();
    let b=null;try{b=await Promise.race([MiniUI.wait(d,'[data-i]'),wait(7000).then(()=>null)])}catch(e){cancelAnimationFrame(raf);throw e}finally{d.onclick=null}
    const okk=b&&o[+b.dataset.i]===w,mm=b&&M[+b.dataset.i];
    if(mm){mm.caught=1;const s=d.querySelector('#fzS');if(s){s.style.left=(mm.x-10)+'px';s.style.top=(mm.y-30)+'px';s.style.display='block';SP.forEach((u,j)=>setTimeout(()=>{s.src=u},j*110));setTimeout(()=>{s.style.display='none'},420)}
     mm.el.style.transition='transform .45s ease-out,opacity .45s';mm.el.style.opacity=okk?'1':'.35';mm.el.style.transform+=okk?' translateY(-70px) scale(1.25)':' translateX(40px)'}
    if(okk){sc++;sfx('right')}else sfx('wrong');await wait(700);cancelAnimationFrame(raf)}
   MiniUI.close();return sc},
  async omikuji(OMI){const o=OMI[Math.floor(Math.random()*OMI.length)],n=1+Math.floor(Math.random()*100),d=MiniUI.open();bg(d);
   d.innerHTML=`<h3>おみくじ · Le tirage</h3><p class="sub">Secoue la boîte : un bâtonnet numéroté va tomber.</p>
    <div class="fz">${lants()}<div style="position:relative">${crop('X_STALL2',12,30,126,170,1.9,150,228,'opacity:.9')}
     <div id="fzBx" style="position:absolute;left:138px;top:182px"><div style="transform-origin:50% 90%">${crop('X_STALL2',92,138,22,36,3.2,150,228)}</div></div></div></div>
    <div class="row"><button class="btn" data-g="1">振る · Secouer</button></div>`;
   await MiniUI.wait(d,'[data-g]');const bx=d.querySelector('#fzBx>div');sfx('item');if(bx)bx.style.animation='fzBox .9s ease-in-out';await wait(950);
   sfx('tap');await wait(300);
   d.innerHTML=`<h3>おみくじ · N° ${n}</h3><p class="sub">La prêtresse te tend le papier n° ${n}.</p>
    <div class="fz">${lants()}<div class="fzSlip"><div class="lk">${jpHtml?jpHtml([o[0]]):lab(o[0])}</div><div style="font-size:13px;margin:2px 0 8px">${esc(o[1])}</div>
     <div style="font-size:19px;line-height:1.6">${jpHtml?jpHtml(o[2]):o[2].map(lab).join('')}</div><div style="font-size:13px;margin-top:4px">${esc(o[3])}</div></div>
     <div style="margin-top:10px;display:flex;align-items:flex-end;gap:10px">${crop('X_B21_OMIKUJI',0,0,79,68,1.6,79,68,'animation:fzPop .5s ease-out')}<span style="font-size:13px;max-width:170px;text-align:left">On noue le papier à la corde : la chance reste au sanctuaire, ou la malchance y reste coincée.</span></div></div>
    <div class="row"><button class="btn" data-l="1">Écouter</button><button class="btn" data-k="1">Nouer le papier</button></div>`;
   for(;;){const b=await MiniUI.wait(d,'[data-l],[data-k]');if(b.dataset.l){try{say(o[2].map(s=>String(s).split('|').pop()).join(''),.85)}catch(e){}continue}break}
   sfx('right');MiniUI.close();
   await D.say([T_('影',"Si c'est une mauvaise fortune, on l'attache à une branche et on la laisse là. Si c'est une bonne, on la garde. Moi, je les garde toutes. On ne sait jamais.")]);return 3}};
 window.FEST2=FEST2;

 /* ---- 13. pied des bâtiments : les cases où l'image ne dessine rien ne bloquent plus ---- */
 const AC=new Map();const alphaOf=k=>{if(AC.has(k))return AC.get(k);const im=XI[k];let r=null;try{if(im&&im.width){const c=document.createElement('canvas');c.width=im.width;c.height=im.height;const x=c.getContext('2d');x.drawImage(im,0,0);r={w:im.width,h:im.height,d:x.getImageData(0,0,im.width,im.height).data}}}catch(e){r=null}AC.set(k,r);return r};
 const bfree=()=>{const F=new Set();for(const b of WM().bld||[]){const A=alphaOf(b.im);if(!A)continue;const sc=(b.sc||1)/((typeof BHR!=='undefined'&&BHR[b.im])||1),w=A.w/3*sc,h=A.h/3*sc,cx=b.x*T+b.w*T/2+(b.ddx||0),by=(b.y+b.h)*T+2,x0=cx-w/2,y0=by-h;
   for(let y=b.y+b.h-Math.min(2,b.h);y<b.y+b.h;y++)for(let x=b.x;x<b.x+b.w;x++){let n=0,o=0;for(let i=0;i<4;i++)for(let j=0;j<4;j++){const px=x*T+2+i*4,py=y*T+2+j*4;let u=(px-x0)/w,v=(py-y0)/h;if(b.flip)u=1-u;n++;if(u<0||u>=1||v<0||v>=1)continue;const ix=Math.floor(u*A.w),iy=Math.floor(v*A.h);if(A.d[(iy*A.w+ix)*4+3]>110)o++}
    if(o/n<.2)F.add(x+','+y)}}window.BFREE=F;AC.clear();return F.size};
 const tryBF=()=>{try{if(typeof MAPS!=='undefined'&&MAPS.world&&ok('X_FORGE')&&ok('X_DOJO')){window.__BFREE=bfree();return true}}catch(e){console.error(e)}return false};
 if(typeof XREADY!=='undefined'&&XREADY.then)XREADY.then(()=>setTimeout(()=>{if(!tryBF()){const iv=setInterval(()=>{if(tryBF())clearInterval(iv)},300)}},1500));else{const iv=setInterval(()=>{if(tryBF())clearInterval(iv)},300)}

 /* ---- 12. sortir du prologue par le voyage rapide : Kaito redevient le héros de l'aventure (plus de clôture invisible partout) ---- */
 const oL=W.load;W.load=(m,x,y,d)=>{try{if(window.PRO&&((m==='world'&&y<=3514)||/^(dj|palais|tour|tro)/.test(m||''))){window.PRO=0;window.PROSLOT=1;try{UI.toast&&UI.toast('Fin du prologue : place à l’aventure',1800)}catch(e){}}}catch(e){}return oL(m,x,y,d)};

 /* ---- 10. cases de décor sans dessin : elles ne bloquent plus (bourg étudiant, ville basse…) ---- */
 const DECO='DloObcfSF';
 window.XFREE=(x,y,c)=>{if(!DECO.includes(c))return false;const B=window.__BUILT;if(!B||!B.has(y))return false;const P=window.__PROPC;return !(P&&P.has(x+','+y))};

 /* ---- 11. professeurs de la route : ils arrêtent Kaito quand il passe à quelques pas d'eux, et viennent jusqu'à lui ---- */
 const TEACH=['worker','eng','bozu','baa'];
 window.HCP=(x,y)=>{if(window.PRO||typeof NPCS==='undefined')return null;for(const id of TEACH){if(S.fl['h_'+id])continue;const n=NPCS.world.find(q=>q.id===id);if(!n)continue;
   if(y>=n.y-1&&y<=n.y+3&&Math.abs(x-n.x)<=10&&!(x===n.x&&y===n.y)&&WM().zone(y)===WM().zone(n.y))return[y,id]}return null};
 window.HCPNEAR=e=>{try{const H=W.H;if(Math.abs(e.x-H.x)+Math.abs(e.y-H.y)<=10)return;
   for(const[dx,dy]of[[0,-2],[1,-2],[-1,-2],[0,-3],[2,-1],[-2,-1],[0,2],[2,0],[-2,0]]){const x=H.x+dx,y=H.y+dy;if(!W.solid(x,y)&&!W.blocked(x,y)){e.x=x;e.y=y;if('px' in e){e.px=x;e.py=y}if('hx' in e){e.hx=x;e.hy=y}return}}}catch(err){}};
})();

/* ===================== v336 : donjons plus retors, salles obscures vraiment noires, décor qui bouge aux quatre vents et au port ===================== */
(()=>{
 const T_=16;
 const cv=(w,h)=>{const c=document.createElement('canvas');c.width=w;c.height=h;return c};
 const pixOf=im=>{const c=cv(im.width,im.height),x=c.getContext('2d');x.drawImage(im,0,0);return{c,x,d:x.getImageData(0,0,im.width,im.height)}};
 const okI=k=>typeof XI!=='undefined'&&XI[k]&&XI[k].width>0;

 /* ---------- 1. donjons ---------- */
 const djOf=m=>(m&&m.startsWith&&m.startsWith('dj')&&typeof DJ!=='undefined')?DJ[m.slice(2)]:null;
 const roomAt=(d,x,y)=>d&&d.O&&d.O.rooms?d.O.rooms.find(r=>y>=r.y0&&y<=r.y1&&x>=(r.x0||0)&&x<(r.x0||0)+15):null;
 /* un rocher ne sort jamais de sa salle (ni par la porte du bas, ni par la porte de côté) : seuls les trous l'avalent */
 const oP=window.XPUSH;window.XPUSH=(m,x,y,dx,dy,dd)=>{const d=djOf(m);
  if(d&&d.O&&d.O.rocks){const r=d.O.rocks.find(q=>!q.gone&&q.x===x&&q.y===y),rm=r&&d.O.rooms[r.room];
   if(rm){const tx=x+dx,ty=y+dy,x0=rm.x0||0,hole=d.O.holes.some(h=>h.x===tx&&h.y===ty);if(!hole&&(ty>=rm.y1||ty<=rm.y0||tx<=x0||tx>=x0+14))return false}}
  return oP?oP(m,x,y,dx,dy,dd):false};
 /* bouton « replacer les rochers » : visible dans une salle dont un rocher a bougé */
 {const st=document.createElement('style');st.textContent=`#djR{position:fixed;z-index:62;left:50%;transform:translateX(-50%);bottom:calc(196px + env(safe-area-inset-bottom,0px));padding:9px 16px;border-radius:999px;border:2px solid #c8973a;background:rgba(18,14,28,.9);color:#fff0b8;font:700 14px/1.1 system-ui,sans-serif;letter-spacing:.02em;box-shadow:0 3px 12px rgba(0,0,0,.55);touch-action:manipulation}#djR.hidden{display:none}`;document.head.appendChild(st)}
 const bt=document.createElement('button');bt.id='djR';bt.type='button';bt.className='hidden';bt.textContent='↺ Replacer les rochers';document.body.appendChild(bt);
 const here=()=>{if(typeof W==='undefined'||!W.H)return null;const d=djOf(W.map);if(!d||!d.O)return null;const rm=roomAt(d,W.H.x,W.H.y);return rm?[d,rm,d.O.rooms.indexOf(rm)]:null};
 setInterval(()=>{let on=false;try{const c=here();if(c&&!G.busy){const[d,,ri]=c;on=d.O.rocks.some(r=>r.room===ri&&!r.gone&&(r.x!==r.x0||r.y!==r.y0))}}catch(e){}bt.classList.toggle('hidden',!on)},350);
 bt.onclick=()=>{const c=here();if(!c||G.busy)return;const[d,rm,ri]=c;bt.classList.add('hidden');
  W.ev(async()=>{try{sfx('back')}catch(e){}await UI.fade(1,220);for(const r of d.O.rocks)if(r.room===ri&&!r.gone){r.x=r.x0;r.y=r.y0}const e=rm.ein||[7,rm.y1-1];W.load(W.map,e[0],e[1],1);W.H.cd=2;await UI.fade(0,220);UI.toast('Les rochers reprennent leur place.',1400)})};
 /* salles obscures : tant qu'on n'y est pas entré, on n'en voit que les murs */
 const oDX=window.XDRAW;window.XDRAW=(m,L,g,X0,Y0,VW,VH)=>{oDX&&oDX(m,L,g,X0,Y0,VW,VH);const d=djOf(m);if(!d||!d.O||!d.O.rooms||typeof W==='undefined'||!W.H)return;
  const cur=roomAt(d,W.H.x,W.H.y);
  for(const r of d.O.rooms){if(!r.k||!r.k.startsWith('dark')||r===cur)continue;const x0=Math.floor(((r.x0||0)+1)*T_-X0),y0=Math.floor((r.y0+1)*T_-Y0),w=13*T_,h=(r.y1-r.y0-1)*T_;
   if(x0>VW||y0>VH||x0+w<0||y0+h<0)continue;
   L.push({y:1e9-1,f:()=>{g.fillStyle='#03030b';g.fillRect(x0,y0,w,h);const a=g.createLinearGradient(0,y0+h-6,0,y0+h+10);a.addColorStop(0,'rgba(3,3,11,.9)');a.addColorStop(1,'rgba(3,3,11,0)');g.fillStyle=a;g.fillRect(x0,y0+h,w,10)}})}};

 /* ---------- 2. carton de bourg : les engrenages du menu de combat ---------- */
 {const s=document.createElement('style');s.textContent=`#actc img.gi{position:absolute;left:0;top:0;width:100%;height:100%;image-rendering:pixelated;filter:drop-shadow(0 6px 14px rgba(0,0,0,.6));pointer-events:none}
#actc img.g1{opacity:1}
#actc img.gs{left:74.7%;top:74.7%;width:44%;height:44%;opacity:.95;animation-duration:11.4s}
#actc img.gt{left:-10.6%;top:-10.6%;width:34%;height:34%;opacity:.85;animation-duration:8.8s}
#actc .sub{text-shadow:0 1px 2px #000,0 0 10px #000,0 0 4px #0b0e1c}
#actc .fr{filter:drop-shadow(0 2px 0 #3a2608) drop-shadow(0 0 5px rgba(0,0,0,.95))}`;document.head.appendChild(s)}

 /* ---------- quitter : le bouton se voit mieux (exercices, leçons) ---------- */
 {const s=document.createElement('style');s.textContent=`#xQuit.qt,#lQuit.qt{font-size:14px!important;padding:6px 13px!important;border:1.5px solid rgba(240,207,122,.85)!important;border-radius:999px!important;color:#fff0b8!important;background:rgba(110,28,28,.55)!important;font-weight:700!important}`;document.head.appendChild(s)}

 /* ---------- 3. hélices, moulin, manche à air ---------- */
 const SPLIT=new WeakMap();
 const split=(im,fn)=>{if(SPLIT.has(im))return SPLIT.get(im);let out=null;try{const P=pixOf(im),W=im.width,H=im.height,D=P.d.data,sel=fn(D,W,H),A=cv(W,H),B=cv(W,H),a=A.getContext('2d').createImageData(W,H),b=B.getContext('2d').createImageData(W,H);
   for(let i=0;i<W*H;i++){const t=sel[i]?a:b;for(let c=0;c<4;c++)t.data[i*4+c]=D[i*4+c]}A.getContext('2d').putImageData(a,0,0);B.getContext('2d').putImageData(b,0,0);out={part:A,base:B}}catch(e){out=null}SPLIT.set(im,out);return out};
 const gold=(D,i)=>{const r=D[i*4],g=D[i*4+1],b=D[i*4+2];return D[i*4+3]>0&&r>110&&r>g&&g>b+25};
 /* les pales : le laiton et son contour ; le support reste fixe */
 const blades=box=>(D,W,H)=>{const m=new Uint8Array(W*H),s=new Uint8Array(W*H);const[x0,y0,x1,y1,hx,hy]=box||[0,0,W,H,-99,-99];
  for(let y=y0;y<y1;y++)for(let x=x0;x<x1;x++){const i=y*W+x;if(gold(D,i))m[i]=1}
  for(let y=y0;y<y1;y++)for(let x=x0;x<x1;x++){const i=y*W+x;if(!D[i*4+3])continue;if(Math.abs(x-hx)<=3&&y>=hy+3)continue;let n=m[i];for(let a=-1;a<=1&&!n;a++)for(let b=-1;b<=1&&!n;b++){const xx=x+b,yy=y+a;if(xx>=x0&&yy>=y0&&xx<x1&&yy<y1&&m[yy*W+xx])n=1}if(n)s[i]=1}
  if(hx>-99)for(let y=y0;y<y1;y++)for(let x=x0;x<x1;x++){const i=y*W+x;if(Math.abs(x-hx)<=3&&y>=hy+3)s[i]=0}return s};
 const sockSel=(D,W,H)=>{const s=new Uint8Array(W*H);for(let y=0;y<Math.min(H,34);y++)for(let x=8;x<W;x++)if(D[(y*W+x)*4+3])s[y*W+x]=1;return s};
 let MILL=null;const millF=()=>{if(MILL)return MILL;if(![0,1,2,3].every(i=>okI('X_AO_MILL'+i)))return null;
  MILL=[0,1,2,3].map(i=>{const im=XI['X_AO_MILL'+i];let cx=im.width/2,b=im.height;try{const P=pixOf(im),D=P.d.data,W=im.width,H=im.height;let yb=-1;for(let y=H-1;y>=0&&yb<0;y--)for(let x=0;x<W;x++)if(D[(y*W+x)*4+3]){yb=y;break}
    let lo=W,hi=-1;for(let y=Math.max(0,yb-24);y<=yb;y++)for(let x=0;x<W;x++)if(D[(y*W+x)*4+3]){if(x<lo)lo=x;if(x>hi)hi=x}if(hi>=0){cx=(lo+hi+1)/2;b=yb+1}}catch(e){}return{im,cx,b}});return MILL};
 const prop=o=>({t:'X',k:'prop',hx:23.5/54,hy:31.5/64,sp:.5+((o.x*7+o.y*3)%5)*.09,a:3});
 window.WANX={X_D_pprop:prop,X_P_PROP:prop,
  X_D_wmill:o=>{if(!millF())return null;const s=1.2;o.w=150/3*s;o.hh=168/3*s;return{t:'X',k:'mill',s,a:3}},
  X_D_psock:()=>({t:'X',k:'sock',a:3}),X_P_SOCK:()=>({t:'X',k:'sock',a:3})};
 window.WANXD=(g,o,bx,by,t)=>{const c=o.an,on=!S.fxoff,L=bx-o.w/2,T0=by-o.hh;
  if(c.k==='prop'){const P=split(o.im,blades());if(!P){g.drawImage(o.im,L,T0,o.w,o.hh);return}g.drawImage(P.base,L,T0,o.w,o.hh);
   const px=L+c.hx*o.w,py=T0+c.hy*o.hh,th=on?t*c.sp*6.2832+o.x*1.3:0;g.save();g.translate(px,py);g.rotate(th);g.drawImage(P.part,-c.hx*o.w,-c.hy*o.hh,o.w,o.hh);g.restore();return}
  if(c.k==='mill'){const F=millF();if(!F){g.drawImage(o.im,L,T0,o.w,o.hh);return}const f=F[on?Math.floor(t*5+o.x*.7)%4:0],s=c.s/3;
   g.drawImage(f.im,Math.round(bx-f.cx*s),Math.round(by-f.b*s),f.im.width*s,f.im.height*s);return}
  if(c.k==='sock'){const P=split(o.im,sockSel);if(!P){g.drawImage(o.im,L,T0,o.w,o.hh);return}const s=o.w/o.im.width,W=o.im.width,H=o.im.height,ph=o.x*.7+o.y*.3;g.drawImage(P.base,L,T0,o.w,o.hh);
   for(let x=8;x<W;x+=2){const q=(x-8)/(W-8),dy=on?6*Math.pow(q,1.2)*(Math.sin(t*2.3*6.2832/2-q*5+ph)*.75+Math.sin(t*3.9-q*8+ph)*.25):0;g.drawImage(P.part,x,0,2,H,L+x*s,T0+dy*s,2*s+.3,H*s)}return}
  g.drawImage(o.im,L,T0,o.w,o.hh)};

 /* ---------- 4. au port : drapeaux qui flottent, hélices des toits qui tournent ---------- */
 const BP={X_V_ZL5:{fl:[[68,22,111,57],[134,22,179,57],[189,22,234,57]]},X_V_ZL7:{pr:[[60,9],[179,9]]}};
 const PART={};
 const prepB=()=>{for(const k in BP){if(PART[k]||!okI(k))continue;const im=XI[k];try{const P=pixOf(im),W=im.width,H=im.height,D=P.d.data,C=BP[k],out={orig:im,fl:[],pr:[]},bd=P.x.createImageData(W,H);bd.data.set(D);
   for(const r of C.fl||[]){const[x0,y0,x1,y1]=r,c=cv(W,H),x=c.getContext('2d'),d=x.createImageData(W,H);for(let y=y0;y<y1;y++)for(let xx=x0;xx<x1;xx++){const i=y*W+xx;if(!D[i*4+3])continue;for(let q=0;q<4;q++){d.data[i*4+q]=D[i*4+q];}bd.data[i*4+3]=0}x.putImageData(d,0,0);out.fl.push({c,r})}
   for(const[hx,hy]of C.pr||[]){const box=[Math.max(0,hx-24),0,Math.min(W,hx+25),hy+9,hx,hy],sel=blades(box)(D,W,H),c=cv(W,H),x=c.getContext('2d'),d=x.createImageData(W,H);
    for(let i=0;i<W*H;i++)if(sel[i]){for(let q=0;q<4;q++)d.data[i*4+q]=D[i*4+q];bd.data[i*4+3]=0}x.putImageData(d,0,0);out.pr.push({c,hx,hy})}
   const base=cv(W,H);base.getContext('2d').putImageData(bd,0,0);out.base=base;PART[k]=out;XI[k]=base}catch(e){console.error(e)}}};
 let BL5=null;
 const oDB=window.XDRAW;window.XDRAW=(m,L,g,X,Y,VW,VH)=>{oDB&&oDB(m,L,g,X,Y,VW,VH);if(m!=='world'||S.fxoff)return;const M=MAPS.world;if(!BL5)BL5=(M.bld||[]).filter(b=>BP[b.im]);
  const t=performance.now()/1000;
  for(const b of BL5){const P=PART[b.im];if(!P)continue;const im=P.orig,sc=(b.sc||1)/((typeof BHR!=='undefined'&&BHR[b.im])||1),w=im.width/3*sc,h=im.height/3*sc,cx=b.x*T_+b.w*T_/2+(b.ddx||0)-X,by=(b.y+b.h)*T_+2-Y;
   if(cx+w/2<0||cx-w/2>VW||by<-4||by-h>VH)continue;const s=w/im.width,x0=Math.round(cx-w/2),y0=Math.round(by-h),ph=b.x*.9+b.y*.37;
   L.push({y:(b.y+b.h-Math.min(2,b.h))*T_+1.7,f:()=>{g.save();if(b.flip){g.translate(Math.round(cx),0);g.scale(-1,1);g.translate(-Math.round(cx),0)}
    for(const F of P.fl){const[a0,b0,a1,b1]=F.r;for(let y=b0;y<b1;y+=2){const q=(y-b0)/(b1-b0),dx=6*Math.pow(q,1.25)*(Math.sin(t*.8*6.2832-y*.21+ph+a0*.05)*.7+Math.sin(t*.8*9.1-y*.37+ph*1.7)*.3);
      g.drawImage(F.c,a0,y,a1-a0,Math.min(2,b1-y),x0+a0*s+dx*s,y0+y*s,(a1-a0)*s,Math.min(2,b1-y)*s+.35)}}
    for(const R of P.pr){const px=x0+R.hx*s,py=y0+R.hy*s;g.save();g.translate(px,py);g.rotate(t*5.2+R.hx);g.drawImage(R.c,-R.hx*s,-R.hy*s,w,h);g.restore()}
    g.restore()}})}};

 /* ---------- 5. les bandes de papier du torii des quatre vents ---------- */
 const TOR=new Map();
 const toriiPrep=im=>{const W=im.width,H=im.height,P=pixOf(im),D=P.d.data,N=W*H,lum=i=>(D[i*4]+D[i*4+1]+D[i*4+2])/3,core=new Uint8Array(N);
  for(let y=Math.round(H*.24);y<Math.round(H*.75);y++)for(let x=0;x<W;x++){const i=y*W+x;if(!D[i*4+3])continue;const r=D[i*4],g_=D[i*4+1],b=D[i*4+2],mx=Math.max(r,g_,b),mn=Math.min(r,g_,b);if((r+g_+b)/3>135&&mx-mn<40)core[i]=1}
  const lab=new Int32Array(N),comps=[];let n=0;
  for(let i=0;i<N;i++){if(!core[i]||lab[i])continue;n++;const st=[i],px=[];lab[i]=n;let x0=W,x1=0,y0=H,y1=0;
   while(st.length){const j=st.pop();px.push(j);const x=j%W,y=(j/W)|0;if(x<x0)x0=x;if(x>x1)x1=x;if(y<y0)y0=y;if(y>y1)y1=y;
    for(let a=-1;a<=1;a++)for(let b=-1;b<=1;b++){const xx=x+b,yy=y+a;if(xx<0||yy<0||xx>=W||yy>=H)continue;const k=yy*W+xx;if(core[k]&&!lab[k]){lab[k]=n;st.push(k)}}}
   comps.push({id:n,px,x0,x1,y0,y1})}
  const keep=comps.filter(c=>!(c.y1-c.y0<=2&&c.x1-c.x0>=10)&&c.px.length>=4),own=new Int32Array(N);
  for(const c of keep)for(const j of c.px)own[j]=c.id;
  for(const c of keep){const add=[];for(const j of c.px){const x=j%W,y=(j/W)|0;for(let a=-1;a<=1;a++)for(let b=-1;b<=1;b++){const xx=x+b,yy=y+a;if(xx<0||yy<0||xx>=W||yy>=H)continue;const k=yy*W+xx;if(!own[k]&&D[k*4+3]&&lum(k)<135){own[k]=c.id;add.push(k)}}}for(const k of add)c.px.push(k)}
  const base=cv(W,H),bx=base.getContext('2d'),bd=bx.createImageData(W,H);bd.data.set(D);
  const near=(i,st,lim)=>{for(let k=1;k<=lim;k++){const j=i+st*k;if(j<0||j>=N)return -1;if(st===1||st===-1){if(((j%W)+W)%W!==((i%W)+st*k))return -1}if(!own[j]&&D[j*4+3])return j}return -1};
  for(let i=0;i<N;i++){if(!own[i])continue;let a=near(i,-1,8),b=near(i,1,8),s=-1;if(a>=0&&b>=0)s=(i-a)<=(b-i)?a:b;else{a=near(i,-W,8);b=near(i,W,8);if(a>=0&&b>=0)s=(i-a)<=(b-i)?a:b}
   if(s>=0)for(let c=0;c<4;c++)bd.data[i*4+c]=D[s*4+c];else bd.data[i*4+3]=0}
  bx.putImageData(bd,0,0);
  const NF=16,frames=[],rnd=i=>((i*9301+49297)%233280)/233280;
  for(let f=0;f<NF;f++){const c=cv(W,H),x=c.getContext('2d'),d=x.createImageData(W,H);
   for(const C of keep){const h=Math.max(4,C.y1-C.y0+1),A=Math.min(7,1.5+h*.28),ph=rnd(C.id)*6.2832;
    for(const j of C.px){const px=j%W,py=(j/W)|0,q=Math.max(0,(py-C.y0)/h),dx=Math.round(A*Math.pow(q,1.2)*Math.sin(f/NF*6.2832+ph-q*1.8)),nx=px+dx;if(nx<0||nx>=W)continue;const k=py*W+nx;for(let c2=0;c2<4;c2++)d.data[k*4+c2]=D[j*4+c2]}}
   x.putImageData(d,0,0);frames.push(c)}
  return{base,frames}};
 window.TORIIX=(g,k,im,x,y,w,h)=>{if(k!=='X_TORII14'||S.fxoff)return false;let P=TOR.get(im);if(P===undefined){try{P=toriiPrep(im)}catch(e){P=null}TOR.set(im,P)}if(!P)return false;
  const f=Math.floor(performance.now()/1000*9)%P.frames.length;g.drawImage(P.base,x,y,w,h);g.drawImage(P.frames[f],x,y,w,h);return true};

 /* ---------- 6. la mer de nuages des quatre vents : moins blanche ---------- */
 let HG=null;window.HGC15=()=>{if(HG)return HG;if(!okI('T_HGC'))return null;try{const P=pixOf(XI.T_HGC),D=P.d.data;for(let i=0;i<D.length;i+=4){D[i]=D[i]*.84;D[i+1]=D[i+1]*.87;D[i+2]=D[i+2]*.95}P.x.putImageData(P.d,0,0);HG=P.c}catch(e){HG=XI.T_HGC}return HG};

 if(typeof XREADY!=='undefined'&&XREADY.then)XREADY.then(()=>{setTimeout(()=>{try{prepB();BL5=null;if(typeof W!=='undefined'&&W.reset)W.reset()}catch(e){console.error(e)}},50)});
})();

/* ===================== v337 : mer de nuages des quatre vents et braises de la citadelle (images Gemini) ===================== */
(()=>{
 const ok=im=>im&&im.width>0;
 /* la texture de nuages (100 × 100 pixels d'art, répétable) : agrandie ×3 au plus proche, avec une marge enroulée pour qu'une case de 16 tienne d'un seul tenant */
 let HT=null;
 window.HGC15D=(X,x,y,px,py)=>{if(!HT){const im=typeof XI!=='undefined'&&XI.X_ZHGC;if(!ok(im))return false;const n=im.width,c=document.createElement('canvas');c.width=c.height=(n+16)*3;const g=c.getContext('2d');g.imageSmoothingEnabled=false;
   for(let a=0;a<2;a++)for(let b=0;b<2;b++)g.drawImage(im,a*n*3,b*n*3,n*3,n*3);HT={c,n}}
  const{c,n}=HT,sx=(((x*16)%n)+n)%n*3,sy=(((y*16)%n)+n)%n*3;X.drawImage(c,sx,sy,48,48,px,py,16,16);return true};
 /* citadelle : braises qui montent en vacillant, escarbilles qui tombent en tournoyant */
 window.CITP=(g,P,vis,tt,hh)=>{if(typeof XI==='undefined')return false;const E=[0,1,2,3].map(i=>XI['X_ZEMB'+i]),A=[0,1,2,3].map(i=>XI['X_ZASH'+i]);if(!E.every(ok)||!A.every(ok))return false;
  for(let i=0;i<Math.round(hh/7);i++){const[px,py]=P(i+1500,3,-9,9);if(!vis(px,py,6))continue;const im=E[[0,1,2,1,0,1,2,3][(Math.floor(tt*7+i*2.3))%8]],w=im.width/3,h=im.height/3;g.drawImage(im,Math.round(px-w/2),Math.round(py-h/2),w,h)}
  for(let i=0;i<Math.round(hh/16);i++){const[px,py]=P(i+1600,7,11,12);if(!vis(px,py,6))continue;const im=A[(Math.floor(tt*5+i*1.7))%4],w=im.width/3,h=im.height/3;g.drawImage(im,Math.round(px-w/2),Math.round(py-h/2),w,h)}
  return true};
})();

/* ===================== v338 : aux quatre vents, le vent emporte des brins de paille, des plumes de susuki et des feuilles sèches (images Gemini) ===================== */
(()=>{
 const ok=im=>im&&im.width>0;
 window.WINDP=(g,P,vis,tt,hh)=>{if(typeof XI==='undefined')return false;const F=['X_ZWST','X_ZWST','X_ZWSU','X_ZWLF'].map(n=>[0,1,2,3].map(i=>XI[n+i]));if(!F.every(f=>f.every(ok)))return false;
  for(let i=0;i<Math.round(hh/18);i++){const[px,py]=P(i+1300,30,6,12);if(!vis(px,py,12))continue;const S_=F[i%4],im=S_[(Math.floor(tt*(4+(i%3))+i*1.3))%4],w=im.width/3,h=im.height/3;
   g.drawImage(im,Math.round(px-w/2),Math.round(py-h/2),w,h)}
  return true};
})();

/* ===================== v339 : bâtiments plus nets, ombres portées, dojo et forge identiques partout, moulin qui tourne en continu ===================== */
(()=>{
 const ok=im=>im&&im.width>0,BH=()=>window.__BHR||{};
 /* ---------- 1. bâtiments agrandis à l'écran : lissage du navigateur au moment du dessin (v342 : l'ancien rééchantillonnage en mémoire faisait chuter les images par seconde) ---------- */
 window.HQB=im=>im;
 /* ---------- 2. ombres portées : la silhouette du décor, couchée vers le bas à droite (lumière venue d'en haut à gauche) ---------- */
 const SIL=new WeakMap();
 const sil=im=>{let c=SIL.get(im);if(c)return c;const W=Math.max(1,Math.round(im.width/3)),H=Math.max(1,Math.round(im.height/3));c=document.createElement('canvas');c.width=W+4;c.height=H+4;const x=c.getContext('2d');x.imageSmoothingEnabled=true;try{x.filter='blur(.6px)'}catch(e){}x.drawImage(im,2,2,W,H);try{x.filter='none'}catch(e){}x.globalCompositeOperation='source-in';x.fillStyle='#0c1020';x.fillRect(0,0,c.width,c.height);c.p=2/W;SIL.set(im,c);return c};
 const cast=(X,im,cx,by,w,h,flip,al,k,q)=>{const s=sil(im),px=w/im.width;X.save();X.globalAlpha=al;X.translate(cx,by);X.transform(1,0,-k,-q,0,0);if(flip)X.scale(-1,1);const pd=s.p*w;X.imageSmoothingEnabled=true;X.drawImage(s,-w/2-pd,-h-pd,w+2*pd,h+2*pd);X.restore()};
 window.SHB=(X,b)=>{if(S.fxoff)return;const im=XI[b.im];if(!ok(im))return;try{const m=X.getTransform(),ya=-m.f/m.d,yb=ya+X.canvas.height/m.d,by=(b.y+b.h)*16;if(by<ya-8||by-im.height/3*1.6>yb)return}catch(e){}const sc=(b.sc||1)/(BH()[b.im]||1),w=im.width/3*sc,h=im.height/3*sc;if(h<28)return;
  cast(X,im,b.x*16+b.w*8+(b.ddx||0),(b.y+b.h)*16+1,w,h,b.flip,.34,.4,.2)};
 window.SHP=(X,o)=>{if(S.fxoff||o.fl||o.nosh)return;const im=o.shIm||o.im;if(!ok(im)||o.hh<16||o.w<6)return;
  cast(X,im,o.x*16+8+o.dx,o.sy-1,o.shW||o.w,o.shH||o.hh,0,.3,.5,.26)};
 /* ---------- 3. le dojo et la forge : la même image partout, sans teinte ni miroir, à la même échelle ---------- */
 {const M=MAPS.world;for(const b of M.bld||[]){if(b.k==='dojo'||b.k==='atel')continue;const m=/^X_V_(DJ|FG)\d+$/.exec(b.im),D=b.im==='X_DOJO'||(m&&m[1]==='DJ'),F=b.im==='X_FORGE'||(m&&m[1]==='FG');if(!D&&!F)continue;
  b.im=D?'X_DOJO':'X_FORGE';b.tint='';b.flip=0;b.sc=+((D?1.75:1.49)*b.w/(D?11:9)).toFixed(3)}}
 /* ---------- 4. le moulin des quatre vents : tour fixe, ailes qui tournent en continu ---------- */
 const MT=()=>ok(XI.X_ZMILLT)&&ok(XI.X_ZMILLS);
 const oW=window.WANX&&WANX.X_D_wmill;if(window.WANX)WANX.X_D_wmill=o=>{if(!MT())return oW?oW(o):null;const s=1.2;o.w=170/3*s;o.hh=180/3*s;o.shIm=XI.X_ZMILLT;return{t:'X',k:'mill2',s,a:3}};
 const oD=window.WANXD;window.WANXD=(g,o,bx,by,t)=>{const c=o.an;if(c.k!=='mill2'||!MT())return oD(g,o,bx,by,t);
  const T_=XI.X_ZMILLT,S_=XI.X_ZMILLS,s=c.s/3,W=T_.width*s,H=T_.height*s,L=bx-85*s,T0=by-180*s;
  g.drawImage(HQB(T_,W*3,H*3),L,T0,W,H);
  const th=S.fxoff?0:-(t*1.35+.25*Math.sin(t*.43+o.x))-o.x;g.save();g.imageSmoothingEnabled=true;g.translate(bx+5*s,by-94*s);g.rotate(th);g.drawImage(HQB(S_,W*3,H*3),-90*s,-86*s,W,H);g.restore()};
 /* ---------- 5. village de la plage : plus de traits blancs dessinés par le moteur ; les mouettes dessinées viendront avec leurs images ---------- */
 window.GULLS=(g,P,vis,tt,hh)=>{const F=[0,1,2,3].map(i=>XI['X_ZGULL'+i]);if(!F.every(ok))return true;
  for(let i=0;i<Math.max(3,Math.round(hh/120));i++){const[px,py]=P(i+700,16,-2,30);if(!vis(px,py,20))continue;const im=F[(Math.floor(tt*6+i*1.7))%4],w=im.width/3,h=im.height/3;g.drawImage(im,Math.round(px-w/2),Math.round(py-h/2),w,h)}return true};
})();

/* ===================== v341 : nouveau moulin (tour + ailes), engrenage de la forge qui tourne ===================== */
(()=>{
 const ok=im=>im&&im.width>0;
 const M=(()=>{try{return JSON.parse('{"millT":[99,180,49.4,54.2],"millS":[204],"dojo":[444,234],"forge":[441,307,349.1,101.0,[179,177,229,217]],"gear":[84],"gull":[60,38,4]}')}catch(e){return null}})();
 /* ---------- le moulin : tour nette, ailes qui tournent en continu autour du moyeu ---------- */
 const MI=()=>M&&ok(XI.X_ZMILL2T)&&ok(XI.X_ZMILL2S);
 const oW=window.WANX&&WANX.X_D_wmill;
 if(window.WANX)WANX.X_D_wmill=o=>{if(!MI())return oW?oW(o):null;const[WT,HT,hx,hy]=M.millT,D=M.millS[0],top=Math.max(0,D/2-hy);o.w=Math.max(WT,D)/3;o.hh=(HT+top)/3;o.shIm=XI.X_ZMILL2T;o.shW=WT/3;o.shH=HT/3;return{t:'X',k:'mill3',a:3}};
 const oD=window.WANXD;window.WANXD=(g,o,bx,by,t)=>{const c=o.an;if(c.k!=='mill3'||!MI())return oD(g,o,bx,by,t);
  const[WT,HT,hx,hy]=M.millT,D=M.millS[0],L=bx-WT/6,T0=by-HT/3;g.drawImage(XI.X_ZMILL2T,L,T0,WT/3,HT/3);
  const th=S.fxoff?0:-(t*1.25+.22*Math.sin(t*.41+o.x))-o.x;g.save();g.imageSmoothingEnabled=true;g.translate(L+hx/3,T0+hy/3);g.rotate(th);g.drawImage(XI.X_ZMILL2S,-D/6,-D/6,D/3,D/3);g.restore()};
 /* ---------- la forge : l'engrenage de laiton tourne sur l'axe du toit ---------- */
 let FL=null;
 const oX=window.XDRAW;window.XDRAW=(m,L,g,X,Y,VW,VH)=>{oX&&oX(m,L,g,X,Y,VW,VH);if(m!=='world'||!M||!M.forge||!ok(XI.X_ZGEAR)||!ok(XI.X_FORGE))return;
  if(!FL)FL=(MAPS.world.bld||[]).filter(b=>b.im==='X_FORGE');const im=XI.X_FORGE,[IW,IH,gx,gy]=M.forge,GD=M.gear[0],BH=window.__BHR||{},t=performance.now()/1000;
  for(const b of FL){const sc=(b.sc||1)/(BH.X_FORGE||1),w=im.width/3*sc,h=im.height/3*sc,cx=b.x*16+b.w*8+(b.ddx||0)-X,by=(b.y+b.h)*16+2-Y;
   if(cx+w/2<0||cx-w/2>VW||by<-4||by-h>VH)continue;const s=w/im.width,px=cx+(b.flip?(IW/2-gx):(gx-IW/2))*s*(IW/im.width>0?im.width/IW:1),py=by-h+gy*s,d=GD*s;
   L.push({y:(b.y+b.h-Math.min(2,b.h))*16+1.7,f:()=>{g.save();g.imageSmoothingEnabled=true;g.translate(px,py);g.rotate(S.fxoff?0:t*1.1+b.x);g.drawImage(XI.X_ZGEAR,-d/2,-d/2,d,d);g.restore()}})}};
})();

/* ===================== v344 : le décor s'anime — petits moulins, roue à aubes, machines à vapeur, cloches, lanternes de pierre ===================== */
(()=>{
 const cv=(w,h)=>{const c=document.createElement('canvas');c.width=w;c.height=h;return c};
 const ok=im=>im&&im.width>0,R_=Math.PI/180;
 const dat=im=>{const c=cv(im.width,im.height),x=c.getContext('2d');x.drawImage(im,0,0);return x.getImageData(0,0,im.width,im.height).data};
 const toC=(W,H,D,m)=>{const c=cv(W,H),x=c.getContext('2d'),d=x.createImageData(W,H);for(let i=0;i<W*H;i++)if(m[i])for(let k=0;k<4;k++)d.data[i*4+k]=D[i*4+k];x.putImageData(d,0,0);return c};
 const arC=(W,H,A)=>{const c=cv(W,H),x=c.getContext('2d'),d=x.createImageData(W,H);d.data.set(A);x.putImageData(d,0,0);return c};
 const inE=(e,x,y)=>{const[cx,cy,ax,ay,an]=e,c=Math.cos(an*R_),s=Math.sin(an*R_),dx=x+.5-cx,dy=y+.5-cy,u=(dx*c+dy*s)/ax,v=(-dx*s+dy*c)/ay;return u*u+v*v<=1};
 const inP=(P,x,y)=>{let r=false;x+=.5;y+=.5;for(let i=0,j=P.length-1;i<P.length;j=i++){const[a,b]=P[i],[c,d]=P[j];if((b>y)!==(d>y)&&x<(c-a)*(y-b)/(d-b)+a)r=!r}return r};
 /* plus grande tache 8-connexe d'un masque */
 const big=(W,H,m)=>{const L=new Int32Array(W*H);let best=0,bn=0,n=0;for(let i=0;i<W*H;i++){if(!m[i]||L[i])continue;n++;let c=0;const st=[i];L[i]=n;while(st.length){const p=st.pop(),x=p%W,y=(p/W)|0;c++;for(let a=-1;a<=1;a++)for(let b=-1;b<=1;b++){const xx=x+b,yy=y+a;if(xx<0||yy<0||xx>=W||yy>=H)continue;const q=yy*W+xx;if(m[q]&&!L[q]){L[q]=n;st.push(q)}}}if(c>bn){bn=c;best=n}}
  const o=new Uint8Array(W*H);for(let i=0;i<W*H;i++)o[i]=L[i]===best?1:0;return o};
 /* bords gauche/droit, rangée par rangée, de l'enveloppe convexe d'un masque */
 const hull=(W,H,m)=>{const P=[];for(let y=0;y<H;y++){let a=-1,b=-1;for(let x=0;x<W;x++)if(m[y*W+x]){if(a<0)a=x;b=x}if(a>=0)P.push([a,y],[b+1,y],[a,y+1],[b+1,y+1])}
  P.sort((p,q)=>p[0]-q[0]||p[1]-q[1]);const cr=(o,a,b)=>(a[0]-o[0])*(b[1]-o[1])-(a[1]-o[1])*(b[0]-o[0]),lo=[],up=[];
  for(const p of P){while(lo.length>1&&cr(lo[lo.length-2],lo[lo.length-1],p)<=0)lo.pop();lo.push(p)}
  for(let i=P.length-1;i>=0;i--){const p=P[i];while(up.length>1&&cr(up[up.length-2],up[up.length-1],p)<=0)up.pop();up.push(p)}
  const Q=lo.slice(0,-1).concat(up.slice(0,-1)),L=new Float32Array(H).fill(1e9),R=new Float32Array(H).fill(-1e9);
  for(let y=0;y<H;y++){const yc=y+.5;for(let i=0;i<Q.length;i++){const[a,b]=Q[i],[c,d]=Q[(i+1)%Q.length];if((b<=yc&&yc<d)||(d<=yc&&yc<b)){const x=a+(yc-b)*(c-a)/(d-b);if(x<L[y])L[y]=x;if(x>R[y])R[y]=x}}}return[L,R]};
 /* bouche un trou avec le pixel voisin le plus proche (ligne d'abord, puis colonne) */
 const fillN=(W,H,D,src,need,Rr)=>{const O=new Uint8ClampedArray(W*H*4);for(let i=0;i<W*H;i++)if(src[i])for(let k=0;k<4;k++)O[i*4+k]=D[i*4+k];
  for(let y=0;y<H;y++)for(let x=0;x<W;x++){const i=y*W+x;if(!need[i]||src[i])continue;let j=-1;
   for(let d=1;d<Rr&&j<0;d++){if(x-d>=0&&src[i-d])j=i-d;else if(x+d<W&&src[i+d])j=i+d;else if(y-d>=0&&src[i-d*W])j=i-d*W;else if(y+d<H&&src[i+d*W])j=i+d*W}
   if(j>=0)for(let k=0;k<4;k++)O[i*4+k]=D[j*4+k]}return O};
 const FR={brass:(D,i)=>{const r=D[i],g=D[i+1],b=D[i+2];return r>140&&r-b>55&&g>80}};
 /* repères pris sur les images d'origine (largeur W0) */
 const SP={
  X_W_MILL:{W0:60,arm:{h:[28.7,32],ex:2.5,A:[[-126.2,35.3,-5,3.5],[-35.1,32.9,-6,3.6],[141.7,31.3,-5.1,3.7],[55.8,36.5,-4.7,3.7]]},sp:.75},
  X_D_wheel:{W0:91,E:[[46,42,13.5,23.5,5]],fp:[[45,39],[55,39],[55,46],[54,46],[54,72],[45,72],[45,46],[44,46]],sp:-.7},
  X_D_engine:{W0:76,E:[[60.5,17.5,9.5,10.5,-10],[50,41.5,8.5,12,-5]],no:[[48.5,41,12.5,16.5,-10]],fr:'brass',sp:2.4,pf:[[18.5,2,1.05]]},
  X_D_fbell:{W0:84,bell:{P:[[36,19],[46,19],[51,27],[54,48],[56,71],[27,71],[29,48],[32,27]],pv:[41,18]},amp:.06,f:1.9}};
 const PC=new WeakMap();
 const prep=(k,im)=>{if(PC.has(im))return PC.get(im);let out=null;try{const sp=SP[k],W=im.width,H=im.height,N=W*H,s=W/sp.W0,D=dat(im),op=i=>D[i*4+3]>40;out={};
  if(sp.arm){const[hx,hy]=[sp.arm.h[0]*s,sp.arm.h[1]*s],ex=sp.arm.ex*s,m=new Uint8Array(N);
   for(let y=0;y<H;y++)for(let x=0;x<W;x++){const i=y*W+x;if(!op(i))continue;const dx=x-hx,dy=y-hy;if(dx*dx+dy*dy<=21*s*s){m[i]=1;continue}
    for(const[an,L,p0,p1]of sp.arm.A){const u=Math.cos(an*R_),v=Math.sin(an*R_),A=dx*u+dy*v,P=-dx*v+dy*u;if(A>=0&&A<=L*s+ex&&((P>=p0*s-ex&&P<=p1*s+ex&&A>=6*s)||Math.abs(P)<=1.6*s)){m[i]=1;break}}}
   let vis=new Uint8Array(N);for(let i=0;i<N;i++)vis[i]=op(i)&&!m[i]?1:0;vis=big(W,H,vis);const[L,R]=hull(W,H,vis),need=new Uint8Array(N);
   for(let y=0;y<H;y++)for(let x=0;x<W;x++){const i=y*W+x;if(m[i]&&x+.5>=L[y]&&x+.5<=R[y])need[i]=1}
   out.base=arC(W,H,fillN(W,H,D,vis,need,14));out.arm={c:toC(W,H,D,m),h:[hx,hy]}}
  if(sp.E){const fp=sp.fp&&sp.fp.map(([x,y])=>[x*s,y*s]),fr=fp?(D_,i)=>inP(fp,(i/4)%W,((i/4)/W)|0):FR[sp.fr],taken=new Uint8Array(N),front=new Uint8Array(N);out.disks=[];
   for(const e0 of sp.E){const e=[e0[0]*s,e0[1]*s,e0[2]*s,e0[3]*s,e0[4]],dm=new Uint8Array(N),need=new Uint8Array(N);
    for(let y=0;y<H;y++)for(let x=0;x<W;x++){const i=y*W+x;if(!inE(e,x,y))continue;need[i]=1;if(!op(i))continue;
     const no=(sp.no||[]).some(q=>e0!==sp.E[sp.E.length-1]&&inE([q[0]*s,q[1]*s,q[2]*s,q[3]*s,q[4]],x,y));if(no||(fr&&fr(D,i*4))){front[i]=1;continue}dm[i]=1;taken[i]=1}
    for(let i=0;i<N;i++)if(need[i]&&(dm[i]||!op(i)))need[i]=0;
    const F=fillN(W,H,D,dm,need,10);out.disks.push({c:arC(W,H,F),e})}
   const bm=new Uint8Array(N);let nf=0;for(let i=0;i<N;i++){bm[i]=op(i)&&!taken[i]?1:0;if(front[i]&&!taken[i])nf++}
   out.base=toC(W,H,D,bm);if(nf)out.front=toC(W,H,D,front.map((v,i)=>v&&!taken[i]?1:0))}
  if(sp.bell){const P=sp.bell.P.map(([x,y])=>[x*s,y*s]),m=new Uint8Array(N),bm=new Uint8Array(N);
   for(let y=0;y<H;y++)for(let x=0;x<W;x++){const i=y*W+x;if(!op(i))continue;if(inP(P,x,y))m[i]=1;else bm[i]=1}
   out.base=toC(W,H,D,bm);out.bell={c:toC(W,H,D,m),pv:[sp.bell.pv[0]*s,sp.bell.pv[1]*s]}}
 }catch(e){out=null}PC.set(im,out);return out};
 const WX=window.WANX||(window.WANX={});
 for(const k in SP)WX[k]=o=>ok(o.im)&&prep(k,o.im)?{t:'X',k:'v344',key:k,a:4}:null;
 const oD=window.WANXD;window.WANXD=(g,o,bx,by,t)=>{const c=o.an;if(c.k!=='v344')return oD?oD(g,o,bx,by,t):g.drawImage(o.im,bx-o.w/2,by-o.hh,o.w,o.hh);
  const L=bx-o.w/2,T0=by-o.hh,P=prep(c.key,o.im);if(!P){g.drawImage(o.im,L,T0,o.w,o.hh);return}
  const sp=SP[c.key],s=o.w/o.im.width,on=!S.fxoff,ph=o.x*1.37+o.y*.71,sm=g.imageSmoothingEnabled;g.drawImage(P.base,L,T0,o.w,o.hh);g.imageSmoothingEnabled=true;
  if(P.disks)for(const d of P.disks){const[cx,cy,ax,ay,an]=d.e,th=on?t*sp.sp+ph:0;g.save();g.translate(L+cx*s,T0+cy*s);g.rotate(an*R_);g.scale(ax,ay);g.rotate(th);g.scale(1/ax,1/ay);g.rotate(-an*R_);g.drawImage(d.c,-cx*s,-cy*s,o.w,o.hh);g.restore()}
  if(P.arm){const[hx,hy]=P.arm.h,v=sp.sp*(.85+.3*((o.x*7+o.y*3)%5)/4),th=on?t*v+ph+.25*Math.sin(t*.37+ph):0;g.save();g.translate(L+hx*s,T0+hy*s);g.rotate(th);g.drawImage(P.arm.c,-hx*s,-hy*s,o.w,o.hh);g.restore()}
  if(P.bell){const[px,py]=P.bell.pv,th=on?sp.amp*(Math.sin(t*sp.f+ph)*.8+Math.sin(t*sp.f*.43+ph*1.3)*.2):0;g.save();g.translate(L+px*s,T0+py*s);g.rotate(th);g.drawImage(P.bell.c,-px*s,-py*s,o.w,o.hh);g.restore()}
  g.imageSmoothingEnabled=sm;if(P.front)g.drawImage(P.front,L,T0,o.w,o.hh);
  if(sp.pf&&on&&window.__PUFF)sp.pf.forEach(([x,y,k],i)=>__PUFF(g,L+x*s,T0+y*s,k*s*3,t,ph+i*1.7))};

 /* ---------- lanternes de pierre : une flamme derrière la fenêtre (la lueur des lanternes de neige, découpée et posée dans l'ouverture) ---------- */
 const LG={X_B21_LANT:0,X_B21_LANTM:0,X_B19_LANT:0,X_B17_SLANT:0,X_D_mlant:0,X_D_zlant:0,X_GLANT:{r:[19,27,31,38],dk:75,W0:48}},LC=new WeakMap();
 const lit=(k,im)=>{if(LC.has(im))return LC.get(im);let out=null;try{const src=ok(XI.X_SLANT)?XI.X_SLANT:ok(XI.X_SLANT_G)?XI.X_SLANT_G:null;if(src){
  const W=im.width,H=im.height,N=W*H,D=dat(im),m=new Uint8Array(N),sp=LG[k];
  if(sp&&sp.r){const s=W/sp.W0,[x0,y0,x1,y1]=sp.r.map(v=>Math.round(v*s));for(let y=y0;y<y1;y++)for(let x=x0;x<x1;x++){const i=y*W+x;if(D[i*4+3]>40&&(D[i*4]+D[i*4+1]+D[i*4+2])/3<sp.dk)m[i]=1}}
  else{const o=new Uint8Array(N),st=[];for(let x=0;x<W;x++){st.push(x,(H-1)*W+x)}for(let y=0;y<H;y++){st.push(y*W,y*W+W-1)}
   while(st.length){const i=st.pop();if(o[i]||D[i*4+3]>40)continue;o[i]=1;const x=i%W,y=(i/W)|0;if(x>0)st.push(i-1);if(x<W-1)st.push(i+1);if(y>0)st.push(i-W);if(y<H-1)st.push(i+W)}
   for(let i=0;i<N;i++)if(D[i*4+3]<=40&&!o[i])m[i]=1}
  let a=W,b=H,c=-1,d=-1,n=0;for(let i=0;i<N;i++)if(m[i]){n++;const x=i%W,y=(i/W)|0;if(x<a)a=x;if(x>c)c=x;if(y<b)b=y;if(y>d)d=y}
  if(n>=4){const sw=src.width/45,f=cv(W,H),fx=f.getContext('2d');fx.imageSmoothingEnabled=true;fx.drawImage(src,24*sw,29*sw,9*sw,10*sw,a,b,c-a+1,d-b+1);
   fx.globalCompositeOperation='destination-in';fx.drawImage(toC(W,H,new Uint8ClampedArray(N*4).fill(255),m),0,0);
   out=cv(W,H);const ox=out.getContext('2d');try{ox.filter=`blur(${Math.max(2,W/12).toFixed(1)}px)`}catch(e){}ox.globalAlpha=.9;ox.drawImage(f,0,0);ox.drawImage(f,0,0);try{ox.filter='none'}catch(e){}ox.globalAlpha=1;ox.drawImage(f,0,0)}}}catch(e){out=null}LC.set(im,out);return out};
 window.LGW={};for(const k in LG)LGW[k]=im=>lit(k,im);
})();

/* ===================== v346 : prologue — les yōkai des hautes herbes se combattent avec les kana appris ===================== */
(()=>{
 const pk=a=>a[Math.floor(Math.random()*a.length)];
 /* une question de kana (ou un mot du prologue fait de kana connus) */
 window.PROQ=()=>{try{const k=PROK.known();if(k.length<4)return null;const ws=PROK.words().filter(([w])=>[...w].every(c=>k.includes(c)));
  if(ws.length>=4&&Math.random()<.3){const[w,fr]=pk(ws),o=[fr];for(const x of shuf(ws))if(o.length<4&&!o.includes(x[1]))o.push(x[1]);return{q:'mcq',p:'Que veut dire ce mot ?',big:w,a:fr,o:shuf(o)}}
  return PROK.kanaQ(pk(k),k)}catch(e){return null}};
 /* les yōkai du prologue : doux, et leur nom est un mot en kana connus */
 const KINDS=['yoma','kodama','kakashi','itachi','takenoko','karakasa','chochin','tesso','toad'];
 window.PROWILD=()=>{const k=PROK.known(),n=k.length,kind=pk(KINDS.filter(x=>RKIND[x])),d=STORY.wildDef(1,kind),ws=PROK.words().filter(([w])=>[...w].every(c=>k.includes(c))),w=ws.length?pk(ws):null;
  Object.assign(d,{lv:1+Math.min(4,Math.floor(n/16)),hp:24+Math.min(40,n),dmg:5+Math.min(6,Math.floor(n/14)),xp:3,gold:2,trait:null});
  if(w){d.t=[w[0]];d.sub=w[1];d.word={t:[w[0]],fr:w[1]};d.clue=`Il a volé le mot « ${w[1]} ».`}return d};
 const oW=STORY.wild;STORY.wild=async function(z){if(window.PRO&&window.PROK)return Battle.start(PROWILD(),{zone:1});return oW.apply(this,arguments)};
 /* pas de rencontre tant qu'on ne connaît pas au moins les cinq voyelles */
 const oE=window.ENCMUL;window.ENCMUL=()=>{if(window.PRO){try{return PROK.known().length>=5?.8:0}catch(e){return 0}}return oE?oE():1};
 /* la clôture du nord : Maître Tanuki explique pourquoi on ne passe pas, au lieu d'un simple « bonk » */
 const oP=window.XPUSH;window.XPUSH=(m,x,y,dx,dy,d)=>{if(window.PRO&&m==='world'&&y<=3514&&dy<0){const t=Date.now();if(!(window.__pf>t)){window.__pf=t+12000;W.ev(()=>D.say([{n:'Maître Tanuki',t:"Hé ! Au-delà de la clôture, c'est la grande route. Pas question d'y aller avant de savoir lire. Même les panneaux sont en japonais, figure-toi."}]))}return true}return oP?oP(m,x,y,dx,dy,d):false};
})();

/* traductions générées (i18n/merge.py) */
I18N.T=I18N.T||{};
I18N.Z=I18N.Z||{};I18N.Z.en="";
I18N.Z=I18N.Z||{};I18N.Z.es="";
I18N.Z=I18N.Z||{};I18N.Z.it="";
I18N.Z=I18N.Z||{};I18N.Z.de="";
/* moteur de traduction : modèles, préfixes, segments */
(function(){const C={},K={};const esc=s=>s.replace(/[.*+?^${}()|[\]\\]/g,'\\$&');const FRW=/[éèêàçùœ]|\b(le|la|les|des|du|une|un|est|pas|tu|ton|ta|tes|pour|avec|dans|sur|qui|que|et|au|aux|ce|cette|mon|ma|de|jour)\b/i;
function pats(L){if(C[L])return C[L];if(I18N.Z&&I18N.Z[L])return [];const out=[],d=I18N[L]||{};const add=(fr,t,aff)=>{const lit=fr.replace(/\{\}/g,'');if(aff&&!/[A-Za-zÀ-ÿ]{2}/.test(lit))return;if(!lit.trim())return;out.push([new RegExp('^'+fr.split('{}').map(esc).join('([\\s\\S]*?)')+'$'),t,lit.length,aff,fr])};
for(const[f,t]of(I18N.T&&I18N.T[L])||[])add(f,t,0);
for(const k in d){if(k.length<3||!/[A-Za-zÀ-ÿ]{2}/.test(k))continue;if(/[\s:：]$/.test(k)&&!/^\s/.test(k))add(k+'{}',d[k]+'{}',1);else if(/^\s/.test(k)&&!/\s$/.test(k))add('{}'+k,'{}'+d[k],1)}
out.sort((a,b)=>b[2]-a[2]);return C[L]=out}
function X(s,L,dp){if(I18N.Z&&I18N.Z[L])return null;const d=I18N[L];if(!d||typeof s!=='string')return null;const k=s.trim();if(!k)return null;if(d[s])return d[s];if(d[k])return s.replace(k,d[k]);{const c0=k.charAt(0),lc=c0.toLowerCase()+k.slice(1);if(lc!==k&&d[lc]){const t=d[lc];return s.replace(k,t.charAt(0).toUpperCase()+t.slice(1))}}const ck=K[L]||(K[L]=new Map());if(ck.has(s))return ck.get(s);let r=null;dp=dp|0;if(dp<4){const m1=k.match(/^([—·•✓✕▶◀▼★☆→:]+\s*)([\s\S]*[A-Za-zÀ-ÿ][\s\S]*)$/);if(m1){const y=X(m1[2],L,dp+1);if(y!=null)r=s.replace(k,m1[1]+y)}if(r==null){const m2=k.match(/^([\s\S]*?[A-Za-zÀ-ÿ.…?!)»])(\s*[✓✕★☆]+)$/);if(m2){const y=X(m2[1],L,dp+1);if(y!=null)r=s.replace(k,y+m2[2])}}if(r!=null){if(ck.size<20000)ck.set(s,r);return r}}
if(dp<4){for(const[re,t,lit,aff]of pats(L)){const m=k.match(re);if(!m)continue;let bad=0;const a=m.slice(1).map(v=>{if(!/[A-Za-zÀ-ÿ]{2}/.test(v))return v;const y=X(v,L,dp+1);if(y!=null)return y;if(FRW.test(v))bad=1;return v});if(bad&&(aff||lit<.4*k.length))continue;let i=0;r=s.replace(k,t.replace(/\{(\d*)\}/g,(q,n)=>n!==''?(a[+n]??''):(a[i++]??'')));break}
if(r==null){for(const sep of[' · ','\n',' — ',' : ']){if(!k.includes(sep))continue;let ch=0;const p=k.split(sep).map(v=>{const y=X(v,L,dp+1);if(y!=null){ch=1;return y}return v});if(ch){r=s.replace(k,p.join(sep===' : '?': ':sep));break}}}}
if(ck.size<20000)ck.set(s,r);return r}
window.I18X=X;
/* modèles contenant des balises seulement : sûrs pour traduire un bloc entier (objectif, carnet) */
window.I18XT=function(s,L){if(I18N.Z&&I18N.Z[L])return null;if(typeof s!=='string')return null;const k=s.trim();if(!k||k.indexOf('<')<0)return null;for(const[re,t,,aff,fr]of pats(L)){if(!fr||fr.indexOf('<')<0)continue;const m=k.match(re);if(!m)continue;let i=0;const a=m.slice(1).map(v=>{if(!/[A-Za-zÀ-ÿ]{2}/.test(v))return v;const y=X(v,L,1);return y!=null?y:v});return s.replace(k,t.replace(/\{(\d*)\}/g,(q,n)=>n!==''?(a[+n]??''):(a[i++]??'')))}return null};
async function dec(L,b64){const b=Uint8Array.from(atob(b64.trim()),c=>c.charCodeAt(0));const txt=await new Response(new Blob([b]).stream().pipeThrough(new DecompressionStream('gzip'))).text();const o=JSON.parse(txt);Object.assign(I18N[L]||(I18N[L]={}),o.d);I18N.T=I18N.T||{};I18N.T[L]=o.T;if(I18N.Z)delete I18N.Z[L];delete C[L];delete K[L];I18N.OK=I18N.OK||{};I18N.OK[L]=1;try{I18D.dirty=1;if(typeof UI!=='undefined'&&UI.stat)UI.stat()}catch(e){}}
const busy={};
window.I18LOAD=async function(L){try{if(!L||L==='fr'||(I18N.OK&&I18N.OK[L])||busy[L])return;busy[L]=1;if(I18N.Z&&I18N.Z[L])await dec(L,I18N.Z[L]);else{const r=await fetch('i18n_'+L+'.txt');if(r.ok)await dec(L,await r.text())}}catch(e){console.warn('i18n',e)}busy[L]=0};
(async function(){try{for(const L in (I18N.Z||{}))await window.I18LOAD(L)}catch(e){}let n=0;const t=setInterval(()=>{n++;try{if(typeof S!=='undefined'&&S.lang&&S.lang!=='fr'){window.I18LOAD(S.lang)}}catch(e){}if(n>20)clearInterval(t)},700)})();
})();
window.trH=function(h){if(typeof h!=='string'||typeof S==='undefined'||!S.lang||S.lang==='fr')return h;const L=S.lang,d=I18N[L]||{};if(d[h])return d[h];if(!/<[^>]+>/.test(h)){const w=I18X(h,L);return w==null?h:w}const seg=x=>{const q=x.trim();if(!q)return x;if(d[q])return x.replace(q,d[q]);const t=window.I18XT&&I18XT(q,L);if(t!=null)return x.replace(q,t);return x.split(/(<[^>]+>)/).map(p=>{if(!p||p[0]==='<'||!/[A-Za-zÀ-ÿ]{2}/.test(p))return p;const y=I18X(p,L);return y==null?p:y}).join('')};return h.split(/(<br\s*\/?>)/i).map(x=>/^<br/i.test(x)?x:seg(x)).join('')};
if(typeof objective==='function'){const _o=objective;objective=function(){return trH(_o.apply(this,arguments))}}


/* ---------- audit : une case par personnage, et les seuils restent libres ---------- */
(()=>{try{const M=MAPS.world,WP=M.warps||[],occ=new Set(),k=(x,y)=>x+','+y;
 const ok=(x,y,z)=>{const r=M.rows[y];if(!r)return false;const c=r[x];if(c===undefined||SOLID.includes(c)||'G^~w'.includes(c))return false;if(M.zone(y)!==z||occ.has(k(x,y)))return false;return !WP.some(w=>w.x===x&&(w.y===y||w.y+1===y))};
 const move=o=>{const z=M.zone(o.y);for(let r=1;r<8;r++)for(let dy=-r;dy<=r;dy++)for(let dx=-r;dx<=r;dx++){if(Math.max(Math.abs(dx),Math.abs(dy))!==r)continue;if(ok(o.x+dx,o.y+dy,z)){o.x+=dx;o.y+=dy;return}}};
 ITEMS.forEach(i=>{if(i.m==='world')occ.add(k(i.x,i.y))});
 if(typeof HIDS!=='undefined')HIDS.forEach(h=>occ.add(k(h.x,h.y)));
 GUARD.forEach(g=>occ.add(k(g.x,g.y)));
 const N=NPCS.world.filter(n=>!n.cond&&!/^pro_/.test(n.id||''));
 for(const n of N.filter(n=>!/^x\d/.test(n.id||'')).concat(N.filter(n=>/^x\d/.test(n.id||'')))){if(occ.has(k(n.x,n.y))||WP.some(w=>w.x===n.x&&w.y===n.y))move(n);occ.add(k(n.x,n.y))}
 for(const A of [typeof ROVERS!=='undefined'?ROVERS:[],typeof ELITES!=='undefined'?ELITES:[]])for(const g of A){if(occ.has(k(g.x,g.y)))move(g);occ.add(k(g.x,g.y))}
}catch(e){console.warn('sep',e)}})();
/* ---------- boucle principale + écran-titre ---------- */
let lastTs=0;
function frame(ts){requestAnimationFrame(frame);const dt=Math.min(.05,(ts-lastTs)/1000||.016);lastTs=ts;G.t+=dt;
 try{
 if(G.scene==='world'){W.step(dt);W.draw(G.t);W.grade()}
 else if(G.scene==='title'){g.fillStyle='#1c2238';g.fillRect(0,0,SW,SH)}
 else if(G.scene==='battle')Battle.drawScene(G.t);
 else if(G.scene==='lesson')Lesson.drawScene(G.t);
 else if(G.scene==='evo')Evo.drawScene(G.t);
 else if(G.scene==='chat')Chat.drawScene(G.t);
 else{g.fillStyle='#000';g.fillRect(0,0,SW,SH)}
 }catch(e){frame.err=(frame.err||0)+1;if(frame.err<4){console.error(e);try{if(G.scene==='world'&&W.reset)W.reset()}catch(x){}}}
 if(G.scene==='world'&&UI.cur==='pad'&&Math.floor(G.t*2)!==frame.o){frame.o=Math.floor(G.t*2);UI.stat()}}
function title(){G.scene='title';G.busy=true;{const l=$('#boot');if(l)l.remove()}$('#banner').classList.remove('on');$('#tit').classList.remove('hidden');UI.panel('title');$('#tit').style.backgroundImage=`linear-gradient(rgba(28,34,56,0) 60%,#1c2238 72%),url(${IM.TITLE})`;
 const has=hasSave()&&S.fl.intro;$('#bCont').classList.toggle('hidden',!has);music('title');$('#tit').addEventListener('pointerdown',()=>{try{au()}catch(e){}},{once:true});let armed=false;
 $('#bCont').onclick=async()=>{au();music('village');sfx('sel');await UI.fade(1,300);$('#tit').classList.add('hidden');let p=S.pos||{m:'world',x:3,y:OY+87,d:0};W.load(p.m,p.x,p.y,p.d);if(W.solid(p.x,p.y)){p=S.heal&&S.heal.m==='world'?{m:'world',x:S.heal.x,y:S.heal.y,d:0}:{m:'world',x:3,y:OY+87,d:0};W.load(p.m,p.x,p.y,0);if(W.solid(p.x,p.y)){p={m:'world',x:3,y:OY+87,d:0};S.heal=null;W.load(p.m,p.x,p.y,0)}S.pos=p}G.scene='world';G.busy=false;UI.panel('pad');await UI.fade(0,300)};
 $('#bNew').onclick=async()=>{au();if(has&&!armed){armed=true;$('#bNew').innerHTML='Effacer la partie en cours ?<small>Touche encore pour confirmer</small>';return}
  sfx('sel');const keep={snd:S.snd,mus:S.mus,furi:S.furi,roma:S.roma};try{localStorage.removeItem('jz3')}catch(e){}loadS();Object.assign(S,keep);S.hp=maxHp();
  await UI.fade(1,400);$('#tit').classList.add('hidden');G.scene='black';await More.welcome();if(PART===34&&window.Act3)return Act3.start();if(PART===4&&window.Act4&&Act4.boot)return Act4.boot();music('village');intro()}}
/* si la carte a grandi depuis la sauvegarde (nouvelles zones au nord), on décale les positions au lieu de renvoyer à la maison */
{const h=MAPS.world.h,zt=[];let pz=-1;for(let y=0;y<h;y++){const z=MAPS.world.zone(y);if(z!==pz){zt.push([z,y]);pz=z}}
 const LEG={1019:[[11,0],[10,102],[9,203],[8,307],[7,405],[6,503],[5,601],[4,657],[3,739],[2,821],[1,929],[0,997]]},old=S.zt||LEG[S.mh];
 if(S.mh&&(S.mh!==h||(S.zt&&JSON.stringify(S.zt)!==JSON.stringify(zt)))){const dy=h-S.mh,band=(t,y,H_)=>{for(let i=t.length-1;i>=0;i--)if(y>=t[i][1])return{z:t[i][0],top:t[i][1],len:(i+1<t.length?t[i+1][1]:H_)-t[i][1]};return null};
  ['pos','heal','ret'].forEach(k=>{const p=S[k];if(!p||typeof p.y!=='number'||(p.m&&p.m!=='world'))return;const a=old&&band(old,p.y,S.mh),nb=a&&zt.find(q=>q[0]===a.z);
   if(!a||!nb){p.y+=dy;return}const b=band(zt,nb[1],h),hm=HAMS.find(q=>q.z===a.z),route=hm?hm.y0-b.top:b.len,off=p.y-a.top;p.y=a.z===0?p.y+dy:off<route?b.top+off:b.top+b.len-(a.len-off)})}
 if(S.mh!==h||JSON.stringify(S.zt||0)!==JSON.stringify(zt)){S.mh=h;S.zt=zt;save()}
 /* une position tombée dans un mur après un agrandissement de la carte : on cherche la case libre la plus proche */
 {const RW=MAPS.world.rows,ok=(x,y)=>RW[y]&&RW[y][x]&&!SOLID.includes(RW[y][x]);['pos','heal','ret'].forEach(k=>{const p=S[k];if(!p||(p.m&&p.m!=='world')||typeof p.y!=='number'||ok(p.x,p.y))return;
  for(let r=1;r<30;r++)for(let dy=-r;dy<=r;dy++)for(let dx=-r;dx<=r;dx++)if(Math.max(Math.abs(dx),Math.abs(dy))===r&&ok(p.x+dx,p.y+dy)){p.x+=dx;p.y+=dy;return}})}}
{UI.fit();title();const bs=[$('#bCont'),$('#bNew')],lb=bs.map(b=>b.innerHTML);bs.forEach(b=>{b.disabled=true;b.style.opacity=.45});bs[1].innerHTML='Chargement des images…';
 XREADY.then(()=>{bs.forEach((b,i)=>{b.disabled=false;b.style.opacity='';b.innerHTML=lb[i]});requestAnimationFrame(frame);
  /* reprise automatique : si la page a été rechargée par le téléphone en pleine partie, on saute l'écran-titre */
  let hb=0;try{hb=+localStorage.getItem('jz_hb')||0}catch(e){}
  if(hasSave()&&S.fl.intro&&Date.now()-hb<15*60*1000){$('#bCont').click();setTimeout(()=>{try{UI.toast('Partie reprise là où tu t\'étais arrêté.')}catch(e){}},900)}
  setInterval(()=>{try{if(G.scene==='title'||!S.fl.intro)return;if(document.hidden)return;if(G.scene==='world'&&W.map==='world'&&!G.busy&&!W.H.mv){S.pos={m:W.map,x:W.H.x,y:W.H.y,d:W.H.dir};save()}localStorage.setItem('jz_hb',Date.now())}catch(e){}},4000)})}

/* temple (zone 21) : l'herbe est posée par blocs de 4×4 cases retournés au hasard (plus de motif qui se répète),
   et des arbres bordent les allées du jardin */
(()=>{const h=HAMS.find(q=>q.z===21),M=MAPS.world;if(!h||!ZT[21]||!ZP[21])return;const T=16,ok=k=>XI[k]&&XI[k].width,
 hb=(a,b)=>{let x=(a*374761393+b*668265263)>>>0;x=((x^(x>>>13))*1274126177)>>>0;return(x^(x>>>16))>>>0},at=(x,y)=>{const r=M.rows[y];return r?r[x]:'T'},
 tex=(X,x,y)=>{const f=hb(x>>2,y>>2)&3,fx=f&1,fy=f>>1,sx=fx?3-(x&3):x&3,sy=fy?3-(y&3):y&3;X.save();X.translate(x*T+(fx?T:0),y*T+(fy?T:0));X.scale(fx?-1:1,fy?-1:1);X.drawImage(XI.T_TE2_2,sx*48,sy*48,48,48,0,0,T,T);X.restore()};
 const o=ZT[21];ZT[21]=(X,c,x,y,hh)=>{if(ok('T_TE2_2')){
   if(y>=32&&y<=h.y0-3&&'.sw,lZ'.includes(c)){tex(X,x,y);return c==='.'||c==='s'}
   if(y>=h.y0&&y<=h.y1){if('.,sw'.includes(c)){tex(X,x,y);return true}if('lbcoSJ'.includes(c)){if(o&&o(X,c,x,y,hh))return true;tex(X,x,y);return true}}}
  return o?o(X,c,x,y,hh):false};
 let TD=0;const trees=()=>{if(TD)return;TD=1;const TR=['X_B21_CEDAR','X_B21_CEDAR','X_B21_SAKURA','X_GT2','X_GT0','X_GT3'].filter(ok);if(!TR.length)return;
  const occ=new Set();for(const b of ((window.PEAKS21&&PEAKS21())||[]))for(let i=-1;i<=b.w;i++)for(let j=-1;j<=b.h;j++)occ.add((b.x+i)+','+(b.y+j));
  const C=[],pl=[];for(let y=33;y<=h.y0-4;y++)for(let x=31;x<80;x++){if(at(x,y)!=='T'||occ.has(x+','+y))continue;let n=0;for(let a=-1;a<=1;a++)for(let b=-1;b<=1;b++)if(at(x+a,y+b)!=='T')n++;if(n)C.push([x,y,hb(x*7+1,y*13+5)])}
  C.sort((a,b)=>a[2]-b[2]);for(const[x,y,r]of C){if(pl.some(([u,v])=>Math.abs(u-x)<2&&Math.abs(v-y)<2))continue;pl.push([x,y]);
   (M.bld||(M.bld=[])).push({k:'city',x,y,w:1,h:1,im:TR[r%TR.length],flip:(r>>4)&1,tint:'',sc:.85+(r>>5)%4*.05})}};
 const of=ZP[21].f;ZP[21].f=(...a)=>{const r=of(...a);trees();return r};
})();
</script>
</body></html>
