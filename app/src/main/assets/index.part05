 if(tgt){if(Math.abs(x-H.x)+Math.abs(y-H.y)===1&&!H.mv){faceTo(H,{x,y});return interactAt(x,y)}H.pend=[x,y,tgt&&tgt.npc?tgt:null];H.path=bfs(x,y,true)}else{H.pend=null;H.path=bfs(x,y)}}
return{reset:()=>{if(window.WAN)WAN.reset();STR=new Map();SDONE=[];SFREE=[];SROW={};BAMF=[]},TC,spawn:o=>{const e=mkEnt(o);ents.push(e);return e},setNight:v=>{night=v},H,load,step,draw,grade,interact,tapTile,ev,emote,walk,walkNear,faceTo,blocked,solid,at:(x,y)=>at(x,y),bfs,
 get ents(){return ents},get map(){return MID},get M(){return M},zone:()=>M.inside?100:zoneAt(H.y),shake:s=>{shakeT=s},remove:e=>{e.gone=true},refreshZone:()=>{lastZone=-1;zoneCheck()},cam:()=>[cx,cy]}})();

/* expression du portrait : donnée par la réplique (em:'h','s','t','d') ou devinée d'après le texte */
function emoOf(l){const t=String(l.fr||l.t||'');if(!t)return '';if(/\?\s*!|!\s*\?|^(Quoi|Hein|Oh|Eh|Ah)\b|\?\?/i.test(t))return 's';if(/(désolé|pardon|triste|pleur|seule?\b|manque|peur|adieu|mort)/i.test(t)||/…\s*$/.test(t))return 't';if(/(merci|bravo|super|content|génial|haha|hihi|bienvenue|youpi)/i.test(t))return 'h';if(/!\s*$/.test(t))return l.n==='Kaito'?'d':'h';return ''}
/* ---------- interface : panneaux, bannière, fondu, dialogues ---------- */
const UI={cur:'',
 fit(){const a=$('#app'),w=a.clientWidth,h=a.clientHeight,u=Math.max(1,w/SW),nh=Math.max(192,Math.round(h/u));document.documentElement.style.setProperty('--u',u.toFixed(3)+'px');if(nh!==SH||scr.height!==nh*2){SH=nh;scr.width=SW*2;scr.height=nh*2;g.setTransform(2,0,0,2,0,0);g.imageSmoothingEnabled=false}document.documentElement.style.setProperty('--bh',Math.max(192,Math.min(260,Math.floor(nh*.47))));if(typeof Trace!=='undefined')Trace.size()},
 panel(n){if(n!=='pad'){const tt=$('#toast');if(tt&&/Carnet/.test(tt.textContent))tt.classList.add('hidden')}UI.cur=n;$('#app').classList.toggle('sheet',n!=='pad');$$('.pan').forEach(p=>p.classList.toggle('hidden',p.id!=='p'+n[0].toUpperCase()+n.slice(1)));if(n==='pad')UI.stat()},
 banner(jp,fr){const b=$('#banner');b.querySelector('b').innerHTML=jpHtml(jp);b.querySelector('span').textContent=fr;b.classList.add('on');clearTimeout(UI.bt);UI.bt=setTimeout(()=>b.classList.remove('on'),2600)},
 fade(on,ms,white){const f=$('#fade');f.classList.toggle('w',!!white);f.style.transitionDuration=(ms||220)+'ms';f.style.opacity=on?1:0;return wait((ms||220)+30)},
 toast(t,ms){const e=$('#toast');e.innerHTML=tr(t);e.classList.remove('hidden');clearTimeout(UI.tt);UI.tt=setTimeout(()=>e.classList.add('hidden'),ms||2400)},
 stat(){const st=stage(S.xp),mx=maxHp();S.hp=clamp(S.hp,0,mx);$('#stAv').src=IM['PX_'+STG[st]];$('#stNm').textContent='Kaito · '+STAGES[st].name;$('#stLv').textContent='Nv '+level(S.xp)+(typeof Quest!=='undefined'?` · 日 ${Quest.count}/3`+(Quest.streak()?` · 🔥${Quest.streak()}`:''):'');
  $('#stHp').style.width=S.hp/mx*100+'%';$('#stHp').style.background=S.hp/mx>.5?'var(--green)':S.hp/mx>.2?'var(--gold)':'var(--red)';$('#stHpT').innerHTML=`PV ${S.hp}/${mx} · ${S.xp} XP · <img class="ic" src="${IM.I_ONI}" alt="onigiri"> ${S.it.oni||0} · <img class="ic" src="${IM.I_CHA}" alt="thé"> ${S.it.cha||0} · <span style="white-space:nowrap">${S.gold||0} 円</span>`;
  $('#stXp').style.width=(S.xp%30)/30*100+'%';$('#obj').innerHTML=typeof objective==='function'?objective():''}};
window.addEventListener('resize',UI.fit);
$('#obj').addEventListener('pointerdown',e=>{e.stopPropagation();$('#obj').classList.toggle('open');sfx('tap')});
/* --- entrées --- */
function pressA(){au();if(Input.onA){Input.onA();return}if(G.scene==='world'&&!G.busy)W.interact()}
function pressB(){if(Input.onB){Input.onB();return}if(Input.onA&&$('#dlg').offsetParent)Input.onA()}
{const dp=$('#dpad');let pid=null;
 const upd=e=>{const r=dp.getBoundingClientRect(),dx=e.clientX-(r.left+r.width/2),dy=e.clientY-(r.top+r.height/2);let d=-1;if(Math.hypot(dx,dy)>r.width*.1)d=Math.abs(dx)>Math.abs(dy)?(dx<0?2:3):(dy<0?1:0);Input.dir=d;dp.querySelectorAll('button').forEach(b=>b.classList.toggle('on',+b.dataset.d===d))};
 dp.addEventListener('pointerdown',e=>{au();pid=e.pointerId;try{dp.setPointerCapture(pid)}catch(x){}upd(e);e.preventDefault()});
 dp.addEventListener('pointermove',e=>{if(e.pointerId===pid)upd(e)});
 const end=e=>{if(e.pointerId!==pid)return;pid=null;Input.dir=-1;dp.querySelectorAll('button').forEach(b=>b.classList.remove('on'))};
 dp.addEventListener('pointerup',end);dp.addEventListener('pointercancel',end);
 $('#kA').addEventListener('pointerdown',e=>{e.preventDefault();pressA()});
 const kb=$('#kB');kb.addEventListener('pointerdown',e=>{e.preventDefault();au();Input.run=true;kb.classList.add('on');pressB()});['pointerup','pointercancel','pointerleave'].forEach(v=>kb.addEventListener(v,()=>{Input.run=false;kb.classList.remove('on')}));
 $('#kStart').onclick=()=>{au();if(G.scene==='world'&&!G.busy)Menu.open()};$('#kRev').onclick=()=>{au();if(G.scene==='world'&&!G.busy)Menu.open('r')};
 const KM={ArrowDown:0,ArrowUp:1,ArrowLeft:2,ArrowRight:3,s:0,w:1,z:1,a:2,q:2,d:3};
 window.addEventListener('keydown',e=>{if(e.repeat||(e.target&&e.target.tagName==='INPUT'))return;const k=e.key.length===1?e.key.toLowerCase():e.key;if(k in KM){Input.dir=KM[k];e.preventDefault()}else if(k==='Enter'||k===' '||k==='x'){pressA();e.preventDefault()}else if(k==='Shift'||k==='b'){Input.run=true}else if(k==='Escape'||k==='m'){if(G.scene==='world'&&!G.busy)Menu.open()}});
 window.addEventListener('keyup',e=>{const k=e.key.length===1?e.key.toLowerCase():e.key;if(KM[k]===Input.dir)Input.dir=-1;if(k==='Shift'||k==='b')Input.run=false});
 /* toucher n'importe où fait avancer le texte, pas seulement la bulle */
 $('#bot').addEventListener('pointerdown',e=>{if(Input.onA&&!e.target.closest('button,input,ruby.fx,.mbody,#dCh'))Input.onA()});
 scr.addEventListener('pointerdown',e=>{au();if(Input.onA){Input.onA();return}e.preventDefault()});
 $('#dlg').addEventListener('pointerdown',e=>{if(Input.onA)Input.onA()});
 document.addEventListener('pointerdown',au);}
/* --- dialogues --- */
const PORT={'Maître Kotoba':'PX_kotoba','Hana':'PX_hana','Maître Tanuki':'PX_tanu','Maître Genzō':'PX_master','Grand-mère Ume':'PX_baa','Moine Jaku':'PX_bozu','Ingénieure Rin':'PX_eng','Forgeronne Hagane':'PX_forg','Samouraï':'PX_ronin','Contremaître Gonta':'PX_worker','Vieil homme':'PX_jii','Enfant':'PX_kid','Pêcheur':'PX_fisher','Vieux pêcheur':'PX_fisher','Paysan':'PX_fisher','Villageoise':'PX_girl','Habitante':'PX_girl','Ouvrière':'PX_worker','Ouvrier':'PX_worker'};
const D=(()=>{
 const box=$('#dlg'),tx=$('#dlgT'),nm=$('#dlgN');let tm=0;
 const pages=t=>{if(t.length<=96)return[t];const out=[];let cur='';(t.match(/[^.!?…»]+[.!?…»]*\s*/g)||[t]).forEach(s=>{s=s.trim();if((cur+' '+s).length>96&&cur){out.push(cur);cur=s}else cur=(cur+' '+s).trim()});if(cur)out.push(cur);return out};
 function study(l,isNew){window.__CURL=l;const st=$('#study'),pp=$('#pPad');pp.classList.toggle('jpl',!!l.jp);pp.classList.remove('ask');if(!l.jp)return;
  st.innerHTML=`${isNew?'<span class="new">＋ ajouté au carnet</span>':''}<div class="row"><div class="grow"><div class="jp">${jpHtml(l.jp)}</div><div class="kana">${esc(jpKana(l.jp))}</div>${S.roma?`<div class="ro">${esc(romaji(l.jp))}</div>`:''}</div>${l.img?`<img class="vimg" src="${l.img}" alt="">`:''}<button class="spk" aria-label="Écouter">🔊</button></div>${l.fr?`<div class="fr">${esc(l.fr)}</div>`:''}${l.x?`<div class="x">${l.x}</div>`:''}`;
  st.querySelector('.spk').onclick=e=>{e.stopPropagation();say(jpText(l.jp))}}
 function show(l,o){return new Promise(res=>{o=o||{};window.SAYP=l.n==='影'?1:0;if(S.lang&&S.lang!=='fr')l=Object.assign({},l,{t:tr(l.t),fr:tr(l.fr),x:tr(l.x)});box.classList.remove('hidden');nm.textContent=tr(l.n||'');{const pk=l.n==='Kaito'?'PX_'+STG[stage(S.xp)]:PORT[l.n],pi=$('#dlgP');box.classList.toggle('hasp',!!pk&&o.panel!==false);$('#app').classList.toggle('hasp',!!pk&&o.panel!==false);if(pk){const em=l.em||emoOf(l);pi.src=(em&&IM[pk+'_'+em])||IM[pk]}}box.classList.toggle('jp',!!l.jp);box.classList.toggle('noarr',!!o.noarr);
  let units,tail='';if(l.jp){units=l.jp.map(t=>window.VHL?VHL(t,rubyTok(t)):rubyTok(t));if(l.fr&&!o.nofr)tail=`<div style="font-size:calc(8*var(--u));color:var(--sub);line-height:1.2">${esc(l.fr)}</div>`;if(!o.quiet)say(jpText(l.jp))}else units=[...String(l.t)].map(esc);
  if(o.panel!==false){UI.panel('pad');$('#pPad').classList.add('wait');study(l,l.jp&&l.fr&&!o.nolearn?learnPhr(l.jp,l.fr):false)}
  let n=0,done=false;box.classList.add('typing');clearInterval(tm);
  const fin=()=>{clearInterval(tm);n=units.length;tx.innerHTML=units.join('')+tail;box.classList.remove('typing')};
  tm=setInterval(()=>{n+=l.jp?1:2;if(n%6<2)sfx('txt');if(n>=units.length){fin();if(o.auto)setTimeout(end,o.auto)}else tx.innerHTML=units.slice(0,n).join('')},l.jp?70:24);
  function end(){if(done)return;done=true;clearInterval(tm);Input.onA=null;res()}
  Input.onA=()=>{if(n<units.length)fin();else{sfx('tap');end()}}})}
 async function sayL(lines,o){for(const l0 of[].concat(lines)){const l=typeof l0==='string'?{t:tr(l0)}:l0.t&&!l0.jp?Object.assign({},l0,{t:tr(l0.t)}):l0;if(l.jp)await show(l,o);else for(const p of pages(l.t))await show({n:l.n,t:p},o)}if(!o||!o.keep)hide()}
 function hide(){box.classList.add('hidden');{const vi=$('#dlgVI');if(vi)vi.style.display='none'}$('#app').classList.remove('hasp');$('#choice').classList.add('hidden');$('#pPad').classList.remove('jpl','ask','wait')}
 function ask(q,opts,o){return new Promise(async res=>{o=o||{};if(q)await show(typeof q==='string'?{t:q}:q,{auto:1,panel:o.panel});Input.onA=null;
  const c=$('#choice'),lab=x=>typeof x==='string'?esc(x):`${jpHtml(x.jp)} <small style="color:var(--sub)">${esc(x.fr)}</small>`;
  c.innerHTML=opts.map((x,i)=>`<button data-i="${i}">${lab(x)}</button>`).join('');c.classList.remove('hidden');
  const fin=i=>{sfx('sel');c.classList.add('hidden');$('#pPad').classList.remove('ask');if(!o.keep)hide();res(i)};
  c.onclick=e=>{const b=e.target.closest('button');if(b)fin(+b.dataset.i)};
  if(o.panel!==false){UI.panel('pad');const pp=$('#pPad');pp.classList.add('ask');pp.classList.remove('wait');const d=$('#dCh');d.innerHTML=opts.map((x,i)=>`<button class="btn" data-i="${i}">${lab(x)}</button>`).join('');d.onclick=e=>{const b=e.target.closest('button');if(b)fin(+b.dataset.i)}}})}
 return{say:sayL,ask,hide,show}})();

/* ---------- tracé des kanji (pinceau sur papier) ---------- */
const ELEM={'木':['bois','#3e9a48'],'土':['terre','#a8743a'],'火':['feu','#e0582a'],'水':['eau','#3a8ad8'],'風':['vent','#4aa8a0'],'雷':['foudre','#c8a018'],'山':['roche','#7a7a96'],'人':['force','#c05a8a']};
const elem=k=>ELEM[k]||['kanji','#58e0ec'];
const unl=sp=>!!S.sp[sp.k];const spK=k=>SP.find(s=>s.k===k);
const starsTxt=n=>'★'.repeat(n)+'☆'.repeat(3-n);
/* aide au tracé : elle diminue à mesure que le kanji est maîtrisé (S.km = tracés réussis) */
const AIDN=['Aide complète','Aide : points de départ','Aide : premier point','Sans aide'];
const aidOf=k=>{const n=(S.km||{})[k]||0;return n<3?0:n<6?1:n<10?2:3};
const Trace=(()=>{
 const cv=$('#cv'),cx=cv.getContext('2d');let TR=null,SZ=300,raf=0;
 function size(){const w=$('#tBw');if(!w||UI.cur!=='trace')return;const r=w.getBoundingClientRect(),s=Math.max(120,Math.floor(Math.min(r.width,r.height)-8)),dpr=Math.min(2,window.devicePixelRatio||1);SZ=s;cv.style.width=cv.style.height=s+'px';cv.width=cv.height=s*dpr;cx.setTransform(dpr,0,0,dpr,0,0)}
 const g2p=p=>[p[0]/100*SZ,p[1]/100*SZ];
 const path=poly=>{cx.beginPath();poly.forEach((p,i)=>{const q=g2p(p);i?cx.lineTo(q[0],q[1]):cx.moveTo(q[0],q[1])})};
 function prog(){$('#tProg').innerHTML=TR.sp.s.map((_,i)=>`<i class="${i<TR.i?'on':i===TR.i?'cur':''}"></i>`).join('')}
 const CY='#58e0ec';
 function glow(w,core){cx.shadowColor=CY;cx.shadowBlur=SZ*.07;cx.strokeStyle='rgba(88,224,236,.55)';cx.lineWidth=w*1.5;cx.stroke();cx.shadowBlur=SZ*.03;cx.strokeStyle=CY;cx.lineWidth=w;cx.stroke();cx.shadowBlur=0;cx.strokeStyle='#eaffff';cx.lineWidth=w*core;cx.stroke()}
 function spark(x,y,n,v){for(let i=0;i<n;i++){const a=Math.random()*6.3,s=(.3+Math.random())*v;TR.fx.push({x,y,vx:Math.cos(a)*s,vy:Math.sin(a)*s-v*.3,l:1,r:.6+Math.random()*1.6,w:Math.random()<.3})}if(TR.fx.length>260)TR.fx.splice(0,TR.fx.length-260)}
 function draw(){if(!TR)return;raf=requestAnimationFrame(draw);const t=performance.now()/1000;cx.clearRect(0,0,SZ,SZ);
  const bg=cx.createRadialGradient(SZ/2,SZ/2,SZ*.1,SZ/2,SZ/2,SZ*.75);bg.addColorStop(0,'#1b2748');bg.addColorStop(1,'#0c1226');cx.fillStyle=bg;cx.fillRect(0,0,SZ,SZ);
  cx.strokeStyle='rgba(88,224,236,.22)';cx.lineWidth=1;cx.setLineDash([6,6]);cx.beginPath();cx.moveTo(SZ/2,0);cx.lineTo(SZ/2,SZ);cx.moveTo(0,SZ/2);cx.lineTo(SZ,SZ/2);cx.stroke();cx.setLineDash([]);
  const A=TR.aid,show=A===0||TR.fail>=2;cx.fillStyle=A===0?'rgba(150,190,255,.09)':A===1?'rgba(150,190,255,.05)':'rgba(0,0,0,0)';cx.font=`${SZ*.9}px "Hiragino Mincho ProN","Yu Mincho","Noto Serif JP",serif`;cx.textAlign='center';cx.textBaseline='middle';if(!(window.fitK&&fitK(cx,TR.sp,SZ,g2p)))cx.fillText(TR.sp.k,SZ/2,SZ*.54);
  cx.lineCap='round';cx.lineJoin='round';
  TR.sp.s.forEach((s,i)=>{const a=g2p(s[0]);
   if(i<TR.i){path(s);glow(SZ*.05,.38)}
   else if(i===TR.i){if(show){cx.save();cx.setLineDash([SZ*.04,SZ*.03]);cx.lineDashOffset=-t*30;cx.strokeStyle='#f0c060';cx.lineWidth=SZ*.03;path(s);cx.stroke();cx.restore()}if(A>2&&!show)return;const pl=1+.25*Math.sin(t*6);cx.fillStyle='#ff6a5a';cx.shadowColor='#ff6a5a';cx.shadowBlur=SZ*.04;cx.beginPath();cx.arc(a[0],a[1],SZ*.035*pl,0,6.3);cx.fill();cx.shadowBlur=0;
    if(!show)return;const e=g2p(s[s.length-1]),pv=g2p(s[s.length-2]),an=Math.atan2(e[1]-pv[1],e[0]-pv[0]);cx.save();cx.translate(e[0],e[1]);cx.rotate(an);cx.fillStyle='#f0c060';cx.beginPath();cx.moveTo(SZ*.035,0);cx.lineTo(-SZ*.02,-SZ*.03);cx.lineTo(-SZ*.02,SZ*.03);cx.fill();cx.restore()}
   else{if(A>1)return;cx.fillStyle='rgba(170,190,240,.35)';cx.beginPath();cx.arc(a[0],a[1],SZ*.018,0,6.3);cx.fill()}
   if(i>=TR.i&&(A<2||(i===TR.i&&show))){cx.fillStyle=i===TR.i?'#ff8a7a':'rgba(190,205,245,.6)';cx.font=`${SZ*.055}px sans-serif`;cx.fillText(i+1,a[0]+(a[0]<SZ/2?-SZ*.06:SZ*.06),a[1]-SZ*.045)}});
  if(TR.pts.length>1){cx.beginPath();TR.pts.forEach((p,i)=>i?cx.lineTo(p[0],p[1]):cx.moveTo(p[0],p[1]));glow(SZ*.045,.4);const l=TR.pts[TR.pts.length-1];cx.fillStyle='#fff';cx.shadowColor=CY;cx.shadowBlur=SZ*.06;cx.beginPath();cx.arc(l[0],l[1],SZ*.02,0,6.3);cx.fill();cx.shadowBlur=0}
  cx.globalCompositeOperation='lighter';TR.fx=TR.fx.filter(p=>{p.x+=p.vx;p.y+=p.vy;p.vy+=.03;p.vx*=.97;p.l-=.028;if(p.l<=0)return false;cx.globalAlpha=p.l;cx.fillStyle=p.w?'#ffffff':CY;const r=p.r*SZ/300*(.6+p.l);cx.fillRect(p.x-r,p.y-r,r*2,r*2);return true});cx.globalAlpha=1;cx.globalCompositeOperation='source-over';
  if(TR.flash>0){cx.fillStyle=`rgba(255,90,90,${TR.flash*.28})`;cx.fillRect(0,0,SZ,SZ);TR.flash-=.06}}
 const cpos=e=>{const r=cv.getBoundingClientRect();return[e.clientX-r.left,e.clientY-r.top]};
 cv.addEventListener('pointerdown',e=>{if(!TR||TR.fin)return;au();try{cv.setPointerCapture(e.pointerId)}catch(x){}TR.down=true;TR.pts=[cpos(e)];e.preventDefault()});
 cv.addEventListener('pointermove',e=>{if(!TR||!TR.down)return;const p=cpos(e),l=TR.pts[TR.pts.length-1];if(dist(p,l)>2){TR.pts.push(p);spark(p[0],p[1],2,SZ*.006)}e.preventDefault()});
 const endS=()=>{if(!TR||!TR.down)return;TR.down=false;const user=TR.pts.map(p=>[p[0]/SZ*100,p[1]/SZ*100]);TR.pts=[];if(user.length<3)return;
  if(judge(user,TR.sp.s[TR.i],[1,1.15,1.3,1.6][TR.aid]*(window.TRTOL||1)))okS();else{TR.err++;TR.fail++;TR.flash=1;sfx('bad');$('#tMsg').textContent=TR.fail>=2&&TR.aid>0?'Voici le trait attendu. Suis-le dans le sens de la flèche.':TR.aid>2?'Ce n\'est pas ce trait-là. Pense à l\'ordre : de haut en bas, de gauche à droite.':TR.aid>0?'Raté : pars du point rouge, dans le bon sens.':'Raté : pars du point rouge et suis la ligne dans le bon sens.'}};
 cv.addEventListener('pointerup',endS);cv.addEventListener('pointercancel',endS);
 function okS(){TR.fail=0;sfx('tok');{const s=TR.sp.s[TR.i];s.forEach((q,j)=>{const a=g2p(q);spark(a[0],a[1],j%2?5:9,SZ*.011)})}TR.i++;prog();$('#tMsg').textContent=TR.i<TR.sp.s.length?`Trait ${TR.i} sur ${TR.sp.s.length} : bien !`:'Parfait !';if(TR.i>=TR.sp.s.length&&!TR.fin){TR.fin=true;const st=TR.err===0?3:TR.err<=3?2:1;setTimeout(()=>finish({stars:st}),450)}}
 function finish(r){if(!TR)return;if(r){Quest.add('trace');r.aid=TR.aid;const m=S.km||(S.km={}),k=TR.sp.k;m[k]=Math.max(0,(m[k]||0)+(r.stars>=2?1:-1));if(spK(k))Review.markK(k,r.stars>=2);const st=S.st||(S.st={}),a=st.tr||(st.tr=[0,0]);a[1]++;if(r.stars>=2)a[0]++}const f=TR.res;cancelAnimationFrame(raf);TR=null;f(r)}
 $('#tHint').onclick=()=>{if(!TR||TR.fin)return;TR.err+=3;okS()};
 $('#tQuit').onclick=()=>{if(TR&&!TR.fin){sfx('back');finish(null)}};
 function run(sp,o){o=o||{};return new Promise(res=>{const aid=o.aid!=null?o.aid:aidOf(sp.k);TR={sp,i:0,err:0,fail:0,aid,pts:[],fx:[],down:false,flash:0,fin:false,res};UI.panel('trace');$('#tQuit').classList.toggle('hidden',o.quit===false);
  $('#tK').textContent=aid>2?'？':sp.k;$('#tName').textContent=`${sp.name} · ${sp.fr}`;$('#tRead').innerHTML=`くん ${sp.kun} · オン ${sp.on} · ${sp.s.length} traits<br><span style="color:var(--cy)">${AIDN[aid]}</span>`;$('#tMsg').textContent=['Trace chaque trait en partant du point rouge.','Les points indiquent où commence chaque trait.','Seul le départ du trait suivant est indiqué.','Trace le kanji de mémoire, trait par trait.'][aid];prog();size();draw()})}
 return{run,size,sim:n=>{if(TR&&!TR.fin){TR.err=n===3?0:n===2?2:5;TR.i=TR.sp.s.length-1;okS()}}}})();

/* ---------- exercices : ord / gap / mcq ---------- */
const LIS=`<div class="lis card"><button class="btn pri lsn icb" id="xPl">${IM.X_ICLIS?`<img src="${IM.X_ICLIS}" alt="">`:'🔊'} Écouter</button><button class="btn lsn icb" id="xSl">${IM.X_ICSLO?`<img src="${IM.X_ICSLO}" alt="">`:'½×'} Lent</button></div>`;
const Ex=(()=>{
 let cur=null;
 const full=e=>e.t.map(x=>x==='＿'?e.a:x);
 function fb(ok,e,extra){const f=$('#xFb');let h='';
  const rp='<button class="spk lsn rp" aria-label="Réécouter" style="float:right;margin:0 0 4px 8px">🔊</button>';
  if(!ok&&e.q==='ord'&&e._ans){/* la phrase du joueur, erreurs soulignées en rouge, puis la bonne phrase */const good=e.t;h+=rp+`<small style="opacity:.75">Ta phrase</small><span class="jp">${e._ans.map((x,i)=>tk(x)[0]===(good[i]?tk(good[i])[0]:'')?esc(tk(x)[0]):`<u style="text-decoration:underline wavy #d8281e;text-underline-offset:5px;color:#b0201a">${esc(tk(x)[0])}</u>`).join(' ')}${e._ans.length<good.length?' <u style="text-decoration:underline wavy #d8281e;color:#b0201a">＿</u>':''}</span><small style="opacity:.75">La bonne phrase</small><span class="jp">${jpHtml(good)}</span>${esc(e.fr||'')}`}
  else if(e.listen)h+=rp+e.show;else if(e.t&&e.q!=='mcq')h+=rp+`<span class="jp">${jpHtml(full(e))}</span>`+(S.roma?`<i style="font-size:12px;opacity:.8">${esc(romaji(full(e)))}</i><br>`:'')+(e.fr?esc(e.fr):'');
  else if(!ok)h+=`<span class="jp">${esc(e.a)}</span>`;
  if(e.why)h+=`<br><span style="opacity:.85">${esc(e.why)}</span>`;if(extra)h+=extra;fbShow(f,ok,h)}
 function run(e,o){o=o||{};return new Promise(res=>{cur=e;UI.panel('ex');const body=$('#xBody'),okb=$('#xOk'),q=$('#xQ');$('#xFb').className='';$('#xFb').innerHTML='';
  let done=false,tmr=0;const t0c=performance.now(),early=()=>performance.now()-t0c<500;$('#xFb').onclick=ev=>{if(ev.target.closest('.rp'))say(e.listen?e.snd:jpText(full(e)))};const tm=$('#xTm'),qb=$('#xQuit');qb.classList.toggle('hidden',!o.quit);qb.onclick=()=>{clearInterval(tmr);done=true;sfx('back');res('quit')};tm.classList.toggle('hidden',!o.timed);
  const end=ok=>{if(done)return;done=true;clearInterval(tmr);{const st=S.st||(S.st={}),a=st[e.listen?'lis':e.q]||(st[e.listen?'lis':e.q]=[0,0]);a[1]++;if(ok)a[0]++}if(ok){Quest.add('ans');if(e.listen)Quest.add('ear')}if(e.id){markEx(e,ok)}sfx(ok?'ok':'bad');
   if(e.listen){if(ok)say(e.snd)}else if(ok&&e.t&&e.q!=='mcq')say(jpText(full(e)));else if(ok&&e.q==='mcq'&&/[ぁ-ん]/.test(e.a))say(e.a);
   fb(ok,e);body.querySelectorAll('button:not(.lsn)').forEach(b=>b.disabled=true);
   if(o.timed){okb.classList.add('hidden');setTimeout(()=>res(ok),ok?900:1900)}else{okb.classList.remove('hidden');okb.disabled=false;okb.textContent='Continuer ▶';okb.onclick=()=>{sfx('tap');res(ok)};
    /* le bouton reste visible même quand l'explication est longue, et toucher l'explication fait aussi continuer */
    okb.style.position='sticky';okb.style.bottom='6px';okb.style.zIndex='5';setTimeout(()=>{try{okb.scrollIntoView({block:'end',behavior:'smooth'})}catch(x){}},60);
    $('#xFb').onclick=ev=>{if(ev.target.closest('.rp'))return say(e.listen?e.snd:jpText(full(e)));if(!okb.disabled){sfx('tap');res(ok)}}}};
  if(o.timed){const bar=tm.firstElementChild,t0=performance.now();bar.style.width='100%';tmr=setInterval(()=>{const p=1-(performance.now()-t0)/o.timed;bar.style.width=Math.max(0,p*100)+'%';if(p<=0)end(false)},50)}
  if(e.q==='ord'){q.innerHTML=(o.head||'')+(e.listen?'Écoute et reconstruis la phrase :':'Remets les mots dans l\'ordre :');const toks=shuf(e.t.concat(e.x||[]));let pickd=[];
   body.innerHTML=`${e.listen?LIS:`<div class="exfr card">${esc(e.fr)}</div>`}<div class="slots" id="xS"></div><div class="tiles" id="xT">${toks.map((t,i)=>`<button class="tile" data-i="${i}">${rubyTok(t)}</button>`).join('')}</div>`;
   const sl=$('#xS'),ti=$('#xT'),ren=()=>{sl.innerHTML=pickd.map(i=>`<button class="tile" data-i="${i}">${rubyTok(toks[i])}</button>`).join('');ti.querySelectorAll('.tile').forEach(b=>b.classList.toggle('used',pickd.includes(+b.dataset.i)));okb.disabled=!pickd.length};
   ti.onclick=ev=>{const b=ev.target.closest('.tile');if(!b||done||early())return;sfx('tap');pickd.push(+b.dataset.i);if(!e.listen)say(tk(toks[+b.dataset.i])[1]);ren()};
   sl.onclick=ev=>{const b=ev.target.closest('.tile');if(!b||done)return;sfx('back');pickd=pickd.filter(i=>i!==+b.dataset.i);ren()};
   okb.classList.remove('hidden');okb.textContent='Valider';okb.disabled=true;okb.onclick=()=>{e._ans=pickd.map(i=>toks[i]);const ans=pickd.map(i=>tk(toks[i])[0]).join(''),good=[jpText(e.t)].concat(e.alt||[]);end(good.includes(ans))};Ex.auto=()=>{pickd=[];e.t.forEach(t=>{const i=toks.findIndex((x,k)=>x===t&&!pickd.includes(k));pickd.push(i)});ren();okb.onclick()}}
  else{const opts=shuf(e.o),txt=e.o.some(x=>x.length>9);okb.classList.add('hidden');
   if(e.q==='gap'){q.innerHTML=(o.head||'')+'Complète la phrase :';body.innerHTML=`<div class="exjp card">${e.t.map(x=>x==='＿'?'<span style="display:inline-block;min-width:44px;border-bottom:3px solid #d84a4a;color:#d84a4a">？</span>':rubyTok(x)).join('')}</div><div class="exfr" style="font-size:15px;color:#cdd3e8">${esc(e.fr||'')}</div>`}
   else{q.innerHTML=(o.head||'')+esc(e.p);body.innerHTML=e.listen?LIS:e.t?`<div class="exjp card" style="position:relative">${jpHtml(e.t)}<button class="spk lsn" id="xRp" aria-label="Réécouter" style="position:absolute;right:6px;bottom:6px">🔊</button></div>`:e.big?`<div class="exjp card" style="font-size:54px;line-height:1.3">${esc(e.big)}</div>`:'';if(e.t&&!o.timed&&!e.listen)say(jpText(e.t));{const rb=$('#xRp');if(rb)rb.onclick=()=>say(jpText(e.t))}}
   body.insertAdjacentHTML('beforeend',`<div class="opts ${txt?'':'two'}">${opts.map(x=>`<button class="btn ${txt?'txt':''} ${/[ぁ-んァ-ン]/.test(x)?'jpo':''} ${x.length===1?'big':''}" data-v="${esc(x)}">${esc(x)}</button>`).join('')}</div>`);
   body.querySelector('.opts').onclick=ev=>{const b=ev.target.closest('button');if(!b||done||early())return;const ok=b.dataset.v===e.a;body.querySelectorAll('.opts button').forEach(x=>{if(x.dataset.v===e.a)x.classList.add('ok')});if(!ok)b.classList.add('ko');end(ok)};
   Ex.auto=ok=>{const bs=[...body.querySelectorAll('.opts button')];(bs.find(b=>(b.dataset.v===e.a)===(ok!==false))||bs[0]).click()}}
  if(e.listen){$('#xPl').onclick=()=>say(e.snd);$('#xSl').onclick=()=>say(e.snd,.55);setTimeout(()=>{if(!done)say(e.snd)},350)}})}
 /* question de kanji pour les parades */
 function kanjiQ(){const pool=SP.filter(unl),t=pick(pool),oth=shuf(pool.filter(s=>s!==t)).slice(0,3),fr=s=>s.fr.split(',')[0],ty=rnd(3);
  if(ty===0)return{q:'mcq',p:`Quel kanji veut dire « ${fr(t)} » ?`,a:t.k,o:[t.k,...oth.map(s=>s.k)],why:`${t.k} se lit ${t.kun}.`};
  if(ty===1)return{q:'mcq',p:'Que signifie ce kanji ?',big:t.k,a:fr(t),o:[fr(t),...oth.map(fr)],why:`${t.k} (${t.kun}) = ${t.fr}.`};
  return{q:'mcq',p:'Comment se lit ce kanji ?',big:t.k,a:t.kun,o:[t.kun,...oth.map(s=>s.kun)],why:`${t.k} = ${t.fr}.`}}
 return{run,kanjiQ}})();

/* ---------- oral : écoute (TTS) et prononciation (micro ou auto-évaluation) ---------- */
const Oral=(()=>{
 const PAIRS=window.ORALP=[['おばさん','tante','おばあさん','grand-mère'],['おじさん','oncle','おじいさん','grand-père'],['きて','viens','きって','timbre'],['びょういん','hôpital','びよういん','salon de coiffure'],['ゆき','neige','ゆうき','courage'],['さか','pente','さっか','écrivain'],['くき','tige','くうき','air'],['いえ','maison','いいえ','non'],['ここ','ici','こうこう','lycée'],['おと','son, bruit','おっと','mari'],['にし','ouest','にっし','journal de bord'],['かこ','passé','かっこ','parenthèse'],['とり','oiseau','とおり','rue'],['まち','ville','マッチ','allumette'],['すき','aimer','スキー','ski'],['ビル','immeuble','ビール','bière'],['かた','épaule','かった','a gagné'],['せかい','monde','せいかい','bonne réponse']];
 const PUN=/^[。、！？!?…「」]+$/;
 const st=()=>S.ear||(S.ear={l:0,lo:0,p:0,po:0});
 const clean=t=>t.filter(x=>!PUN.test(x));
 function pool(){let ks=Object.keys(S.ph).filter(k=>PHR[k]);if(ks.length<6)ks=ks.concat(Object.keys(PHR).filter(k=>PHR[k].src==='l1'&&!ks.includes(k)));return ks.map(k=>PHR[k]).filter(p=>{const n=clean(p.t).length;return n>=2&&n<=9})}
 const show=p=>`<span class="jp">${jpHtml(p.t)}</span><i style="font-size:12px;opacity:.85">${esc(jpKana(p.t))}${S.roma?' · '+esc(romaji(p.t)):''}</i><br>${esc(p.fr)}`;
 /* fabrique une question d'écoute. kind : 'pair' | 'mix' */
 function q(kind){if(!S.snd)return null;const r=kind==='pair'?0:Math.random();
  if(r<.3){const p=pick(PAIRS),a=rnd(2)*2;return{q:'mcq',listen:1,snd:p[a],p:'Écoute bien : quel mot entends-tu ?',a:p[a],o:[p[0],p[2]],show:`<span class="jp">${esc(p[a])}</span>= ${esc(p[a+1])}<br><span style="opacity:.85">${esc(p[2-a])} = ${esc(p[3-a])}. Un son long ou doublé change le mot.</span>`}}
  const ps=pool();if(ps.length<3)return null;const p=pick(ps),c=clean(p.t);
  if(r<.68||c.length<3||c.length>7){const oth=shuf(Object.values(PHR).filter(x=>x.fr!==p.fr)).slice(0,2).map(x=>x.fr);return{q:'mcq',listen:1,snd:jpText(p.t),p:'Écoute : que veut dire cette phrase ?',a:p.fr,o:[p.fr,...oth],show:show(p)}}
  const ot=pick(ps.filter(x=>x!==p)),xt=clean(ot.t).filter(x=>!c.includes(x));
  return{q:'ord',listen:1,snd:jpText(p.t),t:c,fr:p.fr,x:xt.length?[pick(xt)]:[],show:show(p)}}
 /* --- prononciation --- */
 const SR=window.SpeechRecognition||window.webkitSpeechRecognition;let nomic=!SR;
 const norm=s=>String(s).replace(/[ァ-ヶ]/g,c=>String.fromCharCode(c.charCodeAt(0)-96)).replace(/[\s。、！？!?,.・「」…ー]/g,'');
 function sim(a,b){a=norm(a);b=norm(b);if(!a||!b)return 0;const m=a.length,n=b.length;let pr=[];for(let j=0;j<=n;j++)pr[j]=j;for(let i=1;i<=m;i++){const cu=[i];for(let j=1;j<=n;j++)cu[j]=Math.min(pr[j]+1,cu[j-1]+1,pr[j-1]+(a[i-1]===b[j-1]?0:1));pr=cu}return 1-pr[n]/Math.max(m,n)}
 function speak(p,o){o=o||{};return new Promise(res=>{UI.panel('ex');const body=$('#xBody'),okb=$('#xOk'),fbx=$('#xFb'),qb=$('#xQuit');$('#xTm').classList.add('hidden');fbx.className='';fbx.innerHTML='';
  const txt=jpText(p.t);let tries=0,best=-1,rec=null,done=false;qb.classList.toggle('hidden',!o.quit);qb.onclick=()=>{done=true;try{rec&&rec.abort()}catch(x){}sfx('back');res('quit')};
  $('#xQ').innerHTML=(o.head||'')+'Lis cette phrase à voix haute :';
  body.innerHTML=`<div class="exjp card">${jpHtml(p.t)}<div style="font-size:15px;color:var(--sub);line-height:1.4">${esc(jpKana(p.t))}</div><div style="font-size:14px;color:var(--cy);line-height:1.4">${esc(romaji(p.t))}</div><div style="font-size:14px;line-height:1.4">${esc(p.fr)}</div></div><div class="lis"><button class="btn lsn" id="xPl">🔊 Écouter</button><button class="btn lsn" id="xSl">🐢 Lent</button></div><div id="spZone"></div>`;
  $('#xPl').onclick=()=>say(txt);$('#xSl').onclick=()=>say(txt,.55);setTimeout(()=>say(txt),350);
  const fin=gr=>{if(done)return;done=true;const e=st();e.p++;if(gr>0)e.po++;(S.pr||(S.pr={}))[txt]=Math.max(S.pr[txt]||0,gr);sfx(gr?'ok':'bad');okb.classList.remove('hidden');okb.disabled=false;okb.textContent='Continuer ▶';okb.onclick=()=>{sfx('tap');res(gr)}};
  const z=$('#spZone');okb.classList.add('hidden');
  function self(why){z.innerHTML=`<p style="font-size:13px;color:var(--sub);margin:0 0 6px">${why||''}Écoute, répète à voix haute deux ou trois fois, puis évalue-toi honnêtement.</p><div class="opts" style="grid-template-columns:1fr 1fr 1fr"><button class="btn" data-g="0">× Raté</button><button class="btn" data-g="1">△ Moyen</button><button class="btn" data-g="2">○ Bien</button></div>`;
   z.querySelector('.opts').onclick=ev=>{const b=ev.target.closest('button');if(!b||done)return;z.querySelectorAll('button').forEach(x=>x.disabled=true);b.classList.add(+b.dataset.g?'ok':'ko');fbx.className='fb '+(+b.dataset.g?'ok':'ko');fbx.innerHTML=+b.dataset.g?'<b>○ いいね！</b> Bien joué.':'<b>× もういちど</b> Réécoute-la lentement, elle reviendra.';fin(+b.dataset.g)}}
  function mic(){z.innerHTML=`<button class="btn pri" id="spMic" style="width:100%;font-size:20px">🎤 Parler</button><button class="qt" id="spNo" style="align-self:center;margin-top:6px">Sans micro</button>`;
   $('#spNo').onclick=()=>self();
   $('#spMic').onclick=()=>{if(done)return;const b=$('#spMic');try{speechSynthesis.cancel()}catch(x){}let got=false;
    try{rec=new SR();rec.lang='ja-JP';rec.maxAlternatives=5;rec.interimResults=false}catch(x){nomic=true;return self('Le micro n\'est pas disponible ici. ')}
    b.disabled=true;b.textContent='● Je t\'écoute…';const stop=setTimeout(()=>{try{rec.stop()}catch(x){}},8000);
    rec.onresult=ev=>{got=true;let bs=0,heard='';for(const a of ev.results[0]){const s=Math.max(sim(a.transcript,txt),sim(a.transcript,jpKana(p.t)));if(s>=bs){bs=s;heard=a.transcript}}tries++;best=Math.max(best,bs);
     const gr=bs>=.8?2:bs>=.55?1:0;fbx.className='fb '+(gr?'ok':'ko');fbx.innerHTML=(gr===2?'<b>○ かんぺき！</b> Très clair.':gr?'<b>△ おしい！</b> Presque, on te comprend.':'<b>× もういちど</b> Ce n\'est pas encore ça.')+`<br>J'ai entendu : <span class="jp" style="font-size:18px">${esc(heard)}</span>`;
     if(gr===2||tries>=3)fin(best>=.8?2:best>=.55?1:0)};
    rec.onerror=ev=>{if(['not-allowed','service-not-allowed','audio-capture','language-not-supported','network'].includes(ev.error)){got=true;nomic=true;self('Le micro n\'est pas disponible ici. ')}};
    rec.onend=()=>{clearTimeout(stop);if(done||nomic)return;b.disabled=false;b.textContent=tries?'🎤 Réessayer':'🎤 Parler';if(!got){fbx.className='fb ko';fbx.innerHTML='Je n\'ai rien entendu. Parle un peu plus fort, tout près du téléphone.'}};
    try{rec.start()}catch(x){nomic=true;self('Le micro n\'est pas disponible ici. ')}}}
  nomic?self():mic();
  Oral.auto=gr=>{self();z.querySelector(`[data-g="${gr==null?2:gr}"]`).click()}})}
 /* séance de 5 questions depuis le menu */
 async function session(kind){let good=0,n=0;const N=5,used=[];
  for(let i=0;i<N;i++){let r;
   if(kind==='speak'){const ps=pool().filter(p=>!used.includes(p));if(!ps.length)break;const p=pick(ps);used.push(p);r=await speak(p,{quit:1,head:`<b>発音 ${i+1}/${N}</b> · `});if(r==='quit')break;n++;if(r>0)good++}
   else{let e=null;for(let k=0;k<6;k++){e=q(kind);if(e&&!used.includes(e.snd))break}if(!e)break;used.push(e.snd);r=await Ex.run(e,{quit:1,head:`<b>耳 ${i+1}/${N}</b> · `});if(r==='quit')break;n++;const s=st();s.l++;if(r){s.lo++;good++}}}
  if(n){Quest.add('dojo');S.xp+=good;save();sfx(good>=n-1?'lvl':'ok');UI.toast(`${good} / ${n} · +${good} XP`,2600)}return{good,n}}
 return{q,speak,session,st,get mic(){return !nomic}}})();

/* ---------- parcours par thèmes (lié aux lieux) + défis quotidiens ---------- */
const cap=s=>s.charAt(0).toUpperCase()+s.slice(1);
THEMES.forEach(T=>T.k.forEach(q=>{const o=SP.find(s=>s.k===q.k);if(o){o.th=T.id;o.w=q.w;o.wf=q.wf}else SP.push({k:q.k,on:q.on,kun:q.kun,fr:q.fr,name:cap(q.fr.split(',')[0]),s:q.s,neu:1,th:T.id,w:q.w,wf:q.wf})}));
const PLACES=['Maître Genzō, au dojo du village','le dojo des mots du Hameau des bambous','le dojo des mots du Quartier des ouvriers','le dojo des mots du Quartier des fumées','le dojo des mots du Hameau des cendres','le dojo des mots du col des Brumes','le dojo des mots du Relais de la Grand-Route','le dojo des mots du Bourg des passeurs','la forge de la ville basse de Kurogane','la forge de l\'Académie des sceaux','la forge de Hagane, aux Grandes Forges','la forge du port des dirigeables','la forge de la forêt des renards','l\'atelier de Hagane, chez les horlogers','la forge de la croisée des quatre vents','l\'armurerie de la citadelle'];
const Quest=(()=>{
 const day=d=>d.toLocaleDateString('sv'),today=()=>day(new Date());
 const DEF={rev:['Fais ta révision du jour',1],trace:['Trace 3 kanji',3],ans:['Réussis 8 questions',8],win:['Gagne 1 combat',1],dojo:['Termine un entraînement (dojo ou oral)',1],ear:['Réussis 3 questions d\'écoute',3],chat:['Joue 2 fois à l’entraînement de Kage',2]};
 function roll(){const d=today();if(S.dq&&S.dq.d===d)return S.dq;let n=7;for(const c of d)n=(n*31+c.charCodeAt(0))>>>0;S.dq={d,q:[{k:Review.count()>0?'rev':'trace',n:0},{k:'ans',n:0},{k:['win','dojo','ear','chat'][n%4],n:0}],done:0};return S.dq}
 function streak(){const s=S.streak;if(!s)return 0;return s.last===today()||s.last===day(new Date(Date.now()-864e5))?s.n:0}
 function add(k,n){const q=roll(),it=q.q.find(x=>x.k===k);if(!it||it.n>=DEF[k][1])return;it.n=Math.min(DEF[k][1],it.n+(n||1));
  if(it.n>=DEF[k][1]&&!q.q.every(x=>x.n>=DEF[x.k][1])){UI.toast(`Défi réussi : ${DEF[k][0]} ✓`);sfx('item')}
  if(!q.done&&q.q.every(x=>x.n>=DEF[x.k][1])){q.done=1;const st=streak();S.streak={n:(S.streak&&S.streak.last!==q.d?st:0)+1,last:q.d};S.xp+=15;S.it.oni=(S.it.oni||0)+1;
   setTimeout(()=>{UI.toast(`Les 3 défis du jour sont réussis ! +15 XP, +1 onigiri · série de ${S.streak.n} jour${S.streak.n>1?'s':''}`,4500);sfx('lvl');if(UI.cur==='pad')UI.stat()},900)}
  save()}
 return{roll,add,streak,DEF,get count(){const q=roll();return q.q.filter(x=>x.n>=DEF[x.k][1]).length}}})();
const Path=(()=>{
 const lvl=id=>(S.th||(S.th={}))[id]||0,stars=id=>'★'.repeat(lvl(id))+'☆'.repeat(3-lvl(id));
 const open=i=>i===0||lvl(THEMES[i-1].id)>=1;
 const f1=q=>q.fr.split(',')[0],PUN=/^[。、！？!?…「」]+$/,clean=t=>t.filter(x=>!PUN.test(x));
 const oth=(T,q,f)=>shuf(T.k.filter(x=>x!==q)).slice(0,3).map(f);
 function qRec(T,q,ty){
  if(ty===0)return{q:'mcq',p:'Que signifie ce kanji ?',big:q.k,a:f1(q),o:[f1(q),...oth(T,q,f1)],why:`${q.k} se lit ${q.kun} (${q.on}).`};
  if(ty===1)return{q:'mcq',p:`Quel kanji veut dire « ${f1(q)} » ?`,a:q.k,o:[q.k,...oth(T,q,x=>x.k)],why:`${q.k} = ${q.fr}.`};
  if(ty===2)return{q:'mcq',p:'Comment se lit ce kanji ?',big:q.k,a:q.kun,o:[q.kun,...oth(T,q,x=>x.kun)],why:`${q.k} = ${q.fr}. Lecture on : ${q.on}.`};
  if(ty===3)return{q:'mcq',p:'Que veut dire ce mot ?',t:[q.w],a:q.wf,o:[q.wf,...oth(T,q,x=>x.wf)],why:`${tk(q.w)[0]} se lit ${tk(q.w)[1]}.`};
  return{q:'mcq',listen:1,snd:tk(q.w)[1],p:'Écoute : quel mot entends-tu ?',a:tk(q.w)[0],o:[tk(q.w)[0],...oth(T,q,x=>tk(x.w)[0])],show:`<span class="jp">${rubyTok(q.w)}</span>${esc(q.wf)}`}}
 const qOrd=(T,p)=>{const c=clean(p.t),o=pick(T.ph.filter(x=>x!==p)),xt=clean(o.t).filter(x=>!c.includes(x));return{q:'ord',t:c,fr:p.fr,x:xt.length?[pick(xt)]:[]}};
 const qLis=(T,p)=>({q:'mcq',listen:1,snd:jpText(p.t),p:'Écoute : que veut dire cette phrase ?',a:p.fr,o:[p.fr,...T.ph.filter(x=>x!==p).map(x=>x.fr)],show:`<span class="jp">${jpHtml(p.t)}</span>${esc(p.fr)}`});
 async function ask(e,i,n,T){const r=await Ex.run(e,{quit:1,head:`<b>${T.ic} ${i}/${n}</b> · `});return r}
 async function trace(k,aid){const sp=spK(k),r=await Trace.run(sp,aid!=null?{aid}:{});if(!r)return null;S.sp[k]=1;S.best[k]=Math.max(S.best[k]||0,r.stars);say(sp.kun);return r}
 /* une séance : renvoie {good,tot,up} ou null si le joueur quitte */
 async function run(T,n){const L=lvl(T.id);let good=0,tot=0,steps=[];
  if(L===0){
   for(const q of T.k){UI.panel('pad');if(window.KCARD&&KMEMO[q.k]){await KCARD(q);await D.say({n,jp:[q.k+'|'+q.kun],fr:cap(q.fr),x:`${q.s.length} trait${q.s.length>1?'s':''} · trace-le maintenant`})}else await D.say([{n,jp:[q.k+'|'+q.kun],fr:cap(q.fr),x:`Lecture on : ${q.on} · ${q.s.length} trait${q.s.length>1?'s':''}`},{n,jp:[q.w],fr:cap(q.wf),x:'Un mot courant avec ce kanji.'}]);
    const r=await trace(q.k,0);if(!r){UI.panel('pad');return null}tot++;if(r.stars>=2)good++;
    const a=await ask(qRec(T,q,0),tot,T.k.length,T);if(a==='quit'){UI.panel('pad');save();return null}}
   S.th[T.id]=1;S.xp+=good+10;save();UI.panel('pad');return{good,tot,up:1}}
  if(L===1){const ks=shuf(T.k);for(let i=0;i<8;i++)steps.push(qRec(T,ks[i%5],[0,2,3,1,4,3,2,4][i]))}
  else if(L===2){const ph=shuf(T.ph);steps=[qOrd(T,ph[0]),qLis(T,ph[1]),{tr:pick(T.k).k},qOrd(T,ph[1]),qLis(T,ph[2]),qOrd(T,ph[2]),{tr:pick(T.k).k}]}
  else{const ks=shuf(T.k);for(let i=0;i<5;i++)steps.push(qRec(T,ks[i],rnd(5)));steps.push(qOrd(T,pick(T.ph)));steps.push({tr:pick(T.k).k})}
  for(const st of steps){tot++;if(st.tr){const r=await trace(st.tr);if(!r){UI.panel('pad');return null}if(r.stars>=2)good++}else{const r=await ask(st,tot,steps.length,T);if(r==='quit'){UI.panel('pad');save();return null}if(r)good++}}
  const pass=good>=tot-(L===1?2:1),up=pass&&L<3;if(up){S.th[T.id]=L+1;if(L===2){T.ph.forEach(p=>{phrAdd(p.t,p.fr,T.id);S.ph[jpText(p.t)]=1});S.it.oni=(S.it.oni||0)+1}}
  S.xp+=good+(up?10:0);save();UI.panel('pad');return{good,tot,up,pass}}
 /* menu des thèmes chez un maître. place : 0 = Genzō, 1 à 4 = hameaux */
 async function at(place,n){const here=THEMES.map((T,i)=>({T,i})).filter(x=>x.T.place===place),old=THEMES.filter((T,i)=>T.place<place&&lvl(T.id)>=1);
  const lab=x=>open(x.i)?`${x.T.ic} ${x.T.name} ${stars(x.T.id)}`:`🔒 ${x.T.name}`,opts=here.map(lab);if(old.length)opts.push('Réviser un ancien thème');opts.push('Rien, merci');
  const i=await D.ask({n,t:'Quel thème veux-tu travailler ?'},opts);let T=null;
  if(i<here.length){if(!open(here[i].i)){const pv=THEMES[here[i].i-1];await D.say({n,t:`Pas si vite. Découvre d'abord le thème « ${pv.name} »${pv.place!==place?' auprès de '+PLACES[pv.place]:''}.`});return}T=here[i].T}
  else if(old.length&&i===here.length)T=old.sort((a,b)=>lvl(a.id)-lvl(b.id)||Math.random()-.5)[0];
  if(!T)return;
  const L=lvl(T.id),old_=S.xp;await D.say({n,t:[`« ${T.name} » : cinq kanji à découvrir. Pour chacun, je te montre un mot, tu le traces, puis tu vérifies que tu l'as retenu.`,`« ${T.name} », niveau 2 : reconnaître. Huit questions sur le sens, la lecture et les mots.`,`« ${T.name} », niveau 3 : utiliser. Des phrases à construire et à comprendre à l'oreille, et deux tracés.`,`« ${T.name} » : une révision rapide pour garder la main.`][L]});
  if(G.scene==='lesson'&&Lesson.board)Lesson.board(T.k.map(k=>k.k).join(' '),T.name);
  const r=await run(T,n);if(!r){await D.say({n,t:'On s\'arrête là. Reviens quand tu veux, ce que tu as fait est gardé.'});return}
  Quest.add('dojo');
  await D.say({n,t:L===0?`Cinq nouveaux kanji ! Ils sont maintenant dans ta liste de sorts : tu peux les tracer en combat. +${r.good+10} XP.`:r.up?`${r.good} sur ${r.tot}. Niveau réussi : ${stars(T.id)} +${r.good+10} XP.${L===2?' Les phrases du thème sont dans ton carnet, et voici un onigiri.':''}`:L===3?`${r.good} sur ${r.tot}. +${r.good} XP.`:`${r.good} sur ${r.tot}. Il en faut un peu plus pour valider ce niveau. Retente quand tu veux. +${r.good} XP.`});
  await afterXp(old_)}
 function hint(){const i=THEMES.findIndex((T,k)=>open(k)&&lvl(T.id)<3&&T.place<PLACES.length);return i<0?null:THEMES[i]}
 return{at,run,lvl,stars,open,hint}})();

/* ---------- leçons : tableau noir en haut, cahier en bas ---------- */
const Lesson=(()=>{
 let L=null,phase='',ci=0;
 function bgk(){const w=L?L.who:'tanu',zz='kotoba tanu forg'.includes(w)&&typeof MAPS!=='undefined'?(W.map==='world'?W.zone():MAPS.world.zone((S.ret||{y:1e9}).y)):-1,ok=k=>XI[k]&&XI[k].width;
  const k=w==='forg'&&ok('X_LF'+zz)?'X_LF'+zz:w==='tanu'&&ok('X_LT'+zz)?'X_LT'+zz:zz>=19&&ok('X_L'+zz)?'X_L'+zz:'X_L'+(zz>=5&&zz<=18?zz-2:zz===3||zz===4?2:zz===2?1:w==='bozu'?1:'eng worker forg'.includes(w)?2:0);return{w,zz,k}}
 function board(b,s,sm){const e=$('#board');e.classList.remove('hidden');{const q=bgk(),r=typeof LBRD!=='undefined'&&LBRD[q.k];e.classList.toggle('b2',!r&&/X_L[3456]$/.test(q.k));
   ['left','top','width','height'].forEach((p,i)=>{e.style[p]=r?`calc(${r[i]}*var(--u))`:''});e.classList.toggle('b3',!!r)}e.classList.toggle('sm',!!sm);e.querySelector('b').innerHTML=b;e.querySelector('span').innerHTML=s||''}
 function stage(who){const prev=G.scene;L={who,fake:1};G.scene='lesson';$('#banner').classList.remove('on');$('#board').classList.add('hidden');return()=>{$('#board').classList.add('hidden');L=null;G.scene=prev}}
 function drawScene(t){ // salle de classe
  {const q=bgk(),w=q.w,zz=q.zz,bg=XI[q.k];if(bg&&bg.width){g.fillStyle='#000';g.fillRect(0,0,SW,SH);const hh=192,ww=bg.width*hh/bg.height;g.drawImage(bg,SW-ww,0,ww,hh);const hk=XI['C_'+w+zz+'_00'],hi=zz>=2&&hk&&hk.width?hk:XI['C_'+w+'_00'],bob=Math.floor(t*2)%4===0?1:0;if(hi&&hi.width){const h2=84,w2=hi.width*h2/hi.height;g.fillStyle='rgba(30,20,50,.3)';g.fillRect(34-w2*.35,160,w2*.7,4);g.drawImage(hi,34-w2/2,162-h2-bob,w2,h2)}return}}
  for(let y=0;y<SH;y+=T)for(let x=0;x<SW;x+=T)g.drawImage(y<112?wallFace(0):woodF(),x,y);
  g.fillStyle='#6a4a30';g.fillRect(0,0,SW,6);g.fillStyle='#4a3020';g.fillRect(0,6,SW,2);
  g.fillStyle='#5a3c22';g.fillRect(66,14,166,100);g.fillStyle='#8a6038';g.fillRect(68,16,162,96);g.fillStyle='#24503c';g.fillRect(72,20,154,86);g.fillStyle='#1c4030';g.fillRect(72,20,154,3);g.fillStyle='#2e6048';g.fillRect(72,103,154,3);
  g.fillStyle='#d8d0b8';g.fillRect(84,108,14,3);g.fillStyle='#e88a8a';g.fillRect(104,108,10,3);
  g.fillStyle='rgba(30,20,50,.3)';g.fillRect(12,148,44,5);{const hi=XI['C_'+(L?L.who:'tanu')+'_00'];if(hi&&hi.width){const hh=84,ww=hi.width*hh/hi.height;g.drawImage(hi,34-ww/2,152-hh,ww,hh)}}
  g.fillStyle='#7a5438';g.fillRect(90,150,120,10);g.fillStyle='#a07850';g.fillRect(90,150,120,3);g.fillStyle='#5a3c28';g.fillRect(94,160,6,22);g.fillRect(200,160,6,22);g.fillStyle='#f8f4e4';g.fillRect(132,144,30,8);g.fillStyle='#d84a4a';g.fillRect(166,146,10,3)}
 /* lecture guidée : particules en bleu, fins de phrase (verbe, です) en orange ; toucher une particule explique son rôle */
 const PG={'は':'は (wa) : le thème, « quant à… »','が':'が : le sujet, ce qui fait l\'action ou ce qui existe','を':'を (o) : l\'objet direct, ce qui subit l\'action','に':'に : le lieu où l\'on est, le moment, ou à qui l\'on donne','で':'で : le lieu où l\'action se passe, ou le moyen','へ':'へ (e) : la direction, « vers »','と':'と : « et » entre deux noms, ou « avec »','も':'も : « aussi », remplace は ou が','から':'から : « depuis », ou « parce que » après une phrase','まで':'まで : « jusqu\'à »','の':'の : relie deux noms, « de » (A の B = le B de A)','か':'か : en fin de phrase, la transforme en question','ね':'ね : « n\'est-ce pas ? », on cherche l\'accord','よ':'よ : « tu sais », on informe ou on insiste','より':'より : « que », dans une comparaison','や':'や : « et… entre autres »'};
 const END=/(です|でした|ます|ません|ました|ましょう|ませんか|ください|たい|ている|ています|じゃない|ではありません|だ)$/;
 function gram(t){return t.map(x=>{const k=tk(x)[0];if(PG[k])return `<span class="gp" data-g="${esc(PG[k])}">${rubyTok(x)}</span>`;if(END.test(k)&&/[ぁ-ん]$/.test(k))return `<span class="gv">${rubyTok(x)}</span>`;return rubyTok(x)}).join('')}
 const LEG='<div class="glg"><span class="gp">particule</span> <span class="gv">fin de phrase / verbe</span> <small>Touche une particule bleue pour son rôle.</small></div>';
 function card(){const c=L.cards[ci];$('#lT').textContent=`${L.title} — ${ci+1}/${L.cards.length}`;$('#lDots').innerHTML=L.cards.map((_,i)=>`<i class="${i<=ci?'on':''}"></i>`).join('');
  board(esc(c.f),esc(c.h),c.f.length>16);
  $('#lCard').innerHTML=`<h3>${esc(c.h)}</h3><div class="f">${esc(c.f)}</div><p>${c.x}</p>`+(c.ex.length?LEG:'')+c.ex.map((e,i)=>`<div class="exl"><div class="t"><div class="jp">${gram(e.t)}</div>${S.roma?`<div class="ro">${esc(romaji(e.t.filter(x=>x!=='→')))}</div>`:''}<div class="fr">${esc(e.fr)}</div></div><button class="spk" data-i="${i}" aria-label="Écouter">🔊</button></div>`).join('');
  $('#lCard').scrollTop=0;$('#lCard').onclick=e=>{const gp=e.target.closest('.gp[data-g]');if(gp){UI.toast(gp.dataset.g,3200);return}const b=e.target.closest('.spk');if(b){const ex=c.ex[+b.dataset.i];say(jpText(ex.t.includes('→')?ex.t.slice(ex.t.indexOf('→')+1):ex.t))}};
  $('#lPrev').disabled=ci===0;$('#lNext').textContent=ci===L.cards.length-1?'Aux exercices ▶':'Suivant ▶'}
 function run(id,o){o=o||{};return new Promise(async res=>{L=LES(id);if(L.cards.length>1&&!L._rc){L=Object.assign({},L,{_rc:1,cards:L.cards.concat([{h:'À retenir',f:'まとめ',x:'<ul class="rcp">'+L.cards.map(c=>`<li><b>${esc(c.f)}</b> — ${esc(c.h)}</li>`).join('')+'</ul>Relis ces formules une dernière fois : les exercices arrivent.',ex:[]}])})}const prev=G.scene,pm=MUS.name;await UI.fade(1,180);D.hide();G.scene='lesson';music('lesson');$('#banner').classList.remove('on');phase='cards';ci=0;UI.panel('les');card();await UI.fade(0,180);
  const quit=async ok=>{$('#board').classList.add('hidden');await UI.fade(1,180);G.scene=prev;music(pm);L=null;await UI.fade(0,180);res(ok)};
  $('#lQuit').onclick=()=>{sfx('back');quit(false)};
  $('#lPrev').onclick=()=>{if(ci===0)return;sfx('back');ci--;card()};
  $('#lNext').onclick=async()=>{sfx('sel');if(ci<L.cards.length-1){ci++;card();return}
   // exercices : les erreurs reviennent une fois
   let queue=shuf(L.ex).slice(0,o.short?4:L.ex.length),n=0,total=queue.length,good=0;const retried={},need=Math.ceil(queue.length*.7),hd=()=>`<b>${esc(L.title)}</b> · <span style="color:${good>=need?'#7fe0a0':'#f0cf7a'}">${good>=need?'✓ objectif atteint':'objectif'} ${good}/${need}</span> · `;
   while(queue.length){const e=queue.shift();n++;board('れんしゅう',`Exercice ${Math.min(n,total)} sur ${total}`);const ok=await Ex.run(e,{head:hd(),quit:1});if(ok==='quit')return quit(false);if(ok)good++;else if(!retried[e.id]){retried[e.id]=1;queue.push(e);total++}}
   const first=!S.les[id];S.les[id]=1;L.cards.forEach(c=>c.ex.forEach(e=>{if(!e.t.includes('→'))S.ph[jpText(e.t)]=1}));
   const met=good>=need;let xp=(first?L.xp:5)+(met?5:0);S.xp+=xp;save();sfx(met?'lvl':'ok');board(met?'よくできました！':'もう少し！',`${good} bonnes réponses · objectif ${need} · +${xp} XP`);
   UI.panel('pad');await D.say(met?[{n:NPN[L.who],jp:['よく','できました','！'],fr:`Très bien ! ${good} sur ${need} demandées : objectif atteint.`}]:[{n:NPN[L.who],jp:['もう','少し|すこし','！'],fr:`Presque ! ${good} sur ${need}. La leçon est notée ; reviens la revoir depuis le menu Révision pour atteindre l'objectif.`}],{nolearn:1});
   quit(true)}})}
 return{run,drawScene,stage,board}})();

const LBRD={"X_LT2": [104.0, 33.8, 99.4, 62.9], "X_LT3": [101.3, 39.2, 88.1, 60.0], "X_LT5": [104.2, 29.3, 108.9, 62.0], "X_LT6": [100.8, 50.2, 109.6, 60.2], "X_LT7": [112.1, 41.9, 93.1, 56.2], "X_LT8": [116.8, 19.6, 95.8, 64.3], "X_LF2": [74.6, 29.9, 103.7, 56.4], "X_LF3": [91.6, 32.2, 90.4, 54.1], "X_LF5": [71.9, 50.2, 100.8, 53.0], "X_LF6": [72.2, 48.4, 107.8, 56.6], "X_LF7": [77.8, 52.7, 100.1, 53.0], "X_LF8": [80.1, 45.5, 95.6, 61.1], "X_LT9": [129.5, 51.4, 102.0, 70.7], "X_LF9": [101.0, 64.3, 87.4, 48.9], "X_L7": [125.0, 46.1, 119.0, 79.3], "X_LT10": [121.6, 43.3, 91.5, 60.0], "X_LF10": [79.5, 38.0, 82.5, 46.0], "X_L8": [117.0, 49.5, 104.0, 59.0], "X_LT11": [117.9, 49.3, 86.8, 57.9], "X_LF11": [92.2, 46.0, 83.6, 52.5], "X_L9": [113.6, 50.4, 114.6, 61.0], "X_LT4": [101.3, 39.2, 88.1, 60.0], "X_LF4": [91.6, 32.2, 90.4, 54.1]};

/* ---------- combat façon GBA ---------- */
const Battle=(()=>{
 let B=null;
 const BG=[['#b8e0f0','#98d090','#78b870','#e8f0c8'],['#b8e0f0','#98d090','#78b870','#e8f0c8'],['#a8d0c8','#5a9a68','#3e7a50','#c8e0b8'],['#a8a8c0','#8088a0','#606880','#c8c8d8'],['#a8a8c0','#8088a0','#606880','#c8c8d8'],['#583040','#7a4850','#5a3440','#e88848']];
 function drawScene(t){if(!B)return;const c=BG[B.zone]||BG[1];
  g.fillStyle=c[0];g.fillRect(0,0,SW,SH);for(let y=0;y<70;y+=6){g.fillStyle=y%12?'rgba(255,255,255,.14)':'rgba(255,255,255,.05)';g.fillRect(0,y,SW,3)}
  g.fillStyle=c[1];g.fillRect(0,66,SW,SH-66);for(let y=70;y<SH;y+=8){g.fillStyle=y%16?c[2]:'rgba(0,0,0,.05)';g.fillRect(0,y,SW,2)}
  const plat=(x,y,rx,ry)=>{g.fillStyle=c[2];for(let j=-ry;j<=ry;j++){const w=Math.round(rx*Math.sqrt(1-j*j/(ry*ry)));g.fillRect(x-w,y+j,w*2,1)}g.fillStyle=c[3];for(let j=-ry+2;j<=ry-3;j++){const w=Math.round((rx-4)*Math.sqrt(1-j*j/((ry-2)*(ry-2))));g.fillRect(x-w,y+j-1,w*2,1)}};
  plat(184+Math.round(B.ex),84,46,11);plat(62+Math.round(B.mx),136,62,12);
  // ennemi
  const es=B.espr,eh=es.height,ew=es.width,ebx=184-Math.round(ew/2)+Math.round(B.ex+B.lunge),eby=88-eh+Math.round(Math.sin(t*2.4)*1.5);
  if(B.faint<1&&!(B.flashE>0&&Math.floor(t*20)%2)){const vis=Math.round(eh*(1-B.faint));if(vis>0)g.drawImage(es,0,0,ew,vis,ebx,eby+(eh-vis),ew,vis)}
  // héros de dos
  const hs=bspr('back',Math.min(2,stage(S.xp)));if(!(B.flashM>0&&Math.floor(t*20)%2))g.drawImage(hs,62-36+Math.round(B.mx+B.mlunge),140-64+(B.down?Math.round(B.down*70):0));
  // effets
  B.fx=B.fx.filter(p=>{p.t+=1/60;if(p.t>p.life)return false;p.x+=p.vx;p.y+=p.vy;p.vy+=p.g||0;g.globalAlpha=Math.min(1,(p.life-p.t)*4);g.fillStyle=p.c;const s=Math.max(1,Math.round(p.s*(p.grow?1+p.t*p.grow:1)));
   if(p.line){g.fillRect(Math.round(p.x),Math.round(p.y),p.line,2)}else g.fillRect(Math.round(p.x-s/2),Math.round(p.y-s/2),s,s);g.globalAlpha=1;return true});
  if(B.white>0){g.fillStyle=`rgba(255,255,255,${B.white})`;g.fillRect(0,0,SW,SH);B.white-=.08}
  if(B.flashE>0)B.flashE-=1/60;if(B.flashM>0)B.flashM-=1/60;
  // barres de PV animées
  B.eShow+=(B.ehp-B.eShow)*.14;if(Math.abs(B.ehp-B.eShow)<.3)B.eShow=B.ehp;B.mShow+=(S.hp-B.mShow)*.14;if(Math.abs(S.hp-B.mShow)<.3)B.mShow=S.hp;hp()}
 function hp(){const pe=B.eShow/B.e.hp,mx=maxHp(),pm=B.mShow/mx,cl=p=>p>.5?'':p>.2?'mid':'low';const e=$('#eHp'),m=$('#mHp');e.style.width=pe*100+'%';e.className=cl(pe);m.style.width=pm*100+'%';m.className=cl(pm);$('#mHpN').textContent=Math.round(B.mShow)+' / '+mx}
 const tween=(ms,fn)=>new Promise(r=>{const t0=performance.now();const f=()=>{const p=Math.min(1,(performance.now()-t0)/ms);fn(p);p<1?requestAnimationFrame(f):r()};f()});
 const msg=(t,o)=>D.say(t,Object.assign({panel:false,auto:850,keep:1},o));
 const jl=(jp,fr)=>({jp,fr});
 function info(){const e=B.e,known=S.wins[e.id]||S.fl['w_'+e.id]||e.wild;$('#bInfo').innerHTML=`<b>${esc(e.n)}</b> — ${esc(e.clue||'')}<br><small>${e.trait&&TRAITS[e.trait]?'<b style="color:#58e0ec">'+esc(TRAITS[e.trait][0])+'</b> · '+esc(TRAITS[e.trait][1]):'Les kanji « à réviser » frappent plus fort, et moins tu as d\'aide au tracé, plus le coup porte.'}</small>`}
 function menu(){return new Promise(res=>{UI.panel('bat');info();$('#bCmd').classList.remove('hidden');$('#bList').classList.add('hidden');$('#bBack').classList.add('hidden');
  $('#bCmd').querySelector('[data-c=phrase]').classList.toggle('off',(!window.PRO&&!lessonsDone().length)||B.phCd>0);$('#bCmd').querySelector('[data-c=listen]').classList.toggle('off',B.liCd>0||!!window.PRO);
  const t0=performance.now();$('#bCmd').style.opacity=.55;setTimeout(()=>{$('#bCmd').style.opacity=''},450);$('#bCmd').onclick=e=>{const b=e.target.closest('button');if(!b||performance.now()-t0<450)return;sfx('sel');res(b.dataset.c)}})}
 function list(html){return new Promise(res=>{$('#bCmd').classList.add('hidden');const l=$('#bList');l.classList.remove('hidden');l.innerHTML=html;$('#bBack').classList.remove('hidden');
  const t0=performance.now();l.onclick=e=>{const b=e.target.closest('button');if(!b||b.classList.contains('lock')||performance.now()-t0<400)return;sfx('sel');res(b.dataset.k)};$('#bBack').onclick=()=>{sfx('back');res(null)}})}
 const spellList=()=>{if(window.PRO&&window.PROK){if(B.prohT!==B.turn||!B.proh){const kk=PROK.known().filter(q=>[...q].length===1&&KANA[q]&&!B.cool[q]);B.proh=shuf(kk).slice(0,6).map(q=>({k:q,name:PROK.readOf(q),fr:PROK.kat(q)?'katakana':'hiragana',kun:q,on:q,s:KANA[q]}));B.prohT=B.turn}return list(B.proh.map((sp,i)=>`<button class="btn sp" data-k="${i}"><span class="k" style="color:#58e0ec">${sp.k}</span><span class="d"><b>${esc(sp.name)}</b><span class="ty" style="background:#3a4a78">${sp.fr}</span> <i>${starsTxt(S.best[sp.k]||0)}</i></span></button>`).join(''))}B.hand=B.hand||battleHand(B.cool);return list(B.hand.map(sp=>{const due=Review.kDue(sp.k),el=elem(sp.k);return `<button class="btn sp" data-k="${SP.indexOf(sp)}"><span class="k" style="color:${el[1]}">${sp.k}</span><span class="d"><b>${esc(sp.name)} · ${esc(sp.kun)}</b><span class="ty" style="background:${due?'#c8901c':'#3a4a78'}">${due?'à réviser ×1,5':AIDN[aidOf(sp.k)]}</span> <i>${starsTxt(S.best[sp.k]||0)}</i></span></button>`}).join(''))};
 const itemList=()=>list(Object.keys(IT).filter(k=>!IT[k].map&&(S.it[k]>0||k==='oni'||k==='cha')).map(k=>`<button class="btn sp ${S.it[k]>0?'':'lock'}" data-k="${k}"><span class="k"><img class="ic big" src="${IM['I_'+k.toUpperCase()]||IM.I_ONI}" alt=""></span><span class="d"><b>${jpHtml(IT[k].t)} ×${S.it[k]||0}</b>${esc(IT[k].d)}</span></button>`).join(''));
 /* effets visuels des sorts */
 const BSC={el:id=>$('#'+id),cls(id,c,ms){const e=$('#'+id);e.classList.remove(c);void e.offsetWidth;e.classList.add(c);if(ms)setTimeout(()=>e.classList.remove(c),ms)},
  async cut(sp){const c=$('#bsCut'),k=$('#bsKj');k.textContent=sp.k;k.style.color=elem(sp.k)[1];if(sp.im&&IM[sp.im]){c.src=IM[sp.im];BSC.cls('bsCut','go',1300)}BSC.cls('bsKj','go',1300);BSC.cls('bsFl','go',500);await wait(sp.im&&IM[sp.im]?1250:520)}};
 function spellFx(k){const X=184,Y=58,P=(n,f)=>{for(let i=0;i<n;i++)B.fx.push(Object.assign({t:0,life:.7,s:3,vx:0,vy:0},f(i)))};sfx('spell');
  if(k==='火')P(46,i=>({x:X-22+rnd(44),y:Y+26-rnd(8),vy:-1-Math.random()*1.4,vx:(Math.random()-.5)*.6,c:pick(['#f8a030','#e84820','#fff080']),s:3+rnd(4),life:.5+Math.random()*.5,t:-i*.012}));
  else if(k==='水')P(50,i=>({x:X-70+i*1.2,y:Y+10+Math.sin(i*.5)*10,vx:1.6,vy:(Math.random()-.5)*.8,c:pick(['#5a90f0','#a8c4ff','#fff']),s:3+rnd(3),life:.6,t:-i*.01}));
  else if(k==='木')P(36,i=>({x:X-26+rnd(52),y:Y+30,vy:-1.6-Math.random(),vx:(Math.random()-.5)*1.4,g:.06,c:pick(['#3e9444','#78d060','#a07040']),s:3+rnd(3),life:.8,t:-i*.015}));
  else if(k==='土'||k==='山')P(30,i=>({x:X-28+rnd(56),y:Y-60-rnd(30),vy:2.4+Math.random(),c:pick(k==='土'?['#a8743a','#c89858','#7a5028']:['#8a8aa0','#b0b0c8','#5a5a70']),s:5+rnd(5),life:.6,t:-i*.02}));
  else if(k==='風')P(22,i=>({x:X-70,y:Y-24+rnd(56),vx:5+Math.random()*2,vy:-.4,c:pick(['#e8ffff','#a8e8e0']),line:14+rnd(14),life:.5,t:-i*.03}));
  else if(k==='雷'){B.white=.9;let x=X,y=0;P(40,i=>{x+=rnd(11)-5;y+=3;return{x,y,c:i%2?'#fff080':'#fff',s:4,life:.35,t:-i*.004}});setTimeout(()=>{B.white=.7},160)}
  else P(26,i=>{const a=i/26*Math.PI*2;return{x:X,y:Y+6,vx:Math.cos(a)*2.4,vy:Math.sin(a)*2.4,c:pick(['#ffd84a','#fff']),s:4,life:.45}});
  return wait(k==='雷'?500:850)}
