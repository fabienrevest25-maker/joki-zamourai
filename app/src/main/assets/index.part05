const BCACHE={};
function bspr(k,a){const key=k+(a===undefined?'':a);return BCACHE[key]||(BCACHE[key]=BSPR[k](a))}

/* ---------- cartes ----------
 sol : . herbe  , fleurs  : sable  _ chemin  = dalles  w hautes herbes  M métal  | rails  a cendre  P ponton  v grille  s vapeur (rencontres)
 obstacles : T arbre  t cerisier  B bambou  ~ eau  r rizière  # mur  L lave  K falaise  k roche  F clôture  l lanterne  o rocher  b tonneau  c caisse  f fleurs  S panneau  J jizō  G barrière
 ^ rebord (on saute vers le sud)
 intérieurs : H mur  h cloison  R rouleau  q râtelier  u étagère  g forge  y comptoir  A enclume  p pot  z coussin  m tatami  n parquet  d paillasson  (espace) vide */
