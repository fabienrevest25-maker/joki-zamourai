 [['竹|たけ','bambou'],['森|もり','forêt'],['月|つき','lune'],['夜|よる','nuit'],['寺|てら','temple'],['道|みち','chemin'],['石|いし','pierre'],['池|いけ','étang'],['魚|さかな','poisson'],['風|かぜ','vent']],
 [['鉄|てつ','fer'],['火|ひ','feu'],['煙|けむり','fumée'],['音|おと','bruit'],['車|くるま','véhicule'],['時計|とけい','horloge'],['仕事|しごと','travail'],['力|ちから','force'],['電気|でんき','électricité'],['危ない|あぶない','dangereux']]];
VOC[16]=[['人|ひと','personne'],['友達|ともだち','ami'],['名前|なまえ','nom'],['本|ほん','livre'],['会います|あいます','rencontrer'],['自分|じぶん','soi-même'],['皆さん|みなさん','tout le monde'],['城|しろ','château'],['紙|かみ','papier'],['字|じ','caractère']];VOC[15]=[['東|ひがし','est'],['西|にし','ouest'],['南|みなみ','sud'],['北|きた','nord'],['道|みち','chemin'],['風|かぜ','vent'],['右|みぎ','droite'],['左|ひだり','gauche'],['まっすぐ','tout droit'],['電車|でんしゃ','train']];VOC[14]=[['時計|とけい','horloge'],['庭|にわ','jardin'],['花|はな','fleur'],['大きい|おおきい','grand'],['小さい|ちいさい','petit'],['高い|たかい','haut'],['安い|やすい','bon marché'],['新しい|あたらしい','neuf'],['今|いま','maintenant'],['時間|じかん','temps, heure']];VOC[13]=[['森|もり','forêt'],['木|き','arbre'],['葉|は','feuille'],['狐|きつね','renard'],['動物|どうぶつ','animal'],['手|て','main'],['足|あし','pied, jambe'],['目|め','œil'],['耳|みみ','oreille'],['口|くち','bouche']];VOC[12]=[['空|そら','ciel'],['雲|くも','nuage'],['風|かぜ','vent'],['港|みなと','port'],['切符|きっぷ','billet'],['高い|たかい','haut'],['飛びます|とびます','voler'],['乗ります|のります','monter à bord'],['待ちます|まちます','attendre'],['家族|かぞく','famille']];VOC[11]=[['鉄|てつ','fer'],['火|ひ','feu'],['工場|こうじょう','usine'],['仕事|しごと','travail'],['お金|おかね','argent'],['石炭|せきたん','charbon'],['熱い|あつい','brûlant'],['重い|おもい','lourd'],['機械|きかい','machine'],['音|おと','bruit']];VOC[10]=[['字|じ','caractère'],['紙|かみ','papier'],['筆|ふで','pinceau'],['墨|すみ','encre'],['本|ほん','livre'],['試験|しけん','examen'],['学生|がくせい','étudiant'],['桜|さくら','cerisier'],['池|いけ','bassin'],['答え|こたえ','réponse']];VOC[9]=[['町|まち','ville'],['店|みせ','boutique'],['橋|はし','pont'],['夜|よる','nuit'],['電車|でんしゃ','tramway'],['切符|きっぷ','billet'],['人|ひと','personne'],['銭湯|せんとう','bain public'],['新聞|しんぶん','journal'],['猫|ねこ','chat']];VOC[8]=[['川|かわ','fleuve'],['船|ふね','bateau'],['魚|さかな','poisson'],['霧|きり','brume'],['橋|はし','pont'],['水|みず','eau'],['岸|きし','rive'],['鳥|とり','oiseau'],['雨|あめ','pluie'],['朝|あさ','matin']];VOC[7]=[['道|みち','chemin'],['旅|たび','voyage'],['宿|やど','auberge'],['手紙|てがみ','lettre'],['秋|あき','automne'],['紅葉|もみじ','érable rouge'],['橋|はし','pont'],['お金|おかね','argent'],['壁|かべ','mur'],['門|もん','portail']];VOC[6]=[['雪|ゆき','neige'],['山|やま','montagne'],['冬|ふゆ','hiver'],['氷|こおり','glace'],['寒い|さむい','froid'],['白い|しろい','blanc'],['道|みち','chemin'],['お茶|おちゃ','thé']];VOC[4]=VOC[3];VOC[5]=[['山|やま','montagne'],['熱い|あつい','brûlant'],['赤い|あかい','rouge'],['黒い|くろい','noir'],['鬼|おに','démon'],['井戸|いど','puits'],['灰|はい','cendre'],['岩|いわ','rocher']];
VOC[17]=[['海|うみ','mer'],['魚|さかな','poisson'],['泳ぎます|およぎます','nager'],['夏休み|なつやすみ',"vacances d'été"],['甘い|あまい','sucré'],['辛い|からい','épicé'],['カレー','curry'],['丸い|まるい','rond'],['撮ります|とります','photographier'],['登ります|のぼります','grimper'],['咲きます|さきます','fleurir'],['困ります|こまります','être embêté']];
VOC[18]=[['金|きん','or'],['町|まち','ville'],['夏休み|なつやすみ',"vacances d'été"],['カレー','curry'],['紅茶|こうちゃ','thé noir'],['丸い|まるい','rond'],['撮ります|とります','photographier'],['頼みます|たのみます','demander, commander'],['困ります|こまります','être embêté'],['渡します|わたします','remettre'],['お菓子|おかし','friandise'],['暇|ひま','temps libre']];
/* espèces de rôdeurs : sprite, teinte, nom, faiblesse / résistance */
const RKIND={yoma:{s:'yoma',n:()=>'Yōma de vapeur'},tayoma:{s:'tayoma',n:()=>'Yōma des rizières'},kodama:{s:'kodama',n:()=>'Kodama corrompu',weak:'火',res:'木'},braise:{s:'braise',n:()=>'Braise errante',weak:'水',res:'火'},
 kakashi:{s:'kaka',bt:'kakashi',sc:.72,n:()=>'Épouvantail errant',weak:'火',res:'土'},karakasa:{s:'karakasa',sc:.72,n:()=>'Petite ombrelle',weak:'木',res:'水'},smoke:{s:'smoke',sc:.72,n:()=>'Suie vivante',weak:'水',res:'風'},toad:{s:'toad',sc:.72,n:()=>'Crapaudeau',weak:'風',res:'雷'}};
const WCOL=[['#58b8f0','土','水','eau'],['#f08858','水','火','feu'],['#68c868','火','木','bois']];
const GREQ={kakashi:['l3','l4'],karakasa:['l5','l6'],smoke:['l7'],toad:['l8']};
const zoneCleared=z=>!!S.wins[[0,'kakashi','karakasa','smoke','toad','boss','yuki','nuri','umi','wanyudo','kyorin','baku','nue','yamabiko','ungai','kaze','tetsu'][z]];
function gateOpen(gt){if((PART===12||PART===34)&&gt.need==='baku')return false;return !!S.wins[gt.need]}
function respawnNow(){S.hp=maxHp();ROVD.clear();const h=window.PRO?{m:'world',x:11,y:3553}:(S.heal||{m:'world',x:3,y:OY+87});W.load(h.m,h.x,h.y,0);S.pos={m:h.m,x:h.x,y:h.y,d:0};W.H.cd=2;save()}
function objective(){
 if(!S.sp['人'])return 'va voir <b>Maître Genzō</b> au dojo (le toit bleu).';
 if(!S.fl.act1&&!S.les.l1)return 'va voir <b>Maître Tanuki</b>, sur la place du village : il t\'apprendra tes premières phrases.';
 if(!S.fl.act1)return 'la journée est finie. Rentre dormir à la <b>maison</b>, au sud-ouest du village.';
 const z=[['kakashi','Les Yōma venaient du nord. Bats le <b>Seigneur de boue</b> qui garde la route.',['l1','l2']],['karakasa','Traverse la <b>Forêt de Kage</b> et bats la <b>Lanterne de fête</b>.',['l3','l4']],['smoke','Avant-poste de Tetsu : bats la <b>Poupée de cérémonie</b>.',['l5','l6']],['toad','Quai 2 : bats le <b>Grand fourneau</b>.',['l7','l8']],['boss','Monte jusqu\'au <b>vieux puits</b>…',['l9','l10']],['yuki','Acte II. Passe la porte au nord du vieux puits, traverse le <b>col des Brumes</b> et bats la <b>Yuki-onna mécanique</b>.',['l11','l12']],['nuri','Descends la <b>grand-route de Kurogane</b> jusqu\'au relais, puis bats le <b>Grand Nurikabe douanier</b> qui barre le poste de contrôle.',['l13','l14']],['umi','Longe le <b>Grand Fleuve</b> jusqu\'au bourg des passeurs, puis chasse l\'<b>Umibōzu de vapeur</b> de l\'embarcadère.',['l16','l18']],['wanyudo','Entre dans la <b>ville basse de Kurogane</b>, traverse les canaux et présente-toi au <b>Wanyūdō contrôleur</b> du funiculaire.',['l19','l20']],['kyorin','Monte à l\'<b>Académie des sceaux</b>, traverse les jardins et passe l\'examen du <b>Kyōrinrin</b> à la porte nord.',['l21','l22']],['baku','Traverse les <b>Grandes Forges de Tetsu</b> jusqu\'à la halle, au nord, et fais taire le <b>Baku de fer</b>, la machine qui avale les mots.',['l23','l24']],...(PART===12?[]:[['nue','Acte III. Hana a été enlevée. Traverse le <b>port des dirigeables</b> et chasse la <b>Nue</b> perchée sur le mât d\'amarrage, tout au nord : les pilotes retrouveront leurs mots.',['l25','l26']],['yamabiko','Le dirigeable s\'est écrasé dans la <b>forêt suspendue</b>. Traverse-la vers le nord, jusqu\'au treuil de la nacelle, et fais taire le <b>Yamabiko de fer</b>, l\'écho qui répète tout de travers.',['l27','l28']],['ungai','La nacelle t\'a déposé dans les <b>jardins suspendus des horlogers</b>. Traverse les îles vers le nord et passe l\'<b>Ungaikyō d\'horlogerie</b>, le miroir qui garde le nord des jardins.',['l29','l30']],['kaze','Monte au nord des jardins jusqu\'à la <b>croisée des quatre vents</b>, puis suis la ligne du nord et chasse le <b>Kaze-no-kami à vapeur</b>, le mauvais vent qui égare les voyageurs.',['l31','l32']],['tetsu','Par la ligne du nord, monte dans la <b>citadelle de Tetsu</b>, traverse la bibliothèque des noms volés et affronte <b>Tetsu</b> dans la salle du trône pour libérer Hana.',['l33','l34']]])];
 for(const[k,t,ls]of z){if(!S.wins[k]){const l=ls.find(x=>!S.les[x]);return ''+t+(l?`<br>Leçon disponible : « ${LES(l).title} » auprès de <b>${NPN[LES(l).who]}</b>.`:'')}}
 {const T=Path.hint();if(T&&S.wins.tetsu)return `La citadelle est tombée. L\'acte IV arrive bientôt : le cœur du dieu. En attendant, continue ton parcours : thème « ${T.name} » auprès de <b>${PLACES[T.place]}</b>.`;if(T&&S.wins.kaze)return `Le vent s\'est calmé. Au nord, la ligne mène à la citadelle de Tetsu. En attendant, continue ton parcours : thème « ${T.name} » auprès de <b>${PLACES[T.place]}</b>.`;if(T&&S.wins.ungai)return `Le miroir s\'est brisé. Au nord des jardins, un pont mène à la croisée des quatre vents. En attendant, continue ton parcours : thème « ${T.name} » auprès de <b>${PLACES[T.place]}</b>.`;if(T&&S.wins.yamabiko)return `L'écho s'est tu. La nacelle t'attend au nord de la forêt. En attendant, continue ton parcours : thème « ${T.name} » auprès de <b>${PLACES[T.place]}</b>.`;if(T&&S.wins.nue)return `La Nue s'est envolée. Le capitaine t'attend au mât d'amarrage, au nord du port. En attendant, continue ton parcours : thème « ${T.name} » auprès de <b>${PLACES[T.place]}</b>.`;if(T)return `L'acte II est terminé : la machine s'est tue. L'acte III arrive. En attendant, continue ton parcours : thème « ${T.name} » auprès de <b>${PLACES[T.place]}</b>.`}
 return 'Le col est franchi. La suite de l\'acte II arrive : le relais de poste. En attendant, révise dans les hautes herbes et le menu.'}
const STORY=(()=>{
 const H=W.H,J=(n,jp,fr,x)=>({n,jp,fr,x});
 async function lesson(id){const old=S.xp,ok=await Lesson.run(id);if(ok){save();await afterXp(old)}return ok}
 const YN=[{jp:['はい'],fr:'Oui'},{jp:['いいえ'],fr:'Pas maintenant'}];
 async function sensei(e,[a,b],hello,after){const n=NPN[e.spr],nx=!S.les[a]?a:(b&&!S.les[b])?b:null;
  if(nx){await D.say(hello);const i=await D.ask({n,t:`J'ai une leçon pour toi : « ${LES(nx).title} ». Tu veux la suivre ?`},YN);
   if(i!==0){await D.say({n,t:'Comme tu veux. Reviens me voir quand tu en auras envie.'});return false}
   const L_=LES(nx),ow_=L_.who;L_.who=e.spr;let ok;try{ok=await lesson(nx)}finally{L_.who=ow_}
   if(ok){S.it.oni=(S.it.oni||0)+1;sfx('item');await D.say([{n,t:nx===a&&b?'Bien ! J\'ai une deuxième leçon quand tu voudras. Tiens, pour la route.':'Tu apprends vite. Sers-toi de ces phrases en combat avec 言葉 (ことば). Tiens, pour la route.'},'Tu reçois un おにぎり (onigiri) !'])}
   else await D.say({n,t:'On reprendra plus tard. Rien ne presse.'});return ok}
  const ls=[a].concat(b?[b]:[]),i=await D.ask({n,t:'On révise une leçon ?'},ls.map(l=>LES(l).title).concat(['Non merci']));
  if(i<ls.length){const L_=LES(ls[i]),ow_=L_.who;L_.who=e.spr;try{await lesson(ls[i])}finally{L_.who=ow_}}else if(after)await D.say(after);return true}
 async function pushBack(){await W.walk(H,0,.2)}
 async function absorb(k,from){S.sp[k]=1;const sp=spK(k);sfx('evo');await UI.fade(1,90,true);await UI.fade(0,300,true);
  await D.say([J('',['気力|きりょく','を','吸収|きゅうしゅう','した','！'],`Souffle Primordial : tu absorbes le Kiryoku ${from}.`,'吸収 (きゅうしゅう) = absorption'),{jp:[`${k}|${sp.kun}`],fr:`Nouveau sort : ${sp.name} (${elem(k)[0]}).`,x:`${sp.fr} — lecture on : ${sp.on}. Tu peux le tracer en combat ou au dojo.`}]);save()}
 async function night(){
  await UI.fade(1,600);W.setNight(1);music(null);S.hp=maxHp();
  const hana=W.ents.find(e=>e.id==='hana');hana.x=hana.px=6;hana.y=hana.py=OY+89;hana.hx=6;hana.hy=OY+89;hana.dir=3;
  const ym=W.spawn({img:(XI.C_yoma_00&&XI.C_yoma_00.width?XI.C_yoma_00:miniWisp('#8a58c8')),x:8,y:OY+89}),ym2=W.spawn({img:(XI.C_yoma_00&&XI.C_yoma_00.width?XI.C_yoma_00:miniWisp('#8a58c8')),x:10,y:OY+84}),ym3=W.spawn({img:(XI.C_yoma_00&&XI.C_yoma_00.width?XI.C_yoma_00:miniWisp('#8a58c8')),x:5,y:OY+81});
  H.x=H.px=3;H.y=H.py=OY+87;H.dir=0;
  await D.say(['Cette nuit-là…',J('Hana',['お兄ちゃん|おにいちゃん','！','助けて|たすけて','！'],'Grand frère ! Au secours !','助けて (たすけて) = « au secours » · お兄ちゃん = grand frère')]);
  await UI.fade(0,600);W.shake(.7);sfx('boom');
  await D.say(['Des ombres rôdent entre les maisons. Ce ne sont pas des bandits… Ce sont des Yōma !',J('Kaito',['はな','から','離れろ|はなれろ','！'],'Éloigne-toi de Hana !')]);
  await W.walk(H,0,.14);await W.walk(H,3,.14);await W.walk(H,3,.14);W.faceTo(H,ym);
  await UI.fade(1,80,true);await UI.fade(0,400,true);
  Cine.show('N_I4');await D.say(['Une chaleur monte dans ta poitrine. Autour de toi, le Kiryoku semble retenir son souffle…',J('？？？',['…','見つけた|みつけた','。'],'… Je t\'ai trouvé.','Une voix, quelque part au fond de toi.'),{jp:['火|ひ'],fr:'Le feu. Trace-le !',x:'Ton premier élément. 火 se lit ひ, ou カ en lecture chinoise.'},{n:'Kaito',t:"(火… Le kanji interdit de Maître Tanuki. « Ne le trace jamais pour de vrai. » Il n'a pas dit quoi faire si une voix te le demande.)"}]);
  Cine.hide();S.sp['火']=1;const r=await Trace.run(spK('火'),{quit:false});S.best['火']=Math.max(S.best['火']||0,r.stars);UI.panel('pad');
  const old=S.xp,res=await Battle.start(EN.yoma0,{zone:2});
  if(res!=='win'){W.setNight(0);await D.say('Tu te réveilles en sursaut, en nage. Un cauchemar ?… Non. Dehors, Hana crie encore.');return}
  W.remove(ym);W.remove(ym2);W.remove(ym3);
  const ro=W.spawn({npc:1,spr:'ronin',x:9,y:OY+86,dir:2,ev:'ronin'});await W.emote(ro);W.faceTo(H,ro);
  await D.say([J('？？？',['…','面白い|おもしろい','。'],'… Intéressant.'),'Un samouraï t\'observe depuis la route. Avant que tu aies pu dire un mot, il a disparu dans la nuit.']);
  await W.walk(ro,1,.16);await W.walk(ro,1,.16);W.remove(ro);
  W.faceTo(hana,H);W.faceTo(H,hana);
  await D.say([J('Hana',['お兄ちゃん|おにいちゃん','、','ありがとう','！'],'Merci, grand frère !'),J('Hana',['すごい','！','火|ひ','が','出た|でた','よ','！'],'Incroyable ! Du feu est sorti !','出た (でた) = « est sorti »')]);
  await UI.fade(1,700);W.setNight(0);S.fl.act1=1;S.hp=maxHp();ROVD.clear();S.heal={m:'world',x:3,y:OY+87};W.load('world',3,OY+87,0);S.pos={m:'world',x:3,y:OY+87,d:0};save();music('village');await UI.fade(0,700);
  await D.say(['Au matin, le village panse ses plaies. Les Yōma venaient du nord, par la route des rizières.','Maître Tanuki est formel : jamais les Yōma n\'étaient descendus si bas. Si la route du nord les laisse passer, c\'est que quelque chose, là-haut, les pousse vers les villages.','Ils reviendront. Et la prochaine fois, un feu sorti de nulle part ne suffira peut-être pas à protéger Hana.','Ce feu… tu ne sais pas d\'où il vient, ni ce qui s\'est réveillé en toi cette nuit. Les réponses sont au bout de la route du nord. Pour Hana, pour Kome, tu dois la remonter jusqu\'à la source.']);await afterXp(old)}
 const S_={
 async tanu(e){await sensei(e,['l1','l2'],J(NPN.tanu,['こんにちは','！'],'Bonjour !'),J(NPN.tanu,['がんばって','ください','！'],'Bon courage !','がんばって = « fais de ton mieux »'))},
 async baa(e){await sensei(e,['l1','l2'],J(NPN.baa,['あら','、','こんにちは','。'],'Oh, bonjour.'),J(NPN.baa,['気|き','を','つけて','ね','。'],'Fais attention à toi.','気をつけて = « fais attention »'))},
 async bozu(e){await sensei(e,['l3','l4'],J(NPN.bozu,['ようこそ','。'],'Sois le bienvenu.'),J(NPN.bozu,['静か|しずか','な','森|もり','です','ね','。'],'Quelle forêt paisible, n\'est-ce pas ?','Mais les Kodama y sont corrompus…'))},
 async eng(e){await sensei(e,['l5','l6'],J(NPN.eng,['ちょっと','待って|まって','ください','！'],'Attends un instant, s\'il te plaît !'),J(NPN.eng,['水|みず','を','使って|つかって','ください','。'],'Sers-toi de l\'eau.','使って ください = « utilise, s\'il te plaît »'))},
 async worker(e){await sensei(e,['l7','l8'],J(NPN.worker,['おい','、','止まれ|とまれ','！'],'Hé, arrête-toi !'),J(NPN.worker,['風|かぜ','に','気|き','を','つけて','。'],'Méfie-toi du vent.','気をつけて = « fais attention »'))},
 async jii(e){await D.say([J('Vieil homme',['いい','天気|てんき','です','ね','。'],'Il fait beau, n\'est-ce pas ?','天気 (てんき) = le temps qu\'il fait · ね = « n\'est-ce pas ? »'),{n:'Vieil homme',t:'Avant, on voyait les montagnes d\'ici. Maintenant, il n\'y a plus que la fumée de Tetsu.'}])},
 async kid(e){await D.say([J('Enfant',['おなか','が','ぺこぺこ','です','！'],'J\'ai faim !','おなか = le ventre · ぺこぺこ = « tout creux »'),{n:'Enfant',t:'Dis, tu sais que tu peux courir en gardant B appuyé ?'}])},
 async fisher(e){await D.say([J('Pêcheur',['魚|さかな','が','いません','…'],'Il n\'y a pas de poissons…','います → いません : la négation pour les êtres vivants'),{n:'Pêcheur',t:'L\'eau du port est noire depuis que l\'usine tourne. Va voir du côté du vieux puits…'}])},
 async girl(e){if(canLeave())await D.say(J('Villageoise',['気|き','を','つけて','！'],'Fais attention à toi !'));else await D.say([J('Villageoise',['待って|まって','！'],'Attends !'),{n:'Villageoise',t:need()}])},
 async farmer(e){await D.say([J('Paysan',['今年|ことし','は','米|こめ','が','ありません','。'],'Cette année, il n\'y a pas de riz.','あります → ありません : la négation pour les choses'),{n:'Paysan',t:'Depuis que le Kiryoku se corrompt, même la boue des rizières se lève pour attaquer les gens. Trace tes kanji d\'une main sûre, c\'est tout ce qui compte.'}])},
 async worker1(e){await D.say([J('Ouvrière',['ここ','は','危ない|あぶない','です','。'],'C\'est dangereux, ici.'),{n:'Ouvrière',t:'Les grilles qui crachent de la vapeur attirent les esprits. Évite-les si tu es blessé.'}])},
 async master(e){const n=NPN.master;
  if(!S.sp['人']){await D.say([{n,t:'Ah ! Te voilà, Kaimo. … Kaitsu ? … Kaito. Pardon. À mon âge, les noms glissent. Les kanji, eux, ne glissent jamais.'},J(n,['ようこそ','、','海斗|かいと','。'],'Bienvenue, Kaito.'),{n,t:'Le Kiryoku traverse tout ce qui vit. Un kanji bien tracé le canalise : trait par trait, dans le bon ordre et le bon sens.'},J(n,['人|ひと'],'La personne. Le premier kanji : toi-même.','人 se lit ひと (lecture japonaise) ou ジン (lecture chinoise).')]);
   const r=await Trace.run(spK('人'),{quit:false});S.sp['人']=1;S.sp['土']=1;S.best['人']=r.stars;const old=S.xp;S.xp+=10;save();sfx('lvl');
   await D.say([{n,t:`${starsTxt(r.stars)} Bien tracé ! Tu gagnes 10 XP.`},{n,t:'Étrange… Ton Kiryoku n\'a aucune couleur. Ni feu, ni eau, ni vent. En soixante ans, je n\'ai jamais vu ça.'},{n,t:'Tu as vu le modèle gris sous ton doigt ? C\'est une aide. Plus tu traces un kanji, plus elle s\'efface : d\'abord le modèle, puis les points de départ, puis plus rien. Et un kanji tracé sans aide frappe plus fort.'},{jp:['土|つち'],fr:'Prends aussi la terre : un paysan la connaît mieux que personne. Trace-la.',x:'土 se lit つち, ou ド en lecture chinoise.'}]);
   {const r2=await Trace.run(spK('土'),{quit:false});S.best['土']=r2.stars;S.xp+=5;save()}
   await D.say([{n,t:'Deux sorts : 人 (force) et 土 (terre). En combat, choisis 術 (じゅつ, « technique ») puis trace ton kanji. Plus le tracé est propre, plus le sort frappe fort.'},{n,t:'Quand tu voudras d\'autres kanji, reviens me voir : je les enseigne par thèmes, cinq à la fois. Mais un sort ne fait pas tout.'},{n,t:S.les.l1?'Tanuki t\'a déjà appris tes premières phrases. Bien. Les mots aussi sont des armes. La journée a été longue : rentre te reposer.':'Va voir Maître Tanuki, sur la place. Il t\'apprendra tes premières phrases. Les mots aussi sont des armes.'},J(n,['また','どうぞ','。'],'Reviens quand tu veux.')]);await afterXp(old);return}
  {const c=await D.ask({n,t:'Que veux-tu faire ?'},[{jp:['題|だい'],fr:'Apprendre un thème de kanji'},{jp:['字|じ'],fr:'Retravailler un kanji'},{jp:['かな'],fr:'Tracer les kana'},'Rien, merci']);if(c===0)return Path.at(0,n);if(c===2)return Kana.run(n);if(c!==1)return}
  const pool=SP.filter(unl).sort((a,b)=>(S.best[a.k]||0)-(S.best[b.k]||0)).slice(0,8),i=await D.ask({n,t:'Quel kanji veux-tu travailler ?'},pool.map(s=>`${s.k} ${s.kun} — ${s.fr.split(',')[0]} ${starsTxt(S.best[s.k]||0)}`).concat(['Rien, merci']));
  if(i>=pool.length)return;const sp=pool[i],r=await Trace.run(sp);if(!r)return;const b=S.best[sp.k]||0,gain=r.stars>b?(r.stars-b)*4:1,old=S.xp;S.best[sp.k]=Math.max(b,r.stars);S.xp+=gain;save();say(sp.kun);
  await D.say({n,t:`${sp.k} : ${starsTxt(r.stars)} ${r.stars===3?'Parfait !':'Encore un effort.'} +${gain} XP.`});await afterXp(old)},
 async forg(e){const n=NPN.forg;await D.say([J(n,['いらっしゃい','！'],'Bienvenue !','いらっしゃい : ce qu\'on dit aux clients qui entrent'),{n,t:'Tu as l\'air fatigué. Laisse-moi réparer ton équipement.'}]);
  await UI.fade(1,300);sfx('heal');S.hp=maxHp();ROVD.clear();{const r=S.ret||{x:15,y:OY+78};S.heal={m:'world',x:r.x,y:r.y}}save();await wait(700);await UI.fade(0,300);
  if(!S.fl.forg){S.fl.forg=1;S.it.oni=(S.it.oni||0)+2;sfx('item');await D.say([{n,t:'Et prends ça. Un samouraï au ventre vide ne vaut rien.'},'Tu reçois deux おにぎり (onigiri) !'])}
  await D.say([{n,t:['« Un paysan et sa faucille… Trace des kanji, on verra ce que tu vaux. »','« Te voilà voyageur. Il te faudra bientôt une vraie lame. »','« Un apprenti, déjà ? Reviens me voir quand tu auras un katana : je le ferai chanter. »','« Un rōnin. Ta lame est courte, mais elle est honnête. Je ne peux pas en dire autant de mes clients. »','« Une chaudière dans le dos ? Qui t\'a soudé ça ? … C\'est du bon travail. Ça m\'énerve. »','« Tes gantelets brillent tout seuls. Ne touche à rien dans ma forge. »','« Maître du Kiryoku. Et tu viens encore faire réparer tes sandales chez moi. Bien. Reste comme ça. »'][stage(S.xp)]},J(n,['また','ね','！'],'À bientôt !')]);save()},
 async say(e){const q=S.qs||{},act=(e.id==='h20'&&q.q1===1)||(e.id==='h31'&&q.q2===1)||(e.id==='h30'&&q.q2===1)||(e.id==='h41'&&q.q3===1)||(e.id==='h50'&&q.q4===1);if(!act)await D.say([J(e.nm,e.jp,e.frT!=null?e.frT:e.fr,e.xx)].concat(e.t2?[{n:e.nm,t:e.t2}]:[]));await Quests.talk(e)},
 async keiko(e){const n='Maître Kotoba',zz=MAPS.world.zone((S.ret||{y:0}).y),place=zz>=17?zz-1:zz===16?15:zz===15?14:zz===14?13:zz===13?12:zz===12?11:zz===11?10:zz===10?9:zz===9?8:zz===8?7:zz===7?6:zz===6?5:Math.max(1,Math.min(4,zz-1));
  if(!S.fl.keiko){S.fl.keiko=1;await D.say([J(n,['ようこそ','、','言葉|ことば','の','道場|どうじょう','へ','！'],'Bienvenue au dojo des mots !','言葉 (ことば) = mot, parole · へ = « vers, à »'),{n,t:'Genzō ? Un vieil ami. Lui, il enseigne le tracé. Moi, j\'entraîne ce qu\'on oublie toujours : l\'oreille et la voix.'},{n,t:'Un conseil : ne me demande pas quand on se revoit. Tetsu m\'a pris un mot, il y a trois ans. Celui qui veut dire « le jour d\'après aujourd\'hui ». Depuis, je réponds « on verra ». À tout.'}])}
  const i=await D.ask({n,t:'Que veux-tu travailler ?'},[{jp:['題|だい'],fr:'Thèmes de kanji'},{jp:['文法|ぶんぽう'],fr:'Leçon de grammaire'},{jp:['文|ぶん'],fr:'Construire des phrases'},{jp:['耳|みみ'],fr:'Écouter'},{jp:['口|くち'],fr:'Prononcer'},{jp:['語|ご'],fr:'Vocabulaire'},'Rien, merci']);
  if(i===5)return Vocab.at(n);
  if(i===0)return Path.at(place,n);
  if(i===1){const ls=['l9','l10','l11','l12','l13','l14','l15','l16','l17','l18','l19','l20','l21','l22','l23'],nx=ls.find(l=>!S.les[l]);
   if(nx){if(await D.ask({n,t:`J'ai une leçon pour toi : « ${LES(nx).title} » — ${LES(nx).sub}. Tu veux la suivre ?`},YN)!==0)return;const ok=await lesson(nx);await D.say({n,t:ok?'Bien. Ces phrases reviendront dans tes révisions et tes parades.':'On reprendra plus tard.'});if(ok)Quest.add('dojo');return}
   const j=await D.ask({n,t:'Tu as suivi toutes mes leçons. Laquelle veux-tu revoir ?'},ls.map(l=>LES(l).title).concat(['Aucune']));if(j<ls.length)await lesson(ls[j]);return}
  if(i>5){await D.say(J(n,['また','来て|きて','ね','。'],'Reviens quand tu veux.'));return}
  const old=S.xp;let good=0,tot=0;
  if(i===2){const pool=(lessonsDone().length?lessonsDone():[LESSONS[0]]).flatMap(L=>L.ex),used=[];
   for(let k=0;k<5;k++){const c=pool.filter(x=>!used.includes(x)).sort((a,b)=>{const r=y=>{const q=S.sr[y.id]||{c:0,w:0};return q.c-q.w*2+Math.random()*1.5};return r(a)-r(b)});if(!c.length)break;const e2=c[rnd(Math.min(4,c.length))];used.push(e2);
    const r=await Ex.run(e2,{quit:1,head:`<b>文 ${k+1}/5</b> · `});if(r==='quit')break;tot++;if(r)good++}
   S.xp+=good;if(tot)Quest.add('dojo');save()}
  else{if(!S.snd){UI.panel('pad');await D.say({n,t:'Il faut d\'abord activer le son dans les options du menu.'});return}const r=await Oral.session(i===3?'mix':'speak');good=r.good;tot=r.n}
  UI.panel('pad');
  if(tot){const perfect=good===tot&&tot>=5&&!S.fl.kk_gift;await D.say({n,t:`${good} sur ${tot}. ${good===tot?'Sans faute !':good>=tot-1?'Presque parfait.':'Continue, ça vient en pratiquant.'} +${good} XP.`});
   if(perfect){S.fl.kk_gift=1;S.it.cha=(S.it.cha||0)+1;sfx('item');await D.say('Maître Kotoba t\'offre un お茶 (thé vert) pour ta série sans faute !')}}
  save();await afterXp(old)},
 async sign(s){await D.say([{jp:s.t,fr:s.fr,x:s.x}])},
 async item(e){S.fl[e.id]=1;S.it[e.it]=(S.it[e.it]||0)+1;W.remove(e);sfx('item');const it=IT[e.it];await D.say([{jp:it.t.concat(['を','見つけた|みつけた','！']),fr:`Tu trouves : ${it.n} !`,x:it.d}]);save()},
 async jizo(e){const i=await D.ask({jp:['お祈り|おいのり','します','か','？'],fr:'Une statue de Jizō, protecteur des voyageurs. Prier ?'},[{jp:['はい'],fr:'Oui'},{jp:['いいえ'],fr:'Non'}]);
  if(i===0){await UI.fade(1,260,true);sfx('heal');S.hp=maxHp();ROVD.clear();S.heal={m:'world',x:H.x,y:H.y};save();await wait(500);await UI.fade(0,260,true);await D.say('Tes PV sont restaurés et ta partie est sauvegardée. Si tu tombes au combat, tu reviendras ici.')}},
 async gate(gt){if(PART===34&&gt.need==='baku')return D.say(['La passerelle des Grandes Forges est fermée derrière toi.','Les actes I et II se jouent dans l\'autre version en ligne du jeu.']);if(PART===12&&gt.need==='baku'&&S.wins.baku)return D.say(['Au-delà de la grande halle, une passerelle monte vers les nuages. Tout en haut, on devine le port des dirigeables.','La suite de l\'aventure, l\'acte III, se joue dans la version complète du jeu.']);await D.say(`Une barrière de laiton, scellée. Le gardien de la zone — ${EN[gt.need].n} — en a la clé.`)},
 async home(){
  if(!S.sp['人']){await D.say('Il fait encore jour, et le vieux Genzō t\'attend au dojo (le toit bleu).');return}
  if(!S.fl.act1&&!S.les.l1){await D.say('Il fait encore jour. Maître Tanuki te cherchait sur la place du village : il veut t\'apprendre tes premières phrases.');return}
  if(!S.fl.act1){const i=await D.ask({jp:['寝ます|ねます','か','？'],fr:'La journée a été longue. Aller dormir ?'},YN);if(i===0)await night();return}
  const i=await D.ask({jp:['ただいま','！'],fr:'Te voilà chez toi. Te reposer un moment ?'},YN);
  if(i===0){await UI.fade(1,400);sfx('heal');S.hp=maxHp();ROVD.clear();S.heal={m:'world',x:3,y:OY+87};save();await wait(600);await UI.fade(0,400);await D.say([J('Hana',['おはよう','！'],'Bonjour !'),'Tes PV sont restaurés et ta partie est sauvegardée.'])}},
 async scroll(){const s=pick(SP.filter(unl));await D.say([{jp:[`${s.k}|${s.kun}`],fr:`${s.fr} — lecture on : ${s.on}`,x:`Sort : ${s.name}`}])},
 async rack(){await D.say([{jp:['木刀|ぼくとう'],fr:'Des sabres d\'entraînement en bois.',x:'木 (bois) + 刀 (sabre)'}])},
 async forge(){await D.say([{jp:['火|ひ','は','熱い|あつい','です','。'],fr:'Le feu est brûlant.'}])},
 async well(e){if(S.wins.boss)await D.say('Le vieux puits est silencieux. L\'eau y est redevenue claire.');else if(!S.wins.toad)await D.say('Un grondement sourd monte du puits…');else await boss(e)},
 wildDef(z,kind){z=clamp(z,1,18);const w=pick(VOC[z]),c=pick(WCOL),lv=1+z*3+rnd(2),K=RKIND[kind||(z===18?'oboro':z===17?'heikegani':z===16?'ashig':z===15?'kamai':z===14?'mikoshi':z===13?'tenome':z===12?'raiju':z===11?'ippon':z===10?'ittan':z===9?'nekomata':z===8?'kappa':z===7?'nurikabe':z===6?'yukidama':z===2?'kodama':z===1?'tayoma':'yoma')],own=k=>S.sp[k];
  let weak=K.weak||c[1],res=K.res||c[2];if(!K.weak&&!own(weak)){weak=['火','土','人'].find(own)||'人';if(res===weak)res='水'}
  return{id:'wild',wild:1,kind:K,n:K.n(z),t:[w[0]],sub:w[1],lv,hp:(kind?44:30)+z*15,dmg:9+z*4,xp:(kind?7:5)+z*2,atk:'Murmure',weak,res,clue:`Il a volé le mot « ${w[1]} ».`,spr:()=>bspr('wisp',c[0]),cry:[],word:{t:[w[0]],fr:w[1]}}},
 async wild(z){await Battle.start(S_.wildDef(z),{zone:z})},
 async hana(e){if(!S.fl.act1)await D.say([J('Hana',['お兄ちゃん|おにいちゃん','、','おはよう','！'],'Bonjour, grand frère !','お兄ちゃん (おにいちゃん) = grand frère, dit avec affection'),{n:'Hana',t:S.sp['人']?'Tu as l\'air épuisé. Rentre te coucher, je finis d\'étendre le riz.':'Le vieux Genzō te cherchait, au dojo. Tu sais, la maison au toit bleu.'}]);
  else await D.say([J('Hana',['気|き','を','つけて','ね','、','お兄ちゃん|おにいちゃん','。'],'Fais attention à toi, grand frère.'),{n:'Hana',t:'Je garde la maison. Reviens dormir ici quand tu veux : ça te remettra d\'aplomb.'}])},
 async ronin(e){},
 async guard(e,seen){if(seen){await W.emote(e);await W.walkNear(e,H)}else{W.faceTo(e,H)}
  if(e.rov){const r=await Battle.start(S_.wildDef(W.zone(),e.k),{zone:W.zone()});if(r==='win'){ROVD.add(e.id);W.remove(e);save();if(window.ALLYTRY)await ALLYTRY(e.k)}else if(r==='flee')W.H.cd=4;return}
  const def=EN[e.id];
  const r=await Battle.start(def,{zone:W.zone()});
  if(r==='win'){W.remove(e);save();if(def.gives&&!S.sp[def.gives])await absorb(def.gives,`de ${def.n}`);await D.say('La barrière de laiton s\'ouvre dans un sifflement de vapeur !');sfx('door')}
  else if(r==='lose')await D.say('Tu reprends tes esprits… Tes PV sont restaurés. Révise et retente ta chance !')},
 triggers(x,y){
  if(y===OY+73&&(x===9||x===10)&&!canLeave())return async()=>{const gl=W.ents.find(e=>e.id==='girl');if(gl){W.faceTo(gl,H);await W.emote(gl)}await D.say([J('Villageoise',['待って|まって','！'],'Attends !'),{n:'Villageoise',t:need()}]);await pushBack()};
  const cp=window.HCP?HCP(x,y):[[2564, 'worker'], [2728, 'eng'], [2919, 'bozu'], [3108, 'baa']].find(c=>c[0]===y&&!S.fl['h_'+c[1]]);
  if(cp)return async()=>{S.fl['h_'+cp[1]]=1;const e=W.ents.find(n=>n.id===cp[1]);if(!e)return;if(window.HCPNEAR)HCPNEAR(e);await W.emote(e);await W.walkNear(e,H);await S_[cp[1]](e)};
  if(y<=Y5+8&&y>=Y5+2&&x<=13&&W.zone()===5&&S.wins.toad&&!S.wins.boss)return()=>boss(W.ents.find(e=>e.boss));
  return null}};
 function canLeave(){return !!S.fl.act1}
 function need(){return !S.sp['人']?'Tu ne sais pas te battre ! Va d\'abord voir Maître Genzō, au dojo (le toit bleu).':!S.les.l1?'Tu pars sans savoir dire un mot ? Va voir Maître Tanuki, sur la place.':'Il se fait tard, et la route n\'est pas sûre la nuit. Rentre te reposer chez toi, au sud-ouest du village.'}
 async function boss(e){$('#pPad').classList.add('wait');music(null);W.shake(1.4);sfx('boom');await wait(900);await new Promise(r=>{const t0=performance.now();const f=()=>{const p=Math.min(1,(performance.now()-t0)/2400);e.rise=p;p<1?requestAnimationFrame(f):r()};f()});
  await Cine.say('N_S2',[J('？？？',['だれ','だ','！'],'Qui va là ?!'),{t:'Une locomotive à face de démon jaillit du vieux puits !'}]);
  const r=await Battle.start(EN.boss,{zone:5});e.rise=0;
  if(r==='win'){save();await D.say([J('Oni Locomotive',['水|みず','…','水|みず','は','…','きらい','だ','…'],'L\'eau… je déteste… l\'eau…','きらい = détester (le contraire de 好き)'),'La fournaise s\'éteint. Dans le puits, l\'eau redevient claire.',
    J('？？？',['海斗|かいと','…','待って|まって','いる','ぞ','。'],'Kaito… Je t\'attends.','La voix. La même que cette nuit-là.')]);
   const ro=W.spawn({npc:1,spr:'ronin',x:H.x,y:H.y+3,dir:1,ev:'ronin'});await W.emote(ro);await W.walkNear(ro,H);music('village');
   await D.say([J('Samouraï',['その','力|ちから','は','…'],'Ce pouvoir…'),{n:'Samouraï',t:'« Il n\'aurait jamais dû apparaître chez un humain. » Il te tend un sabre court, un wakizashi. « Suis-moi, Kaito. Tu as tout à apprendre. »'},
    J('',['お疲れ様|おつかれさま','でした','！'],'Fin de l\'Acte I — Le Paysan.','À suivre : Acte II, L\'Apprenti.')]);W.remove(ro);W.refreshZone()}
  else if(r==='lose')await D.say('Tu reprends tes esprits… Le démon du puits t\'attend toujours.')}
 return S_})();
/* ---------- introduction ---------- */
async function intro(){G.busy=true;UI.panel('pad');
 await UI.fade(0,10);Cine.show('N_I1');await D.say(['Il y a plusieurs siècles, les humains ont découvert une énergie qui traverse les êtres vivants, les montagnes, les océans et jusqu\'à l\'air.',{jp:['気力|きりょく'],fr:'Le Kiryoku.',x:'気 (esprit, énergie) + 力 (force)'}]);
 Cine.show('N_I2');await D.say('Certains le maîtrisent et commandent aux éléments. D\'autres l\'ont enfermé dans des machines : armures mécaniques, trains blindés, canons magiques.');
 await D.say(['Mais le Kiryoku qu\'on enferme trop longtemps finit par s\'échapper. Il prend alors la forme de Yōma : des esprits affamés, qui se nourrissent des mots des humains.',{jp:['妖魔|ようま'],fr:'Les Yōma.',x:'妖 (étrange, ensorcelant) + 魔 (démon)'},'Un mot volé par un Yōma, et celui qui le portait ne sait plus ni le dire, ni l\'écrire. Des villages entiers sont ainsi devenus muets.']);Cine.show('N_I3');await D.say('Province de Kome. Kaito n\'est personne : un paysan qui cultive le riz avec sa petite sœur, Hana, et rêve du monde au-delà des montagnes.');await UI.fade(1,400);Cine.hide();
 W.load('world',3,OY+87,0);G.scene='world';await UI.fade(0,500);
 const hn=W.ents.find(e=>e.id==='hana');W.faceTo(hn,W.H);W.faceTo(W.H,hn);
 await D.say([{n:'Hana',jp:['お兄ちゃん|おにいちゃん','、','おはよう','！'],fr:'Bonjour, grand frère !'},{n:'Hana',t:'Le vieux Genzō te cherchait, au dojo. Et maître Tanuki voulait te parler aussi !'}]);
 const t=W.ents.find(e=>e.id==='tanu');t.x=3;t.y=OY+91;t.px=3;t.py=OY+91;await W.emote(t);await W.walkNear(t,W.H);t.hx=t.x;t.hy=t.y;
 await D.say([{n:NPN.tanu,jp:['こんにちは','！'],fr:'Bonjour !'},{n:NPN.tanu,jp:['私|わたし','は','たぬき','先生|せんせい','です','。'],fr:'Je suis maître Tanuki.'},{n:NPN.tanu,t:'Dans ce monde, les mots canalisent le Kiryoku : un kanji bien tracé devient un sort, une phrase bien dite fait plier un Yōma. Je peux t\'apprendre la grammaire, si tu veux.'}]);
 const i=await D.ask({n:NPN.tanu,jp:['始めましょう|はじめましょう','か','？'],fr:'On commence la première leçon ?'},[{jp:['はい'],fr:'Oui'},{jp:['いいえ'],fr:'Plus tard'}]);
 S.fl.intro=1;save();
 if(i===0){const old=S.xp;if(await Lesson.run('l1')){save();await D.say({n:NPN.tanu,t:'Très bien ! Maintenant, file au dojo — le bâtiment au toit bleu. Genzō t\'attend.'});await afterXp(old)}}
 else await D.say({n:NPN.tanu,t:'Comme tu veux. File au dojo — le toit bleu — et reviens me voir avant ce soir : je serai sur la place.'});
 G.busy=false;UI.panel('pad')}

/* ---------- révision espacée, main de kanji en combat, kana, quêtes, boutique, bilan, transfert de sauvegarde ---------- */
const dayN=()=>Math.floor((Date.now()-new Date().getTimezoneOffset()*6e4)/864e5);
const SRI=[1,3,7,15,30];
const Review=(()=>{
 const rv=()=>S.rv||(S.rv={}),rp=()=>S.rp||(S.rp={}),PUN=/^[。、！？!?…「」]+$/,clean=t=>t.filter(x=>!PUN.test(x));
 const kDue=k=>{const r=rv()[k];return !r||r.d<=dayN()};
 function mark(st,k,ok){const r=st[k],t=dayN();if(ok){if(r&&r.d>t)return;const i=r?Math.min(4,r.i+1):0;st[k]={i,d:t+SRI[i]}}else st[k]={i:0,d:t+1}}
 const markK=(k,ok)=>mark(rv(),k,ok);
 const dueK=()=>SP.filter(unl).filter(s=>kDue(s.k)).sort((a,b)=>((S.km||{})[a.k]||0)-((S.km||{})[b.k]||0));
 function dueP(){const p=rp(),t=dayN();Object.keys(S.ph).filter(k=>PHR[k]&&!p[k]).forEach((k,i)=>{p[k]={i:0,d:t+i%6}});return Object.keys(S.ph).filter(k=>PHR[k]&&p[k].d<=t)}
 const count=()=>dueK().length+dueP().length;
 function phq(key){const p=PHR[key],c=clean(p.t),oth=()=>shuf(Object.values(PHR).filter(x=>x.fr!==p.fr)).slice(0,2).map(x=>x.fr),r=Math.random(),show=`<span class="jp">${jpHtml(p.t)}</span>${esc(p.fr)}`;
  if(S.snd&&r<.35)return{q:'mcq',listen:1,snd:jpText(p.t),p:'Écoute : que veut dire cette phrase ?',a:p.fr,o:[p.fr,...oth()],show};
  if(c.length>=3&&c.length<=7&&r<.8)return{q:'ord',t:c,fr:p.fr,x:[]};
  return{q:'mcq',p:'Que veut dire cette phrase ?',t:p.t,a:p.fr,o:[p.fr,...oth()]}}
 async function session(){const ks=dueK().slice(0,5),ps=shuf(dueP()).slice(0,4),items=[];for(let i=0;i<5;i++){if(ks[i])items.push({k:ks[i]});if(ps[i])items.push({p:ps[i]})}
  let good=0,n=0;for(const it of items){n++;if(it.k){const r=await Trace.run(it.k);if(!r){n--;break}if(r.stars>=2)good++}else{const r=await Ex.run(phq(it.p),{quit:1,head:`<b>復習 ${n}/${items.length}</b> · `});if(r==='quit'){n--;break}mark(rp(),it.p,!!r);if(r)good++}}
  if(n){S.xp+=good;if(n>=Math.min(3,items.length))Quest.add('rev');save();UI.toast(`Révision : ${good} / ${n} · +${good} XP`,2600)}return{good,n}}
 return{kDue,markK,dueK,dueP,count,session}})();
/* main de 4 kanji proposée à chaque tour : d'abord ceux à réviser, puis les moins maîtrisés */
function battleHand(cool){cool=cool||{};let pool=SP.filter(unl);const fresh=pool.filter(s=>!cool[s.k]);if(fresh.length>=4)pool=fresh;const km=S.km||{},due=shuf(pool.filter(s=>Review.kDue(s.k))).sort((a,b)=>(km[a.k]||0)-(km[b.k]||0)),rest=shuf(pool.filter(s=>!due.includes(s)));
 return shuf(due.slice(0,2).concat(rest,due.slice(2)).slice(0,4))}
/* ----- kana ----- */
const Kana=(()=>{const kata=c=>String.fromCharCode(c.charCodeAt(0)+96),hira=c=>String.fromCharCode(c.charCodeAt(0)-96);
 async function run(n){const a=await D.ask({n,t:'Quel syllabaire veux-tu tracer ?'},[{jp:['ひらがな'],fr:'Hiragana'},{jp:['カタカナ'],fr:'Katakana'},'Rien, merci']);if(a>1)return;
  const rows=KROWS.map(r=>a?[...r].map(kata).join(''):r),done=S.kn||(S.kn={});let pg=0,row=null;
  while(row===null){const sl=rows.slice(pg*5,pg*5+5),i=await D.ask({n,t:'Quelle ligne ?'},sl.map(r=>r+(done[r]?' ✓':'')).concat([pg?'◀ Lignes précédentes':'Lignes suivantes ▶','Annuler']));if(i<sl.length)row=sl[i];else if(i===sl.length)pg=1-pg;else return}
  const rd=c=>romaji([a?hira(c):c]),all=rows.join('');let good=0,tot=0;
  for(const c of row){UI.panel('pad');await D.say({n,jp:[c],fr:`Se lit « ${rd(c)} ».`},{nolearn:1});const r=await Trace.run({k:c,name:rd(c),fr:a?'katakana':'hiragana',kun:a?hira(c):c,on:a?c:kata(c),s:KANA[c]});if(!r){UI.panel('pad');return}tot++;if(r.stars>=2)good++}
  for(const c of shuf([...row]).slice(0,3)){const o=shuf([...all].filter(x=>x!==c&&rd(x)!==rd(c))).slice(0,3).map(rd),r=await Ex.run({q:'mcq',p:'Comment se lit ce caractère ?',big:c,a:rd(c),o:[rd(c),...o]},{quit:1,head:'<b>かな</b> · '});if(r==='quit')break;tot++;if(r)good++}
  done[row]=1;const old=S.xp;S.xp+=good;save();UI.panel('pad');await D.say({n,t:`${good} sur ${tot}. Ligne « ${row} » travaillée. +${good} XP.`});await afterXp(old)}
 return{run}})();
/* ----- quêtes des habitants ----- */
const Quests=(()=>{
 const st=()=>S.qs||(S.qs={}),J=(n,jp,fr,x)=>({n,jp,fr,x}),YN=[{jp:['はい'],fr:'Oui'},{jp:['いいえ'],fr:'Pas maintenant'}];
 const Q={q1:{who:'h20',name:'Un thé pour le vieil homme',gold:40,todo:'Apporte un thé (お茶) au vieil homme du Hameau des bambous.'},
  q2:{who:'h31',name:'Deux onigiri pour papa',gold:50,todo:'Donne deux onigiri à l\'ouvrier du Quartier des ouvriers.'},
  q3:{who:'h41',name:'La question de l\'habitante',gold:40,todo:'Réponds en japonais à l\'habitante du Quartier des fumées.'},
  q4:{who:'h50',name:'Les braises errantes',gold:80,todo:'Abats deux Braises errantes près du vieux puits, puis retourne voir le vieil homme.'}};
 async function done(id,n,line){const q=Q[id],old=S.xp;st()[id]=2;S.gold=(S.gold||0)+q.gold;S.xp+=10;sfx('lvl');await D.say([line,`Quête accomplie : « ${q.name} ». +${q.gold} 円, +10 XP.`]);save();await afterXp(old)}
 async function start(id,lines){st()[id]=1;await D.say(lines.concat([`Nouvelle quête : « ${Q[id].name} ». Tu la retrouves dans le menu, onglet Défis.`]));save()}
 async function talk(e){const s=st(),n=e.nm;
  if(e.id==='h20'&&s.q1!==2){if(!s.q1)return start('q1',[J(n,['お茶|おちゃ','を','一つ|ひとつ','ください','。'],'Un thé, s\'il te plaît.','一つ (ひとつ) = un (objet) · ください = « donne-moi, s\'il te plaît »'),{n,t:'Mes vieux os ont soif. Si tu as un thé dans ton sac, reviens me voir.'}]);
   if((S.it.cha||0)<1)return D.say({n,t:'Toujours pas de thé ? La marchande du hameau en vend.'});
   if(await D.ask({n,jp:['お茶|おちゃ','、','あります','か','。'],fr:'Tu as du thé ? (Lui donner un thé ?)'},YN)===0){S.it.cha--;return done('q1',n,J(n,['ありがとう','。','助かりました|たすかりました','。'],'Merci. Tu me sauves.','助かりました = « ça m\'a bien aidé »'))}return}
  if(e.id==='h31'&&s.q2!==2){if(!s.q2)return start('q2',[J(n,['お父さん|おとうさん','に','おにぎり','を','二つ|ふたつ','、','お願いします|おねがいします','。'],'Donne deux onigiri à papa, s\'il te plaît.','お願いします = « s\'il te plaît » · 二つ (ふたつ) = deux'),{n,t:'Papa, c\'est l\'ouvrier qui marche dans la rue. Il n\'a rien mangé depuis hier.'}]);return D.say({n,t:'Tu as trouvé papa ? Il lui faut deux onigiri !'})}
  if(e.id==='h30'&&s.q2===1){if((S.it.oni||0)<2)return D.say({n,t:'Mon fils t\'envoie ? C\'est gentil… mais tu n\'as pas deux onigiri sur toi.'});
   if(await D.ask({n,t:'Deux onigiri ? Pour moi ? (Les lui donner ?)'},YN)===0){S.it.oni-=2;return done('q2',n,J(n,['いただきます','！'],'Merci pour ce repas !','いただきます : ce qu\'on dit avant de manger'))}return}
  if(e.id==='h41'&&s.q3!==2){if(!s.q3)await start('q3',[{n,t:'Tu n\'es pas d\'ici, toi. Voyons si tu sais te présenter.'}]);
   const i=await D.ask(J(n,['どこ','から','来ました|きました','か','。'],'D\'où viens-tu ?','どこ = où · から = depuis · 来ました = « es venu »'),[{jp:['米|こめ','の','里|さと','に','行きます|いきます','。'],fr:'…'},{jp:['米|こめ','の','里|さと','から','来ました|きました','。'],fr:'…'},{jp:['米|こめ','の','里|さと','が','好き|すき','です','。'],fr:'…'}]);
   if(i===1)return done('q3',n,J(n,['そう','です','か','。','遠い|とおい','です','ね','。'],'Ah bon. C\'est loin, dis donc.','遠い (とおい) = loin'));
   return D.say({n,t:i===0?'« Je vais au village de Kome » ? Ce n\'est pas ce que je demandais. Réessaie quand tu veux.':'« J\'aime le village de Kome » ? Ce n\'est pas ce que je demandais. Réessaie quand tu veux.'})}
  if(e.id==='h50'&&s.q4!==2){if(!s.q4){S.qc=0;return start('q4',[J(n,['鬼火|おにび','を','二つ|ふたつ','倒して|たおして','ください','。'],'Abats deux feux follets, s\'il te plaît.','倒して (たおして) = « abats, renverse »'),{n,t:'Les Braises errantes rôdent autour du puits. Elles ont brûlé mon toit.'}])}
   if((S.qc||0)<2)return D.say({n,t:`Les Braises errantes sont toujours là… (${S.qc||0} sur 2)`});return done('q4',n,J(n,['よく','やりました','。'],'Tu as bien travaillé.'))}}
 function onWin(def){if(st().q4===1&&def.kind&&def.kind.s==='braise'){S.qc=(S.qc||0)+1;UI.toast(`Quête : Braises errantes ${Math.min(2,S.qc)} / 2`)}}
 const html=()=>{const s=st(),a=Object.keys(Q).filter(k=>s[k]===1),d=Object.keys(Q).filter(k=>s[k]===2).length;if(!a.length&&!d)return '';
  return `<div class="sw" style="border:0;padding:8px 0 6px"><span>Quêtes · ${d}/${Object.keys(Q).length} accomplies</span></div>`+a.map(k=>`<div class="mi"><div class="k" style="font-size:22px;color:var(--gold)">！</div><div class="t"><b>${esc(Q[k].name)}</b>${esc(Q[k].todo)}</div></div>`).join('')};
 return{talk,onWin,html}})();
/* ----- marchande : acheter en japonais ----- */
const Shop=(()=>{const n='Marchande',P={oni:[20,['二十|にじゅう','円|えん'],'vingt yen'],cha:[12,['十二|じゅうに','円|えん'],'douze yen']},NB=[['一つ|ひとつ',1],['二つ|ふたつ',2],['三つ|みっつ',3]];
 async function run(){await D.say({n,jp:['いらっしゃいませ','！'],fr:'Bienvenue !',x:'La formule d\'accueil des commerçants.'});
  for(;;){const i=await D.ask({n,t:`Tu as ${S.gold||0} 円 (yen). Que veux-tu demander ?`},[{jp:['おにぎり','は','いくら','です','か','。'],fr:'Combien coûte l\'onigiri ?'},{jp:['お茶|おちゃ','は','いくら','です','か','。'],fr:'Combien coûte le thé ?'},{jp:['けっこう','です','。'],fr:'Non merci.'}]);
   if(i>1){await D.say({n,jp:['また','どうぞ','！'],fr:'Revenez quand vous voulez !'});return}
   const k=i?'cha':'oni',p=P[k];await D.say({n,jp:p[1].concat(['です','。']),fr:`C'est ${p[2]}.`,x:'円 (えん) : le yen, la monnaie du pays.'});
   const j=await D.ask({n,t:'Combien en veux-tu ?'},NB.map(b=>`${b[1]} (${b[1]*p[0]} 円)`).concat([{jp:['やめます','。'],fr:'Finalement, non.'}]));
   if(j>2)continue;const q=NB[j][1],c=Math.round(q*p[0]*(await ShopTalk(k,q,n)));if((S.gold||0)<c){await D.say({n,jp:['お金|おかね','が','足りません|たりません','よ','。'],fr:'Tu n\'as pas assez d\'argent.',x:'足りません (たりません) = « ne suffit pas »'});continue}
   S.gold-=c;S.it[k]=(S.it[k]||0)+q;sfx('item');save();await D.say({n,jp:['ありがとう','ございます','！'],fr:`Merci beaucoup ! (+${q} ${IT[k].n.toLowerCase()})`})}}
 return{run}})();
STORY.shop=()=>Shop.run();
HSHOP.filter(h=>h.z!==5).forEach(h=>NPCS.world.push({id:'shop'+h.z,spr:'merch',x:h.x,y:h.y,ev:'shop',dir:0}));
PORT.Marchande='PX_merch';
/* ----- bilan de progression ----- */
const Bilan={html(){const km=S.km||{},kn=SP.filter(unl),mast=kn.filter(s=>(km[s.k]||0)>=10).length,st=S.st||{},pc=k=>{const a=st[k];return a&&a[1]?`${Math.round(a[0]/a[1]*100)} % <small>(${a[1]})</small>`:'—'},bar=(v,m,c)=>`<div class="bar" style="margin-top:4px"><i style="width:${m?v/m*100:0}%;background:${c}"></i></div>`;
  const weakK=kn.filter(s=>(km[s.k]||0)<3).slice(0,10).map(s=>s.k).join(' '),ex=[];lessonsDone().forEach(L=>L.ex.forEach(e=>{const r=S.sr[e.id];if(r&&r.w>r.c)ex.push(L.title)}));const wl=[...new Set(ex)].slice(0,3);
  const rows=[['Tracé des kanji','tr'],['Remettre en ordre','ord'],['Compléter','gap'],['Choisir la bonne réponse','mcq'],['Écoute','lis']];
  return `<div class="mi"><div class="k" style="color:var(--cy)">字</div><div class="t"><b>Kanji : ${kn.length} appris sur ${SP.length}</b>${bar(kn.length,SP.length,'var(--cy)')}<small>${mast} tracés de mémoire (sans aide) · ${Review.dueK().length} à réviser aujourd'hui</small>${bar(mast,SP.length,'var(--gold)')}</div></div>
<div class="mi"><div class="k" style="color:var(--cy)">文</div><div class="t"><b>Grammaire : ${lessonsDone().length} leçons sur ${LESSONS.length}</b>${bar(lessonsDone().length,LESSONS.length,'var(--green)')}<small>${Object.keys(S.ph).filter(k=>PHR[k]).length} phrases dans le carnet · ${THEMES.filter(T=>Path.lvl(T.id)>=3).length} thèmes maîtrisés sur ${THEMES.length}</small></div></div>
<div class="mi"><div class="k" style="color:var(--cy)">かな</div><div class="t"><b>Kana : ${Object.keys(S.kn||{}).length} lignes travaillées sur ${KROWS.length*2}</b>${bar(Object.keys(S.kn||{}).length,KROWS.length*2,'var(--cy)')}</div></div>
<div class="sw" style="border:0;padding:8px 0 4px"><span>Réussite par type d'exercice</span></div>`+rows.map(r=>`<div class="sw"><span>${r[0]}</span><span style="color:var(--gold)">${pc(r[1])}</span></div>`).join('')+
  `<div class="sw" style="border:0;padding:10px 0 4px"><span>À retravailler</span></div><p style="font-size:13px;color:var(--ink);margin:0 0 6px">${weakK?'Kanji encore fragiles : <span style="font-size:20px;color:var(--cy)">'+weakK+'</span>':'Aucun kanji fragile pour l\'instant.'}</p><p style="font-size:13px;color:var(--ink);margin:0 0 6px">${wl.length?'Leçons où tu fais le plus d\'erreurs : '+wl.map(esc).join(' · '):'Pas de leçon en difficulté.'}</p>
<p style="font-size:12px;color:var(--sub)">Série en cours : ${Quest.streak()} jour${Quest.streak()>1?'s':''} · Combats gagnés contre des Yōma : ${S.wild||0} · ${S.gold||0} 円</p>`}};
/* ----- transfert de sauvegarde ----- */
const SaveX={code(){try{return btoa(unescape(encodeURIComponent(JSON.stringify(S))))}catch(e){return ''}},
 load(txt){try{const o=JSON.parse(decodeURIComponent(escape(atob(String(txt).replace(/\s+/g,'')))));if(typeof o!=='object'||typeof o.xp!=='number'||!o.sp)return false;localStorage.setItem('jz3',JSON.stringify(o));return true}catch(e){return false}}};

