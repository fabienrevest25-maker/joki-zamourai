  '@keyframes caUp{0%,100%{transform:translate(0,0) scale(1)}50%{transform:translate(calc(var(--a)*.6%),calc(var(--a)*-1.6%)) scale(1.04)}}@keyframes caDr{0%,100%{transform:translateX(calc(var(--a)*-1%))}50%{transform:translateX(calc(var(--a)*1%))}}@keyframes caFa{from{transform:translateY(0)}to{transform:translateY(calc(var(--a)*1%))}}'+
  '@keyframes caFt{0%,100%{transform:translate(0,0) rotate(0)}50%{transform:translate(var(--x),var(--y)) rotate(var(--rt))}}@keyframes caSn{0%{transform:translate(0,0);opacity:0}12%{opacity:1}82%{opacity:1}100%{transform:translate(var(--x),var(--y));opacity:0}}'+
  '@keyframes caSw{0%,100%{transform:rotate(calc(var(--a)*-1deg))}50%{transform:rotate(calc(var(--a)*1deg))}}@keyframes caSk{0%,100%{transform:skewX(calc(var(--a)*-1deg))}50%{transform:skewX(calc(var(--a)*1deg))}}'+
  '@keyframes caRt{from{transform:scaleX(var(--sx)) rotate(0deg) scaleX(var(--isx))}to{transform:scaleX(var(--sx)) rotate(calc(var(--a)*360deg)) scaleX(var(--isx))}}@keyframes caTr{0%{transform:translate(var(--x0),var(--y0));opacity:0}7%{opacity:1}88%{opacity:1}100%{transform:translate(var(--x1),var(--y1));opacity:0}}@keyframes caPu{0%{transform:translate(0,0) scale(1);opacity:0}12%{opacity:var(--a)}100%{transform:translate(var(--x),var(--y)) scale(var(--s));opacity:0}}@keyframes caWv{0%,100%{transform:translate(0,0)}50%{transform:translate(var(--x),var(--y))}}@keyframes caPl{0%{transform:translate(0,0) scale(.85);opacity:0}15%{opacity:var(--a)}55%{opacity:calc(var(--a)*.6)}100%{transform:translate(var(--x),-150%) scale(2.6,2.3);opacity:0}}';document.head.appendChild(st)}
 const AN={gl:'caGl',gf:'caGf',up:'caUp',dr:'caDr',fa:'caFa',ft:'caFt',sn:'caSn',sw:'caSw',sk:'caSk',pl:'caPl',pu:'caPu',wv:'caWv',tr:'caTr',rt:'caRt'},LIN={pl:1,fa:1,sn:1,pu:1,tr:1,rt:1};
 const lay=(c,e)=>{const[x,y,w,h]=e.r,W=c.w,H=c.h,P=(v,t)=>(v/t*100).toFixed(3)+'%',A=AN[e.t];
  let s=`left:${P(x,W)};top:${P(y,H)};width:${P(w,W)};height:${P(h,H)};`;
  if(A)s+=`--a:${e.a==null?1:e.a};animation:${A} ${e.d||4}s ${LIN[e.t]?'linear':'ease-in-out'} ${e.de||0}s infinite;`;
  if(e.x!=null)s+=`--x:${e.x}%;`;if(e.y!=null)s+=`--y:${e.y}%;`;if(e.z!=null)s+=`--s:${e.z};`;if(e.x0!=null)s+=`--x0:${e.x0}%;--y0:${e.y0}%;--x1:${e.x1}%;--y1:${e.y1}%;opacity:0;`;if(e.t==='pu')s+='transform-origin:50% 100%;opacity:0;';if(e.rt!=null)s+=`--rt:${e.rt}deg;`;if(e.t==='rt')s+=`--sx:${e.sx||1};--isx:${(1/(e.sx||1)).toFixed(4)};`;
  if(e.o)s+=`transform-origin:${e.o};`;if(e.t==='pl')s+='transform-origin:50% 100%;opacity:0;';if(e.op!=null)s+=`opacity:${e.op};`;
  if(e.k)return IM[e.k]?`<img src="${IM[e.k]}" alt="" style="${s}">`:'';
  if(!e.mk||!IM[e.mk])return'';
  s+=`background-image:var(--cab);background-size:${P(W,w)} ${P(H,h)};background-position:${w>=W?'0%':P(x,W-w)} ${h>=H?'0%':P(y,H-h)};-webkit-mask-image:url(${IM[e.mk]});mask-image:url(${IM[e.mk]});-webkit-mask-size:100% 100%;mask-size:100% 100%;`;
  if(e.f)s+=`filter:${e.f};`;
  return `<div style="${s}"></div>`};
 function hook(box,el){if(document.getElementById('cast'))return;const stg=document.createElement('div');stg.id='cast';box.appendChild(stg);let cur=null;
  const place=()=>{if(stg.style.display!=='block')return;const nw=el.naturalWidth,nh=el.naturalHeight;if(!nw)return;const B=box.getBoundingClientRect(),E=el.getBoundingClientRect();if(!E.width)return;
   const s=Math.min(E.width/nw,E.height/nh),w=nw*s,h=nh*s;stg.style.left=(E.left-B.left+(E.width-w)/2)+'px';stg.style.top=(E.top-B.top)+'px';stg.style.width=w+'px';stg.style.height=h+'px'};
  const vis=v=>{if(el.style.visibility!==v)el.style.visibility=v};
  const build=()=>{const k=el.dataset.k,c=CAC[k];
   if(!c||el.style.display==='none'||!IM[k]||window.CAOFF){stg.style.display='none';if(cur){stg.innerHTML='';cur=null}vis('');return}
   if(cur!==k){cur=k;stg.innerHTML=`<div class="cak" style="--cab:url(${IM[k]})"><img src="${IM[k]}" alt="" style="left:0;top:0;width:100%;height:100%">${c.l.map(e=>lay(c,e)).join('')}</div>`}
   stg.style.display='block';vis('hidden');place();requestAnimationFrame(place)};
  const sync=()=>{const o=el.style.opacity;stg.style.opacity=o===''?'1':o;build()};
  new MutationObserver(sync).observe(el,{attributes:true,attributeFilter:['src','style','data-k']});
  el.addEventListener('load',place);addEventListener('resize',place);sync()}
 /* décors de combat : les mêmes calques, posés exactement sur le fond (#bsBg, object-fit:cover), sous les combattants */
 {const st=document.createElement('style');st.textContent='#bsCa{position:absolute;pointer-events:none;overflow:hidden}#bsCa .cab{position:absolute}#bsCa .cab>*{position:absolute;background-repeat:no-repeat;will-change:transform,opacity}';document.head.appendChild(st)}
 let obs=null;
 function bat(){const img=document.getElementById('bsBg');if(!img)return;let ov=document.getElementById('bsCa');const src=img.getAttribute('src');
  const k=src&&Object.keys(CAC).find(q=>q.startsWith('B_')&&IM[q]===src);
  if(!obs&&window.MutationObserver){obs=new MutationObserver(()=>bat());obs.observe(img,{attributes:true,attributeFilter:['src','class']});if(window.ResizeObserver)new ResizeObserver(()=>{if(document.getElementById('bsCa'))bat()}).observe(img)}
  if(!k||window.CAOFF){if(ov)ov.remove();return}
  if(!ov){ov=document.createElement('div');ov.id='bsCa';img.after(ov)}
  const c=CAC[k];if(ov.dataset.k!==k){ov.dataset.k=k;ov.innerHTML=`<div class="cab" style="--cab:url(${IM[k]})">${c.l.map(e=>lay(c,e)).join('')}</div>`}
  const cs=getComputedStyle(img),W=img.offsetWidth,H=img.offsetHeight,s=Math.max(W/c.w,H/c.h),w=c.w*s,h=c.h*s,op=(cs.objectPosition||'50% 50%').split(' ').map(v=>parseFloat(v)/100);
  Object.assign(ov.style,{left:img.offsetLeft+'px',top:img.offsetTop+'px',width:W+'px',height:H+'px',filter:cs.filter,animation:cs.animationName&&cs.animationName!=='none'?cs.animation:'none',transform:cs.animationName&&cs.animationName!=='none'?'':cs.transform});
  const b=ov.firstChild;Object.assign(b.style,{left:((W-w)*(isNaN(op[0])?.5:op[0]))+'px',top:((H-h)*(isNaN(op[1])?.5:op[1]))+'px',width:w+'px',height:h+'px'})}
 addEventListener('resize',()=>{if(document.getElementById('bsCa'))bat()});
 /* scènes en canevas (trajets, réveils de boss) : mêmes calques, rejoués image par image par-dessus le fond déjà dessiné */
 const CVK=new WeakMap(),IMC={},MKC=new WeakMap();
 const cimg=k=>{let i=IMC[k];if(!i){if(!IM[k])return null;i=IMC[k]=new Image();i.src=IM[k]}return i.complete&&i.naturalWidth?i:null};
 const kOf=bg=>{let k=CVK.get(bg);if(k===undefined){k=null;const src=bg.src||'';for(const q in CAC)if(IM[q]&&IM[q].length===src.length&&IM[q]===src){k=q;break}CVK.set(bg,k)}return k};
 const msk=(bg,c,e)=>{let m=MKC.get(e);if(m)return m;const mk=cimg(e.mk);if(!mk)return null;const q=bg.naturalWidth/c.w,[x,y,w,h]=e.r,cw=Math.max(1,Math.round(w*q)),ch=Math.max(1,Math.round(h*q));
  const v=document.createElement('canvas');v.width=cw;v.height=ch;const x2=v.getContext('2d');if(e.f)x2.filter=e.f;x2.drawImage(bg,x*q,y*q,w*q,h*q,0,0,cw,ch);x2.filter='none';x2.globalCompositeOperation='destination-in';x2.drawImage(mk,0,0,cw,ch);MKC.set(e,v);return v};
 const SE=u=>u*u*(3-2*u),TRI=p=>p<.5?2*p:2-2*p,GF=[[0,.3],[.1,1],[.22,.5],[.35,1],[.5,.2],[.68,1],[.82,.45],[1,.3]];
 const gfv=p=>{for(let i=1;i<GF.length;i++)if(p<=GF[i][0]){const[a0,v0]=GF[i-1],[a1,v1]=GF[i];return v0+(v1-v0)*SE((p-a0)/(a1-a0))}return .3};
 function cv(g,bg,X0,Y0,DW,DH){if(window.CAOFF||(window.S&&S.fxoff))return;const k=kOf(bg);if(!k)return;const c=CAC[k],sx=DW/c.w,sy=DH/c.h,t=performance.now()/1000,CW=g.canvas.width,CH=g.canvas.height;
  for(const e of c.l){const[x,y,w,h]=e.r,W=w*sx,H=h*sy,L=X0+x*sx,T=Y0+y*sy,m=Math.max(W,H)*1.2+40;if(L+W+m<0||L-m>CW||T+H+m<0||T-m>CH)continue;
   const im=e.k?cimg(e.k):e.mk?msk(bg,c,e):null;if(!im)continue;
   const d=e.d||4,p=(((t-(e.de||0))/d)%1+1)%1,a=e.a==null?1:e.a,q=SE(TRI(p));let op=e.op==null?1:e.op,tx=0,ty=0,sc=1,scy=0,rot=0,skx=0,ox=.5,oy=.5;
   if(e.o){const o=e.o.split(' ');ox=parseFloat(o[0])/100;oy=parseFloat(o[1])/100}
   switch(e.t){case 'gl':op=a*q;break;case 'gf':op=a*gfv(p);break;
    case 'up':tx=a*.006*W*q;ty=-a*.016*H*q;sc=1+.04*q;break;case 'dr':tx=a*.01*W*(2*q-1);break;case 'fa':ty=a*.01*H*p;break;
    case 'ft':tx=e.x/100*W*q;ty=e.y/100*H*q;rot=(e.rt||0)*q;break;
    case 'sn':tx=e.x/100*W*p;ty=e.y/100*H*p;op=p<.12?p/.12:p>.82?(1-p)/.18:1;break;
    case 'sw':rot=a*(2*q-1);break;case 'sk':skx=a*(2*q-1);break;
    case 'tr':tx=(e.x0+(e.x1-e.x0)*p)/100*W;ty=(e.y0+(e.y1-e.y0)*p)/100*H;op=p<.07?p/.07:p>.88?(1-p)/.12:1;break;
    case 'pu':tx=e.x/100*W*p;ty=e.y/100*H*p;sc=1+((e.z||1)-1)*p;ox=.5;oy=1;op=p<.12?a*p/.12:a*(1-(p-.12)/.88);break;
    case 'wv':tx=e.x/100*W*q;ty=e.y/100*H*q;break;case 'rt':rot=a*360*p;break;
    case 'pl':tx=e.x/100*W*p;ty=-1.5*H*p;sc=.85+1.75*p;scy=.85+1.45*p;ox=.5;oy=1;op=p<.15?a*p/.15:p<.55?a*(1-.4*(p-.15)/.4):a*.6*(1-(p-.55)/.45);break}
   if(op<=.003)continue;const px=L+ox*W,py=T+oy*H;
   g.save();g.globalAlpha=Math.min(1,op);g.translate(px+tx,py+ty);if(rot){const k_=e.t==='rt'&&e.sx?e.sx:1;if(k_!==1)g.scale(k_,1);g.rotate(rot*Math.PI/180);if(k_!==1)g.scale(1/k_,1)}if(skx)g.transform(1,0,Math.tan(skx*Math.PI/180),1,0,0);if(sc!==1||scy)g.scale(sc,scy||sc);g.drawImage(im,-ox*W,-oy*H,W,H);g.restore()}}
 /* écran-titre : les calques de l'illustration (fumée de la cité, lueur du dos de Kaito, flammes de Kage, bambous, nuages) posés sur l'image du titre */
 {const st=document.createElement('style');st.textContent='#tiCa{position:absolute;left:0;top:0;width:100%;pointer-events:none;overflow:hidden;z-index:0}#tiCa .cab{position:absolute;inset:0}#tiCa .cab>*{position:absolute;background-repeat:no-repeat;will-change:transform,opacity}';document.head.appendChild(st)}
 function tit(){const ti=document.getElementById('tit'),c=CAC.TITLE;if(!ti||!c||window.CAOFF||!IM.TITLE)return false;const need=c.l.map(e=>e.k||e.mk).filter(Boolean);if(need.some(k=>!IM[k]))return false;
  let ov=document.getElementById('tiCa');if(!ov){ov=document.createElement('div');ov.id='tiCa';ov.style.aspectRatio=c.w+'/'+c.h;ov.innerHTML=`<div class="cab" style="--cab:url(${IM.TITLE})">${c.l.map(e=>lay(c,e)).join('')}</div>`;ti.prepend(ov)}return true}
 {let n=0;const iv=setInterval(()=>{if(tit()||++n>240)clearInterval(iv)},500)}
 return{hook,CAC,bat,cv,tit}})();

/* ---------- carte du monde : la végétation ondule au vent (cisaillement des images existantes, pied fixe) ----------
   Les objets animés ne sont plus peints dans la bande fixe : ils sont redessinés à chaque image, triés avec les
   personnages ; les objets fixes posés devant eux sont repeints par-dessus, découpés à leur cadre. */
window.WAN=(()=>{
 let KM=new Map();
 const key=im=>{let k=KM.get(im);if(k===undefined){KM=new Map();for(const q in XI){const v=XI[q];if(v&&typeof v==='object')KM.set(v,q)}k=KM.get(im);if(k===undefined){k='';KM.set(im,'')}}return k};
 /* a : écart du sommet en pixels de carte, f : vitesse, g : herbe (première coupée si l'appareil peine) */
 const CF=[[/^X_RT[01]$/,{a:2.1,f:.75}],[/^X_BAM[0-6]$/,{a:2.6,f:.8}],[/^X_(TR([3-9]|10)|GT\d|AT\d|RT[23]|SP\d|B17_PINE)$/,{a:1.35,f:.9}],
  [/^X_(TR[0-2]|ABUSH|GBUSH|RBUSH)$/,{a:.7,f:1.15}],[/^X_D_bparasol$/,{a:.7,f:.6}],[/^X_(TG\d|AG\d|SG\d|RREED\d|SU\d|BAM7|GIRIS|HG\d+_\d+)$/,{a:1.5,f:1.45,g:1}]];
 const cfg=im=>{const k=key(im);if(!k)return null;for(const[r,c]of CF)if(r.test(k))return c;return null};
 /* lanternes suspendues : le support reste dans la bande fixe (X_k_P), la lanterne découpée (X_k_L) se balance autour du crochet ;
    lumières : les pixels lumineux (X_k_G) rejoués en mode additif, en scintillant */
 const LAN={X_K_LANT:{p:[.371,.0417],a:.11,f:.55},X_P_LANT:{p:[.6778,.0952],a:.075,f:.6},X_FLAMP:{p:[.75,.1771],a:.09,f:.62},X_D_lamp:{p:[.2857,.2281],a:.065,f:.58}};
 const GLO={X_ALANT:.9,X_SLANT:1,X_C_LAMP:1,X_D_gaslamp:.8,X_B18_LAMP:.7,X_K_GLOWM:.6,X_B20_MUSH:.6,X_RPOST:.9};
 const ok=k=>XI[k]&&XI[k].width;
 /* cascades : dans les rochers (X_I…), les pixels d'eau des longues colonnes coulent vers le bas. Le relief (la lumière lissée de chaque colonne)
    reste en place ; seul le grain de l'eau descend, en boucle, donc aucune image nouvelle : ce sont les pixels de la cascade elle-même. */
 const WFM=new Map();
 const anaWF=im=>{const W=im.width,H=im.height;if(!W||!H||W*H>420000)return null;const c=document.createElement('canvas');c.width=W;c.height=H;const g=c.getContext('2d');g.drawImage(im,0,0);let d;try{d=g.getImageData(0,0,W,H).data}catch(e){return null}
  const isW=p=>{const i=p*4,r=d[i],gg=d[i+1],b=d[i+2];return d[i+3]>200&&b>=95&&b-r>=40&&gg-r>=22&&b>=gg-12};
  const Lmin=Math.max(24,H*.15),R=[];let x0=W,x1=-1,y0=H,y1=-1;
  for(let x=0;x<W;x++){let y=0;while(y<H){if(!isW(y*W+x)){y++;continue}let e=y;while(e<H&&isW(e*W+x))e++;if(e-y>=Lmin){R.push([x,y,e-y]);if(x<x0)x0=x;if(x>x1)x1=x;if(y<y0)y0=y;if(e>y1)y1=e}y=e}}
  if(R.length<3)return null;const w=x1-x0+1,h=y1-y0,cv=document.createElement('canvas');cv.width=w;cv.height=h;const cg=cv.getContext('2d'),id=cg.createImageData(w,h);
  let hi=[0,0,0,0];for(const[x,y,L]of R)for(let k=0;k<L;k++){const q=((y+k)*W+x)*4,l=d[q]+d[q+1]+d[q+2];if(l>hi[3])hi=[d[q],d[q+1],d[q+2],l]}
  const runs=R.map(([x,y,L])=>{const col=new Uint8ClampedArray(L*3);for(let j=0;j<L;j++){const i=((y+j)*W+x)*4;col[j*3]=d[i];col[j*3+1]=d[i+1];col[j*3+2]=d[i+2]}
   const h=((x*7919+y*104729)>>>0)%1000/1000;return{x:x-x0,y:y-y0,L,col,h}});
  return{W,H,x0,y0,w,h,runs,cv,cg,id,last:-1,hi}};
 const wfOf=(k,im)=>{if(!WFM.has(k))WFM.set(k,/^X_(I\d|PL(9|20)$)/.test(k)?anaWF(im):null);return WFM.get(k)};
 /* l'eau défile vers le bas (toute la couleur de chaque colonne, raccord fondu), des filets clairs descendent plus vite, l'écume scintille en bas */
 const wfStep=(F,t)=>{const s=Math.floor(t*30);if(s===F.last)return;F.last=s;const D=F.id.data,w=F.w,sp=t*105,H_=F.hi,K=6;
  for(const r of F.runs){const L=r.L,c=r.col,sh=Math.floor(sp*(.85+.3*r.h))%L;
   for(let j=0;j<L;j++){let q=((j-sh)%L+L)%L,R_=c[q*3],G_=c[q*3+1],B_=c[q*3+2];if(q<K){const a=q/K,p_=L-K+q;R_=R_*a+c[p_*3]*(1-a);G_=G_*a+c[p_*3+1]*(1-a);B_=B_*a+c[p_*3+2]*(1-a)}
    const lp=Math.max(3,L*.09);if(j<lp){const a=j/lp;R_=c[j*3]*(1-a)+R_*a;G_=c[j*3+1]*(1-a)+G_*a;B_=c[j*3+2]*(1-a)+B_*a}
    const i=((r.y+j)*w+r.x)*4;D[i]=R_;D[i+1]=G_;D[i+2]=B_;D[i+3]=255}
   /* filets d'écume qui tombent */
   if(r.h<.62){const len=5+((r.h*97)|0)%9,per=L+len,y_=((sp*1.45+r.h*per*3)%per)-len;for(let k=0;k<len;k++){const j=Math.round(y_+k);if(j<0||j>=L)continue;const a=.6*(1-Math.abs(k-len*.35)/len),i=((r.y+j)*w+r.x)*4;D[i]+=(H_[0]-D[i])*a;D[i+1]+=(H_[1]-D[i+1])*a;D[i+2]+=(H_[2]-D[i+2])*a}}
   /* écume du bas */
   for(let j=Math.max(0,L-7);j<L;j++){const hh=((s*31+r.x*17+j*13)*2654435761>>>0)%100;if(hh<30){const i=((r.y+j)*w+r.x)*4;D[i]=D[i]+(240-D[i])*.75;D[i+1]=D[i+1]+(250-D[i+1])*.75;D[i+2]=255}}}
  F.cg.putImageData(F.id,0,0)};
 /* fumées des bâtiments : le panache existant ondule par fines bandes, et des bouffées prises dans son sommet montent, grossissent et s'effacent */
 const SMK={X_V_ZT5:[[72,8,160,136]],X_V_MINE20:[[75,58,96,86],[440,40,466,88],[474,40,526,124]],
  X_B19_VENT:[[12,0,42,21]],X_FT1:[[15,0,62,30]],X_D_noodle:[[18,0,58,29]],X_D_smokebar:[[38,0,57,18]],X_B21_INCENSE:[[8,0,42,26,80,110]]},SMC=new Map(),PFK=new Set(['X_FT1','X_B19_VENT','X_D_noodle','X_D_smokebar','X_B21_INCENSE']);
 const anaSM=(k,im)=>{if(SMC.has(k))return SMC.get(k);let out=null;const R=SMK[k];if(R&&im&&im.width){try{const c=document.createElement('canvas');c.width=im.width;c.height=im.height;const g=c.getContext('2d');g.drawImage(im,0,0);out=[];
   for(const[x0,y0,x1,y1,TL,ML]of R){const w=x1-x0,h=y1-y0,dd=g.getImageData(x0,y0,w,h),D=dd.data,tl=TL||32,ml=ML||100;let n=0,top=h,bot=0,sx=0;
    for(let i=0;i<w*h;i++){const r=D[i*4],gg=D[i*4+1],b=D[i*4+2],mx=Math.max(r,gg,b),mn=Math.min(r,gg,b),L=(r+gg+b)/3;if(D[i*4+3]>20&&mx-mn<tl&&L>=ml){n++;const yy=(i/w)|0;top=Math.min(top,yy);bot=Math.max(bot,yy);sx+=i%w}else D[i*4+3]=0}
    if(n<12)continue;const sc=document.createElement('canvas');sc.width=w;sc.height=h;sc.getContext('2d').putImageData(dd,0,0);
    /* bouffées : des morceaux ronds du panache, bords fondus */
    const P=[],r0=Math.max(4,Math.round(Math.min(w,(bot-top))*.32));
    for(const f of[.25,.5,.72]){const cy=Math.round(top+(bot-top)*f),cx=Math.round(sx/n),pc=document.createElement('canvas');pc.width=pc.height=r0*2;const pg=pc.getContext('2d');pg.drawImage(sc,cx-r0,cy-r0,r0*2,r0*2,0,0,r0*2,r0*2);
     pg.globalCompositeOperation='destination-in';const gr=pg.createRadialGradient(r0,r0,0,r0,r0,r0);gr.addColorStop(0,'rgba(0,0,0,1)');gr.addColorStop(.55,'rgba(0,0,0,.85)');gr.addColorStop(1,'rgba(0,0,0,0)');pg.fillStyle=gr;pg.fillRect(0,0,r0*2,r0*2);P.push(pc)}
    out.push({x0,y0,w,h,top,bot,cx:sx/n,c:sc,P,r0})}}catch(e){out=null}}if(out&&!out.length)out=null;SMC.set(k,out);return out};
 /* le panache ondule par bandes, et des bouffées sortent de sa base, montent au-dessus du toit en grossissant et s'effacent */
 const smoke=(g,S_,im,cx,by,w,hh,fl,t,ph)=>{const s=w/im.width,L=cx-w/2,T_=by-hh;g.save();if(fl){g.translate(cx,0);g.scale(-1,1);g.translate(-cx,0)}
  for(const q of S_){const X0=L+q.x0*s,Y0=T_+q.y0*s,N=7,span=(q.bot-q.top)*s,rise=span+Math.max(18,span*.9),D_=3.4+span*.012;
   for(let y=q.top;y<=q.bot;y+=2){const dx=Math.sin(t*2.1-y*.16+ph)*1.4*s*(1+(q.bot-y)/(q.bot-q.top+1));g.drawImage(q.c,0,y,q.w,2,X0+dx,Y0+y*s,q.w*s,2*s)}
   for(let i=0;i<N;i++){const p=((t/D_+i/N+ph*.13)%1+1)%1,pc=q.P[i%q.P.length],sz=q.r0*2*s*(.55+1.25*p),a=(p<.12?p/.12:Math.pow(1-(p-.12)/.88,1.3))*.9,
     mx=X0+q.cx*s+Math.sin(t*1.3+i*2.4+ph)*(2+6*p)*s+p*5*s,my=Y0+q.bot*s-q.r0*s*.4-p*rise;
    g.globalAlpha=a;g.drawImage(pc,mx-sz/2,my-sz/2,sz,sz)}g.globalAlpha=1}g.restore()};

 /* ---------- objets vivants : pièces qui se balancent, tissus qui ondulent, feux, lampes, signaux, cristaux, bateaux, vapeurs ----------
    tout est découpé à l'exécution dans les images existantes (masques de couleur, composantes connexes) : aucune image nouvelle */
 const SEL={paper:(r,g,b,a)=>a>40&&(r+g+b)/3>=185&&Math.max(r,g,b)-Math.min(r,g,b)<50,fish:(r,g,b,a)=>{const l=(r+g+b)/3;return a>40&&l>=45&&l<=150&&Math.abs(r-b)<=14&&Math.max(r,g,b)-Math.min(r,g,b)<=26},any:(r,g,b,a)=>a>40,chime:(r,g,b,a)=>a>40&&!(r>=b+25&&r-g<=35&&g-r<=10),tan:(r,g,b,a)=>a>40&&r>150&&g>95&&b<150&&r-g>=25&&r-g<=95,
  fire:(r,g,b,a)=>a>40&&r>=190&&g>=70&&b<=150&&r-b>=80,blue:(r,g,b,a)=>a>40&&((b>=190&&b-r>=45)||(r+g+b)/3>=235),lamp:(r,g,b,a)=>a>40&&(r+g+b)/3>=200,
  lamp2:(r,g,b,a)=>a>40&&(r+g+b)/3>=175,red:(r,g,b,a)=>a>40&&r>=170&&g<=110&&b<=120&&r-g>=80,tw:(r,g,b,a)=>a>40&&(r+g+b)/3>=205,
  sgR:(r,g,b,a)=>a>40&&r>=110&&r-g>=45&&r-b>=35,sgG:(r,g,b,a)=>a>40&&g>=90&&g-r>=25&&g-b>=5,wat:(r,g,b,a)=>a>40&&b>=180&&g>=150&&r<=175};
 const cvs=(w,h)=>{const c=document.createElement('canvas');c.width=w;c.height=h;return c};
 const pix=im=>{const c=cvs(im.width,im.height),g=c.getContext('2d');g.drawImage(im,0,0);return{W:im.width,H:im.height,D:g.getImageData(0,0,im.width,im.height).data}};
 const put=(nm,c)=>{XI[nm]=c;KM.set(c,nm);return c};
 const fromMask=(P,m)=>{const c=cvs(P.W,P.H),g=c.getContext('2d'),id=g.createImageData(P.W,P.H),o=id.data,D=P.D;for(let i=0;i<P.W*P.H;i++)if(m[i]){const j=i*4;o[j]=D[j];o[j+1]=D[j+1];o[j+2]=D[j+2];o[j+3]=D[j+3]}g.putImageData(id,0,0);return c};
 /* lueur : les pixels lumineux de l'objet lui-même, plus un halo flou de ces mêmes pixels ; _y1 = bas de la flamme (pour l'étirer depuis sa base) */
 const GNEG=new Set();const glowOf=(nm,im,sel,r,bo)=>{if(XI[nm]&&XI[nm].width)return XI[nm];if(!im||!im.width)return null;if(GNEG.has(nm))return null;let c=null;try{const P=pix(im),W=P.W,H=P.H,D=P.D,f=SEL[sel],m=new Uint8Array(W*H),[x0,y0,x1,y1]=r||[0,0,W,H];let n=0,yb=0;
   for(let y=Math.max(0,y0);y<Math.min(H,y1);y++)for(let x=Math.max(0,x0);x<Math.min(W,x1);x++){const i=y*W+x,j=i*4;if(f(D[j],D[j+1],D[j+2],D[j+3])){m[i]=1;n++;if(y>yb)yb=y}}
   if(n>=3){const k=fromMask(P,m);if(bo){const kg=k.getContext('2d'),id=kg.getImageData(0,0,W,H),q=id.data;for(let i=0;i<q.length;i+=4)if(q[i+3]){const f=255/Math.max(1,q[i],q[i+1],q[i+2]);q[i]*=f;q[i+1]*=f;q[i+2]*=f}kg.putImageData(id,0,0)}c=cvs(W,H);const g=c.getContext('2d');try{g.filter=`blur(${Math.max(1.5,W/45).toFixed(1)}px)`;g.drawImage(k,0,0);g.filter='none'}catch(e){}g.globalAlpha=.85;g.drawImage(k,0,0);c._y1=(yb+1)/H;put(nm,c)}}catch(e){c=null}if(!c)GNEG.add(nm);return c};
 const GL2={X_D_fire:[['fire',1.8,'st']],X_D_cfire:[['fire',1.8,'st']],X_D_kfire:[['blue',1.6,'st']],X_D_bkettle:[['fire',1.6,'st',[0,52,62,78]]],X_B21_CANDLE:[['fire',2,0,0,1]],
  X_D_clamp:[['lamp2',1.5,0,[0,0,24,40]]],X_D_ilamp:[['lamp',1.5]],X_D_zlamp:[['lamp',1.4]],X_D_yatai:[['red',1.2,0,0,1]],X_B20_CRYST:[['tw',1.3,'tw']],X_FT0:[['fire',1.6,'st']],X_FT2:[['fire',1.3]],X_B21_BASIN:[['wat',1.1,'tw']],
  X_D_wsignal:[['sgR',1.1,'sa',0,1],['sgG',1.1,'sb',0,1]],X_W_SIGNAL:[['sgR',1.1,'sa',0,1],['sgG',1.1,'sb',0,1]]};
 /* pièces suspendues : composantes connexes sous la barre, regroupées (une clochette et son papier, une lanterne et son gland), chacune pivote sur son attache */
 const SWG={X_D_gpaper:{s:'paper',r:[8,8,82,64],mn:10,gm:16,a:.34,f:1.05},X_D_fishr:{s:'fish',r:[20,22,72,66],dl:1,mn:12,gm:24,a:.11,f:.6},X_D_wchime:{s:'chime',r:[9,6,54,68],mn:12,gm:40,a:.17,f:.95},X_D_lanterns:{s:'any',r:[17,11,107,96],mn:20,gm:40,a:.055,f:.5},
  X_D_opendul:{s:'any',r:[17,8,43,63],mn:20,gm:40,a:.2,pd:2.4},X_B20_LPOST:{s:'any',r:[0,9,24,52],mn:20,gm:40,a:.07,f:.55,gl:'lamp'},
  X_B21_EMA:{s:'tan',r:[0,0,76,72],dl:1,mn:20,gm:40,a:.05,f:.7},X_D_wbell:{s:'any',r:[13,9,44,48],mn:20,gm:40,a:.12,f:.55},X_D_fishrack:{s:'chime',r:[14,15,80,62],mn:12,gm:30,a:.06,f:.6},X_B19_EMA:{s:'tan',r:[0,0,73,66],dl:1,mn:20,gm:40,a:.05,f:.7}},SWC=new Map();
 const swOf=(k,im)=>{if(SWC.has(k))return SWC.get(k);if(!im||!im.width)return null;let out=null;const C=SWG[k];try{const P=pix(im),W=P.W,H=P.H,D=P.D,f=SEL[C.s],N=W*H,m=new Uint8Array(N),[x0,y0,x1,y1]=C.r;
   for(let y=y0;y<Math.min(H,y1);y++)for(let x=x0;x<Math.min(W,x1);x++){const j=(y*W+x)*4;if(f(D[j],D[j+1],D[j+2],D[j+3]))m[y*W+x]=1}
   if(C.dl){const ad=new Uint8Array(N);for(let y=1;y<H-1;y++)for(let x=1;x<W-1;x++){const i=y*W+x;if(m[i]||D[i*4+3]<=40||(D[i*4]+D[i*4+1]+D[i*4+2])/3>=75)continue;let h=0;for(let dy=-1;dy<=1;dy++)for(let dx=-1;dx<=1;dx++)if(m[i+dy*W+dx])h=1;if(h)ad[i]=1}for(let i=0;i<N;i++)if(ad[i])m[i]=1}
   const lab=new Int32Array(N),cs=[];let nl=0;
   for(let i=0;i<N;i++){if(!m[i]||lab[i])continue;nl++;const q=[i];lab[i]=nl;let a=0,bx0=W,by0=H,bx1=-1,by1=-1;
    while(q.length){const p=q.pop(),x=p%W,y=(p/W)|0;a++;if(x<bx0)bx0=x;if(x>bx1)bx1=x;if(y<by0)by0=y;if(y>by1)by1=y;
     for(let dy=-1;dy<=1;dy++)for(let dx=-1;dx<=1;dx++){const xx=x+dx,yy=y+dy;if(xx<0||yy<0||xx>=W||yy>=H)continue;const pp=yy*W+xx;if(m[pp]&&!lab[pp]){lab[pp]=nl;q.push(pp)}}}
    if(a>=C.mn&&by1-by0>=4)cs.push({l:nl,x0:bx0,y0:by0,x1:bx1,y1:by1,n:a})}
   cs.sort((a,b)=>a.y0-b.y0||b.n-a.n);const GR=[];
   for(const c of cs){let best=null;for(const g of GR)if(c.x0<=g.x1&&c.x1>=g.x0&&c.y0>g.y0+4&&c.y0<=g.y1+6&&(!best||g.y1>best.y1))best=g;
    if(best){best.L.push(c.l);best.x0=Math.min(best.x0,c.x0);best.x1=Math.max(best.x1,c.x1);best.y1=Math.max(best.y1,c.y1);best.n+=c.n}else GR.push({L:[c.l],x0:c.x0,y0:c.y0,x1:c.x1,y1:c.y1,n:c.n})}
   const parts=[],used=new Uint8Array(N);
   GR.filter(g=>g.n>=C.gm).forEach((g,gi)=>{const S_=new Set(g.L),pm=new Uint8Array(N);let sx=0,sn=0;for(let i=0;i<N;i++)if(lab[i]&&S_.has(lab[i])){pm[i]=1;used[i]=1;if(((i/W)|0)<=g.y0+2){sx+=i%W;sn++}}
    const c=put(k+'~s'+gi,fromMask(P,pm));parts.push({c,p:[(sx/Math.max(1,sn)+.5)/W,g.y0/H],gl:C.gl?glowOf(k+'~g'+gi,c,C.gl):null})});
   if(parts.length){const bm=new Uint8Array(N);for(let i=0;i<N;i++)bm[i]=D[i*4+3]>0&&!used[i]?1:0;out={base:put(k+'~b',fromMask(P,bm)),parts}}}catch(e){console.error(e);out=null}
  SWC.set(k,out);return out};
 /* tissus suspendus (bannières, serviettes, kimonos) : la partie sous l'attache ondule par fines bandes, de plus en plus fort vers le bas */
 const CLO={X_C_BANNER:{r:[12,7,46,51],A:1.4,f:.7},X_D_cbanner:{r:[12,7,46,51],A:1.4,f:.7},X_B19_TOWELS:{r:[12,16,73,44],A:.6,f:.85},X_D_laundry:{r:[13,14,105,69],A:.8,f:.55}},CLC=new Map();
 const clOf=(k,im)=>{if(CLC.has(k))return CLC.get(k);if(!im||!im.width)return null;let out=null;const C=CLO[k];try{const P=pix(im),W=P.W,H=P.H,D=P.D,[x0,y0,x1,y1]=C.r,m=new Uint8Array(W*H),bm=new Uint8Array(W*H);let n=0;
   for(let i=0;i<W*H;i++){if(D[i*4+3]<=0)continue;const x=i%W,y=(i/W)|0;if(x>=x0&&x<x1&&y>=y0&&y<y1){m[i]=1;n++}else bm[i]=1}
   if(n>20)out={base:put(k+'~b',fromMask(P,bm)),c:put(k+'~c',fromMask(P,m)),r:C.r,A:C.A,f:C.f}}catch(e){out=null}CLC.set(k,out);return out};
 /* bateaux sur l'eau : ils tanguent */
 const BOB={X_RBOAT:1,X_D_bboat:1,X_B17_BOAT:1};
 /* la forge : le foyer et la fenêtre rougeoient, les deux cheminées fument (bouffées prises dans le panache de la maison des mines) */
 const BGL={X_FORGE:{g:[['fire',185,180,240,234]],k:1.2,e:[[330,6],[366,8]]},
  X_V_ZC0:{e:[[108,8]]},X_V_ZB7:{e:[[8,12]]},X_V_ZB2:{e:[[200,13]]},X_V_ZG4:{e:[[183,2]]},X_V_ZG9:{e:[[68,2]]},
  X_V_ZD7:{e:[[216,128]]},X_V_ZD2:{e:[[216,128]]},
  X_V_ZI2:{g:[['lamp2',60,78,138,135],['lamp2',80,194,115,218],['red',0,66,25,104],['red',172,66,199,104]],k:.9},X_V_ZI0:{g:[['lamp2',78,110,111,133],['red',0,84,23,125],['red',167,84,190,125]],k:.9},
  X_V_ZF0:{g:[['lamp2',97,89,125,113],['lamp2',140,143,161,167]],k:.8},X_PL9:{g:[['red',0,0,300,110]],k:1},X_PL13:{g:[['blue',0,0,300,163]],k:1.15}};
 /* petits jets de vapeur sur les objets (vannes, tuyaux, chaudron) : bouffées prises dans le panache de la maison des mines */
 const EMT={X_FT2:[[45,54,.7]],X_FT3:[[22,10,.5]],X_D_valve:[[24,3,.6]],X_D_gpneu:[[34,16,.5]],X_D_pgas:[[13,3,.4]]};
 /* girouette : le coq et la flèche tournent autour du mât (le reste ne bouge pas) */
 const YAW={X_D_wvane:{r:[0,0,47,34],px:26}};
 const glowMulti=(nm,im,L)=>{if(XI[nm]&&XI[nm].width)return XI[nm];if(!im||!im.width)return null;if(GNEG.has(nm))return null;let c=null;for(const[s,x0,y0,x1,y1]of L){const q=glowOf(nm+'_'+s+x0,im,s,[x0,y0,x1,y1]);if(q){if(!c)c=cvs(im.width,im.height);c.getContext('2d').drawImage(q,0,0)}}if(c)put(nm,c);else GNEG.add(nm);return c};
 const YAC=new Map();
 const yawOf=(k,im)=>{if(YAC.has(k))return YAC.get(k);if(!im||!im.width)return null;let out=null;const C=YAW[k];try{const P=pix(im),W=P.W,H=P.H,D=P.D,[x0,y0,x1,y1]=C.r,m=new Uint8Array(W*H),bm=new Uint8Array(W*H);
   for(let i=0;i<W*H;i++){if(D[i*4+3]<=0)continue;const x=i%W,y=(i/W)|0;if(x>=x0&&x<x1&&y>=y0&&y<y1)m[i]=1;else bm[i]=1}
   out={base:put(k+'~b',fromMask(P,bm)),c:put(k+'~y',fromMask(P,m)),px:C.px/W}}catch(e){out=null}YAC.set(k,out);return out};
 const puffs=(g,q,x,y,k,t,ph)=>{const N=6,D_=3.1;for(let i=0;i<N;i++){const p=((t/D_+i/N+ph*.13)%1+1)%1,pc=q.P[i%q.P.length],sz=(3.5+10*p)*k,a=(p<.12?p/.12:Math.pow(1-(p-.12)/.88,1.4))*.7,
   mx=x+Math.sin(t*1.3+i*2.4+ph)*(1+3*p)*k+p*5*k,my=y-p*30*k;g.globalAlpha=a;g.drawImage(pc,mx-sz/2,my-sz/2,sz,sz)}g.globalAlpha=1};
 window.__PUFF=(g,x,y,k,t,ph)=>{const S5=ok('X_V_ZT5')?anaSM('X_V_ZT5',XI.X_V_ZT5):null;if(S5&&S5[0])puffs(g,S5[0],x,y,k,t,ph)};
 const prep=(o,SPL)=>{const k=key(o.im);if(!k)return;const L=LAN[k];
  {const F=wfOf(k,o.im);if(F){SPL.push({x:o.x,y:o.y,im:F.cv,w:o.w,hh:o.hh,dx:o.dx,dy:o.dy,sy:o.sy+.01,an:{t:'W',F}});return}}
  if(L&&ok(k+'_P')&&ok(k+'_L')){o.im=XI[k+'_P'];SPL.push({x:o.x,y:o.y,im:XI[k+'_L'],w:o.w,hh:o.hh,dx:o.dx,dy:o.dy,sy:o.sy+.01,an:{t:'L',p:L.p,a:L.a,f:L.f,gl:ok(k+'_G')?XI[k+'_G']:null}});return}
  if(GLO[k]&&ok(k+'_G')){SPL.push({x:o.x,y:o.y,im:XI[k+'_G'],w:o.w,hh:o.hh,dx:o.dx,dy:o.dy,sy:o.sy+.01,an:{t:'G',a:0,k:GLO[k]}});return}
  if(window.LGW&&LGW[k]&&o.im.width){const G_=LGW[k](o.im);if(G_){SPL.push({x:o.x,y:o.y,im:G_,w:o.w,hh:o.hh,dx:o.dx,dy:o.dy,sy:o.sy+.01,an:{t:'G',a:0,k:.95,m:'lw'}});return}}if(GL2[k]&&o.im.width){GL2[k].forEach(([s_,k_,m_,r_,b_],i)=>{const G_=glowOf(k+'~G'+i,o.im,s_,r_||null,b_);if(G_)SPL.push({x:o.x,y:o.y,im:G_,w:o.w,hh:o.hh,dx:o.dx,dy:o.dy,sy:o.sy+.01+i*.001,an:{t:'G',a:0,k:k_,m:m_}})});if(!EMT[k])return}
  if(EMT[k]&&o.im.width){SPL.push({x:o.x,y:o.y,im:o.im,w:o.w,hh:o.hh,dx:o.dx,dy:o.dy,sy:o.sy+.02,an:{t:'E',e:EMT[k]}});return}
  if(window.WANX&&WANX[k]){const q_=WANX[k](o);if(q_){o.an=q_;return}}if(YAW[k]){const A=yawOf(k,o.im);if(A){o.im=A.base;SPL.push({x:o.x,y:o.y,im:A.c,w:o.w,hh:o.hh,dx:o.dx,dy:o.dy,sy:o.sy+.01,an:{t:'Y',px:A.px}})}return}
  if(SWG[k]){const A=swOf(k,o.im);if(A){o.im=A.base;const C=SWG[k];A.parts.forEach((P_,i)=>SPL.push({x:o.x,y:o.y,im:P_.c,w:o.w,hh:o.hh,dx:o.dx,dy:o.dy,sy:o.sy+.01+i*.001,an:{t:'L',p:P_.p,a:C.a,f:C.f||.6,pd:C.pd,ph:i*1.9,gl:P_.gl}}))}return}
  if(CLO[k]){const A=clOf(k,o.im);if(A){o.im=A.base;SPL.push({x:o.x,y:o.y,im:A.c,w:o.w,hh:o.hh,dx:o.dx,dy:o.dy,sy:o.sy+.01,an:{t:'C',r:A.r,A:A.A,f:A.f}})}return}
  if(BOB[k]){if(wat(o.x,o.y)||wat(o.x,o.y+1))o.an={t:'B',a:0,f:1};return}
  if(PFK.has(k)){const S_=anaSM(k,o.im);if(S_)SPL.push({x:o.x,y:o.y,im:o.im,w:o.w,hh:o.hh,dx:o.dx,dy:o.dy,sy:o.sy+.01,an:{t:'P',S:S_}});return}
  for(const[r,c]of CF)if(r.test(k)){o.an=c;return}};
 const fl=(t,o,k)=>{const ph=o.x*1.7+o.y*.9;return Math.max(0,(.2+.13*Math.sin(t*4.7+ph)+.07*Math.sin(t*11.3+ph*2.1)+.05*Math.sin(t*23+ph))*k)};
 let BR={},ID=new Map(),NR=0,LV=2,ema=0,lastT=0,bad=0,inv=null;
 let RF={},RID=new Map(),RB=null;
 const reset=()=>{BR={};ID=new Map();NR=0;RF={};RID=new Map();RB=null};
 /* reflets dans l'eau : l'image retournée, découpée aux cases d'eau, ondulée par fines bandes */
 const WM=()=>MAPS.world,wat=(x,y)=>{const M=WM(),r=M.rows[y];if(!r||r[x]!=='~')return false;const z=M.zone(y);return z!==10&&z!==11&&z!==12};
 const cells=(x0,x1,by,hh)=>{const c=[],r0=Math.floor(by/16),r1=Math.floor((by+hh)/16);for(let r=r0;r<=r1;r++)for(let x=Math.floor(x0/16);x<=Math.floor((x1-1)/16);x++)if(wat(x,r))c.push([x*16,r*16]);return c};
 const rf=(o,own)=>{if(o.fl||o.bld||(o.an&&(o.an.g||(o.an.t&&o.an.t!=='B'))))return;if(!wat(o.x,o.y+1))return;const id=o.x+'_'+o.y+'_'+o.dx+'_'+o.dy+'_'+key(o.im),old=RID.get(id);if(old&&(old.own||!own))return;
  const b=box(o),q={o,own,c:cells(b[0],b[0]+b[2],o.sy,o.hh)};if(!q.c.length)return;RID.set(id,q);const row=RF[o.y]||(RF[o.y]=[]);if(old){const k=row.indexOf(old);if(k>=0){row[k]=q;return}}row.push(q)};
 const mirror=(g,im,bx,by,w,hh,X,Y,c,t,s,ph,fl)=>{g.save();g.beginPath();for(const[a,b]of c)g.rect(a-X,b-Y,16,16);g.clip();g.globalAlpha=.3;g.translate(0,by-Y);g.scale(1,-1);
  const sc=im.height/hh,n=Math.max(1,Math.ceil(hh/3));for(let j=0;j<n;j++){const d0=j*3,d1=Math.min(hh,d0+3),sy0=(hh-d1)*sc,sh=(d1-d0)*sc,rp=Math.sin(t*2.3+j*.85+ph)*(.25+.045*d0),sk=s?s*(d0+1.5)/hh:0;
   if(fl){g.save();g.translate(bx-X+rp+sk,0);g.scale(-1,1);g.drawImage(im,0,sy0,im.width,sh,-w/2,-d1,w,d1-d0);g.restore()}else g.drawImage(im,0,sy0,im.width,sh,bx-X-w/2+rp+sk,-d1,w,d1-d0)}g.restore()};
 /* le dessin à l'envers : la bande j (à d0 pixels sous la base) reprend les rangées de l'image à d0 pixels au-dessus de la base */
 const box=o=>[o.x*16+8+o.dx-o.w/2,o.sy-o.hh,o.w,o.hh];
 /* rang de tri : derrière un personnage de la même rangée (comme les bandes fixes), l'ordre du décor entre lui est gardé */
 const dep=q=>(q.y+1)*16-1+(q.sy-(q.y+1)*16)*.01;
 const reg=(o,i,SPL,bb,own)=>{const id=o.x+'_'+o.y+'_'+o.dx+'_'+o.dy+'_'+key(o.im),old=ID.get(id);if(old&&(old.own||!own))return;o.own=own;
  const m=o.an.t==='L'?3:(o.an.t==='G'||o.an.t==='W'||o.an.t==='P'||o.an.t==='E'||o.an.t==='Y')?0:(o.an.t==='B'||o.an.t==='C')?2:o.an.a+1,b=box(o),x0=b[0]-m,x1=b[0]+b[2]+m,y0=b[1]-1,y1=o.sy+1;o.occ=[];o.cb=[x0,y0,x1-x0,y1-y0];o.dp=dep(o);
  for(let j=i+1;j<SPL.length;j++){const q=SPL[j];if(q.A||q.fl)continue;const c=q.bld?bb(q.bld):box(q);if(c&&c[0]<x1&&c[0]+c[2]>x0&&c[1]<y1&&c[1]+c[3]>y0)o.occ.push(q)}
  const row=BR[o.y]||(BR[o.y]=[]);ID.set(id,o);if(old){const k=row.indexOf(old);if(k>=0){row[k]=o;return}}row.push(o);NR++;if(inv){const k=key(o.im);inv[k]=(inv[k]||0)+1}};
 const wind=(t,o,c)=>{if(c.pd)return c.a*Math.sin(t*6.2832/c.pd+(c.ph||0)+o.x*.7);const x=o.x+o.dx/16,ph=x*.45+o.y*.13+(c.ph||0),gu=.62+.38*Math.sin(t*.31+x*.05+o.y*.021);return c.a*gu*(Math.sin(t*c.f*2.1-ph)*.75+Math.sin(t*c.f*3.7-ph*1.7+1.3)*.25)};
 const sway=(g,o,bx,by,s,t)=>{const c=o.an;if(c.t==='X'&&window.WANXD){WANXD(g,o,bx,by,t);return}
  if(c.t==='W'){if(S.fxoff)return;const F=c.F;wfStep(F,t);const sx=o.w/F.W,sy=o.hh/F.H;g.drawImage(F.cv,bx-o.w/2+F.x0*sx,by-o.hh+F.y0*sy,F.w*sx,F.h*sy);return}
  if(c.t==='G'){if(S.fxoff||LV<1)return;const ph=o.x*1.7+o.y*.9;let a;
   if(c.m==='lw'){a=c.k*(.8+.12*Math.sin(t*5.3+ph)+.07*Math.sin(t*12.7+ph*1.7))*(window.__NIGHT?1.2:1)}else if(c.m==='tw'){const v=Math.sin(t*1.7+ph)*Math.sin(t*.63+ph*2.3);a=c.k*Math.pow(Math.max(0,v),1.6)}
   else if(c.m==='sa'||c.m==='sb'){const v=Math.sin(t*2.4+ph);a=c.k*.8*Math.pow(Math.max(0,c.m==='sa'?v:-v),.5)}else a=fl(t,o,c.k);
   g.save();g.globalCompositeOperation='lighter';g.globalAlpha=Math.min(1,a);
   if(c.m==='st'&&o.im._y1){const sy=1+.08*Math.sin(t*8.3+ph)+.05*Math.sin(t*13.7+ph*1.9),yb=by-o.hh+o.im._y1*o.hh;g.translate(bx,yb);g.scale(1,sy);g.drawImage(o.im,-o.w/2,-o.im._y1*o.hh,o.w,o.hh)}
   else g.drawImage(o.im,bx-o.w/2,by-o.hh,o.w,o.hh);g.restore();return}
  if(c.t==='C'){const im=o.im,W=im.width,s_=o.w/W,[x0,y0,x1,y1]=c.r,L=bx-o.w/2,T=by-o.hh,ph=o.x*.9+o.y*.37,on=!S.fxoff&&LV>0;
   for(let y=y0;y<y1;y+=2){const h=Math.min(2,y1-y),q=(y-y0)/(y1-y0),dx=on?c.A*Math.pow(q,1.25)*(Math.sin(t*c.f*6.28-y*.21+ph)*.7+Math.sin(t*c.f*9.1-y*.37+ph*1.7)*.3):0;
    g.drawImage(im,x0,y,x1-x0,h,L+x0*s_+dx,T+y*s_,(x1-x0)*s_,h*s_+.35)}return}
  if(c.t==='B'){const ph=o.x*1.3+o.y*.7,on=!S.fxoff&&LV>0,dy=on?Math.sin(t*1.25+ph)*.55:0,r=on?Math.sin(t*.95+ph*1.3)*.035:0;g.save();g.translate(bx,by+dy);if(r)g.rotate(r);g.drawImage(o.im,-o.w/2,-o.hh,o.w,o.hh);g.restore();return}
  if(c.t==='P'){if(S.fxoff||LV<1)return;smoke(g,c.S,o.im,bx,by,o.w,o.hh,false,t,o.x*.37+o.y*.11);return}
  if(c.t==='E'){if(S.fxoff||LV<1)return;const S5=ok('X_V_ZT5')?anaSM('X_V_ZT5',XI.X_V_ZT5):null;if(!S5||!S5[0])return;const s_=o.w/o.im.width,L=bx-o.w/2,T=by-o.hh;g.save();g.globalAlpha*=.5;c.e.forEach(([ex,ey,kk],i)=>puffs(g,S5[0],L+ex*s_,T+ey*s_,(kk||1)*s_*2.2,t,o.x*.37+o.y*.11+i*1.7));g.restore();return}
  if(c.t==='Y'){const on=!S.fxoff&&LV>0,ph=o.x*.53+o.y*.29,th=on?Math.sin(t*.33+ph)*1.25+Math.sin(t*1.7+ph*2)*.12:0,cs=Math.cos(th),cx=bx-o.w/2+c.px*o.w;g.save();g.translate(cx,0);g.scale(Math.abs(cs)<.12?(cs<0?-.12:.12):cs,1);g.translate(-cx,0);g.drawImage(o.im,bx-o.w/2,by-o.hh,o.w,o.hh);g.restore();return}
  if(c.t==='L'){const x0=bx-o.w/2,y0=by-o.hh,px=x0+c.p[0]*o.w,py=y0+c.p[1]*o.hh;g.save();if(s){g.translate(px,py);g.rotate(s);g.translate(-px,-py)}g.drawImage(o.im,x0,y0,o.w,o.hh);
   if(c.gl&&!S.fxoff&&LV>0){g.globalCompositeOperation='lighter';g.globalAlpha=Math.min(1,fl(t,o,.85));g.drawImage(c.gl,x0,y0,o.w,o.hh)}g.restore();return}
  if(!s){g.drawImage(o.im,bx-o.w/2,by-o.hh,o.w,o.hh);return}g.save();g.translate(bx,by);g.transform(1,0,-s/o.hh,1,0,0);g.drawImage(o.im,-o.w/2,-o.hh,o.w,o.hh);g.restore()};
 const shear=(g,o,X,Y,t)=>{if(!o.A||!o.an||o.an.t)return 0;const s=!S.fxoff&&LV>0&&(LV>1||!o.an.g)?wind(t,o,o.an):0;if(!s)return 0;const bx=o.x*16+8+o.dx-X,by=o.sy-Y;g.translate(bx,by);g.transform(1,0,-s/o.hh,1,0,0);g.translate(-bx,-by);return 1};
 const drawRF=(L,g,X,Y,VW,VH,t,on,E,spr,isHD,BL,bI)=>{const r0=Math.floor(Y/16)-7,r1=Math.ceil((Y+VH)/16);
  for(let r=r0;r<=r1;r++){const row=RF[r];if(!row)continue;for(const q of row){const o=q.o,bx=o.x*16+8+o.dx,by=o.sy;if(bx-X+o.w/2<0||bx-X-o.w/2>VW||by-Y>VH||by+o.hh-Y<0)continue;
   const s=on&&o.A&&o.an?wind(t,o,o.an):0;L.push({y:-1e4,f:()=>mirror(g,o.im,bx,by,o.w,o.hh,X,Y,q.c,t,s,o.x*.7,0)})}}
  if(BL&&bI){if(!RB){RB=[];for(const b of BL){const yb=b.y+b.h;let w=0;for(let x=b.x;x<b.x+b.w;x++)if(wat(x,yb))w++;if(w>=Math.min(2,b.w))RB.push(b)}}
   for(const b of RB){const k=bI(b);if(!k)continue;const[im,cx,by,w,hh,fl]=k;if(cx+w/2-X<0||cx-w/2-X>VW||by-Y>VH||by+hh-Y<0)continue;if(!b._rc)b._rc=cells(cx-w/2,cx+w/2,by,hh);if(!b._rc.length)continue;L.push({y:-1e4,f:()=>mirror(g,im,cx,by,w,hh,X,Y,b._rc,t,0,b.x*.7,fl)})}}
  if(E&&spr)for(const e of E){if(!e||e.gone||e.item||e.big||e.boss)continue;const ex=Math.round(e.px),ey=Math.round(e.py);if(!wat(ex,ey+1))continue;const bx=e.px*16+8,by=e.py*16+16;if(bx-X<-30||bx-X>VW+30||by-Y>VH||by-Y<-40)continue;
   const im=spr(e);if(!im||!im.width)continue;let w,hh;if(isHD(im)){const sc=e.rov&&window.RKIND&&RKIND[e.k]?(RKIND[e.k].sc||1):1;w=im.width/3*sc;hh=im.height/3*sc}else{w=im.width;hh=im.height}const c=cells(bx-w/2,bx+w/2,by,hh);if(!c.length)continue;
   const fl=e.dir===2&&false;L.push({y:-1e4+1,f:()=>mirror(g,im,bx,by,w,hh,X,Y,c,t,0,e.px*.7,fl)})}};
 const draw=(L,g,X,Y,VW,VH,t,dB,bW,E,spr,isHD,BL,bI)=>{
  if(lastT){const dt=Math.min(.25,t-lastT);ema=ema*.95+dt*.05;if(ema>1/30){bad+=dt;if(bad>4&&LV>0&&window.WANLV==null){LV--;bad=0;ema=1/60}}else bad=Math.max(0,bad-dt*.5)}lastT=t;if(window.WANLV!=null)LV=WANLV;
  if(!S.fxoff&&LV>0)drawRF(L,g,X,Y,VW,VH,t,LV>0,E,spr,isHD,BL,bI);
  /* cascades des rochers (posés comme des bâtiments) */
  if(!S.fxoff&&BL&&bI){if(!draw.WB||draw.WBn!==BL.length){draw.WBn=BL.length;draw.WB=BL.filter(b=>/^X_(I\d|PL(9|20)$)/.test(b.im)&&XI[b.im]&&wfOf(b.im,XI[b.im]))}
   for(const b of draw.WB){const k=bI(b);if(!k)continue;const[im,cx,by,w,hh,fl]=k;if(cx+w/2-X<0||cx-w/2-X>VW||by-Y<0||by-hh-Y>VH)continue;const F=wfOf(b.im,XI[b.im]);
    L.push({y:bW(b)*16+1.5,f:()=>{wfStep(F,t);const sx=w/F.W,sy=hh/F.H,x0=cx-X-w/2,y0=by-Y-hh;g.save();if(fl){g.translate(cx-X,0);g.scale(-1,1);g.translate(-(cx-X),0)}g.drawImage(F.cv,x0+F.x0*sx,y0+F.y0*sy,F.w*sx,F.h*sy);g.restore()}})}}
  if(!S.fxoff&&LV>0&&BL&&bI){if(!draw.SB||draw.SBn!==BL.length){draw.SBn=BL.length;draw.SB=BL.filter(b=>SMK[b.im])}
   for(const b of draw.SB){const k=bI(b);if(!k)continue;const[im,cx,by,w,hh,fl]=k;if(cx+w/2-X<0||cx-w/2-X>VW||by-Y<-20||by-hh-Y-60>VH)continue;const S_=anaSM(b.im,XI[b.im]);if(!S_)continue;
    L.push({y:bW(b)*16+2,f:()=>smoke(g,S_,XI[b.im],cx-X,by-Y,w,hh,fl,t,b.x*.37+b.y*.11)})}}
  /* échelle réelle d'une image de bâtiment (lue sur un exemplaire non teinté : les teintés ne passent pas par bI) */
  const fR=b=>{const R=draw.FR||(draw.FR={});if(R[b.im])return R[b.im];for(const q of BL)if(q.im===b.im){const k=bI(q);if(k)return R[b.im]=k[3]/(k[0].width/3*(q.sc||1))}return R[b.im]=1};
  if(!S.fxoff&&LV>0&&BL&&bI){if(!draw.FB||draw.FBn!==BL.length){draw.FBn=BL.length;draw.FB=BL.filter(b=>BGL[b.im]&&ok(b.im))}
   for(const b of draw.FB){const im=XI[b.im],sc0=(b.sc||1)*fR(b),cx=b.x*16+b.w*8+(b.ddx||0),by=(b.y+b.h)*16+2,w=im.width/3*sc0,hh=im.height/3*sc0,fl_=b.flip;if(cx+w/2-X<0||cx-w/2-X>VW||by-Y<-20||by-hh-Y-60>VH)continue;const C=BGL[b.im],G_=C.g?glowMulti(b.im+'~G',XI[b.im],C.g):null,ph=b.x*.37+b.y*.11,oo={x:b.x,y:b.y};
    L.push({y:bW(b)*16+1.6,f:()=>{const x0=cx-X-w/2,y0=by-Y-hh,sc=w/im.width;g.save();if(fl_){g.translate(cx-X,0);g.scale(-1,1);g.translate(-(cx-X),0)}
     if(G_){g.globalCompositeOperation='lighter';g.globalAlpha=Math.min(1,fl(t,oo,C.k||1));g.drawImage(G_,x0,y0,w,hh);g.globalCompositeOperation='source-over';g.globalAlpha=1}
     if(C.e){const S5=ok('X_V_ZT5')?anaSM('X_V_ZT5',XI.X_V_ZT5):null;if(S5&&S5[0])C.e.forEach(([ex,ey],i)=>puffs(g,S5[0],x0+ex*sc,y0+ey*sc,sc*3,t,ph+i*1.7))}
     g.restore()}})}}
  if(!NR)return;const on=!S.fxoff&&LV>0,r0=Math.floor(Y/16)-1,r1=Math.ceil((Y+VH)/16)+6;
  for(let r=r0;r<=r1;r++){const row=BR[r];if(!row)continue;for(const o of row){const bx=o.x*16+8+o.dx-X,by=o.sy-Y,m=o.w/2+4;if(bx+m<0||bx-m>VW||by<-2||by-o.hh>VH)continue;
   const c=o.an,s=on&&(!c.t||c.t==='L')&&(LV>1||!c.g)?wind(t,o,c):0;L.push({y:o.dp,f:()=>sway(g,o,bx,by,s,t)});
   for(const q of o.occ){const cb=o.cb;L.push({y:q.bld?bW(q.bld)*16+1:dep(q),f:()=>{g.save();g.beginPath();g.rect(cb[0]-X,cb[1]-Y,cb[2],cb[3]);g.clip();if(q.bld)dB(g,q.bld,X,Y);else g.drawImage(q.im,q.x*16+8-q.w/2+q.dx-X,q.sy-q.hh-Y,q.w,q.hh);g.restore()}})}}}};
 return{WFM,cfg,prep,reg,rf,reset,draw,shear,get N(){return NR},get LV(){return LV},inv:v=>{inv=v||{};return inv},get I(){return inv}}})();

/* ===== fiches mémo des kanji : image mnémotechnique, phrase pour retenir la forme, lectures kun et on expliquées ===== */
window.KMEMO={
'一':["Un doigt de laiton tendu à l'horizontale : un seul trait, un.","一つ|ひとつ|un (objet)","一月|いちがつ|janvier"],
'二':["Une paire de baguettes : la courte en haut, la longue en bas. Deux.","二つ|ふたつ|deux (objets)","二月|にがつ|février"],
'三':["Trois futons roulés : le plus court au milieu, le plus long en bas. Trois.","三つ|みっつ|trois (objets)","三月|さんがつ|mars"],
'四':["Une fenêtre aux quatre coins rivetés, avec deux rideaux à l'intérieur : quatre.","四つ|よっつ|quatre (objets)","四月|しがつ|avril"],
'五':["Une petite étagère qui porte cinq pièces de monnaie : cinq.","五つ|いつつ|cinq (objets)","五月|ごがつ|mai"],
'六':["Une douche à vapeur : le tuyau, la barre, et deux jets qui s'écartent. Six heures du matin, on se lave.","六つ|むっつ|six (objets)","六月|ろくがつ|juin"],
'七':["Le bambou de Tanabata, la fête du 7 juillet : une branche en travers, la tige qui tourne vers la droite, et sept vœux suspendus.","七つ|ななつ|sept (objets)","七月|しちがつ|juillet"],
'八':["Une araignée mécanique à huit pattes : ses deux pattes du bas s'écartent sans se toucher.","八つ|やっつ|huit (objets)","八月|はちがつ|août"],
'九':["Le chat aux neuf vies s'étire : la patte avant tendue, puis le dos, la patte arrière et la queue.","九つ|ここのつ|neuf (objets)","九月|くがつ|septembre"],
'十':["Deux bâtons de bambou croisés, et dix clochettes suspendues : dix.","十日|とおか|le 10 du mois","十分|じゅっぷん|dix minutes"],
'上':["Un mât planté dans le sol, une petite plate-forme sur le côté : l'oiseau mécanique se pose tout en haut.","上|うえ|dessus, en haut","上手|じょうず|habile"],
'下':["Une poutre en haut, une corde qui pend, une lanterne sur le côté : l'araignée descend tout en bas.","下|した|dessous, en bas","地下|ちか|sous-sol"],
'左':["Il tend le bras vers la gauche et tient l'équerre de l'autre main : gauche.","左|ひだり|gauche","左右|さゆう|gauche et droite"],
'右':["La main droite porte la boulette de riz à la bouche carrée : droite.","右|みぎ|droite","右折|うせつ|tourner à droite"],
'中':["Une flèche plantée en plein milieu de la cible : le milieu.","中|なか|dedans, milieu","中国|ちゅうごく|la Chine"],
'山':["Trois volcans sur une même base, le plus haut au milieu : la montagne.","山|やま|montagne","富士山|ふじさん|le mont Fuji"],
'川':["Trois filets d'eau tombent de la falaise et deviennent une rivière.","川|かわ|rivière","河川|かせん|cours d'eau"],
'田':["Une rizière vue du ciel, partagée en quatre parcelles par deux chemins.","田んぼ|たんぼ|rizière","水田|すいでん|rizière inondée"],
'花':["L'herbe pousse en haut, le vieux jardinier regarde : le cerisier est en fleur.","花|はな|fleur","花火|はなび|feu d'artifice (lecture kun en composé)"],
'空':["Sous le toit, une lucarne ronde s'ouvre sur le ciel où passe un dirigeable.","空|そら|ciel","空気|くうき|air"],
'日':["Une fenêtre à deux carreaux : le soleil se lève derrière.","日|ひ|soleil, jour","日曜日|にちようび|dimanche"],
'月':["La lune dans une fenêtre étroite à deux barreaux.","月|つき|lune","月曜日|げつようび|lundi"],
'年':["L'épouvantail porte toute la récolte de riz : une récolte par an.","年|とし|année, âge","今年|ことし|cette année (lecture spéciale)"],
'今':["Sous le toit, la montre sonne : c'est maintenant !","今|いま|maintenant","今週|こんしゅう|cette semaine"],
'時':["Le soleil à la fenêtre, la cloche du temple qui sonne : c'est l'heure.","時|とき|moment, quand","時間|じかん|durée, temps"],
'天':["Bras et jambes écartés, le samouraï a le ciel juste au-dessus de la tête.","天|あめ|ciel (rare)","天気|てんき|le temps qu'il fait"],
'気':["La marmite de riz bout, la vapeur file : de l'énergie !","気|き|esprit, humeur","元気|げんき|en forme"],
'雨':["Sous l'auvent, la fenêtre et son montant : les gouttes de pluie tombent.","雨|あめ|pluie","大雨|おおあめ|forte pluie"],
