 Object.assign(F.Z,{oboro:18,zeni:18,hitodama:18,byobu:18});
 if(window.FOEZP)FOEZP[18]=['oboro','zeni','hitodama','byobu'];
 Object.assign(F.KV,{
  oboro:[[['次|つぎ','は','終点|しゅうてん','です','。'],'Prochain arrêt : le terminus.',"L'Oboroguruma fait tinter sa cloche, très vexé, et repart sur ses rails imaginaires."]],
  zeni:[[['お釣り|おつり','は','ボタン','です','。'],'La monnaie, c\'est des boutons.',"Le Zeni-gami te lance trois boutons et s'enfuit en comptant sur ses doigts. Il se trompe."]],
  hitodama:[[['ランプ','に','帰らなければ|かえらなければ','…'],'Il faut que je retourne dans ma lampe…',"Le feu follet remonte dans son réverbère. Toute la rue se rallume d'un coup."]],
  byobu:[[['見て|みて','ない','よ','。'],'Je ne regarde pas, hein.',"Le Byōbu-nozoki se cache derrière son paravent. On voit encore ses yeux. Et son cou. Et tout le reste."]]});
 Object.assign(F.EV,{
  oboro:[[['乗客|じょうきゃく','が','いない','…'],'Il n\'y a plus de passagers…',"Le char fantôme ralentit, s'arrête, et se dissout dans un tintement de cloche."]],
  zeni:[[['金|きん','より','名前|なまえ','が','ほしい','…'],'Plutôt qu\'or, je voudrais un nom…',"La vieille pièce verdie roule dans le caniveau et disparaît."]]});
})();
/* ---------- le gardien, l'Empereur et l'histoire du bourg ---------- */
(()=>{
 const J=(n,jp,fr,x)=>({n,jp,fr,x}),T_=(n,t)=>({n,t}),KG='影',KA='Kaito',TN=NPN.tanu,HA='Hana',KM='Empereur Kinmaru',CB='Grand chambellan',BK='Baron Kinkō',TE='Tetsu',OPP=[1,0,3,2];
 Object.assign(PORT,{[KM]:'PX_kinmaru',[CB]:'PX_chamb',[BK]:'PX_gkinko','Okayu':'PX_okayu','Pika':'PX_pika'});
 EN.kinko={id:'kinko',bt:'kinko',n:BK,t:['金公|きんこう'],lv:70,hp:820,dmg:52,trait:'mimic',weak:'水',res:'土',xp:320,atk:'Facture finale',
  clue:'Un banquier automate tout en or : un coffre-fort pour ventre, un monocle sur un œil rouge, une facture sans fin qui sort de sa poitrine. Il ne parle qu\'en chiffres. Il ne supporte pas qu\'on lui demande un reçu.',
  cry:['請求書|せいきゅうしょ','！'],cryFr:'FACTURE !',mus:'nue',bg:'B_VILLE',big:1};
 if(typeof Gates!=='undefined')Gates.REQ.kinko=[33,38,590];
 const M=()=>MAPS.world,H18=()=>HAMS.find(h=>h.z===18);
