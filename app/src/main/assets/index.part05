  for(let i=0;i<Math.round(hh/50);i++){const[px,py]=P(i+950,1,-1,5);if(!vis(px,py,3))continue;const k=.5+.5*Math.sin(tt*3+i*2.3);if(k>.7){g.fillStyle=`rgba(255,226,140,${k})`;g.fillRect(Math.round(px),Math.round(py),1,1)}}};
