   else if(K==='bell'){put(12,mid,'k');put(4,1,'Y');put(9,h-2,'Y');put(7,mid,'Y');put(11,1,'Y');put(6,mid-1,'#');put(6,mid+1,'#')}
   else{for(let y=1;y<h-1;y++)g[y][9]='#';put(9,mid,'W');put(12,mid,'k');put(4,1,'#')}}
