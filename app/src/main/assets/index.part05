 Object.assign(RKIND,{oboro:{s:'oboro',sc:1,n:()=>'Oboroguruma',weak:'水',res:'雷'},zeni:{s:'zeni',sc:.9,n:()=>'Zeni-gami',weak:'火',res:'土'},
  hitodama:{s:'hitodama',sc:.85,n:()=>'Hitodama des réverbères',weak:'水',res:'火'},byobu:{s:'byobu',sc:1,n:()=>'Byōbu-nozoki',weak:'火',res:'木'},
  oboro2:{s:'oboro',bt:'oboro2',sc:1.15,tint:'cool',el:1,n:()=>'Oboroguruma revenant'},zeni2:{s:'zeni',bt:'zeni2',sc:1.1,tint:'cool',el:1,n:()=>'Zeni-gami terni'}});
