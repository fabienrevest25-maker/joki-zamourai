const VDROP={"v23": ["氷"], "v24": ["宿", "泊まります", "一泊", "布団", "予約", "お客さん"], "v25": ["お釣り", "払います"], "v26": ["急ぎます", "通ります", "出発", "お土産"], "v27": ["雷", "霧", "雲", "台風", "虹"], "v29": ["港", "釣り", "深い", "浅い", "渡し船", "岸"], "v30": ["銀行", "郵便局", "病院", "公園", "地図", "銭湯", "市場"], "v31": ["隣", "後ろ", "近く", "遠い", "まっすぐ", "向かい"], "v32": ["会社員", "店員", "運転手", "料理人", "切符", "電車"], "v33": ["試験", "授業", "点", "図書館"], "v34": ["筆", "墨", "間違い"], "v35": ["習います"], "v36": ["働きます", "作ります", "使います", "手伝います", "工場", "給料", "休憩"], "v37": ["鉄", "石", "火", "油", "石炭", "機械", "道具", "はさみ"], "v38": ["冷たい", "忙しい"], "v39": ["落ちます", "上がります", "動きます"], "v40": ["赤ちゃん"], "v42": ["馬", "虫", "狐", "狸", "熊", "兎", "猿"], "v43": ["首", "肩", "背中", "指", "髪", "腕", "膝", "心"], "v44": ["眠い", "嬉しい", "悲しい", "怖い", "寂しい"], "v45": ["前", "もうすぐ", "もう", "まだ", "早朝", "秒"], "v46": ["両方", "好き", "似て", "ずっと"], "v47": ["思います", "信じます", "決めます", "説明します", "忘れます", "覚えます", "分かります", "聞きます"], "v48": ["灰色", "金色", "銀色"], "v53": ["自分"], "v60": ["お風呂", "点けます"]};
const VORIG=[];VDECKS.forEach(D_=>{D_.w.forEach((w,i)=>{w.ix=i;const k=w[0].split('|')[0],out=(VDROP[D_.id]||[]).includes(k);VORIG.push(!out)});D_.w=D_.w.filter(w=>!(VDROP[D_.id]||[]).includes(w[0].split('|')[0]))});
/* un seuil fixé sur l'ancien total (530 mots) devient le nombre de mots restants parmi ces premiers mots */
window.VADJ=n=>{let c=0;for(let i=0;i<Math.min(n,VORIG.length);i++)if(VORIG[i])c++;return c+Math.max(0,n-VORIG.length)};
{const keep=new Set();VDECKS.forEach(D_=>D_.w.forEach(w=>keep.add(w[0].split('|')[0])));const gone=new Set(Object.values(VDROP).flat());
 for(let z=1;z<VOC.length;z++){if(!VOC[z])continue;const L=VOC[z].filter(w=>!gone.has(w[0].split('|')[0]));if(L.length>=6)VOC[z]=L}}
if(PART===12)VDECKS.splice(38);if(PART===34)VDECKS.splice(53);
/* mots du N5 qui manquaient */const VADD={v1:[['ええ','oui (familier)'],['どうも','merci ; bien… (formule)'],['もしもし','allô'],['さあ','allez ! bon…'],['それでは','eh bien, alors']],v3:[['あっち','par là-bas'],['どっち','lequel des deux'],['どなた','qui (poli)'],['こんな','comme ça, de ce genre'],['なぜ','pourquoi']],v4:[['奥さん|おくさん','épouse (de quelqu\'un)'],['二十歳|はたち','vingt ans']],v5:[['お皿|おさら','assiette'],['カップ','tasse'],['グラス','verre (à pied)'],['バター','beurre'],['夕飯|ゆうはん','dîner']],v7:[['七つ|ななつ','sept (objets)'],['八つ|やっつ','huit (objets)'],['昨夜|ゆうべ','hier soir']],v15:[['大きな|おおきな','grand (devant un nom)'],['小さな|ちいさな','petit (devant un nom)'],['つまらない','ennuyeux'],['だんだん','peu à peu']],v16:[['アパート','appartement'],['お手洗い|おてあらい','toilettes'],['花瓶|かびん','vase'],['テーブル','table'],['ベッド','lit'],['ストーブ','poêle, chauffage'],['スリッパ','chaussons'],['灰皿|はいざら','cendrier']],v18:[['しかし','cependant'],['そうして','et puis, ainsi']],v19:[['自動車|じどうしゃ','automobile'],['ポスト','boîte aux lettres'],['お巡りさん|おまわりさん','agent de police']],v34:[['片仮名|かたかな','katakana'],['字引|じびき','dictionnaire (mot ancien)'],['文章|ぶんしょう','texte, rédaction'],['問題|もんだい','question, problème'],['英語|えいご','l\'anglais'],['コピー','photocopie'],['クラス','classe'],['留学生|りゅうがくせい','étudiant étranger']],v36:[['勤めます|つとめます','travailler (pour une entreprise)'],['無くします|なくします','perdre (un objet)']],v45:[['一日|ついたち','le 1er du mois'],['四日|よっか','le 4 du mois'],['五日|いつか','le 5 du mois'],['六日|むいか','le 6 du mois'],['七日|なのか','le 7 du mois'],['九日|ここのか','le 9 du mois'],['十日|とおか','le 10 du mois'],['二十日|はつか','le 20 du mois'],['二月|にがつ','février'],['今月|こんげつ','ce mois-ci'],['先月|せんげつ','le mois dernier'],['毎月|まいげつ','chaque mois'],['毎年|まいねん','chaque année'],['一昨年|おととし','il y a deux ans'],['さ来年|さらいねん','dans deux ans'],['一月|ひとつき','un mois (durée)']],v46:[['キロ','kilo'],['メートル','mètre']],v49:[['背広|せびろ','costume d\'homme'],['ワイシャツ','chemise blanche']],v52:[['ニュース','les informations'],['テープ','cassette, ruban'],['レコード','disque'],['フィルム','pellicule'],['ペット','animal de compagnie']]};VDECKS.forEach(D_=>{const a=VADD[D_.id];if(a){const have=new Set(D_.w.map(w=>w[0].split('|')[0]));a.forEach((w,i)=>{if(have.has(w[0].split('|')[0]))return;w.ix=100+i;D_.w.push(w)})}});
const Vocab=(()=>{
 const st=()=>S.vw||(S.vw={}),lv=()=>S.vd||(S.vd={}),cap=s=>s.charAt(0).toUpperCase()+s.slice(1);
 const mk=(w,D_)=>{const key=jpText([w[0]]),kana=jpKana([w[0]]);return{ix:w.ix,t:w[0],fr:w[1],key,kana,disp:key===kana?key:`${key}（${kana}）`,deck:D_.id}};
 const ALL=[];VDECKS.forEach(D_=>{D_.ws=D_.w.map(w=>mk(w,D_));ALL.push(...D_.ws)});
 const known=()=>ALL.filter(w=>st()[w.key]),count=()=>known().length,due=()=>known().filter(w=>st()[w.key].d<=dayN());
 const open=i=>i===0||(lv()[VDECKS[i-1].id]||0)>=1;
 function mark(w,ok){const r=st()[w.key],t=dayN();if(ok){if(r&&r.d>t)return;const i=r?Math.min(4,r.i+1):0;st()[w.key]={i,d:t+SRI[i]}}else st()[w.key]={i:0,d:t+1}}
 function q(w,ty,pool){const oth=shuf((pool||ALL).filter(x=>x.key!==w.key&&x.fr!==w.fr)).slice(0,3),show=`<span class="jp">${jpHtml([w.t])}</span>${esc(cap(w.fr))}`;
  if(ty===2&&S.snd)return{q:'mcq',listen:1,snd:w.kana,p:'Écoute : quel est ce mot ?',a:w.fr,o:[w.fr,...oth.map(x=>x.fr)],show};
  if(ty===1)return{q:'mcq',p:`Comment dit-on « ${w.fr} » ?`,a:w.disp,o:[w.disp,...oth.map(x=>x.disp)],why:`${w.disp} = ${w.fr}.`};
  return{q:'mcq',p:'Que veut dire ce mot ?',t:[w.t],a:w.fr,o:[w.fr,...oth.map(x=>x.fr)],why:`${w.disp} = ${w.fr}.`}}
 /* question de parade : un mot déjà appris */
 const pq=()=>{const k=known();if(k.length<4)return null;const w=pick(k);return q(w,rnd(2),k.length>=8?k:ALL)};
 /* un paquet de dix mots s'apprend en deux visites de cinq : moins dense, mieux retenu */
 async function first(D_,n){const ws=D_.ws,vh=S.vh||(S.vh={}),hf=ws.length>5?(vh[D_.id]||0):0,part=ws.slice(hf*5,hf*5+5),N=part.length+3,need=N-2;let good=0,tot=0;
  const hd=()=>`<b>語 ${tot}/${N}</b> · <span style="color:${good>=need?'#7fe0a0':'#f0cf7a'}">${good>=need?'✓ objectif atteint':'objectif'} ${good}/${need}</span> · `;
  UI.panel('pad');await D.say(part.map(w=>({n,jp:[w.t],fr:cap(w.fr),img:IM['VI_'+D_.id+'_'+w.ix]})));
  for(const w of shuf(part)){tot++;const r=await Ex.run(q(w,0,ws),{quit:1,head:hd()});if(r==='quit'){UI.panel('pad');return null}if(r)good++}
  for(const w of shuf(part).slice(0,3)){tot++;const r=await Ex.run(q(w,Math.random()<.4?2:1,ws),{quit:1,head:hd()});if(r==='quit'){UI.panel('pad');return null}if(r)good++}
  UI.panel('pad');const ok=good>=need;let pass=false,half=false;if(ok){part.forEach(w=>{if(!st()[w.key])st()[w.key]={i:0,d:dayN()+1}});if(hf===0&&ws.length>5){vh[D_.id]=1;half=true}else{lv()[D_.id]=1;pass=true}}S.xp+=good+(pass?10:0);Quest.add('dojo');save();return{good,tot,pass,half,need}}
 async function drill(D_,n){const ws=shuf(D_.ws);let good=0,tot=0;
  for(const w of ws){tot++;const r=await Ex.run(q(w,[1,2,0,1,2,1,0,2,1,1][tot-1],D_.ws),{quit:1,head:`<b>語 ${tot}/${ws.length}</b> · <span style="color:${good>=ws.length-2?'#7fe0a0':'#f0cf7a'}">${good>=ws.length-2?'✓ objectif atteint':'objectif'} ${good}/${ws.length-2}</span> · `});if(r==='quit'){UI.panel('pad');return null}mark(w,!!r);if(r)good++}
  UI.panel('pad');const pass=good>=tot-2,up=pass&&(lv()[D_.id]||0)<2;if(up){lv()[D_.id]=2;S.it.oni=(S.it.oni||0)+1}S.xp+=good+(up?10:0);save();return{good,tot,pass,up}}
 /* chez un maître : le prochain paquet à découvrir, puis ceux à consolider */
 async function at(n){const old=S.xp,nx=VDECKS.findIndex((D_,i)=>open(i)&&!(lv()[D_.id]>=1)),weak=VDECKS.filter(D_=>lv()[D_.id]===1).slice(0,4),opts=[],acts=[];
  if(nx>=0){opts.push({jp:[VDECKS[nx].ic],fr:`Nouveau paquet : ${VDECKS[nx].name}`});acts.push(['new',VDECKS[nx]])}
  weak.forEach(D_=>{opts.push({jp:[D_.ic],fr:`Consolider : ${D_.name}`});acts.push(['dr',D_])});
  if(!opts.length){await D.say({n,t:'Tu maîtrises tous les paquets de mots que je connais. D\'autres viendront avec la suite de ton voyage.'});return}
  const i=await D.ask({n,t:`Tu connais ${count()} mots sur ${ALL.length}. Dix de plus ?`},opts.concat(['Pas maintenant']));if(i>=acts.length)return;
  const[k,D_]=acts[i],r=k==='new'?await first(D_,n):await drill(D_,n);if(!r)return;
  if(k==='new')await D.say({n,t:r.pass?`${r.good} sur ${r.tot}. Le paquet « ${D_.name} » est complet : ses mots reviendront dans tes révisions et tes parades.`:r.half?`${r.good} sur ${r.tot}. Cinq mots de « ${D_.name} » sont dans ta besace. Reviens me voir pour les cinq suivants : rien ne presse.`:`${r.good} sur ${r.tot}. Il en faut ${r.need} pour valider. On recommence quand tu veux.`});
  else{await D.say({n,t:r.up?`${r.good} sur ${r.tot}. Paquet « ${D_.name} » maîtrisé !`:r.pass?`${r.good} sur ${r.tot}. Solide.`:`${r.good} sur ${r.tot}. Il en faut ${r.tot-2} pour le maîtriser.`});if(r.up){sfx('item');await D.say('Tu reçois un おにぎり (onigiri) !')}}
  await afterXp(old)}
 return{at,pq,count,due,mark,q,known,ALL,total:ALL.length,lv}})();
/* les mots dus rejoignent la révision du jour */
{const oc=Review.count,os=Review.session;Review.count=()=>oc()+Vocab.due().length;
 Review.session=async()=>{const r=await os();const ws=shuf(Vocab.due()).slice(0,6);let good=0,n=0;
  for(const w of ws){n++;const a=await Ex.run(Vocab.q(w,rnd(3)),{quit:1,head:`<b>語 ${n}/${ws.length}</b> · `});if(a==='quit'){n--;break}Vocab.mark(w,!!a);if(a)good++}
  if(n){S.xp+=good;if(n>=3)Quest.add('rev');save();UI.toast(`Mots révisés : ${good} / ${n} · +${good} XP`,2600)}return{good:r.good+good,n:r.n+n}}}

/* ---------- scénario enrichi et humour : rōnin, Kage, lettres de Hana, gardiens bavards, gags ---------- */
{const J=(n,jp,fr,x)=>({n,jp,fr,x}),T_=(n,t)=>({n,t}),KG='影',RO='Rōnin';
 PORT[KG]='K_F1';PORT[RO]='PX_ronin';
 /* --- Kage : remarques mises en file, dites au prochain pas sur la carte --- */
 const KQ={
  firstwin:[J(KG,['やった','ね','。'],'Bien joué.'),T_(KG,"Enfin, « bien »… Tu viens de te battre contre quelque chose qui, hier encore, était un mot du dictionnaire. Mais je suis de bonne humeur.")],
  flee:[J(KG,['逃げた|にげた','。'],'Tu as fui.','逃げた = passé de 逃げる, fuir'),T_(KG,"Pas de jugement. Si, en fait. Beaucoup de jugement.")],
  lose:[J(KG,['痛い|いたい','。'],'Aïe.'),T_(KG,"Je précise que j'habite là-dedans. Quand tu prends un coup, c'est mon salon qui tremble.")],
  noaid:[J(KG,['すごい','！'],'Incroyable !'),T_(KG,"Tu as tracé un kanji de mémoire. Sans aide. Je… non, rien. Je n'ai pas été ému. Les ombres ne sont pas émues.")],
  factory:[T_(KG,"Du métal, de la fumée, des gens qui saluent des tuyaux. Vous aviez des forêts, vous autres humains, et vous avez choisi ça ?"),J(KG,['変|へん','です','ね','。'],"C'est bizarre, hein.",'変 (へん) = bizarre')],
  well:[T_(KG,"Kaito. Ce qui dort dans ce puits… je le connais. Ne me demande pas comment."),J(KG,['帰りましょう|かえりましょう','か','。'],'On rentre ?','〜ましょうか = « et si on… ? »'),T_(KG,"… Non ? Bon. J'aurai essayé.")],
  k12:[T_(KG,"Douze kanji. À ce rythme, tu sauras lire un journal dans… attends, je compte… non, je préfère ne pas te le dire.")],
  streak3:[J(KG,['三日|みっか','！'],'Trois jours !'),T_(KG,"Trois jours de suite. Chez les humains, il paraît que c'est le début d'une habitude. Chez les démons, c'est une malédiction. Les deux me vont.")],
  shop:[T_(KG,"Encore du riz. Toujours du riz. Vous mangez autre chose, parfois ? Des cailloux ? Des regrets ?")],
  quest:[T_(KG,"Tu aides les gens, maintenant. Gratuitement. Enfin, contre de l'argent. C'est noté dans ton dossier.")]};
 const BAD=[[T_(KG,"Ce kanji… tu l'as tracé avec le coude ?")],[T_(KG,"J'ai vu des poules écrire plus droit. Et elles n'essayaient même pas.")],[J(KG,['もう','一度|いちど','。'],'Encore une fois.'),T_(KG,"Je dis ça pour toi. Moi, j'ai l'éternité. Toi, tu as l'air pressé.")],[T_(KG,"Intéressant. On dirait une araignée qui a perdu un pari.")]];
 const queue=[];let badN=0;
 const once=k=>{if(S.fl['kq_'+k]||!S.fl.act1)return;S.fl['kq_'+k]=1;queue.push(KQ[k])};
 /* --- le rōnin, une scène par hameau --- */
 const RSC={2:[J(RO,['遅い|おそい','。'],'Tu es lent.','遅い (おそい) = lent, en retard'),T_(RO,"Trois jours pour traverser une route de rizières. J'ai connu des escargots plus pressés. L'un d'eux était même mieux armé."),J('Kaito',['だれ','です','か','。'],'Qui êtes-vous ?'),
   T_(RO,"Quelqu'un qui te suit depuis la nuit du feu. Ne me demande pas pourquoi : je ne le sais pas encore moi-même, et ça m'agace."),T_(RO,"Cette forêt était gardée par les Kodama. Depuis que l'usine de Tetsu pompe le Kiryoku des racines, ils mordent. Toi, tu rends leur Kiryoku aux choses que tu frappes. Curieux, pour un paysan."),
   J(RO,['また','会おう|あおう','。'],'On se reverra.','会おう : « rencontrons-nous », forme familière de 会いましょう'),"Il disparaît derrière un bambou. Un bambou beaucoup trop mince pour cacher qui que ce soit."],
  3:[J(RO,['静か|しずか','に','。'],'Silence.'),T_(RO,"Personne ici n'a vu le seigneur Tetsu depuis trois ans. Ses ordres arrivent par un tuyau. Les ouvriers saluent le tuyau. Le tuyau a eu une promotion."),J('Kaito',['どうして','ここ','に','います','か','。'],'Pourquoi êtes-vous ici ?','どうして = pourquoi'),
   T_(RO,"Je cherche quelqu'un qui porte la même chose que toi dans la poitrine. Lui ne s'en sert pas pour consoler des épouvantails."),J(RO,['気|き','を','つけろ','。'],'Fais attention.','つけろ : forme d\'ordre, rude. La version polie est 気をつけてください.'),"Il s'éloigne, se cogne dans un tuyau, fait comme si de rien n'était… et salue le tuyau."],
  4:[T_(RO,"Tu traces de mieux en mieux. C'est-à-dire qu'on reconnaît maintenant tes kanji. Avant, on aurait dit des araignées écrasées avec conviction."),T_(RO,"Les machines de Tetsu ne brûlent pas de charbon. Elles boivent quelque chose qui monte du vieux puits, au nord. Quelque chose qui a un nom."),
   J(RO,['黒神|くろかみ','。'],'Kurokami.','黒 (noir) + 神 (dieu)'),T_(KG,"… Ne répète pas ce nom. Il me donne des démangeaisons, et je n'ai pas de peau."),J(RO,['今|いま','、','だれか','話しました|はなしました','か','。'],"Quelqu'un vient de parler ?",'だれか = quelqu\'un'),J('Kaito',['いいえ','。'],'Non.'),"Le rōnin te fixe longuement, puis s'en va à reculons. Il rate la marche."],
  5:[T_(RO,"Ce village s'appelait « le village des cendres » bien avant de brûler. Ses fondateurs avaient soit un don de voyance, soit un humour déplorable."),T_(RO,"Le puits s'est réveillé il y a un an. Ce qui dort dessous n'est qu'un doigt de Kurokami. Un petit doigt. Probablement le gauche."),
   J(RO,['こわい','です','か','。'],'Tu as peur ?','こわい = effrayant, avoir peur'),J('Kaito',['はい','、','少し|すこし','。'],'Oui, un peu.'),J(RO,['いい','答え|こたえ','だ','。'],'Bonne réponse.','答え (こたえ) = réponse'),T_(RO,"Ceux qui n'ont pas peur meurent en premier. Ceux qui ont trop peur aussi. Vise le milieu."),"Il s'assoit sur une ruine pour avoir l'air mystérieux. La ruine s'effondre. Il reste assis dans les décombres, très digne."]};
 RSC[6]=[J(RO,['遅い|おそい','。','とても','遅い|おそい','。'],'Tu es lent. Très lent.'),T_(RO,"Tu as scellé un doigt de Kurokami et tu as mis une semaine à monter jusqu'ici. Les deux m'impressionnent autant."),T_(RO,"À partir d'aujourd'hui, tu es mon apprenti. Règle numéro un : je ne répète pas. Règle numéro deux : je ne répète pas."),
  J('Kaito',['先生|せんせい','、','どこ','へ','行きます|いきます','か','。'],'Maître, où allons-nous ?','へ = vers (direction)'),J(RO,['北|きた','。'],'Au nord.','北 (きた) = nord'),T_(RO,"La capitale. Tetsu y fabrique une machine qui avale les mots. Toi, tu en as encore très peu : tu ne risques rien."),
  "Il s'éloigne dans la neige d'un pas décidé. Dans la mauvaise direction. Il revient sans un mot et repart de l'autre côté."];
 RSC[16]=[J(RO,['静か|しずか','に','。'],'Doucement.','静か (しずか) = calme, silencieux'),T_(RO,"Ici, chaque pas résonne jusqu'au trône. Tetsu entend tout. Il a toujours tout entendu."),T_(RO,"Quand Kiku était petite, elle chuchotait exprès, à l'autre bout de l'atelier, pour voir s'il l'entendrait. Il l'entendait toujours. Le jour où elle s'est tue, il a arrêté d'écouter qui que ce soit."),T_(KG,"… Ça n'excuse rien."),T_(RO,"Non. Ça explique. Monte, petit. Et quand tu seras devant lui, regarde l'amulette rouge à son cou. C'est la seule chose qu'il n'a jamais effacée.")];
 RSC[17]=[J(RO,['遅い|おそい','。','そして','、','ぬれて','いる','。'],'Tu es lent. Et mouillé.','ぬれている = être mouillé · そして = et, ensuite'),T_(RO,"Moi ? Je suis arrivé hier. À pied. Il y a toujours une route, petit. Toi, tu préfères tomber."),
  T_('Kaito',"Vous étiez dans la citadelle quand elle est tombée !"),T_(RO,"J'étais dans la citadelle quand elle a COMMENCÉ à tomber. Nuance. Je suis sorti au bon moment. C'est un talent qui vient avec l'âge, comme les rhumatismes."),
  J(RO,['テツ','は','もう','人|ひと','じゃない','。'],'Tetsu n\'est plus un homme.','じゃない = n\'est pas (familier) · もう + négatif = ne… plus'),
  T_(RO,"Il serre le cœur du dieu contre sa poitrine. Il ne dort plus, il ne mange plus, il ne se retourne plus. Il file vers le nord, par la ville impériale, et il achète tout ce qui se trouve sur son chemin."),
  T_(KG,"Là-haut, vous disiez qu'on pouvait le comprendre."),T_(RO,"J'avais tort. Il ne cherche plus le nom de sa fille. Il veut que plus personne n'ait de nom. Ne cherche pas à le sauver, petit. Arrête-le."),
  J('Kaito',['わかりました','。'],'Compris.'),T_(RO,"Bien. Le bus-crabe part vers la capitale par la côte. Moi, je marche. On verra bien qui arrive le premier."),
  "Il s'éloigne sur le sable, en laissant des traces parfaitement droites. Même ses empreintes ont l'air d'attendre quelqu'un."];
 RSC[18]=[J(RO,['金|きん','は','重い|おもい','。','名前|なまえ','は','軽い|かるい','。'],'L\'or est lourd. Un nom est léger.','重い (おもい) = lourd · 軽い (かるい) = léger'),T_(RO,"Cette ville se change en or, et elle trouve ça très bien. Tetsu a vendu l'horloge à l'Empereur. Avec l'or, il paie les rails qui descendent vers la mine."),T_(RO,"Le cœur est déjà sous la montagne. Ne t'attarde pas à admirer les dorures."),T_(KG,"Il a dit « admirer ». Il a regardé ton armure en le disant. Elle est sale, Kaito.")];
 RSC[15]=[J(RO,['風|かぜ','が','強い|つよい','です','ね','。'],'Le vent est fort, hein.','強い (つよい) = fort'),T_(RO,"Ce vent-là n'est pas naturel. Il pousse les gens vers le sud, loin de la citadelle. Tetsu ne veut pas de visiteurs."),T_(RO,"La ligne du nord monte jusqu'à ses portes. Le Kaze-no-kami la garde. Si tu passes, il n'y aura plus rien entre lui et toi."),T_(KG,"… Il dit « lui » comme s'il le connaissait."),T_(RO,"Je l'ai connu. Avant les machines. Avant sa fille. Va, petit. On se reverra là-haut.")];
 RSC[14]=[J(RO,['遅い|おそい','。'],'Tu es lent.'),T_(RO,"… Enfin. Peut-être pas. Ici, toutes les horloges disent autre chose. Tu es peut-être en avance."),T_(RO,"La citadelle de Tetsu est juste là, derrière les nuages. On la voit par beau temps. Pour l'atteindre, il faut passer par la croisée des quatre vents, au nord."),J('Kaito',['どう','行きます|いきます','か','。'],'Comment on y va ?','どう = comment'),T_(RO,"Une draisine, sur une plaque tournante. Il faut choisir la bonne direction. En japonais. Les horlogers disent que les mauvaises directions mènent dans le vide."),T_(RO,"Un miroir garde la plaque. Il montre le vrai visage de ceux qui passent. Je ne l'ai pas regardé. Je n'avais pas envie de le voir.")];
 RSC[13]=[J(RO,['遅い|おそい','。'],'Tu es lent.'),T_(RO,"… Non. Tu es tombé du ciel. On ne peut pas reprocher à quelqu'un sa vitesse de chute."),T_(RO,"Moi, je suis arrivé par le pont de racines. Il se déroule tout seul sous les pieds, et il s'enroule derrière toi. Je n'ai pas eu le choix de la direction. Comme d'habitude."),J('Kaito',['ここ','は','どこ','です','か','。'],'Où sommes-nous ?','どこ = où'),T_(RO,"Une île de forêt, posée sur les nuages. Les renards et les tanuki qui ont fui les machines vivent ici. Ils n'aiment pas les humains. Ils m'ont laissé entrer parce que je ne compte pas vraiment."),T_(RO,"Au nord, il y a une nacelle sur une chaîne. Elle mène aux jardins des horlogers, et de là, à la citadelle. Mais un écho de fer garde le treuil. Il répète tout ce qu'on dit. Surtout les erreurs."),J(RO,['間違えないで|まちがえないで','ください','。'],'Ne te trompe pas.','間違えます (まちがえます) = se tromper')];
 RSC[12]=[J(RO,['遅い|おそい','。'],'Tu es lent.'),T_(RO,"Ta sœur est passée ici avant toi. Dans une cage dorée, sous un dirigeable noir. Elle a mordu un garde. Il en porte encore la marque, et il en parle avec respect."),J('Kaito',['どこ','へ','行きました|いきました','か','。'],'Où sont-ils allés ?','どこへ = vers où · 行きました = le passé de 行きます'),T_(RO,"Là-haut. La citadelle de Tetsu flotte au-dessus des nuages. On n'y monte qu'en dirigeable, et plus aucun dirigeable ne décolle."),T_(RO,"Sur le mât d'amarrage, au nord, une Nue a fait son nid. Tête de singe, pattes de tigre, queue de serpent. Elle crie la nuit, et chaque cri vole un mot aux pilotes. Ils ne savent même plus dire « décollage »."),J(RO,['空|そら','に','行きたい|いきたい','です','か','。','じゃあ','、','勝って|かって','ください','。'],'Tu veux aller au ciel ? Alors gagne.','行きたい = vouloir aller · 勝ちます (かちます) = gagner'),T_(RO,"Je surveille le quai. Personne ne me l'a demandé. C'est ce qui rend la chose élégante.")];
 RSC[11]=[J(RO,['遅い|おそい','。'],'Tu es lent.'),T_(RO,"Les Grandes Forges. Tout le fer du pays finit ici. Et depuis un an, tous les mots aussi."),T_(RO,"Dans la grande halle, Tetsu a fait construire une bête de fer. Elle avale ce qui est écrit, ce qui est dit, et bientôt ce qui est pensé. J'ai voulu lui parler. Elle a mangé ma phrase. J'en avais une très belle."),
  J('Kaito',['先生|せんせい','、','それ','は','いくら','です','か','。'],'Maître, combien ça coûte ?','いくらですか = combien ça coûte ?'),J(RO,['一万|いちまん','円|えん','だ','。'],'Dix mille yens.','一万 (いちまん) = dix mille'),T_(RO,"Le bol de nouilles de la cantine. Dix mille. En bons d'usine. J'ai payé avec mon sabre. Ils me l'ont rendu : il ne coupait pas assez."),
  "Il s'adosse à un fourneau pour avoir l'air menaçant. Son manteau prend feu. Il s'éloigne lentement, sans courir, par principe."];
 RSC[10]=[J(RO,['遅い|おそい','。'],'Tu es lent.'),T_(RO,"L'Académie des sceaux. C'est ici que Tetsu fait copier les kanji par des machines. Elles écrivent vite, sans faute, et sans rien comprendre. Ça te rappelle quelqu'un ?"),T_(RO,"La porte nord ne s'ouvre qu'à ceux qui réussissent l'examen. L'examinateur est un tas de vieux rouleaux vexés. J'ai passé l'épreuve."),
  J('Kaito',['先生|せんせい','、','試験|しけん','の','日|ひ','、','何|なに','を','しました','か','。'],"Maître, le jour de l'examen, qu'avez-vous fait ?",'試験 (しけん) の 日 (ひ) = le jour de l\'examen'),J(RO,['泣いた|ないた','。'],"J'ai pleuré.",'泣く (なく) = pleurer · 泣いた : forme familière du passé'),T_(RO,"De rire. Évidemment. Il m'a mis zéro en écriture. Je signe d'une croix, c'est un style."),
  "Il s'éloigne en lisant un panneau à voix haute. Il le tient à l'envers."];
 RSC[9]=[J(RO,['遅い|おそい','。'],'Tu es lent.'),T_(RO,"La ville basse. Ici, il fait nuit à midi : la ville haute est construite par-dessus, et Tetsu n'a pas prévu de fenêtres pour ceux d'en dessous."),T_(RO,"Pour monter, il y a le funiculaire. Pour le funiculaire, il faut un billet. Pour le billet, il faut le guichet. Le guichet est fermé. J'ai voulu parler au responsable : c'est une roue."),
  J('Kaito',['先生|せんせい','、','駅|えき','は','どこ','に','あります','か','。'],'Maître, où se trouve la station ?','どこにありますか = où se trouve… ?'),J(RO,['風呂|ふろ','の','後ろ|うしろ','だ','。'],'Derrière les bains.','風呂 (ふろ) = bain · 後ろ (うしろ) = derrière'),T_(RO,"Je le sais parce que j'ai cherché. Dans les bains. Longtemps. C'était de la reconnaissance."),
  "Il repart vers le bain public, une serviette sur l'épaule. Elle est déjà mouillée."];
 RSC[8]=[J(RO,['遅い|おそい','。'],'Tu es lent.'),T_(RO,"Tetsu a fait démonter le pont. Pierre par pierre, avec des reçus. Il ne veut pas qu'on entre dans Kurogane : il veut qu'on y soit livré."),T_(RO,"Reste le bac. Le passeur refuse de partir tant qu'il y a « quelque chose » devant l'embarcadère. J'ai regardé. Il y a quelque chose. C'est gros, c'est mouillé, et ça m'a regardé aussi."),
  J('Kaito',['先生|せんせい','は','何|なに','を','して','います','か','。'],'Maître, qu\'est-ce que vous faites ?','〜ています = être en train de'),J(RO,['待って|まって','いる','。'],'J\'attends.','いる : la forme familière de います'),T_(RO,"J'attends que mon apprenti règle le problème. C'est de la pédagogie. Ça ressemble à de la paresse, mais vu de l'intérieur c'est très différent."),
  "Il s'assoit sur un ponton pour pêcher. Il n'a pas de ligne. Un poisson saute dans son chapeau quand même."];
 RSC[7]=[J(RO,['遅い|おそい','。'],'Tu es lent.'),T_(RO,"Leçon du jour : sur une grand-route, on apprend tout. Les prix, les heures, les interdictions. Surtout les interdictions."),T_(RO,"Le poste de contrôle, au nord, est tenu par un mur. Un vrai. Il a un règlement. J'ai voulu discuter : il m'a demandé un formulaire. J'ai voulu le découper : il m'a demandé un formulaire pour ça aussi."),
  J('Kaito',['通って|とおって','も','いい','です','か','。'],'Est-ce qu\'on peut passer ?','〜てもいいですか = « est-ce que je peux… ? »'),J(RO,['だめ','だ','。'],'Non.','だめ = interdit, pas possible'),T_(RO,"Voilà. Tu sais poser la question. Apprends maintenant à comprendre la réponse, et va la poser au mur. Moi, je surveille l'auberge. De l'intérieur."),
  "Il entre dans l'auberge par la fenêtre. La porte était ouverte."];
RSC[17]=[J(RO,['遅い|おそい','。','そして','、','ぬれて','いる','。'],'Tu es lent. Et mouillé.','ぬれている = être mouillé · そして = et, ensuite'),T_(RO,"Moi ? Arrivé hier. À pied. Par la mer. Je n'ai pas dit que c'était agréable."),
  T_('Kaito',"Vous étiez dans la citadelle quand elle est tombée !"),T_(RO,"J'étais dans la citadelle quand elle a COMMENCÉ à tomber. Nuance. Je suis sorti au bon moment. C'est un talent qui vient avec l'âge, comme les rhumatismes."),
  J(RO,['テツ','は','もう','人|ひと','じゃない','。'],'Tetsu n\'est plus un homme.','じゃない = n\'est pas (familier) · もう + négatif = ne… plus'),
  T_(RO,"Il serre le cœur du dieu contre lui et file vers le nord. Il ne dort plus, il ne mange plus. Il achète. Tout ce qu'il croise. Hier, une île. Avec les mouettes dessus."),
  T_(KG,"Et vous, vous avez fait quoi depuis hier ?"),T_(RO,"J'ai fait sécher mon chapeau. Puis j'ai fait sécher mon autre chapeau. Ne juge jamais un homme qui a deux chapeaux."),
  J('Kaito',['わかりました','。'],'Compris.'),T_(RO,"Le bus-crabe part vers la capitale. Il roule de côté. Moi, je marche droit. On verra bien qui arrive le premier."),
  "Il s'éloigne sur le sable. Un crabe le suit pendant dix mètres, puis le dépasse."];
 RSC[18]=[J(RO,['金|きん','は','重い|おもい','。','名前|なまえ','は','軽い|かるい','。'],'L\'or est lourd. Un nom est léger.','重い (おもい) = lourd · 軽い (かるい) = léger'),T_(RO,"Tu es lent. Mais tu es propre. Ici, ça compte davantage."),
  T_(RO,"Cette ville se change en or et elle trouve ça très bien. On m'a fait payer l'air. Le matin, c'est plus cher."),
  J('Kaito',['先生|せんせい','、','お金|おかね','が','あります','か','。'],'Maître, vous avez de l\'argent ?','お金 (おかね) = argent'),J(RO,['ない','。'],'Non.','ない = il n\'y en a pas (familier)'),
  T_(RO,"J'ai vendu mon ombre à un banquier. Il n'a pas remarqué qu'elle me suivait encore. Je repasse demain pour la lui revendre."),
  T_(RO,"Sérieusement : Tetsu a vendu l'horloge à l'Empereur. Avec l'or, il paie les rails qui descendent vers la mine. Le cœur est déjà sous la montagne."),T_(KG,"Il a dit « sérieusement ». Il a l'air surpris lui-même."),
  "Il s'éloigne en faisant tinter une bourse vide. Le bruit, c'est lui qui le fait avec la bouche."];
 RSC[19]=[J(RO,['山|やま','は','高い|たかい','。','足|あし','が','痛い|いたい','。'],'La montagne est haute. J\'ai mal aux pieds.','高い (たかい) = haut · 足 (あし) = pied · 痛い (いたい) = avoir mal'),T_(RO,"Tu es lent. Moi aussi, cette fois. Ne le répète à personne."),
  T_(RO,"Les tengu m'ont arrêté au col. Ils voulaient savoir si je savais voler. J'ai dit non. Ils ont eu pitié et m'ont offert un gâteau. Il était en pierre."),
  J('Kaito',['先生|せんせい','、','天狗|てんぐ','は','強い|つよい','です','か','。'],'Maître, les tengu sont forts ?','強い (つよい) = fort'),J(RO,['強い|つよい','。','そして','、','うるさい','。'],'Forts. Et bruyants.','うるさい = bruyant, pénible'),
  T_(RO,"Pendant une heure, ils ont débattu pour savoir si j'étais un vieil homme ou un très grand corbeau. Je ne les ai pas aidés."),
  T_(RO,"Tetsu est passé sous la montagne, par la mine. Il a creusé un trou plutôt que de dire bonjour à qui que ce soit. Ça lui ressemble."),
  "Il reprend le sentier. Un corbeau se pose sur son chapeau. Il ne le chasse pas. Ils ont l'air de bien s'entendre."];
 RSC[20]=[J(RO,['暗い|くらい','。','何|なに','も','見えない|みえない','。'],'Il fait noir. Je ne vois rien.','何も見えない (なにもみえない) = je ne vois rien · 何も + négatif = rien'),T_(RO,"Tu es lent. Enfin, je crois que c'est toi. Je parle peut-être à un mineur."),
  T_(RO,"Les mineurs travaillent pour Tetsu sans l'avoir jamais vu. Ils pensent qu'il est fait de vapeur et de factures. Je n'ai pas osé les contredire : c'est assez juste."),
  J('Kaito',['先生|せんせい','の','ランタン','は','どこ','です','か','。'],'Maître, où est votre lanterne ?','どこですか = où est… ?'),J(RO,['食べた|たべた','。'],'Je l\'ai mangée.','食べた (たべた) = forme familière du passé de 食べます'),
  T_(RO,"La bougie. Pas la lanterne. J'avais faim, il faisait noir. C'était une mauvaise décision, prise dans de mauvaises conditions."),
  T_(RO,"Au fond, il y a une vieille gare et des montagnes russes. C'est le seul chemin vers le temple. Ne regarde pas en bas. Moi, j'ai regardé. Je regrette."),
  "Il s'enfonce dans une galerie à tâtons. On l'entend dire « pardon » à un mur. Deux fois."];
 RSC[21]=[J(RO,['ここ','が','最後|さいご','です','。'],'C\'est ici, la fin.','最後 (さいご) = la fin, le dernier'),T_(RO,"Tu es arrivé avant moi. Par la cloche, à ce qu'on raconte. Toute la montagne l'a entendue. Moi aussi. J'étais dessous."),
  T_(RO,"Tetsu t'attend en haut de la tour. Pour monter, il faut passer quatre gardiens : vocabulaire, grammaire, lecture, écoute. Un examen, petit."),
  J('Kaito',['先生|せんせい','は','試験|しけん','が','好き|すき','です','か','。'],'Maître, vous aimez les examens ?','好き (すき) = aimer bien'),J(RO,['大嫌い|だいきらい','だ','。'],'Je les déteste.','大嫌い (だいきらい) = détester · le contraire de 大好き'),
  T_(RO,"La dernière fois, j'ai écrit mon nom dans la case « date ». L'examinateur a pleuré. Pas de tristesse : il riait trop."),
  T_(KG,"Vous venez avec nous ?"),T_(RO,"Non. Je garde la porte. Si quelqu'un veut entrer, je lui demande son nom. Puis je le lui rends. C'est ma façon de faire la différence."),
  "Il s'assoit sur une marche, le sabre sur les genoux, et ferme les yeux. Au bout d'un moment, il ronfle. Très bas, pour ne gêner personne."];
 const HAM=HAMS;
 async function ronin(h){S.fl['ro'+h.z]=1;const H=W.H,up=H.dir!==0,ro=W.spawn({npc:1,spr:'ronin',x:H.x,y:H.y+(up?-3:3),dir:up?0:1,ev:'ronin'});await W.emote(ro);W.faceTo(H,ro);if(h.z===6)await Cine.say('N_S3',RSC[h.z]);else await D.say(RSC[h.z]);
  for(let i=0;i<3;i++)await W.walk(ro,up?1:0,.16);W.remove(ro);save()}
 const oTrig=STORY.triggers;
 STORY.triggers=(x,y)=>{const t=oTrig(x,y);if(t||!S.fl.act1)return t;
  const h=HAM.find(h=>y<=h.y1&&y>=h.y0);if(h&&RSC[h.z]&&!S.fl['ro'+h.z]&&y<=h.y1-Math.round((h.y1-h.y0)*(h.z>=17?.75:.65)))return()=>ronin(h);
  const z=MAPS.world.zone(y);if(z===3)once('factory');if(z===5&&S.wins.toad&&y<16)once('well');
  if(SP.filter(unl).length>=12)once('k12');if(Quest.streak()>=3)once('streak3');if(Object.values(S.qs||{}).includes(2))once('quest');
  if(queue.length){const l=queue.shift();return()=>D.say(l)}return null};
 /* --- combats et tracés : réactions de Kage --- */
 const oStart=Battle.start;Battle.start=async(def,o)=>{const r=await oStart(def,o);if(r==='win')once('firstwin');else if(r==='flee')once('flee');else if(r==='lose')once('lose');return r};
 const oRun=Trace.run;Trace.run=async(sp,o)=>{const r=await oRun(sp,o);if(r&&S.fl.act1){if(r.aid===3&&r.stars>=2)once('noaid');else if(r.stars===1&&++badN%4===1&&queue.length<2)queue.push(BAD[Math.floor(badN/4)%BAD.length])}return r};
 const oShop=STORY.shop;STORY.shop=async()=>{await oShop();once('shop')};
 /* --- lettres de Hana, glissées sous les statues Jizō --- */
 const HN='Lettre de Hana';PORT[HN]='PX_hana';
 const LET={1:[J(HN,['お兄ちゃん|おにいちゃん','へ','。','元気|げんき','です','か','。'],'À mon grand frère. Tu vas bien ?','へ = « à », en tête de lettre'),J(HN,['たぬき','先生|せんせい','は','「','たぬき','じゃない','です','」','。'],'Maître Tanuki : « Je ne suis pas un tanuki. »','じゃないです = « ne suis pas », « n\'est pas »'),J(HN,['うそ','です','。'],"C'est un mensonge."),T_(KG,"Ta sœur a raison. Il a une queue. Elle dépasse.")],
  2:[J(HN,['今日|きょう','の','ごはん','は','魚|さかな','です','。'],"Aujourd'hui, au repas : du poisson.",'ごはん = le repas, le riz'),J(HN,['漁師|りょうし','さん','の','魚|さかな','じゃない','です','。'],"Ce n'était pas un poisson du pêcheur.",'漁師 (りょうし) = pêcheur'),J(HN,['漁師|りょうし','さん','は','まだ','ゼロ','です','。'],'Le pêcheur en est toujours à zéro.','まだ = encore, toujours')],
  3:[J(HN,['井戸|いど','の','ポンプ','は','だめ','でした','。'],'La pompe du puits était cassée.','だめ = ça ne va pas, ça ne marche pas'),J(HN,['今|いま','は','大丈夫|だいじょうぶ','です','。','スプーン','で','。'],'Maintenant, elle marche. Avec une cuillère.','で = avec (le moyen)'),T_(KG,"Ta sœur répare des pompes avec des couverts. Si Tetsu savait, il aurait peur."),
     J(HN,['家|いえ','は','静か|しずか','です','。'],'La maison est calme.'),J(HN,['静か|しずか','すぎます','。'],'Trop calme.','〜すぎます = « trop… »'),J(HN,['早く|はやく','会いたい|あいたい','です','。'],"J'ai hâte de te revoir.",'会いたい = « je veux (te) voir »'),T_(KG,"Elle s'ennuie de toi. Je ne comprends pas pourquoi, mais je note.")],
  4:[J(HN,['夜|よる','、','変|へん','な','声|こえ','を','聞きました|ききました','。'],"La nuit, j'ai entendu une voix étrange.",'声 (こえ) = voix'),J(HN,['「','海斗|かいと','」','と','言いました|いいました','。'],'Elle a dit : « Kaito ».'),J(HN,['こわくない','です','。','少し|すこし','だけ','。'],"Je n'ai pas peur. Juste un peu.",'だけ = seulement'),T_(KG,"… Ce n'était pas moi. Je ne sors pas la nuit. Enfin, je suis la nuit. Bref, ce n'était pas moi.")],
  5:[J(HN,['お兄ちゃん|おにいちゃん','は','強い|つよい','です','。'],'Grand frère, tu es fort.','強い (つよい) = fort'),J(HN,['でも','、','ごはん','を','食べて|たべて','ください','。'],"Mais mange, s'il te plaît."),J(HN,['待って|まって','います','。'],"Je t'attends.",'〜ています : une action qui dure')]};
 Object.assign(LET,{6:[J(HN,['お兄ちゃん|おにいちゃん','へ','。','雪|ゆき','を','見ました|みました','か','。'],'À mon grand frère. Tu as vu de la neige ?'),J(HN,['こちら','は','まだ','暑い|あつい','です','。'],'Ici, il fait encore chaud.','こちら = ici, de mon côté'),J(HN,['雪|ゆき','を','少し|すこし','送って|おくって','ください','。'],"Envoie-moi un peu de neige, s'il te plaît.",'送ります (おくります) = envoyer'),T_(KG,"Elle veut de la neige par courrier. C'est la personne la plus raisonnable de ta famille, et ça m'inquiète.")],
  7:[J(HN,['手紙|てがみ','は','高い|たかい','です','。'],'Les lettres coûtent cher.'),J(HN,['切手|きって','は','三十円|さんじゅうえん','でした','。'],'Le timbre coûtait trente yen.','切手 (きって) = timbre'),J(HN,['だから','、','短い|みじかい','手紙|てがみ','です','。'],"Alors c'est une lettre courte.",'だから = c\'est pourquoi · 短い (みじかい) = court'),J(HN,['元気|げんき','です','。','おわり','。'],'Je vais bien. Fin.'),T_(KG,"Quatre phrases, trente yen. Elle écrit mieux que toi et elle gère mieux son argent. Rentre chez toi et envoie-la à ta place.")],
  11:[J(HN,['お兄ちゃん|おにいちゃん','、','お金|おかね','を','送りました|おくりました','。'],"Grand frère, je t'ai envoyé de l'argent.",'送ります (おくります) = envoyer'),J(HN,['百|ひゃく','円|えん','です','。','全部|ぜんぶ','です','。'],"C'est cent yens. C'est tout ce que j'ai.",'全部 (ぜんぶ) = tout'),J(HN,['何|なに','か','おいしい','もの','を','買って|かって','ください','。'],"Achète-toi quelque chose de bon.",'買います (かいます) = acheter'),T_(KG,"… Cent yens. Ici, ça ne paie même pas l'eau du thé. Ne lui dis jamais. Achète quelque chose, n'importe quoi, et dis-lui que c'était délicieux.")],
  10:[J(HN,['たぬき','先生|せんせい','の','時計|とけい','を','開けました|あけました','。'],"J'ai ouvert l'horloge de Maître Tanuki.",'開けます (あけます) = ouvrir'),J(HN,['おもしろかった','です','。','でも','、','先生|せんせい','は','「','だめ','！','」','と','言いました|いいました','。'],"C'était passionnant. Mais le maître a dit : « Non ! »",'おもしろかった = c\'était intéressant (passé de おもしろい)'),T_(KG,"Elle démonte les horloges, maintenant. Tu es sûr que c'est ta sœur, et pas une ingénieure de Tetsu ?"),
   J(HN,['新聞|しんぶん','、','ありがとう','。'],'Merci pour le journal.','新聞 (しんぶん) = journal'),J(HN,['でも','、','たぬき','先生|せんせい','が','新聞|しんぶん','を','食べました|たべました','。'],"Mais Maître Tanuki a mangé le journal.",'でも = mais'),J(HN,['「','味|あじ','は','いい','」','と','言いました|いいました','。'],'Il a dit : « Le goût est bon. »','味 (あじ) = goût'),T_(KG,"Il mange la presse. Chez nous, on appelle ça dévorer l'actualité. … Ne me regarde pas comme ça, j'essaie des choses.")],
  9:[J(HN,['お兄ちゃん|おにいちゃん','、','町|まち','は','大きい|おおきい','です','か','。'],'Grand frère, la ville est grande ?'),J(HN,['人|ひと','が','多い|おおい','です','から','、','気|き','を','つけて','ください','。'],'Comme il y a beaucoup de monde, fais attention.','〜から = parce que · 気をつけて = fais attention'),J(HN,['おみやげ','は','新聞|しんぶん','が','いい','です','。'],'Comme souvenir, je voudrais un journal.','おみやげ = souvenir de voyage'),T_(KG,"Elle veut un journal. Elle sait lire, elle. Je dis ça, je ne dis rien.")],
  8:[J(HN,['たぬき','先生|せんせい','は','毎日|まいにち','寝て|ねて','います','。'],'Maître Tanuki dort tous les jours.','〜ています = être en train de'),J(HN,['「','教えて|おしえて','います','」','と','言います|いいます','。'],'Il dit : « Je suis en train d\'enseigner. »'),J(HN,['金曜日|きんようび','に','魚|さかな','を','食べます|たべます','。','お兄ちゃん|おにいちゃん','の','分|ぶん','も','。'],'Vendredi, je mange du poisson. Ta part aussi.','分 (ぶん) = la part de quelqu\'un'),T_(KG,"Elle mange ta part. Je commence à bien l'aimer.")]});
 const oJizo=STORY.jizo;STORY.jizo=async e=>{const z=W.zone();if(S.fl.act1&&LET[z]&&!S.fl['let'+z]){S.fl['let'+z]=1;sfx('item');await D.say(["Une lettre pliée est glissée sous la statue. Tu reconnais l'écriture, et les taches de sauce."].concat(LET[z]));save()}await oJizo(e)};
 /* --- gardiens : un mot avant, un mot après --- */
 const GPRE={kakashi:[J(0,['止まれ|とまれ','！'],'Halte !','止まれ : forme d\'ordre de 止まる, s\'arrêter'),T_(0,"Par ordre du seigneur Tetsu, cette route est fermée. Et de toute façon, cette rizière est à moi. Celle d'à côté aussi. Tu marches sur ma boue, là. Rends-la.")],
  karakasa:[J(0,['こんばんは','！','祭り|まつり','は','好き|すき','です','か','。'],'Bonsoir ! Aimez-vous les fêtes ?','祭り (まつり) = fête, festival'),T_(0,"Je pose la question à tout le monde. Ensuite je frappe, quelle que soit la réponse. Mais demander d'abord, je trouve ça plus festif.")],
  smoke:[J(0,['いらっしゃいませ','。'],'Bienvenue.','いらっしゃいませ : la formule d\'accueil des boutiques'),T_(0,"Thé ? … Thé ? … Thé ? Pardon. Mon ressort saute. On m'a remontée pour servir, puis on m'a ordonné de barrer la route. Je fais les deux. Thé ?"),J(0,['通しません|とおしません','。'],'Je ne vous laisserai pas passer.','通します = laisser passer')],
  kyorin:["Devant la porte scellée, un tas de rouleaux se déplie, se redresse et te regarde par-dessus un bec de papier.",J(0,['試験|しけん','を','始めます|はじめます','。'],"L'examen commence.",'始めます (はじめます) = commencer'),T_(0,"Je suis fait de tous les livres que personne n'a ouverts. Il y en a beaucoup. J'ai donc beaucoup de questions, et très peu de patience.")],
  wanyudo:["Une roue de tramway dévale les rails dans des flammes bleues et s'arrête net devant le portillon. Au milieu, une tête de moine. Sur la tête, un képi.",J(0,['切符|きっぷ','を','見せて|みせて','ください','。'],'Votre billet, s\'il vous plaît.','切符 (きっぷ) = billet'),T_(0,"Pas de billet ? Le guichet est fermé depuis quarante ans. C'est moi qui l'ai fermé. Je contrôle quand même. Un contrôleur sans voyageurs, c'est juste une roue qui a chaud.")],
  umi:["L'eau se soulève devant l'embarcadère. Une tête noire, lisse, grande comme une maison, te regarde sans cligner.",J(0,['…','船|ふね','は','出ません|でません','。'],'… Aucun bateau ne partira.'),T_(0,"On m'a mis ce col. Il serre. Il fuit. Depuis, je n'entends plus le fleuve, seulement la vapeur. Alors plus personne ne traverse. C'est équitable.")],
  nuri:[J(0,['手形|てがた','を','見せて|みせて','ください','。'],'Votre laissez-passer, s\'il vous plaît.','手形 (てがた) = laissez-passer'),T_(0,"Pas de laissez-passer ? Alors formulaire B-12, en trois exemplaires, tamponné par le poste de contrôle. Le poste de contrôle, c'est moi. Je ne tamponne pas. Je suis un mur.")],
  toad:[J(0,['熱い|あつい','。'],'Chaud.','熱い (あつい) = brûlant, au toucher'),T_(0,"Je suis à la fois un fourneau et un fonctionnaire. On m'a mis une corde sacrée pour me calmer. Regarde l'aiguille. Est-ce que j'ai l'air calme ?")]};
 const GPOST={kakashi:[T_(0,"Trois ans à garder cette route… et la seule chose qui ait poussé sur moi, c'est du riz. On ne m'a même pas laissé le goûter."),J(0,['疲れました|つかれました','。'],'Je suis fatigué.')],
  karakasa:[T_(0,"J'étais la plus belle lanterne de la fête. Puis la fête a fini, et personne ne m'a éteinte. Cent ans allumée ! Tu imagines la note de gaz ?"),J(0,['さようなら','。'],'Adieu.')],
  smoke:[J(0,['お茶|おちゃ','…','冷めました|さめました','…'],'Le thé… a refroidi…','冷めます (さめます) = refroidir'),T_(0,"Cent tasses servies, pas une seule bue. Alors c'est ça, s'arrêter ? … C'est reposant.")],
  kyorin:["Le pinceau rouge tombe. Les rouleaux se rembobinent un à un, presque soulagés.",J(0,['よく','できました','。'],'Très bien réussi.','よくできました : ce que dit le professeur à un bon élève'),T_(0,"Tu m'as lu. Enfin, tu m'as frappé, mais en lisant. C'est plus que ce qu'ont fait les étudiants en cent ans. Passe. Et rends tes livres à l'heure.")],
  wanyudo:["Les flammes retombent. La roue fume doucement, comme une bouilloire qu'on a oubliée.",J(0,['どうぞ','、','お乗り|おのり','ください','。'],'Je vous en prie, montez.','乗ります (のります) = monter à bord'),T_(0,"Quarante ans que je réclame un billet. Tu es le premier à me répondre autre chose que « aaah ». Je te poinçonne la manche, pour le principe.")],
  umi:["Le col de laiton se fend et tombe dans l'eau avec un bruit de casserole.",J(0,['静か|しずか','です','ね','。'],"C'est calme, hein.",'静か (しずか) = calme, silencieux'),T_(0,"J'entends le fleuve. Il dit que tu peux passer. Il dit aussi que tu nages très mal, mais ça, je l'avais vu.")],
  nuri:[T_(0,"Trente ans que personne n'était passé. Trente ans de service impeccable. … Tu vas faire un rapport défavorable, c'est ça ?"),J(0,['どうぞ','、','通って|とおって','ください','。'],'Je vous en prie, passez.','どうぞ = je vous en prie')],
  toad:[T_(0,"Du riz. Tout ce que je voulais, c'était cuire du riz. On m'a donné du charbon et des ordres."),J(0,['ご飯|ごはん','…'],'Du riz…')]};
 const named=(l,n)=>l.map(x=>typeof x==='string'?x:Object.assign({},x,{n}));
 const oGuard=STORY.guard;STORY.guard=async(e,seen)=>{if(e.rov||!GPRE[e.id])return oGuard(e,seen);const nm=EN[e.id].n,had=S.wins[e.id];if(!S.fl['gp_'+e.id]){S.fl['gp_'+e.id]=1;W.faceTo(e,W.H);await D.say(named(GPRE[e.id],nm))}await oGuard(e,seen);if(!had&&S.wins[e.id])await D.say(named(GPOST[e.id],nm))};
 /* --- ennemis errants : un cri ridicule, une sortie ridicule --- */
 const KC={tayoma:[['どろ','、','好き|すき','です','か','。'],'Tu aimes la boue ?',"Le Yōma des rizières retourne à sa flaque. Il t'en veut. La flaque aussi."],
  kodama:[['…','…','カタカタ','。'],'… … clac clac.',"Le Kodama s'éloigne en faisant clac clac. C'est peut-être un rire. Ou un genou."],
  kakashi:[['道|みち','に','迷いました|まよいました','。'],'Je me suis perdu.',"L'Épouvantail errant repart dans la mauvaise direction, avec assurance."],
  karakasa:[['雨|あめ','は','まだ','です','か','。'],'Il pleut bientôt ?',"La Petite ombrelle se referme d'un coup sec. C'est sa façon de claquer la porte."],
  smoke:[['ゴホ','ゴホ','。'],'Kof kof.',"La Suie vivante se dissipe en toussant, vexée d'avoir été confondue avec un nuage."],
  toad:[['見ないで|みないで','ください','！'],'Ne me regarde pas !',"Le Crapaudeau s'en va, très vexé. Il se retourne pour vérifier que tu as bien vu qu'il était vexé."],
  braise:[['熱い|あつい','！','自分|じぶん','が','熱い|あつい','！'],'Ça brûle ! Je me brûle moi-même !',"La Braise errante s'éteint dans un petit « pfff » déçu."],
  yoma:[['言葉|ことば','を','ください','。'],'Donne-moi des mots.',"Le Yōma se dissout. Il emporte une virgule, par principe."]};
 const oDef=STORY.wildDef;STORY.wildDef=(z,kind)=>{const d=oDef(z,kind),k=Object.keys(RKIND).find(n=>RKIND[n]===d.kind),c=KC[k];if(c){d.cry=c[0];d.cryFr=c[1];d.bye=c[2]}return d};
 /* --- habitants à gags récurrents --- */
 const rot=(key,orig,gags)=>async e=>{const n=S.fl[key]||0;S.fl[key]=n+1;if(n%(gags.length+1)===0)return orig(e);await D.say(gags[n%(gags.length+1)-1])};
 STORY.kid=rot('g_kid',STORY.kid,[[J('Enfant',['まだ','おなか','が','すいて','います','。'],"J'ai encore faim.",'まだ = encore'),T_('Enfant',"J'ai mangé il y a dix minutes. Mais c'était il y a dix minutes.")],
  [J('Enfant',['それ','、','食べられます|たべられます','か','。'],'Ça se mange, ça ?','食べられます = « pouvoir être mangé »'),"Il regarde ton sabre d'entraînement avec un intérêt qui ne te plaît pas."],
  [J('Enfant',['石|いし','は','おいしくない','です','。'],"Les cailloux, ce n'est pas bon.",'おいしくない : négation de おいしい'),T_('Enfant',"Ne me demande pas comment je le sais.")]]);
 STORY.fisher=rot('g_fish',STORY.fisher,[[J('Pêcheur',['今日|きょう','も','ゼロ','です','。'],"Aujourd'hui encore : zéro.",'も = aussi, encore'),T_('Pêcheur',"Quarante ans de métier. Quarante ans de zéro. À ce stade, c'est de la constance.")],
  [J('Pêcheur',['魚|さかな','は','私|わたし','が','きらい','です','。'],'Les poissons me détestent.'),T_('Pêcheur',"Hier, un poisson a sauté hors de l'eau pour me regarder dans les yeux. Puis il est reparti.")],
  [J('Pêcheur',['長靴|ながぐつ','を','釣りました|つりました','！'],"J'ai pêché une botte !",'長靴 (ながぐつ) = botte · 釣ります = pêcher'),T_('Pêcheur',"C'est la troisième cette année. Il m'en manque une pour faire deux paires.")]]);
 STORY.jii=rot('g_jii',STORY.jii,[[J('Vieil homme',['はし','で','はし','を','渡ります|わたります','。'],'Je traverse le pont avec des baguettes.','はし = pont (橋) ou baguettes (箸). Seul l\'accent change.'),T_('Vieil homme',"Ou bien je traverse les baguettes avec un pont. À mon âge, on ne fait plus la différence.")],
  [J('Vieil homme',['かみ','に','かみ','を','ください','。'],'Du papier pour le dieu, s\'il te plaît. Ou des cheveux.','かみ = papier (紙), dieu (神) ou cheveux (髪)'),T_('Vieil homme',"J'ai prié pour avoir des cheveux. J'ai reçu du papier. Les dieux aussi confondent.")],
  [J('Vieil homme',['あめ','が','降って|ふって','います','。'],'Il pleut. Ou il tombe des bonbons.','あめ = pluie (雨) ou bonbon (飴)'),T_('Vieil homme',"Je sors toujours avec un parapluie et la bouche ouverte. On ne sait jamais.")]]);
 const TG=[[J('Maître Tanuki',['私|わたし','は','たぬき','じゃない','です','。'],'Je ne suis pas un tanuki.'),T_('Maître Tanuki',"Je suis un homme. Un homme rond, poilu, avec un masque naturel autour des yeux. Ça arrive dans les meilleures familles.")],
  [T_('Maître Tanuki',"Cette queue ? Quelle queue ? … Ah, celle-là. C'est une écharpe. Je la porte bas.")],
  [J('Maître Tanuki',['たぬき','を','見ました|みました','か','。','どこ','？'],'Tu as vu un tanuki ? Où ça ?'),"Il regarde derrière lui avec beaucoup trop d'application."]];
 const oTanu=STORY.tanu;STORY.tanu=async e=>{await oTanu(e);if(S.les.l1){const n=S.fl.g_tanu||0;S.fl.g_tanu=n+1;UI.panel('pad');await D.say(TG[n%TG.length])}};
}

/* ---------- ennemis à caractère, revenants, trésors cachés, épreuves des hameaux ---------- */
const TRAITS={fog:['Suie épaisse','elle cache le modèle : tu traces sans aide, mais tes coups portent +30 %.'],
 words:['Toile huilée','les kanji glissent dessus (dégâts ÷2). Les phrases, elles, font double dégâts.'],
 ear:['Coassements','il attaque à la voix : ses parades se jouent à l\'oreille.'],
 burn:['Combustion','elle perd 5 PV à chaque tour, toute seule, mais elle frappe fort.'],
 mimic:['Écho','il retient ton dernier kanji : le même deux fois de suite fait moitié moins mal.'],
 frost:['Souffle de givre','le froid t\'engourdit : tu as un quart de temps en moins pour parer.'],
 stiff:['Raide comme un piquet','il n\'attaque qu\'un tour sur deux, mais presque deux fois plus fort.']};
(()=>{
 const TRK={jinda:'ear',ashig:'stiff',mushi:'words',gasha:'fog',kamai:'ear',okuri:'stiff',beto:'fog',sune:'burn',mikoshi:'stiff',okubi:'ear',zori:'mimic',uneri:'fog',ashinaga:'stiff',tenome:'fog',ashi:'stiff',tsuchi:'mimic',raiju:'burn',tsurube:'stiff',mokumoku:'fog',hitotsume:'ear',ippon:'stiff',kanedama:'words',kasha:'burn',abura:'fog',ittan:'stiff',suzuri:'fog',kamikiri:'words',soroban:'mimic',nekomata:'burn',rokuro:'mimic',akaname:'words',noppera:'stiff',kappa:'words',tsuru:'stiff',namazu:'burn',funa:'frost',nurikabe:'stiff',kitsune:'mimic',tengu:'fog',koma:'ear',doro:'stiff',chochin:'burn',karakuri:'mimic',kamado:'fog',nobusuma:'ear',hone:'stiff',oni:'frost',yukidama:'stiff',karasu:'mimic',smoke:'fog',karakasa:'words',toad:'ear',braise:'burn',kodama:'mimic',kakashi:'stiff'};
 const ATK={jinda:'Roulement de guerre',ashig:'Coup de pinceau-lance',mushi:'Ciseaux à noms',gasha:'Étreinte des oubliés',kamai:'Plongeon de flamme bleue',okuri:'Morsure du voyageur',beto:'Rafale de l\'œil unique',sune:'Souffle de braises',mikoshi:'Cou télescopique',okubi:'Souffle de vapeur',zori:'Racines griffues',uneri:'Tourbillon de poussière',ashinaga:'Hameçon télescopique',tenome:'Regard des paumes',ashi:'Morsure des mandibules',tsuchi:'Lecture des pensées',raiju:'Décharge de fusible',tsurube:'Chute de poulie',mokumoku:'Regard fixe',hitotsume:'Coup de longue-vue',ippon:'Coup de marteau-pilon',kanedama:'Pluie de monnaie',kasha:'Wagonnet fou',abura:'Giclée d\'huile',ittan:'Bourrage papier',suzuri:'Giclée d\'encre',kamikiri:'Coup de massicot',soroban:'Addition salée',nekomata:'Coup de hérisson',rokuro:'Coup de cou télescopique',akaname:'Grand coup de langue',noppera:'Coup de tampon',kappa:'Jet de burette',tsuru:'Coup de bec à ressort',namazu:'Moustache électrique',funa:'Louche d\'eau froide',nurikabe:'Barrage',hikyaku:'Colis recommandé',kitsune:'Feu follet',tengu:'Éventail à vapeur',koma:'Rugissement de pierre',itachi:'Coup de faucille à piston',doro:'Poignée de boue',chochin:'Coup de langue',takenoko:'Pique de bambou',karakuri:'Thé brûlant',tesso:'Coup de clé à molette',kamado:'Bouffée de suie',nobusuma:'Cri strident',hone:'Lance rouillée',hitokage:'Sifflet de théière',oni:'Massue à vapeur',yuzaru:'Seau d\'eau chaude',tayoma:'Jet de boue',kodama:'Clac-clac',kakashi:'Coup de paille',karakasa:'Coup de baleine',yukidama:'Jet de vapeur glacée',karasu:'Coup de bec en laiton',smoke:'Toux noire',toad:'Grand coassement',braise:'Étincelle',yoma:'Murmure'};
 Object.assign(RKIND,{jinda:{s:'jinda',sc:.95,n:()=>'Jindaiko, tambour de guerre',weak:'雷',res:'火'},ashig:{s:'ashig',sc:.9,n:()=>'Ashigaru-zutsu, fantassin-encrier',weak:'火',res:'水'},mushi:{s:'mushi',sc:.85,n:()=>'Tetsu-mushi, scarabée-scribe',weak:'火',res:'木'},gasha:{s:'gasha',sc:1.1,n:()=>'Gashadokuro des oubliés',weak:'雷',res:'土'},
  ashig2:{s:'ashig',bt:'ashig2',sc:1.2,tint:'cool',el:1,n:()=>'Ashigaru-zutsu rouillé'},mushi2:{s:'mushi',bt:'mushi2',sc:1.2,tint:'cool',el:1,n:()=>'Tetsu-mushi aux ciseaux brisés'},
  kamai:{s:'kamai',sc:.9,n:()=>"Itsumade, l'oiseau-démon",weak:'水',res:'火'},okuri:{s:'okuri',n:()=>'Okuri-inu à lanterne',weak:'水',res:'火'},beto:{s:'beto',sc:.95,n:()=>"Ichimokuren, le dragon à l'œil unique",weak:'土',res:'風'},sune:{s:'sune',sc:.8,n:()=>'Basan, le coq de feu',weak:'水',res:'火'},
  kamai2:{s:'kamai',bt:'kamai2',sc:1.2,tint:'cool',el:1,n:()=>'Itsumade aux plumes rouillées'},okuri2:{s:'okuri',bt:'okuri2',sc:1.2,tint:'cool',el:1,n:()=>'Okuri-inu à la lanterne froide'},
  mikoshi:{s:'mikoshi',n:()=>'Mikoshi-nyūdō télescopique',weak:'雷',res:'土'},okubi:{s:'okubi',sc:.95,n:()=>'Ōkubi cadran',weak:'木',res:'風'},zori:{s:'zori',sc:.85,n:()=>'Ninmenju des jardins',weak:'火',res:'水'},uneri:{s:'uneri',sc:.95,n:()=>'Shiro-uneri à ressorts',weak:'水',res:'風'},
  mikoshi2:{s:'mikoshi',bt:'mikoshi2',sc:1.2,tint:'cool',el:1,n:()=>'Mikoshi-nyūdō sans fin'},okubi2:{s:'okubi',bt:'okubi2',sc:1.2,tint:'cool',el:1,n:()=>'Ōkubi au cadran brisé'},
  ashinaga:{s:'ashinaga',n:()=>'Ashinaga-Tenaga',weak:'火',res:'水'},tenome:{s:'tenome',sc:.95,n:()=>'Tenome horloger',weak:'火',res:'土'},ashi:{s:'ashi',sc:.85,n:()=>'Kurogane-mukade, le mille-pattes de fer',weak:'雷',res:'土'},tsuchi:{s:'tsuchi',sc:.8,n:()=>'Satori aux antennes',weak:'火',res:'雷'},
  tenome2:{s:'tenome',bt:'tenome2',sc:1.2,tint:'cool',el:1,n:()=>'Tenome aux paumes vides'},ashi2:{s:'ashi',bt:'ashi2',sc:1.2,tint:'cool',el:1,n:()=>'Kurogane-mukade rouillé'},
  raiju:{s:'raiju',sc:.9,n:()=>'Raijū des fusibles',weak:'土',res:'雷'},tsurube:{s:'tsurube',sc:.95,n:()=>'Tsurube-otoshi des haubans',weak:'火',res:'風'},mokumoku:{s:'mokumoku',sc:.9,n:()=>'Mokumokuren de toile',weak:'火',res:'水'},hitotsume:{s:'hitotsume',sc:.85,n:()=>'Hitotsume-kozō vigie',weak:'雷',res:'土'},
  raiju2:{s:'raiju',bt:'raiju2',sc:1.2,tint:'cool',el:1,n:()=>'Raijū d\'orage'},tsurube2:{s:'tsurube',bt:'tsurube2',sc:1.25,tint:'cool',el:1,n:()=>'Grand tsurube des haubans'},
  ippon:{s:'ippon',sc:.95,n:()=>'Ippon-datara',weak:'水',res:'火'},kanedama:{s:'kanedama',sc:.85,n:()=>'Kanedama',weak:'雷',res:'土'},kasha:{s:'kasha',sc:1,n:()=>'Kasha en wagonnet',weak:'水',res:'火'},abura:{s:'abura',sc:.9,n:()=>'Abura-sumashi graisseur',weak:'火',res:'水'},
  ittan:{s:'ittan',sc:.9,n:()=>'Ittan-momen de papier',weak:'火',res:'風'},suzuri:{s:'suzuri',sc:.9,n:()=>'Pierre à encre grognon',weak:'水',res:'土'},kamikiri:{s:'kamikiri',sc:.9,n:()=>'Kamikiri au massicot',weak:'雷',res:'木'},soroban:{s:'soroban',sc:.9,n:()=>'Soroban-bōzu',weak:'雷',res:'土'},
  nekomata:{s:'nekomata',sc:.9,n:()=>'Nekomata ramoneur',weak:'水',res:'火'},rokuro:{s:'rokuro',sc:.95,n:()=>'Rokurokubi à tuyau',weak:'雷',res:'風'},akaname:{s:'akaname',sc:.9,n:()=>'Akaname des bains',weak:'火',res:'水'},noppera:{s:'noppera',sc:.9,n:()=>'Noppera-bō de bureau',weak:'木',res:'土'},nekomata2:{s:'nekomata',bt:'nekomata2',sc:1.25,tint:'cool',el:1,n:()=>'Bakeneko de la chaudière'},akaname2:{s:'akaname',bt:'akaname2',sc:1.2,tint:'cool',el:1,n:()=>'Grand lécheur du bain condamné'},noppera2:{s:'noppera',bt:'noppera2',sc:1.15,tint:'ink',el:1,n:()=>'Chef de bureau sans visage'},ippon2:{s:'ippon',bt:'ippon2',sc:1.25,tint:'cool',el:1,n:()=>'Forgeron de la lame maudite'},kasha2:{s:'kasha',bt:'kasha2',sc:1.25,tint:'cool',el:1,n:()=>'Wagonnet du dernier quart'},suzuri2:{s:'suzuri',bt:'suzuri2',sc:1.25,tint:'cool',el:1,n:()=>'Encrier sans fond'},kamikiri2:{s:'kamikiri',bt:'kamikiri2',sc:1.2,tint:'cool',el:1,n:()=>'Grand Correcteur'},rokuro2:{s:'jorogumo',bt:'jorogumo',sc:1.05,el:1,n:()=>'Jorōgumo des câbles'},
  kappa:{s:'kappa',sc:.9,n:()=>'Kappa mécanicien',weak:'雷',res:'水'},tsuru:{s:'tsuru',sc:.95,n:()=>'Grue à ressort',weak:'雷',res:'風'},namazu:{s:'namazu',sc:1,n:()=>'Poisson-chat de cuivre',weak:'木',res:'雷'},funa:{s:'funa',sc:.9,n:()=>'Fantôme de batelier',weak:'火',res:'水'},namazu2:{s:'namazu',bt:'namazu2',sc:1.5,tint:'dark',el:1,n:()=>'Grand namazu'},
  nurikabe:{s:'nurikabe',sc:.9,n:()=>'Nurikabe',weak:'水',res:'土'},hikyaku:{s:'hikyaku',sc:.9,n:()=>'Coursier automate',weak:'雷',res:'風'},kitsune:{s:'kitsune',sc:.9,n:()=>'Renard voyageur',weak:'水',res:'火'},tengu:{s:'tengu',sc:.9,n:()=>'Petit tengu',weak:'雷',res:'風'},koma:{s:'koma',sc:.9,n:()=>'Lion-chien de pierre',weak:'木',res:'土'},hikyaku2:{s:'hikyaku',bt:'hikyaku2',sc:1.1,tint:'r',el:1,n:()=>'Coursier express'},
  itachi:{s:'itachi',sc:.9,n:()=>'Belette-faucille',weak:'火',res:'風'},doro:{s:'doro',sc:.9,n:()=>'Spectre de boue',weak:'火',res:'土'},chochin:{s:'chochin',sc:.9,n:()=>'Lanterne fantôme',weak:'水',res:'火'},takenoko:{s:'takenoko',sc:.9,n:()=>'Pousse-fantassin',weak:'火',res:'木'},
  karakuri:{s:'karakuri',sc:.9,n:()=>'Poupée automate',weak:'水',res:'雷'},tesso:{s:'tesso',sc:.9,n:()=>'Rat de fer',weak:'雷',res:'土'},kamado:{s:'kamado',sc:.9,n:()=>'Fourneau grognon',weak:'水',res:'火'},nobusuma:{s:'nobusuma',sc:.9,n:()=>'Chauve-souris de suie',weak:'雷',res:'風'},
  hone:{s:'hone',sc:.9,n:()=>'Fantassin d\'os',weak:'火',res:'風'},hitokage:{s:'hitokage',sc:.9,n:()=>'Salamandre de forge',weak:'水',res:'火'},oni:{s:'oni',sc:.9,n:()=>'Petit oni des neiges',weak:'火',res:'水'},yuzaru:{s:'yuzaru',sc:.9,n:()=>'Macaque des sources',weak:'雷',res:'水'},yukidama:{s:'yukidama',sc:.9,n:()=>'Bouilloire des neiges'},karasu:{s:'karasu',sc:.9,n:()=>'Corbeau à ressort'},kakashi2:{s:'kaka',bt:'kakashi2',sc:.98,tint:'dark',el:1,n:()=>'Épouvantail rancunier'},karakasa2:{s:'karakasa',bt:'karakasa2',sc:.98,tint:'r',el:1,n:()=>'Ombrelle de gala'},
  smoke2:{s:'smoke',bt:'smoke2',sc:.98,tint:'ink',el:1,n:()=>'Suie de cheminée'},toad2:{s:'toad',bt:'toad2',sc:.98,tint:'warm',el:1,n:()=>'Crapaud notaire'},braise2:{s:'braise',bt:'braise2',sc:1.3,tint:'cool',el:1,n:()=>'Braise majuscule'},hone2:{s:'hone',bt:'hone2',sc:1.1,tint:'warm',el:1,n:()=>'Capitaine d\'os'},oni2:{s:'oni',bt:'oni2',sc:1.15,tint:'cool',el:1,n:()=>'Grand oni du givre'}});
 /* répliques supplémentaires : [cri, traduction, sortie] */
 const KV={jinda:[[['ドン','！','ドン','！'],'Boum ! Boum !',"Le tambour te bat la mesure si fort que tu en as mal aux dents, puis il part au pas de charge, vers une guerre qu'il est seul à entendre."],
   [['静か|しずか','に','して','ください','。'],'Du calme, s\'il te plaît.',"Le Jindaiko s'arrête net, vexé, fronce sa peau de tambour et s'éloigne en tapotant tout doucement."]],
  ashig:[[['止まれ|とまれ','！','名前|なまえ','は','？'],'Halte ! Ton nom ?',"Tu donnes ton nom. Le soldat le cherche dans son registre, ne le trouve pas, se gratte le couvercle et repart en patrouille, perplexe."],
   [['命令|めいれい','です','。'],'Ce sont les ordres.',"Le fantassin-encrier salue, se cogne la lance contre le casque, et s'éloigne en clopinant, une flaque d'encre derrière lui."]],
  mushi:[[['チョキ','、','チョキ','。'],'Tchic, tchac.',"Le scarabée claque des ciseaux, découpe une feuille morte en forme de nom, l'avale et trottine vers d'autres rayonnages."],
   [['紙|かみ','を','ください','。'],'Du papier, s\'il te plaît.',"Tu lui tends une page vierge. Il la range délicatement dans son dôme et part, ravi."]],
  gasha:[[['私|わたし','の','名前|なまえ','は','？'],'Mon nom, c\'était quoi ?',"Le grand squelette fouille dans ses côtes, sort un rouleau, le déroule : il est vide. Il le range en soupirant et s'enfonce dans l'ombre des rayons."],
   [['忘れないで|わすれないで','…'],'Ne m\'oublie pas…',"Ses flammes bleues vacillent. Il te regarde longtemps, comme pour retenir ton visage, puis il s'en va."]],
  kamai:[[["いつ", "まで", "です", "か", "。"], "Jusqu'à quand ?", "C'est le cri de la légende : いつまで, « jusqu'à quand ? ». L'oiseau-démon le répète en tournant au-dessus de toi, puis file vers les nuages."], [["空|そら", "へ", "帰ります|かえります", "。"], "Je rentre dans le ciel.", "Étonné qu'on lui parle poliment, il replie ses ailes de lames et remonte dans le ciel en une seule flamme bleue."]],
  okuri:[[['ついて','来ないで|こないで','ください','。'],'Ne me suis pas, s\'il te plaît.',"Le chien s'assoit, la tête penchée. Puis il décide d'aller suivre quelqu'un d'autre. Quelqu'un de moins bavard."],
   [['ありがとう','、','さようなら','。'],'Merci, au revoir.',"Dans les légendes, il faut remercier l'Okuri-inu pour qu'il vous laisse. Il remue la queue, souffle un nuage de vapeur, et s'en va."]],
  beto:[[["大きい|おおきい", "目|め", "でしょう", "。"], "Un grand œil, hein ?", "L'œil unique te fixe longtemps, cligne une fois, et le dragon remonte dans les nuages en sifflant comme une bouilloire."], [["風|かぜ", "が", "強い|つよい", "です", "。"], "Le vent est fort.", "La tempête qu'il traîne derrière lui t'arrache ton chapeau. Le temps de le ramasser, il est déjà loin."]],
  sune:[[["あつい", "です", "よ", "。"], "C'est chaud, tu sais.", "Le coq de feu secoue ses plumes : une pluie de braises retombe autour de toi, et il s'en va en battant des ailes, basa, basa, basa."], [["朝|あさ", "です", "！"], "C'est le matin !", "Il pousse un cri à réveiller tout le plateau, alors qu'il fait nuit noire, et repart très fier de lui."]],
  mikoshi:[[['上|うえ','を','見て|みて','ください','。'],'Regarde en haut, s\'il te plaît.',"Le Mikoshi-nyūdō rétrécit d'un coup, tube par tube, clac clac clac. Il ne reste qu'un petit moine vexé qui s'éloigne en grommelant."],
   [['ぼく','は','高い|たかい','です','か','。'],'Je suis grand, hein ?',"Il s'étire encore un peu pour te dominer, perd l'équilibre, et part en titubant comme un mât un jour de tempête."]],
  okubi:[[['今|いま','は','何時|なんじ','です','か','。'],'Quelle heure est-il ?',"La grosse tête consulte son propre front, fronce les sourcils, et s'envole en soufflant de la vapeur. Elle ne sait pas non plus."],
   [['大きい|おおきい','顔|かお','です','ね','。'],'Grand visage, hein ?',"Elle s'éloigne lentement dans le ciel comme une lune grognon."]],
  zori:[[["おもしろい", "です", "ね", "。"], "C'est amusant, hein.", "Toutes les têtes de l'arbre éclatent de rire en même temps. La jarre repart sur ses pieds de fer, et les rires s'entendent encore longtemps après."], [["水|みず", "を", "ください", "。"], "De l'eau, s'il te plaît.", "Tu verses un peu d'eau dans la jarre. Les visages font la grimace : ce n'est pas d'eau qu'ils avaient soif. L'arbre s'en va, vexé."]],
  uneri:[[['そうじ','を','して','ください','。'],'Fais le ménage, s\'il te plaît.',"Le Shiro-uneri s'enroule autour d'une horloge et la fait briller. Il est vexé, mais il ne peut pas s'en empêcher."],
   [['ほこり','が','好き|すき','です','。'],'J\'aime la poussière.',"Il s'envole en laissant une traînée de poussière. Quelque part, une ménagère soupire."]],
  ashinaga:[[['上|うえ','は','魚|さかな','、','下|した','は','足|あし','。'],'En haut, le poisson. En bas, les jambes.',"Ashinaga repart à grandes enjambées, Tenaga accroché à sa tête. Ils se disputent pour savoir qui a perdu. C'est toujours l'autre."],
   [['手|て','が','長い|ながい','です','。','足|あし','も','長い|ながい','です','。'],'Les bras sont longs. Les jambes aussi.',"Tenaga t'attrape ton chapeau au bout de sa canne, s'excuse, et te le rend. Puis il le reprend. Puis il le rend. Ils s'en vont."]],
  tenome:[[['手|て','で','見て|みて','います','よ','。'],'Je te regarde avec les mains, tu sais.',"Le Tenome range ses mains dans ses manches. Il ne voit plus rien. Il trouve ça reposant."],
   [['手|て','を','たたかないで','ください','。'],'Ne frappe pas dans tes mains, s\'il te plaît.',"Il s'éloigne à tâtons. Quelqu'un applaudit au loin. Il pousse un cri : ça lui a fait mal aux yeux."]],
  ashi:[[["足|あし", "が", "たくさん", "あります", "。"], "J'ai beaucoup de pattes.", "Le mille-pattes de fer compte ses pattes, se trompe, recommence, et s'enfonce sous les rails en grinçant."], [["暗い|くらい", "ところ", "が", "好き|すき", "です", "。"], "J'aime les endroits sombres.", "Il se glisse dans une fente du sol, segment après segment. Il lui faut une bonne minute pour disparaître tout entier."]],
  tsuchi:[[["あなた", "の", "名前|なまえ", "を", "知っています|しっています", "。"], "Je connais ton nom.", "Le Satori ricane, répète ton nom trois fois avec ta propre voix, et disparaît entre les arbres. Tu n'as rien dit."], [["言わないで|いわないで", "ください", "。", "わかります", "。"], "Ne le dis pas. Je sais.", "Il tapote son casque à antennes d'un air entendu, et s'éloigne en grésillant."]],
  raiju:[[['ゴロゴロ','。','雨|あめ','は','まだ','です','か','。'],'Grrr. La pluie, c\'est pour bientôt ?',"Le Raijū se roule en boule dans un moteur et s'endort en grésillant. Il rêve d'orage."],
   [['電気|でんき','を','ください','。'],'Donne-moi de l\'électricité.',"Il te lèche la main. Tes cheveux restent dressés jusqu'au soir."]],
  tsurube:[[['こんにちは','。','上|うえ','から','失礼|しつれい','します','。'],'Bonjour. Pardon de vous déranger d\'en haut.',"La tête du Tsurube-otoshi remonte au bout de sa corde, très lentement, en s'excusant à chaque mètre."],
   [['下|した','を','見ないで|みないで','ください','。'],'Ne regarde pas en bas.',"Il remonte dans les haubans en fermant les yeux. Il a le vertige. C'est un métier difficile, pour lui."]],
  mokumoku:[[['見て|みて','います','よ','。'],'Je te regarde, tu sais.',"Les yeux du Mokumokuren se referment un par un. Le dernier te fait un clin d'œil."],
   [['目|め','が','痛い|いたい','です','。'],'J\'ai mal aux yeux.',"Il se colle une rustine sur un œil et repart en voyant un tout petit peu moins bien."]],
  hitotsume:[[['ぼく','の','目|め','は','一つ|ひとつ','です','。'],'Moi, j\'ai un seul œil.',"Le Hitotsume-kozō range sa longue-vue. Avec un seul œil, il n'a jamais eu besoin de fermer l'autre."],
   [['あそこ','に','雲|くも','が','あります','。'],'Là-bas, il y a un nuage.',"Il te montre le nuage avec une immense fierté. Il y en a des milliers. C'est son préféré."]],
  ippon:[[['足|あし','は','一本|いっぽん','で','いい','です','。'],'Une seule jambe, ça suffit.',"L'Ippon-datara repart en sautillant. Il laisse une seule empreinte, très profonde, tous les deux mètres."],
   [['この','鉄|てつ','は','まだ','熱い|あつい','です','。'],'Ce fer est encore chaud.',"Il te tend un fer à cheval brûlant, par politesse. Tu déclines. Il est vexé : c'était du travail soigné."]],
  kanedama:[[['いくら','です','か','。'],'C\'est combien ?',"Le Kanedama s'éparpille en petite monnaie. Tu ramasses une pièce. Elle te mord."],
   [['百|ひゃく','円|えん','、','千|せん','円|えん','、','一万|いちまん','円|えん','！'],'Cent yens, mille yens, dix mille yens !',"Il referme son tiroir d'un coup sec et s'envole en comptant. Il lui manque un yen. Il le cherchera toute la nuit."]],
  kasha:[[['どいて','ください','！'],'Poussez-vous, s\'il vous plaît !',"Le Kasha rate le virage et traverse un mur. On l'entend rire de l'autre côté."],
   [['ブレーキ','が','ありません','。'],'Il n\'y a pas de frein.',"Le wagonnet repart tout seul. Le chat court derrière. C'est une relation compliquée."]],
  abura:[[['油|あぶら','は','大事|だいじ','です','よ','。'],'L\'huile, c\'est important, tu sais.',"L'Abura-sumashi huile tes genoux en passant. Tu ne grinces plus. Tu ne t'étais jamais rendu compte que tu grinçais."],
   [['すべります','よ','。'],'Ça glisse, attention.',"Il s'en va en glissant sur sa propre flaque, très digne, sans bouger les pieds."]],
  ittan:[[['読んで|よんで','ください','。'],'Lisez-moi, s\'il vous plaît.',"L'Ittan-momen se rembobine tout seul. Il lui manque un bout. C'était la fin de l'histoire."],
   [['紙|かみ','が','ありません','。'],'Il n\'y a plus de papier.',"Il s'envole en claquant comme un drapeau. Trois étudiants le poursuivent : c'était leur mémoire."]],
  suzuri:[[['水|みず','を','少し|すこし','ください','。'],'Un peu d\'eau, s\'il te plaît.',"La Pierre à encre repart en laissant des empreintes noires. Elles forment un kanji. Il est mal écrit."],
   [['字|じ','が','きたない','です','ね','。'],'Ton écriture est sale, hein.',"Elle s'en va en marmonnant que de son temps, on broyait l'encre à la main et on se taisait."]],
  kamikiri:[[['少し|すこし','切って|きって','も','いい','です','か','。'],'Je peux couper un peu ?',"Le Kamikiri range ses ciseaux. Ta manche est plus courte d'un côté. Il appelle ça une mise en page."],
   [['長い|ながい','です','。','切ります|きります','。'],'C\'est trop long. Je coupe.',"Il repart en coupant sa propre ombre, par acquit de conscience."]],
  soroban:[[['三|さん','たす','四|よん','は','いくつ','です','か','。'],'Trois plus quatre, ça fait combien ?',"Le Soroban-bōzu recompte ta défaite. Puis la sienne. Il trouve un écart de deux coups et s'en va le chercher."],
   [['計算|けいさん','が','合いません|あいません','。'],'Le compte n\'est pas bon.',"Sa clé s'arrête de tourner. Il reste figé, un doigt levé, au milieu d'une retenue."]],
  nekomata:[[['えんとつ','は','きれい','です','。'],'La cheminée est propre.',"Le Nekomata ramoneur s'en va en laissant des traces de pattes noires. Partout. Sur toi aussi."],
   [['魚|さかな','を','ください','。'],'Du poisson, s\'il te plaît.',"Il file sur les toits, ses deux queues en feu. Il a oublié sa brosse. Il reviendra : c'est un chat."]],
  rokuro:[[['見て|みて','いません','よ','。'],'Je ne regardais pas, hein.',"La Rokurokubi rentre son cou segment par segment. Ça fait clac, clac, clac. Elle dit bonsoir, très digne."],
   [['首|くび','が','長い|ながい','です','か','。'],'Mon cou est-il long ?',"Elle s'en va en se cognant aux lanternes. Toutes. Une par une."]],
  akaname:[[['お風呂|おふろ','は','どこ','です','か','。'],'Où sont les bains ?',"L'Akaname repart vers le bain public en léchant les murs. La ville n'a jamais été aussi propre, ni aussi gênée."],
   [['石けん|せっけん','は','きらい','です','。'],'Je déteste le savon.',"Il glisse sur sa propre brosse et disparaît dans une bouche d'égout. Proprement."]],
  noppera:[[['書類|しょるい','を','出して|だして','ください','。'],'Présentez vos documents.',"Le Noppera-bō tamponne ton front « REFUSÉ » et s'en va, satisfait. Son aiguille est repassée dans le vert."],
   [['顔|かお','が','ありません','。'],'Je n\'ai pas de visage.',"Il soulève son chapeau pour saluer. Dessous, c'est pareil. Il est très poli."]],
  kappa:[[['きゅうり','を','ください','。'],'Un concombre, s\'il te plaît.',"Le Kappa mécanicien replonge. Il a réparé ta sandale au passage. Il te manque un lacet et il en reste trois de trop."],
   [['頭|あたま','の','水|みず','が','ありません','。'],'Je n\'ai plus d\'eau sur la tête.',"Il court vers le fleuve en tenant sa coupelle à deux mains. C'est une question de vie ou de mort, et aussi de coiffure."]],
  tsuru:[[['千年|せんねん','、','生きます|いきます','。'],'Je vivrai mille ans.',"La Grue à ressort s'immobilise sur une patte. Il faudra la remonter d'ici mardi."],
   [['ねじ','が','見えます|みえます','か','。'],'On voit ma clé ?',"Elle s'envole dignement, la clé tournant dans le dos. On la voyait."]],
  namazu:[[['地震|じしん','は','私|わたし','じゃ','ありません','。'],'Le séisme, ce n\'est pas moi.',"Le Poisson-chat de cuivre retombe sur le ponton. Tout tremble. Ce n'était pas lui. Enfin si."],
   [['ねむい','です','。'],'J\'ai sommeil.',"Il s'endort au milieu du chemin. Tu l'enjambes. Il grésille un peu."]],
  funa:[[['ひしゃく','を','貸して|かして','ください','。'],'Prête-moi une louche, s\'il te plaît.',"Le Fantôme de batelier repart avec sa louche. Elle est percée. On ne le lui a jamais dit, par gentillesse."],
   [['船|ふね','を','待って|まって','います','。','百年|ひゃくねん','。'],'J\'attends le bateau. Depuis cent ans.',"Il retourne attendre. Le bac passe juste derrière lui. Il regardait de l'autre côté."]],
  nurikabe:[[['通れません|とおれません','。'],'On ne passe pas.',"Le Nurikabe se pousse de dix centimètres. Pour lui, c'est une défaite écrasante."],
   [['壁|かべ','です','。','ドア','じゃ','ありません','。'],'Je suis un mur. Pas une porte.',"Il s'effrite un peu et s'en va, vexé qu'on l'ait pris pour une porte."]],
  hikyaku:[[['急いで|いそいで','います','！'],'Je suis pressé !',"Le Coursier automate repart en courant. Il livrera la nouvelle de sa défaite à quelqu'un d'autre."],
   [['手紙|てがみ','です','。','サイン','を','ください','。'],'Une lettre. Signez ici.',"Il te laisse un avis de passage et disparaît. Tu étais là. Il le sait. Il s'en fiche."]],
  kitsune:[[['私|わたし','は','人間|にんげん','です','。','本当|ほんとう','です','。'],'Je suis un humain. C\'est vrai.',"Le Renard voyageur s'éloigne dignement. Sa queue dépasse du manteau. Personne n'ose le lui dire."],
   [['今|いま','、','何時|なんじ','です','か','。'],'Quelle heure est-il ?',"Il consulte sa montre, constate qu'il est l'heure de fuir, et fuit."]],
  tengu:[[['鼻|はな','を','見ないで|みないで','ください','。'],'Ne regarde pas mon nez.',"Le Petit tengu s'envole, le nez en l'air. Avec un nez pareil, il n'a pas le choix."],
   [['私|わたし','は','山|やま','の','先生|せんせい','です','。'],'Je suis le maître de la montagne.',"Il repart donner des leçons à des pins. Les pins n'ont rien demandé."]],
  koma:[[['ここ','は','入り口|いりぐち','じゃありません','。'],'Ce n\'est pas une entrée, ici.',"Le Lion-chien de pierre retourne garder un sanctuaire qui n'est pas là. Il le gardera très bien."],
   [['ワン','。','…','ガオー','。'],'Ouaf. … Graou.',"Il n'a jamais su s'il était un lion ou un chien. Il s'en va y réfléchir."]],
  itachi:[[['速い|はやい','です','か','。','はい','、','速い|はやい','です','。'],'Je suis rapide ? Oui, je suis rapide.',"La Belette-faucille file dans les rizières. Elle a déjà oublié pourquoi elle se battait, mais elle l'a oublié très vite."],
   [['草|くさ','を','切ります|きります','。'],'Je coupe l\'herbe.',"Elle repart tondre un champ qui n'est pas le sien. Le fermier dira merci, puis recomptera ses doigts."]],
  doro:[[['私|わたし','の','田|た','は','どこ','です','か','。'],'Où est ma rizière ?',"Le Spectre de boue se rassoit dans sa rizière. Elle était à lui depuis le début. Il n'avait pas regardé."],
   [['水|みず','が','出ません|でません','。'],'L\'eau ne sort pas.',"Il tourne sa vanne dans le mauvais sens et s'en va, très arrosé."]],
  chochin:[[['暗い|くらい','です','ね','。'],'Il fait sombre, hein ?',"La Lanterne fantôme s'éteint. Elle a peur du noir. C'est ballot, pour une lanterne."],
   [['ベー','。','これ','は','舌|した','です','。'],'Bêêh. Ça, c\'est une langue.',"Elle rentre sa langue et s'éloigne en flottant, pas mécontente de sa démonstration."]],
  takenoko:[[['明日|あした','、','大きく|おおきく','なります','。'],'Demain, je serai grande.',"La Pousse-fantassin bat en retraite. Dans dix ans ce sera un grand bambou, et elle te retrouvera."],
   [['食べないで|たべないで','ください','。'],'Ne me mange pas, s\'il te plaît.',"Elle s'enfuit en criant qu'elle n'est pas de saison."]],
  karakuri:[[['お茶|おちゃ','を','どうぞ','。'],'Voici votre thé.',"La Poupée automate s'incline, fait demi-tour et repart servir un mur. Le mur ne boit pas. Elle insiste."],
   [['ねじ','を','まいて','ください','。'],'Remonte ma clé, s\'il te plaît.',"Elle s'arrête au milieu d'un pas, à court de ressort. Quelqu'un la remontera. Pas toi."]],
  tesso:[[['今日|きょう','は','休み|やすみ','です','。'],'Aujourd\'hui, c\'est repos.',"Le Rat de fer pose sa clé et déclare la pause. C'est la quatrième depuis ce matin."],
   [['それ','は','私|わたし','の','ねじ','です','。'],'Ça, c\'est ma vis.',"Il repart avec une vis de la barrière. La barrière tiendra. Probablement."]],
  kamado:[[['ご飯|ごはん','は','まだ','です','。'],'Le riz n\'est pas encore prêt.',"Le Fourneau grognon s'en va en fumant. Le riz ne sera jamais prêt : il n'y a pas de riz."],
   [['熱い|あつい','です','よ','。','さわらないで','。'],'C\'est chaud, tu sais. Ne touche pas.',"Il refroidit en boudant. Tu aurais pu y faire griller quelque chose, par politesse."]],
  nobusuma:[[['夜|よる','が','好き|すき','です','。'],'J\'aime la nuit.',"La Chauve-souris de suie repart dormir. Il est midi. Avec cette fumée, personne ne voit la différence."],
   [['何|なに','も','見えません|みえません','。','いつも','です','。'],'Je ne vois rien. Comme d\'habitude.',"Elle rajuste ses lunettes et fonce droit dans une cheminée."]],
  hone:[[['まだ','元気|げんき','です','。'],'Je suis encore en forme.',"Le Fantassin d'os perd un bras, le ramasse et s'en va. « En forme », c'est relatif."],
   [['名前|なまえ','を','忘れました|わすれました','。'],'J\'ai oublié mon nom.',"Il repart monter la garde devant un château qui a brûlé il y a cent ans."]],
  hitokage:[[['お湯|おゆ','が','わきました','。'],'L\'eau a bouilli.',"La Salamandre de forge s'éloigne, la théière sifflant sur sa tête. Elle n'a jamais compris d'où venait ce bruit."],
   [['ここ','は','あたたかい','です','ね','。'],'Il fait bon ici, hein ?',"Elle se roule dans les braises et s'endort. C'est la seule habitante heureuse du coin."]],
  oni:[[['鬼|おに','は','外|そと','！','…','あれ','？'],'Dehors, les démons ! … Hein ?',"Le Petit oni des neiges comprend qu'il vient de se chasser lui-même. Il sort, vexé."],
   [['寒く|さむく','ない','です','。'],'Je n\'ai pas froid.',"Il s'en va en claquant des dents. Sa massue fume plus que lui."]],
  yuzaru:[[['いい','お湯|おゆ','です','ね','。'],'Elle est bonne, l\'eau, hein ?',"Le Macaque des sources retourne à son bain. Tu l'as dérangé pour rien, et il te le fait sentir en ne te regardant pas."],
   [['タオル','を','返して|かえして','ください','。'],'Rends-moi ma serviette.',"La serviette était sur sa tête depuis le début."]],
  tayoma:[[['足|あし','が','冷たい|つめたい','です','。'],'J\'ai les pieds gelés.',"Le Yōma des rizières s'enfonce dans la boue en soupirant. Des bulles remontent. Elles soupirent aussi."],
   [['米|こめ','は','おいしい','です','か','。'],'C\'est bon, le riz ?',"Il repart sans avoir goûté le riz. C'est toute la tragédie de sa vie."]],
  kodama:[[['木|き','です','。','たぶん','。'],'Je suis un arbre. Probablement.',"Le Kodama retourne faire l'arbre. Il n'est pas très convaincant."],
   [['しずか','に','して','ください','。'],'Silence, s\'il te plaît.',"Le Kodama s'en va en exigeant le silence, très bruyamment."]],
  kakashi:[[['鳥|とり','が','こわい','です','。'],'J\'ai peur des oiseaux.',"L'Épouvantail errant s'enfuit, poursuivi par un moineau qui n'avait rien demandé."],
   [['すみません','、','田んぼ|たんぼ','は','どこ','です','か','。'],'Excuse-moi, où est la rizière ?',"Il te remercie pour le combat et repart chercher sa rizière. Elle est juste derrière lui."]],
  karakasa:[[['今日|きょう','は','いい','天気|てんき','です','ね','。','ざんねん','。'],'Il fait beau aujourd\'hui. Dommage.',"La Petite ombrelle s'éloigne en boudant le soleil."],
   [['かさ','じゃ','ありません','。','ぼうし','です','。'],'Je ne suis pas un parapluie. Je suis un chapeau.',"Elle se replie dignement. Personne n'a jamais porté ce chapeau."]],
  smoke:[[['まど','は','どこ','です','か','。'],'Où est la fenêtre ?',"La Suie vivante sort par une fenêtre qui n'existe pas."],
   [['わたし','は','雲|くも','です','。'],'Je suis un nuage.',"Elle se disperse. Les vrais nuages refusent toujours de lui parler."]],
  toad:[[['ケロ','。','これ','は','日本語|にほんご','です','。'],'Kero. C\'est du japonais.',"Le Crapaudeau s'en va en répétant « kero », persuadé d'avoir eu le dernier mot."],
   [['水|みず','が','きたない','です','。','わたし','の','せい','じゃ','ありません','。'],'L\'eau est sale. Ce n\'est pas ma faute.',"Il replonge dans l'eau sale. C'était un peu sa faute."]],
  braise:[[['水|みず','は','きらい','です','。'],'Je déteste l\'eau.',"La Braise errante s'éteint. Elle laisse une odeur de pain grillé raté."],
   [['さむい','です','か','。','わたし','は','あつい','です','。'],'Tu as froid ? Moi, j\'ai chaud.',"Elle fait « pfff » et devient un caillou tiède. Tu peux t'y réchauffer les mains."]],
  yukidama:[[['お湯|おゆ','が','ありません','。'],'Je n\'ai plus d\'eau chaude.',"La Bouilloire des neiges fond un peu, par dépit. Elle regèlera cette nuit et recommencera à bouder."],
   [['寒い|さむい','。','とても','寒い|さむい','。'],'J\'ai froid. Très froid.',"Elle s'en va en sifflant. C'est une bouilloire, elle ne sait faire que ça."],
   [['帽子|ぼうし','を','見ないで|みないで','ください','。'],'Ne regarde pas mon chapeau.',"Elle rajuste sa bouilloire sur sa tête et s'éloigne avec toute la dignité d'une boule de neige."]],
  karasu:[[['カア','。','先生|せんせい','と','呼んで|よんで','ください','。'],'Croa. Appelle-moi « maître ».',"Le Corbeau à ressort s'envole de travers. Il lui manque un tour de clé."],
   [['それ','は','私|わたし','の','です','。'],'Ça, c\'est à moi.',"Il repart avec un bouton de ta veste. Tu ne t'en apercevras que ce soir."],
   [['飛べます|とべます','。','たぶん','。'],'Je sais voler. Probablement.',"Il s'élance, bat des ailes, et retombe dans la neige. Il fait comme si c'était voulu."]],
  yoma:[[['その','言葉|ことば','、','いくら','です','か','。'],'Ce mot, il coûte combien ?',"Le Yōma s'évapore. Il te devait une syllabe, tu ne la reverras jamais."],
   [['静か|しずか','な','町|まち','が','好き|すき','です','。'],'J\'aime les villes silencieuses.',"Il se dissout en silence. C'est bien la seule chose qu'il sache faire proprement."]]};
 const EV={ashig:[[['任務|にんむ','…','終わり|おわり','。'],'Mission… terminée.',"Le couvercle tombe. À l'intérieur, rien qu'un peu d'encre bleue qui s'évapore."],
   [['家|いえ','に','帰りたい|かえりたい','。'],'Je veux rentrer chez moi.',"Le vieux soldat rouillé pose sa lance contre le mur et se dissout en flammes bleues."]],
  mushi:[[['返します|かえします','。'],'Je les rends.',"Le dôme s'ouvre. Des dizaines de pages s'envolent, chacune porte un nom, et elles partent vers leurs propriétaires."],
   [['もう','切りません|きりません','。'],'Je ne coupe plus.',"Les ciseaux brisés tombent sur le sol. Le scarabée s'éteint doucement."]],
  kamai:[[["空|そら", "が", "遠い|とおい", "です", "。"], "Le ciel est loin.", "Ses plumes de métal tombent une à une dans l'herbe en tintant. La flamme bleue s'éteint."], [["北|きた", "へ", "行かないで|いかないで", "。"], "Ne va pas au nord.", "Il tourne la tête vers la citadelle, pousse un dernier cri, et se disperse en cendres bleues."]],
  okuri:[[['もう','送りません|おくりません','。'],'Je ne raccompagne plus personne.',"La lanterne froide s'éteint. Le grand chien se couche au bord des rails et devient brume."],
   [['お帰りなさい|おかえりなさい','。'],'Bon retour.',"Il dit enfin ce qu'il attendait de dire depuis cent ans, et s'efface tranquillement."]],
  mikoshi:[[['もう','上|うえ','は','ありません','。'],'Il n\'y a plus de haut.',"Le cou de laiton se replie une dernière fois dans un long soupir de vapeur bleue."],
   [['空|そら','に','届きません|とどきません','。'],'Je n\'atteins pas le ciel.',"Il tend le cou vers les nuages, très loin, puis s'efface."]],
  okubi:[[['時間|じかん','が','止まりました|とまりました','。'],'Le temps s\'est arrêté.',"Les aiguilles fendues de son front tournent une dernière fois, puis la tête se dissout en flammes bleues."],
   [['遅い|おそい','です','。','もう','遅い|おそい','です','。'],'C\'est tard. Il est déjà trop tard.',"Elle ferme les yeux et laisse le vent l'emporter."]],
  tenome:[[['もう','何|なに','も','見えません|みえません','。'],'Je ne vois plus rien du tout.',"Le Tenome aux paumes vides referme ses mains. Les loupes de laiton tombent dans la mousse et continuent de cligner."],
   [['あなた','の','顔|かお','を','見せて|みせて','ください','。'],'Montre-moi ton visage.',"Il tend les mains vers toi, très doucement, puis s'efface. Il voulait juste voir quelqu'un, une dernière fois."]],
  ashi:[[["もう", "歩けません|あるけません", "。"], "Je ne peux plus marcher.", "Les segments se détachent un à un dans un nuage de vapeur. Il ne reste qu'un tas de ferraille noire, encore tiède."], [["どこ", "に", "も", "行けません|いけません", "。"], "Je ne peux aller nulle part.", "Ses antennes frémissent une dernière fois, puis retombent sur le rail."]],
  raiju:[[['雷|かみなり','が','好き|すき','です','。'],'J\'aime la foudre.',"La bête d'orage remonte vers le ciel en zigzag. Quelque part au-dessus, un nuage gronde de soulagement."],
   [['空|そら','に','帰ります|かえります','。'],'Je rentre au ciel.',"Elle s'éteint comme une ampoule. Il reste une odeur d'orage et trois boutons de ta veste, fondus."]],
  tsurube:[[['ずっと','ここ','に','います','。'],'Je suis ici depuis toujours.',"La grosse tête remonte dans la mâture et se tait. Les cordes grincent comme une berceuse."],
   [['落ちます|おちます','よ','。'],'Je vais tomber, attention.',"Elle tombe. Puis elle remonte. Puis elle retombe. Elle fait ça depuis cent ans : c'est son métier."]],
  ippon:[[['まだ','できて','いません','。'],'Elle n\'est pas encore finie.',"Le Forgeron repose sa lame froide. Il la reprendra demain. Il la reprend tous les soirs depuis deux cents ans."],
   [['この','刀|かたな','は','売りません|うりません','。'],'Ce sabre n\'est pas à vendre.',"Il s'efface en serrant la lame contre lui. Elle n'a jamais coupé que lui."]],
  kasha:[[['仕事|しごと','は','終わりました|おわりました','。'],'Le travail est fini.',"Le Wagonnet du dernier quart s'arrête enfin. Les casques dedans se lèvent, saluent, et rentrent chez eux."],
   [['休み|やすみ','を','ください','。'],'Donnez-moi un congé.',"Il repart sur ses roues de feu bleu. La sirène de fin de service sonne pour lui seul."]],
  suzuri:[[['墨|すみ','は','まだ','あります','。'],'Il reste encore de l\'encre.',"L'Encrier sans fond se referme. Au fond, quelque chose écrit encore. On préfère ne pas savoir quoi."],
   [['名前|なまえ','を','書いて|かいて','ください','。'],'Écris ton nom, s\'il te plaît.',"Il te tend un pinceau. Tu refuses poliment. Il a l'air déçu : il lui manquait un nom pour finir la page."]],
  kamikiri:[[['ここ','は','間違い|まちがい','です','。'],'Ici, c\'est une faute.',"Le Grand Correcteur te rend ta copie. Elle est en dentelle. Il a mis « à revoir »."],
   [['赤|あか','で','直します|なおします','。'],'Je corrige en rouge.',"Il s'éloigne en raturant l'horizon. Ça penchait, d'après lui."]],
  nekomata:[[['まだ','仕事|しごと','が','あります','。'],'J\'ai encore du travail.',"Le Bakeneko s'évapore par une cheminée. Elle n'était pas ramonée. Il le fera remarquer."],
   [['九つ|ここのつ','の','命|いのち','、','あと','一つ|ひとつ','。'],'Neuf vies… plus qu\'une.',"Il compte sur ses griffes, se trompe, recompte, et s'en va vérifier ailleurs."]],
  akaname:[[['この','お風呂|おふろ','は','私|わたし','の','です','。'],'Ce bain est à moi.',"Le Grand lécheur retourne à son bain condamné. Il y a mis un panneau « complet ». Il y est seul."],
   [['きれい','に','なりました','か','。'],'C\'est devenu propre ?',"Il passe un doigt sur ton armure, regarde le résultat, et soupire comme une belle-mère."]],
  noppera:[[['はんこ','を','ください','。'],'Votre tampon, je vous prie.',"Le Chef de bureau te remet un reçu pour ta victoire. En quatre exemplaires. Tous blancs."],
   [['会議|かいぎ','の','時間|じかん','です','。'],'C\'est l\'heure de la réunion.',"Il s'éloigne en flottant vers une réunion qui dure depuis cent ans. Il est en retard."]],
  rokuro:[[['電報|でんぽう','です','。'],'Un télégramme pour vous.',"La Jorōgumo des câbles replie ses huit pattes et retourne à sa toile. Ton télégramme disait : « Stop. »"],
   [['線|せん','に','さわらないで','ください','。'],'Ne touchez pas aux fils.',"Elle remonte le long d'un poteau. Toute la rue reçoit un message en même temps. C'est une facture."]],
  namazu:[[['少し|すこし','、','ゆれます','よ','。'],'Ça va trembler un peu.',"Le Grand namazu se rendort. La berge s'est déplacée de deux mètres. Les cartographes le détestent."],
   [['私|わたし','は','川|かわ','の','神様|かみさま','です','。'],'Je suis le dieu du fleuve.',"Il replonge dans une gerbe de vapeur. Les vrais dieux du fleuve portent plainte régulièrement."]],
  hikyaku:[[['速達|そくたつ','です','！'],'Courrier express !',"Le Coursier express s'arrête net. C'est la première fois. Il trouve ça reposant, puis repart deux fois plus vite pour rattraper."],
   [['遅い|おそい','です','よ','。'],'Tu es lent, tu sais.',"Il te double, te redouble, puis explose de vapeur. Il recollera les morceaux en route."]],
  hone:[[['前|まえ','へ','！','…','だれ','も','いません','。'],'En avant ! … Il n\'y a personne.',"Le Capitaine d'os replie son éventail. Son armée est partie il y a cent ans. Personne n'a osé le lui dire."],
   [['私|わたし','は','えらい','です','。'],'Je suis quelqu\'un d\'important.',"Il s'effondre en tas, très dignement. Le casque roule un peu plus loin. Il fera un rapport."]],
  oni:[[['これ','は','雪|ゆき','じゃ','ありません','。','ひげ','です','。'],'Ce n\'est pas de la neige. C\'est ma barbe.',"Le Grand oni du givre s'en va en lissant ses glaçons. Il en casse un. Il fait comme si de rien n'était."],
   [['小さい|ちいさい','の','は','弟|おとうと','です','。'],'Le petit, c\'est mon frère.',"Il repart chercher son petit frère. Tu préfères ne pas être là quand il apprendra ce que tu lui as fait."]],
  kakashi:[[['また','あなた','です','か','。'],'Encore toi ?',"L'Épouvantail rancunier note ton nom. Il n'a pas de mains. Il le retiendra mal."],
   [['わすれません','よ','。'],'Je n\'oublie pas, tu sais.',"Il jure de se venger, puis oublie de quoi. La paille, ça ne retient rien."]],
  karakasa:[[['わたし','は','高い|たかい','かさ','です','。'],'Je suis un parapluie de luxe.',"L'Ombrelle de gala se referme, outrée. Elle reviendra : elle n'a que ça à faire."],
   [['さわらないで','ください','。'],'Ne me touche pas, je te prie.',"Elle s'en va en tournant sur elle-même. Personne ne regardait. Elle a salué quand même."]],
  smoke:[[['何|なに','も','見えません|みえません','ね','。'],'On n\'y voit rien, hein ?',"La Suie de cheminée retombe en poussière. Elle se reformera dès que tu auras le dos tourné, par pure mesquinerie."],
   [['そうじ','は','きらい','です','。'],'Je déteste le ménage.',"Elle se disperse sur tes vêtements. C'est petit. C'est très petit."]],
  toad:[[['もう一度|もういちど','言って|いって','ください','。'],'Répète encore une fois, s\'il te plaît.',"Le Crapaud notaire consigne sa défaite en trois exemplaires et s'en va faire appel."],
   [['ここ','に','名前|なまえ','を','書いて|かいて','ください','。'],'Écris ton nom ici, s\'il te plaît.',"Il range sa plume, vexé que tu n'aies rien signé."]],
  braise:[[['わたし','は','大きい|おおきい','火|ひ','です','！'],'Je suis un grand feu !',"La Braise majuscule redevient minuscule. Elle prétendra le contraire demain."],
   [['見て|みて','！','見て|みて','！'],'Regarde ! Regarde !',"Elle s'éteint en vérifiant que tu regardais. Tu regardais. Elle est contente."]]};
 const ZP=window.FOEZP={1:['itachi','doro'],2:['chochin','takenoko'],3:['karakuri','tesso'],4:['kamado','nobusuma'],5:['hone','hitokage'],6:['oni','yuzaru'],7:['nurikabe','kitsune','tengu','koma','hikyaku'],8:['kappa','tsuru','namazu','funa'],9:['nekomata','rokuro','akaname','noppera'],10:['ittan','suzuri','kamikiri','soroban'],11:['ippon','kanedama','kasha','abura'],12:['raiju','tsurube','mokumoku','hitotsume'],13:['tenome','ashi','tsuchi','ashinaga'],14:['mikoshi','okubi','zori','uneri'],15:['kamai','okuri','beto','sune'],16:['ashig','mushi','gasha','jinda']};const oDef=STORY.wildDef;STORY.wildDef=(z,kind)=>{if(!kind&&ZP[clamp(z,1,16)]&&Math.random()<(z>=7?1:.55))kind=pick(ZP[clamp(z,1,16)]);const d=oDef(z,kind),k=Object.keys(RKIND).find(n=>RKIND[n]===d.kind)||'yoma',b=k.replace(/2$/,''),K=d.kind;
  d.kk=b;
  d.trait=TRK[b];d.atk=ATK[b]||d.atk;
  if(K.el&&EV[b]){const c=pick(EV[b]),L=level(S.xp);d.el=1;d.cry=c[0];d.cryFr=c[1];d.bye=c[2];d.lv=Math.max(d.lv+3,L+2);d.hp=Math.round(d.hp*1.8)+L*2;d.dmg+=4;d.xp=d.xp*2+6;d.gold=30+clamp(z,1,5)*8;d.clue='Un revenant. Tes kanji « à réviser » lui font double dégâts.'}
  else{const v=KV[b];if(v&&Math.random()<v.length/(v.length+1)){const c=pick(v);d.cry=c[0];d.cryFr=c[1];d.bye=c[2]}}
  return d};
 {const oB=Battle.start;Battle.start=async(def,o)=>{if(def&&def.kk)S.fl['s_'+def.kk]=1;const r=await oB(def,o);if(r==='win'&&def&&def.kk){S.fl['w_'+def.kk]=(S.fl['w_'+def.kk]||0)+1;save()}return r}}
 window.FOEINFO={TRK,ATK,KV,EV,Z:{jinda:16,ashig:16,mushi:16,gasha:16,kamai:15,okuri:15,beto:15,sune:15,yoma:0,tayoma:1,kakashi:1,itachi:1,doro:1,kodama:2,karakasa:2,chochin:2,takenoko:2,smoke:3,karakuri:3,tesso:3,toad:4,kamado:4,nobusuma:4,braise:5,hone:5,hitokage:5,yukidama:6,karasu:6,oni:6,yuzaru:6,nurikabe:7,hikyaku:7,kitsune:7,tengu:7,koma:7,kappa:8,tsuru:8,namazu:8,funa:8,nekomata:9,rokuro:9,akaname:9,noppera:9,ittan:10,suzuri:10,kamikiri:10,soroban:10,ippon:11,kanedama:11,kasha:11,abura:11,raiju:12,tsurube:12,mokumoku:12,hitotsume:12,tenome:13,ashi:13,tsuchi:13,ashinaga:13,mikoshi:14,okubi:14,zori:14,uneri:14}};
 /* --- trésors cachés --- */
 const oItem=STORY.item;STORY.item=async e=>{if(!e.hid)return oItem(e);S.fl[e.id]=1;W.remove(e);sfx('item');const n=HIDS.filter(h=>S.fl[h.id]).length,g=25+e.z*10,tea=n%3===0;S.gold=(S.gold||0)+g;if(tea)S.it.cha=(S.it.cha||0)+1;
  await D.say([{jp:['宝|たから','を','見つけた|みつけた','！'],fr:`Un trésor caché ! Tu trouves ${g} 文${tea?' et un お茶 (thé vert)':''}.`,x:`Trésors cachés : ${n} / ${HIDS.length}`}]);
  if(n===HIDS.length&&!S.fl.hid_all){S.fl.hid_all=1;S.gold+=150;sfx('lvl');await D.say('Tu as trouvé tous les trésors cachés ! Quelqu\'un avait glissé 150 円 de plus dans le dernier, avec un mot : « Tu n\'as vraiment que ça à faire ? »')}save()};
 /* --- Frère Daruma : une épreuve par hameau --- */
 const J=(n,jp,fr,x)=>({n,jp,fr,x});const DN='Frère Daruma';PORT[DN]='PX_daruma';
 const HI={18:"La ville de l'Empereur. Ici, tout est en or, même les lois. J'ai demandé l'aumône : on m'a répondu que le mardi, il faut marcher. Alors je marche. Lentement.",17:"J'ai dérivé jusqu'ici sur une planche. Trois jours en mer, sans bol, sans natte, sans rien. La méditation parfaite. Puis un crabe m'a pincé, et j'ai dû tout recommencer depuis le début.",21:"Le dieu a bougé un sourcil quand vous êtes tombés dans la cloche. Moi, je médite depuis quarante ans, et il ne m'a jamais regardé. Je ne suis pas jaloux. Un peu.",20:"Je médite au fond de la mine. Il fait noir, il fait chaud, et un chat en feu passe toutes les dix minutes. C'est très formateur.",19:"Je suis monté à pied. Quatre mille marches. Les corbeaux m'ont volé mon bol. Le bol était vide. Ils sont repartis déçus. Moi aussi.",16:"Je suis entré par la porte des cuisines. Personne ne m'a demandé mon nom. Ici, personne n'en a plus. C'est reposant, pour un moine : je n'en avais déjà presque plus.",15:"Le vent souffle de partout. Il a emporté mon chapelet, ma natte et la moitié de ma méditation. Il me reste l'autre moitié : c'est déjà beaucoup.",14:"Toutes les horloges d'ici marquent une heure différente. Pour un moine qui médite, c'est le paradis : il n'est jamais l'heure de se lever.",13:"Je suis tombé du dirigeable avec toi. Si, si. J'étais dans la soute. Je méditais dans un sac de riz. J'ai atterri en lotus.",12:"Je suis monté par l'escalier de service. Neuf mille marches. Je médite depuis la quatre-millième, sans m'arrêter de monter.",11:"Il fait chaud. J'ai médité sur un lingot. Il était encore tiède. Maintenant je médite debout.",10:"Une académie. J'y ai étudié, autrefois. Enfin, j'y ai dormi. On m'a donné un diplôme pour que je parte.",9:"Une ville où il fait toujours nuit. Parfait : personne ne voit que je dors. Enfin, que je médite.",8:"J'ai traversé le fleuve à pied. Sur le fond. C'est long, mais on ne fait pas la queue.",7:"Un relais, c'est fait pour ceux qui voyagent. Moi, je ne voyage pas : j'arrive. Nuance.",6:"Tu montes vite. Moi, j'étais déjà là : j'ai pris le raccourci. Il n'y a pas de raccourci.",2:"Tu as mis le temps. Je suis parti après toi et je suis arrivé avant. Le secret ? Je ne lis pas les panneaux.",
  3:"Encore toi. Enfin, encore moi. C'est une question de point de vue.",
  4:"Ne me demande pas comment je passe les portes de l'usine. Les gardiens ne frappent pas un homme qui dort debout.",
  5:"Ici, tout a brûlé sauf moi. Je suis ignifugé par la sagesse. Et par une couverture mouillée."};
 const LOSE=["Mon bol à aumônes a fait mieux, et il est en bois.","C'est encourageant. Pour tes adversaires.","J'ai connu un épouvantail plus vif. Il était planté dans un champ.","Respire. Recommence. Et cette fois, lis la question."];
 MONKS.forEach(m=>NPCS.world.push({id:'monk'+m.z,spr:'daruma',x:m.x,y:m.y,ev:'monk',dir:0,z:m.z}));
 STORY.monk=async e=>{const z=e.z,n=DN;
  if(!S.fl['mk'+z]){S.fl['mk'+z]=1;await D.say([J(n,['修行|しゅぎょう','を','しましょう','。'],'Entraînons-nous.','修行 (しゅぎょう) = entraînement, ascèse · 〜ましょう = « faisons… »'),{n,t:HI[z]},{n,t:'Je propose une épreuve dans chaque hameau : six questions, vite. Cinq bonnes réponses et je te paie. Oui, un moine qui paie. Profite.'}])}
  const c=await D.ask({n,t:'Alors ?'},[{jp:['修行|しゅぎょう'],fr:'Relever l\'épreuve'},{jp:['宝|たから'],fr:'Les trésors cachés'},'Rien, merci']);
  if(c===1){const here=HIDS.filter(h=>h.z===z),left=here.filter(h=>!S.fl[h.id]).length;
   await D.say({n,t:left?`Il reste ${left} trésor${left>1?'s':''} caché${left>1?'s':''} dans cette région. Cherche un petit scintillement bleu dans les coins où personne ne va. Je les aurais bien pris moi-même, mais j'ai fait vœu de paresse.`:'Tu as tout trouvé par ici. Il ne reste que la poussière, et je la garde.'});return}
  if(c!==0)return;
  const old=S.xp;let good=0;const N=6;
  for(let i=0;i<N;i++){let q=null,oral=false;if(i%3===2){q=Oral.q('mix');oral=!!q}if(!q&&i%3===1)q=pickEx(x=>x.q!=='ord');if(!q)q=Ex.kanjiQ();
   const r=await Ex.run(q,{quit:1,timed:oral?15000:10000,head:`<b>修行 ${i+1}/${N}</b> · `});if(r==='quit'){UI.panel('pad');return D.say({n,t:'On s\'arrête là ? Le temple ne bouge pas. Reviens quand tu veux.'})}if(oral){const s=Oral.st();s.l++;if(r)s.lo++}if(r)good++}
  UI.panel('pad');S.xp+=good;S.hcd=S.hcd||{};const first=!S.fl['hc'+z],today=S.hcd[z]===dayN();
  if(good>=5){if(first){const g=40+10*z;S.fl['hc'+z]=1;S.hcd[z]=dayN();S.gold=(S.gold||0)+g;S.it.cha=(S.it.cha||0)+1;sfx('item');await D.say([{n,t:`${good} sur ${N}. Pas mal du tout.`},`Frère Daruma te remet ${g} 円 et un お茶 (thé vert), en soupirant comme si c'était son dernier.`,{n,t:'Reviens demain. Je paie moins, mais je paie.'}])}
   else if(!today){S.hcd[z]=dayN();S.gold=(S.gold||0)+15;sfx('item');await D.say([{n,t:`${good} sur ${N}. Tu progresses, c'est agaçant.`},'Tu reçois 15 円.'])}
   else await D.say({n,t:`${good} sur ${N}. Très bien, mais je n'ai plus un sou aujourd'hui. Reviens demain, j'aurai mendié.`})}
  else await D.say({n,t:`${good} sur ${N}. ${pick(LOSE)} Il en faut cinq.`});
  save();await afterXp(old)};
})();

/* ---------- menu ---------- */
const Menu=(()=>{
 const ALLT={m:[['ca','図','Carte'],['pe','侍','Perso'],['iv','袋','Sac'],['gu','道','Guide'],['op','設定','Options']],r:[['dq','日','Séance'],['sp','字','Kanji'],['le','文法','Leçons'],['or','耳','Oral'],['ph','言葉','Carnet'],['rd','読','Lecture'],['er','誤','Erreurs'],['bi','進','Bilan']],c:[['be','妖','Yōkai'],['al','友','Alliés'],['fi','魚','Pêche'],['ge','遊','Jeux']]},LAST={m:'ca',r:'dq',c:'be'};let grp='m',TABS=ALLT.m,tab='ca';
 function render(){{let gb=document.getElementById('mGrp');const mt=$('#mTabs');if(!gb){gb=document.createElement('div');gb.id='mGrp';mt.parentNode.insertBefore(gb,mt);gb.onclick=e=>{const b=e.target.closest('button');if(!b)return;grp=b.dataset.g;TABS=ALLT[grp];tab=LAST[grp];Extra.reset();sfx('tap');render();$('#mBody').scrollTop=0}}gb.innerHTML=[['m','冒','Aventure'],['r','学','Apprendre'],['c','集','Collection']].map(g=>`<button data-g="${g[0]}" class="${g[0]===grp?'on':''}">${g[1]} ${g[2]}</button>`).join('')}$('#mTabs').innerHTML=TABS.map(t=>`<button data-t="${t[0]}" class="${t[0]===tab?'on':''}">${t[1]}<br><small>${t[2]}</small></button>`).join('');const b=$('#mBody');let h='';
  if(tab==='dq'){const q=Quest.roll(),st=Quest.streak();
   const nE_=Object.keys(S.er||{}).length,rc=Review.count()+nE_;h=`<div class="mi"><div class="k" style="color:var(--cy)">復</div><div class="t"><b>Séance du jour</b>${rc?`${Review.dueK().length} kanji, ${Review.dueP().length} phrases, ${Vocab.due().length} mots et ${Math.min(4,nE_)} erreur${nE_>1?'s':''} à revoir, en une seule séance de 5 minutes.`:'Rien à réviser pour l\'instant. Reviens demain !'}</div>${rc?'<button class="go" data-act="rev">Réviser</button>':''}</div>`+`<div class="sw" style="border:0;padding:2px 0 6px"><span>Défis du jour · ${Quest.count}/3</span><span style="color:var(--gold)">Série : ${st} jour${st>1?'s':''}</span></div>`+q.q.map(x=>{const d=Quest.DEF[x.k],ok=x.n>=d[1];return `<div class="mi ${ok?'':''}"><div class="k" style="font-size:22px;color:${ok?'var(--green)':'var(--sub)'}">${ok?'✓':'・'}</div><div class="t"><b>${esc(d[0])}</b><div class="bar" style="margin-top:6px"><i style="width:${x.n/d[1]*100}%;background:var(--cy)"></i></div><small>${x.n} / ${d[1]}</small></div></div>`}).join('')+
   `<p style="font-size:12px;color:var(--sub);margin:4px 0 10px">${q.done?'Tout est fait pour aujourd\'hui. Reviens demain pour continuer ta série !':'Termine les trois pour gagner 15 XP et un onigiri, et faire grandir ta série.'}</p><div class="sw" style="border:0;padding:2px 0 6px"><span>Parcours des kanji</span></div>`+
   THEMES.map((T,i)=>{const op=Path.open(i),l=Path.lvl(T.id);return `<div class="mi ${op?'':'lock'}"><div class="k" style="color:var(--cy)">${op?T.ic:'🔒'}</div><div class="t"><b>${esc(T.name)}</b>${T.k.map(q=>l?q.k:'・').join(' ')} <span style="color:#c89018">${Path.stars(T.id)}</span><br><small>${l>=3?'Maîtrisé. Révision possible chez ':'Auprès de '}${esc(PLACES[T.place]||'un bourg à venir, plus loin dans le voyage')}</small></div></div>`}).join('')}
  else if(tab==='gu')h=Guide.html();
  else if(tab==='bi')h=Bilan.html();else if(tab==='fi')h=window.FISHHTML?FISHHTML():'';else if(tab==='al')h=window.ALLYHTML?ALLYHTML():'';
  else if(tab==='pe')h=window.CharPage?CharPage():'';
  else if(tab==='sp')h=`<p style="font-size:12px;color:var(--sub);margin:0 0 6px">En combat, quatre de ces kanji te sont proposés à chaque tour. Plus tu en connais, plus ta main est variée.</p>`+SP.map((s,i)=>{const ok=unl(s),el=elem(s.k);if(!ok)return '';return `<div class="mi ${ok?'':'lock'}"><div class="k" style="color:${el[1]}">${s.k}</div><div class="t"><b>${ok?esc(s.name):'？？？'}</b>${ok?`${s.kun} · ${s.on} — ${esc(s.fr)}<br><span class="ty" style="background:#3a4a78">${AIDN[aidOf(s.k)]}</span>${Review.kDue(s.k)?'<span class="ty" style="background:#c8901c">à réviser</span>':''}<span style="color:#c89018">${starsTxt(S.best[s.k]||0)}</span>`:''}</div>${ok?`<button class="go" data-tr="${i}">Tracer</button>`:''}</div>`}).join('');
  else if(tab==='le')h=LESSONS.map(l=>{const ok=S.les[l.id];return `<div class="mi ${ok?'':'lock'}"><div class="k" style="font-size:22px">${ok?'✓':'・'}</div><div class="t"><b>${esc(l.title)}</b>${esc(l.sub)}<br><small>${ok?'Leçon apprise':'Sensei : '+NPN[l.who]}</small></div>${ok?`<button class="go" data-le="${l.id}">Revoir</button>`:''}</div>`}).join('');
  else if(tab==='or'){const e=Oral.st(),pc=(a,b)=>b?Math.round(a/b*100)+' % de réussite sur '+b:'pas encore essayé';
   h=`<div class="mi"><div class="k">耳</div><div class="t"><b>Écoute</b>Tu entends une phrase de ton carnet sans la voir : trouve son sens ou reconstruis-la.<br><small>${pc(e.lo,e.l)}</small></div><button class="go" data-or="mix">5 questions</button></div>
<div class="mi"><div class="k">ー</div><div class="t"><b>Paires pièges</b>おばさん ou おばあさん ? Les sons longs et doublés qui changent le mot.</div><button class="go" data-or="pair">5 questions</button></div>
<div class="mi"><div class="k">口</div><div class="t"><b>Prononciation</b>${Oral.mic?'Lis la phrase au micro : le jeu te dit ce qu\'il a compris.':'Écoute, répète à voix haute, puis évalue-toi.'}<br><small>${pc(e.po,e.p)}</small></div><button class="go" data-or="speak">5 phrases</button></div>
<p style="font-size:12px;color:var(--sub)">Chaque bonne réponse rapporte 1 XP. En combat, la commande 聞く te fait écouter le murmure du Yōma. Si tu n'entends rien, vérifie que le son est activé et qu'une voix japonaise est installée sur ton téléphone.</p>`}
  else if(tab==='ph'){const ks=Object.keys(S.ph).filter(k=>PHR[k]);h=`<div class="sw" style="border:0;padding:2px 0 6px"><span>${ks.length} phrase${ks.length>1?'s':''} dans ton carnet</span></div>`+(ks.length?ks.map((k,i)=>{const p=PHR[k];return `<div class="mi"><div class="t"><div class="jp">${jpHtml(p.t)}</div>${S.roma?`<i style="color:var(--sub)">${esc(romaji(p.t))}</i><br>`:''}${esc(p.fr)}</div><button class="spk" data-say="${esc(k)}" aria-label="Écouter">🔊</button></div>`}).join(''):'<p>Parle aux habitants et suis les leçons : chaque phrase rencontrée s\'ajoute ici.</p>')}
  else if(tab==='be')h=Object.values(EN).filter(e=>e.img).map(e=>{const seen=S.wins[e.id]||S.fl['s_'+e.id];return `<div class="mi ${seen?'':'lock'}">${seen?`<img src="${IM['BT_'+(e.bt||e.id)]}" alt="" style="object-fit:contain;image-rendering:pixelated">`:'<div class="k">？</div>'}<div class="t"><b>${seen?esc(e.n):'？？？'}</b>${seen?`${jpHtml(e.t)}<br>${esc(e.clue)}${S.wins[e.id]?'<br><small>Vaincu ✓</small>':''}`:'Pas encore rencontré'}</div></div>`}).join('')+(window.FOEINFO?(()=>{const F=FOEINFO,ZN=['Partout','Rizières','Bambous','Ouvriers','Fumées','Cendres','Col des Brumes','Grand-route','Grand Fleuve','Ville basse','Académie','Grandes Forges'],ks=Object.keys(F.Z).sort((a,b)=>F.Z[a]-F.Z[b]),n=ks.filter(k=>S.fl['s_'+k]).length;
   return `<div class="mi" style="background:none;border:0;padding:6px 2px 0"><div class="t"><b>Yōma des routes · ${n} / ${ks.length}</b></div></div>`+ks.map(k=>{const K=RKIND[k],seen=S.fl['s_'+k],w=S.fl['w_'+k]||0,tr=F.TRK[k]&&TRAITS[F.TRK[k]];return `<div class="mi ${seen?'':'lock'}">${seen?`<img src="${IM['BT_'+(K.bt||K.s)]}" alt="" style="object-fit:contain;image-rendering:pixelated">`:'<div class="k">？</div>'}<div class="t"><b>${seen?esc(K.n()):'？？？'}</b>${seen?`${ZN[F.Z[k]]}${F.ATK[k]?' · '+esc(F.ATK[k]):''}${tr?`<br><small>${esc(tr[0])} : ${esc(tr[1])}</small>`:''}${w?`<br><small>Vaincu × ${w}</small>`:''}`:ZN[F.Z[k]]+' · pas encore rencontré'}</div></div>`}).join('')})():'')+`<div class="mi"><div class="k">👻</div><div class="t"><b>Yōma</b>${S.wild||0} mot${(S.wild||0)>1?'s':''} libéré${(S.wild||0)>1?'s':''}</div></div>`;
  else{const sw=(k,l)=>`<div class="sw"><span>${l}</span><button data-sw="${k}" class="${S[k]?'on':''}">${S[k]?'Oui':'Non'}</button></div>`;
   h=sw('snd','Effets sonores et voix')+`<div class="sw"><span>Voix japonaise</span><button data-act="tts" class="on">Tester</button></div><p id="ttsMsg" style="font-size:12px;color:var(--sub);margin:-2px 0 6px">Touche « Tester » : tu dois entendre こんにちは.</p>`+sw('mus','Musique')+sw('roma','Afficher le rōmaji')+`<div class="sw"><span>Sauvegarde</span><button data-act="save" class="on">Sauver</button></div><div class="sw"><span>Transférer ma partie</span><span><button data-act="exp" class="on">Exporter</button> <button data-act="imp" class="on">Importer</button></span></div><div id="sxBox"></div><div class="sw"><span>Recommencer à zéro</span><button data-act="reset" style="background:#d84a4a">Effacer</button></div><p style="font-size:12px;color:var(--sub)">Tracés des kanji des thèmes : KanjiVG © Ulrich Apel, licence CC BY-SA 3.0 (kanjivg.tagaini.net).</p><p style="font-size:12px;color:var(--sub)">Commandes : croix directionnelle pour marcher · A pour parler · B maintenu pour courir. Au clavier : flèches, Entrée, Maj.</p>`}
  if(tab==='op'&&typeof TestMode!=='undefined')h+=TestMode.html();
  if(tab==='dq')h=Extra.cal()+h;else if(tab==='ca')h=Extra.map();else if(tab==='ge')h=Extra.games();else if(tab==='sp')h=Extra.kanji(h);if(tab==='iv')h=More.bagHtml();else if(tab==='er')h=More.errHtml();else if(tab==='rd')h=More.readHtml();else if(tab==='op')h=More.optHtml()+h;const xp=Extra.page(tab);if(xp)h=xp;
  b.innerHTML=h;Extra.after(tab)}
 function open(k){if(G.busy)return;grp=k==='r'||k==='bi'?'r':k==='c'?'c':'m';TABS=ALLT[grp];tab=k==='bi'?'bi':LAST[grp];Extra.reset();G.busy=true;sfx('sel');$('#toast').classList.add('hidden');UI.panel('menu');render()}
 function close(){sfx('back');G.busy=false;UI.panel('pad');save()}
 $('#mTabs').onclick=e=>{const b=e.target.closest('button');if(!b)return;tab=b.dataset.t;LAST[grp]=tab;Extra.reset();sfx('tap');render();$('#mBody').scrollTop=0};
 $('#mClose').onclick=close;let rs=0;
 $('#mBody').onclick=async e=>{const b=e.target.closest('button');if(!b)return;
  if(Extra.click(b,render))return;if(More.click(b,render))return;
  if(b.dataset.say){say(b.dataset.say);return}
  if(b.dataset.tm){if(TestMode.act(b.dataset.tm)===true){G.busy=false;UI.panel('pad')}else render();return}
  if(b.dataset.sw){const k=b.dataset.sw;S[k]=S[k]?0:1;vol();save();sfx('tap');render();return}
  if(b.dataset.act==='tts'){const ok=say('こんにちは',.9,true);setTimeout(()=>{const m=$('#ttsMsg');if(m)m.textContent=ttsStatus()+(ok&&TTS.voice?' Si tu n\'entends rien, vérifie le volume « média » du téléphone et le mode silencieux.':'')},700);return}
  if(b.dataset.act==='rev'){if(Review.count()>0)await Review.session();await More.errSession(4);UI.panel('menu');render();return}
  if(b.dataset.act==='exp'){save();$('#sxBox').innerHTML=`<p style="font-size:12px;color:var(--sub);margin:4px 0">Copie ce code, puis colle-le dans « Importer » sur l'autre appareil ou dans l'autre application.</p><textarea id="sxT" readonly style="width:100%;height:90px;font:11px monospace;background:#0c1226;color:#cfe;border:1px solid var(--brass);border-radius:6px;padding:6px">${SaveX.code()}</textarea><button data-act="cpy" class="btn" style="width:100%;margin:6px 0">Copier le code</button>`;return}
  if(b.dataset.act==='cpy'){const t=$('#sxT');t.select();try{await navigator.clipboard.writeText(t.value);UI.toast('Code copié')}catch(x){try{document.execCommand('copy');UI.toast('Code copié')}catch(y){UI.toast('Sélectionne le texte et copie-le à la main')}}return}
  if(b.dataset.act==='imp'){$('#sxBox').innerHTML=`<p style="font-size:12px;color:var(--sub);margin:4px 0">Colle ici le code exporté. Attention : il remplace la partie en cours sur cet appareil.</p><textarea id="sxT" style="width:100%;height:90px;font:11px monospace;background:#0c1226;color:#cfe;border:1px solid var(--brass);border-radius:6px;padding:6px" aria-label="Code de sauvegarde"></textarea><button data-act="ld" class="btn" style="width:100%;margin:6px 0">Charger cette partie</button>`;return}
  if(b.dataset.act==='ld'){if(SaveX.load($('#sxT').value)){UI.toast('Partie chargée, redémarrage…');setTimeout(()=>location.reload(),700)}else UI.toast('Ce code n\'est pas valide. Vérifie que tu l\'as copié en entier.');return}
  if(b.dataset.act==='save'){save();sfx('save');UI.toast('Partie sauvegardée');return}
  if(b.dataset.act==='reset'){if(rs<1){rs++;b.textContent='Sûr ?';return}try{localStorage.removeItem('jz3')}catch(x){}location.reload();return}
  if(b.dataset.or){if(!S.snd){UI.toast('Active d\'abord le son dans les options.');return}const old=S.xp;await Oral.session(b.dataset.or);UI.panel('menu');render();return}
  if(b.dataset.tr){const sp=SP[+b.dataset.tr],r=await Trace.run(sp);if(r){const bst=S.best[sp.k]||0;if(r.stars>bst){S.xp+=(r.stars-bst)*4;S.best[sp.k]=r.stars}say(sp.kun);UI.toast(`${sp.k} ${starsTxt(r.stars)}`);save()}UI.panel('menu');render();return}
  if(b.dataset.le){const old=S.xp;await Lesson.run(b.dataset.le,{short:1});UI.panel('menu');render();return}};
 return{open,close}})();

/* ---------- carnet de l'apprenti, conseils, guide « comment apprendre », histoires des hameaux ---------- */
const Guide=(()=>{
 const T=[
  {id:'phr',t:'Tes premières phrases',d:'Suis la leçon de Maître Tanuki, sur la place du village.',ok:()=>!!S.les.l1},
  {id:'bat',t:'Ton premier combat',d:'Repousse le Yōma qui menace Hana.',ok:()=>!!S.fl.act1},
  {id:'vo',t:'Tes dix premiers mots',d:'Chez Maître Tanuki, ou dans un dojo des mots, choisis « Vocabulaire » : dix mots par paquet.',ok:()=>Vocab.count()>=10},
  {id:'th',t:'Un thème de kanji',d:'Chez Maître Genzō, choisis « Apprendre un thème de kanji » : cinq kanji d\'un coup, donc cinq sorts de plus.',ok:()=>Object.values(S.th||{}).some(v=>v>=1)},
  {id:'km',t:'Alléger l\'aide',d:'Trace trois fois le même kanji (au dojo ou en combat) : le modèle s\'efface et tes coups portent plus.',ok:()=>Object.values(S.km||{}).some(v=>v>=3)},
  {id:'l2',t:'Une deuxième leçon',d:'Chaque sensei a une ou deux leçons de grammaire. Ton objectif, en haut de l\'écran, t\'indique la prochaine.',ok:()=>Object.keys(S.les).length>=2},
  {id:'wi',t:'Les hautes herbes',d:'Gagne un combat dans les hautes herbes : chaque Yōma vaincu te rend un mot de vocabulaire.',ok:()=>(S.wild||0)>=1},
  {id:'dq',t:'Un défi du jour',d:'Menu, onglet Défis : trois petits défis par jour, et la révision des kanji qui s\'oublient.',ok:()=>Quest.count>=1},
  {id:'ka',t:'Les kana',d:'Chez Maître Genzō, choisis « Tracer les kana » et termine une ligne.',ok:()=>Object.keys(S.kn||{}).length>0},
  {id:'dj',t:'Un dojo des mots',d:'Dans chaque hameau, le toit bleu abrite Maître Kotoba : il entraîne l\'oreille (écouter) et la voix (prononcer).',ok:()=>!!S.fl.keiko},
  {id:'ea',t:'Tendre l\'oreille',d:'Réponds à une question d\'écoute : 聞く en combat, ou « Écouter » au dojo des mots.',ok:()=>{try{return Oral.st().l>0}catch(e){return false}}}];
 const st=()=>S.tu||(S.tu={});
 function check(){if(!S.fl.act1||G.busy||G.scene!=='world'||UI.cur!=='pad')return;const s=st();let n=0,last='';T.forEach(t=>{if(!s[t.id]&&t.ok()){s[t.id]=1;S.gold=(S.gold||0)+10;n++;last=t.t}});if(!n)return;
  if(T.every(t=>s[t.id])&&!S.fl.tu_all){S.fl.tu_all=1;S.gold+=100;S.it.cha=(S.it.cha||0)+1;UI.toast('Carnet de l\'apprenti terminé ! +100 円 et un thé',3600)}else UI.toast(`Carnet : ✓ ${last} · +${n*10} 円`,2800);save()}
 const next=()=>S.fl.act1?T.find(t=>!st()[t.id]):null;
 const sec=(h,rows)=>`<div class="sw" style="border:0;padding:10px 0 6px"><span>${h}</span></div>`+rows.map(r=>`<div class="mi"><div class="k" style="font-size:20px;color:var(--cy)">${r[0]}</div><div class="t"><b>${r[1]}</b>${r[2]}</div></div>`).join('');
 function html(){const s=st(),d=T.filter(t=>s[t.id]).length;
  return `<div class="sw" style="border:0;padding:2px 0 6px"><span>Carnet de l'apprenti · ${d}/${T.length}</span><span style="color:var(--gold)">+10 円 par ligne</span></div>`+
   (S.fl.act1?T.map(t=>{const ok=s[t.id];return `<div class="mi"><div class="k" style="font-size:22px;color:${ok?'var(--green)':'var(--sub)'}">${ok?'✓':'・'}</div><div class="t"><b>${esc(t.t)}</b>${ok?'':esc(t.d)}</div></div>`}).join(''):'<p style="font-size:12px;color:var(--sub);margin:0 0 8px">Le carnet s\'ouvrira après ta première nuit au village.</p>')+
   sec('Les gardiens',[['門','Le savoir ouvre les portes','Chaque gardien de zone exige un nombre d\'étoiles de thèmes de kanji et de leçons de grammaire avant d\'accepter le combat. Le compte s\'affiche sous ton objectif, en haut de l\'écran.'],['戦','En combat','Un kanji utilisé repose trois tours avant de revenir dans ta main. 言葉 et 聞く ont aussi besoin de souffler. Un gardien blessé enrage et frappe plus fort : garde un onigiri.']])+
   sec('Apprendre plus de kanji',[['題','Les thèmes','Maître Genzō au village, puis la forgeronne Hagane dans la forge de chaque hameau, enseignent les kanji par thèmes de cinq. Entre dans la forge et choisis « Thèmes de kanji ». Chaque thème a trois niveaux : reconnaître, tracer, puis tracer de mémoire.'],
    ['術','Les combats','Chaque kanji appris devient un sort. Ta main de quatre kanji change à chaque tour, et les kanji « à réviser » frappent plus fort : te battre, c\'est réviser.'],
    ['★','Retravailler','Chez Genzō, « Retravailler un kanji » améliore tes étoiles. Plus tu traces un kanji, moins tu as d\'aide, et plus il fait mal.'],
    ['復','La révision du jour','Menu, onglet Défis. Le jeu te ressort les kanji au moment où tu commences à les oublier : d\'abord le lendemain, puis de plus en plus tard.'],
    ['かな','Les kana','Hiragana et katakana se travaillent ligne par ligne chez Genzō. C\'est la base pour lire les furigana au-dessus des kanji.']])+
   sec('Apprendre plus de phrases',[['文法','Les leçons de grammaire','Les premières viennent des sensei de la route : Tanuki, Ume, Jaku, Rin, Tetsu. Ensuite, c\'est Maître Tanuki qui les donne, dans chaque hameau : il t\'interpelle quand une leçon est prête, ou tu vas lui parler. Il fait aussi le quiz de phrases.'],
    ['語','Le vocabulaire','Maître Tanuki, dans chaque hameau, et Maître Kotoba, dans les dojos, enseignent les mots par paquets de dix. Un paquet se découvre, puis se consolide. Les mots appris reviennent dans les révisions et les parades.'],
    ['耳','Le dojo des mots','Dans chaque hameau, sous le toit bleu : Maître Kotoba fait écouter et prononcer. C\'est là qu\'on s\'entraîne l\'oreille et la voix, sans risque.'],
    ['言葉','En combat','« 言葉 » pose une question sur tes leçons, et chaque parade aussi. Les mots volés par les Yōma te reviennent quand tu les bats.'],
    ['話','Les habitants','Chaque habitant dit une vraie phrase, avec son explication. Certains ont une histoire à te confier : il faudra comprendre et répondre en japonais.'],
    ['修行','Frère Daruma','Dans chaque hameau, six questions rapides qui mélangent tout. Il paie une fois par jour.'],
    ['言','Le carnet de phrases','Menu, onglet Carnet : toutes les phrases rencontrées, à réécouter quand tu veux.']])}
 return{check,next,html,T}})();
{const oObj=objective;objective=function(){try{Guide.check()}catch(e){}const o=oObj(),n=Guide.next();return o+(n?`<br><span style="color:#58e0ec">Carnet</span> : ${esc(n.t)} — ${esc(n.d)}`:'')}}
(()=>{
 const J=(n,jp,fr,x)=>({n,jp,fr,x}),YN=[{jp:['はい'],fr:'Oui'},{jp:['いいえ'],fr:'Pas maintenant'}];
 /* --- le refuge du col : son gardien, sa soupe --- */
 const YN_='Gardien du refuge';PORT[YN_]='PX_yado';NPCS.refuge=[{id:'yado',spr:'yado',x:6,y:2,ev:'inn',dir:0}];
 STORY.inn=async()=>{const n=YN_;
  await D.say(J(n,['いらっしゃい','。','外|そと','は','寒い|さむい','です','ね','。'],'Bienvenue. Il fait froid dehors, hein.','ね = « hein », « n\'est-ce pas »'));
  const i=await D.ask({n,jp:['スープ','は','いかが','です','か','。'],fr:'Un peu de soupe ? (Te reposer ici ?)'},YN);
  if(i!==0){await D.say({n,t:'Comme tu veux. Elle sera encore là demain. Elle est là depuis mardi.'});return}
  await UI.fade(1,300);sfx('heal');S.hp=maxHp();ROVD.clear();{const r=S.ret||{x:9,y:OY+78};S.heal={m:'world',x:r.x,y:r.y}}save();await wait(700);await UI.fade(0,300);
  await D.say([{n,t:'C\'est du navet. En hiver, ici, tout est du navet. Même le thé a un goût de navet, je ne sais pas pourquoi.'},'Tes PV sont restaurés et ta partie est sauvegardée. Si tu tombes au combat, tu reviendras devant le refuge.']);
  if(!S.fl.inn_gift){S.fl.inn_gift=1;S.it.cha=(S.it.cha||0)+1;sfx('item');await D.say([J(n,['これ','も','どうぞ','。'],'Prends ça aussi.','どうぞ = « je t\'en prie »'),'Tu reçois un お茶 (thé vert). Il sent le navet.'])}};
 /* --- Tanuki : grammaire ou vocabulaire --- */
 /* Tanuki suit Kaito de hameau en hameau : grammaire, phrases à construire, vocabulaire */
 TANUS.forEach(t=>NPCS.world.push({id:'tanu'+t.z,spr:'tanu',x:t.x,y:t.y,ev:'tanu',wander:1,hz:t.z}));
 const THI={21:"Le dernier bourg, Kaito. Après ça, je retourne à mon dojo et je dors trois semaines. Mais d'abord, deux leçons. Le savoir, ça ne se met pas en vacances.",20:"Il fait noir, Kaito. J'ai trouvé un champignon qui brille. Je l'ai mangé. Maintenant, c'est moi qui brille. Ça a du bon : on me voit de loin.",19:"Les corbeaux m'ont volé mes onigiri. Tous. Même celui que j'avais caché dans mon chapeau. Je n'ai pas de chapeau, Kaito. Ils ont pris le chapeau aussi.",16:"Une bibliothèque entière ! J'ai voulu emprunter un livre de recettes. Le bibliothécaire m'a demandé mon nom. Je l'ai dit. Il l'a rangé. Je n'ose plus parler.",15:"Le vent m'a retourné trois fois. Ma queue montre le nord, mon nez le sud. Je suis une girouette, maintenant. Une girouette qui a faim.",14:"Des horloges partout ! J'ai voulu me transformer en coucou. Je suis sorti toutes les heures. Les vraies heures, pas les leurs. Personne n'a apprécié.",13:"Ma forêt ! Ma maison ! Ma… ma femme. Kaito, si quelqu'un te demande, je suis parti il y a trois jours. Pas trois ans. Trois jours.",12:"Un port dans les nuages ! J'ai voulu me transformer en dirigeable. J'ai gonflé, gonflé… et je n'ai pas décollé. J'ai juste été très rond pendant une heure.",11:"Une forge géante ! J'ai voulu me transformer en bouilloire, par habitude. On m'a mis sur le feu. Je déconseille.",10:"Une académie ! J'ai voulu m'inscrire. À la ligne « espèce », j'ai écrit « professeur ». Ils vérifient.",9:"Une vraie ville ! J'ai voulu prendre un pousse-pousse. Le tireur m'a regardé, il a regardé ses roues, et il a dit qu'il était complet.",8:"De l'eau partout. J'ai horreur de ça. Un tanuki mouillé, ça double de volume et ça perd toute autorité.",7:"Un relais de poste ! J'ai voulu m'envoyer moi-même par courrier. Trop lourd pour un seul timbre, paraît-il.",2:"Ah, te voilà ! J'ai pris le chemin des bambous. Ils m'ont reconnu : la famille.",3:"Ne dis à personne que je suis un tanuki. Ici, on me prend pour un contremaître poilu, et ça m'arrange.",4:"La fumée me pique les yeux. Je pleure, mais c'est de la pédagogie.",5:"Il fait chaud, par ici. J'ai perdu trois poils en arrivant. Je les compte, tu sais.",6:"Un tanuki dans la neige, ça ne se voit pas. Enfin si. Ça se voit énormément."};
 async function phrases(n){const pool=(lessonsDone().length?lessonsDone():[LESSONS[0]]).flatMap(L=>L.ex),used=[],old=S.xp;let good=0,tot=0;
  for(let k=0;k<5;k++){const c=pool.filter(x=>!used.includes(x)).sort((a,b)=>{const r=y=>{const q=S.sr[y.id]||{c:0,w:0};return q.c-q.w*2+Math.random()*1.5};return r(a)-r(b)});if(!c.length)break;const e2=c[rnd(Math.min(4,c.length))];used.push(e2);
   const r=await Ex.run(e2,{quit:1,head:`<b>文 ${k+1}/5</b> · `});if(r==='quit')break;tot++;if(r)good++}
  UI.panel('pad');if(!tot)return;S.xp+=good;Quest.add('dojo');save();
  await D.say({n,t:`${good} sur ${tot}. ${good===tot?'Sans faute ! Je suis fier, et un peu vexé.':good>=tot-1?'Presque parfait.':'Les phrases, c\'est comme les glands : il faut en ramasser beaucoup.'} +${good} XP.`});await afterXp(old)}
 const oTanu=STORY.tanu;STORY.tanu=async e=>{if(!S.fl.act1||!S.les.l1)return oTanu(e);const n=NPN.tanu,hz=e&&e.hz;
  if(hz&&!S.fl['tn'+hz]){S.fl['tn'+hz]=1;await D.say([J(n,['また','会いました|あいました','ね','！'],'On se retrouve !','また = encore · 会いました = « on s\'est rencontrés »'),{n,t:THI[hz]},{n,t:'Je te suivrai dans chaque hameau. Viens me voir pour pratiquer tes phrases.'}]);save()}
  const i=await D.ask({n,t:'Que veux-tu travailler ?'},[{jp:['文|ぶん'],fr:'Pratiquer des phrases'},{jp:['文法|ぶんぽう'],fr:'Grammaire'},{jp:['語|ご'],fr:'Vocabulaire'},'Rien, merci']);
  if(i===0)return phrases(n);if(i===1)return oTanu(e);if(i===2)return Vocab.at(n)};
 /* --- le carnet, remis par Hana au premier matin --- */
 const oHome=STORY.home;STORY.home=async e=>{const b=S.fl.act1;await oHome(e);if(!b&&S.fl.act1&&!S.fl.tu_intro){S.fl.tu_intro=1;
  await D.say([J('Hana',['これ','、','どうぞ','。'],'Tiens, c\'est pour toi.','どうぞ = « je t\'en prie, tiens »'),{n:'Hana',t:'Maître Genzō a laissé ce carnet pour toi. Il a dit : « S\'il sait lire, qu\'il le lise. S\'il ne sait pas, qu\'il apprenne. »'},
   'Tu reçois le Carnet de l\'apprenti. Il liste ce qu\'il te reste à découvrir pour apprendre plus de kanji et plus de phrases. Chaque ligne remplie rapporte 10 円.','Tu le retrouves dans le menu, onglet Guide. La prochaine ligne s\'affiche aussi sous ton objectif, en haut de l\'écran : touche-le pour le déplier.']);save();UI.hud&&UI.hud()}};
 /* --- conseils donnés une seule fois, au bon endroit --- */
 const oTrig=STORY.triggers;STORY.triggers=(x,y)=>{const t=oTrig(x,y);if(t||!S.fl.act1)return t;
  const tip=(k,lines)=>S.fl[k]?null:async()=>{S.fl[k]=1;await D.say(lines);save()};
  if(W.at(x,y)==='w'){const r=tip('tip_w',['Les hautes herbes. Des Yōma s\'y cachent : ils sont plus faibles que ceux de la route, et chacun a volé un mot de vocabulaire que tu récupères en le battant.','Tu peux fuir ces combats-là. Si tu es blessé, contourne les herbes.']);if(r)return r}
  if(HAMS.some(h=>y>=h.y0&&y<=h.y1)){const r=tip('tip_ham',['Un hameau. Tu en trouveras un au bout de chaque région.','Trois maîtres par hameau. À la forge : les thèmes de kanji, et le repos. Maître Tanuki, dans la rue : la grammaire et le quiz de phrases. Sous le toit bleu, Maître Kotoba : écouter et prononcer.','La marchande vend onigiri et thé, en japonais.','Parle aux habitants : certains ont une histoire à te confier.']);if(r)return r}
  if(y<OY+71){const r=tip('tip_road',['Te voilà sur la route. Les créatures que tu vois t\'attaquent si elles t\'aperçoivent : affronte-les, ou passe dans leur dos.','Chaque espèce a sa manie, affichée en bleu pendant le combat. Lis-la : elle change la bonne tactique.','Les statues de Jizō, au bord du chemin, te soignent et sauvegardent ta partie.']);if(r)return r}
  return null};
 /* --- histoires des hameaux --- */
 const HQ={q5:{name:'Le chat qui séchait les cours',gold:60,todo:[,'Demande à la marchande du Hameau des bambous si elle a vu le chat.','La marchande a vu le chat entrer au dojo des mots. Va voir Maître Kotoba.','Ramène le chat à la villageoise du Hameau des bambous.']},
  q6:{name:'Trois cents en bons d\'usine',gold:70,todo:[,'Lis à l\'ouvrier du Quartier des ouvriers le montant de son bon.','Demande à la marchande du Quartier des ouvriers ce que vaut le bon.','Rapporte la réponse (et l\'onigiri) à l\'ouvrier.']},
  q7:{name:'Le message du pêcheur',gold:80,todo:[,'Transmets à Frère Daruma, au Quartier des fumées : l\'eau n\'est pas potable.','Fais taire un Crapaudeau sur le quai 2.','Retourne voir le vieux pêcheur du Quartier des fumées.']}};
 const qs=()=>S.qs||(S.qs={}),qf=()=>S.qf||(S.qf={}),step=id=>qs()[id]===1?(qf()[id]||1):0;
 async function start(id,lines){qs()[id]=1;qf()[id]=1;await D.say(lines.concat([`Nouvelle quête : « ${HQ[id].name} ». Tu la retrouves dans le menu, onglet Défis.`]));save()}
 async function done(id,lines){const q=HQ[id],old=S.xp;qs()[id]=2;S.gold=(S.gold||0)+q.gold;S.xp+=15;sfx('lvl');await D.say(lines.concat([`Quête accomplie : « ${q.name} ». +${q.gold} 円, +15 XP.`]));save();await afterXp(old)}
 const to=(id,n)=>{qf()[id]=n;save()};
 /* le chat : endormi au dojo des mots tant qu'on ne l'a pas ramené, puis aux pieds de sa maîtresse */
 NPCS.keiko.push({id:'cat',spr:'cat',x:7,y:3,dir:0,ev:'cat',cond:()=>qs().q5!==2&&step('q5')<3});
 {const v=NPCS.world.find(n=>n.id==='h21');if(v)NPCS.world.push({id:'cat',spr:'cat',x:v.x+1,y:v.y,dir:0,wander:1,ev:'cat',cond:()=>qs().q5===2})}
 const CAT=["Le chat te regarde. Puis il regarde ailleurs. Tu as été évalué.","Il bâille. Tu y vois un commentaire sur ton dernier tracé.","Il ronronne. Pas pour toi. Il ronronne en général."];
 STORY.cat=async()=>{sfx('tap');await D.say([J('Maître',['ニャー','。'],'Miaou.','ニャー : le cri du chat, en katakana'),pick(CAT)])};
 const oTalk=Quests.talk;Quests.talk=async e=>{const s=qs(),n=e.nm;
  if(e.id==='h21'&&s.q5!==2){if(!s.q5)return start('q5',[J(n,['猫|ねこ','が','いません','。'],'Mon chat n\'est plus là.','猫 (ねこ) = chat · いません = « n\'est pas là » (être vivant)'),{n,t:'Il s\'appelle Maître. Ne ris pas. Demande à la marchande : elle voit tout, elle ne fait que ça.'}]);
   if(step('q5')<3)return D.say({n,t:'Toujours pas de Maître ? Il a dû trouver quelqu\'un qui le nourrit mieux. Ça ne serait pas difficile.'});
   return done('q5',[J(n,['ありがとう','！','よかった','！'],'Merci ! Quel soulagement !','よかった = « tant mieux », le passé de いい'),{n,t:'Maître ! Tu as encore séché mes câlins pour aller en cours ? … Il a retenu des kanji ? Lui ? Il ne retient même pas son nom.'}])}
  if(e.id==='h30'&&s.q2!==1&&s.q6!==2){if(!s.q6)await start('q6',[{n,t:'Le seigneur Tetsu nous paie en bons d\'usine. Tiens, lis-moi celui-ci : je n\'ai jamais appris les chiffres, on ne m\'en a pas laissé le temps.'}]);
   if(step('q6')===1){const i=await D.ask({jp:['三百|さんびゃく','円|えん'],fr:'Le bon de l\'ouvrier. Combien vaut-il ?',x:'百 (ひゃく) = cent · 三百 se lit さんびゃく'},['Trente yen','Trois cents yen','Trois mille yen']);
    if(i!==1)return D.say({n,t:i===0?'Trente ? Pour un mois d\'usine ? … Relis, je t\'en prie. Dis-moi que tu t\'es trompé.':'Trois mille ?! … Non. Tetsu n\'a jamais été aussi drôle. Relis.'});
    to('q6',2);return D.say([{n,t:'Trois cents ! Je suis riche ! … Je suis riche ?'},{n,t:'Va demander à la marchande ce que ça vaut vraiment. Moi, je n\'ose pas.'}])}
   if(step('q6')===2)return D.say({n,t:'Alors, la marchande ? Elle a dit quoi ? … Tu n\'y es pas encore allé. D\'accord. Je ne suis pas pressé, j\'ai une vie entière d\'usine devant moi.'});
   if((S.it.oni||0)>0)S.it.oni--;return done('q6',[{n,t:'Un onigiri. Trois cents yen de Tetsu, un onigiri.'},J(n,['いただきます','。'],'Merci pour ce repas.','いただきます : ce qu\'on dit avant de manger'),{n,t:'C\'est le meilleur salaire que j\'aie touché cette année. Tiens, voilà de vraies pièces : je les gardais pour le jour où j\'aurais une bonne nouvelle.'}])}
  if(e.id==='h40'&&s.q7!==2){if(!s.q7)return start('q7',[{n,t:'L\'eau du quai est noire. Et Frère Daruma, le moine du quartier, la boit en méditant. Il dit que ça « ouvre l\'esprit ».'},{n,t:'Préviens-le. Dis-lui bien : l\'eau n\'est pas potable. En japonais, sinon il fait semblant de dormir.'}]);
   if(step('q7')<3)return D.say({n,t:step('q7')===1?'Tu as prévenu le moine ? Il est quelque part dans le quartier, debout, les yeux fermés. On dirait un poteau avec une opinion.':'Le Crapaudeau salit toujours le quai. Je l\'entends coasser d\'ici. Il chante faux, en plus.'});
   return done('q7',[J(n,['魚|さかな','が','います','！'],'Il y a des poissons !','います = « il y a » pour les êtres vivants'),{n,t:'Enfin… un. Il a l\'air fâché. Mais c\'est un début. Merci, mon garçon.'}])}
  return oTalk(e)};
 const oShop=STORY.shop;STORY.shop=async e=>{const z=e&&e.id?+String(e.id).replace('shop',''):0,n='Marchande';
  if(z===2&&step('q5')===1){const i=await D.ask(J(n,['猫|ねこ','は','道場|どうじょう','の','中|なか','に','います','。'],'(Que dit-elle ?)','中 (なか) = intérieur · 道場 (どうじょう) = dojo'),['Le chat est devant la forge.','Le chat est dans le dojo.','Le chat est dans la forêt.']);
   if(i!==1)return D.say({n,t:'Elle répète, plus lentement, avec le regard de quelqu\'un qui a toute la journée devant elle. Et c\'est le cas.'});
   to('q5',2);return D.say({n,t:'Dans le dojo des mots, oui. Il y entre tous les matins. Il est plus assidu que les élèves.'})}
  if(z===3&&step('q6')===2){const i=await D.ask(J(n,['いくら','です','か','。'],'C\'est combien ? (Réponds-lui.)','いくら = combien (prix)'),[{jp:['三十|さんじゅう','円|えん','です','。'],fr:'…'},{jp:['三千|さんぜん','円|えん','です','。'],fr:'…'},{jp:['三百|さんびゃく','円|えん','です','。'],fr:'…'}]);
   if(i!==2)return D.say({n,t:i===0?'Trente ? Ce n\'est pas ce qui est écrit sur ce bon. Je sais lire, moi.':'Trois mille ? Si c\'était vrai, je fermerais boutique et je t\'épouserais. Relis.'});
   to('q6',3);S.it.oni=(S.it.oni||0)+1;sfx('item');return D.say([{n,t:'Trois cents, en bons de Tetsu ? Ça vaut un onigiri. Froid. Et je suis généreuse.'},'Tu reçois un おにぎり, et un regard de pitié qui ne t\'était pas destiné.'])}
  return oShop(e)};
 const oKeiko=STORY.keiko;STORY.keiko=async e=>{if(step('q5')===2){const n='Maître Kotoba';to('q5',3);
   await D.say([J(n,['この','猫|ねこ','は','いい','生徒|せいと','です','。'],'Ce chat est un bon élève.','生徒 (せいと) = élève'),{n,t:'Il dort sur mes rouleaux depuis ce matin. Il a déjà retenu plus de kanji que toi : il est couché dessus.'},'Tu repars avec le chat sous le bras. Il te juge.'])}
  return oKeiko(e)};
 const oMonk=STORY.monk;STORY.monk=async e=>{if(e.z===4&&step('q7')===1){const n='Frère Daruma';
   const i=await D.ask({n,t:'Un message pour moi ? En japonais. Sinon je dors.'},[{jp:['水|みず','を','飲みたい|のみたい','です','。'],fr:'…'},{jp:['水|みず','は','飲めません|のめません','。'],fr:'…'},{jp:['水|みず','は','おいしい','です','。'],fr:'…'}]);
   if(i===0)return D.say({n,t:'Tu veux boire de l\'eau ? Sers-toi, le quai est juste là. Elle a du caractère.'});
   if(i===2)return D.say({n,t:'L\'eau est délicieuse ? Je trouvais aussi. Surtout l\'arrière-goût de charbon.'});
   to('q7',2);return D.say([{n,t:'Pas potable ? … Ça explique les visions. Et le crapaud qui me parle.'},{n,t:'Ah non, lui, il existe. C\'est un Crapaudeau qui salit le quai. Fais-en taire un, et dis au pêcheur que c\'est réglé. Moi, je vais m\'asseoir. Longtemps.'}])}
  return oMonk(e)};
 const oWin=Quests.onWin;Quests.onWin=def=>{oWin(def);if(step('q7')===2&&def.kind&&def.kind.s==='toad'){to('q7',3);UI.toast('Quête : un Crapaudeau de moins. Retourne voir le pêcheur.',3200)}};
 const oHtml=Quests.html;Quests.html=()=>{const s=qs(),ids=Object.keys(HQ),a=ids.filter(k=>s[k]===1),d=ids.filter(k=>s[k]===2).length;
  return oHtml()+(a.length||d?`<div class="sw" style="border:0;padding:8px 0 6px"><span>Histoires des hameaux · ${d}/${ids.length}</span></div>`+a.map(k=>`<div class="mi"><div class="k" style="font-size:22px;color:var(--gold)">！</div><div class="t"><b>${esc(HQ[k].name)}</b>${esc(HQ[k].todo[step(k)])}</div></div>`).join(''):'')};
})();

/* ---------- le savoir ouvre les portes : chaque gardien exige un niveau de kanji et de grammaire ---------- */
const Gates=(()=>{
 /* [étoiles de thèmes, leçons] exigées avant d'affronter le gardien */
 const REQ={kakashi:[2,2,30],karakasa:[4,4,70],smoke:[6,6,110],toad:[8,8,150],boss:[10,10,190],yuki:[12,12,230],nuri:[14,14,260],umi:[16,16,290],wanyudo:[18,18,320],kyorin:[20,20,350],baku:[22,22,380],nue:[24,24,410],yamabiko:[26,26,440],ungai:[28,28,470],kaze:[30,30,500],tetsu:[32,32,530]};
 const stars=()=>Object.values(S.th||{}).reduce((a,b)=>a+b,0),les=()=>Object.keys(S.les||{}).length;
 const meets=id=>{const r=REQ[id];return !r||S.wins[id]||S.fl.dbg_open||S.fl.visit||(stars()>=r[0]&&les()>=r[1]&&Vocab.count()>=VADJ(r[2]))};
 const lack=id=>{const r=REQ[id],a=[];if(stars()<r[0])a.push(`${r[0]} étoiles de thèmes de kanji (tu en as ${stars()})`);if(les()<r[1])a.push(`${r[1]} leçons de grammaire (tu en as ${les()})`);if(Vocab.count()<VADJ(r[2]))a.push(`${VADJ(r[2])} mots de vocabulaire (tu en as ${Vocab.count()})`);return a};
 const next=()=>['kakashi','karakasa','smoke','toad','boss','yuki','nuri','umi','wanyudo','kyorin','baku'].find(k=>!S.wins[k]);
 const hint=()=>{const k=next();if(!k||!S.fl.act1||meets(k))return '';const r=REQ[k];return `<br><span style="color:#f0cf7a">Savoir requis</span> : ★ ${stars()}/${r[0]} étoiles de thèmes · ${les()}/${r[1]} leçons · ${Vocab.count()}/${VADJ(r[2])} mots`};
 return{REQ,meets,lack,hint,stars,les}})();
{const o=objective;objective=function(){const t=o(),h=Gates.hint();if(!h)return t;const i=t.indexOf('<br><span style="color:#58e0ec">Carnet');return i<0?t+h:t.slice(0,i)+h+t.slice(i)}}
(()=>{
 const KG='影',OPP=[1,0,3,2];
 const MOCK={baku:"Elle avale les mots. Toi, tu en as si peu qu'elle ne s'en apercevrait même pas. Va en chercher d'autres, qu'on ait au moins de quoi la vexer.",kyorin:"Un examen. Toi. Je voudrais être ailleurs, mais je suis coincé dans ta poitrine, au premier rang.",wanyudo:"Une roue en feu qui réclame des billets. Tu ne saurais même pas lui dire où se trouve la gare. Remarque, elle est dessus.",umi:"C'est grand, c'est noir et ça casse des bateaux. Tu ne sais même pas dire quel jour on est. Lui non plus, remarque, mais lui il s'en fiche.",nuri:"Un mur avec un règlement. Tu ne sais même pas lui demander la permission de passer. « 〜てもいいですか », ça te dit quelque chose ? Non. Évidemment.",yuki:"Elle gèle les gens qui ne finissent pas leurs devoirs. Je trouve ça excessif, mais je comprends l'idée.",kakashi:"Un tas de boue te barre la route, et il a raison. C'est humiliant pour nous deux.",karakasa:"Elle te demande si tu aimes les fêtes. Tu ne saurais même pas lui répondre « un peu ».",smoke:"Elle retient tout ce que tu traces. Toi, tu ne retiens même pas ce que tu as tracé hier.",toad:"Tu veux te battre dans la suie sans connaître tes kanji par cœur ? J'adore ton optimisme. Non.",boss:"Ce qui dort là-dessous a mangé des samouraïs entiers. Toi, tu serais un amuse-bouche. Va apprendre."};
 async function refuse(id){const nm=EN[id].n,l=Gates.lack(id),H=W.H;
  if(!S.fl['gr_'+id]){S.fl['gr_'+id]=1;await D.say([`Le gardien te toise : ${nm}. Le Kiryoku qui l'anime est trop dense, tes kanji ne mordraient même pas.`,{n:KG,t:MOCK[id]},`Pour l'affronter, il te faut : ${l.join(', ')}.`,'Les étoiles se gagnent en apprenant les thèmes de kanji (trois niveaux par thème) chez Maître Genzō puis dans les forges. Les leçons de grammaire se suivent auprès des sensei de la route, puis de Maître Tanuki dans chaque hameau. Les mots s\'apprennent par paquets de dix chez Maître Tanuki et dans les dojos des mots. Le compte s\'affiche sous ton objectif.'])}
  else await D.say(`Le gardien ne bouge pas. Il te faut encore : ${l.join(', ')}.`);
  await W.walk(H,OPP[H.dir],.2);H.cd=8;save()}
 const oGuard=STORY.guard;STORY.guard=async(e,seen)=>{if(!e.rov&&Gates.REQ[e.id]&&!Gates.meets(e.id)){W.faceTo(e,W.H);return refuse(e.id)}return oGuard(e,seen)};
 const oWell=STORY.well;STORY.well=async e=>{if(S.wins.toad&&!S.wins.boss&&!Gates.meets('boss'))return refuse('boss');return oWell(e)};
 const oTrig=STORY.triggers;STORY.triggers=(x,y)=>{if(y<=Y5+8&&y>=Y5+2&&x<=13&&W.zone()===5&&S.wins.toad&&!S.wins.boss&&!Gates.meets('boss'))return()=>refuse('boss');return oTrig(x,y)};
})();

/* ---------- les nouveaux habitants des bourgs agrandis : 9 à 16, et des passants communs à tous ---------- */
(()=>{const F=window.FOLKX={
 '9v':[['sendo','Batelier',['舟|ふね','に','乗ります|のります','か','。'],'Tu montes dans la barque ?','乗ります (のります) = monter (dans un véhicule)',"C'est gratuit. Le retour, c'est autre chose. Le retour, on en parle sur l'eau."],
  ['fishw','Marchande de poisson',['この','魚|さかな','は','新しい|あたらしい','です','。'],'Ce poisson est frais.','魚 (さかな) = poisson · 新しい (あたらしい) = neuf, frais',"Il est frais de ce matin. De quel matin, je ne sais plus."],
  ['kidg','Petite fille des canaux',['橋|はし','の','下|した','に','猫|ねこ','が','います','。'],'Il y a un chat sous le pont.','下 (した) = dessous · います = il y a (êtres vivants)',"Il s'appelle Monsieur. C'est moi qui l'ai appelé comme ça. Il ne répond pas, mais par politesse."],
  ['worker','Éclusier',['水|みず','が','多い|おおい','です','ね','。'],'Il y a beaucoup d\'eau, hein.','水 (みず) = eau · 多い (おおい) = nombreux, beaucoup',"Trop d'eau, j'ouvre. Pas assez, je ferme. Trente ans de métier. Je résume bien, hein ?"],
  ['oldw','Couturière des quais',['雨|あめ','の','日|ひ','は','静か|しずか','です','。'],'Les jours de pluie sont calmes.','雨 (あめ) = pluie · 静か (しずか) = calme',"Ici il pleut un jour sur deux. L'autre jour, on attend la pluie."]],
 '10v':[['gakusei','Étudiant en retard',['宿題|しゅくだい','が','まだ','です','。'],'Mes devoirs ne sont pas encore faits.','宿題 (しゅくだい) = devoirs · まだ = pas encore',"Ils sont pour hier. J'ai encore le temps d'être en retard demain."],
  ['shinbun','Crieur de journaux',['新聞|しんぶん','は','いかが','です','か','。'],'Un journal, ça vous dit ?','新聞 (しんぶん) = journal · いかがですか = ça vous dirait ?',"Les nouvelles d'hier, à moitié prix. Celles d'avant-hier, je vous les donne."],
  ['girl','Bibliothécaire',['図書館|としょかん','で','話さないで|はなさないで','ください','。'],'Ne parlez pas dans la bibliothèque.','図書館 (としょかん) = bibliothèque · 〜ないでください = ne… pas, s\'il vous plaît',"On n'est pas dans la bibliothèque ? Peu importe. C'est une habitude."],
  ['insatsu','Imprimeur',['紙|かみ','が','高い|たかい','です','。'],'Le papier coûte cher.','紙 (かみ) = papier · 高い (たかい) = cher (aussi « haut »)',"Alors j'écris petit. Mes clients ont de très bons yeux, ou de très bonnes loupes."],
  ['kid','Écolier',['先生|せんせい','は','こわい','です','。'],'Le professeur fait peur.','先生 (せんせい) = professeur · こわい = effrayant',"Il a un sceau qui dit « recommencez ». Il le tamponne avant même de lire."]],
 '11v':[['welder','Soudeuse',['熱い|あつい','から','気をつけて|きをつけて','。'],'C\'est chaud, alors fais attention.','熱い (あつい) = brûlant · 〜から = parce que · 気をつけて = fais attention',"Tout est chaud ici. La soupe, les rails, le chef. Surtout le chef."],
  ['sekitan','Charbonnier',['顔|かお','が','黒い|くろい','です','か','。'],'J\'ai le visage noir ?','顔 (かお) = visage · 黒い (くろい) = noir',"Je me lave le dimanche. Le lundi, ça ne se voit plus."],
  ['baa','Mère d\'ouvrier',['息子|むすこ','は','工場|こうじょう','に','います','。'],'Mon fils est à l\'usine.','息子 (むすこ) = (mon) fils · 工場 (こうじょう) = usine',"Il y est depuis quatre ans. Il rentre dormir. Je crois. Le lit est défait, en tout cas."],
  ['imoji','Fondeur',['この','鍋|なべ','は','私|わたし','が','作りました|つくりました','。'],'Cette marmite, c\'est moi qui l\'ai faite.','鍋 (なべ) = marmite · 作りました (つくりました) = (j\')ai fabriqué',"Elle a un trou. Mais c'est un trou de très bonne qualité."],
  ['kid','Gamin des forges',['大きく|おおきく','なったら','、','汽車|きしゃ','を','運転します|うんてんします','。'],'Quand je serai grand, je conduirai un train.','〜たら = quand, si · 運転します (うんてんします) = conduire',"Ou une forge. Ou une forge sur un train. Je n'ai pas encore décidé."]],
 '12v':[['meca','Mécanicienne de quai',['ネジ','が','一つ|ひとつ','ありません','。'],'Il manque une vis.','一つ (ひとつ) = un (objet) · ありません = il n\'y a pas',"Elle était là ce matin. Le dirigeable aussi, d'ailleurs. Ce n'est peut-être pas lié."],
  ['eng','Chauffeur de nacelle',['空|そら','は','広い|ひろい','です','ね','。'],'Le ciel est vaste, hein.','空 (そら) = ciel · 広い (ひろい) = vaste',"Vaste, oui. Mais encombré. Hier, j'ai doublé un nuage par la droite. Il n'a pas apprécié."],
  ['peddler','Vendeur de parapluies',['かさ','は','いりません','か','。'],'Vous n\'avez pas besoin d\'un parapluie ?','かさ = parapluie · いります = avoir besoin',"Au-dessus des nuages, il ne pleut pas. C'est pour ça que j'en ai encore autant."],
  ['kidg','Fille de capitaine',['父|ちち','は','船長|せんちょう','です','。'],'Mon père est capitaine.','父 (ちち) = (mon) père · 船長 (せんちょう) = capitaine',"De quel bateau, il ne dit pas. Il dit « le plus beau ». Ça ne se trouve pas sur les registres."],
  ['rail','Contrôleur du port',['切符|きっぷ','を','見せて|みせて','ください','。'],'Montrez-moi votre billet, s\'il vous plaît.','切符 (きっぷ) = billet · 見せてください = montrez-moi',"Vous n'en avez pas ? Moi non plus. On est quittes. Passez."]],
 '13v':[['lumber','Bûcheron renard',['この','木|き','は','とても','古い|ふるい','です','。'],'Cet arbre est très vieux.','木 (き) = arbre · 古い (ふるい) = vieux (pour les choses)',"Je ne le coupe pas. Il me regarde. Il a mille ans, il a le droit."],
  ['pilgrim','Voyageuse égarée',['駅|えき','は','どちら','です','か','。'],'De quel côté est la gare ?','駅 (えき) = gare · どちら = de quel côté (poli)',"Un renard m'a dit « à gauche ». Un tanuki « à droite ». Je suis là depuis mardi."],
  ['weaver','Tisserande',['きつね','の','しっぽ','は','きれい','です','ね','。'],'Elle est belle, la queue des renards.','しっぽ = queue · きれい = joli, beau',"Ils me l'ont prêtée pour un modèle. Je dois la rendre avant la pleine lune. Ou alors on s'arrange."],
  ['kid','Enfant tanuki',['いっしょに','あそびましょう','！'],'Jouons ensemble !','〜ましょう = faisons… (invitation)',"Je suis un vrai enfant. Ma queue, c'est une écharpe. Ne tire pas dessus."],
  ['jii','Vieux conteur',['むかしむかし','、','この','森|もり','に','…'],'Il était une fois, dans cette forêt…','むかしむかし = il était une fois · 森 (もり) = forêt',"… un vieux qui racontait des histoires. Et c'est moi. Fin. Les histoires courtes, c'est mon style."]],
 '14v':[['jardin','Jardinière',['花|はな','に','水|みず','を','やります','。'],'J\'arrose les fleurs.','花 (はな) = fleur · 水をやります = arroser',"À l'heure pile. Le problème, c'est qu'ici aucune horloge n'est d'accord sur l'heure pile."],
  ['kagi','Serrurier',['かぎ','を','なくしました','。'],'J\'ai perdu la clé.','かぎ = clé · なくしました = (j\')ai perdu',"La clé de mon atelier. Je suis serrurier. Je vais devoir me cambrioler."],
  ['girl','Apprentie horlogère',['今|いま','、','何時|なんじ','です','か','。'],'Quelle heure est-il ?','今 (いま) = maintenant · 何時 (なんじ) = quelle heure',"Ne regarde pas les horloges. Elles mentent toutes. Moi, je compte les moutons. Et je m'endors."],
  ['jii','Vieil horloger',['時計|とけい','は','遅れて|おくれて','います','。'],'La montre retarde.','時計 (とけい) = montre, horloge · 遅れています (おくれています) = retarder',"Depuis quarante ans. Elle est constante. Je respecte ça."],
  ['kidg','Fillette aux nuages',['雲|くも','の','上|うえ','は','寒い|さむい','です','。'],'Au-dessus des nuages, il fait froid.','雲 (くも) = nuage · 上 (うえ) = dessus · 寒い (さむい) = froid',"Mais on est plus près des oiseaux. Ça compense. Un peu."]],
 '15v':[['rail','Aiguilleur',['右|みぎ','です','か','、','左|ひだり','です','か','。'],'À droite ou à gauche ?','右 (みぎ) = droite · 左 (ひだり) = gauche',"Je pose la question à chaque train. Ils ne répondent jamais. Alors je tire à pile ou face."],
  ['furin','Marchande de clochettes',['風|かぜ','の','音|おと','が','好き|すき','です','。'],'J\'aime le bruit du vent.','風 (かぜ) = vent · 音 (おと) = son, bruit · 好き (すき) = aimer',"Ici le vent souffle des quatre côtés. Mes clochettes ne savent plus où donner de la tête."],
  ['peddler','Voyageur indécis',['北|きた','へ','行きます|いきます','。'],'Je vais vers le nord.','北 (きた) = nord · 〜へ行きます = aller vers…',"Ou vers le sud. Je décide au carrefour. Ça fait trois semaines que je suis au carrefour."],
  ['oldw','Veilleuse des lanternes',['夜|よる','は','あぶない','です','よ','。'],'La nuit, c\'est dangereux, tu sais.','夜 (よる) = nuit · あぶない = dangereux',"Pas à cause des yōkai. À cause des aiguilleurs qui rentrent du bistrot."],
  ['kid','Gamin du carrefour',['この','道|みち','は','どこ','へ','行きます|いきます','か','。'],'Où va ce chemin ?','どこへ = vers où · 道 (みち) = chemin',"Personne ne sait. C'est pour ça qu'on l'appelle « le chemin ». Les autres ont des noms."]],
 '16v':[['worker','Ouvrier sans nom',['私|わたし','の','名前|なまえ','は','…'],'Mon nom est…','名前 (なまえ) = nom',"… je l'avais ce matin. Il était sur le bout de ma langue. Puis un garde l'a pris."],
  ['oldw','Vieille dame des archives',['この','本|ほん','に','名前|なまえ','が','あります','。'],'Il y a des noms dans ce livre.','本 (ほん) = livre · あります = il y a (choses)',"Des milliers. Si tu trouves le mien, rends-le-moi. Il commence par un « A ». Ou un « O »."],
  ['junsa','Garde fatigué',['ここ','に','入らないで|はいらないで','ください','。'],'N\'entrez pas ici, s\'il vous plaît.','入ります (はいります) = entrer · 〜ないでください = ne… pas, s\'il vous plaît',"Ordre de Tetsu. Moi, je m'en fiche. Mais il m'a pris mon nom, alors je fais semblant d'obéir."],
  ['kidg','Petite fille de la citadelle',['あなた','の','名前|なまえ','は','何|なん','です','か','。'],'Comment tu t\'appelles ?','何 (なん) = quoi · 名前は何ですか = quel est ton nom ?',"Ne le dis pas trop fort. Ici, les murs écoutent. Et ils prennent des notes."],
  ['karak','Automate domestique',['お茶|おちゃ','を','入れます|いれます','。'],'Je vous sers le thé.','入れます (いれます) = servir (le thé), mettre dedans',"Je n'ai pas de nom. J'ai un numéro. C'est moins joli, mais personne ne peut me le voler."]],
 '17v':[['pnj10','Pêcheur sans poisson',['今日|きょう','は','何|なに','も','釣れない|つれない','。'],'Aujourd\'hui, je n\'attrape rien.','〜ない : la forme négative familière · 釣れる (つれる) = mordre (poisson)',"J'ai attrapé un truc, hier. Je ne sais pas ce que c'était. Il n'avait plus de nom. Je l'ai relâché par politesse."],
  ['kidg','Petite bâtisseuse',['お城|おしろ','を','作って|つくって','います','！'],'Je construis un château !','お城 (おしろ) = château · 〜ています = être en train de',"Le vieux tanuki n'a pas bougé de la matinée. C'est le meilleur donjon que j'ai jamais eu."],
  ['pnj4','Grand-mère des filets',['あの','人|ひと','は','ぜんぜん','泳がない|およがない','。'],'Celui-là ne nage pas du tout.','ぜんぜん + négatif · 泳ぐ (およぐ) → 泳がない',"Le garçon tombé du ciel, là. Il a coulé comme un caillou en armure. Les poissons se sont moqués de lui. Enfin, les trucs."],
  ['pnj2','Marchande de coquillages',['この','貝|かい','は','高く|たかく','ない','です','よ','。'],'Ce coquillage n\'est pas cher, tu sais.','貝 (かい) = coquillage · 高くない = pas cher',"Il était à quelqu'un, avant. Il y avait un nom écrit dedans. La mer l'a effacé. Je te le fais à moitié prix."],
  ['pnj12','Armateur ruiné',['船|ふね','が','ない','。','お金|おかね','も','ない','。'],'Plus de bateau. Plus d\'argent non plus.','ない : il n\'y a pas · も = non plus',"Un morceau de citadelle est tombé sur ma flotte. J'ai écrit à Tetsu pour me plaindre. La lettre m'est revenue dans une bouteille."]],
 '17r':[['pnj9','Garde-côte',['海|うみ','に','入らない|はいらない','で','ね','。'],'N\'entre pas dans la mer, hein.','入らない (はいらない) : forme en ない de 入る',"Le grand crabe à tête de taureau garde la route du nord. Il ne laisse passer personne. Même pas moi, et c'est moi le garde."],
  ['pnj7','Ramasseur d\'épaves',['この','鉄|てつ','は','重い|おもい','。','持てない|もてない','。'],'Ce fer est lourd. Je ne peux pas le porter.','持てない (もてない) = ne pas pouvoir porter',"Tout ça vient du ciel. Des plaques, des engrenages, une baignoire. Qui met une baignoire dans une citadelle volante ?"],
  ['pnj8','Moine des dunes',['あまり','急がない','で','ください','。'],'Ne vous pressez pas trop.','あまり + négatif · 急ぐ (いそぐ) → 急がない',"Le sable est patient. La mer est patiente. Le crabe-taureau, au nord, beaucoup moins."]],
 /* les passants communs : ils complètent chaque bourg, en habits de toutes les couleurs */
 'v':[['pnj1','Riziculteur',['田んぼ|たんぼ','は','広い|ひろい','です','ね','。'],'Les rizières sont vastes, hein.','田んぼ (たんぼ) = rizière · 広い (ひろい) = vaste',"Je les retourne avec ma houe depuis quarante ans. Elles ne sont pas plus petites. Moi si."],
  ['pnj1','Cultivateur',['今年|ことし','の','米|こめ','は','いい','です','。'],'Le riz de cette année est bon.','今年 (ことし) = cette année · 米 (こめ) = riz',"Je dis ça chaque année. Un jour, ce sera vrai."],
  ['pnj2','Marchande de légumes',['この','大根|だいこん','は','百円|ひゃくえん','です','。'],'Ce radis coûte cent yens.','大根 (だいこん) = radis blanc · 百円 (ひゃくえん) = cent yens',"Il est énorme, oui. Je ne l'ai pas fait exprès. Il a poussé pendant que je regardais ailleurs."],
  ['pnj3','Ancien du bourg',['私|わたし','は','八十|はちじゅう','歳|さい','です','。'],'J\'ai quatre-vingts ans.','八十 (はちじゅう) = quatre-vingts · 歳 (さい) = an (d\'âge)',"Ou quatre-vingt-un. Après soixante-dix, j'ai arrêté de compter. Les bougies coûtaient trop cher."],
  ['pnj4','Grand-mère au baluchon',['孫|まご','に','会いに|あいに','行きます|いきます','。'],'Je vais voir mon petit-fils.','孫 (まご) = petit-enfant · 会いに行きます (あいにいきます) = aller voir quelqu\'un',"Il habite trois bourgs plus loin. Je fais un peu de chemin chaque jour. J'arrive l'an prochain."],
  ['pnj5','Garçon à la libellule',['見て|みて','！','とんぼ','です','よ','。'],'Regarde ! C\'est une libellule.','見て (みて) = regarde · とんぼ = libellule',"Elle est en bambou. Elle vole très bien. Vers le bas, surtout."],
  ['pnj6','Fillette au moulinet',['風|かぜ','が','ありません','。'],'Il n\'y a pas de vent.','風 (かぜ) = vent · ありません = il n\'y a pas (choses)',"Alors je cours, et mon moulin tourne. Papa dit que le vent, je l'ai surtout dans la tête."],
  ['pnj7','Mécano à lunettes',['この','機械|きかい','は','古い|ふるい','です','。'],'Cette machine est vieille.','機械 (きかい) = machine · 古い (ふるい) = vieux (pour les choses)',"Je la répare avec cette clé. Je l'ai aussi cassée avec cette clé. C'est une clé polyvalente."],
  ['pnj8','Moine errant',['静か|しずか','に','歩きましょう|あるきましょう','。'],'Marchons en silence.','静かに (しずかに) = calmement · 歩きましょう (あるきましょう) = marchons',"… Bien. Tu as tenu trois secondes. Moi, quarante ans. Chacun son rythme."],
  ['pnj9','Garde à la lance',['名前|なまえ','を','書いて|かいて','ください','。'],'Écrivez votre nom, s\'il vous plaît.','名前 (なまえ) = nom · 書いてください (かいてください) = écrivez, s\'il vous plaît',"C'est pour le registre. Personne ne le lit jamais. Mais il est très bien rangé."],
  ['pnj10','Pêcheur au seau',['今日|きょう','は','魚|さかな','が','いません','。'],'Aujourd\'hui, il n\'y a pas de poisson.','魚 (さかな) = poisson · いません = il n\'y a pas (êtres vivants)',"Hier non plus. Mais le seau est content : il se repose."],
  ['pnj12','Riche négociant',['お金|おかね','は','大切|たいせつ','です','よ','。'],'L\'argent, c\'est important, tu sais.','お金 (おかね) = argent · 大切 (たいせつ) = précieux, important',"Je compte le mien tous les soirs. Il y en a toujours autant. C'est rassurant, et un peu décevant."],
  ['pnj2','Maraîchère',['野菜|やさい','を','買いません|かいません','か','。'],'Vous n\'achetez pas de légumes ?','野菜 (やさい) = légume · 〜ませんか = invitation polie',"Les carottes sont fraîches. Les navets, eux, ont vécu. Ils ont des histoires à raconter."],
  ['pnj3','Vieux lettré',['目|め','が','悪い|わるい','です','。'],'J\'ai de mauvais yeux.','目 (め) = œil · 悪い (わるい) = mauvais',"D'où les lunettes. Elles marchent très bien. C'est moi qui marche moins bien."],
  ['pnj4','Doyenne',['若い|わかい','人|ひと','は','はやい','です','ね','。'],'Les jeunes vont vite, hein.','若い (わかい) = jeune · はやい = rapide',"Toi, tu cours partout avec ton sabre. Moi je marche. On finit tous au même endroit : au salon de thé."],
  ['pnj5','Petit coureur',['ぼく','は','走る|はしる','の','が','好き|すき','です','。'],'J\'aime courir.','ぼく = moi (garçon) · 走る (はしる) = courir · 好き (すき) = aimer',"Je cours tout le temps. Maman dit que je finirai bien par arriver quelque part."],
  ['pnj6','Petite sœur',['お姉さん|おねえさん','は','どこ','です','か','。'],'Où est ma grande sœur ?','お姉さん (おねえさん) = grande sœur · どこ = où',"Elle joue à cache-cache. Depuis hier. Elle est très forte."],
  ['pnj7','Riveteur',['毎日|まいにち','、','工場|こうじょう','で','働きます|はたらきます','。'],'Je travaille à l\'usine tous les jours.','毎日 (まいにち) = tous les jours · 働きます (はたらきます) = travailler',"Le dimanche aussi. Le dimanche, c'est un lundi avec moins de monde."],
  ['pnj8','Bonze pèlerin',['お寺|おてら','は','山|やま','の','上|うえ','です','。'],'Le temple est en haut de la montagne.','お寺 (おてら) = temple · 上 (うえ) = dessus, en haut',"Ils sont tous en haut. Personne n'a jamais bâti un temple en bas. C'est une question d'image."],
  ['pnj9','Sentinelle',['この','町|まち','は','安全|あんぜん','です','。'],'Cette ville est sûre.','町 (まち) = ville · 安全 (あんぜん) = sûr, sans danger',"Grâce à moi. Et à ma lance. Surtout à ma lance : elle est plus grande que moi."],
  ['pnj10','Pêcheur matinal',['朝|あさ','、','五時|ごじ','に','起きます|おきます','。'],'Je me lève à cinq heures du matin.','朝 (あさ) = matin · 起きます (おきます) = se lever',"Les poissons se lèvent à six. J'ai une heure d'avance. Ça ne sert à rien, mais j'y tiens."],
  ['pnj12','Marchand au boulier',['全部|ぜんぶ','で','千円|せんえん','です','。'],'Ça fait mille yens en tout.','全部で (ぜんぶで) = en tout · 千円 (せんえん) = mille yens',"Tu n'as rien acheté ? C'est le prix de la conversation. Je plaisante. À moitié."],
  ['peddler','Marchand ambulant',['安い|やすい','です','よ','！'],'C\'est pas cher !','安い (やすい) = bon marché',"Pas cher pour moi, en tout cas. Je l'ai trouvé par terre."],
  ['girl','Jeune fille pressée',['すみません','、','急いで|いそいで','います','。'],'Pardon, je suis pressée.','急いでいます (いそいでいます) = être pressé',"Je ne sais pas où je vais. Mais j'y vais vite."],
  ['jii','Grand-père au soleil',['いい','天気|てんき','です','ね','。'],'Il fait beau, hein.','天気 (てんき) = temps (météo) · いい = bon',"Je dis ça tous les jours. Même quand il pleut. Ça fait plaisir aux gens."],
  ['kid','Enfant curieux',['それ','は','何|なん','です','か','。'],'C\'est quoi, ça ?','それ = ça (près de toi) · 何 (なん) = quoi',"Ton sabre ? Ah. Moi, j'ai un bâton. On fait la même chose, en gros."],
  ['shafu','Tireur de pousse-pousse',['どこ','まで','です','か','。'],'Jusqu\'où ?','どこまで = jusqu\'où',"Le prix dépend de la distance. Et de la tête du client. La tienne, ça va."],
  ['baa','Grand-mère du marché',['ごはん','を','食べました|たべました','か','。'],'Tu as mangé ?','ごはん = repas, riz · 食べました (たべました) = (j\')ai mangé',"Tu es tout maigre. Tiens, une boulette de riz. Elle date d'hier. Hier, c'était hier, pas si loin."],
  ['pnj8','Voyageur fourbu',['足|あし','が','痛い|いたい','です','。'],'J\'ai mal aux pieds.','足 (あし) = pied, jambe · 痛い (いたい) = douloureux',"J'ai marché depuis le bourg d'à côté. En passant par trois détours. Et une barque."],
  ['yatai','Marchand de nouilles',['ラーメン','は','おいしい','です','よ','。'],'Les ramen sont délicieuses, tu sais.','おいしい = délicieux',"Recette secrète. Le secret, c'est qu'il n'y a pas de recette."],
  ['sentaku','Lavandière',['今日|きょう','は','いそがしい','です','。'],'Aujourd\'hui, je suis occupée.','いそがしい = occupé, débordé',"Hier aussi. Demain aussi. Le linge sale ne prend jamais de vacances."],
  ['mount','Porteur',['荷物|にもつ','が','重い|おもい','です','。'],'Mes bagages sont lourds.','荷物 (にもつ) = bagages · 重い (おもい) = lourd',"Ce ne sont pas les miens. Mais le client est parti devant. Avec ses bras libres."],
  ['merch','Commerçant',['また','来て|きて','ください','ね','。'],'Revenez, hein.','また = encore, de nouveau · 来てください = venez, s\'il vous plaît',"Tu n'as rien acheté ? Raison de plus pour revenir."],
  ['shokudo','Cuisinière',['お腹|おなか','が','すきました','か','。'],'Tu as faim ?','お腹がすきました (おなかがすきました) = avoir faim',"Moi, toujours. C'est pour ça que je suis cuisinière. Je goûte beaucoup."]]};
})();
/* ---------- habitants et voyageurs en plus : une vraie phrase chacun, et une remarque ---------- */
(()=>{
 /* [sprite, nom, phrase, traduction, explication, remarque] — r : sur la route, v : dans un hameau */
 const F={
 '1r':[['peddler','Colporteur',['この','道|みち','は','長い|ながい','です','よ','。'],'Cette route est longue, tu sais.','長い (ながい) = long · よ = « je t\'assure »',"Je la fais tous les jours. Elle ne raccourcit pas. J'ai vérifié."],
  ['girl','Cueilleuse',['今日|きょう','は','暑い|あつい','です','ね','。'],'Il fait chaud aujourd\'hui, hein.','暑い (あつい) = chaud (pour le temps)',"Les épouvantails ne transpirent pas, eux. C'est injuste."],
  ['kid','Gamin',['あの','かかし','は','こわい','です','。'],'Cet épouvantail-là fait peur.','あの = ce… là-bas · こわい = effrayant',"Il m'a regardé. Enfin je crois. Il n'a pas d'yeux, c'est ça le problème."]],
 '2r':[['lumber','Bûcheron',['竹|たけ','を','切ります|きります','。'],'Je coupe du bambou.','切ります (きります) = couper',"Il repousse plus vite que je ne coupe. On appelle ça un métier d'avenir."],
  ['pilgrim','Pèlerine',['寺|てら','は','どこ','です','か','。'],'Où est le temple ?','寺 (てら) = temple · どこ = où',"On m'a dit « tout droit ». Dans une forêt. Merci du conseil."],
  ['fisher','Chasseur de champignons',['きのこ','が','たくさん','あります','。'],'Il y a beaucoup de champignons.','たくさん = beaucoup · あります = il y a (choses)',"Je ne sais pas lesquels sont bons. Je goûte. Je suis encore là, c'est bon signe."]],
 '3r':[['rail','Cheminot',['電車|でんしゃ','は','まだ','来ません|きません','。'],'Le train n\'arrive toujours pas.','まだ + négatif = « pas encore »',"Il a trois jours de retard. Ou alors c'est moi qui suis en avance."],
  ['worker','Manutentionnaire',['この','箱|はこ','は','重い|おもい','です','。'],'Cette caisse est lourde.','箱 (はこ) = boîte, caisse · 重い (おもい) = lourd',"Elle est vide. C'est la caisse elle-même qui est lourde. Tetsu fait des économies bizarres."],
  ['kid','Apprenti',['仕事|しごと','は','五時|ごじ','まで','です','。'],'Le travail, c\'est jusqu\'à cinq heures.','まで = jusqu\'à',"Cinq heures du matin, hein. On commence à six."]],
 '4r':[['welder','Soudeur',['気|き','を','つけて','。','ここ','は','熱い|あつい','です','。'],'Fais attention. C\'est brûlant, ici.','熱い (あつい) = chaud au toucher',"J'ai perdu mes sourcils en mars. Ils ne sont pas revenus. Je ne leur en veux pas."],
  ['girl','Porteuse d\'eau',['水|みず','を','飲みません|のみません','か','。'],'Tu ne veux pas boire de l\'eau ?','〜ませんか = invitation polie',"Pas celle du quai. La mienne. Elle vient d'ailleurs, elle a de la chance."],
  ['fisher','Veilleur',['夜|よる','は','もっと','うるさい','です','。'],'La nuit, c\'est encore plus bruyant.','もっと = davantage',"Le jour, on n'entend que les machines. La nuit, on entend ce qu'elles pensent."]],
 '8r':[['fisher','Pêcheur à la ligne',['魚|さかな','が','釣れません|つれません','。'],'Ça ne mord pas.','釣れます (つれます) = (le poisson) se laisse prendre',"Trois heures que j'attends. Le poisson-chat, là, me regarde faire. Il prend des notes."],
  ['pilgrim','Pèlerine',['橋|はし','は','どこ','です','か','。'],'Où est le pont ?','橋 (はし) = pont',"On m'a dit « il y a un pont ». On ne m'a pas dit « il y avait »."],
  ['lumber','Charpentier de marine',['船|ふね','を','作って|つくって','います','。'],'Je construis un bateau.','〜ています = être en train de',"Le troisième ce mois-ci. La grosse tête noire les casse plus vite que je ne cloue."]],
 '8v':[['oldw','Veuve de passeur',['霧|きり','の','日|ひ','は','外|そと','に','出ません|でません','。'],'Les jours de brume, je ne sors pas.','霧 (きり) = brume · 外 (そと) = dehors',"Il y a un fantôme qui demande une louche. Je lui en ai donné une. Il en redemande. C'est un collectionneur."],
  ['kidg','Petite du fumoir',['この','魚|さかな','は','私|わたし','が','取りました|とりました','。'],'Ce poisson, c\'est moi qui l\'ai attrapé.','取ります (とります) = prendre, attraper',"Avec les mains. Il dormait. Ça compte quand même."],
  ['welder','Mécanicien de bac',['エンジン','は','水曜日|すいようび','に','直ります|なおります','。'],'Le moteur sera réparé mercredi.','直ります (なおります) = être réparé',"Je dis mercredi tous les jours. Un jour ce sera vrai, et ce jour-là sera un mercredi."],
  ['peddler','Vendeur de billets',['切符|きっぷ','は','一枚|いちまい','百円|ひゃくえん','です','。'],'Le billet coûte cent yens.','一枚 (いちまい) = un (objet plat)',"Le bateau ne part pas, mais le billet reste valable. Indéfiniment. C'est écrit en tout petit."]],
 '7r':[['pilgrim','Pèlerine',['紅葉|もみじ','が','きれい','です','ね','。'],'Les érables sont beaux, hein.','紅葉 (もみじ) = érable rouge, feuillage d\'automne',"Je marche depuis trois jours pour les voir. Ils sont rouges. Voilà. C'était ça."],
  ['peddler','Colporteur',['宿場|しゅくば','まで','あと','少し|すこし','です','。'],'Le relais n\'est plus très loin.','あと少し = encore un peu',"C'est ce que je dis à tout le monde, dans les deux sens. Ça fait toujours plaisir."],
  ['mount','Porteur de palanquin',['お客さん|おきゃくさん','を','待って|まって','います','。'],'J\'attends un client.','お客さん (おきゃくさん) = client · 待ちます (まちます) = attendre',"Depuis que les automates courent sur la route, plus personne ne veut être porté. J'attends quand même. Par principe."]],
 '7v':[['oldw','Vieille voyageuse',['この','宿|やど','の','お風呂|おふろ','は','いい','です','よ','。'],'Le bain de cette auberge est très bien, tu sais.','宿 (やど) = auberge · お風呂 (おふろ) = bain',"Je suis arrivée pour une nuit. C'était il y a onze ans."],
  ['kidg','Fille du postier',['手紙|てがみ','を','出しました|だしました','か','。'],'Tu as posté une lettre ?','手紙を出します = poster une lettre',"Les tubes en laiton, ça fait « pfouit ». Parfois la lettre revient. Parfois c'en est une autre."],
  ['weaver','Vendeuse de sandales',['わらじ','は','いかが','です','か','。','百円|ひゃくえん','です','。'],'Des sandales de paille ? C\'est cent yens.','いかがですか = « que diriez-vous de… ? »',"Elles tiennent jusqu'au prochain relais. C'est fait exprès. J'ai une cousine au prochain relais."],
  ['peddler','Marchand de marrons',['熱い|あつい','です','から','、','気|き','を','つけて','ください','。'],'C\'est chaud, alors fais attention.','気をつけて = « fais attention »',"Le renard, là-bas, m'a payé avec des feuilles. De belles feuilles, remarque."]],
 '6r':[['mount','Montagnard',['雪|ゆき','が','深い|ふかい','です','。'],'La neige est profonde.','深い (ふかい) = profond',"J'y ai perdu une sandale en novembre. Je la retrouverai au printemps, avec mon pied si tout va bien."],
  ['girl','Voyageuse',['北|きた','は','どちら','です','か','。'],'De quel côté est le nord ?','どちら = quel côté (poli)',"Tout est blanc. Le nord aussi. Ça n'aide pas."],
  ['kid','Petit luge',['雪だるま|ゆきだるま','を','作りました|つくりました','！'],'J\'ai fait un bonhomme de neige !','作りました = « ai fabriqué »',"Il a bougé. Maman dit que non. Maman n'était pas là."]],
 '2v':[['baa','Grand-mère',['お茶|おちゃ','を','どうぞ','。'],'Tiens, du thé.','どうぞ = « je t\'en prie »',"Non, je n'en ai pas. Mais c'est l'intention qui compte."],
  ['kid','Enfant',['一緒に|いっしょに','遊びます|あそびます','か','。'],'On joue ensemble ?','一緒に = ensemble · 遊びます = jouer',"Tu fais le Yōma. Non attends, tu as un sabre. C'est toi le Yōma quand même."],
  ['weaver','Vannier',['これ','は','私|わたし','の','家|いえ','です','。'],'Ça, c\'est ma maison.','これ = ceci · 私の = mon, ma',"Celle de dos. On ne voit que le mur. C'est un bon mur."]],
 '3v':[['sentaku','Lavandière',['洗濯物|せんたくもの','が','黒く|くろく','なりました','。'],'Le linge est devenu noir.','黒くなりました = « est devenu noir »',"Je l'ai étendu blanc. La suie a fait le reste. Maintenant je vends du linge noir, ça marche mieux."],
  ['worker','Ouvrier au repos',['今日|きょう','は','休み|やすみ','です','。'],'Aujourd\'hui, c\'est congé.','休み (やすみ) = repos, congé',"Mon premier en quatre ans. Je ne sais pas quoi faire. Je regarde l'usine, par habitude."],
  ['kidg','Gamine',['先生|せんせい','に','なりたい','です','。'],'Je veux devenir professeure.','〜に なります = devenir · 〜たい = vouloir',"Pas ouvrière. Papa dit que c'est pareil mais avec de la craie."]],
 '4v':[['jii','Retraité',['むかし','、','ここ','に','川|かわ','が','ありました','。'],'Autrefois, il y avait une rivière ici.','ありました = « il y avait »',"Elle y est toujours. C'est juste qu'on ne la reconnaît plus."],
  ['girl','Couturière',['この','服|ふく','は','安い|やすい','です','よ','。'],'Ce vêtement n\'est pas cher, tu sais.','服 (ふく) = vêtement · 安い = bon marché',"Il est ignifugé. Ici, c'est le seul argument de vente."],
  ['worker','Chauffeur',['石炭|せきたん','が','もう','ありません','。'],'Il n\'y a plus de charbon.','もう + négatif = « ne… plus »',"Ne le dis pas à Tetsu. Il croit que les machines tournent à la bonne volonté."]],
 '5v':[['oldw','Vieille femme',['ここ','に','住んで|すんで','います','。'],'J\'habite ici.','住んでいます = « habiter »',"Oui, dans la ruine. Le toit est ouvert, on voit les étoiles. Et la pluie. Surtout la pluie."],
  ['jii','Gardien de rien',['何も|なにも','ありません','。'],'Il n\'y a rien.','何も + négatif = « rien »',"Je garde quand même. On ne sait jamais, quelqu'un pourrait vouloir voler le rien."],
  ['kid','Orphelin',['お兄さん|おにいさん','は','強い|つよい','です','か','。'],'Tu es fort, grand frère ?','強い (つよい) = fort',"Parce que le truc dans le puits, lui, il est très fort. Je dis ça, je dis rien."]],
 '6v':[['sentaku','Lavandière',['洗濯|せんたく','は','大変|たいへん','です','。'],'La lessive, c\'est dur.','洗濯 (せんたく) = lessive · 大変 (たいへん) = pénible',"Je lave à l'eau chaude. Le linge gèle quand même avant de sécher. Je le range debout."],
  ['baa','Aubergiste à la retraite',['寒い|さむい','日|ひ','は','スープ','が','一番|いちばん','です','。'],'Les jours froids, rien ne vaut une soupe.','一番 (いちばん) = le meilleur, numéro un',"De navet. Évidemment de navet. Ne pose pas la question."],
  ['fisher','Guide',['この','山|やま','は','高い|たかい','です','。'],'Cette montagne est haute.','高い (たかい) = haut',"Je la fais visiter. Les clients redescendent plus vite qu'ils ne montent. Parfois beaucoup plus vite."],
  ['yukiko','Enfant emmitouflé',['手|て','が','冷たい|つめたい','です','。'],'J\'ai les mains froides.','冷たい (つめたい) = froid au toucher',"J'ai trois paires de gants. Elles sont à la maison. Avec mes mains chaudes."]]};
 PORT.Colporteur='PX_peddler';PORT['Bûcheron']='PX_lumber';Object.assign(PORT,{'Pèlerine':'PX_pilgrim','Cheminot':'PX_rail','Soudeur':'PX_welder','Montagnard':'PX_mount','Vannier':'PX_weaver','Gamine':'PX_kidg','Vieille femme':'PX_oldw'});
 Object.assign(F,window.FOLKX||{});
 const cnt={};XNPC.forEach(n=>{const k=n.z+n.r,L=F[k]||[],G=n.r==='v'?F.v:[];const i=cnt[k]=(cnt[k]||0);cnt[k]++;
  let d;if(i<L.length)d=L[i];else if(G.length)d=G[(i-L.length+n.z*5)%G.length];else if(L.length)d=L[i%L.length];else return;
  if(!PORT[d[1]]&&IM['PX_'+d[0]])PORT[d[1]]='PX_'+d[0];
  /* les habits changent de couleur d'un habitant à l'autre */
  const cl=0;
  NPCS.world.push({id:'x'+k+i,spr:d[0],x:n.x,y:n.y,ev:'say',wander:n.r==='v'?1:0,dir:0,nm:d[1],jp:d[2],fr:d[3],xx:d[4],t2:d[5],cl})});
})();

/* ---------- mode test : se téléporter au début d'une zone, visiter sans combats ---------- */
const TestMode=(()=>{
 const G_=['kakashi','karakasa','smoke','toad','boss','yuki','nuri','umi','wanyudo','kyorin','baku','nue','yamabiko','ungai','kaze','tetsu'];
 /* [nom, gardiens déjà battus, position d'arrivée] */
 const gy=k=>(MAPS.world.gates.find(q=>q.need===k)||{y:0}).y,ham=z=>HAMS.find(h=>h.z===z);
 const Z=()=>[['Village de Kome',0,[9,OY+80]],['Route des rizières',0,[9,OY+70]],['Hameau des bambous',1,[9,ham(2).y1-1]],['Forêt de Kage',1,[9,ham(2).y0-2]],
  ['Quartier des ouvriers',2,[9,ham(3).y1-1]],['Avant-poste, quai 1',2,[9,ham(3).y0-2]],['Quartier des fumées',3,[9,ham(4).y1-1]],['Avant-poste, quai 2',3,[9,ham(4).y0-2]],
  ['Hameau des cendres',4,[9,ham(5).y1-1]],['Le vieux puits',4,[9,ham(5).y0-2]],['Acte II · Refuge du col',5,[9,ham(6).y1-1]],['Acte II · Col des Brumes',5,[9,ham(6).y0-2]],['Acte II · Relais de la Grand-Route',6,[9,ham(7).y1-1]],['Acte II · Grand-route de Kurogane',6,[9,ham(7).y0-2]],['Acte II · Bourg des passeurs',7,[9,ham(8).y1-1]],['Acte II · Grand Fleuve',7,[9,ham(8).y0-2]],['Acte II · Ville basse de Kurogane',8,[9,ham(9).y1-1]],['Acte II · Canaux des faubourgs',8,[9,ham(9).y0-2]],['Acte II · Quartier des étudiants',9,[9,ham(10).y1-1]],['Acte II · Jardins de l\'Académie',9,[9,ham(10).y0-2]],['Acte II · Cité ouvrière des Forges',10,[9,ham(11).y1-1]],['Acte II · Grandes Forges',10,[9,ham(11).y0-2]]].filter(()=>PART!==34).concat(PART===12?[]:[['Acte III · Port des dirigeables',11,[9,ham(12).y1-1]],['Acte III · Pontons des nuages',11,[9,ham(12).y0-2]],['Acte III · Envol en dirigeable',11,[15,ham(12).y0+12],'fly'],['Acte III · Village des renards',12,[9,ham(13).y1-2],'z13'],['Acte III · Forêt suspendue',12,[9,ham(13).y0-2],'z13'],['Acte III · Nacelle sur la chaîne',13,[9,ham(13).y0-30],'nac'],['Acte III · Jardins des horlogers',13,[9,ham(14).y1-2],'z14'],['Acte III · Terrasses des horloges',13,[9,ham(14).y0-2],'z14'],['Acte III · Croisée des quatre vents',14,[9,ham(15).y1-1],'z15'],['Acte III · Ligne du nord',14,[9,ham(15).y0-2],'z15'],['Acte III · Citadelle de Tetsu',15,[9,ham(16).y1-1],'z16'],['Acte III · Salle du trône',15,[9,ham(16).y0-50],'z16'],['Acte IV · Plage des naufragés',16,[ham(17)?ham(17).px-RX(ham(17).py+2):9,ham(17)?ham(17).py+2:0],'z17'],['Acte IV · Route côtière',16,[9,ham(17)?ham(17).y0-2:0],'z17'],['Acte IV · Ville impériale',17,[ham(18)?ham(18).px-RX(ham(18).py+2):9,ham(18)?ham(18).py+2:0],'z18'],['Acte IV · Faubourgs impériaux',17,[9,ham(18)?ham(18).y0-2:0],'z18'],['Acte IV · Monts des Tengu',17,[ham(19)?ham(19).px-RX(ham(19).py+4):9,ham(19)?ham(19).py+4:0],'z19'],['Acte IV · Route des gouffres',17,[27,ham(19)?ham(19).y0-2:0],'z19'],['Acte IV · Village des mineurs',18,[ham(20)?ham(20).px-RX(ham(20).py+4):9,ham(20)?ham(20).py+4:0],'z20'],['Acte IV · Galeries de la mine',18,[27,ham(20)?ham(20).y0-15:0],'z20'],['Acte IV · Cour de la cloche',19,[ham(21)?ham(21).px-RX(ham(21).py+4):9,ham(21)?ham(21).py+4:0],'z21'],['Acte IV · Devant le grand temple',19,[27,ham(21)?ham(21).y0-62:0],'z21']]);
 function html(){const on=!!S.fl.visit;
  return `<div class="sw" style="border:0;padding:14px 0 4px"><span style="color:var(--cy)">Mode test</span></div><p style="font-size:12px;color:var(--sub);margin:0 0 6px">Pour vérifier les décors et le scénario. À retirer avant la publication.</p>`+
   `<div class="sw"><span>Visite : sans combats ni épreuves</span><button data-tm="visit" class="${on?'on':''}">${on?'Oui':'Non'}</button></div>`+
   `<p style="font-size:12px;color:var(--sub);margin:6px 0 4px">Aller au début de :</p><div style="display:grid;grid-template-columns:1fr 1fr;gap:5px">`+Z().map((z,i)=>`<button data-tm="go${i}" class="btn" style="font-size:12px;padding:7px 4px">${esc(z[0])}</button>`).join('')+`</div>`}
 function act(a){
  if(a==='visit'){S.fl.visit=S.fl.visit?0:1;save();sfx('tap');UI.toast(S.fl.visit?'Visite : les ennemis t\'ignorent, les gardiens te laissent passer.':'Combats et épreuves réactivés.',2600);return false}
  const z=Z()[+a.slice(2)];if(!z)return false;
  S.fl.intro=1;S.fl.act1=1;S.fl.tu_intro=1;['tip_w','tip_ham','tip_road','tut_b','tut_p'].forEach(k=>S.fl[k]=1);
  ['人','土','火','木','水','風','雷'].forEach(k=>S.sp[k]=1);if(!S.les.l1)S.les.l1=1;
  G_.slice(0,z[1]).forEach(k=>S.wins[k]=1);S.hp=maxHp();
  const[x0,y]=z[2],x=x0+RX(y);S.pos={m:'world',x,y,d:1};S.heal={m:'world',x,y};save();W.load('world',x,y,1);W.H.cd=3;G.scene='world';W.refreshZone();sfx('door');UI.toast('Arrivée : '+z[0],2200);if(z[3]==='fly'&&window.Act3){S.fl.act3c=1;S.wins.nue=1;save();setTimeout(()=>W.ev(()=>Act3.fly()),900)}if((z[3]==='z13'||z[3]==='nac')&&window.Act3){Object.assign(S.fl,{act3c:1,fly12:1,crash13:1,reun13:1});S.wins.nue=1;save()}if(z[3]==='z14'&&window.Act3){Object.assign(S.fl,{act3c:1,fly12:1,crash13:1,reun13:1,nac13:1,arr14:1});S.wins.nue=1;S.wins.yamabiko=1;save()}if(z[3]==='z15'&&window.Act3){Object.assign(S.fl,{act3c:1,fly12:1,crash13:1,reun13:1,nac13:1,arr14:1,arr15:1});S.wins.nue=1;S.wins.yamabiko=1;S.wins.ungai=1;save()}if(z[3]==='z17'&&window.Act4){Object.assign(S.fl,{act3c:1,fly12:1,crash13:1,reun13:1,nac13:1,arr14:1,arr15:1,arr16:1,hana16:1,tp1:1,act3done:1,a4wake:1});['nue','yamabiko','ungai','kaze','tetsu'].forEach(k=>S.wins[k]=1);save()}if(z[3]==='z21'&&window.Act4){Object.assign(S.fl,{act3c:1,fly12:1,crash13:1,reun13:1,nac13:1,arr14:1,arr15:1,arr16:1,hana16:1,tp1:1,act3done:1,a4wake:1,arr18:1,ac18:1,soon18:1,arr19:1,fly19:1,arr20:1,ride20:1,arr21:1});['nue','yamabiko','ungai','kaze','tetsu','ushioni','kinko','daitengu','mukade'].forEach(k=>S.wins[k]=1);save()}if(z[3]==='z20'&&window.Act4){Object.assign(S.fl,{act3c:1,fly12:1,crash13:1,reun13:1,nac13:1,arr14:1,arr15:1,arr16:1,hana16:1,tp1:1,act3done:1,a4wake:1,arr18:1,ac18:1,soon18:1,arr19:1,fly19:1,arr20:1});['nue','yamabiko','ungai','kaze','tetsu','ushioni','kinko','daitengu'].forEach(k=>S.wins[k]=1);save()}if(z[3]==='z19'&&window.Act4){Object.assign(S.fl,{act3c:1,fly12:1,crash13:1,reun13:1,nac13:1,arr14:1,arr15:1,arr16:1,hana16:1,tp1:1,act3done:1,a4wake:1,arr18:1,ac18:1,soon18:1,arr19:1});['nue','yamabiko','ungai','kaze','tetsu','ushioni','kinko'].forEach(k=>S.wins[k]=1);save()}if(z[3]==='z16'&&window.Act3){Object.assign(S.fl,{act3c:1,fly12:1,crash13:1,reun13:1,nac13:1,arr14:1,arr15:1,arr16:1});S.wins.nue=1;S.wins.yamabiko=1;S.wins.ungai=1;S.wins.kaze=1;save()}if(z[3]==='nac'&&window.Act3&&Act3.nacelle){S.wins.yamabiko=1;save();setTimeout(()=>W.ev(()=>Act3.nacelle()),900)}return true}
 return{html,act}})();
/* en visite : parler à un gardien propose de passer sans combattre */
(()=>{const o=STORY.guard;STORY.guard=async(e,seen)=>{if(!S.fl.visit||e.rov)return S.fl.visit&&e.rov?D.say('(Visite) Cet ennemi t\'ignore.'):o(e,seen);
  const i=await D.ask({t:`(Visite) ${EN[e.id].n} : que fais-tu ?`},['Passer sans combattre','Combattre quand même','Rien']);
  if(i===0){S.wins[e.id]=1;W.remove(e);save();W.refreshZone();await D.say('Le gardien s\'écarte. La barrière est ouverte.')}else if(i===1)return o(e,seen)};
 const ow=STORY.well;STORY.well=async e=>{if(!S.fl.visit||S.wins.boss||!S.wins.toad)return ow(e);
  const i=await D.ask({t:'(Visite) Le démon du puits : que fais-tu ?'},['Passer sans combattre','Combattre quand même','Rien']);if(i===0){S.wins.boss=1;save();W.refreshZone();await D.say('Le puits se tait. La barrière du nord est ouverte.')}else if(i===1)return ow(e)};
 const ot=STORY.triggers;STORY.triggers=(x,y)=>{if(S.fl.visit&&y<=Y5+8&&y>=Y5+2&&x<=13&&W.zone()===5&&!S.wins.boss)return null;return ot(x,y)}})();

/* ---------- carton d'acte : engrenage de laiton, titre cyan ---------- */
const ActCard=(()=>{
 const css=document.createElement('style');css.textContent=`
#actc{position:absolute;inset:0;z-index:80;display:grid;place-items:center;background:radial-gradient(circle at 50% 45%,#1f2644 0%,#0b0e1c 75%);opacity:0;transition:opacity .9s;overflow:hidden}
#actc.on{opacity:1}
#actc .gw{position:relative;width:min(78vw,340px);aspect-ratio:1;display:grid;place-items:center}
#actc svg{position:absolute;inset:0;width:100%;height:100%}
#actc .g1{animation:actspin 26s linear infinite;transform-origin:50% 50%}
#actc .g2{animation:actspin 17s linear infinite reverse;transform-origin:50% 50%;opacity:.3}
@keyframes actspin{to{transform:rotate(360deg)}}
#actc .tx{position:relative;text-align:center;transform:scale(.7);opacity:0;transition:transform 1.4s cubic-bezier(.2,.9,.3,1) .5s,opacity 1.1s .5s}
#actc.on .tx{transform:none;opacity:1}
#actc .jp{font-family:'Kaisei Decol',serif;font-weight:700;font-size:clamp(46px,15vw,70px);line-height:1.05;color:#eaffff;text-shadow:0 0 6px #fff,0 0 18px #58e0ec,0 0 42px rgba(88,224,236,.9),0 3px 0 #0e4458;animation:actglow 2.6s ease-in-out infinite}
@keyframes actglow{50%{text-shadow:0 0 8px #fff,0 0 28px #58e0ec,0 0 62px rgba(88,224,236,1),0 3px 0 #0e4458}}
#actc .fr{font-family:'Cinzel',serif;font-size:clamp(15px,4.6vw,21px);letter-spacing:.34em;margin-top:10px;background:linear-gradient(180deg,#fff0b8,#f0cf7a 45%,#a87a2a);-webkit-background-clip:text;background-clip:text;color:transparent;filter:drop-shadow(0 2px 0 #3a2608)}
#actc .sub{font-family:'Kaisei Decol',serif;font-size:clamp(14px,4vw,18px);color:#cfd6ee;margin-top:8px;letter-spacing:.08em}
#actc .ln{width:0;height:2px;margin:12px auto 0;background:linear-gradient(90deg,transparent,#58e0ec,transparent);box-shadow:0 0 10px #58e0ec;transition:width 1.6s 1s}
#actc.on .ln{width:78%}
#actc i{position:absolute;width:3px;height:3px;border-radius:50%;background:#9af4fa;box-shadow:0 0 6px #58e0ec;animation:actp 3.4s linear infinite;opacity:0}
@keyframes actp{0%{opacity:0;transform:translateY(0)}20%{opacity:.9}100%{opacity:0;transform:translateY(-90px)}}
@media (prefers-reduced-motion:reduce){#actc .g1,#actc .g2,#actc .jp,#actc i{animation:none}}`;document.head.appendChild(css);
 const gear=(r,n,tw,cls,sw)=>{let d='';for(let i=0;i<n;i++){const a=i/n*Math.PI*2,p=(q,rr)=>`${(100+Math.cos(a+q)*rr).toFixed(1)},${(100+Math.sin(a+q)*rr).toFixed(1)}`;d+=`<polygon points="${p(-tw,r)} ${p(-tw*.6,r+9)} ${p(tw*.6,r+9)} ${p(tw,r)}"/>`}
  return `<g class="${cls}" fill="url(#actb)"><g>${d}</g><circle cx="100" cy="100" r="${r}" fill="none" stroke="url(#actb)" stroke-width="${sw}"/><circle cx="100" cy="100" r="${r-sw-3}" fill="none" stroke="#7a5420" stroke-width="1.5"/></g>`};
 function show(jp,fr,sub){return new Promise(res=>{const host=$('#scrw')?$('#app'):document.body,e=document.createElement('div');e.id='actc';
  let parts='';for(let i=0;i<14;i++)parts+=`<i style="left:${8+Math.random()*84}%;top:${45+Math.random()*45}%;animation-delay:${(Math.random()*3).toFixed(2)}s"></i>`;
  e.innerHTML=`<div class="gw"><svg viewBox="0 0 200 200" aria-hidden="true"><defs><linearGradient id="actb" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#fff0b8"/><stop offset=".45" stop-color="#c8973a"/><stop offset="1" stop-color="#7a5420"/></linearGradient></defs>${IM.UI_GEAR1?'':gear(84,18,.085,'g1',7)+gear(66,12,.11,'g2',3)}</svg>${IM.UI_GEAR1?`<img class="g1 gi" src="${IM.UI_GEAR1}" alt=""><img class="g2 gi gs" src="${IM.UI_GEAR2||IM.UI_GEAR1}" alt=""><img class="g2 gi gt" src="${IM.UI_GEAR2||IM.UI_GEAR1}" alt="">`:''}<div class="tx"><div class="jp">${esc(jp)}</div><div class="fr">${esc(fr)}</div><div class="sub">${esc(sub)}</div><div class="ln"></div></div></div>${parts}`;
  host.appendChild(e);void e.offsetWidth;e.classList.add('on');try{sfx('evo')}catch(x){}
  let done=false;const end=()=>{if(done)return;done=true;e.classList.remove('on');setTimeout(()=>{e.remove();res()},950)};
  setTimeout(()=>{e.onclick=end},1400);setTimeout(end,5200)})}
 return{show}})();
(()=>{const o=STORY.triggers;STORY.triggers=(x,y)=>{if(S.fl.act1&&!S.fl.act2c&&W.zone()===6)return async()=>{S.fl.act2c=1;save();music(null);await More.actEnd(1);await ActCard.show('第二幕','ACTE II','L\'Apprenti');W.refreshZone()};return o(x,y)}})();

/* ---------- acte II : auberges payantes, étals à prix parlés, intérieurs et maîtres selon le bourg ---------- */
(()=>{
 const J=(n,jp,fr,x)=>({n,jp,fr,x}),T_=(n,t)=>({n,t}),zr=()=>MAPS.world.zone((S.ret||{y:1e9}).y),has=k=>XI[k]&&XI[k].width>0;
 Object.assign(PORT,{'Aubergiste':'PX_okami','Garde du relais':'PX_sekiban','Vieux passeur':'PX_sendo','Poissonnière':'PX_fishw','Lavandière':'PX_sentaku','Fille du postier':'PX_kidg','Bûcheron':'PX_lumber','Enfant emmitouflé':'PX_yukiko',
  'Yuki-onna mécanique':'PX_gyuki','Grand Nurikabe douanier':'PX_gnuri','Umibōzu de vapeur':'PX_gumi','Wanyūdō contrôleur':'PX_gwanyudo','Cantinière':'PX_shokudo','Fondeur':'PX_imoji','Caissière':'PX_kaikei','Petit porteur':'PX_sekitan','Vieux maître-forgeron':'PX_toko','Kyōrinrin, l\'examinateur':'PX_gkyorin','Intendante du dortoir':'PX_ryobo','Vieux bibliothécaire':'PX_shisho','Imprimeuse':'PX_insatsu','Petite calligraphe':'PX_shodo','Étudiant':'PX_gakusei','Tenancière des bains':'PX_bandai','Tireur de pousse-pousse':'PX_shafu','Cuisinière de nuit':'PX_yatai','Agent de ville':'PX_junsa','Petit crieur':'PX_shinbun'});
 Object.defineProperty(PORT,'Maître Kotoba',{get:()=>{const z=G.scene==='world'&&W.map==='world'?W.zone():zr();return has('C_kotoba'+z+'_00')?'PX_kotoba'+z:'PX_kotoba'},configurable:true});
 /* le dojo des mots change de teinte et de maître selon le bourg ; l'auberge change d'hôte, de nom et de musique */
 Object.defineProperty(MAPS.keiko,'tint',{get:()=>({5:'ash',6:'cool',7:'warm',8:'moss',9:'warm',10:'',11:'warm',12:'cool',13:'moss',14:'',15:'',16:'ink',17:'',18:'warm'})[zr()]||'ink',configurable:true});
 Object.defineProperty(NPCS.keiko[0],'spr',{get:()=>has('C_kotoba'+zr()+'_00')?'kotoba'+zr():'kotoba',enumerable:true,configurable:true});
 Object.defineProperty(NPCS.refuge[0],'spr',{get:()=>({7:'okami',8:'sendo',9:'bandai',10:'ryobo',11:'shokudo',12:'eki',13:'messa',14:'karak',15:'furin',16:'kagi',17:'fishw',18:'okayu'})[zr()]||'yado',enumerable:true,configurable:true});
 Object.defineProperty(MAPS.refuge,'name',{get:()=>({7:['宿|やど','L\'auberge du relais'],8:['船頭|せんどう','Chez le passeur'],9:['銭湯|せんとう','Le bain public'],10:['寮|りょう','Le dortoir des étudiants'],11:['食堂|しょくどう','La cantine des ouvriers'],12:['待合室|まちあいしつ','La salle d\'attente du port'],13:['茶屋|ちゃや','La maison de thé des feuilles'],14:['茶室|ちゃしつ','La maison de thé des jardins'],15:['客車|きゃくしゃ','Le wagon-auberge'],16:['兵舎|へいしゃ','L\'ancienne caserne'],17:['海の家|うみのいえ','La maison de la plage'],18:['宿|やど','L\'auberge impériale']})[zr()]||['山小屋|やまごや','Le refuge du col'],configurable:true});
 Object.defineProperty(MAPS.refuge,'music',{get:()=>({7:'kaido',8:'kawa',9:ZONES[9].mus,10:'gakuin',11:ZONES[11].mus,12:'port',13:'foret',14:'gakuin',15:'kaido',16:'factory',17:'port',18:'gakuin'})[zr()]||'col',configurable:true});
 Object.defineProperty(MAPS.refuge,'tint',{get:()=>({8:'cool'})[zr()]||'warm',configurable:true});
 /* --- maisons des villages : on peut entrer, quelqu'un y vit --- */
 MAPS.maison={w:12,h:9,inside:1,zi:1,rows:['HHHHHHHHHHHH','h1hRhgghqu2h','nnnnnnnnnnnn','pmmmmmmmmmmn','nmzmyymmzmmn','nmmmmmmmmmmp','nnnnnnnnnnnn','nnnnnnnnnnnn','     d      '],zone:()=>99,warps:[{x:5,y:8,to:'world',ret:1}]};
 Object.defineProperty(MAPS.maison,'tint',{get:()=>({3:'ink',4:'ink'})[zr()]||'',configurable:true});
 Object.defineProperty(MAPS.maison,'music',{get:()=>(ZONES[zr()]||ZONES[0]).mus,configurable:true});
 Object.defineProperty(MAPS.maison,'name',{get:()=>['家|いえ','Une maison'],configurable:true});
 /* [sprite, nom, phrase, traduction, explication, remarque] — deux habitants possibles par bourg */
 const RES={2:[['baa','Grand-mère',['お茶|おちゃ','を','飲みません|のみません','か','。'],'Tu ne veux pas un thé ?','〜ませんか = une invitation polie',"Assieds-toi. Pas là, c'est la place du chat. Là non plus, c'est son autre place."],
   ['weaver','Vannier',['毎日|まいにち','、','かご','を','作ります|つくります','。'],'Je fabrique des paniers tous les jours.','かご = panier · 作ります (つくります) = fabriquer',"En bambou. Tout est en bambou, ici. Même ma patience."]],
  3:[['worker','Ouvrier de nuit',['今|いま','、','寝て|ねて','います','。'],'Là, je dors.','〜ています = être en train de',"Je travaille la nuit. Tu es entré chez un homme qui dort. On en reparlera quand je serai réveillé, c'est-à-dire jamais."],
   ['kid','Écolier',['宿題|しゅくだい','が','たくさん','あります','。'],'J\'ai beaucoup de devoirs.','宿題 (しゅくだい) = devoirs',"C'est de la conjugaison. Tu veux les faire ? Non ? Personne ne veut jamais."]],
  4:[['welder','Soudeur',['この','家|いえ','は','うるさい','です','。'],'Cette maison est bruyante.','うるさい = bruyant',"L'usine est derrière le mur. Je ne l'entends plus. Je n'entends plus grand-chose, remarque."],
   ['girl','Couturière',['服|ふく','が','黒く|くろく','なりました','。'],'Les vêtements sont devenus noirs.','〜くなります = devenir (avec un adjectif en い)',"Je lave du blanc, j'étends du gris, je range du noir. C'est la suie. On s'y fait."]],
  5:[['jii','Dernier habitant',['ここ','に','残ります|のこります','。'],'Je reste ici.','残ります (のこります) = rester',"Tout le monde est parti. Moi, j'ai un toit. Enfin, la moitié. C'est la bonne moitié."],
   ['oldw','Vieille femme',['むかし','、','ここ','に','花|はな','が','ありました','。'],'Autrefois, il y avait des fleurs ici.','ありました = le passé de あります',"J'en ai replanté une. Elle a pris feu. J'en replanterai une autre : je suis plus têtue que le volcan."]],
  6:[['mount','Montagnard',['外|そと','は','寒い|さむい','です','よ','。'],'Il fait froid dehors, tu sais.','よ = « tu sais », pour insister',"Ferme la porte. Non, plus vite. Voilà : tu as fait entrer l'hiver."],
   ['sentaku','Lavandière',['火|ひ','の','そば','に','座って|すわって','ください','。'],'Assieds-toi près du feu.','そば = à côté de',"Pas trop près. Le dernier voyageur a séché si vite qu'il a rétréci."]],
  7:[['weaver','Vendeuse de sandales',['旅|たび','は','楽しい|たのしい','です','か','。'],'Le voyage te plaît ?','旅 (たび) = voyage · 楽しい (たのしい) = agréable',"Moi, je n'ai jamais quitté le relais. Je regarde passer les gens. C'est du voyage immobile, ça use moins les sandales."],
   ['peddler','Marchand au repos',['今日|きょう','は','休み|やすみ','です','。'],'Aujourd\'hui, c\'est repos.','休み (やすみ) = repos, congé',"Ne touche pas aux malles. Elles sont comptées. Deux fois. Par moi et par ma femme, et on ne trouve jamais pareil."]],
  16:[['kikai','Soldat sans nom',['ぼく','の','名前|なまえ','は','何|なん','です','か','。'],'Mon nom, c\'est quoi ?','名前 (なまえ) = nom',"On m'a remonté avec une clé, on m'a donné une lance, on a oublié de me donner un nom. J'ai une étiquette, regarde : elle est vide. Tu peux écrire dessus, si tu veux. Un joli nom. Pas « Lance »."],
   ['kagi','Kagi le geôlier',['お茶|おちゃ','は','いかが','です','か','。'],'Un peu de thé ?','いかがですか = « que diriez-vous de… ? », très poli',"J'ai les clés de toutes les cellules. Je n'ai jamais ouvert la bonne. Ce soir, peut-être. Si quelqu'un me le demande poliment. En japonais."]],
 15:[['kazami','Kazami',['風|かぜ','は','どこ','から','来ます|きます','か','。'],'Le vent, il vient d\'où ?','から = depuis · 来ます (きます) = venir',"Grand-mère Fūrin dit qu'il vient des quatre côtés à la fois, depuis que Tetsu a pris le mot « chemin ». Mes girouettes tournent tellement vite qu'elles font du thé."],
   ['gonta','Gonta le cheminot',['ここ','で','休んで|やすんで','ください','。'],'Repose-toi ici.','休みます (やすみます) = se reposer',"Pose ton sabre, je pose mon rail. Voilà. Deux hommes qui ne portent rien. C'est ça, le luxe."]],
 14:[['jardin','Moine jardinier',['この','木|き','は','百年|ひゃくねん','です','。'],'Cet arbre a cent ans.','百年 (ひゃくねん) = cent ans',"Ou dix minutes. Depuis que l'heure a disparu, je ne sais plus. Il pousse quand même. Les arbres se fichent de Tetsu."],
   ['karak','Karakuri-san',['お茶|おちゃ','を','どうぞ','。'],'Voici du thé.','どうぞ = je vous en prie',"Je sers du thé depuis cent quarante ans. Personne ne m'a jamais dit d'arrêter. Personne ne m'a jamais dit merci non plus. Vous pouvez essayer, si vous voulez."]],
  13:[['mtanu','Madame Tanuki',['夫|おっと','は','いつも','遅い|おそい','です','。'],'Mon mari est toujours en retard.','夫 (おっと) = mon mari · 遅い (おそい) = en retard',"Trois ans pour aller chercher du saké. Il est revenu sans le saké. Avec un garçon, un démon et une forgeronne. Je ne sais pas si c'est mieux ou pire."],
   ['pon','Pon',['お父さん|おとうさん','は','先生|せんせい','です','か','。'],'Mon papa, il est professeur ?','お父さん (おとうさん) = papa',"Maman dit qu'il enseigne la sieste. Moi je veux apprendre à me transformer en dirigeable. Papa dit que c'est la même chose."]],
  12:[['oldw','Femme de pilote',['夫|おっと','は','空|そら','に','います','。'],'Mon mari est dans le ciel.','夫 (おっと) = mon mari · 空 (そら) = ciel',"Non, il n'est pas mort. Il est coincé là-haut depuis trois semaines, dans un dirigeable qui n'a plus de mots pour atterrir. Il m'envoie des lettres par les mouettes. Elles arrivent mangées."],
   ['kid','Petit mousse',['大きく|おおきく','なったら','、','パイロット','に','なります','！'],'Quand je serai grand, je serai pilote !','〜になります = devenir',"Pour l'instant, je nettoie les hublots. Par l'extérieur. En plein vol. Ma mère ne le sait pas, alors chut."]],
  11:[['toko','Vieux maître-forgeron',['むかし','、','刀|かたな','を','作りました|つくりました','。'],'Autrefois, je fabriquais des sabres.','刀 (かたな) = sabre',"Un par mois. Maintenant ils font mille tuyaux par jour. Hagane est la seule qui prend encore son temps. Elle dit qu'elle est pressée, mais regarde ses lames : elle ment."],
   ['kaikei','Caissière',['一万|いちまん','円|えん','、','足りません|たりません','。'],'Il manque dix mille yens.','足りません (たりません) = ne suffit pas',"Tous les soirs, il manque dix mille yens dans la caisse. Tous les matins, ils sont revenus. Je ne dors plus. Il y a une boule dorée qui rit sous mon lit."]],
  10:[['shisho','Vieux bibliothécaire',['本|ほん','を','返して|かえして','ください','。'],'Rendez les livres, s\'il vous plaît.','返します (かえします) = rendre',"Hein ? Parlez dans le cornet. Non, vous ne m'avez rien emprunté. Mais ça finit toujours par arriver, alors je prends de l'avance."],
   ['insatsu','Imprimeuse',['友達|ともだち','に','本|ほん','を','貸しました|かしました','。'],'J\'ai prêté un livre à une amie.','貸します (かします) = prêter',"C'était le premier que j'imprimais. Il y avait une faute à chaque page. Elle dit que c'est son préféré : on ne s'ennuie jamais."]],
  9:[['shafu','Tireur de pousse-pousse',['足|あし','が','痛い|いたい','です','。'],"J'ai mal aux jambes.",'痛い (いたい) = douloureux',"On m'a mis un moteur à vapeur sur le pousse-pousse. Maintenant c'est lui qui tire, et c'est moi qui cours derrière pour le rattraper."],
   ['yatai','Cuisinière de nuit',['そば','を','食べません|たべません','か','。'],'Tu ne veux pas manger des nouilles ?','〜ませんか = une invitation polie',"Je cuisine la nuit. Ici, ça veut dire tout le temps. Je n'ai pas fermé depuis onze ans. Assieds-toi, tu es maigre."]],
  8:[['fishw','Poissonnière',['魚|さかな','を','焼いて|やいて','います','。'],'Je fais griller du poisson.','焼きます (やきます) = griller',"Tu sens ? Non ? C'est que tu es enrhumé. Tout le bourg sent comme ça."],
   ['oldw','Veuve de passeur',['川|かわ','の','音|おと','が','聞こえます|きこえます','。'],'On entend le bruit du fleuve.','聞こえます (きこえます) = s\'entendre',"Jour et nuit. Mon mari disait que ça berce. Mon mari dormait n'importe où."]]};
 const res=()=>{const r=S.ret||{x:0,y:0},L=RES[zr()]||RES[2];return L[(r.x+r.y)%L.length]};
 const R0={id:'resident',x:6,y:2,ev:'resident',dir:0};['spr','nm','jp','fr','xx','t2'].forEach((k,i)=>Object.defineProperty(R0,k,{get:()=>res()[i],enumerable:true}));
 NPCS.maison=[R0];
 STORY.resident=async e=>{await D.say([J(e.nm,e.jp,e.frT!=null?e.frT:e.fr,e.xx),{n:e.nm,t:e.t2}]);const r=S.ret||{x:0,y:0},k='hs'+r.x+'_'+r.y;
  if(!S.fl[k]){S.fl[k]=1;const n=Object.keys(S.fl).filter(f=>f.startsWith('hs')).length;if(n%3===0){S.it.cha=(S.it.cha||0)+1;sfx('item');await D.say('En partant, on te glisse un お茶 (thé vert) dans la main. Les gens d\'ici sont comme ça.')}save()}};
 /* nombres de 10 à 99, avec lecture */
 const U=['','一|いち','二|に','三|さん','四|よん','五|ご','六|ろく','七|なな','八|はち','九|きゅう'];
 const NUM=n=>{const t=Math.floor(n/10),u=n%10,a=(t>1?U[t]:'|').split('|'),b=(u?U[u]:'|').split('|');return a[0]+(t?'十':'')+b[0]+'|'+a[1]+(t?'じゅう':'')+b[1]};
 /* --- auberges du relais et du fleuve : la nuit se paie --- */
 const oInn=STORY.inn;STORY.inn=async e=>{const z=zr();if(z<7||z>16)return oInn(e);
  const n=z===16?'Kagi le geôlier':z===15?'Grand-mère Fūrin':z===14?'Karakuri-san':z===13?'Hôtesse renarde':z===12?'Vendeuse d\'ekiben':z===11?'Cantinière':z===10?'Intendante du dortoir':z===9?'Tenancière des bains':z===7?'Aubergiste':'Vieux passeur',price=z===16?64:z===15?62:z===14?60:z===13?58:z===12?55:z===11?50:z===10?45:z===9?40:z===7?30:35;
  await D.say(J(n,['いらっしゃいませ','。','一泊|いっぱく',NUM(price),'円|えん','です','。'],`Bienvenue. C'est ${price} mon la nuit.`,'一泊 (いっぱく) = une nuit · 文 (もん) : la monnaie du pays'));
  const i=await D.ask({n,jp:['泊まります|とまります','か','。'],fr:'Tu restes pour la nuit ?'},[{jp:['はい','、','お願い|おねがい','します','。'],fr:`Oui · ${price} 円 (tu as ${S.gold||0} 円)`},{jp:['いいえ','、','けっこう','です','。'],fr:'Non merci'}]);
  if(i!==0){await D.say({n,t:z===16?'Comme tu veux. Mais ne dors pas dans les couloirs : les scarabées découpent tout ce qui ne bouge pas.':z===15?'Comme tu veux. Écoute les clochettes en partant : elles te diront d\'où souffle le vent. Moi, je ne peux plus, je ne connais plus le mot.':z===14?'Comme vous voudrez. Le thé sera servi quand même. Je suis remontée pour ça.':z===13?'Comme tu veux. Mais la forêt est froide la nuit, et les renards farceurs adorent les dormeurs.':z===12?'Comme tu veux. Mais prends au moins un bentō : on ne sait jamais quand le prochain dirigeable partira.':z===11?'Comme tu veux. Mais repasse manger : tu as une tête à sauter des repas.':z===10?'Comme tu veux. Extinction des feux à neuf heures, que tu dormes ici ou non.':z===9?'Comme tu veux. Mais tu sens la route, je te le dis avec affection.':z===7?'Comme tu voudras. La route est longue, et les automates ne dorment pas, eux.':'À ta guise. La berge est gratuite. Humide, mais gratuite.'});return}
  const poor=(S.gold||0)<price;
  if(poor)await D.say([J(n,['お金|おかね','が','足りません|たりません','ね','。'],'Tu n\'as pas assez d\'argent, hein.','足りません (たりません) = « ne suffit pas »'),{n,t:z===16?'Pas d\'argent ? Il reste une cellule vide. Je laisse la porte ouverte, promis. Enfin, je crois que c\'est la bonne clé.':z===15?'Pas d\'argent ? Dors dans le fourgon de queue, alors. Il n\'a plus de locomotive, il n\'ira nulle part : c\'est le lit le plus sûr de la croisée.':z===14?'Pas d\'argent ? Mon programme ne prévoit pas ce cas. Je vais donc faire comme s\'il était l\'heure de dormir. Ici, il est toujours l\'heure de quelque chose.':z===13?'Pas un sou ? Les tanuki paient en feuilles, ici. Bon. Je vais faire comme si cette feuille de chêne était une pièce. Ne le dis à personne.':z===12?'Pas un sou ? Bon. Il reste le banc du fond, sous le tableau des départs. Il n\'y a aucun départ, tu dormiras tranquille.':z===11?'Pas un sou ? Alors tu fais la plonge. Non, je plaisante. Assieds-toi, mange, et dors sur le banc près du four.':z===10?'Pas d\'argent ? Comme tous mes étudiants. Prends le lit du fond : son occupant est en retenue jusqu\'à jeudi.':z===9?'Bon. Tu peux dormir dans la chaufferie. C\'est chaud, c\'est gratuit, et la chaudière ne ronfle presque pas.':z===7?'Bon. Il reste la remise à bois. C\'est gratuit, ça sent le cèdre, et le chat y dort déjà. Ne le dérange pas.':'Bah. Dors dans la barque retournée. C\'est ce que je fais quand ma femme est fâchée.'}]);
  else S.gold-=price;
  await UI.fade(1,300);sfx('heal');S.hp=maxHp();ROVD.clear();{const r=S.ret||{x:9,y:OY+78};S.heal={m:'world',x:r.x,y:r.y}}save();await wait(700);await UI.fade(0,300);
  await D.say([{n,t:z===16?(poor?'Tu as dormi dans une cellule, la porte entrouverte. Kagi a monté la garde devant toute la nuit, une tasse à la main, pour que personne ne la referme.':'Un vrai lit de caserne, une couverture de laine, et Kagi qui chantonne une berceuse de prisonnier en essuyant ses tasses. Tu dors comme une pierre.'):z===15?(poor?'Le fourgon grinçait à chaque rafale. Tu as rêvé que tu partais vers le nord, puis vers le sud, puis vers les deux. Tu te réveilles un peu étourdi, mais reposé.':'Une couchette de wagon, une couverture épaisse et cent clochettes qui chantent dans le vent. Grand-mère Fūrin t\'a laissé une tasse de thé encore chaude.'):z===14?(poor?'Tu as dormi sur un coussin, sous une horloge qui sonnait toutes les sept minutes. Karakuri-san t\'a réveillé quarante-deux fois pour te servir du thé.':'Un futon sous la verrière, le tic-tac de cent horloges, et un thé parfait servi à une heure que personne ne connaît. Tu te sens neuf.'):z===13?(poor?'Tu as dormi dans un coin, sur un lit de mousse. Au réveil, quelqu\'un t\'avait dessiné des moustaches de renard. Elles partent au lavage.':'Une soupe de châtaignes, un futon de feuilles, et le chant des grillons. Au réveil, une petite renarde t\'avait laissé une fleur sur l\'oreiller.'):z===12?(poor?'Le banc était étroit. Tu t\'es réveillé avec l\'horaire du vol de 1897 imprimé sur la joue. On t\'a quand même laissé un onigiri.':'Un bentō au saumon, une couverture de laine, et le vent qui chante dans les haubans toute la nuit. Tu repars le ventre plein.'):z===11?(poor?'Le banc était dur et le four ronflait. Tu as quand même eu droit à trois bols de riz.':'Trois bols de riz, un lit à l\'étage, et la sirène de l\'équipe du matin à cinq heures. Tu es en pleine forme, de force.'):z===10?(poor?'Le lit du fond grinçait. Son propriétaire aussi : il est rentré à minuit et a dormi par terre sans rien dire.':'Tu as dormi dans un vrai futon. On t\'a réveillé au claquoir à six heures. C\'est compris dans le prix.'):z===9?(poor?'La chaudière a ronflé. Tu as dormi quand même, et tu ressors un peu cuit.':'Tu as trempé une heure dans l\'eau chaude. Tu ne sais plus très bien qui tu es, mais tu es propre.'):z===7?(poor?'Le chat a pris toute la place. Tu as dormi quand même.':'Le bain était chaud et le futon presque sec. À ce prix-là, c\'est un palace.'):(poor?'La barque fuyait. Par le haut, donc ça ne compte pas.':'Tu as dormi au bruit de l\'eau. Et du passeur, qui ronfle comme une roue à aubes.')},'Tes PV sont restaurés et ta partie est sauvegardée. Si tu tombes au combat, tu reviendras devant cette porte.'])};
 /* --- étals de l'acte II : le prix est annoncé en japonais, à toi de le comprendre --- */
 const PR={6:{oni:24,cha:16},7:{oni:28,cha:18},8:{oni:32,cha:21},9:{oni:36,cha:24},10:{oni:38,cha:26},11:{oni:41,cha:27},12:{oni:44,cha:29},13:{oni:46,cha:31},14:{oni:48,cha:33},15:{oni:50,cha:34},16:{oni:52,cha:35}},NB=[['一つ|ひとつ',1],['二つ|ふたつ',2],['三つ|みっつ',3]];
 const oShop=STORY.shop;STORY.shop=async e=>{const z=e&&e.id?+String(e.id).replace('shop',''):0,n='Marchande';if(!PR[z])return oShop(e);
  await D.say({n,jp:['いらっしゃいませ','！'],fr:'Bienvenue !'});
  if(!S.fl.shop2){S.fl.shop2=1;await D.say({n,t:'Par ici, on annonce les prix à voix haute et on ne répète pas. Si tu comprends du premier coup, je te fais une petite remise. Si tu te trompes, tu paies le prix fort. C\'est l\'école de la grand-route.'})}
  for(;;){const i=await D.ask({n,t:`Tu as ${S.gold||0} 円 (yen). Que veux-tu demander ?`},[{jp:['おにぎり','は','いくら','です','か','。'],fr:'Combien coûte l\'onigiri ?'},{jp:['お茶|おちゃ','は','いくら','です','か','。'],fr:'Combien coûte le thé ?'},{jp:['けっこう','です','。'],fr:'Non merci.'}]);
   if(i>1){await D.say({n,jp:['また','どうぞ','！'],fr:'Revenez quand vous voulez !'});return}
   const k=i?'cha':'oni',p=PR[z][k],sw=(p%10)*10+Math.floor(p/10),opts=shuf([p,sw!==p&&sw>9?sw:p+10,p-4]);
   const a=await D.ask({n,jp:[NUM(p),'円|えん','です','。'],fr:'(Combien a-t-elle dit ?)'},opts.map(v=>`${v} 円`));
   const ok=opts[a]===p,unit=ok?p-3:p;
   await D.say({n,t:ok?`Bonne oreille. ${p} mon, et pour toi ce sera ${unit}.`:`Non : ${p} mon. Et sans remise, ça t'apprendra à écouter.`});
   const j=await D.ask({n,t:'Combien en veux-tu ?'},NB.map(b=>`${b[1]} (${b[1]*unit} 円)`).concat([{jp:['やめます','。'],fr:'Finalement, non.'}]));
   if(j>2)continue;const q=NB[j][1],c=Math.round(q*unit*(await ShopTalk(k,q,n)));if((S.gold||0)<c){await D.say({n,jp:['お金|おかね','が','足りません|たりません','よ','。'],fr:'Tu n\'as pas assez d\'argent.',x:'足りません (たりません) = « ne suffit pas »'});continue}
   S.gold-=c;S.it[k]=(S.it[k]||0)+q;sfx('item');save();await D.say({n,jp:['ありがとう','ございます','！'],fr:`Merci beaucoup ! (+${q} ${IT[k].n.toLowerCase()})`})}};
})();

/* ---------- qui enseigne quoi : Tanuki (grammaire, phrases), Kotoba (oreille, voix), la forge (kanji) ---------- */
(()=>{
 const J=(n,jp,fr,x)=>({n,jp,fr,x}),T_=(n,t)=>({n,t}),KG='影',TN=NPN.tanu,YN2=[{jp:['はい','！'],fr:'Oui, allons-y'},{jp:['あとで','。'],fr:'Plus tard'}];
 /* deux leçons par bourg : l1-l2 à Kome, puis Tanuki donne la suite, bourg après bourg (zone 99 = bourgs à venir) */
 const LZ={l3:2,l4:2,l5:3,l6:3,l7:4,l8:4,l9:5,l10:5,l11:6,l12:6,l13:7,l14:7,l16:8,l18:8,l19:9,l20:9,l21:10,l22:10,l23:11,l24:11,l25:12,l26:12,l27:13,l28:13,l29:14,l30:14,l31:15,l32:15,l33:16,l34:16,l35:17,l36:17,l37:18,l38:18,l39:19,l40:19,l41:20,l42:20,l43:21,l44:21,l15:99,l17:99};
 const GL=Object.keys(LZ).filter(id=>LESSONS.some(L=>L.id===id));GL.forEach(id=>{const L=LES(id);L.who='tanu';L.zone=LZ[id]});
 const zh=()=>W.map==='world'?W.zone():MAPS.world.zone((S.ret||{y:1e9}).y);
 const nextL=z=>{const nx=GL.find(l=>!S.les[l]);return nx&&LES(nx).zone<=z?nx:null};
 /* le fil de Maître Tanuki : comment il est arrivé là, et un mot pour le démon */
 const HAIL={
  2:[J(TN,['海斗|かいと','くん','！','こっち','、','こっち','！'],'Kaito ! Par ici, par ici !','こっち = par ici (familier)'),T_(TN,"Je t'ai suivi. Enfin, précédé. J'ai coupé par la forêt, je me suis perdu, j'ai demandé mon chemin à un bambou et il avait raison."),T_(TN,"Et bonjour à toi aussi, là-dedans. Oui, toi. L'ombre qui fait semblant de ne pas écouter."),T_(KG,"… Il me voit ?"),T_(TN,"Je suis un tanuki, mon petit. On voit les esprits, les dettes et les bons restaurants. Bon ! J'ai une leçon toute chaude.")],
  3:[J(TN,['おーい','！','海斗|かいと','くん','！'],'Ohé ! Kaito !'),T_(TN,"Je suis arrivé dans une caisse. Il y avait écrit « fragile ». J'ai trouvé ça délicat de leur part."),T_(KG,"Demande-lui pourquoi il nous suit."),T_(TN,"Parce que ce garçon a un démon dans la poitrine et pas un seul adverbe dans la tête. Il faut bien que quelqu'un s'occupe de l'un des deux. J'ai choisi le plus facile."),T_(KG,"… Lequel ?"),T_(TN,"Je ne te le dirai pas, ça te ferait trop plaisir.")],
  4:[J(TN,['ここ','、','ここ','！','ゴホ','、','ゴホ','。'],'Ici, ici ! Kof, kof.'),T_(TN,"Quelle fumée ! J'ai voulu me transformer en théière pour passer inaperçu. Ça a marché. On m'a rempli. J'ai servi onze tasses avant de pouvoir m'enfuir."),T_(KG,"Il ment."),T_(TN,"Je n'ai jamais menti de ma vie, démon. Je me trompe avec assurance, c'est très différent. Allez, grammaire !")],
  5:[J(TN,['海斗|かいと','くん','…','こっち','…'],'Kaito… par ici…'),T_(TN,"Je chuchote parce que le village est triste. Et aussi parce que j'ai marché dans une braise et que je préfère ne pas y penser."),T_(TN,"Dis-moi, l'ombre. Ce qui dort sous le puits… c'est de ta famille ?"),T_(KG,"… Un cousin. On ne se parle plus."),T_(TN,"Ah, les réunions de famille. Chez nous aussi, ça finit toujours par quelqu'un qui scelle quelqu'un. Viens, petit : on va apprendre de quoi lui tenir tête.")],
  6:[J(TN,['さ','、','さ','、','寒い|さむい','！'],'F-f-froid !'),T_(TN,"J'ai passé le col en roulant. Je ne l'ai pas fait exprès. Un tanuki rond sur une pente, c'est de la physique, pas du courage."),T_(KG,"Il a de la neige dans les oreilles."),T_(TN,"C'est pour mieux réfléchir. Toi, démon, tu n'as pas froid, au moins ? Non ? Tant mieux. S'il gèle, réchauffe le petit. Discrètement. Je ne dirai rien."),T_(KG,"… Je ne fais pas ça."),T_(TN,"Bien sûr que non.")],
  7:[J(TN,['海斗|かいと','くん','！','手紙|てがみ','です','よ','！'],'Kaito ! Du courrier !','手紙 (てがみ) = lettre'),T_(TN,"Je me suis envoyé ici par la poste. On m'a tamponné. Trois fois. Je garde les tampons : ça me fait un pedigree."),T_(TN,"Et j'ai une lettre pour le locataire. « À l'attention de l'ombre, poitrine de Kaito, côté gauche. »"),T_(KG,"… De qui ?"),T_(TN,"De moi. Elle dit : « Sois gentil avec lui. » Voilà. C'était plus simple de te le dire, mais j'avais déjà acheté le timbre.")],
  16:[J(TN,['しーっ','…','海斗|かいと','くん','、','こっち','。'],'Chut… Kaito, par ici.','しーっ = chut'),T_(TN,"Je suis caché sous une pile de dictionnaires. C'est le seul endroit où personne ne regarde : les gens d'ici ont peur des mots."),T_(TN,"Hana est là-haut. Je l'ai vue par une fenêtre. Elle a démonté la moitié de sa cage avec une épingle. Elle attend qu'on vienne, par politesse."),T_(KG,"Et nous, on prend des cours de grammaire."),T_(TN,"Évidemment. Pour libérer une princesse, il faut savoir dire « je veux » et « pas encore ». Tu verras, ça sert.")],
  15:[J(TN,['わ','、','わ','、','風|かぜ','が','！'],'Ouah, ouah, le vent !','風 (かぜ) = vent'),T_(TN,"J'ai traversé le pont à quatre pattes. Puis à plat ventre. Puis en roulant, mais vers l'arrière. Le vent d'ici n'a aucun respect pour les tanuki."),T_(KG,"Il souffle de tous les côtés à la fois."),T_(TN,"Parce que plus personne ne sait dire d'où il vient. Tetsu a pris le mot « chemin », et sans chemin, le vent se perd comme tout le monde."),T_(TN,"Alors aujourd'hui, on apprend à indiquer le chemin : tout droit, à droite, à gauche. Et à dire « ne fais pas ça ». Ça, c'est pour le démon.")],
  14:[J(TN,['海斗|かいと','くん','、','見て|みて','！'],'Kaito, regarde !','見て : « regarde ! »'),T_(TN,"Cette épingle. C'est celle de Hana. Elle me l'a lancée à la figure, un jour, parce que j'avais dit que ses boulettes étaient trop salées. Elles l'étaient."),T_(TN,"Elle est passée par ici. Elle va bien. Elle répare les horloges de Tetsu de travers, exprès. Je reconnais bien là notre petite."),T_(KG,"… Elle sait qu'on arrive ?"),T_(TN,"Elle le pense. Et justement : aujourd'hui, on apprend à dire ce qu'on pense. Et à comparer. Par exemple : Hana est plus courageuse que nous deux réunis.")],
  13:[J(TN,['ただいま','…'],'Je suis rentré…','ただいま : ce qu\'on dit en rentrant chez soi'),T_(TN,"Elle m'a frappé avec le rouleau. Trois fois. Puis elle m'a serré si fort que j'ai perdu ma feuille."),T_(TN,"Je suis parti il y a trois ans. Je lui avais dit « je vais acheter du saké ». Je suis un mauvais mari et un excellent professeur. Ce n'est pas une excuse. C'est un constat."),T_(KG,"… Pourquoi tu es parti ?"),T_(TN,"Pour suivre une voix. Celle d'un dieu endormi qui appelait au secours en pleine nuit. Je l'ai suivie jusqu'à Kome, et à Kome il y avait un garçon. Voilà. Maintenant tu sais."),T_(TN,"Bon ! Leçon. Aujourd'hui : dire ce qu'on veut. Moi, je veux un bain, un pardon et une sieste. Dans cet ordre.")],
  12:[J(TN,['海斗|かいと','くん','！','花|はな','ちゃん','が','…'],'Kaito ! Hana, elle…','ちゃん : petit suffixe affectueux, pour un enfant ou une amie'),T_(TN,"Je sais. Je l'ai vu. J'étais à Kome, sur ton toit, en pleine sieste. Le ciel est devenu noir et deux grandes mains de fer sont descendues."),T_(TN,"J'ai couru derrière le dirigeable. Un tanuki ne court pas vite, mais il ne s'arrête jamais. Je me suis transformé en ancre et je me suis accroché à la coque jusqu'ici. Puis je suis tombé dans un tas de cordages."),T_(KG,"… Et tu n'as rien pu faire."),T_(TN,"Rien. Écoute-moi bien, Kaito : Tetsu ne lui fera pas de mal. Il veut quelque chose. Et ce qu'il veut, c'est toi. Ou ce que tu as dans la poitrine."),T_(KG,"Moi."),T_(TN,"Alors on ne lui donnera rien, et on ira la chercher. Mais d'abord, une leçon. Si, si. On ne monte pas au ciel avec une grammaire qui traîne par terre. Et elle tombe bien : aujourd'hui, on apprend à dire « parce que ».")],
  11:[J(TN,['あつ','、','あつ','、','熱い|あつい','！'],'Chaud, chaud, c\'est brûlant !','熱い (あつい) = brûlant'),T_(TN,"Je me suis caché dans un wagonnet. Il allait au fourneau. J'ai sauté à temps, mais ma queue a un peu fondu. Elle repoussera. Je crois."),T_(TN,"Dis-moi, l'ombre. Tu la sens, la bête, là-bas dans la halle ?"),T_(KG,"… Elle a faim. Pas comme moi. Moi, je garde ce que je prends. Elle, elle avale et il ne reste rien."),T_(TN,"Alors nous sommes d'accord tous les trois, pour une fois. Kaito : chaque mot que tu apprends, c'est un mot qu'elle n'aura pas. Viens. J'en ai deux ou trois tout frais.")],
  10:[J(TN,['しーっ','！','授業中|じゅぎょうちゅう','です','。'],'Chut ! Je suis en cours.','授業中 (じゅぎょうちゅう) = en plein cours'),T_(TN,"Je me suis fait passer pour un professeur invité. Ils m'ont donné une classe. Trente élèves. Je leur enseigne la sieste comparée depuis ce matin, ils ont d'excellents résultats."),T_(KG,"Ils vont s'en apercevoir."),T_(TN,"Ils m'ont déjà proposé une chaire. Dis-moi, démon : tous ces kanji mis en machine… ça te fait quoi ?"),T_(KG,"… Ça gratte. Comme si on recopiait mon nom mille fois sans savoir le lire."),T_(TN,"Voilà. C'est exactement ça. Kaito, retiens bien ce qu'il vient de dire, c'est la chose la plus intelligente de ce voyage. Et maintenant : grammaire. Dans l'ordre, pour une fois.")],
  9:[J(TN,['海斗|かいと','くん','！','上|うえ','、','上|うえ','！'],'Kaito ! En haut, en haut !','上 (うえ) = en haut, sur'),T_(TN,"Je suis sur le toit. J'ai voulu me transformer en lanterne pour passer inaperçu. Très réussi. On m'a accroché. Et allumé."),T_(KG,"Il sent le roussi."),T_(TN,"Je sens la pédagogie ardente, démon. Dis-moi plutôt : cette ville te plaît ? Il y fait toujours nuit. Tu devrais te sentir chez toi."),T_(KG,"… Il y a trop de lanternes."),T_(TN,"Ah. Lui aussi, il a peur du noir quand il n'est pas tout seul dedans. Note-le, Kaito, c'est touchant. Bon ! Descends-moi de là, et je te donne ta leçon. Dans cet ordre, j'y tiens.")],
  8:[J(TN,['た','、','助けて|たすけて','！','…','あ','、','浅い|あさい','。'],'À-à l\'aide ! … Ah. C\'est peu profond.','助けて (たすけて) = au secours · 浅い (あさい) = peu profond'),T_(TN,"J'ai voulu traverser en me transformant en barque. J'ai très bien flotté. C'est pour ramer que ça s'est gâté."),T_(KG,"Vieux fou. Tu aurais pu te noyer."),T_(TN,"Oh ! Tu t'es inquiété. Kaito, tu as entendu ? Il s'est inquiété."),T_(KG,"Je constatais."),T_(TN,"Il constatait avec inquiétude. On progresse tous, dans ce voyage. Allez : conjugaison, pendant que je sèche.")]};
 async function hail(h,nx){const first=!S.fl['hz'+h.z];S.fl['hz'+h.z]=1;S.fl['hl_'+nx]=1;S.fl['tn'+h.z]=1;const e=W.ents.find(x=>x.id==='tanu'+h.z);
  if(e){try{const H=W.H;if(Math.abs(e.x-H.x)+Math.abs(e.y-H.y)>3){const c=[[0,6],[0,-6],[0,5],[0,-5],[5,0],[-5,0],[0,4],[0,-4]].find(([a,b])=>!W.solid(H.x+a,H.y+b)&&!W.solid(H.x+Math.sign(a)*2,H.y+Math.sign(b)*2));if(c){e.x=e.px=e.hx=H.x+c[0];e.y=e.py=e.hy=H.y+c[1]}}sfx('alert');await D.say([J(TN,['海斗|かいと','くん','！'],'Kaito !')]);for(let i=0;i<12&&Math.abs(e.x-H.x)+Math.abs(e.y-H.y)>1;i++){const dx=H.x-e.x,dy=H.y-e.y,d=Math.abs(dy)>=Math.abs(dx)?(dy>0?0:1):(dx<0?2:3);if(!(await W.walk(e,d,.11)))break}W.faceTo(W.H,e);W.faceTo(e,W.H);await W.emote(e)}catch(x){}}
  await D.say(first&&HAIL[h.z]?HAIL[h.z]:[J(TN,['海斗|かいと','くん','！','ちょっと','！'],'Kaito ! Une minute !','ちょっと = un instant'),T_(TN,pick(["J'ai retrouvé une leçon dans ma manche. Elle y était depuis ce matin. Elle a un peu chaud, mais elle est bonne.","J'ai rêvé d'une règle de grammaire. Elle était très belle. Je te la montre avant de l'oublier ?","Ne bouge pas ! … Voilà. Tu as l'air de quelqu'un qui a exactement le temps pour une leçon."]))]);
  const L=LES(nx);if(await D.ask({n:TN,t:`« ${L.title} » — ${L.sub}. On la fait maintenant ?`},YN2)!==0){await D.say(T_(TN,"Pas de souci. Je reste dans le coin. Si tu ne me vois pas, cherche quelque chose de rond qui dort."));save();return}
  await teach(nx)}
 async function teach(nx){const old=S.xp,ok=await Lesson.run(nx);UI.panel('pad');if(ok){save();Quest.add('dojo')}
  await D.say(T_(TN,ok?pick(["Bravo ! Je suis fier comme si c'était moi qui avais appris. D'ailleurs j'ai appris deux ou trois choses.","Parfait. Ces phrases reviendront dans tes combats. Et dans mes rêves, probablement."]):"On reprendra. Rien ne presse. Enfin si, mais faisons comme si."));if(ok&&typeof afterXp==='function')await afterXp(old)}
 const oTrig=STORY.triggers;STORY.triggers=(x,y)=>{const t=oTrig(x,y);if(t||!S.fl.act1||S.fl.noscn)return t;const h=HAMS.find(h=>y<=h.y1-2&&y>=h.y0+2);if(!h)return t;const nx=nextL(h.z);if(nx&&!S.fl['hl_'+nx])return()=>hail(h,nx);return t};
 /* Maître Tanuki, quand on va le voir */
 const oTanu=STORY.tanu;STORY.tanu=async e=>{if(!S.fl.act1||!S.les.l1)return oTanu(e);const hz=e&&e.hz;if(!hz)return oTanu(e);
  if(!S.fl['tn'+hz]){S.fl['tn'+hz]=1;await D.say(HAIL[hz]&&!S.fl['hz'+hz]?HAIL[hz]:[J(TN,['また','会いました|あいました','ね','！'],'On se retrouve !')]);S.fl['hz'+hz]=1;save()}
  const i=await D.ask({n:TN,t:'Qu\'est-ce qu\'on fait, mon grand ?'},[{jp:['文法|ぶんぽう'],fr:'Leçon de grammaire'},{jp:['文|ぶん'],fr:'Quiz de phrases'},{jp:['語|ご'],fr:'Vocabulaire'},'Rien, merci']);
  if(i===0){const nx=nextL(hz);if(nx){S.fl['hl_'+nx]=1;const L=LES(nx);if(await D.ask({n:TN,t:`J'ai une leçon pour toi : « ${L.title} » — ${L.sub}. On y va ?`},YN2)===0)await teach(nx);return}
   const done=GL.filter(l=>S.les[l]);if(!done.length){await D.say(T_(TN,GL.find(l=>!S.les[l])?"La prochaine leçon, je te la garde pour le prochain bourg. Je l'ai rangée quelque part. Je crois.":"Tu sais tout ce que je sais. C'est vexant, mais c'est allé vite."));return}
   const j=await D.ask({n:TN,t:GL.find(l=>!S.les[l])?'La suivante t\'attend au prochain bourg. Laquelle veux-tu revoir ?':'Laquelle veux-tu revoir ?'},done.slice(-6).map(l=>LES(l).title).concat(['Aucune']));if(j<Math.min(6,done.length))await teach(done.slice(-6)[j]);return}
  const sc=async f=>{const ok=XI['X_LT'+hz]&&XI['X_LT'+hz].width;let un=null;if(ok){await UI.fade(1,160);un=Lesson.stage('tanu');await UI.fade(0,160)}try{return await f()}finally{if(un){await UI.fade(1,160);un();UI.panel('pad');await UI.fade(0,160)}}};
  if(i===1)return sc(async()=>{const o=D.ask;D.ask=async(q,opts)=>{D.ask=o;return 0};try{return await oTanu(e)}finally{D.ask=o}});
  if(i===2)return sc(()=>Vocab.at(TN))};

 /* les fils de Kotoba (il essaie d'être sérieux) et de Hagane (elle n'a pas le temps) : une scène par bourg */
 const KN='Maître Kotoba',KA='Kaito',N_=t=>({t});
 const KSC={
  2:[J(KN,['静か|しずか','に','。'],'Silence.','静か (しずか) = calme, silencieux'),T_(KN,"Un dojo est un lieu de rigueur. Ici, on ne rit pas."),T_(KA,"Maître… vous êtes habillé en bambou."),T_(KN,"C'est un camouflage. Un maître doit se fondre dans son environnement."),T_(KA,"Vous êtes à l'intérieur."),T_(KN,"… Les bambous aussi, parfois. Bon. On écoute, ou on critique ?")],
  3:[T_(KN,"Ne dis rien."),J(KA,['先生|せんせい','、','顔|かお','が','黒い|くろい','です','。'],'Maître, vous avez le visage noir.','顔 (かお) = visage · 黒い (くろい) = noir'),T_(KN,"C'est de la suie pédagogique. Elle montre que je travaille."),T_(KA,"Et les lunettes de soudeur ?"),T_(KN,"Pour lire. De très près. Des choses très chaudes. Ouvre tes oreilles et ferme le reste.")],
  4:[T_(KA,"Vous n'avez pas changé de tenue, cette fois."),T_(KN,"Parce que celle-ci me va. Je l'ai décidé. Un maître est constant."),T_(KA,"Le tablier est à l'envers."),J(KN,['知って|しって','います','。'],'Je le sais.','知っています (しっています) = je sais'),T_(KN,"… Depuis combien de temps ?"),T_(KA,"Depuis l'autre quartier.")],
  5:[T_(KN,"(voix étouffée) Mmmf mm mmf."),T_(KA,"Pardon ?"),T_(KN,"(baissant le foulard) J'ai dit : « La prononciation est la clé de tout. »"),T_(KA,"C'était très clair."),T_(KN,"Le foulard, c'est pour la cendre. Pas pour ressembler à un bandit. On m'a déjà donné deux bourses dans la rue, je les ai rendues. Presque toutes.")],
  6:[J(KN,['さ','、','寒くない|さむくない','です','。'],'J-je n\'ai pas froid.','寒くない (さむくない) = pas froid'),T_(KA,"Vous portez trois manteaux et un chapeau à oreilles."),T_(KN,"C'est une tenue de cérémonie. Montagnarde. Très ancienne."),T_(KA,"Votre nez est rouge."),T_(KN,"C'est la colère. Contre les élèves insolents. Assieds-toi près du radiateur. Non, pas celui-là, c'est le mien.")],
  7:[T_(KN,"Je voyage léger, comme tout sage. Un maître ne possède rien."),T_(KA,"Qu'est-ce qu'il y a dans la hotte ?"),T_(KN,"Rien. Des livres. Et quatre tenues de rechange."),J(KA,['先生|せんせい','、','肩|かた','に','葉っぱ|はっぱ','が','あります','。'],'Maître, vous avez une feuille sur l\'épaule.','肩 (かた) = épaule · 葉っぱ (はっぱ) = feuille'),T_(KN,"Elle est là exprès. Elle symbolise l'automne. … Elle y est depuis quand ?")],
  16:[T_(KN,"Psst. C'est moi. Archiviste impérial numéro quatre cent douze."),T_(KA,"Maître… votre moustache glisse."),T_(KN,"C'est une moustache de service. Elle a ses horaires."),J(KN,['お名前|おなまえ','は','何|なん','です','か','。'],'Quel est votre nom ?','お名前 = votre nom (poli)'),T_(KN,"C'est la seule question qu'on pose ici. Apprends à l'entendre, et à y répondre. Vite, avant que mon chapeau tombe.")],
  15:[T_(KN,"Pfffuiiit ! Le train de seize heures douze entre en gare !"),T_(KA,"Maître, il n'y a pas de train."),T_(KN,"Il y en aura un quand tu sauras demander ton chemin. Un chef de gare, c'est d'abord une oreille. Il entend le train avant de le voir."),J(KN,['東|ひがし','は','どちら','です','か','。'],'L\'est, c\'est de quel côté ?','どちら = de quel côté, lequel'),T_(KN,"Écoute la réponse. Pas le vent. La réponse.")],
  14:[T_(KN,"Regarde ces montres. Cinq. Une par fuseau horaire de l'île."),T_(KA,"Maître, il n'y a qu'une île."),T_(KN,"Mais cinq heures différentes. Je m'adapte."),J(KA,['先生|せんせい','、','今|いま','、','何時|なんじ','です','か','。'],'Maître, quelle heure est-il ?','何時 (なんじ) = quelle heure'),T_(KN,"… Toutes. Il est toutes les heures. Bon. Écoute bien ce qui suit, et ne regarde pas mon gilet.")],
  13:[T_(KN,"Silence. Les renards nous observent. Je me fonds dans la population."),T_(KA,"Maître, ce sont des oreilles en papier."),T_(KN,"Ce sont des oreilles de cérémonie."),J(KA,['先生|せんせい','、','しっぽ','が','落ちました|おちました','。'],'Maître, votre queue est tombée.','落ちます (おちます) = tomber'),T_(KN,"… Ramasse-la. Discrètement. Puis ouvre tes oreilles, les vraies : aujourd'hui, on écoute le corps. 目、耳、口. Un renard m'a dit que j'avais un accent. Un renard."),T_(KN,"Je n'ai pas d'accent.")],
  12:[T_(KN,"Ne fais aucun commentaire sur la tenue."),T_(KA,"Maître, vous portez des lunettes d'aviateur et une écharpe de deux mètres."),T_(KN,"C'est l'uniforme réglementaire des instructeurs de vol. Je me suis inscrit ce matin."),T_(KA,"Vous savez piloter ?"),J(KN,['まだ','です','。'],'Pas encore.','まだです = « pas encore »'),T_(KN,"Mais j'enseigne déjà la phraséologie. « Décollage », « atterrissage », « au secours ». Surtout le dernier. Écoute bien, c'est le plus utile.")],
  11:[T_(KN,"PARLE PLUS FORT. ICI, IL Y A DU BRUIT."),T_(KA,"Maître, vous avez des théières sur les oreilles."),T_(KN,"QUOI ?"),J(KA,['先生|せんせい','、','聞こえます|きこえます','か','。'],'Maître, vous m\'entendez ?','聞こえます (きこえます) = entendre, être audible'),T_(KN,"(retirant son casque) Parfaitement. C'est un équipement de sécurité. Je donne un cours d'écoute, je protège donc mes oreilles. C'est logique. … Ne réfléchis pas trop à cette phrase.")],
  10:[T_(KN,"Appelle-moi « Professeur ». Ici, j'ai un rang."),T_(KA,"Maître, on ne voit plus vos yeux sous le chapeau."),T_(KN,"Un grand esprit n'a pas besoin de voir. Il devine."),J(KA,['先生|せんせい','、','服|ふく','に','墨|すみ','が','あります','。'],"Maître, il y a de l'encre sur votre robe.",'服 (ふく) = vêtement · 墨 (すみ) = encre'),T_(KN,"C'est un sceau. Personnel. Très ancien. … J'ai trébuché sur la robe en entrant. Dans l'encrier du doyen. Devant le doyen. Nous n'en parlerons pas non plus.")],
  9:[T_(KN,"Regarde bien. Voilà comment s'habille un homme de la capitale. Élégance. Modernité. Autorité."),T_(KA,"Maître, le chapeau tient avec une ficelle."),T_(KN,"C'est une jugulaire. Très à la mode. En haut."),J(KA,['先生|せんせい','、','靴|くつ','は','一つ|ひとつ','だけ','です','か','。'],"Maître, vous n'avez qu'une seule chaussure ?",'靴 (くつ) = chaussure · だけ = seulement'),T_(KN,"L'autre était en option. … Le vendeur parlait très vite. J'ai dit « oui » à tout. J'enseigne l'écoute, je ne la pratique pas forcément.")],
  8:[T_(KN,"Avant que tu parles : oui, le chapeau est trop petit."),T_(KA,"Je n'allais rien dire."),T_(KN,"Tu allais le penser très fort. C'était le dernier. L'autre, un tanuki l'a pris pour faire une barque."),T_(KA,"Et le pantalon retroussé ?"),J(KN,['川|かわ','は','深い|ふかい','です','。'],'Le fleuve est profond.','深い (ふかい) = profond'),T_(KN,"Je l'ai appris ce matin. En personne. On ne parlera plus jamais de ce matin.")]};
 const HN=NPN.forg;
 const FSC={
  0:[J(HN,['早く|はやく','！'],'Vite !','早く (はやく) = vite'),T_(HN,"Entre ou sors, tu fais courant d'air et ma braise refroidit."),T_(HN,"Toi, c'est Kaito. Moi, c'est Hagane. Voilà, on se connaît. Tu veux quoi ?"),T_(HN,"Les kanji ? Bien. Un trait raté, tu recommences. Dix traits ratés, tu recommences dix fois. C'est toute ma méthode. Elle marche.")],
  2:[T_(HN,"Encore toi. J'ai trois lames au feu et un client qui veut une bouilloire. Une bouilloire ! Dans une forge !"),T_(HN,"Ici tout est en bambou. Mon établi plie. Mes murs plient. Si mon marteau plie, je pars."),J(HN,['時間|じかん','が','ない','。'],'Pas le temps.','時間 (じかん) = le temps'),T_(HN,"Montre-moi ce que tu sais tracer. Maintenant.")],
  3:[T_(HN,"Ne touche à rien. Tout ce qui est ici est chaud, coupant, ou à moi."),T_(HN,"Les machines de Tetsu font en une heure ce que je fais en un jour. En moins bien. Ça ne se voit pas tout de suite. Ça se voit quand ça casse."),T_(HN,"Un kanji fait à la machine, ça n'existe pas. Alors au travail. Je te regarde d'un œil, l'autre est sur la soudure.")],
  4:[T_(HN,"Tu tousses ? Tousse plus loin de mon acier."),T_(HN,"Tes derniers tracés étaient corrects. Pas bons. Corrects. Ne souris pas."),J(HN,['次|つぎ','！'],'Suivant !','次 (つぎ) = suivant'),T_(HN,"… Il n'y a personne d'autre ? Alors c'est encore toi. Dépêche.")],
  5:[N_("Elle ne lève pas les yeux. Elle redresse une poutre à coups de marteau."),T_(HN,"La forge d'ici a brûlé. Je la remonte. Personne ne me l'a demandé."),T_(HN,"Tiens-moi ça. Non, l'autre bout. Voilà. Tu viens d'aider. N'en parle à personne, j'ai une réputation."),T_(HN,"Bon. Tes kanji. Vite, avant que le toit retombe.")],
  6:[T_(HN,"Ferme la porte. FERME LA PORTE."),T_(HN,"Le fer gèle, l'eau gèle, mes doigts gèlent. La seule chose qui ne gèle pas ici, c'est ma mauvaise humeur."),J(HN,['寒い|さむい','。'],'Froid.','寒い (さむい) = froid'),T_(HN,"Trace vite, ça réchauffe. Et si tu rates, recommence : ça réchauffe aussi.")],
  7:[T_(HN,"Quarante fers à cheval depuis ce matin. Je ne forge plus, je chausse."),T_(HN,"Tout le monde passe, personne ne reste, tout le monde est pressé. … Quoi ? Moi, ce n'est pas pareil. Moi, j'ai des raisons."),T_(HN,"Tu tiens mieux ton pinceau qu'avant. Je l'ai remarqué. Ça ne veut pas dire que je regardais.")],
  16:[T_(HN,"Je suis garde. Ne ris pas."),T_(HN,"Le casque est trop grand, je vois mes pieds par la visière. J'ai gardé mon marteau : on m'a demandé où était ma lance, j'ai dit que c'était une lance très courte et très lourde."),J(HN,['友達|ともだち','を','助けに|たすけに','来ました|きました','。'],'Je suis venue sauver une amie.','友達 (ともだち) = ami · 助けに来ました = venue pour aider'),T_(HN,"Le thème d'ici : les gens. 人、友、名、本、会. Une personne, un ami, un nom, un livre, une rencontre. Tetsu les a tous volés. On les reprend. Trace.")],
  15:[T_(HN,"Des rails. Des VRAIS rails. Du fer, du lourd, du qui-tient-debout."),T_(HN,"J'en ai posé quarante mètres ce matin. Pour le plaisir. Gonta a pleuré. De joie, je crois. Ou de peur."),J(HN,['道|みち','を','作ります|つくります','！'],'Je fabrique des chemins !','道 (みち) = chemin · 作ります (つくります) = fabriquer'),T_(HN,"Le thème d'ici : les points cardinaux. 東、西、南、北, et 道, le chemin. Tetsu l'a volé ? Alors on le reforge. Trace.")],
  14:[T_(HN,"Des rouages. Des rouages grands comme un ongle. Et on me demande de les forger. MOI."),T_(HN,"Mon marteau pèse six kilos. Cet engrenage pèse le poids d'une puce. J'ai cassé quatorze pinces depuis ce matin."),J(HN,['小さい|ちいさい','！','小さすぎる|ちいさすぎる','！'],'Petit ! Beaucoup trop petit !','小さすぎる = trop petit'),T_(HN,"Le thème d'ici, c'est décrire : grand, petit, haut, bon marché, neuf. Trace. Et si tu me parles de la taille de ces rouages, je te forge en rouage.")],
  13:[T_(HN,"Ne dis rien. Oui, j'ai des feuilles dans les cheveux. Oui, je suis tombée du ciel. Oui, j'étais dans la soute avec ton moine."),T_(HN,"J'ai monté une forge sous une racine avec ce qui restait du dirigeable. L'hélice fait un très bon soufflet. Le capitaine pleure chaque fois qu'il passe."),J(HN,['手|て','を','見せて|みせて','。'],'Montre-moi tes mains.','手 (て) = main'),T_(HN,"Pas de brûlure, pas de tremblement. Bien. Le thème d'ici, c'est le corps : main, pied, œil, oreille, bouche. Trace-les comme si c'étaient les tiens. Ce sont les tiens.")],
  12:[T_(HN,"Je sais pour ta sœur. Tout le port le sait : le dirigeable noir a fait escale ici avant de remonter vers la citadelle."),T_(HN,"Je ne vais pas te dire que ça va aller. Je n'en sais rien. Je vais te dire ce que je sais faire : tenir un marteau. Et t'apprendre à tenir un pinceau."),J(HN,['家族|かぞく','は','大事|だいじ','です','。'],"La famille, c'est important.",'家族 (かぞく) = famille · 大事 (だいじ) = important'),T_(HN,"Le thème d'ici, c'est la famille. Je ne l'ai pas fait exprès. … Si, je l'ai fait exprès. Trace. Et ne pleure pas sur mon enclume : ça la fait rouiller.")],
  11:[T_(HN,"Enfin. Une vraie forge. Regarde-moi ce feu."),T_(HN,"J'ai appris ici. Avec le vieux, celui qui a un œil fermé. Il m'a fait balayer deux ans avant de me laisser toucher un marteau. Je l'ai détesté. Il avait raison."),J(HN,['見て|みて','！'],'Regarde !','見て : forme en て de 見る, ici un ordre familier'),T_(HN,"Cette lame-là, je ne la vends pas. Elle sera prête quand tu sauras tracer sans trembler. Donc dépêche-toi. Non. Prends ton temps. … Dépêche-toi de prendre ton temps.")],
  10:[T_(HN,"Des caractères d'imprimerie. Trois mille par jour. Tous pareils. Ils appellent ça le progrès."),T_(HN,"Un kanji coulé dans le plomb, ça ne tremble pas, ça ne déborde pas, ça ne se trompe pas. Et ça ne veut rien dire tant que personne ne l'a tracé une fois à la main."),J(HN,['書いて|かいて','！'],'Écris !','書いて : forme en て de 書く, ici un ordre familier'),T_(HN,"Alors trace. Mal, s'il le faut. Mais vite : j'ai un moule qui refroidit et je ne supporte pas d'attendre un moule.")],
  9:[T_(HN,"Des tuyaux. Je suis forgeronne et on me fait souder des tuyaux. Six cents mètres depuis ce matin."),T_(HN,"Les lunettes ? C'est pour la soudure. Et pour lire les bons de commande : ils écrivent petit exprès. Ne commente pas."),J(HN,['急いで|いそいで','！'],'Dépêche-toi !','急ぎます (いそぎます) = se dépêcher'),T_(HN,"La ville haute veut de la vapeur pour hier. Moi, je veux tes kanji pour maintenant. Devine qui passe en premier. Toi. Ne le répète pas.")],
  8:[T_(HN,"Des ancres. Des chaînes. Des crochets. Tout rouille avant que j'aie fini."),T_(HN,"Le passeur dit que son bateau ne part pas. Je lui ai proposé de lui forger du courage. Il n'a pas ri. Moi non plus, j'étais sérieuse."),J(HN,['よく','できた','。'],'C\'est bien fait.','よくできた = bien fait, bravo'),T_(HN,"… J'ai dit ça à l'ancre. Pas à toi. Toi, au travail.")]};
 /* Maître Kotoba : l'oreille et la voix */
 const oKeiko=STORY.keiko;STORY.keiko=async e=>{const n='Maître Kotoba',o=D.ask;let un=null;
  {const z=zh();if(KSC[z]&&!S.fl['ks'+z]){if(!S.fl.keiko){S.fl.keiko=1;S.fl.keiko2=1;await D.say([J(n,['ようこそ','、','言葉|ことば','の','道場|どうじょう','へ','！'],'Bienvenue au dojo des mots !','言葉 (ことば) = mot, parole · へ = « vers, à »'),T_(n,"Ici, j'entraîne ce qu'on oublie toujours : l'oreille et la voix. Avec le plus grand sérieux.")])}S.fl['ks'+z]=1;await D.say(KSC[z]);save()}}
  if(!S.fl.keiko2&&S.fl.keiko){S.fl.keiko2=1;await D.say(T_(n,'Changement de programme. Le tanuki a pris la grammaire, la forge a pris les kanji. Il me reste l\'essentiel : tes oreilles et ta bouche. Elles en ont besoin.'))}
  D.ask=async(q,opts)=>{if(q&&q.t==='Que veux-tu travailler ?'){D.ask=o;const i=await o(q,[{jp:['耳|みみ'],fr:'Écouter'},{jp:['口|くち'],fr:'Prononcer'},{jp:['語|ご'],fr:'Vocabulaire'},'Rien, merci']);if(i<3){await UI.fade(1,160);un=Lesson.stage('kotoba');await UI.fade(0,160)}return i+3}return o(q,opts)};
  try{return await oKeiko(e)}finally{D.ask=o;if(un){await UI.fade(1,160);un();UI.panel('pad');await UI.fade(0,160)}}};
 /* la forge : thèmes de kanji */
 const oForg=STORY.forg;STORY.forg=async e=>{const n=NPN.forg,z=zh(),place=z>=17?z-1:z===16?15:z===15?14:z===14?13:z===13?12:z===12?11:z===11?10:z===10?9:z===9?8:z===8?7:z===7?6:z===6?5:z>=2?Math.max(1,Math.min(4,z-1)):0;
  {const k=z===1?0:z,f=!S.fl.forgk;S.fl.forgk=1;if(FSC[k]&&!S.fl['fs'+k]){S.fl['fs'+k]=1;await D.say(FSC[k]);if(f&&k)await D.say(T_(n,"Et retiens : les thèmes de kanji, c'est à l'enclume. Dans chaque bourg. Je ne le répéterai pas."));save()}}
  const i=await D.ask({n,t:'Qu\'est-ce que je te fais ?'},[{jp:['漢字|かんじ'],fr:'Thèmes de kanji'},{jp:['休み|やすみ'],fr:'Réparer mon équipement (repos)'},{jp:['強化|きょうか'],fr:'Améliorer mon équipement'},'Rien, merci']);if(i===2)return Forge.up(n);
  if(i===0){const un=z>=2&&XI['X_LF'+z]&&XI['X_LF'+z].width?(await UI.fade(1,160),Lesson.stage('forg')):null;if(un)await UI.fade(0,160);try{await Path.at(place,n)}finally{if(un){await UI.fade(1,160);un();UI.panel('pad');await UI.fade(0,160)}}return}if(i===1)return oForg(e)};
 Object.defineProperty(NPCS.atelier[0],'spr',{get:()=>{const z=zh();return XI['C_forg'+z+'_00']&&XI['C_forg'+z+'_00'].width?'forg'+z:'forg'},enumerable:true,configurable:true});
 Object.defineProperty(PORT,NPN.forg,{get:()=>{const z=zh();return IM['PX_forg'+z]?'PX_forg'+z:'PX_forg'},configurable:true});
 ['le dojo des mots du Hameau des bambous','le dojo des mots du Quartier des ouvriers','le dojo des mots du Quartier des fumées','le dojo des mots du Hameau des cendres','le dojo des mots du col des Brumes','le dojo des mots du Relais de la Grand-Route','le dojo des mots du Bourg des passeurs'].forEach((s,i)=>{const k=PLACES.indexOf(s);if(k>=0)PLACES[k]=s.replace('le dojo des mots','la forge')});
})();

/* ---------- fin de l'acte II : le Baku de fer, la machine qui avale les mots (deux phases) ---------- */
(()=>{
 const J=(n,jp,fr,x)=>({n,jp,fr,x}),T_=(n,t)=>({n,t}),KG='影',BN='Baku de fer',OPP=[1,0,3,2];
 const oG=STORY.guard;STORY.guard=async(e,seen)=>{if(e.rov||e.id!=='baku'||!Gates.meets('baku'))return oG(e,seen);
  const H=W.H;W.faceTo(e,H);
  if(!S.fl.baku_in){S.fl.baku_in=1;await bakuRise(e);await Cine.say('N_S6',["Au fond de la halle, quelque chose d'énorme se retourne. Des plaques de fer noir, une trompe de laiton, et dans son ventre une cuve où tournent des milliers de traits d'encre.",T_(KG,"… Ce sont des mots. Elle les a tous là-dedans. Je les entends. Ils ne veulent plus rien dire."),J(BN,['言葉|ことば','を','ください','。'],'Donnez-moi des mots.','言葉 (ことば) = mot, parole'),T_(BN,"Dans le folklore, le Baku mange les mauvais rêves. On m'a refait pour manger autre chose. Je ne choisis pas. J'ai faim. Parle."),T_(KG,"Ne lui donne rien. Trace. Elle ne sait pas avaler ce qu'on écrit à la main : ça lui reste en travers.")])}
  else await D.say(J(BN,['言葉|ことば','を','ください','。'],'Donnez-moi des mots.'));
  const r=await Battle.start(EN.baku,{zone:11});
  if(r!=='win'){delete S.wins.baku;if(r==='lose')await D.say('Tu reprends tes esprits… Tes PV sont restaurés. La machine a avalé ta dernière phrase. Révise et reviens la lui reprendre.');else{await W.walk(H,OPP[H.dir],.2);H.cd=6}save();return}
  delete S.wins.baku;
  await D.say(["La cuve se fissure. Les plaques rougissent. La machine ne s'arrête pas : elle s'emballe.",J(BN,['もっと','！','もっと','！'],'Encore ! Encore !','もっと = plus, davantage'),T_(KG,"Elle recrache tout ce qu'elle a mangé. Attention : ce sont de vrais mots, et ils sont en colère d'avoir été avalés.")]);
  S.hp=Math.max(S.hp,Math.round(maxHp()*.6));
  await bakuRage();
  const r2=await Battle.start(EN.baku2,{zone:11});
  if(r2!=='win'){delete S.wins.baku2;if(r2==='lose')await D.say('Tu reprends tes esprits… Tes PV sont restaurés. Il faudra la vaincre deux fois de suite.');else{await W.walk(H,OPP[H.dir],.2);H.cd=6}save();return}
  S.wins.baku=1;S.fl.act2done=1;W.remove(e);save();
  await D.say(["La cuve éclate. Des milliers de feuillets s'envolent dans la halle, et sur chacun l'encre se remet en ordre.",J(BN,['ごちそうさま','でした','。'],"Merci pour ce repas.",'ごちそうさまでした : ce qu\'on dit en fin de repas'),T_(BN,"Je n'ai plus faim. C'est la première fois. … Les rêves avaient meilleur goût, de toute façon."),"La machine s'assoit lourdement, replie sa trompe, et s'endort comme un très gros chat de fonte.",T_(KG,"Les mots repartent chez eux. Tu entends ? Dans toute la ville, les gens retrouvent ce qu'ils voulaient dire."),T_(KG,"… Ne te réjouis pas trop vite. Cette bête, quelqu'un l'a commandée. Il est là-haut, dans son palais, et il vient de perdre son jouet préféré.")]);
  {const RO='Rōnin',H=W.H,ro=W.spawn({npc:1,spr:'ronin',x:H.x,y:H.y+3,dir:1,ev:'ronin'});await W.emote(ro);try{await W.walkNear(ro,H)}catch(x){}W.faceTo(H,ro);
   await D.say([J(RO,['遅い|おそい','。'],'Tu es lent.'),T_(RO,"… Non. Pas cette fois. Cette fois, tu es arrivé avant moi."),T_(RO,"Je dois te dire quelque chose, apprenti. Tetsu a été mon maître. Avant d'être un seigneur, c'était un lettré. Le meilleur calligraphe du pays. Il m'a appris à tenir un pinceau. J'étais mauvais. Il était patient.")]);
   await Cine.say('N_S7',[J('Kaito',['どうして','ですか','。'],'Pourquoi ?','どうして = pourquoi'),T_(RO,"Sa fille est morte il y a dix ans. Kiku. Elle avait l'âge de ta sœur. Il lui écrivait une lettre tous les soirs, et il allait la lire au dieu, en lui demandant de la lui rendre."),
    T_(RO,"Le dieu n'a jamais répondu. Alors Tetsu a conclu que les mots avaient un pouvoir, mais qu'il n'en avait pas assez. Il a décidé de les prendre tous. Tous les mots du pays, dans une seule machine, pour écrire une seule phrase : « Kiku est vivante. »")]);
   await D.say([T_(KG,"… Ça ne marche pas comme ça. Un mot volé ne veut plus rien dire. Il pourrait avaler la langue entière, la phrase resterait fausse."),T_(RO,"Je ne sais pas à qui tu parles quand tu regardes dans le vide, mais dis-lui que je suis d'accord."),
    J(RO,['行こう|いこう','。'],'Allons-y.','行こう : « allons-y », forme familière de 行きましょう'),T_(RO,"Il est là-haut. Il n'a plus de machine. Il lui reste le dieu, des scies, et dix ans de chagrin. C'est beaucoup plus dangereux."),"Il part devant, pour une fois. Dans la bonne direction. Tu ne le lui fais pas remarquer."]);
   for(let i=0;i<3;i++)await W.walk(ro,1,.16);W.remove(ro)}
  await Cine.say('N_S8',["Au-dessus des forges, le jour se lève. Les mots repartent vers les maisons, la ville basse, les rizières.",T_(KG,"Regarde-les. Chacun sait où il habite. … J'aimerais bien en dire autant.")]);
  music(null);if(typeof ActCard!=='undefined')await ActCard.show('第二幕 完','FIN DE L\'ACTE II','La machine s\'est tue');await More.actEnd(2);W.refreshZone();save()};
 PORT[BN]='PX_gbaku';PORT['Baku de fer déchaîné']='PX_gbaku';
})();

/* le Baku se déchaîne : la cuve tremble, éclate dans un flash, et la bête renaît plus grande en recrachant les mots avalés */
function bakuRage(){return new Promise(res=>{const app=$('#app'),box=document.createElement('div');box.className='brg';
 const W_='字言語文名音読書話聞山川火水木金土日月人',ws=Array.from({length:26},(_,i)=>{const a=i/26*Math.PI*2+Math.random()*.3,d=140+Math.random()*160;return `<i style="--x:${Math.cos(a)*d}px;--y:${Math.sin(a)*d}px;--r:${(Math.random()*2-1)*400}deg;animation-delay:${1.55+Math.random()*.35}s">${W_[i%W_.length]}</i>`}).join('');
 box.innerHTML=`<div class="brg-bg"></div><img class="brg-a" src="${IM.BT_baku||''}" alt=""><div class="brg-f"></div><img class="brg-b" src="${IM.BT_baku2||IM.BT_baku||''}" alt=""><div class="brg-w">${ws}</div><div class="brg-t"><b>獏 · 暴走</b><span>Le Baku de fer se déchaîne !</span></div>`;
 app.appendChild(box);try{music(null);sfx('alert')}catch(e){}
 setTimeout(()=>{try{sfx('hit')}catch(e){}},500);setTimeout(()=>{try{sfx('hit')}catch(e){}},950);setTimeout(()=>{try{sfx('boom')}catch(e){}},1450);setTimeout(()=>{try{sfx('crit')}catch(e){}},1700);
 const end=()=>{box.style.transition='opacity .35s';box.style.opacity=0;setTimeout(()=>{box.remove();res()},380)};setTimeout(end,3600);box.onclick=()=>{}})}

/* avant le combat, le Baku dort sous un tas de ferraille et de papier ; il en jaillit quand Kaito approche */
setInterval(()=>{try{if(typeof W==='undefined'||W.map!=='world')return;const e=W.ents.find(x=>x.id==='baku');if(!e)return;if(!S.fl.baku_in&&!S.wins.baku&&!e.rising){if(XI.X_BAKU0&&XI.X_BAKU0.width){const sh=Math.floor(performance.now()/90)%40<3;e.img=XI.X_BAKU0;e.img.hd=1}}else if(!e.rising)e.img=null}catch(x){}},120);
async function bakuRise(e){if(!XI.X_BAKU0||!XI.X_BAKU0.width)return;e.rising=1;try{music(null)}catch(x){}
 const st=k=>{const im=XI['X_BAKU'+k];im.hd=1;e.img=im};
 st(0);sfx('alert');for(let i=0;i<6;i++){W.shake(.25);sfx('hit');await wait(260)}
 st(1);sfx('boom');W.shake(.9);await wait(900);
 st(2);sfx('crit');W.shake(.5);await wait(1200);
 e.rising=0;e.img=XI.X_BAKU2}

/* ---------- 影 : d'où vient le démon, et ce qu'il dit en route (une scène par parcours) ---------- */
(()=>{
 const J=(n,jp,fr,x)=>({n,jp,fr,x}),T_=(n,t)=>({n,t}),KG='影',KA='Kaito';
 const KZ={
  1:["Tu marches entre les rizières. Depuis la nuit du feu, quelque chose marche avec toi, juste derrière tes côtes.",J(KA,['だれ','です','か','。'],'Qui es-tu ?','だれ = qui'),J(KG,['影|かげ','です','。'],'Je suis Kage.','影 (かげ) = ombre'),
   T_(KG,"Une ombre. Pas la tienne : celle de quelqu'un de beaucoup plus grand. Je me suis enfui, et cette nuit-là les Yōma ne venaient pas pour ta sœur. Ils venaient me reprendre."),
   T_(KA,"Alors pourquoi es-tu… dans moi ?"),T_(KG,"Tu avais le cœur grand ouvert et presque rien dedans : quelques kana, et des gâteaux de riz. Une maison vide, la porte pas fermée. Je suis entré. Je comptais ressortir au matin."),
   T_(KA,"Et mon ombre à moi ?"),T_(KG,"Je l'ai poussée un peu. Elle boude quelque part. Elle reviendra le jour où je partirai. Regarde par terre de temps en temps : si tu la vois, c'est que je ne suis plus là."),
   T_(KG,"Seulement voilà : tu as tracé 火. Un kanji tracé avec moi à l'intérieur, ça scelle. Je ne peux plus sortir, et toi, tu ne peux plus tracer sans moi. On est coincés ensemble, paysan."),
   J(KA,['外|そと','に','、','お願いします|おねがいします','。'],"Dehors, s'il te plaît.",'外 (そと) = dehors · お願いします = s\'il te plaît'),T_(KG,"J'adorerais. Trouve-moi qui m'a perdu, là-haut dans le nord, et on en reparle. En attendant, je vois par tes yeux, j'entends par tes oreilles, et je commente. C'est mon seul loisir."),
   T_(KG,"Tu peux me parler quand tu veux. En japonais, de préférence : c'est la seule langue qui me nourrit."),"Astuce : le bouton « 影 Démon », sous l'écran, ouvre une discussion libre avec Kage, à tout moment. Il te répond, te corrige, et se moque un peu."],
  2:[T_(KG,"Cette forêt… Je la connais. Les Kodama gardaient les racines. Ils chantaient. Maintenant ils mordent."),T_(KA,"Tu es déjà venu ici ?"),J(KG,['むかし','、','むかし','。'],'Il y a très, très longtemps.','むかし = autrefois'),T_(KG,"J'étais plus grand. J'avais un corps. Enfin, j'étais l'ombre d'un corps. Ne pose pas la question suivante, je n'ai pas la réponse."),
   T_(KG,"Et arrête de compter tes pas. Je t'entends. Tu comptes toujours quand tu as peur. Tu en es à trois cent douze."),J(KA,['三百十三|さんびゃくじゅうさん','。'],'Trois cent treize.','三百 (さんびゃく) = trois cents : après さん, ひゃく devient びゃく'),T_(KG,"… Tu viens de compter celui-là exprès.")],
  3:[T_(KG,"Tu sens cette odeur ? Non, toi tu sens la fumée. Moi, je sens ce qu'ils brûlent."),T_(KA,"Du charbon ?"),T_(KG,"Du Kiryoku. Ils le pompent, ils le pressent, ils le font tourner dans des roues. C'est comme si on faisait bouillir une chanson pour chauffer une soupe."),J(KG,['きらい','です','。'],'Je déteste ça.','きらい = détester')],
  4:[T_(KG,"Ces machines ont une voix. Tu ne l'entends pas. Elle dit toujours la même chose."),T_(KA,"Qu'est-ce qu'elle dit ?"),J(KG,['帰りたい|かえりたい','。'],'Je veux rentrer.','〜たい = vouloir · 帰ります (かえります) = rentrer'),T_(KG,"… C'est la mienne. C'est ma voix, découpée en morceaux et mise en bouteille. Avance. Je ne veux pas rester ici.")],
  5:[T_(KG,"Kaito. Sous ce puits, il y a un morceau de celui dont je suis l'ombre."),T_(KA,"Kurokami."),T_(KG,"Ne dis pas ce nom si fort. Il n'est pas méchant. Il est grand, il dort, et quelqu'un le débite comme du bois de chauffage. Chaque morceau qu'on lui prend se réveille seul, sans ombre, et devient fou."),J(KG,['助けて|たすけて','ください','。'],"Aide-le, s'il te plaît.",'助けます (たすけます) = aider, sauver'),T_(KG,"… Je n'ai rien dit. Tu n'as rien entendu. On y va.")],
  6:[T_(KG,"De la neige. Je n'en avais jamais vu par des yeux humains. C'est… non, rien."),T_(KA,"C'est beau ?"),J(KG,['寒い|さむい','です','。'],'Il fait froid.'),T_(KG,"Voilà ce que je voulais dire. Il fait froid. Uniquement ça. Arrête de sourire, je le sens quand tu souris, ça tire sur les côtes.")],
  7:[T_(KG,"Depuis le puits, je me souviens de plus de choses. C'est désagréable."),T_(KA,"De quoi ?"),T_(KG,"D'un homme qui venait parler au dieu, autrefois. Tous les soirs. Il lui lisait des lettres. Un jour, il est revenu avec des ingénieurs et des scies."),J(KG,['名前|なまえ','は','鉄|てつ','です','。'],"Son nom, c'est Tetsu.",'名前 (なまえ) = nom'),T_(KG,"Je voudrais savoir ce qu'il y avait dans la dernière lettre.")],
  8:[T_(KG,"Tout ce qui garde une porte sur cette route est un revenant. Tu l'as remarqué ?"),T_(KA,"Oui. Pourquoi ?"),T_(KG,"Parce que les vivants ont cessé de vouloir garder quoi que ce soit pour Tetsu. Il ne lui reste que ceux qui n'ont pas eu le choix."),J(KG,['かわいそう','です','ね','。'],"C'est triste pour eux, hein.",'かわいそう = pauvre, à plaindre'),T_(KG,"Ne le répète pas. J'ai une réputation de démon à tenir.")],
  9:[T_(KG,"Regarde en haut. Toute une ville posée sur une autre. Ceux d'en bas n'ont plus de jour, et ceux d'en haut n'ont plus d'ombre."),T_(KA,"Plus d'ombre ?"),T_(KG,"Les lampes de Tetsu éclairent de partout à la fois. Rien ne fait d'ombre, là-haut. C'est très propre. C'est ce qu'il veut faire au monde entier."),J(KG,['こわい','です','。'],"Ça me fait peur.",'こわい = avoir peur, effrayant'),T_(KG,"Moi. Peur. Note la date.")],
  10:[T_(KG,"Ils recopient des kanji à la machine. Des milliers à l'heure. Tu sais ce que ça fait, un mot que personne n'a pensé ?"),T_(KA,"Non."),T_(KG,"Rien. Il ne fait rien. Il est là, il a la bonne forme, et il est mort. Tes kanji à toi sont tordus, hésitants, vivants. C'est pour ça qu'ils mordent."),J(KG,['上手|じょうず','に','なりました','ね','。'],'Tu as fait des progrès, hein.','上手 (じょうず) = habile'),T_(KG,"C'est un constat. Pas un compliment. Les démons ne font pas de compliments.")],
  16:[T_(KG,"Le cœur. Il est là, derrière les murs. Il bat si fort que les étagères tremblent."),T_(KA,"Kage… ça va ?"),T_(KG,"Non. Il m'appelle. Une partie de moi veut y aller toute seule et se recoller à lui."),J(KG,['手|て','を','離さないで|はなさないで','。'],'Ne me lâche pas la main.','離さないで (はなさないで) = ne lâche pas'),T_(KG,"Je n'ai pas de main. Je sais. Fais semblant.")],
  15:[T_(KG,"Regarde au nord. Derrière les nuages."),T_(KA,"La citadelle…"),T_(KG,"Le cœur bat plus fort, ici. Il est tout proche. Chaque battement me tire vers là-haut, comme un fil."),J(KG,['北|きた','へ','行きましょう|いきましょう','。'],'Allons au nord.','北 (きた) = nord · 〜ましょう = allons…'),T_(KG,"Et quand on y sera… ne me laisse pas redevenir ce que j'étais. Promets-le. Non, ne dis rien. Fais-le, c'est tout.")],
  14:[T_(KG,"Tu l'entends ? Sous les jardins. Boum… boum…"),T_(KA,"Les horloges ?"),T_(KG,"Non. Derrière les horloges. Tetsu a branché tous ces mécanismes sur quelque chose qui bat. Un cœur. Énorme. Endormi."),J(KG,['神様|かみさま','の','心|こころ','です','。'],"C'est le cœur du dieu.",'神様 (かみさま) = dieu · 心 (こころ) = cœur'),T_(KG,"Il fait tourner son empire avec le cœur de celui dont je suis l'ombre. Il le remonte comme une montre.")],
  13:[T_(KG,"Les renards me regardent. Ils me voient, Kaito. Tous."),T_(KA,"C'est grave ?"),T_(KG,"Les renards gardaient les sanctuaires du dieu, autrefois. Ils reconnaissent son ombre. Pour eux, je suis… une relique. Un morceau sacré."),J(KG,['はずかしい','です','。'],"C'est gênant.",'はずかしい = gênant, avoir honte'),T_(KG,"Une petite renarde m'a fait une révérence. Je ne sais pas quoi faire de mes bras. Je n'ai pas de bras. C'est encore pire.")],
  12:[T_(KG,"Kaito. Ce dirigeable noir, je l'ai senti passer. Il y avait quelque chose de moi à bord."),T_(KA,"Hana ?"),T_(KG,"Ta sœur aussi. Mais à côté d'elle, dans un coffre scellé, il y avait un morceau du dieu. Tetsu les a rangés ensemble, comme deux choses qu'on emporte en voyage."),J(KG,['どうして','です','か','。'],'Pourquoi ?','どうして = pourquoi'),T_(KG,"Je ne sais pas. Et je déteste ne pas savoir. Avance. Plus vite que ça.")],
  11:[T_(KG,"C'est ici. Tout ce qu'on lui a pris finit dans ces fourneaux."),T_(KA,"On va l'arrêter."),T_(KG,"Kaito, écoute. Si on rend ses morceaux au dieu, il se réveille. Et quand il se réveillera, il voudra récupérer son ombre."),J(KA,['行かないで|いかないで','ください','。'],"Ne pars pas, s'il te plaît.",'〜ないでください = ne fais pas…, s\'il te plaît'),T_(KG,"… Tu m'as demandé de sortir, dans les rizières. Décide-toi, paysan."),"Il ne dit plus rien pendant un long moment. Tu sens quand même qu'il est là."]};
 /* à trois moments, c'est Kaito qui répond : la réaction de Kage dépend de la phrase choisie */
 const KC={2:{q:J(KG,['森|もり','が','好き|すき','です','か','。'],'Tu aimes la forêt ?','好き (すき) = aimer · 〜が好きですか = « tu aimes… ? »'),o:[
    [['はい','、','好き|すき','です','。'],'Oui, je l\'aime.',[T_(KG,"Alors regarde-la bien. Elle ne sera plus là quand Tetsu aura fini de la compter en planches.")]],
    [['いいえ','、','こわい','です','。'],'Non, elle fait peur.',[T_(KG,"Enfin une réponse honnête. Elle me fait peur aussi, et je suis précisément ce qui fait peur dans les forêts.")]],
    [['森|もり','は','大きい|おおきい','です','。'],'La forêt est grande.',[T_(KG,"Ce n'était pas la question. Mais la phrase est correcte, et à ton niveau, je prends.")]]]},
  6:{q:J(KG,['寒い|さむい','です','か','。'],'Tu as froid ?','寒い (さむい) = froid, quand on parle du temps qu\'il fait'),o:[
    [['はい','、','寒い|さむい','です','。'],'Oui, j\'ai froid.',[T_(KG,"Bien. Moi, je ne sens rien du tout. Décris-moi. Non, pas en français : je ne m'en nourris pas.")]],
    [['いいえ','、','大丈夫|だいじょうぶ','です','。'],'Non, ça va.',[T_(KG,"Menteur. Tes dents claquent. Je les entends de l'intérieur, c'est assourdissant.")]],
    [['雪|ゆき','は','きれい','です','。'],'La neige est belle.',[T_(KG,"… Oui. C'est exactement ce que j'allais dire, juste avant de me retenir.")]]]},
  16:{q:J(KG,['テツ','に','何|なに','が','ほしい','です','か','。'],'Qu\'est-ce que tu veux de Tetsu ?','ほしい = vouloir (avoir) · la leçon de Tanuki'),o:[
    [['花|はな','が','ほしい','です','。'],'Je veux Hana.',[T_(KG,"Hana n'est pas une chose qu'on veut, c'est quelqu'un qu'on va chercher. Mais j'ai compris l'idée.")]],
    [['名前|なまえ','を','返して|かえして','ほしい','です','。'],'Qu\'il rende les noms.',[T_(KG,"Tous ? Il y en a des millions. On va avoir besoin d'un très grand sac.")]],
    [['何|なに','も','いりません','。'],'Rien du tout.',[T_(KG,"Rien. Même pas une vengeance. … Tu es bizarre, Kaito. C'est pour ça que je reste.")]]]},
  15:{q:J(KG,['北|きた','へ','行かないで|いかないで','と','言ったら|いったら','、','どうします','か','。'],'Si je te disais de ne pas aller au nord, tu ferais quoi ?','〜ないで = sans faire, ne pas… (la leçon de Tanuki)'),o:[
    [['行きます|いきます','。'],'J\'y vais quand même.',[T_(KG,"Évidemment. Je ne sais même pas pourquoi je pose la question. Si : pour t'entendre le dire.")]],
    [['いっしょ','に','行きましょう|いきましょう','。'],'Allons-y ensemble.',[T_(KG,"Ensemble. Tu dis ça à une ombre. Tu sais qu'on ne peut pas se séparer, de toute façon ? … C'est gentil quand même.")]],
    [['どうして','です','か','。'],'Pourquoi ?',[T_(KG,"Parce que j'ai peur de ce que je serai, là-haut. Voilà. C'est dit. N'en parle pas au tanuki.")]]]},
  14:{q:J(KG,['テツ','は','悪い|わるい','人|ひと','だ','と','思います|おもいます','か','。'],'Tu penses que Tetsu est quelqu\'un de mauvais ?','〜と思いますか = penses-tu que… (la leçon de Tanuki)'),o:[
    [['はい','、','悪い|わるい','と','思います|おもいます','。'],'Oui, je pense qu\'il est mauvais.',[T_(KG,"Il a enlevé ta sœur et débité un dieu. Je ne vais pas te contredire.")]],
    [['わかりません','。'],'Je ne sais pas.',[T_(KG,"… Moi non plus. Un homme qui écrit une lettre à sa fille morte tous les soirs, ce n'est pas un monstre. C'est pire : c'est quelqu'un de triste avec des scies.")]],
    [['かなしい','人|ひと','だ','と','思います|おもいます','。'],'Je pense que c\'est quelqu\'un de triste.',[T_(KG,"Tu as appris ça où, la pitié ? … Non, ne réponds pas. C'est le tanuki. C'est toujours le tanuki.")]]]},
  13:{q:J(KG,['家族|かぞく','に','会いたい|あいたい','です','か','。'],'Tu as envie de revoir ta famille ?','会いたい = « vouloir voir » (〜たい : la leçon de Tanuki)'),o:[
    [['はい','、','会いたい|あいたい','です','。'],'Oui, j\'en ai envie.',[T_(KG,"Moi aussi. Enfin, je crois. Je ne suis pas sûr d'avoir une famille. J'ai un dieu, ce n'est pas pareil.")]],
    [['花|はな','に','会いたい|あいたい','です','。'],'Je veux voir Hana.',[T_(KG,"Évidemment. On y va. Le tanuki a eu ses retrouvailles, tu auras les tiennes. Avec moins de rouleau à pâtisserie, j'espère.")]],
    [['今|いま','は','会いたくない|あいたくない','です','。'],'Pas maintenant.',[T_(KG,"Menteur. Ton cœur vient de faire un bond. Je l'ai pris en pleine figure.")]]]},
  12:{q:J(KG,['花|はな','は','強い|つよい','です','か','。'],'Hana est forte ?','強い (つよい) = fort'),o:[
    [['はい','、','とても','強い|つよい','です','。'],'Oui, très forte.',[T_(KG,"Alors elle tiendra. Elle aura mordu deux ou trois gardes de plus avant qu'on arrive. Je commence à l'apprécier.")]],
    [['わかりません','。'],'Je ne sais pas.',[T_(KG,"Moi, je sais. Elle t'écrit avec des taches de sauce et elle se moque d'un tanuki. On ne casse pas les gens comme ça.")]],
    [['私|わたし','より','強い|つよい','です','。'],'Plus forte que moi.',[T_(KG,"… Oui. Beaucoup plus. C'est très rassurant, quand on y pense.")]]]},
  9:{q:J(KG,['上|うえ','に','行きたい|いきたい','です','か','。'],'Tu veux monter là-haut ?','上 (うえ) = en haut · 行きたい = vouloir aller'),o:[
    [['はい','、','行きたい|いきたい','です','。'],'Oui, je veux y aller.',[T_(KG,"Évidemment. Tous ceux d'en bas le veulent. C'est exactement comme ça qu'on les tient.")]],
    [['いいえ','、','ここ','に','います','。'],'Non, je reste ici.',[T_(KG,"Noble. Inutile, mais noble. On montera quand même.")]],
    [['どうして','です','か','。'],'Pourquoi ?',[T_(KG,"Parce que Tetsu est là-haut, et que j'ai deux mots à lui dire. En japonais. Donc ce sera long.")]]]}};
 const o=STORY.triggers;STORY.triggers=(x,y)=>{const t=o(x,y);if(t||!S.fl.act1||S.fl.noscn||W.map!=='world')return t;const z=W.zone();
  if(KZ[z]&&!S.fl['kz'+z]&&!HAMS.some(h=>y>=h.y0&&y<=h.y1)&&(z!==6||S.fl.act2c))return async()=>{S.fl['kz'+z]=1;save();const im={1:'N_S1',7:'N_S4'}[z];if(im)await Cine.say(im,KZ[z]);else await D.say(KZ[z]);if(KC[z]){const C=KC[z],i=await D.ask(C.q,C.o.map(o=>({jp:o[0],fr:o[1]})));S.fl['kc'+z]=i+1;save();await D.say(C.o[i][2])}};return t};
})();

/* ---------- deux quêtes par bourg : celles de Kome, du hameau des cendres et de tout l'acte II ---------- */
(()=>{
 const J=(n,jp,fr,x)=>({n,jp,fr,x}),qs=()=>S.qs||(S.qs={}),qn=()=>S.qn||(S.qn={}),YN=[{jp:['はい'],fr:'Oui'},{jp:['いいえ'],fr:'Pas maintenant'}];
 const O3=(...a)=>a.map(jp=>({jp,fr:'…'}));
 const NQ={
  k1:{who:'kid',n:'Enfant',name:'Le goûter du petit',gold:20,type:'give',it:'oni',nb:1,todo:'Donne un onigiri à l\'enfant du village de Kome.',intro:[J('Enfant',['おにぎり','を','ください','！'],'Un onigiri, s\'il te plaît !','ください = « donne-moi, s\'il te plaît »'),{n:'Enfant',t:'Hana dit que tu en as plein les poches depuis que tu es un héros. Un seul. Je ne dirai rien à personne.'}],wait:'Tu n\'as pas d\'onigiri ? Et tu te dis héros.',thanks:J('Enfant',['おいしい','！'],'C\'est bon !','おいしい = délicieux')},
  k2:{who:'fisher',n:'Pêcheur',name:'La question du pêcheur',gold:20,type:'ask',todo:'Réponds en japonais au pêcheur du village de Kome.',intro:[{n:'Pêcheur',t:'Toi qui voyages, maintenant… réponds-moi franchement.'}],q:J('Pêcheur',['魚|さかな','が','好き|すき','です','か','。'],'Tu aimes le poisson ?','好き (すき) = aimer'),o:O3(['はい','、','好き|すき','です','。'],['いいえ','、','魚|さかな','です','。'],['魚|さかな','は','どこ','です','か','。']),a:0,no:'Le pêcheur te regarde, perplexe. Ce n\'était pas la question. Réessaie quand tu veux.',win:J('Pêcheur',['よかった','。'],'Tant mieux.','よかった = « tant mieux », le passé de いい')},
  q8:{who:'h50',after:'q4',name:'Les lances rouillées',gold:90,type:'hunt',kind:'hone',nb:2,todo:'Abats deux Fantassins d\'os près du vieux puits, puis retourne voir le vieil homme.',intro:[J(0,['骨|ほね','の','兵|へい','が','います','。'],'Il y a des soldats d\'os.','骨 (ほね) = os'),{t:'Ce sont nos anciens. Ils gardaient le village de leur vivant, ils continuent. Rends-leur le repos, mon garçon : ils l\'ont mérité.'}],wait:'Ils marchent encore, là-haut.',thanks:J(0,['ありがとう','。','やっと','休めます|やすめます','。'],'Merci. Ils peuvent enfin se reposer.','やっと = enfin')},
  a60:{who:'h60',name:'Du thé pour les porteurs',gold:70,type:'give',it:'cha',nb:2,todo:'Apporte deux thés au porteur du Refuge du col.',intro:[J(0,['お茶|おちゃ','を','二つ|ふたつ','お願い|おねがい','します','。'],'Deux thés, s\'il vous plaît.','お願いします = « je vous en prie », pour demander'),{t:'Mes gars sont coincés dans la remise depuis trois jours. Deux thés chauds, et ils te porteront en triomphe. Enfin, sur dix mètres.'}],wait:'Deux thés. La marchande du refuge en vend.',thanks:J(0,['助かりました|たすかりました','。'],'Tu nous sauves.','助かりました = « ça m\'a bien aidé »')},
  a61:{who:'h61',name:'Les bouilloires du col',gold:80,type:'hunt',kind:'yukidama',nb:2,todo:'Fais taire deux Bouilloires des neiges sur le col, puis retourne voir la voyageuse.',intro:[J(0,['外|そと','は','うるさい','です','。'],'Dehors, c\'est bruyant.','うるさい = bruyant'),{t:'Des bouilloires qui sifflent dans la neige, toute la nuit. Je sers du thé depuis trente ans : je ne supporte plus ce bruit. Fais-en taire deux.'}],wait:'Je les entends encore siffler.',thanks:J(0,['静か|しずか','に','なりました','。'],'C\'est devenu calme.','〜になりました = est devenu')},
  a70:{who:'h70',name:'Une chambre pour un',gold:70,type:'ask',todo:'Réponds en japonais à l\'aubergiste du Relais.',intro:[{t:'Avant de te donner une clé, il faut remplir le registre. Voyons si tu sais répondre comme un vrai voyageur.'}],q:J(0,['何名様|なんめいさま','です','か','。'],'Vous êtes combien ?','何名様 (なんめいさま) = combien de personnes, très poli'),o:O3(['一人|ひとり','です','。'],['一時|いちじ','です','。'],['一つ|ひとつ','ください','。']),a:0,no:'L\'aubergiste note quelque chose, soupire et efface. Réessaie quand tu veux.',win:J(0,['かしこまりました','。'],'Très bien, monsieur.','かしこまりました : « c\'est entendu », très poli')},
  a71:{who:'h71',name:'Les renards voleurs',gold:90,type:'hunt',kind:'kitsune',nb:3,todo:'Chasse trois Renards voyageurs sur la grand-route, puis retourne voir le garde du relais.',intro:[J(0,['きつね','が','手形|てがた','を','取りました|とりました','。'],'Les renards ont pris les laissez-passer.','取ります (とります) = prendre'),{t:'Trois renards. Trois laissez-passer. Ils se déguisent en fonctionnaires, maintenant. L\'un d\'eux m\'a demandé mes papiers.'}],wait:'Ils courent toujours sur la route.',thanks:J(0,['ご苦労|ごくろう','さま','でした','。'],'Merci pour ta peine.','ご苦労さまでした : ce qu\'on dit à quelqu\'un qui a bien travaillé')},
  a80:{who:'h80',name:'Les mécaniciens du ponton',gold:90,type:'hunt',kind:'kappa',nb:2,todo:'Chasse deux Kappa mécaniciens au bord du fleuve, puis retourne voir le vieux passeur.',intro:[J(0,['かっぱ','が','船|ふね','を','こわしました','。'],'Les kappa ont cassé le bateau.','こわします = casser'),{t:'Ils disent qu\'ils le « réparent ». Il flottait très bien avant qu\'ils le réparent.'}],wait:'Ils sont encore sous le ponton, avec des outils.',thanks:J(0,['船|ふね','は','大丈夫|だいじょうぶ','です','。'],'Le bateau va bien.','大丈夫 (だいじょうぶ) = ça va, pas de problème')},
  a81:{who:'h81',name:'Le jour du marché',gold:70,type:'ask',todo:'Réponds en japonais à la poissonnière du Bourg des passeurs.',intro:[{t:'Je te garde le plus beau poisson, mais dis-moi quand tu repasses. Et dis-le bien, que je note.'}],q:J(0,['いつ','来ます|きます','か','。'],'Tu viens quand ?','いつ = quand'),o:O3(['土曜日|どようび','に','来ます|きます','。'],['土曜日|どようび','が','好き|すき','です','。'],['土曜日|どようび','から','です','。']),a:0,no:'La poissonnière fronce les sourcils. Ça ne répond pas à « quand ». Réessaie quand tu veux.',win:J(0,['じゃ','、','土曜日|どようび','に','。'],'Alors, à samedi.','じゃ = alors, bon')},
  a90:{who:'h90',name:'Tapage nocturne sur les toits',gold:95,type:'hunt',kind:'nekomata',nb:2,todo:'Fais descendre deux Nekomata ramoneurs des toits de la ville basse, puis retourne voir l\'agent.',intro:[J(0,['屋根|やね','の','上|うえ','に','猫|ねこ','が','います','。'],'Il y a des chats sur les toits.','屋根 (やね) = toit'),{t:'Avec deux queues, un balai et aucun respect du règlement. Je ne peux pas monter : j\'ai le vertige et un uniforme neuf.'}],wait:'Ça miaule toujours là-haut.',thanks:J(0,['よく','やりました','。'],'Beau travail.')},
  a91:{who:'h91',name:'Le crieur perdu',gold:75,type:'ask',todo:'Indique son chemin en japonais au petit crieur de la ville basse.',intro:[{t:'Psst. Je dois livrer des journaux à la station du funiculaire et… je ne sais pas où c\'est. Ne le dis à personne, je suis du quartier.'}],q:J(0,['駅|えき','は','どこ','に','あります','か','。'],'Où se trouve la station ?'),o:O3(['銭湯|せんとう','の','後ろ|うしろ','に','あります','。'],['銭湯|せんとう','の','上|うえ','に','います','。'],['駅|えき','が','あります','。']),a:0,no:'Le crieur part dans la mauvaise direction, revient, et te regarde avec reproche. Réessaie quand tu veux.',win:J(0,['わかりました','！','ありがとう','！'],'Compris ! Merci !','わかりました = j\'ai compris')},
  a100:{who:'h100',name:'La nuit blanche',gold:80,type:'give',it:'cha',nb:3,todo:'Apporte trois thés à l\'étudiant de l\'Académie.',intro:[J(0,['お茶|おちゃ','を','三つ|みっつ','ください','。'],'Trois thés, s\'il te plaît.','三つ (みっつ) = trois (objets)'),{t:'L\'examen est demain. Enfin, il est demain depuis six ans. Trois thés et je tiens jusqu\'à l\'aube.'}],wait:'Trois thés. Je ne dors pas, je compte.',thanks:J(0,['これ','で','大丈夫|だいじょうぶ','です','。'],'Avec ça, ça ira.')},
  a101:{who:'h101',name:'L\'encre volée',gold:95,type:'hunt',kind:'suzuri',nb:2,todo:'Rattrape deux Pierres à encre dans les jardins de l\'Académie, puis retourne voir la petite calligraphe.',intro:[J(0,['墨|すみ','が','ありません','。'],'Je n\'ai plus d\'encre.','墨 (すみ) = encre'),{t:'Elle est partie. Sur ses pattes. Elle a dit que mon écriture la fatiguait. Rattrape-en deux, je choisirai la plus polie.'}],wait:'Elles courent encore dans les jardins.',thanks:J(0,['ありがとう','。','また','書けます|かけます','。'],'Merci. Je peux écrire à nouveau.','書けます (かけます) = pouvoir écrire')},
  a110:{who:'h110',name:'Le casse-croûte de l\'équipe',gold:90,type:'give',it:'oni',nb:3,todo:'Apporte trois onigiri au fondeur des Grandes Forges.',intro:[J(0,['おにぎり','を','三つ|みっつ','お願い|おねがい','します','。'],'Trois onigiri, s\'il vous plaît.'),{t:'La cantine ne prend que les bons de Tetsu, et on nous paie en retard. Trois onigiri pour l\'équipe du four, et je te revaudrai ça en vraies pièces.'}],wait:'Trois onigiri. On a faim, mais on est patients : on est fondeurs.',thanks:J(0,['いただきます','！'],'Merci pour ce repas !','いただきます : ce qu\'on dit avant de manger')},
  a111:{who:'h111',name:'Cent ou mille',gold:80,type:'ask',todo:'Réponds en japonais au petit porteur des Grandes Forges.',intro:[{t:'On m\'a payé avec deux billets. Un où il y a écrit 百, un où il y a écrit 千. Je ne sais pas lequel garder pour maman.'}],q:J(0,['どちら','が','高い|たかい','です','か','。'],'Lequel vaut le plus ?','どちら = lequel des deux'),o:O3(['千|せん','円|えん','の','ほう','が','高い|たかい','です','。'],['百|ひゃく','円|えん','の','ほう','が','高い|たかい','です','。'],['千|せん','円|えん','は','安い|やすい','です','。']),a:0,no:'Le petit porteur hésite. Il sent que ce n\'est pas ça. Réessaie quand tu veux.',win:J(0,['千|せん','円|えん','！','ありがとう','！'],'Mille yens ! Merci !')},
  a120:{who:'h120',name:'Les chats de foudre',gold:95,type:'hunt',kind:'raiju',nb:2,todo:'Chasse deux Raijū des fusibles sur les pontons du port, puis retourne voir la mécanicienne.',intro:[J(0,['雷|かみなり','の','動物|どうぶつ','が','います','。'],'Il y a des bêtes de foudre.','雷 (かみなり) = foudre · 動物 (どうぶつ) = animal'),{t:'Des Raijū. Ils dorment dans les moteurs et ils mangent les éclairs. Comme il n\'y a plus d\'orage, ils mangent les fusibles. Chasses-en deux et je te devrai une hélice.'}],wait:'Ils grésillent encore sous les pontons.',thanks:J(0,['電気|でんき','が','戻りました|もどりました','。'],'Le courant est revenu.','戻ります (もどります) = revenir')},
  a121:{who:'h121',name:'Le tableau des départs',gold:85,type:'ask',todo:'Réponds en japonais au chef de gare du port.',intro:[{t:'Le tableau des départs indique 三時 pour le prochain dirigeable. Moi, je ne sais plus lire les heures depuis que la bête crie. Dis-moi, toi : il part à quelle heure ?'}],q:J(0,['次|つぎ','の','船|ふね','は','何時|なんじ','に','出ます|でます','か','。'],'À quelle heure part le prochain dirigeable ?','何時 (なんじ) = quelle heure · 出ます (でます) = partir'),o:O3(['三時|さんじ','に','出ます|でます','。'],['三時|さんじ','です','か','。'],['三つ|みっつ','です','。']),a:0,no:'Le chef de gare note ta réponse, la regarde longuement, et la raye. Réessaie quand tu veux.',win:J(0,['三時|さんじ','！','ありがとう','ございます','。'],'Trois heures ! Merci beaucoup.')},
  a130:{who:'h130',name:'Les veilleurs aux mains',gold:100,type:'hunt',kind:'tenome',nb:2,todo:'Chasse deux Tenome horlogers dans la forêt, puis retourne voir la doyenne des renards.',intro:[J(0,['手|て','に','目|め','が','あります','。'],'Ils ont des yeux dans les mains.','手 (て) = main · 目 (め) = œil'),{t:'Les Tenome rôdent autour du village et regardent par nos fenêtres. Avec les mains. C\'est très impoli. Chasses-en deux.'}],wait:'Ils regardent encore par les fenêtres.',thanks:J(0,['よく','見えません|みえません','。','いい','です','ね','。'],'On ne voit plus rien. C\'est bien.')},
  a131:{who:'h131',name:'La lettre sans adresse',gold:90,type:'ask',todo:'Réponds en japonais à la messagère renarde.',intro:[{t:'J\'ai une lettre pour « le grand frère de la fille du dirigeable noir ». C\'est toi ? Réponds bien, je n\'ai pas le droit de me tromper deux fois cette semaine.'}],q:J(0,['だれ','に','会いたい|あいたい','です','か','。'],'Qui veux-tu voir ?','会いたい = vouloir voir'),o:O3(['妹|いもうと','に','会いたい|あいたい','です','。'],['妹|いもうと','が','会いました|あいました','。'],['妹|いもうと','です','か','。']),a:0,no:'La messagère renifle la lettre, puis toi, et secoue la tête. Réessaie quand tu veux.',win:J(0,['じゃあ','、','これ','は','あなた','の','です','。'],'Alors, elle est pour toi.')},
  a160:{who:'h160',name:'Le nom de Sumi',gold:120,type:'hunt',kind:'mushi',nb:2,todo:'Chasse deux Tetsu-mushi qui découpent les registres de la bibliothèque, puis retourne voir Sumi.',intro:[J(0,['名前|なまえ','を','切らないで|きらないで','！'],'Ne découpez pas les noms !','切ります (きります) = couper'),{t:'Les scarabées découpent les registres. Si l\'un d\'eux avale la page où est mon nom, je ne le retrouverai jamais. Chasses-en deux.'}],wait:'On entend encore claquer leurs ciseaux dans les rayons.',thanks:J(0,['すみ','…','私|わたし','は','すみ','です','！'],'Sumi… Je m\'appelle Sumi !')},
  a161:{who:'h161',name:'La question de Grand-père Hon',gold:110,type:'ask',todo:'Réponds en japonais à Grand-père Hon.',intro:[{t:'Mon livre est vide, mais ma tête marche encore un peu. Dis-moi : quand deux personnes se voient pour la première fois, que disent-elles ?'}],q:J(0,['初めて|はじめて','会った|あった','人|ひと','に','何|なん','と','言います|いいます','か','。'],'Que dit-on à quelqu\'un qu\'on rencontre pour la première fois ?','初めて (はじめて) = pour la première fois · 会う (あう) = rencontrer'),o:O3(['はじめまして','。'],['さようなら','。'],['おやすみなさい','。']),a:0,no:'Grand-père Hon fronce les sourcils : « Non, ça, c\'est pour partir. » Réessaie.',win:J(0,['はじめまして','！','そう','です','！'],'Enchanté ! C\'est ça !')},
  a170:{who:'h170',name:'Le nom dans la bouteille',gold:120,type:'ask',todo:'Lis en japonais le nom que Sango a trouvé dans une bouteille.',intro:[{t:'Celle-là, je n\'arrive pas à la lire. Il y a écrit かにまる. C\'est un nom de personne ? De bateau ? De crabe ?'}],q:J(0,['かにまる','は','何|なん','です','か','。'],'Kanimaru, c\'est quoi ?','何 (なん) = quoi'),o:O3(['バス','の','名前|なまえ','です','。'],['魚|さかな','の','名前|なまえ','です','。'],['名前|なまえ','じゃ','ない','です','。']),a:0,no:'Sango secoue la bouteille. « Non… Ça ne colle pas. Il y a un dessin de crabe à roulettes à côté. » Réessaie.',win:J(0,['バス','！','カニバス','の','名前|なまえ','です','ね','！'],'Le bus ! C\'est le nom du Kani-bus !')},
  a171:{who:'h171',name:'Les requins des sables',gold:120,type:'hunt',kind:'isonade',nb:2,todo:'Chasse deux Isonade qui nagent dans le sable de la route côtière, puis retourne voir la pêcheuse.',intro:[J(0,['砂|すな','の','中|なか','に','さめ','が','います','。'],'Il y a des requins dans le sable.','砂 (すな) = sable · さめ = requin'),{t:'Ils mordent les filets qu\'on fait sécher. Et les mollets de ceux qui font sécher les filets. Chasses-en deux sur la route.'}],wait:'On voit encore des ailerons sortir du sable.',thanks:J(0,['もう','こわくない','！'],'Je n\'ai plus peur !')},
  a180:{who:'h180',name:'La soupe en or',gold:130,type:'give',it:'oni',nb:3,todo:'Apporte trois onigiri à Okayu, la cuisinière du palais.',intro:[J(0,['スープ','が','金|きん','に','なりました','。'],'La soupe est devenue de l\'or.','〜になりました = est devenu'),{t:'Depuis que l\'Empereur a reçu l\'horloge dorée de Tetsu, tout ce que je cuisine se change en or. Le riz, la soupe, les nouilles. Le palais a faim. Trois onigiri, s\'il te plaît : faits dehors, loin de cette horloge.'}],wait:'Trois onigiri. Pas en or, hein.',thanks:J(0,['やっと','食べられる|たべられる','！'],'Enfin quelque chose qui se mange !')},
  a181:{who:'h181',name:'La monnaie de travers',gold:130,type:'hunt',kind:'zeni',nb:2,todo:'Chasse deux Zeni-gami qui rendent mal la monnaie dans les faubourgs, puis retourne voir Pika.',intro:[J(0,['お釣り|おつり','が','おかしい','です','。'],'La monnaie n\'est pas normale.','おかしい = bizarre, anormal'),{t:'Les petits dieux des pièces rendent la monnaie de travers. On leur donne cent yens, ils rendent trois cents yens… en boutons. Chasses-en deux dans les faubourgs.'}],wait:'J\'ai encore reçu un bouton à la place d\'une pièce ce matin.',thanks:J(0,['ちゃんと','した','お金|おかね','！','ピカピカ','！'],'Des vraies pièces ! Toutes brillantes !','ピカピカ = qui brille')},
  a210:{who:'h212',name:'Les lanternes qui se promènent',gold:160,type:'hunt',kind:'toro',nb:2,todo:'Ramène au calme deux Tōrō dans les jardins du temple, puis retourne voir le kodama de la cour.',intro:[J(0,['灯籠|とうろう','が','歩いて|あるいて','います','。'],'Les lanternes marchent.','歩いています = être en train de marcher'),{t:'(Le kodama montre une lanterne de pierre qui traverse le jardin, puis une autre. Il croise les bras. Une lanterne, ça ne doit pas marcher. Il te demande d\'en calmer deux.)'}],wait:'(Le kodama montre encore une lanterne qui se balade.)',thanks:J(0,['ありがとう','！'],'Merci !')},
  a211:{who:'h211',name:'Le goûter des kodama',gold:160,type:'give',it:'oni',nb:3,todo:'Apporte trois onigiri au kodama de l\'étang.',intro:[J(0,['おなか','が','すきました','。'],'J\'ai faim.','おなかがすきました = j\'ai faim'),{t:'(Le kodama tapote son ventre tout rond, montre ton sac, puis lève trois doigts. Il en a quatre. Il en cache un.)'}],wait:'(Le kodama lève trois doigts, très sérieusement.)',thanks:J(0,['おいしい','！'],'Délicieux !')},
  a200:{who:'h203',name:'La moisissure de la cantine',gold:150,type:'hunt',kind:'kabi',nb:2,todo:'Chasse deux Kabi-bōzu dans les galeries, puis retourne voir la cuisinière de la mine.',intro:[J(0,['台所|だいどころ','に','カビ','が','います','。'],'Il y a de la moisissure dans la cuisine.','台所 (だいどころ) = cuisine'),{t:'Des moisissures qui rient ! Elles sortent de la mine et viennent goûter ma soupe. Ma soupe ne rit pas, elle. Chasses-en deux dans les galeries, s\'il te plaît.'}],wait:'Encore une qui ricane dans la marmite.',thanks:J(0,['きれい','に','なりました','！'],'C\'est redevenu propre !','きれいになりました = c\'est devenu propre')},
  a201:{who:'h200',name:'Le thé du vieux mineur',gold:150,type:'give',it:'cha',nb:2,todo:'Apporte deux thés au vieux mineur, près de l\'autel-foreuse.',intro:[J(0,['お茶|おちゃ','が','もう','ありません','。'],'Je n\'ai plus de thé.','もう + négatif = plus du tout'),{t:'Quarante ans de mine, et jamais un jour sans thé. Aujourd\'hui, la boîte est vide. Je ne peux pas descendre comme ça : la mine le sentirait. Deux thés, s\'il te plaît.'}],wait:'Deux thés. La mine attend. Elle est patiente, mais moi non.',thanks:J(0,['ああ','、','おいしい','。','元気|げんき','が','出ます|でます','。'],'Ah, que c\'est bon. Ça redonne des forces.','元気が出ます = reprendre des forces')},
  a190:{who:'h190',name:'Les onigiri du guide',gold:140,type:'give',it:'oni',nb:3,todo:'Apporte trois onigiri au guide de montagne : les corbeaux lui ont tout volé.',intro:[J(0,['おにぎり','が','ありません','。'],'Je n\'ai plus d\'onigiri.','ありません = il n\'y a pas'),{t:'Les corbeaux du Grand Tengu m\'ont tout pris. Je ne peux pas guider les gens le ventre vide : je les emmène toujours vers la cuisine. Trois onigiri, s\'il te plaît.'}],wait:'Trois onigiri. Cache-les bien : les corbeaux regardent.',thanks:J(0,['おいしい','！','元気|げんき','に','なりました','。'],'Délicieux ! Je suis requinqué.','元気になりました = je suis en forme')},
  a191:{who:'h191',name:'Les araignées des marches',gold:140,type:'hunt',kind:'ishigumo',nb:2,todo:'Chasse deux araignées de pierre sur la route de montagne, puis retourne voir la pèlerine.',intro:[J(0,['階段|かいだん','に','石|いし','の','蜘蛛|くも','が','います','。'],'Il y a des araignées de pierre dans les escaliers.','います = il y a (êtres vivants)'),{t:'Je m\'assois sur une marche pour me reposer. La marche se lève et s\'en va. C\'était une araignée. Ça fait trois fois. Chasses-en deux, s\'il te plaît.'}],wait:'Je viens encore de m\'asseoir sur une araignée.',thanks:J(0,['やっと','座れます|すわれます','！'],'Enfin, je peux m\'asseoir !','座れます = pouvoir s\'asseoir')},
  a21:{who:'h21',name:'Les lanternes qui rôdent',gold:30,type:'hunt',kind:'chochin',nb:2,todo:'Éteins deux Lanternes fantômes près de la bambouseraie, puis retourne voir la villageoise.',intro:[J(0,['夜|よる','は','こわい','です','。'],'La nuit, j\'ai peur.','こわい = qui fait peur'),{t:'Deux lanternes se promènent toutes seules autour du village. Elles rient. Une lanterne, ça ne rit pas. Éteins-en deux, s\'il te plaît.'}],wait:'Je les vois encore ricaner entre les bambous.',thanks:J(0,['ありがとう','ございます','！'],'Merci beaucoup !')},
  a30:{who:'h30',name:'Le petit-déjeuner de l\'ouvrier',gold:35,type:'ask',todo:'Réponds en japonais à l\'ouvrier de l\'usine.',intro:[{t:'Je travaille du matin au soir. J\'ai tellement faim que j\'ai oublié ce que j\'ai mangé ce matin. Toi, tu te souviens de ton petit-déjeuner ?'}],q:J(0,['朝|あさ','、','何|なに','を','食べました|たべました','か','。'],'Ce matin, qu\'as-tu mangé ?','食べました = j\'ai mangé (passé)'),o:O3(['パン','を','食べました|たべました','。'],['パン','を','食べます|たべます','。'],['パン','が','好き|すき','です','。']),a:0,no:'L\'ouvrier se gratte la tête. Il a demandé ce que tu AS mangé. Pense au passé en 〜ました.',win:J(0,['いい','です','ね','。','ぼく','は','何も|なにも','…'],'C\'est bien, ça. Moi, je n\'ai rien…','何も + négatif = rien')},
  a40:{who:'h40',name:'L\'eau qu\'on ne boit pas',gold:35,type:'give',it:'cha',nb:2,todo:'Apporte deux thés au vieux pêcheur du bourg de l\'usine.',intro:[J(0,['お茶|おちゃ','を','ください','。'],'Du thé, s\'il te plaît.','ください = donne-moi, s\'il te plaît'),{t:'L\'eau d\'ici a un goût de boulon. J\'ai essayé de la faire bouillir : maintenant elle a un goût de boulon chaud. Deux thés, et je te raconte comment j\'ai pêché un poisson-robot.'}],wait:'Deux thés. Pas de l\'eau de la rivière, hein.',thanks:J(0,['おいしい','！','鉄|てつ','の','味|あじ','が','しない','！'],'Délicieux ! Ça n\'a pas le goût du fer !','味 (あじ) = goût')},
  a150:{who:'h150',name:'Les aiguillages fous',gold:110,type:'hunt',kind:'kamai',nb:2,todo:'Chasse deux Itsumade qui coupent les câbles des aiguillages de leur bec en scie, puis retourne voir Fumi.',intro:[J(0,['線|せん','を','切らないで|きらないで','ください','！'],'Ne coupez pas les câbles, s\'il vous plaît !','切ります (きります) = couper · 〜ないでください = ne faites pas…'),{t:'Ce sont les oiseaux-démons. Ils coupent les câbles des aiguillages avec leur bec en scie, et les trains partent n\'importe où. Chasses-en deux.'}],wait:'Les aiguillages claquent encore tout seuls.',thanks:J(0,['電車|でんしゃ','が','まっすぐ','行きます|いきます','！'],'Les trains vont tout droit !')},
  a151:{who:'h151',name:'La question du cheminot',gold:100,type:'ask',todo:'Réponds en japonais à Gonta le cheminot.',intro:[{t:'J\'ai un rail. Je veux le poser vers le soleil du matin. Le soleil du matin, il se lève où, déjà ?'}],q:J(0,['朝|あさ','、','日|ひ','は','どちら','から','出ます|でます','か','。'],'Le matin, le soleil sort de quel côté ?','どちら = de quel côté · 出ます (でます) = sortir'),o:O3(['東|ひがし','から','出ます|でます','。'],['西|にし','から','出ます|でます','。'],['北|きた','から','出ます|でます','。']),a:0,no:'Gonta pose le rail. Le soleil se lève de l\'autre côté. Il soupire et reprend le rail. Réessaie.',win:J(0,['東|ひがし','です','ね','！','ありがとう','！'],'L\'est, c\'est ça ! Merci !')},
  a140:{who:'h140',name:'Les têtes qui flottent',gold:105,type:'hunt',kind:'okubi',nb:2,todo:'Fais fuir deux Ōkubi cadrans au-dessus des jardins, puis retourne voir Maîtresse Tokei.',intro:[J(0,['大きい|おおきい','顔|かお','が','空|そら','に','います','。'],'Il y a de grands visages dans le ciel.','顔 (かお) = visage · 空 (そら) = ciel'),{t:'Ils font de l\'ombre à mes cadrans solaires. Un cadran solaire à l\'ombre, c\'est un caillou. Chasses-en deux.'}],wait:'Ils flottent encore au-dessus des terrasses.',thanks:J(0,['明るく|あかるく','なりました','。'],'C\'est redevenu lumineux.')},
  a141:{who:'h141',name:'La plus grande horloge',gold:95,type:'ask',todo:'Réponds en japonais à Byōshin, l\'apprenti horloger.',intro:[{t:'Maîtresse Tokei dit que je dois apprendre à comparer. Alors je compare tout. Tiens, toi : la tour ou ma maison ?'}],q:J(0,['塔|とう','と','家|いえ','と','どちら','が','高い|たかい','です','か','。'],'Entre la tour et la maison, laquelle est la plus haute ?','どちら = lequel des deux'),o:O3(['塔|とう','の','ほう','が','高い|たかい','です','。'],['塔|とう','より','高い|たかい','です','。'],['家|いえ','が','いちばん','です','。']),a:0,no:'Byōshin réfléchit, compte sur ses doigts, et se perd. Réessaie quand tu veux.',win:J(0,['そう','です','ね','！','塔|とう','の','ほう','が','高い|たかい','です','！'],'C\'est vrai ! C\'est la tour, la plus haute !')}};
 const nm=(l,n)=>Object.assign({},l,{n:l.n||n});
 async function done(id,n,line){const q=NQ[id],old=S.xp;qs()[id]=2;S.gold=(S.gold||0)+q.gold;S.xp+=15;sfx('lvl');await D.say([nm(line,n),`Quête accomplie : « ${q.name} ». +${q.gold} 円, +15 XP.`]);save();await afterXp(old)}
 async function run(id,n){const q=NQ[id],s=qs();
  if(!s[id]){s[id]=1;qn()[id]=0;await D.say(q.intro.map(l=>nm(l,n)).concat([`Nouvelle quête : « ${q.name} ». Tu la retrouves dans le menu, onglet Défis.`]));save();if(q.type!=='ask')return}
  if(q.type==='give'){if((S.it[q.it]||0)<q.nb)return D.say({n,t:q.wait});if(await D.ask({n,t:`(Lui donner ${q.nb} ${q.it==='cha'?'thé':'onigiri'}${q.nb>1&&q.it==='cha'?'s':''} ?)`},YN)===0){S.it[q.it]-=q.nb;return done(id,n,q.thanks)}return}
  if(q.type==='hunt'){const c=qn()[id]||0;if(c<q.nb)return D.say({n,t:`${q.wait} (${c} sur ${q.nb})`});return done(id,n,q.thanks)}
  const i=await D.ask(nm(q.q,n),q.o);if(i===q.a)return done(id,n,q.win);return D.say(q.no)}
 const pick_=e=>Object.keys(NQ).find(id=>NQ[id].who===e.id&&qs()[id]!==2&&(!NQ[id].after||qs()[NQ[id].after]===2));
 const oTalk=Quests.talk;Quests.talk=async e=>{const id=pick_(e);if(id)return run(id,e.nm);return oTalk(e)};
 for(const k of ['kid','fisher']){const o=STORY[k];STORY[k]=async e=>{await o(e);if(!S.fl.act1)return;const id=pick_({id:k});if(id)await run(id,NQ[id].n)}}
 const oWin=Quests.onWin;Quests.onWin=def=>{oWin(def);const kk=def&&(def.kk||(def.kind&&def.kind.s));for(const id in NQ){const q=NQ[id];if(q.type==='hunt'&&qs()[id]===1&&q.kind===kk&&(qn()[id]||0)<q.nb){qn()[id]=(qn()[id]||0)+1;UI.toast(`Quête « ${q.name} » : ${qn()[id]} / ${q.nb}`,2600)}}};
 const oHtml=Quests.html;Quests.html=()=>{const s=qs(),ids=Object.keys(NQ),a=ids.filter(k=>s[k]===1),d=ids.filter(k=>s[k]===2).length;
  return oHtml()+(a.length||d?`<div class="sw" style="border:0;padding:8px 0 6px"><span>Services rendus · ${d}/${ids.length}</span></div>`+a.map(k=>`<div class="mi"><div class="k" style="font-size:22px;color:var(--gold)">！</div><div class="t"><b>${esc(NQ[k].name)}</b>${esc(NQ[k].todo)}${NQ[k].type==='hunt'?` (${qn()[k]||0} / ${NQ[k].nb})`:''}</div></div>`).join(''):'')};
})();

/* ---------- objets en plus : sac, étal de voyage, trouvailles — et les images du générique ---------- */
Object.assign(IT,{
 dango:{n:'Dango',t:['だんご'],use:['だんご','を','食べた|たべた','！'],heal:30,d:'Trois boulettes sur une pique. Rend 30 PV.',p:14},
 ramen:{n:'Rāmen',t:['ラーメン'],use:['ラーメン','を','食べた|たべた','！'],heal:120,d:'Un grand bol brûlant. Rend 120 PV.',p:55},
 ume:{n:'Umeboshi',t:['梅干し|うめぼし'],use:['梅干し|うめぼし','を','食べた|たべた','！'],heal:20,fx:'ume',d:'Prune salée : +20 PV, et le temps pour parer est allongé jusqu\'à la fin du combat.',p:30},
 bento:{n:'Bentō',t:['弁当|べんとう'],use:['弁当|べんとう','を','食べた|たべた','！'],heal:9999,fx:'bento',d:'Rend tous les PV et annule le prochain coup reçu.',p:90},
 ofuda:{n:'Ofuda',t:['お札|おふだ'],use:['お札|おふだ','を','使った|つかった','！'],heal:0,fx:'ofuda',d:'Talisman : ton prochain kanji frappe deux fois plus fort un revenant ou un gardien.',p:60},
 sumi:{n:'Encre et pierre',t:['墨|すみ'],use:['墨|すみ','を','使った|つかった','！'],heal:0,fx:'sumi',d:'Jusqu\'à la fin du combat, le modèle du kanji s\'affiche pendant le tracé.',p:40},
 fude:{n:'Pinceau fin',t:['筆|ふで'],use:['筆|ふで','を','使った|つかった','！'],heal:0,fx:'fude',d:'Jusqu\'à la fin du combat, le tracé est jugé avec plus d\'indulgence.',p:45},
 kemuri:{n:'Bombe fumigène',t:['煙玉|けむりだま'],use:['煙玉|けむりだま','を','投げた|なげた','！'],heal:0,fx:'kemuri',d:'Fuite assurée face à un yōkai. Face à un gardien, il perd son prochain tour.',p:35},
 suzu:{n:'Clochette',t:['鈴|すず'],use:['鈴|すず','を','鳴らした|ならした','！'],heal:0,fx:'suzu',map:1,d:'À utiliser depuis le menu : éloigne les yōkai des hautes herbes pendant 150 pas.',p:25}});
const Items=(()=>{
 const NEW=['dango','ramen','ume','bento','ofuda','sumi','fude','kemuri','suzu'],J=(n,jp,fr,x)=>({n,jp,fr,x});
 const icon=k=>IM['I_'+k.toUpperCase()]||IM.I_ONI;
 function useMap(k){if(k!=='suzu'||!(S.it.suzu>0))return;S.it.suzu--;S.bell=(S.steps||0)+150;sfx('item');save();UI.toast('La clochette tinte. Les yōkai des hautes herbes te laissent tranquille pendant 150 pas.',3200);try{Menu.refresh&&Menu.refresh()}catch(e){}}
 const html=()=>{const own=NEW.filter(k=>S.it[k]>0);if(!own.length)return '';
  return `<div class="sw" style="border:0;padding:8px 0 6px"><span>Sac de voyage</span></div>`+own.map(k=>`<div class="mi"><div class="k"><img class="ic big" src="${icon(k)}" alt=""></div><div class="t"><b>${jpHtml(IT[k].t)} ×${S.it[k]} · ${esc(IT[k].n)}</b>${esc(IT[k].d)}${IT[k].map?`<br><button class="btn" style="margin-top:4px;padding:4px 10px" onclick="Items.useMap('${k}')">Utiliser</button>`:''}${k==='suzu'&&S.bell>(S.steps||0)?`<br><small>Encore ${S.bell-(S.steps||0)} pas de tranquillité.</small>`:''}</div></div>`).join('')};
 /* étal : les objets de voyage, selon le bourg */
 const STOCK=z=>NEW.filter((k,i)=>z>=[0,3,2,6,5,2,3,1,0][i]);
 async function stall(z){const n='Marchande';
  for(;;){const ks=STOCK(z),i=await D.ask({n,t:`Tu as ${S.gold||0} 円. Que veux-tu ?`},ks.map(k=>({jp:IT[k].t,fr:`${IT[k].n} · ${IT[k].p+z*2} 円`})).concat(['Rien d\'autre']));
   if(i>=ks.length)return;const k=ks[i],p=IT[k].p+z*2;await D.say({n,t:IT[k].d});
   if(await D.ask({n,jp:IT[k].t.concat(['を','買います|かいます','か','。']),fr:`Acheter pour ${p} 円 ?`},[{jp:['はい','、','ください','。'],fr:'Oui'},{jp:['いいえ'],fr:'Non'}])!==0)continue;
   if((S.gold||0)<p){await D.say({n,jp:['お金|おかね','が','足りません|たりません','よ','。'],fr:'Tu n\'as pas assez d\'argent.'});continue}
   S.gold-=p;S.it[k]=(S.it[k]||0)+1;sfx('item');save();await D.say({n,jp:['ありがとう','ございます','！'],fr:`Merci beaucoup ! (+1 ${IT[k].n})`})}}
 const oShop=STORY.shop;STORY.shop=async e=>{if(!S.fl.act1)return oShop(e);const z=e&&e.id?+String(e.id).replace('shop',''):0;
  const i=await D.ask({n:'Marchande',jp:['いらっしゃいませ','！'],fr:'Bienvenue ! Que cherches-tu ?'},[{jp:['食べ物|たべもの'],fr:'Riz et thé'},{jp:['旅|たび','の','道具|どうぐ'],fr:'Objets de voyage'},'Rien, merci']);
  if(i===0)return oShop(e);if(i===1)return stall(z||0)};
 /* trouvailles : les trésors cachés contiennent aussi un objet */
 const oItem=STORY.item;STORY.item=async e=>{await oItem(e);if(e.hid){const k=NEW[hash(e.x,e.y)%NEW.length];S.it[k]=(S.it[k]||0)+1;sfx('item');await D.say({jp:IT[k].t.concat(['も','あった','！']),fr:`Il y avait aussi : ${IT[k].n} !`,x:IT[k].d});save()}};
 const oWild=STORY.wild;STORY.wild=async z=>{if(S.bell>(S.steps||0))return;return oWild(z)};
 const oH=Quests.html;Quests.html=()=>html()+oH();
 return{useMap,icon,html}})();
/* --- images du générique --- */
const Cine=(()=>{let box=null,el=null;
 function mk(){if(box)return;box=document.createElement('div');box.id='cine';box.style.cssText='position:absolute;inset:0;z-index:24;background:#07060c;opacity:0;transition:opacity .6s;pointer-events:none;display:flex;flex-direction:column;align-items:center;justify-content:center;padding-bottom:24%;box-sizing:border-box;overflow:hidden';
  el=document.createElement('img');el.alt='';el.style.cssText='width:100%;max-height:78%;object-fit:contain;object-position:50% 0;image-rendering:auto;transition:opacity .35s';box.appendChild(el);$('#fade').parentNode.insertBefore(box,$('#dlg'));if(window.CA)CA.hook(box,el)}
 function show(k){(window.__cine||(window.__cine=[])).push(k);if(!IM[k])return;mk();if(box.style.opacity==='1'){el.style.opacity=0;setTimeout(()=>{el.dataset.k=k;el.src=IM[k];el.style.display='';el.style.opacity=1},300)}else{el.dataset.k=k;el.src=IM[k];el.style.opacity=1;el.style.display='';box.style.opacity=1}}
 function hide(){if(box)box.style.opacity=0}
 const say=async(k,lines)=>{show(k);try{await D.say(lines)}finally{hide()}};
 const host=()=>{mk();el.style.display='none';box.style.opacity=1;return box};
 return{show,hide,say,host}})();

/* ---------- la montée en funiculaire : de la ville basse à l'Académie (scène animée) ---------- */
(()=>{const J=(n,jp,fr,x)=>({n,jp,fr,x}),T_=(n,t)=>({n,t}),KG='影',KA='Kaito',CL=[[0, 230, 221, 129], [119, 242, 73, 28], [238, 345, 210, 120], [245, 425, 76, 33]];
 const top9=()=>{for(let y=0;y<MAPS.world.h;y++)if(MAPS.world.zone(y)===9)return y;return 0};
 let BG=null;const bgi=()=>{if(!BG){BG=new Image();BG.src=IM.N_FUNI}return BG};
 function ride(dur,down){const host=Cine.host(),bg=bgi(),cab=XI.X_CABIN,BW=448,BH=1056;
  const cv=document.createElement('canvas'),r=host.getBoundingClientRect(),VH=Math.round(BW*Math.min(1.9,Math.max(.9,(r.height*.8)/Math.max(1,r.width))));cv.width=BW;cv.height=VH;cv.style.cssText='width:100%;image-rendering:pixelated;display:block';host.appendChild(cv);
  const g=cv.getContext('2d'),t0=performance.now(),ease=p=>p<.5?2*p*p:1-Math.pow(-2*p+2,2)/2;let stop=false,puffs=[];
  const FG=[['X_FF_girder',-70,640,1.5],['X_FF_pipes',300,520,1.6]];const CLD=[[6,30,470,2,7],[3,300,410,1,-9],[0,200,350,1,12],[2,60,290,2,-6],[7,330,240,1,5],[5,150,190,1,-11],[8,260,80,1,-5],[1,100,40,1,6]];
  const WR=[[470,440,28,1.35,[.25,.55,.85]],[390,410,36,1.6,[.4,.75]],[300,275,20,1.3,[.18,.5,.8]],[215,235,26,1.5,[.3,.65]],[140,120,22,1.3,[.2,.5,.85]]];
  const lant=(x,y,k,t,i)=>{const w=Math.round(9*k),h=Math.round(12*k),c=Math.max(1,Math.round(k)),sl=Math.round(5*k);x=Math.round(x-w/2);y=Math.round(y);
   g.fillStyle=`rgba(70,220,255,${.13+.06*Math.sin(t*4+i*2.1)})`;g.beginPath();g.arc(x+w/2,y+sl+h/2,w*1.5,0,7);g.fill();
   g.fillStyle='#1b1418';g.fillRect(x+(w>>1),y,c,sl);g.fillRect(x+c,y+sl,w-2*c,c);g.fillRect(x+c,y+sl+h-c,w-2*c,c);
   g.fillStyle='#1c7fa3';g.fillRect(x,y+sl+c,w,h-2*c);g.fillStyle='#45cbe6';g.fillRect(x+c,y+sl+c,w-2*c,h-2*c);g.fillStyle='#d2fbff';g.fillRect(x+2*c,y+sl+2*c,Math.max(c,w-5*c),h-4*c);
   g.fillStyle='rgba(15,70,95,.55)';for(let r=y+sl+3*c;r<y+sl+h-2*c;r+=3*c)g.fillRect(x,r,w,c)};
  const wires=(t,cy)=>{WR.forEach((w,i)=>{const[y0,y1,sag,par,ls]=w,th=par>1.45?2:1,Y=u=>((y0+(y1-y0)*u-cy-VH*.5)*par+VH*.5)+(sag*4*u*(1-u)+Math.sin(t*1.1+i*1.9)*2.5*4*u*(1-u))*par;
    const a=Y(0),b=Y(1),m=Y(.5);if(Math.min(a,b,m)>VH+40||Math.max(a,b,m)<-40)return;g.fillStyle='#15101a';for(let x=0;x<BW;x+=2)g.fillRect(x,Math.round(Y(x/BW)),2,th);
    ls.forEach((u,j)=>lant(u*BW+Math.sin(t*1.6+i+j*2)*1.5,Y(u)+th,par*1.3,t,i*5+j))})};
  const done=new Promise(res=>{const f=()=>{if(stop){res();return}const t=(performance.now()-t0)/1000,p=Math.min(1,t/dur),e=down?1-ease(p):ease(p);
    const ty=770-(770-140)*e,sc=.8-.3*e,cw=74*sc,ch=cw*(cab&&cab.width?cab.height/cab.width:1.4),cy=Math.max(0,Math.min(BH-VH,ty-VH*.62));
    g.imageSmoothingEnabled=false;g.fillStyle='#07060c';g.fillRect(0,0,BW,VH);if(bg.width){g.drawImage(bg,0,-cy,BW,BH);if(window.CA&&CA.cv)CA.cv(g,bg,0,-cy,BW,BH)}
    if(cab&&cab.width){const sway=Math.sin(t*5)*.6;g.drawImage(cab,224-cw/2+sway,ty-ch-cy,cw,ch)}
    if(Math.random()<.25)puffs.push({x:224,y:ty-ch,r:3*sc+1,a:.6});puffs=puffs.filter(q=>q.a>.03);for(const q of puffs){q.y-=.25;q.x+=.2;q.r+=.12;q.a*=.965;g.fillStyle=`rgba(235,235,240,${q.a})`;g.beginPath();g.arc(q.x,q.y-cy,q.r,0,7);g.fill()}
    if(bg.width)g.drawImage(bg,0,548*bg.height/BH,bg.width,52*bg.height/BH,0,548-cy,BW,52);
    CLD.forEach(([k,x0,y,z,sp])=>{const im=XI['X_FCL'+k];if(!im||!im.width)return;const w=im.width*z,span=BW+w,x=((x0+t*sp)%span+span)%span-w;g.globalAlpha=z>2?.8:.95;g.drawImage(im,Math.round(x),Math.round((y-cy-VH*.5)*(1+z*.12)+VH*.5),w,im.height*z);g.globalAlpha=1});
    for(const[k,x,y,par]of FG){const im=XI[k];if(!im||!im.width)continue;const yy=(y-cy-VH*.5)*par+VH*.5;if(yy>VH+10||yy+im.height<-10)continue;g.drawImage(im,x,yy)}
    wires(t,cy);g.fillStyle=`rgba(255,250,235,${.10*e})`;g.fillRect(0,0,BW,VH);
    if(p>=1){res();return}requestAnimationFrame(f)};requestAnimationFrame(f)});
  return{done,end(){stop=true;cv.remove()}}}
 const o=STORY.triggers;STORY.triggers=(x,y)=>{const t=o(x,y);if(t||S.fl.noscn||W.map!=='world'||!(S.fl.visit||(S.fl.act1&&S.wins.wanyudo)))return t;const t9=top9(),z=W.zone(),up=z===9&&y<=t9+1,dn=z===10&&y>=t9-2;if(!up&&!dn)return t;
  if(up&&!S.fl.funi)return async()=>{S.fl.funi=1;save();music(null);bgi();await UI.fade(1,350);const R=ride(24);await UI.fade(0,300);sfx('door');
   await D.say(["La cabine s'ébranle. Sous tes pieds, les lanternes de la ville basse rétrécissent.",T_(KG,"Ça monte. Je n'aime pas quand ça monte. Une ombre, c'est fait pour rester par terre."),J(KA,['大丈夫|だいじょうぶ','です','か','。'],'Ça va ?','大丈夫 (だいじょうぶ) = ça va, pas de problème'),
    T_(KG,"Non. Regarde ces tuyaux. Tout ce qu'ils pompent en bas passe par ici. La ville haute boit la ville basse à la paille."),"La cabine passe sous le grand pont de fer, puis traverse les nuages. La lumière change : du violet à l'or, puis au blanc.",
    J(KG,['明るい|あかるい','…'],'C\'est lumineux…','明るい (あかるい) = clair, lumineux'),T_(KG,"Kaito. Je n'ai pas vu le jour d'aussi haut depuis… depuis que j'étais l'ombre de quelqu'un de très grand. Ne dis rien. Laisse-moi regarder.")]);
   await Promise.race([R.done,wait(6000)]);await UI.fade(1,300);R.end();W.load('world',RX(top9()-3)+9,top9()-3,1);W.H.cd=2;Cine.show('N_S5');await UI.fade(0,300);
   await D.say(["La ville haute. Des lampes de laiton brillent de tous les côtés à la fois. Rien ne fait d'ombre, ici.",T_(KG,"… Sauf toi. Tout le monde va me voir. Marche vite, et tâche d'avoir l'air de quelqu'un qui a une ombre normale.")]);
   Cine.hide();music(ZONES[10].mus);W.refreshZone();save()};
  /* trajets suivants : plus courts, sans dialogue ; la descente rejoue la montée à l'envers */
  return async()=>{music(null);bgi();await UI.fade(1,300);const R=ride(8.5,dn);await UI.fade(0,250);sfx('door');await Promise.race([R.done,wait(11000)]);await wait(350);await UI.fade(1,300);R.end();Cine.hide();
   if(dn)W.load('world',RX(top9()+4)+9,top9()+4,0);else W.load('world',RX(top9()-3)+9,top9()-3,1);W.H.cd=2;await UI.fade(0,300);music(ZONES[dn?9:10].mus);W.refreshZone();save()}};
 window.Funi={hidden:()=>!S.fl.noscn,ride};
})();

/* ---------- carte du voyage, carnet de kanji, mini-jeux, calendrier de tampons ---------- */
const Extra=(()=>{
 const PN=['Village de Kome','Hameau des bambous','Quartier des ouvriers','Quartier des fumées','Hameau des cendres','Refuge du col des Brumes','Relais de la Grand-Route','Bourg des passeurs','Ville basse de Kurogane','Académie des sceaux','Grandes Forges de Tetsu','Port des dirigeables','Forêt des renards','Jardins des horlogers','Croisée des quatre vents','Citadelle de Tetsu','Plage des naufragés','Ville impériale dorée','Monts des Tengu','Mine de Tetsu','Temple du dieu endormi'];
 const GD=['kakashi','karakasa','smoke','toad','boss','yuki','nuri','umi','wanyudo','kyorin','baku','nue','yamabiko','ungai','kaze','tetsu','ushioni','kinko','daitengu','mukade','tetsuf'];
 const LZP=[['l1','l2'],['l3','l4'],['l5','l6'],['l7','l8'],['l9','l10'],['l11','l12'],['l13','l14'],['l16','l18'],['l19','l20'],['l21','l22'],['l23','l24'],['l25','l26'],['l27','l28'],['l29','l30'],['l31','l32'],['l33','l34'],['l35','l36'],['l37','l38'],['l39','l40'],['l41','l42'],['l43','l44']];
 const reach=()=>{let n=0;while(n<GD.length&&S.wins[GD[n]])n++;return n},here=()=>{let z=0;try{z=W.zone()}catch(e){}return z>=99?Math.min(PN.length-1,reach()):Math.min(PN.length-1,Math.max(0,z-1))};
 const pjp=p=>ZONES[p?p+1:0].jp,day=d=>d.toLocaleDateString('sv'),today=()=>day(new Date()),ago=n=>day(new Date(Date.now()-n*864e5));
 let view=null,raf=0,gm=null;
 function reset(){view=null;gm=null;cancelAnimationFrame(raf)}
 /* --- carte --- */
 const MK=[[378,1262],[618,1188],[372,1060],[618,1050],[155,1100],[120,705],[300,728],[112,900],[452,875],[468,700],[662,812],[652,578],[482,478],[662,368],[505,280],[655,150]],SN=['Kome','Bambous','Ouvriers','Fumées','Cendres','Le Col','Relais','Passeurs','Ville basse','Académie','Forges','Port','Renards','Horlogers','Quatre vents','Citadelle','Plage','Ville dorée','Tengu','Mine','Temple'];
 const RIB=[[341,1317,89],[546,1237,134],[318,1135,123],[539,1101,141],[101,1166,107],[83,749,89],[264,790,67],[81,981,88],[411,933,111],[432,752,90],[624,862,88],[616,633,87],[432,542,124],[617,410,89],[437,326,140],[609,220,91]],LB=RIB.map(([x,y,w])=>{const W=Math.max(w,118);return[x+w/2-W/2,y-6,W,31]});
 /* l'acte IV : déjà sur la carte, pas encore dans le jeu */
 const MK4=[[132,505],[215,395],[332,298],[98,262],[210,108]],LB4=[[56,546,152],[163,433,117],[297,352,80],[57,329,98],[146,187,135]].map(([x,y,w])=>{const W=Math.max(w,118);return[x+w/2-W/2,y-6,W,31]});
 /* la carte (version de l'acte IV) : les 21 lieux le long de la route, dans l'ordre du jeu, avec les bandeaux de la carte */
 const MAP2=true,NP=[[380,1250],[610,1180],[600,1040],[375,1085],[150,1110],[115,705],[270,760],[230,925],[450,880],[470,700],[660,790],[655,570],[310,540],[480,470],[670,360],[665,100],[460,250],[310,300],[130,380],[90,190],[235,80]],NB=[[343,1317,86],[545,1237,136],[555,1091,121],[303,1142,139],[100,1166,109],[83,749,88],[265,790,65],[81,981,88],[415,934,118],[433,753,90],[623,862,87],[617,633,85],[282,597,81],[439,543,114],[617,411,88],[610,185,110],[447,326,86],[299,352,78],[60,445,120],[56,257,90],[194,188,87]];
 {const lb=([x,y,w])=>{const W=Math.max(w,118);return[x+w/2-W/2,y-6,W,31]};
  MK.splice(0,MK.length,...NP.slice(0,16));RIB.splice(0,RIB.length,...NB.slice(0,16));LB.splice(0,LB.length,...RIB.map(lb));
  MK4.splice(0,MK4.length,...NP.slice(16));LB4.splice(0,LB4.length,...NB.slice(16).map(lb))}
 /* le premier lieu de l'acte IV est ouvert : il passe dans les listes normales */
 MK.push(MK4.shift());RIB.push(NB[16]);LB.push(LB4.shift());
 MK.push(MK4.shift());RIB.push(NB[17]);LB.push(LB4.shift());
 MK.push(MK4.shift());RIB.push(NB[18]);LB.push(LB4.shift());
 MK.push(MK4.shift());RIB.push(NB[19]);LB.push(LB4.shift());
 MK.push(MK4.shift());RIB.push(NB[20]);LB.push(LB4.shift());
 const ACT=[[0,5,'#3f8a3a','ACTE I',[18,1205]],[5,11,'#c0571c','ACTE II',[200,640]],[11,16,'#2f6fb4','ACTE III',[560,690]],[16,21,'#b58410','ACTE IV',[18,598]]];
 if(MAP2){ACT[0][4]=[180,1215];ACT[1][4]=[20,820];ACT[2][4]=[560,690];ACT[3][4]=[600,250]}
 if(PART===12){[PN,SN,MK,LB,LZP,RIB].forEach(a=>a.splice(11));GD.splice(10)}
 function map(){if(view&&view.p!=null)return place(view.p);const R=reach(),C=here(),px=v=>(v/768*100).toFixed(2)+'%',py=v=>(v/1376*100).toFixed(2)+'%';
  let h=`<p style="font-size:12px;color:var(--sub);margin:0 0 6px">Ton voyage, du village de Kome jusqu'au sanctuaire du dieu endormi. Touche un lieu pour voir ses kanji et ses leçons.</p><div id="xMap" style="position:relative;width:100%;aspect-ratio:768/1376;background:#e6d3a2 url(${IM.N_MAP}) center/100% 100%;border:2px solid #7a5420;border-radius:8px;overflow:hidden;image-rendering:auto;color:#3a2608">`;
  const plate=(r,t,ok)=>`<div style="position:absolute;left:${px(r[0])};top:${py(r[1])};width:${px(r[2])};height:${py(r[3])};display:flex;align-items:center;justify-content:center;text-align:center;font-size:11px;line-height:1.05;font-weight:bold;background:#f3e4c0;border:1px solid #7a5420;border-radius:3px;color:${ok?'#3a2608':'#8a8068'};pointer-events:none;overflow:hidden">${t}</div>`;
  {const P=MK.concat(MK4),seg=[];for(let i=0;i+1<P.length;i++){const a=ACT.find(q=>i>=q[0]&&i<q[1])||ACT[3],on=i+1<=R&&i+1<MK.length;seg.push(`<line x1="${P[i][0]}" y1="${P[i][1]}" x2="${P[i+1][0]}" y2="${P[i+1][1]}" stroke="${a[2]}" stroke-width="${on?9:6}" stroke-linecap="round" stroke-dasharray="${on?'':'2 14'}" opacity="${on?.85:.6}"/>`)}
   h+=`<svg viewBox="0 0 768 1376" preserveAspectRatio="none" style="position:absolute;inset:0;width:100%;height:100%;pointer-events:none">${seg.join('')}</svg>`;
   ACT.forEach(a=>{h+=`<div style="position:absolute;left:${px(a[4][0])};top:${py(a[4][1])};padding:2px 7px;font-size:10px;font-weight:bold;letter-spacing:1px;color:#fff;background:${a[2]};border:1px solid #3a2608;border-radius:3px;pointer-events:none">${a[3]}</div>`});
   if(PART!==12)LB4.forEach((r,i)=>{h+=plate(r,'？？？',0);const m=MK4[i];h+=`<div style="position:absolute;left:${px(m[0])};top:${py(m[1])};transform:translate(-50%,-50%);width:22px;height:22px;border-radius:50%;border:2px solid #77705e;background:#bdb6a2;color:#77705e;font-size:12px;display:grid;place-items:center;pointer-events:none">？</div>`})}
  for(let i=0;i<PN.length;i++){const ok=i<=R,T=THEMES[i],cur=i===C,m=MK[i];h+=plate(LB[i],ok?SN[i]:'？？？',ok);
   h+=`<button data-xp="${ok?i:-1}" aria-label="${ok?esc(PN[i]):'Lieu inconnu'}" style="position:absolute;left:${px(m[0])};top:${py(m[1])};transform:translate(-50%,-50%);width:30px;height:30px;padding:0;border-radius:50%;font-size:15px;line-height:1;border:2px solid ${cur?'#19e0f0':ok?'#5a3a10':'#77705e'};background:${ok?'radial-gradient(circle at 35% 30%,#fff0b8,#d8a848)':'#bdb6a2'};color:${ok?'#2a1a04':'#77705e'};box-shadow:${cur?'0 0 0 3px rgba(25,224,240,.55),0 0 10px #19e0f0,':''}0 2px 0 rgba(40,25,5,.6)">${ok?T.ic:'？'}</button>`}
  return h+`</div><p style="font-size:12px;color:var(--sub);margin:6px 0 0">Le cercle bleu indique où tu te trouves : ${esc(PN[Math.min(C,PN.length-1)])}.</p>`}
 function place(p){const T=THEMES[p],l=Path.lvl(T.id),g=GD[p];
  return `<button class="go" data-xb="1" style="margin-bottom:8px">◀ Carte</button><div class="mi"><div class="k" style="color:var(--cy)">${T.ic}</div><div class="t"><b>${esc(PN[p])}</b><span class="jp">${jpHtml(pjp(p))}</span><br><small>${p===13?(S.wins.ungai?'L\'Ungaikyō s\'est brisé ✓':'Le miroir de l\'horloger garde la plaque tournante, au nord.'):p===12?(S.wins.yamabiko?'Le Yamabiko de fer s\'est tu ✓':'L\'écho de fer garde le treuil, au nord de la forêt.'):p===11?(S.wins.nue?'La Nue des nuages est vaincue ✓':'La Nue garde le mât d\'amarrage, au nord du port.'):p===10?(S.wins.baku2?'Le Baku de fer est vaincu ✓':'Le Baku de fer t\'attend au fond de la halle.'):S.wins[g]?'Gardien de la route vaincu ✓':'Le gardien de la sortie nord n\'est pas encore vaincu.'}</small></div></div>
${p<=reach()&&p!==here()&&(PART!==34||p>=11)&&(PART!==4||p>=16)?`<button class="btn" data-xgo="${p}" style="width:100%;margin:2px 0 8px">駕籠 · S'y rendre en palanquin</button>`:''}<div class="sw" style="border:0;padding:6px 0 4px"><span>Kanji du lieu · ${esc(T.name)}</span><span style="color:#c89018">${Path.stars(T.id)}</span></div><div style="display:grid;grid-template-columns:repeat(5,1fr);gap:6px;margin-bottom:8px">${T.k.map((q,i)=>l?`<button data-xk="${p},${i}" class="btn" style="font-size:26px;padding:8px 0">${q.k}</button>`:`<button class="btn dark" disabled style="font-size:26px;padding:8px 0;opacity:.5">・</button>`).join('')}</div>${l?'':`<p style="font-size:12px;color:var(--sub)">À apprendre auprès de ${esc(PLACES[T.place]||'ce bourg')}.</p>`}
<div class="sw" style="border:0;padding:6px 0 4px"><span>Leçons de grammaire</span></div>`+LZP[p].map(id=>{const L=LESSONS.find(q=>q.id===id);return L?`<div class="mi ${S.les[id]?'':'lock'}"><div class="k" style="font-size:22px">${S.les[id]?'✓':'・'}</div><div class="t"><b>${esc(L.title)}</b>${esc(L.sub)}</div></div>`:''}).join('')}
 /* --- carnet de kanji --- */
 const known=()=>{const o=[];THEMES.forEach((T,ti)=>{if(Path.lvl(T.id))T.k.forEach((q,i)=>o.push([ti,i,q]))});return o};
 /* couleur d'un kanji selon sa maîtrise : gris (nouveau), blanc, bleu, vert, puis laiton */
 const KCOL=k=>{const r=S.rv&&S.rv[k],i=r?r.i:-1;return i>=4?'#e2b65a':i===3?'#7fe0a0':i===2?'#58e0ec':i>=0?'#e8ecf8':'#8a93ad'},KLEG='<p style="font-size:11px;color:var(--sub);margin:0 0 8px">Maîtrise : <b style="color:#8a93ad">■</b> nouveau · <b style="color:#e8ecf8">■</b> en cours · <b style="color:#58e0ec">■</b> connu · <b style="color:#7fe0a0">■</b> solide · <b style="color:#e2b65a">■</b> maîtrisé</p>';
 let kq='';const norm=t=>String(t||'').toLowerCase().normalize('NFD').replace(/[̀-ͯ]/g,'').replace(/[ァ-ヶ]/g,c=>String.fromCharCode(c.charCodeAt(0)-96));
 function kfind(q){q=norm(q).trim();if(!q)return null;const o=[];THEMES.forEach((T,ti)=>T.k.forEach((k,i)=>{const hay=norm([k.k,k.fr,k.kun,k.on,k.w,k.wf,T.name].join(' '));if(hay.includes(q))o.push([ti,i,k])}));return o}
 function kres(){const r=kfind(kq);if(!r)return '';if(!r.length)return `<p style="font-size:13px;color:var(--sub)">Aucun kanji ne correspond à « ${esc(kq)} ». Essaie un sens (« eau »), une lecture (« みず ») ou le kanji lui-même.</p>`;
  return `<div class="sw" style="border:0;padding:2px 0 4px"><span>${r.length} résultat${r.length>1?'s':''}</span></div>`+r.slice(0,40).map(([t,i,k])=>{const ok=Path.lvl(THEMES[t].id);return `<div class="mi ${ok?'':'lock'}"><div class="k" style="color:${KCOL(k.k)}">${k.k}</div><div class="t"><b>${esc(k.fr)}</b>${ok?`${esc(k.kun)} · ${esc(k.on)}<br>`:''}<small>${esc(THEMES[t].name)}${ok?'':' · pas encore appris'}</small></div>${ok?`<button class="go" data-xk="${t},${i}">Fiche</button>`:''}</div>`}).join('')}
 function theme(t){const T=THEMES[t],l=Path.lvl(T.id);return `<button class="go" data-xb="1" style="margin-bottom:8px">◀ Thèmes</button><div class="mi"><div class="k" style="color:var(--cy)">${T.ic}</div><div class="t"><b>${esc(T.name)}</b><span style="color:#c89018">${Path.stars(T.id)}</span><br><small>${l?'Appris auprès de ':'À apprendre auprès de '}${esc(PLACES[T.place]||'un bourg à venir')}</small></div></div>`+T.k.map((k,i)=>`<div class="mi ${l?'':'lock'}"><div class="k" style="font-size:30px;color:${KCOL(k.k)}">${l?k.k:'・'}</div><div class="t"><b>${l?esc(k.fr):'？？？'}</b>${l?`${esc(k.kun)} · ${esc(k.on)}<br><small>${jpHtml([k.w])} — ${esc(k.wf||'')}</small>`:''}</div>${l?`<button class="go" data-xk="${t},${i}">Fiche</button>`:''}</div>`).join('')}
 function kanji(spells){if(view&&view.t!=null)return theme(view.t);const tot=THEMES.reduce((a,T)=>a+T.k.length,0),n=known().length;
  return `<input id="xKq" type="search" inputmode="search" autocomplete="off" placeholder="Chercher : eau, みず, 水, nombre…" value="${esc(kq)}" aria-label="Chercher un kanji" style="width:100%;box-sizing:border-box;font:15px inherit;padding:9px 12px;border-radius:8px;border:2px solid var(--brass);background:#0c1226;color:#e8ecf8;margin-bottom:8px"><div id="xKres">${kres()}</div>
${KLEG}<div class="sw" style="border:0;padding:6px 0 4px"><span>Sommaire des thèmes</span><span style="color:var(--gold)">${n} / ${tot} kanji</span></div><div style="display:grid;grid-template-columns:1fr 1fr;gap:6px;margin-bottom:10px">${THEMES.map((T,i)=>{const l=Path.lvl(T.id);return `<button data-xth="${i}" class="btn ${l?'':'dark'}" style="display:flex;align-items:center;gap:8px;padding:7px 8px;text-align:left;${l?'':'opacity:.6'}"><span style="font-size:22px;flex:none;width:26px;text-align:center">${l?T.ic:'🔒'}</span><span style="font-size:12px;line-height:1.25"><b style="display:block">${esc(T.name)}</b>${l?T.k.map(k=>`<span style="color:${KCOL(k.k)};text-shadow:0 1px 0 rgba(0,0,0,.5)">${k.k}</span>`).join(' '):'・ ・ ・ ・ ・'}</span></button>`}).join('')}</div>
<div class="sw" style="border:0;padding:6px 0 4px"><span>Kanji de combat (tes sorts)</span></div>`+spells}
 function opt(){const n=S.fbs||1,NM=['Plaque de laiton','Tampon sur papier','Manomètre à vapeur','Rouleau'];return `<div class="sw"><span>Fenêtre de réponse</span><span style="white-space:nowrap">${[1,2,3,4].map(i=>`<button data-xf="${i}" class="${i===n?'on':''}" style="min-width:0;padding:6px 11px">${i}</button>`).join(' ')}</span></div><p style="font-size:12px;color:var(--sub);margin:-2px 0 6px">Style ${n} : ${NM[n-1]}. Touche un numéro pour le voir et l'entendre.</p><div id="xFbA" style="margin-bottom:8px"></div><div id="xFbB" style="margin-bottom:10px"></div>`}
 function demo(snd){const a=$('#xFbA'),b=$('#xFbB');if(!a||!b)return;fbShow(a,true,'<span class="jp">'+jpHtml(['水|みず','を','飲みます|のみます','。'])+'</span>Je bois de l\'eau.',!snd);b.innerHTML='';b.className='';setTimeout(()=>{if(document.body.contains(b))fbShow(b,false,'<span class="jp">'+jpHtml(['水|みず'])+'</span>水 se lit みず (スイ).',!snd)},snd?900:150)}
 function kcard(t,i){const T=THEMES[t],q=T.k[i],w=(q.w||'').split('|'),r=S.rv&&S.rv[q.k];
  return `<button class="go" data-xb="1" style="margin-bottom:8px">◀ Retour</button><div style="display:flex;gap:10px;align-items:flex-start"><canvas id="xKc" width="264" height="264" style="width:190px;height:190px;background:#f4ead0;border:2px solid #7a5420;border-radius:8px;flex:none"></canvas><div style="font-size:13px;line-height:1.5"><b style="font-size:17px">${esc(q.fr)}</b><br>Kun : <span class="jp">${esc(q.kun)}</span> <button class="spk" data-xs="${esc(q.kun)}" aria-label="Écouter">🔊</button><br>On : <span class="jp">${esc(q.on)}</span><br>${q.s.length} trait${q.s.length>1?'s':''}<br><small style="color:var(--sub)">${esc(T.name)}</small></div></div>
${w[0]?`<div class="mi" style="margin-top:8px"><div class="t"><div class="jp">${jpHtml([q.w])}</div>${esc(q.wf||'')}</div><button class="spk" data-xs="${esc(w[1]||w[0])}" aria-label="Écouter">🔊</button></div>`:''}
<p style="font-size:12px;color:var(--sub)">${r?(r.d<=dayN()?'À réviser aujourd\'hui.':`Prochaine révision dans ${r.d-dayN()} jour${r.d-dayN()>1?'s':''}.`):'Pas encore passé en révision.'} ${i>0?`<button class="go" data-xk="${t},${i-1}">◀ ${T.k[i-1].k}</button>`:''} ${i<T.k.length-1?`<button class="go" data-xk="${t},${i+1}">${T.k[i+1].k} ▶</button>`:''}</p>`}
 function anim(q){const c=$('#xKc');if(!c)return;const g=c.getContext('2d'),sc=2.64,L=q.s.map(s=>{let n=0;for(let i=1;i<s.length;i++)n+=Math.hypot(s[i][0]-s[i-1][0],s[i][1]-s[i-1][1]);return n}),tot=L.reduce((a,b)=>a+b,0),t0=performance.now(),dur=Math.max(1.6,tot/90);
  const part=(s,len)=>{g.beginPath();g.moveTo(s[0][0]*sc,s[0][1]*sc);let n=0;for(let i=1;i<s.length;i++){const d=Math.hypot(s[i][0]-s[i-1][0],s[i][1]-s[i-1][1]);if(n+d>len){const f=(len-n)/d;g.lineTo((s[i-1][0]+(s[i][0]-s[i-1][0])*f)*sc,(s[i-1][1]+(s[i][1]-s[i-1][1])*f)*sc);break}g.lineTo(s[i][0]*sc,s[i][1]*sc);n+=d}g.stroke()};
  cancelAnimationFrame(raf);const f=()=>{if(!document.body.contains(c))return;const p=((performance.now()-t0)/1000)%(dur+1.2);let len=Math.min(1,p/dur)*tot;g.clearRect(0,0,264,264);g.strokeStyle='rgba(120,90,40,.25)';g.lineWidth=1;g.setLineDash([5,5]);g.beginPath();g.moveTo(132,0);g.lineTo(132,264);g.moveTo(0,132);g.lineTo(264,132);g.stroke();g.setLineDash([]);
   g.lineCap='round';g.lineJoin='round';g.lineWidth=13;g.strokeStyle='#d9cba6';q.s.forEach((s,i)=>part(s,L[i]));g.strokeStyle='#1b1418';q.s.forEach((s,i)=>{if(len<=0)return;part(s,Math.min(L[i],len));if(len<L[i]){g.strokeStyle='#c8401f'}len-=L[i]});
   g.fillStyle='#c8401f';g.font='bold 15px sans-serif';let n=Math.min(1,p/dur)*tot;q.s.forEach((s,i)=>{if(n>0)g.fillText(i+1,s[0][0]*sc-14,s[0][1]*sc-6);n-=L[i]});raf=requestAnimationFrame(f)};f()}
 /* --- mini-jeux --- */
 const U=['','いち','に','さん','よん','ご','ろく','なな','はち','きゅう'],KD=['','一','二','三','四','五','六','七','八','九'];
 function num(n){let k='',r='';const m=Math.floor(n/10000),s=Math.floor(n/1000)%10,h=Math.floor(n/100)%10,t=Math.floor(n/10)%10,o=n%10;
  if(m){k+=KD[m]+'万';r+=U[m]+'まん'}if(s){k+=(s>1?KD[s]:'')+'千';r+=({1:'せん',3:'さんぜん',8:'はっせん'})[s]||U[s]+'せん'}if(h){k+=(h>1?KD[h]:'')+'百';r+=({1:'ひゃく',3:'さんびゃく',6:'ろっぴゃく',8:'はっぴゃく'})[h]||U[h]+'ひゃく'}if(t){k+=(t>1?KD[t]:'')+'十';r+=t>1?U[t]+'じゅう':'じゅう'}if(o){k+=KD[o];r+=o===4?'よ':U[o]}return[k,r]}
 const HR=['','いち','に','さん','よ','ご','ろく','しち','はち','く','じゅう','じゅういち','じゅうに'],HK=['','一','二','三','四','五','六','七','八','九','十','十一','十二'],MN={30:['半','はん'],15:['十五分','じゅうごふん'],45:['四十五分','よんじゅうごふん'],10:['十分','じゅっぷん'],20:['二十分','にじゅっぷん'],40:['四十分','よんじゅっぷん'],50:['五十分','ごじゅっぷん']};
 const tjp=(h,m)=>[`${HK[h]}時|${HR[h]}じ`].concat(m?[MN[m].join('|')]:[]),flat=t=>t.map(x=>x.split('|')[0]).join(''),kana=t=>t.map(x=>x.split('|')[1]||x.split('|')[0]).join('');
 const FOOD=[['ラーメン','ramen','🍜'],['おにぎり','onigiri','🍙'],['お茶|おちゃ','thé','🍵'],['だんご','dango','🍡'],['水|みず','eau','💧'],['魚|さかな','poisson','🐟']],CT=['','一つ|ひとつ','二つ|ふたつ','三つ|みっつ','四つ|よっつ'];
 const GAMES=[{id:'mem',k:'合',n:'Les paires',d:'Retourne les cartes et associe chaque kanji à son sens.',ok:()=>known().length>=4,lock:'Apprends tes premiers kanji au dojo.'},
  {id:'ord',k:'順',n:'La phrase en désordre',d:'Remets les mots d\'une phrase de ton carnet dans le bon ordre.',ok:()=>pool().length>=3,lock:'Il te faut au moins trois phrases dans ton carnet.'},
  {id:'prix',k:'円',n:'Le juste prix',d:'Le marchand annonce son prix en japonais : trouve le bon montant.',ok:()=>reach()>=1,lock:'S\'ouvre au Hameau des bambous.'},
  {id:'resto',k:'食',n:'La commande',d:'Un client commande en japonais : sers-lui exactement ce qu\'il demande.',ok:()=>reach()>=6,lock:'S\'ouvre au Relais de la Grand-Route.'},
  {id:'heure',k:'時',n:'L\'horloge de la gare',d:'Lis l\'heure sur le cadran et choisis la bonne phrase.',ok:()=>reach()>=8,lock:'S\'ouvre à la ville basse de Kurogane.'}];
 const PUN=/^[。、！？!?…「」]+$/,pool=()=>Object.keys(S.ph||{}).filter(k=>PHR[k]).map(k=>PHR[k]).filter(p=>{const n=p.t.filter(x=>!PUN.test(x)).length;return n>=3&&n<=7});
 const mg=()=>{if(!S.mg||S.mg.d!==today())S.mg={d:today(),g:{}};return S.mg};
 function games(){if(gm)return play();const m=mg();return `<p style="font-size:12px;color:var(--sub);margin:0 0 6px">Cinq manches par partie. La première réussite du jour à chaque jeu rapporte 5 XP et 10 円 ; les suivantes, 1 XP.</p>`+GAMES.map(G=>{const ok=G.ok();return `<div class="mi ${ok?'':'lock'}"><div class="k" style="color:var(--cy)">${ok?G.k:'🔒'}</div><div class="t"><b>${G.n}</b>${ok?G.d:G.lock}${m.g[G.id]?'<br><small>Fait aujourd\'hui ✓</small>':''}</div>${ok?`<button class="go" data-xg="${G.id}">Jouer</button>`:''}</div>`}).join('')}
 function next(){const g=gm;g.r++;g.msg='';g.lock=0;if(g.r>5){g.end=1;return}
  if(g.id==='mem'){const ks=shuf(known()).slice(0,6).map(x=>x[2]);g.c=shuf(ks.flatMap((q,i)=>[{p:i,t:q.k,b:1},{p:i,t:q.fr.split(',')[0]}]));g.o=[];g.f={};g.mv=0;g.r=5}
  else if(g.id==='ord'){const p=pool()[rnd(pool().length)];g.p=p;g.t=p.t.filter(x=>!PUN.test(x));g.pl=shuf(g.t.map((x,i)=>i));g.a=[]}
  else if(g.id==='prix'){const R=reach(),n=R<2?1+rnd(10):R<8?1+rnd(99):R<10?(1+rnd(99))*10*(rnd(2)?10:1):(1+rnd(999))*50;g.n=n;const o=new Set([n]);let s=0;while(o.size<4&&s++<60){const c=[n*10,Math.round(n/10),n+[1,10,100,1000][rnd(n<100?2:4)],n-[1,10,100][rnd(n<100?2:3)],Number(String(n).split('').reverse().join(''))][rnd(5)];if(c>0&&c<1e5&&Number.isInteger(c))o.add(c)}while(o.size<4)o.add(1+rnd(99));g.o=shuf([...o]);const[k,r]=num(n);g.t=[`${k}円|${r}えん`,'です','。'];say(r+'えんです',.9)}
  else if(g.id==='heure'){const ms=reach()<9?[0,30]:[0,30,15,45,10,20,40,50],h=1+rnd(12),m=ms[rnd(ms.length)];g.h=h;g.m=m;const o=[[h,m]];let s=0;while(o.length<4&&s++<60){const c=[rnd(2)?h:1+rnd(12),rnd(2)?m:ms[rnd(ms.length)]];if(m&&rnd(3)===0){c[0]=Math.round(m/5)||12;c[1]=0}if(!o.some(x=>x[0]===c[0]&&x[1]===c[1]))o.push(c)}while(o.length<4){const c=[1+rnd(12),0];if(!o.some(x=>x[0]===c[0]&&x[1]===c[1]))o.push(c)}g.o=shuf(o)}
  else if(g.id==='resto'){const it=shuf(FOOD.map((x,i)=>i)).slice(0,4),two=g.r>1;g.it=it;g.w={[it[0]]:1+rnd(3)};if(two)g.w[it[1]]=1+rnd(2);g.c={};it.forEach(i=>g.c[i]=0);const ks=Object.keys(g.w).map(Number);g.t=ks.flatMap((i,j)=>[FOOD[i][0],'を',CT[g.w[i]]].concat(j<ks.length-1?['と']:[])).concat(['ください','。']);say(kana(g.t),.9)}}
 function win(){const g=gm,m=mg(),first=!m.g[g.id],ok=g.id==='mem'||g.sc>=3;if(ok){m.g[g.id]=1;S.xp+=first?5:1;if(first)S.gold=(S.gold||0)+10;try{Quest.add('dojo')}catch(e){}sfx('lvl')}else sfx('back');save();return ok?(first?'+5 XP · +10 円':'+1 XP'):'Il faut au moins 3 bonnes réponses sur 5 pour la récompense.'}
 function play(){const g=gm,G=GAMES.find(x=>x.id===g.id),top=`<div class="sw" style="border:0;padding:2px 0 8px"><span><button class="go" data-xq="1">◀ Quitter</button> ${G.n}</span><span style="color:var(--gold)">${g.id==='mem'?`${g.mv||0} coups`:`Manche ${Math.min(5,g.r)}/5 · ${g.sc} ✓`}</span></div>`;
  if(g.end)return top+`<div class="mi"><div class="k" style="color:var(--cy)">${G.k}</div><div class="t"><b>${g.id==='mem'?`Toutes les paires trouvées en ${g.mv} coups !`:`${g.sc} bonne${g.sc>1?'s':''} réponse${g.sc>1?'s':''} sur 5`}</b>${g.rw}</div></div><button class="btn" data-xg="${g.id}" style="width:100%;margin:6px 0">Rejouer</button>`;
  const msg=g.msg?`<p style="font-size:13px;margin:8px 0;color:${g.good?'#7fe0a0':'#ffb0a0'}">${g.msg}</p>${g.id==='mem'?'':'<button class="btn" data-xn="1" style="width:100%">Suite ▶</button>'}`:'';
  if(g.id==='mem')return top+`<div style="display:grid;grid-template-columns:repeat(4,1fr);gap:6px">${g.c.map((c,i)=>{const up=g.f[c.p]||g.o.includes(i);return `<button data-xc="${i}" class="btn ${up?'':'dark'}" style="height:62px;padding:2px;font-size:${up?(c.b?28:12):22}px;line-height:1.1;${g.f[c.p]?'opacity:.55':''}">${up?esc(c.t):'？'}</button>`}).join('')}</div>`;
  if(g.id==='ord')return top+`<p style="margin:0 0 8px">« ${esc(g.p.fr)} »</p><div style="min-height:52px;border:1px dashed var(--brass);border-radius:6px;padding:6px;display:flex;flex-wrap:wrap;gap:5px">${g.a.map(i=>`<button data-xa="${i}" class="btn" style="padding:6px 9px"><span class="jp">${jpHtml([g.t[i]])}</span></button>`).join('')}</div><div style="display:flex;flex-wrap:wrap;gap:5px;margin-top:10px">${g.pl.filter(i=>!g.a.includes(i)).map(i=>`<button data-xt="${i}" class="btn dark" style="padding:6px 9px"><span class="jp">${jpHtml([g.t[i]])}</span></button>`).join('')}</div>`+msg;
  const opts=f=>`<div style="display:grid;grid-template-columns:1fr 1fr;gap:6px;margin-top:10px">${g.o.map((o,i)=>`<button data-xo="${i}" class="btn ${g.lock?(g.right===i?'':'dark'):''}" style="padding:10px 4px;font-size:15px">${f(o)}</button>`).join('')}</div>`;
  if(g.id==='prix')return top+`<div class="mi"><div class="k">🪙</div><div class="t"><div class="jp" style="font-size:20px">${jpHtml(g.t)}</div><small>Combien demande le marchand ?</small></div><button class="spk" data-xs="${esc(kana(g.t))}" aria-label="Écouter">🔊</button></div>`+opts(o=>o.toLocaleString('fr-FR')+' 円')+msg;
  if(g.id==='heure'){const a=(g.h%12+g.m/60)*30,b=g.m*6,hand=(d,l,w)=>`<line x1="60" y1="60" x2="${60+l*Math.sin(d*Math.PI/180)}" y2="${60-l*Math.cos(d*Math.PI/180)}" stroke="#1b1418" stroke-width="${w}" stroke-linecap="round"/>`;
   return top+`<div style="text-align:center"><svg viewBox="0 0 120 120" style="width:150px;height:150px"><circle cx="60" cy="60" r="56" fill="#f4ead0" stroke="#a87a2a" stroke-width="5"/>${Array.from({length:12},(_,i)=>`<text x="${60+44*Math.sin((i+1)*Math.PI/6)}" y="${64-44*Math.cos((i+1)*Math.PI/6)}" font-size="11" text-anchor="middle" fill="#3a2608">${i+1}</text>`).join('')}${hand(a,26,5)}${hand(b,40,3)}<circle cx="60" cy="60" r="4" fill="#c8401f"/></svg><br><small>今、何時ですか。 Quelle heure est-il ?</small></div>`+opts(o=>`<span class="jp">${jpHtml(tjp(o[0],o[1]).concat(['です']))}</span>`)+msg}
  return top+`<div class="mi"><div class="k">客</div><div class="t"><div class="jp" style="font-size:17px">${jpHtml(g.t)}</div><small>Prépare le plateau, puis sers.</small></div><button class="spk" data-xs="${esc(kana(g.t))}" aria-label="Écouter">🔊</button></div><div style="display:grid;grid-template-columns:1fr 1fr;gap:6px;margin-top:8px">${g.it.map(i=>`<div class="mi" style="margin:0;padding:6px;display:flex;align-items:center;gap:6px"><span style="font-size:26px">${FOOD[i][2]}</span><button class="go" data-xm="${i},-1" style="min-width:30px">−</button><b style="min-width:16px;text-align:center">${g.c[i]}</b><button class="go" data-xm="${i},1" style="min-width:30px">+</button></div>`).join('')}</div>${g.lock?'':'<button class="btn" data-xv="1" style="width:100%;margin-top:8px">Servir</button>'}`+msg}
 function res(ok,why){const g=gm;g.lock=1;g.good=ok;if(ok){g.sc++;sfx('ok')}else sfx('bump');g.msg=(ok?'正解！ Bonne réponse. ':'ざんねん… ')+(why||'')}
 /* --- calendrier de tampons --- */
 const RW={3:[50,0],7:[100,1],14:[200,1],30:[500,2]};
 function stamp(){const q=S.dq;if(!q||!q.done)return;const c=S.cal||(S.cal={});if(c[q.d])return;c[q.d]=1;const n=S.streak?S.streak.n:1,r=RW[n];if(r&&!S.fl['sr'+n]){S.fl['sr'+n]=1;S.gold+=r[0];S.omamori=(S.omamori||0)+r[1];setTimeout(()=>{UI.toast(`${n} jours de suite ! +${r[0]} 文${r[1]?` et ${r[1]} amulette${r[1]>1?'s':''} お守り`:''}`,5000);sfx('lvl')},2600)}save()}
 function cal(){const c=S.cal||{},d=new Date(),y=d.getFullYear(),m=d.getMonth(),n=new Date(y,m+1,0).getDate(),off=(new Date(y,m,1).getDay()+6)%7,td=today(),st=Quest.streak(),nx=[3,7,14,30].find(x=>x>st);let h='';for(let i=0;i<off;i++)h+='<i></i>';
  for(let k=1;k<=n;k++){const key=day(new Date(y,m,k)),v=c[key];h+=`<i style="position:relative;display:flex;align-items:center;justify-content:center;height:30px;font-style:normal;font-size:11px;border-radius:4px;background:rgba(255,255,255,.05);${key===td?'outline:1px solid var(--cy);':''}color:var(--sub)">${k}${v?`<b style="position:absolute;inset:2px;display:flex;align-items:center;justify-content:center;border:2px solid ${v===2?'#58a0d8':'#d8402a'};color:${v===2?'#58a0d8':'#d8402a'};border-radius:50%;font-size:13px;transform:rotate(-12deg);background:rgba(20,16,30,.75)">${v===2?'守':'済'}</b>`:''}</i>`}
  return `<div class="mi" style="display:block"><div class="sw" style="border:0;padding:0 0 6px"><span><b>Carnet de tampons</b> · ${d.toLocaleDateString('fr-FR',{month:'long',year:'numeric'})}</span><span style="color:var(--gold)">お守り × ${S.omamori||0}</span></div><div style="display:grid;grid-template-columns:repeat(7,1fr);gap:3px;text-align:center"><small>L</small><small>M</small><small>M</small><small>J</small><small>V</small><small>S</small><small>D</small>${h}</div><p style="font-size:12px;color:var(--sub);margin:6px 0 0">Un tampon 済 par jour où tu termines les trois défis. ${nx?`Prochaine récompense à ${nx} jours de suite.`:'Tu as décroché toutes les récompenses de série !'} Une amulette お守り sauve ta série si tu manques un jour.</p></div>`}
 function daily(){const KG='影',T_=(n,t)=>({n,t}),s=S.streak;let lines=null;
  if(s&&s.n>0&&s.last===ago(2)&&(S.omamori||0)>0){S.omamori--;s.last=ago(1);(S.cal||(S.cal={}))[ago(1)]=2;lines=["Ton amulette お守り s'effrite entre tes doigts : elle a protégé ta série de "+s.n+" jour"+(s.n>1?'s':'')+" pendant ton absence."]}
  const gap=S.seen?dayN()-S.seen:0;S.seen=dayN();
  if(gap>=2&&S.fl.intro){try{lines=(lines||[]).concat(More.recap())}catch(e){}}
  if(gap>=3&&S.fl.intro){const a=S.fl.kz1?[T_(KG,`${gap} jours. J'ai compté. Je n'avais rien d'autre à faire, enfermé là-dedans.`),{n:KG,jp:['久しぶり|ひさしぶり','です','ね','。'],fr:'Ça faisait longtemps, hein.',x:'久しぶり (ひさしぶり) = « ça fait longtemps »'},T_(KG,"Tes kanji ont rouillé, je le sens d'ici. Passe par la révision du jour avant de te battre, ou c'est moi qui vais avoir honte.")]:[`Cela fait ${gap} jours que tu n'as pas pratiqué. Commence par la révision du jour, dans le menu : la mémoire s'entretient comme un sabre.`];lines=(lines||[]).concat(a)}
  save();if(lines)W.ev(async()=>{await D.say(lines)})}
 setInterval(()=>{try{const b=$('#kDemon');if(b)b.style.visibility=(typeof S==='undefined'||!S.fl||S.fl.kz1||S.fl.intro||S.fl.act1||S.fl.visit||(S.xp||0)>0||Object.keys(S.wins||{}).length||S.fl.noscn)?'':'hidden'}catch(e){}},500);
 let dd=0;setInterval(()=>{try{if(!dd&&G.scene==='world'&&!G.busy&&UI.cur==='pad'&&!S.fl.noscn){dd=1;daily()}if(typeof S!=='undefined'&&S.dq)stamp()}catch(e){}},2500);
 /* --- clics --- */
 function click(b,R){const d=b.dataset;
  if(d.xs){say(d.xs,.85);return true}
  if(d.xgo!=null){const p=+d.xgo;if(W.map!=='world'){UI.toast('Sors d\'abord du bâtiment.');return true}const h=p?HAMS.find(q=>q.z===p+1):null,y=p?h.y1-1:OY+85,x=9+RX(y);view=null;$('#mClose').click();W.ev(async()=>{sfx('door');await UI.fade(1,350);W.load('world',x,y,1);W.H.cd=2;await UI.fade(0,350);W.refreshZone();save();UI.toast('駕籠 · Arrivée : '+PN[p],2400)});return true}
  if(d.xf){S.fbs=+d.xf;save();R();demo(true);return true}
  if(d.xth!=null){if(!Path.lvl(THEMES[+d.xth].id)){sfx('bump');UI.toast('Thème encore verrouillé : '+THEMES[+d.xth].name);return true}view={t:+d.xth};sfx('tap');R();$('#mBody').scrollTop=0;return true}
  if(d.xb){if(view&&view.k&&view.from!=null){view={p:view.from}}else if(view&&view.k&&view.ft!=null){view={t:view.ft}}else view=null;cancelAnimationFrame(raf);R();$('#mBody').scrollTop=0;return true}
  if(d.xp!=null){if(+d.xp<0){sfx('bump');return true}view={p:+d.xp};sfx('tap');R();$('#mBody').scrollTop=0;return true}
  if(d.xk){const[t,i]=d.xk.split(',').map(Number);view={k:[t,i],from:view&&(view.p!=null?view.p:view.from),ft:view&&(view.t!=null?view.t:view.ft)};sfx('tap');R();$('#mBody').scrollTop=0;return true}
  if(d.xq){gm=null;R();return true}
  if(d.xg){gm={id:d.xg,r:0,sc:0};next();sfx('sel');R();return true}
  if(!gm)return false;const g=gm;
  if(d.xn){next();if(g.end)g.rw=win();R();return true}
  if(d.xc!=null){const i=+d.xc,c=g.c[i];if(g.wait||g.f[c.p]||g.o.includes(i))return true;g.o.push(i);sfx('tap');if(c.b)say(known().find(x=>x[2].k===c.t)[2].kun,.9);
   if(g.o.length===2){g.mv++;const[a,b2]=g.o.map(j=>g.c[j]);if(a.p===b2.p){g.f[a.p]=1;g.o=[];sfx('ok');if(Object.keys(g.f).length===g.c.length/2){g.end=1;g.rw=win()}}else{g.wait=1;setTimeout(()=>{g.o=[];g.wait=0;if(gm===g)R()},800)}}R();return true}
  if(d.xt!=null){if(g.lock)return true;g.a.push(+d.xt);sfx('tap');if(g.a.length===g.t.length){const ok=g.a.map(i=>g.t[i].split('|')[0]).join('')===flat(g.t);res(ok,ok?'':'La phrase était : '+flat(g.p.t));say(kana(g.t),.9)}R();return true}
  if(d.xa!=null){if(g.lock)return true;g.a=g.a.filter(i=>i!==+d.xa);R();return true}
  if(d.xo!=null){if(g.lock)return true;const o=g.o[+d.xo];if(g.id==='prix'){g.right=g.o.indexOf(g.n);res(o===g.n,`${flat(g.t.slice(0,1))} = ${g.n.toLocaleString('fr-FR')} 円`)}else{g.right=g.o.findIndex(x=>x[0]===g.h&&x[1]===g.m);const ok=o[0]===g.h&&o[1]===g.m,t=tjp(g.h,g.m);res(ok,`${flat(t)} (${kana(t)})`);say(kana(t)+'です',.9)}R();return true}
  if(d.xm){if(g.lock)return true;const[i,v]=d.xm.split(',').map(Number);g.c[i]=Math.max(0,Math.min(4,g.c[i]+v));sfx('tap');R();return true}
  if(d.xv){const ok=g.it.every(i=>g.c[i]===(g.w[i]||0));res(ok,ok?'Le client est ravi.':'Il voulait : '+Object.keys(g.w).map(i=>`${g.w[i]} × ${FOOD[i][1]}`).join(', ')+'.');R();return true}
  return false}
 function after(tab){if(view&&view.k){const q=THEMES[view.k[0]].k[view.k[1]];anim(q)}else if(tab==='ca'&&!view){setTimeout(()=>{const b=$('#mBody'),m=$('#xMap');if(b&&m){const i=Math.min(PN.length-1,here());b.scrollTop=Math.max(0,m.offsetTop-b.offsetTop+m.offsetHeight*MK[i][1]/1376-b.clientHeight/2)}},30)}}
 const page=tab=>view&&view.k?kcard(view.k[0],view.k[1]):null;
 document.addEventListener('input',e=>{if(e.target&&e.target.id==='xKq'){kq=e.target.value;const r=$('#xKres');if(r)r.innerHTML=kres()}});
 return{map,games,kanji,opt,cal,click,after,reset,page,num,reach}})();

/* ---------- accueil, mes erreurs, lecture, fin d'acte, séance éclair, taille du texte, furigana au toucher ---------- */
const More=(()=>{
 const er=()=>S.er||(S.er={}),today=()=>dayN();
 /* --- mes erreurs : tout ce qui est raté est noté, tout ce qui est réussi ensuite s'efface peu à peu --- */
 function rec(key,ok,data){const E=er();if(ok){if(E[key]){E[key].n--;if(E[key].n<=0)delete E[key]}}else{const o=E[key]||(E[key]={n:0});o.n=Math.min(9,o.n+1);o.d=today();Object.assign(o,data);const ks=Object.keys(E);if(ks.length>40){ks.sort((a,b)=>E[a].n-E[b].n||E[a].d-E[b].d);delete E[ks[0]]}}}
 const strip=e=>{const o={};['q','p','big','a','o','why','t','fr','x','listen','snd','show'].forEach(k=>{if(e[k]!=null)o[k]=e[k]});return o};
 {const o=Ex.run;Ex.run=async(e,opt)=>{const r=await o(e,opt);try{if(r!=='quit'&&e&&(e.q==='mcq'||e.q==='ord')){const key=e.big||(e.t?jpText(e.t):e.snd||e.a);if(key)rec('q:'+key,!!r,{q:strip(e),lb:e.big||(e.t?jpText(e.t):e.listen?'🔊 '+e.a:e.a),an:e.q==='ord'?e.fr:e.a})}}catch(x){}return r};
  const t=Trace.run;Trace.run=async(sp,opt)=>{const r=await t(sp,opt);try{if(r&&sp&&sp.k&&/[一-鿿]/.test(sp.k))rec('tr:'+sp.k,r.stars>=2,{tr:sp.k,lb:sp.k,an:'tracé · '+(sp.fr||'')})}catch(x){}return r}}
 const errs=()=>Object.entries(er()).sort((a,b)=>b[1].n-a[1].n||b[1].d-a[1].d);
 function errHtml(){const L=errs();if(!L.length)return `<div class="mi"><div class="k" style="color:var(--cy)">誤</div><div class="t"><b>Aucune erreur à revoir</b>Tout ce que tu rates en quiz, en combat ou au tracé vient se ranger ici, puis s'efface quand tu le réussis à nouveau.</div></div>`;
  return `<div class="mi"><div class="k" style="color:var(--cy)">誤</div><div class="t"><b>${L.length} point${L.length>1?'s':''} à retravailler</b>Les plus ratés en premier. Chaque réussite fait redescendre un point, jusqu'à ce qu'il disparaisse.</div><button class="go" data-ker="1">Réviser</button></div>`+L.slice(0,10).map(([k,o])=>`<div class="mi"><div class="k" style="font-size:${String(o.lb||'').length>2?15:26}px;max-width:96px;overflow:hidden;line-height:1.2">${esc(String(o.lb||'').slice(0,12))}</div><div class="t"><b>${esc(o.an||'')}</b><small>${o.tr?'Tracé du kanji':'Question'} · raté ${o.n} fois</small></div></div>`).join('')}
 async function errSession(max){const L=errs().slice(0,max||8);let good=0,n=0;for(const[k,o]of L){n++;if(o.tr){const sp=SP.find(s=>s.k===o.tr);if(!sp){delete er()[k];n--;continue}const r=await Trace.run(sp);if(!r){n--;break}if(r.stars>=2)good++}else{const r=await Ex.run(JSON.parse(JSON.stringify(o.q)),{quit:1,head:`<b>誤 ${n}/${L.length}</b> · `});if(r==='quit'){n--;break}if(r)good++}}
  if(n){S.xp+=good;save();UI.toast(`Erreurs revues : ${good} / ${n} · +${good} XP`,2600)}return n}
 /* --- compréhension écrite --- */
 const TX=[
  {id:'r0',at:0,ic:'札',n:'Le panneau du village',ctx:'Planté à l\'entrée de Kome. Quelqu\'un a rajouté la dernière ligne au charbon.',t:[['米|こめ','の','里|さと','です','。'],['人|ひと','は','五十人|ごじゅうにん','です','。'],['たぬき','は','一人|ひとり','です','。']],q:[['Combien d\'habitants compte le village ?','Cinquante',['Cinq','Quinze','Cinq cents'],'五十人 (ごじゅうにん) = cinquante personnes.'],['Combien y a-t-il de tanuki ?','Un seul',['Aucun','Deux','Cinquante'],'一人 (ひとり) = une personne. Maître Tanuki tient à être compté.']]},
  {id:'r1',at:1,ic:'茶',n:'L\'ardoise de la maison de thé',ctx:'Accrochée de travers au Hameau des bambous.',t:[['お茶|おちゃ','は','三円|さんえん','です','。'],['だんご','は','五円|ごえん','です','。'],['お茶|おちゃ','と','だんご','は','七円|ななえん','です','。'],['安い|やすい','です','！']],q:[['Combien coûtent les dango seuls ?','Cinq yen',['Trois yen','Sept yen','Huit yen'],'だんごは五文です。'],['Que gagne-t-on à prendre thé et dango ensemble ?','Un mon de moins',['Rien du tout','Un dango offert','Deux yen de moins'],'3 + 5 = 8, mais l\'ardoise dit 七文 : sept.']]},
  {id:'r2',at:2,ic:'妹',n:'Un mot de Hana',ctx:'Glissé dans ton sac avant ton départ. Tu ne l\'avais pas vu.',t:[['お兄ちゃん|おにいちゃん','へ','。'],['きのう','は','雨|あめ','でした','。'],['今日|きょう','は','いい','天気|てんき','です','。'],['田んぼ|たんぼ','の','水|みず','は','多い|おおい','です','。'],['元気|げんき','です','か','。']],q:[['Quel temps faisait-il hier à Kome ?','Il pleuvait',['Il faisait beau','Il neigeait','Il y avait du vent'],'きのうは雨でした。'],['Que dit Hana de la rizière ?','Il y a beaucoup d\'eau',['Elle est sèche','Le riz est mûr','Elle est gelée'],'水は多いです : l\'eau est abondante.']]},
  {id:'r3',at:3,ic:'場',n:'Le règlement de l\'usine',ctx:'Cloué à la porte d\'un atelier du Quartier des fumées. Signé d\'un sceau en forme d\'enclume.',t:[['朝|あさ','、','六時|ろくじ','に','来て|きて','ください','。'],['昼|ひる','は','休みません|やすみません','。'],['夜|よる','、','八時|はちじ','に','帰ります|かえります','。'],['話さないで|はなさないで','ください','。']],q:[['À quelle heure faut-il arriver ?','À six heures du matin',['À huit heures du matin','À six heures du soir','À midi'],'朝、六時に来てください。'],['Que se passe-t-il à midi ?','On ne se repose pas',['On mange une heure','On rentre chez soi','On change d\'équipe'],'昼は休みません : pas de pause.']]},
  {id:'r4',at:5,ic:'筆',n:'Une lettre inachevée',ctx:'Une feuille froissée, sous un banc du refuge. L\'écriture est d\'une beauté rare. Elle s\'arrête au milieu d\'une ligne.',t:[['菊|きく','へ','。'],['今日|きょう','、','新しい|あたらしい','筆|ふで','を','買いました|かいました','。'],['小さい|ちいさい','筆|ふで','です','。'],['菊|きく','の','手|て','は','小さい|ちいさい','です','から','。'],['あした','、','一緒に|いっしょに','書きましょう|かきましょう','。']],q:[['Qu\'a acheté celui qui écrit ?','Un pinceau neuf',['Un livre','Une lanterne','Du papier'],'新しい筆を買いました。'],['Pourquoi l\'a-t-il choisi petit ?','Parce que Kiku a de petites mains',['Parce qu\'il coûtait moins cher','Parce qu\'il voyage beaucoup','Parce qu\'il n\'en restait pas d\'autre'],'きくの手は小さいですから : から donne la raison.']]},
  {id:'r5',at:6,ic:'駅',n:'Les horaires de la diligence',ctx:'Affichés au Relais de la Grand-Route.',t:[['黒鉄|くろがね','行き|いき','は','、','午前|ごぜん','九時|くじ','と','午後|ごご','三時|さんじ','です','。'],['土曜日|どようび','と','日曜日|にちようび','は','休み|やすみ','です','。'],['切符|きっぷ','は','百円|ひゃくえん','です','。']],q:[['Quand part la diligence pour Kurogane ?','À 9 h et à 15 h',['À 9 h seulement','À 3 h et à 9 h du soir','Toutes les heures'],'午前九時 = 9 h du matin, 午後三時 = 3 h de l\'après-midi.'],['Quels jours ne roule-t-elle pas ?','Le samedi et le dimanche',['Le lundi','Le dimanche seulement','Les jours de pluie'],'土曜日と日曜日は休みです。']]},
  {id:'r6',at:7,ic:'父',n:'Une deuxième lettre inachevée',ctx:'Pliée en bateau, coincée entre deux planches du ponton. La même écriture.',t:[['菊|きく','へ','。'],['今日|きょう','、','菊|きく','は','「','父|ちち','」','と','書きました|かきました','。'],['上手|じょうず','でした','。'],['わたし','は','泣きました|なきました','。'],['でも','、','菊|きく','は','笑いました|わらいました','。']],q:[['Quel mot Kiku a-t-elle écrit ?','« Père »',['« Pinceau »','Son propre nom','« Mère »'],'父 (ちち) = père, quand on parle du sien.'],['Comment a réagi celui qui écrit ?','Il a pleuré',['Il a ri','Il s\'est fâché','Il n\'a rien dit'],'わたしは泣きました。C\'est Kiku qui a ri.']]},
  {id:'r7',at:8,ic:'新',n:'Le journal de la ville basse',ctx:'Imprimé la nuit, vendu sous le manteau.',t:[['上|うえ','の','町|まち','は','明るい|あかるい','です','。'],['下|した','の','町|まち','は','暗い|くらい','です','。'],['下|した','の','町|まち','の','人|ひと','は','毎日|まいにち','働きます|はたらきます','。'],['でも','、','お金|おかね','は','上|うえ','に','行きます|いきます','。']],q:[['Comment est décrite la ville du bas ?','Sombre',['Lumineuse','Riche','Vide'],'下の町は暗いです。'],['Où va l\'argent ?','En haut',['Il reste en bas','Aux Forges','Nulle part'],'お金は上に行きます。']]},
  {id:'r8',at:9,ic:'言',n:'La dernière lettre inachevée',ctx:'Rangée dans un livre de la bibliothèque de l\'Académie. L\'encre a coulé par endroits.',t:[['菊|きく','へ','。'],['菊|きく','は','もう','いません','。'],['でも','、','言葉|ことば','は','あります','。'],['世界|せかい','の','言葉|ことば','を','全部|ぜんぶ','集めます|あつめます','。'],['そして','、','菊|きく','の','名前|なまえ','を','書きます|かきます','。']],q:[['Que veut rassembler celui qui écrit ?','Tous les mots du monde',['Tous les pinceaux','Une armée','L\'argent de la ville'],'世界の言葉を全部集めます。'],['Pour quoi faire ?','Pour écrire le nom de Kiku',['Pour devenir seigneur','Pour ouvrir une école','Pour les vendre'],'そして、きくの名前を書きます。Et il signe du sceau à l\'enclume : Tetsu.']]},
  {id:'r9',at:10,ic:'火',n:'L\'avis des Grandes Forges',ctx:'Peint en rouge sur une plaque de fer.',t:[['ここ','は','危ない|あぶない','です','。'],['火|ひ','に','気|き','を','つけて','ください','。'],['子ども|こども','は','入らないで|はいらないで','ください','。'],['水|みず','は','左|ひだり','に','あります','。']],q:[['Que demande-t-on aux enfants ?','De ne pas entrer',['De porter de l\'eau','De rester à gauche','De surveiller le feu'],'子どもは入らないでください。'],['Où trouve-t-on de l\'eau ?','À gauche',['À droite','Dehors','Il n\'y en a pas'],'水は左にあります。']]}];
 let rdv=null;const rd=()=>S.rd||(S.rd={}),reach=()=>Extra.reach();
 function readHtml(){if(rdv){const X=TX.find(x=>x.id===rdv);return `<button class="go" data-krb="1" style="margin-bottom:8px">◀ Textes</button><div class="mi"><div class="k" style="color:var(--cy)">${X.ic}</div><div class="t"><b>${esc(X.n)}</b><small>${esc(X.ctx)}</small></div></div><div style="background:#f4ead0;color:#2a2018;border:1px solid #c9b88a;border-radius:8px;padding:12px 14px;margin:8px 0;box-shadow:inset 0 0 0 3px #f9f2df" class="rdt">${X.t.map(l=>`<div class="jp" style="font-size:20px;line-height:2.1">${jpHtml(l)}</div>`).join('')}</div><p style="font-size:12px;color:var(--sub);margin:0 0 8px">Lis sans te presser. Un mot souligné en pointillé ? Touche-le pour voir sa lecture.</p><button class="btn" data-krq="${X.id}" style="width:100%">Répondre aux ${X.q.length} questions</button>`}
  const R=reach();return `<p style="font-size:12px;color:var(--sub);margin:0 0 6px">De courts textes trouvés en chemin, comme à l'épreuve de lecture du N5. Lis d'abord, réponds ensuite. La première réussite complète rapporte 6 XP.</p>`+TX.map(X=>{const ok=X.at<=R,s=rd()[X.id];return `<div class="mi ${ok?'':'lock'}"><div class="k" style="color:var(--cy)">${ok?X.ic:'🔒'}</div><div class="t"><b>${ok?esc(X.n):'？？？'}</b>${ok?`<small>${s!=null?`Meilleur résultat : ${s} / ${X.q.length}${s===X.q.length?' ✓':''}`:'Pas encore lu'}</small>`:'<small>À trouver plus loin sur la route.</small>'}</div>${ok?`<button class="go" data-krd="${X.id}">Lire</button>`:''}</div>`}).join('')}
 async function readRun(id){const X=TX.find(x=>x.id===id);let good=0,n=0;for(const q of X.q){n++;const r=await Ex.run({q:'mcq',p:q[0],a:q[1],o:[q[1],...q[2]],why:q[3]},{quit:1,head:`<b>読 ${n}/${X.q.length}</b> · `});if(r==='quit')return;if(r)good++}
  const old=rd()[id];if(old==null||good>old)rd()[id]=good;if(good===X.q.length&&old!==X.q.length){S.xp+=6;UI.toast('Texte compris ! +6 XP',2600);try{Quest.add('dojo')}catch(e){}}save()}
 /* --- options : taille du texte --- */
 const applyTz=()=>{const a=$('#app');if(!a)return;const n=S.tsz||0;a.classList.toggle('tz1',n===1);a.classList.toggle('tz2',n===2)};
 function optHtml(){const n=S.tsz||0,L=S.lang||'fr',fr=Object.keys(I18N.en).length;return `<div class="sw" style="flex-wrap:wrap;gap:6px"><span>Langue</span><span style="display:flex;flex-wrap:wrap;gap:4px;justify-content:flex-end">${LANGS.map(([k,nm,fl])=>`<button data-klg="${k}" class="${k===L?'on':''}" style="min-width:0;padding:5px 8px">${fl} ${nm}</button>`).join('')}</span></div><div class="sw"><span>Taille du texte</span><span style="white-space:nowrap">${['Normale','Grande','Très grande'].map((l,i)=>`<button data-ktz="${i}" class="${i===n?'on':''}" style="min-width:0;padding:6px 9px;font-size:${12+i*2}px">${l}</button>`)
.join(' ')}</span></div><div class="sw"><span>Volume de la musique</span><span style="display:flex;align-items:center;gap:8px"><input id="kMv" type="range" min="0" max="100" step="5" value="${Math.round((S.mv==null?1:S.mv)*100)}" style="width:130px" aria-label="Volume de la musique"><small id="kMvL" style="min-width:38px;text-align:right">${Math.round((S.mv==null?1:S.mv)*100)} %</small></span></div>`}
 /* --- clics du menu --- */
 function click(b,R){const d=b.dataset;
  if(d.klg){S.lang=d.klg;save();I18D.dirty=1;window.I18LOAD&&I18LOAD(S.lang);sfx('tap');R();setTimeout(()=>I18D.run(),30);return true}
  if(d.ktz!=null){S.tsz=+d.ktz;applyTz();save();sfx('tap');R();return true}
  if(d.krd){rdv=d.krd;sfx('tap');R();$('#mBody').scrollTop=0;return true}
  if(d.krb){rdv=null;R();return true}
  if(d.krq){readRun(d.krq).then(()=>{UI.panel('menu');rdv=null;R()});return true}
  if(d.ker){errSession(8).then(()=>{UI.panel('menu');R()});return true}
  return false}
 /* --- accueil : le but du jeu, avant toute chose --- */
 function welcome(){return new Promise(res=>{const P=[['学','Bienvenue dans Jōki Zamurai','Ceci est un jeu pour <b>apprendre le japonais</b>. Tu pars de zéro : aucune connaissance n\'est demandée.<br><br>Ton but : atteindre le niveau <b>JLPT N5</b>, le premier niveau de l\'examen officiel de japonais. Cela représente une centaine de kanji, environ 800 mots et la grammaire de base.'],
   ['旅','Comment on apprend','Tu voyages de bourg en bourg. Chacun t\'enseigne <b>cinq kanji</b> et <b>deux leçons</b> de grammaire.<br><br>Les kanji se tracent au doigt. Les combats se gagnent en traçant et en répondant juste. Un peu de révision chaque jour vaut mieux qu\'une longue séance par semaine.'],
   ['塔','Au bout du voyage','Tout en haut t\'attend une <b>tour de quatre étages</b> : un étage par épreuve de l\'examen N5. Vocabulaire, grammaire, lecture, écoute.<br><br>Ce sera ton examen blanc. D\'ici là, personne ne te note : trompe-toi autant qu\'il le faut.']];let i=0;
  const box=document.createElement('div');box.id='welc';box.style.cssText='position:absolute;inset:0;z-index:70;background:linear-gradient(#1c2238,#10131f);display:flex;flex-direction:column;align-items:center;justify-content:center;padding:26px 22px;gap:16px;text-align:center;color:#e8ecf8';$('#app').appendChild(box);
  const draw=()=>{const p=P[i];box.innerHTML=`<div style="width:86px;height:86px;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:44px;color:#2a1a04;background:radial-gradient(circle at 35% 30%,#fff0b8,#d8a848);border:3px solid #7a5420;animation:fbStamp .45s both">${p[0]}</div><h2 style="margin:0;font-size:21px;color:#f0cf7a;font-weight:400">${p[1]}</h2><p style="margin:0;font-size:15px;line-height:1.55;max-width:340px">${p[2]}</p><div style="display:flex;gap:6px">${P.map((_,k)=>`<i style="width:8px;height:8px;border-radius:50%;background:${k===i?'#58e0ec':'#3a4566'}"></i>`).join('')}</div><button class="btn pri" style="width:100%;max-width:300px">${i<P.length-1?'Suivant ▶':'Commencer l\'aventure'}</button>`;box.querySelector('button').onclick=()=>{sfx('tap');if(++i<P.length)draw();else{box.remove();res()}}};draw()})}
 /* --- bilan de fin d'acte --- */
 function actEnd(n){return new Promise(res=>{const kn=THEMES.filter(T=>Path.lvl(T.id)).reduce((a,T)=>a+T.k.length,0),ph=Object.keys(S.ph||{}).length,le=Object.keys(S.les||{}).length;let wd=0;try{wd=Vocab.known().length}catch(e){}const pt=S.pt||0,hh=Math.floor(pt/3600),mm=Math.floor(pt%3600/60),tm=hh?`${hh} h ${mm} min`:`${mm} min`,st=Quest.streak();
  const rows=[['字','Kanji appris',`${kn} / 105`],['言','Mots connus',wd],['文','Phrases au carnet',ph],['法','Leçons de grammaire',le],['読','Textes compris',Object.values(S.rd||{}).filter((v,i)=>v>=2).length],['日','Jours de suite',st],['時','Temps de jeu',tm]],txt=`Jōki Zamurai · ${n===4?'fin du voyage':'fin de l\'acte '+['I','II','III'][n-1]} : ${kn} kanji, ${wd} mots, ${le} leçons en ${tm}. 頑張りました！`;
  const box=document.createElement('div');box.style.cssText='position:absolute;inset:0;z-index:70;background:rgba(12,14,26,.96);display:flex;flex-direction:column;align-items:center;justify-content:center;padding:22px;gap:12px;color:#e8ecf8;animation:fbFade .5s both';
  box.innerHTML=`<div style="font-size:13px;letter-spacing:3px;color:#58e0ec">${['第一幕 完','第二幕 完','第三幕 完','全幕 完'][n-1]}</div><h2 style="margin:0;font-size:22px;color:#f0cf7a;font-weight:400">${n===4?'Fin du voyage':'Fin de l\'acte '+['I','II','III','IV'][n-1]}</h2><p style="margin:0;font-size:13px;color:#aab2cc;text-align:center">Regarde le chemin parcouru depuis la rizière.</p><div style="width:100%;max-width:330px;background:#f4ead0;color:#2a2018;border-radius:8px;padding:6px 14px;box-shadow:inset 0 0 0 3px #f9f2df">${rows.map(r=>`<div style="display:flex;align-items:center;gap:10px;padding:7px 0;border-bottom:1px dashed #c9b88a"><span style="font-size:20px;color:#c8281e;width:26px;text-align:center">${r[0]}</span><span style="flex:1;font-size:14px">${r[1]}</span><b style="font-size:16px">${r[2]}</b></div>`).join('')}</div><p style="margin:0;font-size:13px;text-align:center;max-width:320px">${['Tu sais déjà te présenter, compter et décrire ce qui t\'entoure.','Tu peux lire une affiche, demander ton chemin et raconter ta journée. La moitié du chemin vers le N5 est faite.','Tu comprends une annonce de gare, une conversation au marché et un petit texte. L\'examen blanc n\'est plus très loin.','Tu as passé l\'examen blanc du N5 au sommet du temple. Tu es prêt pour le vrai.'][n-1]}</p><div style="display:flex;gap:8px;width:100%;max-width:330px"><button class="btn dark" data-a="s" style="flex:1">Partager</button><button class="btn pri" data-a="c" style="flex:1">Continuer ▶</button></div>`;
  $('#app').appendChild(box);box.onclick=async e=>{const b=e.target.closest('button');if(!b)return;if(b.dataset.a==='s'){try{if(navigator.share)await navigator.share({text:txt});else{await navigator.clipboard.writeText(txt);UI.toast('Résumé copié')}}catch(x){}return}box.remove();res()};try{sfx('lvl')}catch(e){}})}
 /* --- résumé « précédemment » --- */
 const RC=["Kaito, paysan de Kome, a tracé le kanji du feu pour sauver sa sœur Hana. Depuis, une ombre nommée Kage vit en lui. Maître Tanuki l'a envoyé sur la route du nord.",
  "Kaito a traversé les rizières et vaincu l'épouvantail qui gardait la route. Kage dit être l'ombre perdue de quelqu'un de très grand.",
  "Après la forêt de bambous, Kaito est entré sur les terres du seigneur Tetsu : des usines, des ouvriers payés en bons, et des mots qui disparaissent.",
  "Dans les quartiers de Tetsu, les machines avalent les mots des habitants. Un rōnin taciturne suit Kaito de loin.",
  "Kaito a atteint le village des cendres. Sous le vieux puits dort un morceau de Kurokami, le dieu dont Kage est l'ombre.",
  "Le vieux puits est scellé : l'acte I est terminé. Kaito a franchi le col des Brumes, vers les terres hautes de Kurogane.",
  "Sur la grand-route, tous les gardiens sont des revenants. Kage se souvient de plus en plus de choses, et ça ne lui plaît pas.",
  "Au bord du Grand Fleuve, Tetsu a fait démonter les ponts. Des lettres inachevées, adressées à une certaine Kiku, traînent le long du chemin.",
  "Kaito est entré dans la ville basse de Kurogane, où il fait nuit toute la journée. Tout ce qu'on y produit monte vers la ville haute.",
  "Le funiculaire a mené Kaito à l'Académie des sceaux, où l'on recopie les kanji à la machine. Tetsu n'est plus très loin.",
  "Kaito est aux Grandes Forges. Tout ce que Tetsu a pris aux habitants finit dans ces fourneaux."];
 function recap(){let o='';try{o=String(objective()||'').replace(/<[^>]+>/g,'')}catch(e){}return ['Précédemment… '+RC[Math.min(10,reach())]].concat(o?['Ton objectif : '+o]:[])}
 /* --- séance éclair depuis l'écran-titre --- */
 let quick=0;
 function titleBtn(){try{const c=$('#bCont');if(!c||$('#bQuick'))return;const b=document.createElement('button');b.id='bQuick';b.className='btn';b.innerHTML='五分<small>Séance éclair · 5 minutes</small>';c.after(b);b.onclick=()=>{quick=1;c.click()};}catch(e){}}
 setInterval(()=>{try{applyTz();const q=$('#bQuick'),c=$('#bCont');if(q&&c)q.classList.toggle('hidden',c.classList.contains('hidden')||G.scene!=='title');if(G.scene==='title')titleBtn();
   if(G.scene!=='title'&&!document.hidden&&typeof S!=='undefined'&&S.fl&&S.fl.intro)S.pt=(S.pt||0)+1;
   if(quick&&G.scene==='world'&&!G.busy&&UI.cur==='pad'){quick=0;W.ev(async()=>{let did=0;if(Review.count()>0){const r=await Review.session();did+=r&&r.n||0}did+=await errSession(4);UI.panel('pad');if(!did)UI.toast('Rien à réviser aujourd\'hui : essaie un mini-jeu ou un texte à lire.',3200)}).then(()=>{try{Menu.open();const t=$('#mTabs [data-t="dq"]');if(t)t.click()}catch(e){}})}}catch(e){}},1000);
 /* --- furigana cachés : un toucher les fait revenir, avec le sens des kanji --- */
 let KFR=null;const kfr=c=>{if(!KFR){KFR={};try{SP.forEach(s=>{KFR[s.k]=s.fr});THEMES.forEach(T=>T.k.forEach(k=>{KFR[k.k]=k.fr}))}catch(e){}}return KFR[c]};
 document.addEventListener('pointerdown',e=>{const r=e.target&&e.target.closest&&e.target.closest('ruby.fx');if(!r||e.target.closest('button'))return;e.stopPropagation();e.preventDefault();const w=r.firstChild?r.firstChild.textContent:r.textContent;if(!r.querySelector('rt')){const rt=document.createElement('rt');rt.textContent=r.dataset.r;r.appendChild(rt)}r.classList.add('on');
  const ks=(w.match(/[一-鿿]/g)||[]).filter(c=>kfr(c)).map(c=>`${c} : ${esc(String(kfr(c)).split(',')[0])}`);try{UI.toast(`<b>${esc(w)}</b> · ${esc(r.dataset.r)}${ks.length?'<br>'+ks.join(' · '):''}`,3200)}catch(x){}},true);
 /* --- sac : objectif, bourse, objets expliqués, quêtes --- */
 function bagHtml(){let o='';try{o=String(objective()||'').replace(/<[^>]+>/g,'')}catch(e){}const ks=Object.keys(IT),own=ks.filter(k=>(S.it[k]||0)>0);
  return `<div class="mi"><div class="k" style="color:var(--cy)">的</div><div class="t"><b>Objectif</b>${o?o.charAt(0).toUpperCase()+o.slice(1):'Explore librement.'}</div></div>
<div class="mi"><div class="k" style="color:var(--gold)">円</div><div class="t"><b>${S.gold||0} 円</b>Ta bourse. Les marchandes des bourgs vendent de quoi te soigner.</div></div>
<div class="sw" style="border:0;padding:8px 0 4px"><span>Objets · ${own.length} sorte${own.length>1?'s':''}</span></div>`+(own.length?own.map(k=>{const it=IT[k],ic=IM['I_'+k.toUpperCase()];return `<div class="mi">${ic?`<div class="k" style="position:relative"><img src="${ic}" alt="" style="width:40px;height:40px;object-fit:contain;image-rendering:pixelated"><small style="position:absolute;right:-2px;bottom:-4px;font-size:12px;color:var(--gold)">×${S.it[k]}</small></div>`:`<div class="k" style="font-size:20px">×${S.it[k]}</div>`}<div class="t"><b>${esc(it.n)}</b><span class="jp" style="font-size:15px">${jpHtml(it.t)}</span><br><small>${esc(it.d||'')}</small></div></div>`}).join(''):'<p style="font-size:13px;color:var(--sub)">Ton sac est vide. Les coffres, les statues Jizō et les marchandes t\'aideront à le remplir.</p>')+
  `<div class="sw" style="border:0;padding:8px 0 4px"><span>Objets pas encore trouvés</span></div><p style="font-size:12px;color:var(--sub);margin:0 0 8px">${(n=>n?n+(n>1?' objets restent':' objet reste')+' à découvrir. À toi de les trouver !':'Tu les as tous !')(ks.filter(k=>!own.includes(k)).length)}</p>`+(()=>{try{return Quests.html()}catch(e){return ''}})()}
 /* --- attaque par la phrase : les mots eux-mêmes traversent l'écran --- */
 function phraseFx(e){return new Promise(res=>{let t='言葉';try{if(e&&e.t&&e.q!=='mcq')t=e.t.map(x=>x==='＿'?e.a:tk(x)[0]).join('');else if(e&&e.t)t=jpText(e.t);else if(e&&e.a&&/[ぁ-んァ-ン一-龯]/.test(e.a))t=e.a}catch(x){}t=t.replace(/[。、]/g,'').slice(0,14);
  const scr=$('#scr').parentNode,box=document.createElement('div');box.className='phfx';box.innerHTML=[...t].map((c,i)=>`<i style="animation-delay:${i*45}ms">${esc(c)}</i>`).join('')+'<b></b>';scr.appendChild(box);try{sfx('spell')}catch(x){}setTimeout(()=>{try{sfx('boom')}catch(x){}},520+t.length*45);setTimeout(()=>{box.remove();res()},900+t.length*45)})}
 /* --- gardiens et boss plus coriaces, et interrogés sur les dernières leçons --- */
 try{Object.values(EN).forEach(e=>{if(e&&e.hp&&!e.wild&&!e._up){e._up=1;e.hp=Math.round(e.hp*1.45);e.dmg=Math.round(e.dmg*1.2)}})}catch(e){}
 {const o=Battle.start;Battle.start=async(def,opt)=>{window.EXREC=def&&!def.wild?1:0;try{return await o(def,opt)}finally{window.EXREC=0}}}
 /* --- écran de jeu allégé : objets et objectif sont dans le sac --- */
 {const o=UI.stat;UI.stat=function(){o.apply(UI,arguments);try{$('#stHpT').textContent=`PV ${S.hp}/${maxHp()} · ${S.xp} XP`;$('#obj').style.display='none'}catch(e){}}}
 document.addEventListener('input',e=>{if(e.target&&e.target.id==='kMv'){S.mv=+e.target.value/100;vol();const l=$('#kMvL');if(l)l.textContent=e.target.value+' %'}});document.addEventListener('change',e=>{if(e.target&&e.target.id==='kMv')save()});
 return{errHtml,readHtml,optHtml,bagHtml,phraseFx,click,welcome,actEnd,recap,errSession,TX}})();

/* ---------- découpage : la version « actes I-II » s'arrête aux Grandes Forges ---------- */
(()=>{if(PART!==12)return;
 const cut=y=>MAPS.world.zone(y)>=12,isW=o=>!o.m||o.m==='world';
 for(const A of [ROVERS,ELITES,HIDS,MONKS,TANUS,XNPC,ITEMS,GUARD])for(let i=A.length-1;i>=0;i--){const o=A[i];if(o&&isW(o)&&cut(o.y))A.splice(i,1)}
 NPCS.world=NPCS.world.filter(n=>!cut(n.y));
})();

/* la version « acte III » s'arrête à la citadelle : la plage de l'acte IV a son propre fichier */
(()=>{if(PART!==34)return;
 const cut=y=>MAPS.world.zone(y)>=17,isW=o=>!o.m||o.m==='world';
 for(const A of [ROVERS,ELITES,HIDS,MONKS,TANUS,XNPC,ITEMS,GUARD])for(let i=A.length-1;i>=0;i--){const o=A[i];if(o&&isW(o)&&cut(o.y))A.splice(i,1)}
 NPCS.world=NPCS.world.filter(n=>!cut(n.y));
})();

/* ---------- hautes herbes détourées : des touffes posées case par case, qui débordent les unes sur les autres ---------- */
window.HGN={1:6,6:4,9:4,13:4,14:8,15:4,17:8,18:8,19:8,20:8,21:8};window.HGNEW=true;
window.HGON=z=>!!(window.HGNEW&&HGN[z]&&XI['X_HG'+z+'_0']&&XI['X_HG'+z+'_0'].width>0);
window.HGZ=(z,x,y,h,dx,dy,add,tg)=>{if(!HGON(z))return false;const n=HGN[z],i=h%n,j=hash(x+9,y+4)%n,W_=MAPS.world.w;
 add(x,y,XI['X_HG'+z+'_'+j],-dx*2+((x+y)%2?3:-3),-6+dy,0);
 tg(x+y*W_,add(x,y,XI['X_HG'+z+'_'+i],dx,dy,0));return true};

/* ---------- en passant sous le torii d'entrée, le nom du bourg s'affiche (une fois par bourg) ---------- */
(()=>{
 const BC={2:['竹の村','HAMEAU DES BAMBOUS','Le village des vanniers'],3:['鉄の町','QUARTIER DES OUVRIERS','Au pied de l\'avant-poste'],4:['煙の町','QUARTIER DES FUMÉES','Le quai des machines'],
  5:['灰の村','HAMEAU DES CENDRES','Le village du vieux puits'],6:['峠の茶屋','REFUGE DU COL','Au pied du col des Brumes'],7:['街道の宿場','RELAIS DE LA GRAND-ROUTE','Le bourg des coursiers'],
  8:['渡し場の村','BOURG DES PASSEURS','Au bord du Grand Fleuve'],9:['黒鉄の下町','VILLE BASSE DE KUROGANE','Le quartier des canaux'],10:['学生の町','QUARTIER DES ÉTUDIANTS','Sous l\'Académie des sceaux'],
  11:['鉄の町','CITÉ OUVRIÈRE','Les Grandes Forges de Tetsu'],12:['空の港','PORT DES DIRIGEABLES','Le bourg au-dessus des nuages'],13:['狐と狸の村','VILLAGE DES RENARDS','Caché dans la forêt suspendue'],
  14:['時計の庭','JARDINS SUSPENDUS','Le bourg des horlogers'],15:['四つ辻','LA CROISÉE DES QUATRE VENTS','Le bourg des aiguilleurs'],16:['鉄の城','LA CITADELLE DE TETSU','La bibliothèque des noms volés'],17:['浜辺の村','LA PLAGE DES NAUFRAGÉS','Le village où s\'échouent les noms'],18:['金の都','LA VILLE IMPÉRIALE DORÉE','La capitale où tout se change en or']};
 const ty=h=>h.z>=15?h.y1+3:h.y1-4;
 const o=STORY.triggers;STORY.triggers=(x,y)=>{if(W.map==='world'&&S.fl.act1&&!S.fl.noscn&&typeof HAMS!=='undefined'){const z=W.zone(),c=BC[z];
   if(c&&!S.fl['ac'+z]&&x-RX(y)>=7&&x-RX(y)<=12){const h=HAMS.find(q=>q.z===z);if(h&&y===ty(h))return async()=>{S.fl['ac'+z]=1;save();await ActCard.show(...c);if(window.BPOST&&BPOST[z])await BPOST[z]();W.refreshZone()}}}
  return o(x,y)};
 window.BOURGCARD=BC;
})();

/* ---------- les énigmes des routes : un obstacle au milieu de chaque détour ---------- */
(()=>{
 const J=(n,jp,fr,x)=>({n,jp,fr,x}),T_=(n,t)=>({n,t}),KA='Kaito',KG='影',TG='Tanuki géant';
 Object.assign(IT,{axe:{n:'Hache',t:['斧|おの'],heal:0,map:1,pz:1,d:'Pour couper un tronc tombé en travers du chemin.'},
  bell:{n:'Cloche de réveil',t:['鐘|かね'],heal:0,map:1,pz:1,d:'Assez bruyante pour réveiller un yōkai qui dort.'},
  torch:{n:'Torche',t:['松明|たいまつ'],heal:0,map:1,pz:1,d:'Elle ne s\'éteint pas, même dans le vent du col. Fait fondre la glace.'},
  plank:{n:'Planches',t:['板|いた'],heal:0,map:1,pz:1,d:'Trois bonnes planches, de quoi réparer un pont.'},
  crank:{n:'Manivelle',t:['ハンドル'],heal:0,map:1,pz:1,d:'Une manivelle de laiton. Elle s\'emboîte sur les leviers des grilles bloqués.'},
  oar:{n:'Rame',t:['オール'],heal:0,map:1,pz:1,d:'Avec une barque, elle permet de traverser l\'eau.'}});
 const ICO={};const icon=k=>{if(!ICO[k]&&IM['I_'+k.toUpperCase()]){const i=new Image();i.src=IM['I_'+k.toUpperCase()];ICO[k]=i}return ICO[k]};
 ITEMS.forEach(it=>{if(IT[it.it]&&IT[it.it].pz)Object.defineProperty(it,'img',{get:()=>icon(it.it),enumerable:true,configurable:true})});
 const M=()=>MAPS.world,set=(x,y,c)=>{const m=M(),r=m.rows[y];m.rows[y]=r.slice(0,x)+c+r.slice(x+1)};
 const done=q=>!!S.fl['pz'+q.z],apply=q=>{if(q.kind==='boat')return;for(const x of [q.x,q.x+1])set(x,q.y,'Y')};
 PUZ.forEach(q=>{if(done(q))apply(q)});
 /* une fois l'énigme résolue, le détour est plus calme : moitié moins de rencontres */
 window.PUZCALM=y=>PUZ.some(q=>done(q)&&y>=q.top&&y<q.top+40);
 const find=(x,y,c)=>c==='Z'?PUZ.find(q=>q.lever&&q.lever[0]===x&&q.lever[1]===y):PUZ.find(q=>q.y===y||q.y2===y);
 const IMG={trunk:['X_PZ_TRUNK','X_PZ_TRUNK2'],gate:['X_PZ_GATE','X_PZ_GATE2'],ice:['X_PZ_ICE','X_PZ_PUDDLE'],bridge:['X_PZ_BRIDGE','X_PZ_BRIDGE2'],tanuki:['X_PZ_TANU','X_PZ_TANU2'],boat:['X_PZ_BOAT','X_PZ_BOAT2']};
 window.PUZP=(add,c,x,y,z)=>{const q=find(x,y,c);if(!q)return;
  if(c==='Z'){const im=XI[done(q)?'X_PZ_LEVER2':'X_PZ_LEVER'];if(im&&im.width)add(x,y,im,0,-1,0,1);return}
  if(x!==q.x)return;let k=IMG[q.kind][done(q)?1:0],dx=8;
  if(q.kind==='boat'){if(q.y2===y){if(!done(q))return;k='X_PZ_BOAT2'}else k=(S.it.oar>0||done(q))?'X_PZ_BOAT2':'X_PZ_BOAT'}
  if(q.kind==='tanuki'&&done(q))dx=64;
  const im=XI[k];if(im&&im.width)add(x,y,im,dx,q.kind==='bridge'?4:q.kind==='tanuki'&&done(q)?-24:0,0,1)};
 async function solve(q){S.fl['pz'+q.z]=1;apply(q);save();const H=W.H;W.reset();W.load('world',H.x,H.y,H.dir);W.H.cd=2}
 const vis=()=>!!S.fl.visit,has=k=>S.it[k]>0||vis(),VIS='(Mode visite : le passage s\'ouvre tout seul.)';
 window.PUZI=async(x,y,c)=>{const q=find(x,y,c);if(!q)return;const H=W.H;
  if(c==='Z'){if(done(q))return D.say('Le levier est déjà abaissé. La grille est ouverte.');
   if(q.crank&&!has('crank'))return D.say([J(KA,['レバー','が','動きません|うごきません','。'],'Le levier ne bouge pas.','動きます (うごきます) = bouger'),'Le levier est bloqué : il manque sa manivelle. Quelqu\'un l\'a dévissée. Le mécanicien d\'à côté sait sûrement où elle est.']);
   sfx('door');await D.say([...(q.crank&&!vis()?['Tu emboîtes la manivelle sur le levier et tu tournes. Clac, clac, clac.']:[]),J(KA,['レバー','を','下げます|さげます','。'],'J\'abaisse le levier.','下げます (さげます) = baisser'),'Au loin, un long grincement de fer : quelque part sur la route, une grille vient de s\'ouvrir.']);return solve(q)}
  if(done(q)&&q.kind!=='boat')return;
  switch(q.kind){
  case 'trunk':if(!has('axe'))return D.say([J(KA,['木|き','が','道|みち','に','あります','。'],'Il y a un arbre sur le chemin.','木 (き) = arbre · 道 (みち) = chemin'),'Un tronc énorme barre la route. Avec une hache, ça irait vite. Le bûcheron qui campe juste à côté en a sûrement une.']);
   sfx('hit');await D.say([vis()?VIS:J(KA,['木|き','を','切ります|きります','！'],'Je coupe l\'arbre !','切ります (きります) = couper'),'Trois coups de hache, et le tronc roule de chaque côté du chemin.']);return solve(q);
  case 'gate':return D.say([J(KA,['門|もん','が','閉まって|しまって','います','。'],'Le portail est fermé.','閉まっています (しまっています) = être fermé'),vis()?VIS:'Pas de serrure, pas de poignée. Ces grilles s\'ouvrent avec un levier. Il doit y en avoir un, quelque part dans les environs.']).then(()=>vis()?solve(q):0);
  case 'ice':if(!has('torch'))return D.say([J(KA,['氷|こおり','です','。','冷たい|つめたい','！'],'C\'est de la glace. C\'est froid !','氷 (こおり) = glace · 冷たい (つめたい) = froid'),'Un bloc de glace bouche le sentier. Il faudrait du feu pour le faire fondre. Le montagnard d\'à côté a une torche.']);
   sfx('item');await D.say([vis()?VIS:J(KA,['火|ひ','で','氷|こおり','を','溶かします|とかします','。'],'Je fais fondre la glace avec le feu.','溶かします (とかします) = faire fondre'),'La glace craque, ruisselle, et s\'effondre en flaque.']);return solve(q);
  case 'bridge':if(!has('plank'))return D.say([J(KA,['橋|はし','が','壊れて|こわれて','います','。'],'Le pont est cassé.','橋 (はし) = pont · 壊れています (こわれています) = être cassé'),'Il manque des planches au milieu. Avec quelques planches, on pourrait le réparer. La charpentière du port en a.']);
   sfx('hit');await D.say([vis()?VIS:J(KA,['板|いた','で','直します|なおします','。'],'Je répare avec les planches.','直します (なおします) = réparer'),'Les planches neuves tiennent. Le pont craque, mais il tient.']);return solve(q);
  case 'tanuki':if(!has('bell'))return D.say([J(TG,['ぐう','…','ぐう','…'],'Ronfl… ronfl…'),'Un tanuki de pierre grand comme une maison dort au milieu du chemin. Tu le pousses : il ne bouge pas d\'un poil. Il faudrait un bruit énorme pour le réveiller. Quelqu\'un, pas loin, a peut-être une cloche.',T_(KG,"Même son réveil sonne et il dort. C'est un talent.")]);
   sfx('alert');await D.say([vis()?VIS:J(KA,['起きて|おきて','ください','！'],'Réveillez-vous, s\'il vous plaît !','起きます (おきます) = se réveiller'),'Tu fais sonner la cloche de toutes tes forces. Le tanuki ouvre un œil, puis deux.',J(TG,['あ','、','すみません','。','どうぞ','。'],'Ah, pardon. Je vous en prie.','どうぞ = je vous en prie, passez'),'Il se lève en bâillant et s\'assoit un peu plus loin, pour se rendormir aussitôt.']);return solve(q);
  case 'boat':{const south=y===q.y;
   if(!done(q)&&!has('oar'))return D.say([J(KA,['舟|ふね','が','あります','。','でも','、','オール','が','ありません','。'],'Il y a une barque. Mais pas de rame.','舟 (ふね) = barque'),'Sans rame, impossible de traverser. Quelqu\'un, juste à côté, en a peut-être une.']);
   if(!done(q)){S.fl['pz'+q.z]=1;save()}
   await D.say(J(KA,['舟|ふね','で','渡ります|わたります','。'],'Je traverse en barque.','渡ります (わたります) = traverser'));
   await UI.fade(1,350);sfx('door');W.load('world',q.x,south?q.y2-1:q.y+1,south?1:0);W.H.cd=2;await wait(300);await UI.fade(0,350);return}}};
 /* les morceaux de la lettre de Tetsu à sa fille, au fond des détours de l'acte III */
 const KIKU={12:"« Kiku. Aujourd'hui, j'ai pris le nom d'un pilote. Il ne te ressemblait pas. Demain, j'en prendrai un autre. »",
  14:"« Kiku. Toutes les horloges disent une heure différente, maintenant. Comme ça, il n'est jamais l'heure où tu es partie. »",
  15:"« Kiku. Le vent ne sait plus d'où il vient. Moi non plus. Je garde ton amulette contre mon cœur : c'est la seule chose qui sait encore ton nom. »"};
 const oItem=STORY.item;STORY.item=async e=>{await oItem(e);const z=MAPS.world.zone(e.y),q=PUZ.find(p=>p.z===z);
  if(KIKU[z]&&q&&e.x===q.chest[0]&&e.y===q.chest[1]&&!S.fl['kk'+z]){S.fl['kk'+z]=1;save();
   await D.say(['Au fond du coffre, sous la nourriture, une feuille pliée en quatre, scellée d\'une petite enclume de cire noire.',J('Lettre',['菊|きく','へ'],'À Kiku','へ = à, vers (en tête d\'une lettre)'),KIKU[z],
    T_(KG,S.fl.kk12&&S.fl.kk14&&S.fl.kk15?"Trois lettres. Toutes à la même petite fille. Tetsu écrit à quelqu'un qui ne répondra jamais.":"Encore une lettre de lui. À une certaine Kiku. Garde-la.")])}};
})();

/* ---------- Actes I-II : le train (bourg 2 → 3) et le bac du Grand Fleuve (bourg 7 → 8) ----------
   La route s'arrête à une petite gare (ou à un embarcadère) ; le bourg suivant est caché dans la fumée ou la brume.
   On parle au cheminot (ou au passeur), la scène animée se joue, et on arrive en bas du bourg suivant. */
(()=>{
 const J=(n,jp,fr,x)=>({n,jp,fr,x}),T_=(n,t)=>({n,t}),KA='Kaito',KG='影',TN=NPN.tanu;
 const M=MAPS.world,set=(x,y,c)=>{const r=M.rows[y];M.rows[y]=(typeof r==='string')?r.slice(0,x)+c+r.slice(x+1):(r[x]=c,r)};
 const top=z=>{let y=0;while(y<M.h&&M.zone(y)!==z)y++;return y},HZ=z=>HAMS.find(h=>h.z===z);
 const walk=(x,y)=>{const r=M.rows[y];if(!r)return false;const c=r[x];return c!==undefined&&!SOLID.includes(c)&&c!=='G'};
 /* image définitive si elle existe, sinon un bâtiment du bourg en attendant */
 const L={train:{from:2,to:3,need:'karakasa',im:'X_STA_TRAIN',fb:'X_V_ZC4',spr:'rail',nm:'Cheminot',bg:'N_TRAIN',veh:'X_TRAIN',fog:'128,128,136'},
  bac:{from:7,to:8,need:'nuri',im:'X_STA_BAC',fb:'X_V_ZH5',spr:'sendo',nm:'Passeur du bac',bg:'N_BAC',veh:'X_BAC',fog:'226,232,238'}};
 const SEAMS=[];
 for(const k in L){const o=L[k],t=top(o.from),bor=M.rows[t+5][0];o.seam=t;SEAMS.push([t,o.fog,o.from,o.to]);
  /* la route ne monte plus : trois rangées de forêt à la place du portail */
  for(let y=t;y<t+3;y++)for(let x=0;x<M.w;x++)if(walk(x,y)||M.rows[y][x]==='G')set(x,y,bor);
  /* la gare du départ : un îlot libre de 5×3 juste sous la lisière, le cheminot à sa droite */
  let best=null;const gx=RX(t)+9;
  for(let y=t+3;y<t+16&&!best;y++)for(let x=3;x<M.w-9;x++){let ok=true;
   for(let yy=y;yy<y+3&&ok;yy++)for(let xx=x;xx<x+5;xx++)if(!walk(xx,yy)){ok=false;break}
   if(ok&&walk(x+5,y+2)&&walk(x+6,y+2)&&(!best||Math.abs(x-gx)<Math.abs(best[0]-gx)))best=[x,y]}
  if(best){const[x,y]=best;o.A={x:x+5,y:y+2,bx:x,by:y,out:[x+6,y+2]}}
  /* la gare d'arrivée, réservée dans le plan du bourg, à gauche de l'entrée du bas */
  const h=HZ(o.to),e=h.x0+h.ex;o.B={x:e-2,y:h.y1-4,bx:e-7,by:h.y1-6,out:[e,h.y1-2]}}
 const img=o=>XI[o.im]&&XI[o.im].width?o.im:o.fb;
 /* les bâtiments et les deux employés sont ajoutés au monde */
 for(const k in L){const o=L[k];for(const S_ of [o.A,o.B]){if(!S_)continue;
  /* on dégage les arbres juste devant, pour qu'ils ne cachent pas le bâtiment */
  {const gc=M.rows[S_.y][S_.x],bc=walk(S_.x,S_.y)?gc:'.';for(let yy=S_.by;yy<=S_.by+4;yy++)for(let xx=S_.bx-1;xx<=S_.bx+5;xx++){const c=M.rows[yy]&&M.rows[yy][xx];if(c&&'TtBkK#wo'.includes(c)&&!(M.bld||[]).some(q=>xx>=q.x&&xx<q.x+q.w&&yy>=q.y&&yy<q.y+q.h))set(xx,yy,bc)}}
  (M.bld||(M.bld=[])).push({k:'h',x:S_.bx,y:S_.by,w:5,h:3,get im(){return img(o)},flip:0,tint:'',sc:1});
  NPCS.world.push({id:'tr_'+k+(S_===o.A?'A':'B'),spr:o.spr,x:S_.x,y:S_.y,dir:0,wander:0,ev:'transport',tk:k,side:S_===o.A?'A':'B',nm:o.nm})}}
 /* le bourg d'en face reste caché : fumée d'usine pour le train, brume du fleuve pour le bac */
 window.ZCOVER2=(g,X,Y,VW,VH,zh)=>{const T=16,tt=performance.now()/1000;
  for(const[t,col,zs,zn]of SEAMS){if(zh!==zs&&zh!==zn)continue;const hb=t*T-Y;if(hb<-60||hb>VH+60)continue;const up=zh===zs;
   const gr=g.createLinearGradient(0,up?hb+34:hb-34,0,hb);gr.addColorStop(0,`rgba(${col},0)`);gr.addColorStop(1,`rgba(${col},.98)`);g.fillStyle=gr;g.fillRect(0,up?hb:hb-34,VW,34);
   g.fillStyle=`rgb(${col})`;if(up)g.fillRect(0,-10,VW,hb+10);else g.fillRect(0,hb,VW,VH-hb+10);
   const SK=smokeSpr(col);g.globalAlpha=.8;for(let i=0;i<8;i++){const cx=((i*67+tt*(4+i%3))%(VW+120))-60,cy=hb+(up?-8-(i%3)*7:8+(i%3)*7);g.drawImage(SK.band,cx-60,cy-12,120,24)}g.globalAlpha=1}};
 /* la scène animée : le fond défile, le véhicule traverse l'écran */
 function ride(o,back,dur){const host=Cine.host(),bg=new Image();bg.src=IM[o.bg];const vh=XI[o.veh],BW=600,BH=448;
  const cv=document.createElement('canvas');cv.width=BW;cv.height=BH;cv.style.cssText='width:100%;image-rendering:pixelated;display:block';host.appendChild(cv);
  const g=cv.getContext('2d'),t0=performance.now(),ease=p=>p<.5?2*p*p:1-Math.pow(-2*p+2,2)/2;let stop=false;const puffs=[];let lastP=0;const st={sign:null,st:0};
  const train=o.veh==='X_TRAIN',base=train?393:366,chim=train?.86:.6;
  const done=new Promise(res=>{const f=()=>{if(stop){res();return}const now=performance.now(),t=(now-t0)/1000,p=Math.min(1,t/dur),u=ease(p);
   const BGW=bg.width?Math.round(bg.width*BH/bg.height):1056,camx=(BGW-BW)*(back?1-u:u);
   g.imageSmoothingEnabled=false;g.fillStyle='#10141c';g.fillRect(0,0,BW,BH);if(bg.width){g.drawImage(bg,-camx,0,BGW,BH);if(window.CA&&CA.cv)CA.cv(g,bg,-camx,0,BGW,BH)}
   if(vh&&vh.width){const K=train?1.45:1.6,w=vh.width*K,h=vh.height*K,sx=back?BW-110-u*(BW-220)-w/2:110+u*(BW-220)-w/2,bob=train?(Math.floor(t*8)%2):Math.sin(t*2.2)*2,sy=base-h+bob;
    if(t-lastP>.22){lastP=t;puffs.push({x:sx+(back?1-chim:chim)*w,y:sy+4,t})}
    for(const q of puffs){const a=t-q.t;if(a>2.2)continue;g.fillStyle=`rgba(240,240,244,${.75*(1-a/2.2)})`;g.beginPath();g.ellipse(q.x+(back?1:-1)*a*22,q.y-a*26,5+a*7,4+a*5,0,0,7);g.fill()}
    if(back){g.save();g.translate(sx+w,0);g.scale(-1,1);g.drawImage(vh,0,sy,w,h);g.restore()}else g.drawImage(vh,sx,sy,w,h)}
   if(st.sign){const k=Math.min(1,(now-st.st)/250),sx=BW/2,sy=70*k-10;g.fillStyle='#3a2a1a';g.fillRect(sx-4,sy+40,8,60);g.fillStyle='#6b4a2a';g.fillRect(sx-92,sy-6,184,60);g.fillStyle='#e8dcc0';g.fillRect(sx-86,sy,172,48);
    g.fillStyle='#2a1a10';g.font='bold 34px "Hiragino Mincho ProN","Yu Mincho","Noto Serif JP",serif';g.textAlign='center';g.textBaseline='middle';g.fillText(st.sign,sx,sy+25);g.textAlign='left'}
   g.fillStyle=`rgba(255,220,160,${.04+.03*Math.sin(t)})`;g.fillRect(0,0,BW,BH);if(p>=1){res();return}requestAnimationFrame(f)};requestAnimationFrame(f)});
  return{done,sign(w){st.sign=w;st.st=performance.now()},end(){stop=true;cv.remove()}}}
 const TALK={train:{
   no:[J('Cheminot',['電車|でんしゃ','は','まだ','出ません|でません','。'],'Le train ne part pas encore.','まだ + négatif = « pas encore »'),"Une Lanterne de fête bloque la voie plus loin dans la forêt. Tant qu'elle est là, la locomotive refuse de démarrer. Elle a peur des lanternes. C'est une longue histoire."],
   q:J('Cheminot',['乗ります|のります','か','。'],'Vous montez ?','乗ります (のります) = monter (dans un véhicule)'),
   go:[J('Cheminot',['どうぞ','。'],'Je vous en prie.'),"Le cheminot donne un coup de sifflet. Vous grimpez dans le dernier wagon, entre deux sacs de charbon."],
   ride:["Le train s'ébranle. Les bambous défilent, puis les rizières dorées, puis les cheminées de brique.",T_(TN,"Ah, le train ! Plus rapide qu'un tanuki, presque aussi confortable, et bien moins bavard."),J(KA,['速い|はやい','です','ね','。'],'C\'est rapide, hein.','速い (はやい) = rapide'),T_(KG,"Regarde, là-bas, la forteresse de fer. Elle a des yeux partout. Des projecteurs, je veux dire. Mais aussi des yeux."),"Le train ralentit dans un nuage de fumée. Terminus : le quartier des ouvriers."],
   back:["Le train repart vers la forêt. La fumée se dissipe, les rizières reviennent. Terminus : la lisière du hameau des bambous."]},
  bac:{
   no:[J('Passeur du bac',['今日|きょう','は','船|ふね','が','出ません|でません','。'],'Aujourd\'hui, le bac ne part pas.','船 (ふね) = bateau'),"Le Grand Nurikabe douanier bloque la grand-route. Tant qu'il est là, personne n'arrive jusqu'au fleuve. Pas de client, pas de traversée. C'est de l'économie."],
   q:J('Passeur du bac',['川|かわ','を','渡ります|わたります','か','。'],'Vous traversez le fleuve ?','川 (かわ) = rivière · 渡ります (わたります) = traverser'),
   go:[J('Passeur du bac',['乗って|のって','ください','。'],'Montez, je vous prie.'),"Le vieux passeur détache l'amarre. La roue à aubes se met à tourner en crachotant."],
   ride:["Le bac glisse sur l'eau immobile. Derrière vous, les érables rouges disparaissent dans la brume.",T_(TN,"Je… je n'ai pas le mal de mer. C'est le fleuve qui bouge trop. Dis-lui d'arrêter."),J(KA,['霧|きり','が','多い|おおい','です','ね','。'],'Il y a beaucoup de brume, hein.','霧 (きり) = brume'),"Au milieu du fleuve, une silhouette immense se dessine dans le brouillard. Deux yeux s'allument, puis s'éteignent.",T_(KG,"Il nous regarde. Ne le regarde pas. … Bon, il nous a vus quand même."),"Un pilotis, un autre, une cloche qui tinte : le bourg des passeurs sort de la brume."],
   back:["Le bac retraverse le fleuve dans la brume, jusqu'au ponton de la grand-route."]}};
 /* mini-jeu : des panneaux défilent par la fenêtre, il faut les lire avant qu'ils ne passent */
 const shuf=a=>{for(let i=a.length-1;i>0;i--){const j=Math.floor(Math.random()*(i+1));[a[i],a[j]]=[a[j],a[i]]}return a};
 async function signs(o,R){const z=o.to,pool=[].concat(VOC[z-1]||[],VOC[z]||[],VOC[z-2]||[]).filter(Boolean);if(pool.length<4)return;
  await D.say([T_(KG,o.veh==='X_TRAIN'?"Des panneaux défilent le long de la voie. Lis-les avant qu'ils ne passent. Je compte les points.":"Des bouées à panneaux flottent sur le fleuve. Lis-les avant qu'on les dépasse. Je compte les points.")]);
  const used=shuf(pool.slice()).slice(0,4);let ok=0;
  for(const w of used){R.sign(w[0].split('|')[0]);const opts=shuf([w[1],...shuf(pool.filter(v=>v[1]!==w[1])).slice(0,2).map(v=>v[1])]);
   const t0=performance.now(),i=await D.ask({n:'Panneau',jp:[w[0]],fr:'Que dit ce panneau ?'},opts),fast=performance.now()-t0<6000;
   if(opts[i]===w[1]){ok++;sfx('right');UI.toast(fast?'Bien lu, et vite !':'Bien lu !',1400)}else{sfx('wrong');UI.toast(`Raté : ${w[0].split('|')[0]} = ${w[1]}`,2200)}
   R.sign(null);await wait(500)}
  const g=ok*10;S.gold=(S.gold||0)+g;if(ok===4){S.it.dango=(S.it.dango||0)+1;S.fl.signs4=1}save();
  await D.say([T_(KG,ok===4?"Quatre sur quatre. Tu lis plus vite que le train ne roule.":ok>=2?`${ok} sur 4. Pas mal. Les autres sont passés trop vite, ce n'est pas de ta faute. Si, un peu.`:`${ok} sur 4. Les panneaux t'ont doublé.`),`(Tu gagnes ${g} pièces${ok===4?' et un dango':''}.)`])}
 STORY.transport=async e=>{const o=L[e.tk],D_=TALK[e.tk],A_=e.side==='A';
  if(A_&&!S.wins[o.need]&&!S.fl.visit)return D.say(D_.no);
  const i=await D.ask(D_.q,['Oui','Non']);if(i!==0)return;
  await D.say(D_.go);music(null);await UI.fade(1,350);const R=ride(o,!A_,A_?60:9);await UI.fade(0,300);sfx('door');
  try{if(A_){const L_=D_.ride;await D.say(L_.slice(0,-1));await signs(o,R);await D.say(L_.slice(-1));await wait(1200)}else{await D.say(D_.back);await Promise.race([R.done,wait(4000)])}}finally{await UI.fade(1,350);R.end();Cine.hide()}
  const S2=A_?o.B:o.A;W.load('world',S2.out[0],S2.out[1],A_?0:1);W.H.cd=3;save();await UI.fade(0,300);music(ZONES[A_?o.to:o.from].mus);W.refreshZone()};
 window.TRANSP={ride,L};
 /* les illustrations à l'arrivée dans les bourgs qui n'en avaient pas (après la carte du bourg) */
 window.BPOST={
  2:()=>Cine.say('N_S19',["Sous les bambous, un petit hameau de paille et de vannerie. Des paniers partout, sur les toits, sur les murs, et même sur un chat qui dort.",J(KA,['きれい','な','村|むら','です','ね','。'],'C\'est un joli village, hein.','きれい = joli, propre · 村 (むら) = village'),T_(TN,"Kaito ! Par ici ! J'ai trouvé un panier à ma taille. J'ai décidé d'y vivre."),T_(KG,"Il est rond. Le panier aussi. Ils étaient faits l'un pour l'autre.")]),
  3:()=>Cine.say('N_S20',["Au bout de la rue de briques, la forteresse de fer écrase le quartier. Ses projecteurs balaient les toits, même en plein jour.",T_(TN,"L'avant-poste de Tetsu. Les ouvriers y entrent le matin et en ressortent le soir, sans un mot. Littéralement : on leur a volé leurs mots."),J(KA,['大きい|おおきい','です','ね','。'],'C\'est grand, hein.','大きい (おおきい) = grand'),T_(KG,"Grand, oui. Mais les grandes choses ont de grandes portes. Et les grandes portes, ça s'ouvre.")]),
  4:()=>Cine.say('N_S21',["Le quai des machines disparaît dans une fumée épaisse. Au fond, à travers le brouillard, une gueule de feu gigantesque éclaire tout en orange.",T_(TN,"Kof… kof… Le Grand fourneau. Il avale le charbon jour et nuit. Et les mots de ceux qui s'approchent trop."),J(KA,['熱い|あつい','です','。'],'C\'est brûlant.','熱い (あつい) = brûlant'),T_(KG,"Il a faim. Moi aussi, d'ailleurs. Mais je ne mange pas les gens. Pas souvent.")]),
  8:()=>Cine.say('N_S22',["La brume recouvre le fleuve. Les maisons sur pilotis semblent flotter. Au loin, dans le brouillard, une silhouette immense ne bouge pas.",J(KA,['あれ','は','何|なん','です','か','。'],'Qu\'est-ce que c\'est, ça ?','あれ = ça, là-bas · 何 (なん) = quoi'),T_(TN,"Ne… ne le regarde pas. C'est l'Umibōzu. S'il te regarde, il te pose une question. Si tu réponds mal, il coule ton bateau."),T_(KG,"On n'a pas de bateau. Alors il coulera le tanuki.")]),
  10:()=>Cine.say('N_S23',["Une rue pavée monte vers l'Académie des sceaux, sous les cerisiers en fleurs. Des étudiants courent dans tous les sens, les bras chargés de livres.",T_(TN,"Attrape-la ! La feuille, là ! C'était peut-être un devoir important !"),J(KA,['学生|がくせい','が','多い|おおい','です','ね','。'],'Il y a beaucoup d\'étudiants, hein.','学生 (がくせい) = étudiant · 多い (おおい) = nombreux'),T_(KG,"Tous ces livres… et la moitié des pages sont blanches. Quelqu'un est passé avant nous.")])};
})();

/* ---------- Piste 2 : les objets des énigmes ne traînent plus par terre ----------
   Un habitant campe près de chaque obstacle. Il a l'objet qu'il faut, et le donne contre un service :
   fetch = retrouver ce qu'il a perdu sur la route ; hunt = chasser deux yōkai de la route ; word = répondre à ses questions de vocabulaire. */
(()=>{
 const J=(n,jp,fr,x)=>({n,jp,fr,x}),T_=(n,t)=>({n,t}),KA='Kaito',KG='影',TN=NPN.tanu;
 const SV={
  1:{it:'axe',spr:'lumber',nm:'Bûcheron Gonbei',type:'fetch',obj:'Gourde en bambou',
   ask:[J('Bûcheron Gonbei',['水筒|すいとう','が','ありません','。'],'Je n\'ai plus ma gourde.','水筒 (すいとう) = gourde'),"Je l'ai posée quelque part sur le sentier, en faisant le tour. Sans elle, je ne coupe rien. Le bois, ça donne soif. Rapporte-la-moi et je te prête ma hache."],
   wait:"Ma gourde… quelque part sur le sentier qui fait le tour. Elle est verte. Comme tout le reste, je sais.",found:"Une gourde en bambou, encore à moitié pleine. Elle sent le thé froid."},
  2:{it:'bell',spr:'pilgrim',nm:'Pèlerine sonneuse',type:'word',
   ask:[J('Pèlerine sonneuse',['この','鐘|かね','を','貸します|かします','よ','。'],'Je te prête cette cloche.','鐘 (かね) = cloche · 貸します (かします) = prêter'),"Mais d'abord, un petit examen. Une cloche, ça se mérite. Deux mots du hameau des bambous."]},
  4:{it:'crank',spr:'worker',nm:'Mécanicien du quai',type:'hunt',kind:'yōkai des fumées',
   ask:[J('Mécanicien du quai',['ハンドル','は','ここ','に','あります','。'],'La manivelle, elle est ici.','ここ = ici'),"Je l'ai dévissée moi-même : les yōkai des fumées s'amusaient à ouvrir la grille. Chasse-m'en deux sur la route, et je te la prête."]},
  6:{it:'torch',spr:'mount',nm:'Montagnard frigorifié',type:'fetch',obj:'Pierre à feu',
   ask:[J('Montagnard frigorifié',['寒い|さむい','…','火|ひ','が','ほしい','です','。'],'Froid… je veux du feu.','寒い (さむい) = froid · ほしい = vouloir (une chose)'),"J'ai une torche, mais j'ai perdu ma pierre à feu sur le sentier glacé, en faisant le tour. Rapporte-la et on partage : moi le feu, toi la torche."],
   wait:"La pierre à feu… sur le sentier qui fait le tour. Vite, je ne sens plus mes orteils. Ni mes oreilles. Ni mon nom.",found:"Une petite pierre à feu, noire et brillante, dans la neige."},
  7:{it:'bell',spr:'peddler',nm:'Marchand de cloches',type:'word',
   ask:[J('Marchand de cloches',['鐘|かね','は','高い|たかい','です','よ','。'],'Les cloches, c\'est cher, tu sais.','高い (たかい) = cher'),"Pas d'argent ? Alors réponds à mes questions. Deux bonnes réponses, une cloche. C'est le tarif du relais."]},
  8:{it:'oar',spr:'sendo',nm:'Vieux batelier',type:'hunt',kind:'yōkai du fleuve',
   ask:[J('Vieux batelier',['かっぱ','が','うるさい','です','。'],'Les kappa sont pénibles.','うるさい = bruyant, pénible'),"Chaque fois que je laisse ma rame, un yōkai du fleuve la cache. Chasses-en deux sur la route, et elle est à toi."]},
  9:{it:'oar',spr:'fishw',nm:'Pêcheuse des canaux',type:'fetch',obj:'Panier de poissons',
   ask:[J('Pêcheuse des canaux',['魚|さかな','の','かご','を','なくしました','。'],'J\'ai perdu mon panier de poissons.','魚 (さかな) = poisson · なくしました = (j\')ai perdu'),"Il est tombé de ma barque, de l'autre côté, sur le sentier. Rapporte-le, et je te prête ma rame de rechange."],
   wait:"Mon panier… sur le sentier, quelque part. S'il y a un chat à côté, il est trop tard.",found:"Un panier de poissons. Il en manque deux. Un chat s'enfuit en léchant ses moustaches."},
  10:{it:'crank',spr:'gakusei',nm:'Étudiant ingénieur',type:'word',
   ask:[J('Étudiant ingénieur',['試験|しけん','を','します','。'],'On fait un examen.','試験 (しけん) = examen'),"J'ai la manivelle de la grille. Je la donne à qui réussit mon examen. C'est l'Académie : ici, tout passe par un examen. Même le déjeuner."]},
  12:{it:'plank',spr:'meca',nm:'Charpentière du port',type:'hunt',kind:'yōkai des pontons',
   ask:[J('Charpentière du port',['板|いた','は','あります','が','…'],'Des planches, j\'en ai, mais…','〜が = mais'),"… chaque fois que je répare le pont, les yōkai des pontons le redémolissent. Chasses-en deux, et je te donne mes trois meilleures planches."]},
  13:{it:'bell',spr:'mtanu',nm:'Tanuki sonneur',type:'fetch',obj:'Battant de cloche',
   ask:[J('Tanuki sonneur',['鐘|かね','が','鳴りません|なりません','。'],'La cloche ne sonne pas.','鳴ります (なります) = sonner'),"Un renard a volé le battant de ma cloche, pour rire. Il l'a jeté sur le sentier qui fait le tour. Rapporte-le, et je te prête la cloche."],
   wait:"Le battant… sur le sentier. Les renards, ça vole tout. Sauf le travail.",found:"Un battant de cloche en laiton, couvert de traces de dents de renard."},
  14:{it:'oar',spr:'jardin',nm:'Jardinière des étangs',type:'word',
   ask:[J('Jardinière des étangs',['時間|じかん','が','ありますか','。'],'Tu as du temps ?','時間 (じかん) = temps'),"Ici, les horloges mentent, mais pas les mots. Réponds juste à deux questions, et ma rame est à toi."]},
  17:{it:'oar',spr:'pnj10',nm:'Pêcheur sans rame',type:'hunt',kind:'yōkai de la plage',
   ask:[J('Pêcheur sans rame',['かに','が','ぜんぜん','いなく','なりません','。'],'Les crabes ne partent pas du tout.','ぜんぜん + négatif = pas du tout'),"Ma barque est là, de l'autre côté du bras de mer. Ma rame aussi. Mais les yōkai de la plage me pincent les mollets dès que je m'approche. Chasses-en deux, et je te prête ma rame."]},
  15:{it:'axe',spr:'rail',nm:'Aiguilleur au tronc',type:'hunt',kind:'yōkai du vent',
   ask:[J('Aiguilleur au tronc',['風|かぜ','が','強い|つよい','です','。'],'Le vent est fort.','強い (つよい) = fort'),"Ce sont les yōkai du vent qui ont abattu cet arbre sur la route. Chasses-en deux, que je puisse travailler tranquille, et je te prête ma hache."]}};
 window.PZSV=SV;
 for(const z in SV)if(!PORT[SV[z].nm])PORT[SV[z].nm]='PX_'+SV[z].spr;
 const M=MAPS.world,walk=(x,y)=>{const r=M.rows[y];if(!r)return false;const c=r[x];return c!==undefined&&!SOLID.includes(c)&&c!=='G'};
 /* les anciens objets au sol disparaissent ; pour « fetch », on pose l'objet perdu à leur place */
 for(const z in SV){const o=SV[z],q=PUZ.find(p=>p.z===+z);if(!q)continue;
  const i=ITEMS.findIndex(e=>e.it===o.it&&e.m==='world'&&M.zone(e.y)===+z);let old=null;if(i>=0){old=ITEMS[i];ITEMS.splice(i,1)}
  if(o.type==='fetch'&&old)ITEMS.push({id:'pq'+z,m:'world',x:old.x,y:old.y,it:'pq',pq:+z});
  /* l'habitant : à côté de l'obstacle, côté sud (on arrive par le bas), hors du chemin principal */
  const cx=q.x,cy=q.kind==='boat'?q.y:q.y;let best=null;
  for(let r=1;r<6&&!best;r++)for(let dy=1;dy<=r+1&&!best;dy++)for(const dx of [-r,r+1,-r-1,r+2]){const x=cx+dx,y=cy+dy;if(walk(x,y)&&walk(x,y+1)&&(x<cx-1||x>cx+2)){best=[x,y];break}}
  if(!best)for(let dy=2;dy<6&&!best;dy++)for(const dx of [-1,2])if(walk(cx+dx,cy+dy))best=[cx+dx,cy+dy];
  if(best)NPCS.world.push({id:'pzs'+z,spr:o.spr,x:best[0],y:best[1],dir:0,wander:0,ev:'pzserv',pz:+z,nm:o.nm})}
 IT.pq={n:'Objet perdu',t:['落とし物|おとしもの'],heal:0,map:1,d:'Quelqu\'un l\'a perdu sur la route.'};
 const oItem=STORY.item;STORY.item=async e=>{if(!e.pq)return oItem(e);const o=SV[e.pq];S.fl[e.id]=1;S.fl['pqf'+e.pq]=1;W.remove(e);sfx('item');
  await D.say([{jp:['落とし物|おとしもの','を','見つけた|みつけた','！'],fr:`Tu trouves : ${o.obj} !`,x:'落とし物 (おとしもの) = objet perdu'},o.found,`(Rapporte-le à : ${o.nm}.)`]);save()};
 /* le petit examen de vocabulaire : un mot du bourg, trois traductions */
 const shuffle=a=>{for(let i=a.length-1;i>0;i--){const j=Math.floor(Math.random()*(i+1));[a[i],a[j]]=[a[j],a[i]]}return a};
 const pool=z=>{let L=[];for(let k=z;k>=1&&L.length<12;k--)if(VOC[k])L=L.concat(VOC[k]);return L};
 window.vocQuiz=async(z,n,who)=>{const L=pool(z);if(L.length<3)return true;const used=new Set();let ok=0;
  for(let i=0;i<n;i++){let w;do w=L[Math.floor(Math.random()*Math.min(L.length,10))];while(used.has(w[0])&&used.size<L.length);used.add(w[0]);
   const oth=shuffle(L.filter(v=>v[1]!==w[1])).slice(0,2).map(v=>v[1]),opts=shuffle([w[1],...oth]);
   const a=await D.ask(J(who,['「',w[0],'」','は','フランス語|ふらんすご','で','何|なん','ですか','。'],`Que veut dire « ${w[0].split('|')[0]} » en français ?`,'フランス語 (ふらんすご) = le français'),opts);
   if(opts[a]===w[1]){ok++;sfx('right');await D.say(J(who,['そうです','！'],'C\'est ça !'))}
   else{sfx('wrong');await D.say([J(who,['違います|ちがいます','。'],'Non, ce n\'est pas ça.','違います (ちがいます) = c\'est faux'),{jp:[w[0],'＝'],fr:w[1]}]);return false}}
  return ok===n};
 const give=async(z,o)=>{S.it[o.it]=(S.it[o.it]||0)+1;S.fl['pzg'+z]=1;sfx('item');const it=IT[o.it];
  await D.say([J(o.nm,['ありがとう','！','どうぞ','。'],'Merci ! Tiens, prends-le.','どうぞ = tiens, je t\'en prie'),{jp:it.t.concat(['を','もらった','！']),fr:`Tu reçois : ${it.n} !`,x:it.d}]);save()};
 STORY.pzserv=async e=>{const z=e.pz,o=SV[z],q=PUZ.find(p=>p.z===z);
  if(S.fl['pzg'+z]||S.fl['pz'+z])return D.say(J(o.nm,['頑張って|がんばって','ね','。'],'Bon courage.','頑張って (がんばって) = courage, fais de ton mieux'));
  if(S.fl.visit){return give(z,o)}
  if(!S.fl['pzs'+z]){await D.say(o.ask);S.fl['pzs'+z]=1;save();if(o.type==='word')return quiz(z,o);return D.say(o.type==='hunt'?`(Service : chasse deux ${o.kind} sur cette route, puis reviens.)`:`(Service : retrouve « ${o.obj} » sur le sentier qui fait le tour.)`)}
  if(o.type==='word')return quiz(z,o);
  if(o.type==='fetch'){if(!S.fl['pqf'+z])return D.say(J(o.nm,['まだ','です','か','。'],'Pas encore ?','まだ = pas encore')).then(()=>D.say(o.wait));return give(z,o)}
  if(o.type==='hunt'){const c=S.fl['pzh'+z]||0;if(c<2)return D.say([J(o.nm,['あと','少し|すこし','です','。'],'Encore un peu.','少し (すこし) = un peu'),`(${c} sur 2.)`]);return give(z,o)}};
 const quiz=async(z,o)=>{if(await vocQuiz(z,2,o.nm))return give(z,o);await D.say(J(o.nm,['また','どうぞ','。'],'Reviens quand tu veux.','また = encore, de nouveau'))};
 const oWin=Quests.onWin;Quests.onWin=def=>{oWin(def);if(W.map!=='world'||!def||!def.wild)return;const z=W.zone(),o=SV[z];
  if(o&&o.type==='hunt'&&S.fl['pzs'+z]&&!S.fl['pzg'+z]&&(S.fl['pzh'+z]||0)<2){S.fl['pzh'+z]=(S.fl['pzh'+z]||0)+1;UI.toast(`${o.nm} : ${S.fl['pzh'+z]} / 2`,2600)}};
})();

/* ---------- Piste 1 : les verrous de langue ----------
   Un goulet par route, généré par la carte (LOCKS). Trois sortes :
   door  = porte de pierre scellée par un kanji : il faut le tracer ;
   guard = garde de péage : trois questions de vocabulaire ;
   fog   = carrefour dans le brouillard : il faut lire le bon panneau. */
(()=>{
 const J=(n,jp,fr,x)=>({n,jp,fr,x}),T_=(n,t)=>({n,t}),KA='Kaito',KG='影',TN=NPN.tanu;
 const done=l=>!!S.fl['lk'+l.z],cells=l=>{const a=[];for(let x=l.x;x<=l.x2;x++)a.push(x);return a};
 const at=(x,y)=>LOCKS.find(l=>!done(l)&&y===l.y&&x>=l.x&&x<=l.x2);
 const GUARD={3:'junsa',7:'junsa',10:'junsa',12:'junsa'},GN='Garde du péage';
 const kanjiFor=l=>{const ks=Object.keys(S.sp||{}).filter(k=>spK(k));if(!ks.length)return '人';return ks[(l.z*7+3)%ks.length]};
 const FOG={6:{q:"Dans la brume du col, un vieux poteau à trois flèches. Le refuge est plus haut, vers la montagne. Quelle flèche suivre ?",o:['山','川','森'],a:0,why:'山 (やま) = montagne · 川 (かわ) = rivière · 森 (もり) = forêt'},
  14:{q:"Un panneau tourne lentement dans le vent. Tanuki se souvient : « Les jardins des horlogers ? À droite, toujours à droite. » Quelle flèche ?",o:['左','右','上','下'],a:1,why:'右 (みぎ) = droite · 左 (ひだり) = gauche · 上 (うえ) = haut · 下 (した) = bas'},
  15:{q:"Le carrefour des quatre vents. Quatre panneaux, quatre kanji. La citadelle est au nord. Lequel suivre ?",o:['東','西','南','北'],a:3,why:'北 (きた) = nord · 南 (みなみ) = sud · 東 (ひがし) = est · 西 (にし) = ouest'}};
 PORT[GN]=PORT[GN]||'PX_junsa';
 window.XSOLID_L=(m,x,y)=>m==='world'&&!!at(x,y);
 const oS=window.XSOLID;window.XSOLID=(m,x,y)=>(oS&&oS(m,x,y))||XSOLID_L(m,x,y);
 const open=async l=>{S.fl['lk'+l.z]=1;save();W.refreshZone()};
 async function run(l){
  if(l.kind==='door'){const k=kanjiFor(l);
   await D.say(["Une porte de pierre barre le passage. Au centre, un kanji est gravé : 「"+k+"」. Les sillons brillent faiblement, comme s'ils attendaient un pinceau.",T_(KG,"Une porte à kanji. Trace-le bien, dans l'ordre des traits, et elle te reconnaîtra.")]);
   if(S.fl.visit){await D.say('(Mode visite : la porte s\'ouvre toute seule.)');sfx('door');return open(l)}
   if(await D.ask('Tracer le kanji ?',['Tracer','Plus tard'])!==0)return;
   const sp=spK(k)||spK('人'),r=await Trace.run(sp,{});UI.panel('pad');
   if(r&&r.stars>=1){sfx('door');await D.say(["Les traits s'illuminent un à un. La porte glisse dans la roche avec un long grondement.",J(KA,['開きました|あきました','！'],'Elle s\'est ouverte !','開きます (あきます) = s\'ouvrir')]);return open(l)}
   return D.say("Les traits s'éteignent. La porte ne bouge pas d'un cheveu.")}
  if(l.kind==='guard'){
   await D.say([J(GN,['止まれ|とまれ','！'],'Halte !','止まれ (とまれ) = halte ! (un ordre)'),"Personne ne passe sans prouver qu'il parle la langue du pays. Trois questions. Une erreur, et tu recommences depuis le début."]);
   if(S.fl.visit||await vocQuiz(l.z,3,GN)){sfx('door');await D.say([J(GN,['よし','。','通って|とおって','いい','です','。'],'Bien. Tu peux passer.','通ります (とおります) = passer · 〜ていいです = tu peux…'),"Le garde lève la barrière en grommelant."]);return open(l)}
   return D.say(J(GN,['また','来なさい|きなさい','。'],'Reviens plus tard.','来なさい (きなさい) = viens (un ordre)'))}
  if(l.kind==='fog'){const F=FOG[l.z];if(!F)return open(l);
   const i=S.fl.visit?F.a:await D.ask(F.q,F.o);
   if(i===F.a){sfx('right');await D.say(["Tu suis la flèche 「"+F.o[F.a]+"」. La brume s'écarte devant toi : c'était le bon chemin.",{jp:[F.o[F.a]],fr:F.why}]);return open(l)}
   sfx('wrong');await D.say("Tu suis la flèche 「"+F.o[i]+"」… et la brume se referme. Le sol monte, descend, tourne.");
   await UI.fade(1,400);W.load('world',l.x+1,l.y+8,1);W.H.cd=3;await UI.fade(0,400);
   return D.say([T_(KG,"On est revenus en arrière. Le brouillard ne pardonne pas les fautes de lecture."),{jp:[F.o[F.a],'？'],fr:'Relis bien les panneaux.',x:F.why}])}}
 const oI=window.XINT;window.XINT=(m,x,y,probe)=>{if(m==='world'){const l=at(x,y);if(l)return probe?true:()=>run(l)}return oI?oI(m,x,y,probe):null};
 /* quand on arrive juste en dessous du verrou, la scène se lance d'elle-même (une fois par approche) */
 let near=null;
 const oT=STORY.triggers;STORY.triggers=(x,y)=>{if(W.map==='world'&&!S.fl.noscn){const l=LOCKS.find(l=>!done(l)&&y===l.y+1&&x>=l.x&&x<=l.x2);
   if(l&&near!==l){near=l;return()=>run(l)}if(!l&&near&&Math.abs(y-near.y)>2)near=null}return oT(x,y)};
 /* dessin : porte de pierre, barrière + garde, ou brouillard + poteau */
 const FONT='"Hiragino Mincho ProN","Yu Mincho","Noto Serif JP",serif';
 const oD=window.XDRAW;window.XDRAW=(m,L,g,X,Y,VW,VH)=>{oD&&oD(m,L,g,X,Y,VW,VH);if(m!=='world')return;const T=16,tt=performance.now()/1000;
  for(const l of LOCKS){if(done(l))continue;const px=l.x*T-X,py=l.y*T-Y,w=(l.x2-l.x+1)*T;if(py<-80||py>VH+80||px<-w-20||px>VW+20)continue;
   if(l.kind==='door')L.push({y:(l.y+1)*T,f:()=>{const im=XI.X_LK_DOOR;if(im&&im.width){const s=w/(im.width/3);g.drawImage(im,px,py+T-im.height/3*s,w,im.height/3*s)}
     else{g.fillStyle='#4c4a48';g.fillRect(px,py-18,w,34);g.fillStyle='#6a6764';g.fillRect(px+2,py-16,w-4,30);g.fillStyle='#57544f';for(let i=0;i<w;i+=11)g.fillRect(px+i,py-16,1,30);
      g.fillStyle='#3a5a2c';g.fillRect(px+2,py-16,w-4,3);g.fillStyle='#2b2926';g.fillRect(px,py+15,w,2)}
     const k=kanjiFor(l),gl=.55+.35*Math.sin(tt*2);g.fillStyle=`rgba(120,220,255,${gl})`;g.font=`bold 20px ${FONT}`;g.textAlign='center';g.textBaseline='middle';g.fillText(k,px+w/2,py-1);g.textAlign='left'}});
   else if(l.kind==='guard')L.push({y:(l.y+1)*T,f:()=>{const fe=XI.X_AFENCE,pb=XI.X_GATE_POL;if(pb&&pb.width){const bw=Math.max(w+10,64),bh=pb.height*bw/pb.width;g.drawImage(pb,Math.round(px+w/2-bw/2),Math.round(py+T+1-bh),Math.round(bw),Math.round(bh))}else if(fe&&fe.width){const fw=fe.width/3,fh=fe.height/3;for(let i=T;i<w;i+=T)g.drawImage(fe,px+i-(fw-T)/2,py+T-fh+1,fw,fh)}else{g.fillStyle='#5a3a22';g.fillRect(px+T,py+2,w-T,3);g.fillRect(px+T,py+8,w-T,3)}
     const im=XI['C_'+(GUARD[l.z]||'junsa')+'_00'];if(im&&im.width){const s=1/3;g.drawImage(im,px+8-im.width*s/2,py+16-im.height*s,im.width*s,im.height*s)}}});
   else if(l.kind==='fog')L.push({y:(l.y+3)*T,f:()=>{const SK=smokeSpr('226,230,236');g.globalAlpha=.85;for(let i=0;i<6;i++){const cx=px+w/2+Math.sin(tt*.4+i)*22+(i-3)*16,cy=py-12+(i%3)*12;g.drawImage(SK.band,cx-50,cy-12,100,24)}g.globalAlpha=1;
     {const sk=['X_O_SIGN','X_SIGN0','X_GSIGN','X_CSIGN','X_P_SIGN'].find(k=>XI[k]&&XI[k].width);if(sk){const im=XI[sk],sh=30,sw=im.width*sh/im.height;g.drawImage(im,Math.round(px+w/2-sw/2),Math.round(py+14-sh),sw,sh)}else{g.fillStyle='#4a3424';g.fillRect(px+w/2-1,py-14,3,28);g.fillStyle='#8a6a44';g.fillRect(px+w/2-14,py-12,13,6);g.fillRect(px+w/2+2,py-8,13,6);g.fillRect(px+w/2-12,py-2,11,6)}}}})}};
})();

/* ---------- Piste 3 : trésors scellés et raccourcis ----------
   Trésors scellés : dans chaque route, un coffre caché est bloqué par un obstacle qu'on ne franchit
   qu'avec un objet trouvé PLUS LOIN dans l'aventure. Il faut revenir.
   Raccourcis : un vieux passage relie le haut d'un bourg au bas du suivant. Il s'ouvre quand la route est finie. */
(()=>{
 const J=(n,jp,fr,x)=>({n,jp,fr,x}),T_=(n,t)=>({n,t}),KA='Kaito',KG='影',TN=NPN.tanu;
 const M=MAPS.world,T=16,walk=(x,y)=>{const r=M.rows[y];if(!r)return false;const c=r[x];return c!==undefined&&!SOLID.includes(c)&&c!=='G'};
 /* quel objet ouvre le trésor de chaque route (toujours un objet obtenu plus tard) */
 const NEEDS={1:'bell',2:'crank',3:'torch',4:'torch',6:'bell',7:'crank',8:'crank',9:'plank',10:'plank',11:'bell',12:'axe',13:'axe',14:'axe'};
 const SEAL={torch:{d:"Un coffre pris dans une gangue de glace bleue. Un yōkai des neiges a dû souffler dessus en passant.",need:"Il faudrait du feu pour la faire fondre.",ok:"Tu approches la torche. La glace craque, fond, et libère le coffre."},
  crank:{d:"Un coffre de fer bardé de rivets. Au milieu, un verrou rouillé avec un trou carré, comme pour une manivelle.",need:"Il faudrait une manivelle pour tourner ce verrou.",ok:"Tu emboîtes la manivelle. Clac, clac, clac… le couvercle se soulève."},
  bell:{d:"Un petit tanuki de pierre dort, couché en boule sur un coffre. Il ronfle.",need:"Il faudrait un bruit énorme pour le réveiller.",ok:"Tu fais sonner la cloche. Le petit tanuki sursaute, bâille, et va se rendormir un peu plus loin."},
  plank:{d:"Un coffre, au fond d'un trou boueux trop large pour sauter.",need:"Avec une planche, on pourrait faire un petit pont.",ok:"Tu poses une planche en travers du trou et tu vas chercher le coffre."},
  axe:{d:"Un coffre étranglé par des racines épaisses comme des bras.",need:"Une hache en viendrait à bout.",ok:"Trois coups de hache, et les racines lâchent le coffre."}};
 const RARE=['ofuda','fude','sumi','kemuri','suzu','bento'];
 const SEALS=[];
 for(const z in NEEDS){const L=HIDS.filter(h=>h.z===+z);if(!L.length)continue;const h=L[L.length-1];HIDS.splice(HIDS.indexOf(h),1);SEALS.push({id:'sc'+z,z:+z,x:h.x,y:h.y,it:NEEDS[z]})}
 window.SEALS=SEALS;
 const has=k=>S.it[k]>0||!!S.fl.visit;
 async function openSeal(s){const o=SEAL[s.it],it=IT[s.it];
  if(S.fl[s.id])return;
  if(!has(s.it))return D.say([o.d,o.need,T_(KG,"On reviendra. Ce coffre a l'air patient.")]);
  await D.say([o.d,{jp:it.t.concat(['を','使います|つかいます','。']),fr:`Tu utilises : ${it.n}.`,x:'使います (つかいます) = utiliser'},o.ok]);
  S.fl[s.id]=1;const g=120+s.z*20,r=RARE[s.z%RARE.length];S.gold=(S.gold||0)+g;S.it[r]=(S.it[r]||0)+1;S.it.hagane=(S.it.hagane||0)+1;sfx('item');
  const n=SEALS.filter(q=>S.fl[q.id]).length;
  await D.say([{jp:['宝物|たからもの','を','見つけた|みつけた','！'],fr:`Un trésor scellé ! ${g} pièces et : ${IT[r]?IT[r].n:r}.`,x:'宝物 (たからもの) = trésor'},`(Et un morceau d'acier de kiryoku. Trésors scellés : ${n} sur ${SEALS.length}.)`]);save()}
 /* raccourcis : du haut du bourg z au bas du bourg z+1 */
 const SC=[3,4,6,8,10,14,15],SHORT=[];
 const spot=(h,yy,dir)=>{const e=h.x0+h.ex;for(let k=0;k<9;k++)for(let d=2;d<22;d++)for(const sx of [-1,1]){const x=e+sx*d,y=yy+dir*k;
   let n=0;for(let a=-1;a<=1;a++)for(let b=-1;b<=1;b++)if((a||b)&&walk(x+a,y+b))n++;let ok=walk(x,y)&&walk(x,y+1)&&walk(x,y-1)&&n>=7;
   if(ok&&!(M.bld||[]).some(q=>x>=q.x-1&&x<=q.x+q.w&&y>=q.y-1&&y<=q.y+q.h+1)&&!(M.warps||[]).some(w=>Math.abs(w.x-x)<2&&Math.abs(w.y-y)<3))return[x,y]}return null};
 for(const z of SC){const A=HAMS.find(h=>h.z===z),B=HAMS.find(h=>h.z===z+1);if(!A||!B)continue;const a=spot(A,A.y0+3,1),b=spot(B,B.y1-3,-1);if(a&&b)SHORT.push({z,a,b})}
 window.SHORTS=SHORT;
 const routeDone=z=>{const q=PUZ.find(p=>p.z===z),l=LOCKS.find(p=>p.z===z);return (!q||!!S.fl['pz'+z])&&(!l||!!S.fl['lk'+z])};
 async function useShort(s,fromA){
  if(!routeDone(s.z)&&!S.fl.visit)return D.say(["Un vieux passage de mineur, bouché par des éboulis. Un filet d'air froid passe entre les pierres.",T_(TN,"Ça doit mener au bourg d'à côté. Quand la route sera sûre, les gens du coin le dégageront sûrement.")]);
  if(!S.fl['sh'+s.z]){S.fl['sh'+s.z]=1;save();await D.say(["Les éboulis ont été dégagés. Des lanternes neuves éclairent un tunnel qui file sous la colline.",J(KA,['近道|ちかみち','です','ね','。'],'C\'est un raccourci, hein.','近道 (ちかみち) = raccourci')])}
  if(await D.ask(fromA?'Prendre le raccourci vers le bourg suivant ?':'Prendre le raccourci vers le bourg précédent ?',['Oui','Non'])!==0)return;
  await UI.fade(1,350);sfx('door');const p=fromA?s.b:s.a;W.load('world',p[0],p[1]+(fromA?-1:1),fromA?0:1);W.H.cd=3;await UI.fade(0,350);W.refreshZone()}
 const cellOf=(x,y)=>{const s=SEALS.find(q=>q.x===x&&q.y===y&&!S.fl[q.id]);if(s)return{k:'seal',s};for(const q of SHORT){if(q.a[0]===x&&q.a[1]===y)return{k:'a',s:q};if(q.b[0]===x&&q.b[1]===y)return{k:'b',s:q}}return null};
 const oS=window.XSOLID;window.XSOLID=(m,x,y)=>(oS&&oS(m,x,y))||(m==='world'&&!!cellOf(x,y));
 const oI=window.XINT;window.XINT=(m,x,y,probe)=>{if(m==='world'){const c=cellOf(x,y);if(c)return probe?true:(c.k==='seal'?()=>openSeal(c.s):()=>useShort(c.s,c.k==='a'))}return oI?oI(m,x,y,probe):null};
 /* dessin provisoire (remplacé par les images X_SEAL_*, X_SHORT0/1 si elles existent) */
 const img=k=>XI[k]&&XI[k].width?XI[k]:null;
 const oD=window.XDRAW;window.XDRAW=(m,L,g,X,Y,VW,VH)=>{oD&&oD(m,L,g,X,Y,VW,VH);if(m!=='world')return;const tt=performance.now()/1000;
  for(const s of SEALS){if(S.fl[s.id])continue;const px=s.x*T-X,py=s.y*T-Y;if(px<-40||px>VW+40||py<-60||py>VH+40)continue;
   L.push({y:(s.y+1)*T,f:()=>{const im=img('X_SEAL_'+s.it.toUpperCase());if(im){const w=im.width/3,h=im.height/3;g.drawImage(im,px+8-w/2,py+16-h,w,h);return}
    const ch=img('X_BUNDLE');g.fillStyle='#6a4426';g.fillRect(px+2,py+4,12,10);g.fillStyle='#c89a3a';g.fillRect(px+2,py+8,12,2);g.fillRect(px+7,py+6,2,6);
    if(s.it==='torch'){g.fillStyle='rgba(150,220,255,.6)';g.fillRect(px,py-2,16,18);g.fillStyle='rgba(255,255,255,.7)';g.fillRect(px+2,py,3,10)}
    else if(s.it==='crank'){g.fillStyle='#5a5e66';g.fillRect(px+1,py+3,14,12);g.fillStyle='#9a5a2a';g.fillRect(px+6,py+7,4,4);g.fillStyle='#2a2a30';g.fillRect(px+7,py+8,2,2)}
    else if(s.it==='bell'){g.fillStyle='#8a8a84';g.beginPath();g.ellipse(px+8,py+2,7,6,0,0,7);g.fill();g.fillStyle='#55554f';g.fillRect(px+4,py,2,1);g.fillRect(px+10,py,2,1);g.fillStyle='#fff';g.font='6px sans-serif';g.fillText('z',px+12,py-4-Math.sin(tt*2)*2)}
    else if(s.it==='plank'){g.fillStyle='#3a2a1a';g.beginPath();g.ellipse(px+8,py+12,10,5,0,0,7);g.fill()}
    else if(s.it==='axe'){g.strokeStyle='#4a3420';g.lineWidth=3;g.beginPath();g.moveTo(px-2,py+2);g.quadraticCurveTo(px+8,py+16,px+18,py+2);g.moveTo(px-2,py+12);g.quadraticCurveTo(px+8,py-2,px+18,py+12);g.stroke()}}})}
  for(const s of SHORT)for(const[k,p]of [['a',s.a],['b',s.b]]){const px=p[0]*T-X,py=p[1]*T-Y;if(px<-40||px>VW+40||py<-60||py>VH+40)continue;const op=routeDone(s.z)||S.fl.visit;
   L.push({y:(p[1]+1)*T,f:()=>{const im=img(op?'X_SHORT1':'X_SHORT0');if(im){const w=im.width/3,h=im.height/3;g.drawImage(im,px+8-w/2,py+16-h,w,h);return}
    g.fillStyle='#5a5650';g.beginPath();g.ellipse(px+8,py+10,14,11,0,Math.PI,0);g.fill();g.fillRect(px-6,py+10,28,6);
    g.fillStyle=op?'#120e0c':'#7a756c';g.beginPath();g.ellipse(px+8,py+12,8,8,0,Math.PI,0);g.fill();g.fillRect(px,py+12,16,4);
    if(!op){g.fillStyle='#8e887e';for(const[a,b,r]of[[3,11,3],[9,9,3],[13,12,3],[7,13,2]]){g.beginPath();g.arc(px+a,py+b,r,0,7);g.fill()}}
    else{const k2=.7+.3*Math.sin(tt*3);g.fillStyle=`rgba(255,180,80,${k2})`;g.fillRect(px-4,py+2,3,4);g.fillRect(px+17,py+2,3,4)}}})}};
})();

/* ---------- Pistes 4 et 7 : trois donjons courts, un par acte ----------
   Salle 1 : l'entrée.  Salle 2 : rochers à pousser dans les trous.  Salle 3 : pont fissuré au-dessus du vide
   (il casse si on court).  Salle 4 : yōkai endormi qui se réveille et regarde autour de lui (il faut passer
   derrière les piliers quand il ne regarde pas).  Salle 5 : porte à kanji, puis le gardien du donjon. */
(()=>{
 const J=(n,jp,fr,x)=>({n,jp,fr,x}),T_=(n,t)=>({n,t}),KA='Kaito',KG='影',TN=NPN.tanu;
 /* plans (de bas en haut on lit de la dernière ligne à la première).
    # mur   . sol   ' ' vide   o rocher   x trou   c planche fissurée   Y yōkai (sa direction de départ en suffixe dans le code)
    D porte à kanji   B gardien   C coffre   E sortie   S stèle */
 const ROOMS={
  boss:["###############","#.............#","#......B......#","#.............#","#....C...C....#","#.............#","#######D#######"],
  sneak1:["#######.#######","#.............#","#..#.......#..#","#......Y......#","#..#.......#..#","#.............#","#######.#######"],
  sneak2:["#######.#######","#.............#","#.#..Y....#...#","#.............#","#...#....Y..#.#","#.............#","#######.#######"],
  bridge1:["#######.#######","#     ...     #","#      c      #","#      cc     #","#       c     #","#      cc     #","#      c      #","#     ...     #","#######.#######"],
  bridge2:["#######.#######","#    ...      #","#    c        #","#    cccc     #","#       c     #","#       ccc   #","#         c   #","#      ccccc  #","#      c      #","#     ...     #","#######.#######"],
  rocks1:["#######.#######","#######x#######","#.............#","#....o........#","#.............#","#.........o...#","#.............#","#######.#######"],
  rocks2:["#######x#######","#######x#######","#.............#","#...o.........#","#.............#","#..........o..#","#.............#","#######.#######"],
  rocks3:["#######x#######","#######x#######","#.............#","#..o......#...#","#.......o.....#","#....#.....o..#","#.............#","#######.#######"],
  entry:["#######.#######","#.............#","#..S...........#".slice(0,15),"#.............#","#######E#######"]};
 const DJ={
  1:{z:3,name:['古い鉱山|ふるいこうざん','La vieille mine'],rooms:['boss','sneak1','bridge1','rocks1','entry'],tint:'dark',mus:'well',
     boss:{kind:'karakuri',n:'Contremaître de fer',jp:['親方|おやかた'],lv:16,hp:260},yk:'karakuri',
     lore:"Une stèle couverte de poussière : « Ici, les ouvriers creusaient le fer de Tetsu. Un soir, le contremaître automate a refusé de les laisser remonter. »",
     win:"Le contremaître s'effondre dans un fracas de rouages. Dans sa poitrine, une petite boîte en fer : le salaire que les mineurs n'ont jamais touché."},
  2:{z:9,name:['黒鉄の下水道|くろがねのげすいどう','Les égouts de Kurogane'],rooms:['boss','sneak2','bridge2','rocks2','entry'],tint:'ink',mus:'city',
     boss:{kind:'namazu',n:'Grand Namazu des égouts',jp:['大鯰|おおなまず'],lv:34,hp:520},yk:'nekomata',
     lore:"Une plaque d'égoutier : « Interdit de descendre après le troisième coude. Quelque chose de gros dort sous la ville. Il fait trembler les quais quand il se retourne. »",
     win:"Le grand poisson-chat se tortille, crache une pluie de boulons et se rendort au fond de l'eau, sage comme une image. Dans la vase, un coffret de laiton."},
  3:{z:13,name:['大樹の根|たいじゅのね','Les racines du grand arbre'],rooms:['boss','sneak2','bridge2','rocks3','entry'],tint:'moss',mus:'foret',
     boss:{kind:'tsuchi',n:'Satori des racines',jp:['覚|さとり'],lv:52,hp:780},yk:'tenome',
     lore:"Gravé dans l'écorce, de la main d'un renard : « Ne réveillez pas ce qui dort sous l'arbre. Et si vous le réveillez, ne lui dites pas que c'est nous. »",
     win:"La grosse bête roule sur elle-même et s'enfonce dans la terre en ronchonnant. Entre les racines, un coffre que les renards cachaient depuis cent ans."}};
 const CH={'#':'H','.':'m',' ':' ','o':'m','x':'m','c':'m','Y':'m','D':'m','B':'m','C':'m','E':'d','S':'m'};
 for(const n in DJ){const d=DJ[n],R=[],O={rocks:[],holes:[],crack:[],yk:[],doors:[],boss:null,chests:[],exit:null,stele:null,rooms:[]};let y=0;
  for(const rn of d.rooms){const rows=ROOMS[rn],y0=y;O.rooms.push({k:rn,y0,y1:y0+rows.length-1});
   rows.forEach((r,j)=>{const yy=y0+j;R.push([...r].map((c,x)=>{
    if(c==='o')O.rocks.push({x,y:yy,x0:x,y0:yy,room:O.rooms.length-1});else if(c==='x')O.holes.push({x,y:yy});else if(c==='c')O.crack.push({x,y:yy});
    else if(c==='Y')O.yk.push({x,y:yy,dir:O.yk.length%2?2:0,room:O.rooms.length-1});else if(c==='D')O.doors.push({x,y:yy});else if(c==='B'&&!O.boss)O.boss={x,y:yy};
    else if(c==='C')O.chests.push({x,y:yy,i:O.chests.length});else if(c==='E')O.exit={x,y:yy};else if(c==='S')O.stele={x,y:yy};return CH[c]||'m'}).join(''))});y+=rows.length}
  d.O=O;MAPS['dj'+n]={w:15,h:R.length,inside:1,zi:0,dj:+n,src:d.rooms.flatMap(k=>ROOMS[k]),tint:d.tint,music:d.mus,name:d.name,rows:R,zone:()=>99,warps:[]}}
 window.DJ=DJ;
 /* les vraies tuiles de chaque donjon (planche 6 × 3) ; sinon on garde les sols d'intérieur assombris */
 const TC={},tile=(n,k)=>{const i=XI['T_DJ'+(n===4?1:n)+'_'+k];return i&&i.width?i:null};
 const FLOOR={4:['00','00','00','01','05'],1:['00','00','00','01','05'],2:['00','00','01','02','00'],3:['00','00','01','02','04']};
 window.DJTILE=(M,c,x,y)=>{const n=M.dj;if(!tile(n,'00'))return null;const s=M.src,o=s[y]&&s[y][x],up=s[y-1]&&s[y-1][x],dn=s[y+1]&&s[y+1][x],hh=(x*7+y*13)%17;
  const fl=()=>tile(n,hh===3?'25':FLOOR[n][hh%5]);
  if(o==='#'){if(dn&&dn!=='#')return tile(n,'1'+(hh%7===0?'2':hh%7===1?'1':hh%9===2?'3':'0'));const t=tile(n,'10');return t?(TC['d'+n]||(TC['d'+n]=tintImg(t,'dark'))):null}
  if(o===' ')return tile(n,up&&up!==' '&&up!=='#'?'15':'14');
  if(o==='c')return tile(n,'20');if(o==='E')return tile(n,'22');if(o==='D')return tile(n,'23');if(o==='x')return tile(n,'21');
  return fl()};
 const cur=()=>{const m=W.map;return m&&m.startsWith('dj')?DJ[m.slice(2)]:null},F=n=>'dj'+n+'_';
 const filled=(d,n,h)=>!!S.fl[F(n)+'h'+h.x+'_'+h.y];
 const rockAt=(d,x,y)=>d.O.rocks.find(r=>!r.gone&&r.x===x&&r.y===y);
 const ykAt=(d,x,y)=>d.O.yk.find(k=>k.x===x&&k.y===y);
 const nOf=d=>+Object.keys(DJ).find(k=>DJ[k]===d);
 const roomOf=(d,y,x)=>{if(x==null)x=W.H.x;return d.O.rooms.findIndex(r=>y>=r.y0&&y<=r.y1&&x>=(r.x0||0)&&x<(r.x0||0)+15)};
 const entryOf=(d,ri)=>{const r=d.O.rooms[ri];return r.ein||[7,r.y1-1]};
 const solidAt=(d,x,y)=>{const n=nOf(d);if(rockAt(d,x,y)||ykAt(d,x,y))return true;
  if(d.O.holes.some(h=>h.x===x&&h.y===y&&!filled(d,n,h)))return true;
  if(d.O.doors.some(q=>q.x===x&&q.y===y)&&!S.fl[F(n)+'door'])return true;
  if(d.O.boss&&!S.fl[F(n)+'boss']&&Math.abs(x-d.O.boss.x-.5)<=1&&(y===d.O.boss.y||y===d.O.boss.y-1))return true;
  if(d.O.chests.some(c=>c.x===x&&c.y===y))return true;if(d.O.stele&&d.O.stele.x===x&&d.O.stele.y===y)return true;return false};
 /* état des rochers : on les remet en place quand on rentre dans la salle */
 const resetRocks=(d,ri)=>{const n=nOf(d);for(const r of d.O.rocks)if(r.room===ri&&!r.gone){r.x=r.x0;r.y=r.y0}};
 const restore=d=>{const n=nOf(d);for(const r of d.O.rocks){r.gone=!!S.fl[F(n)+'r'+r.x0+'_'+r.y0];if(!r.gone){r.x=r.x0;r.y=r.y0}}};
 const oS=window.XSOLID;window.XSOLID=(m,x,y)=>(oS&&oS(m,x,y))||(m.startsWith&&m.startsWith('dj')&&solidAt(DJ[m.slice(2)],x,y));
 /* pousser un rocher */
 const oP=window.XPUSH;window.XPUSH=(m,x,y,dx,dy)=>{if(oP&&oP(m,x,y,dx,dy))return true;const d=m.startsWith&&m.startsWith('dj')?DJ[m.slice(2)]:null;if(!d)return false;
  const r=rockAt(d,x,y);if(!r)return false;const n=nOf(d),tx=x+dx,ty=y+dy,row=MAPS[m].rows[ty];if(!row)return false;
  const hole=d.O.holes.find(h=>h.x===tx&&h.y===ty&&!filled(d,n,h));
  if(hole){r.gone=true;S.fl[F(n)+'h'+hole.x+'_'+hole.y]=1;S.fl[F(n)+'r'+r.x0+'_'+r.y0]=1;save();sfx('boom');W.shake&&W.shake(.25);UI.toast('Le rocher tombe dans le trou !',1600);return true}
  if(row[tx]!=='m'||solidAt(d,tx,ty)||(W.H.x===tx&&W.H.y===ty))return false;
  r.x=tx;r.y=ty;r.anim=performance.now();sfx('bump');return true};
 /* arrivée sur une case : planche fissurée (on tombe si on court), entrée de salle (on remet les rochers) */
 let fallen=0;
 const oA=window.XARR;window.XARR=(m,x,y,run)=>{if(oA&&oA(m,x,y,run))return true;const d=m.startsWith&&m.startsWith('dj')?DJ[m.slice(2)]:null;if(!d)return false;
  const ri=roomOf(d,y,x),rm=d.O.rooms[ri];
  if(rm&&y===rm.y1&&rm.k.startsWith('rocks'))resetRocks(d,ri);
  if(run&&d.O.crack.some(c=>c.x===x&&c.y===y)){W.ev(async()=>{sfx('boom');await D.say(["Crac ! La planche fissurée cède sous tes pas de course.",T_(KG,"Sur un vieux pont, on marche. On ne court pas. … Je le note pour la prochaine fois. Toi aussi.")]);
    await UI.fade(1,300);const[ex,ey]=entryOf(d,ri);W.load(m,ex,ey,1);W.H.cd=2;await UI.fade(0,300)});return true}
  return false};
 /* le yōkai endormi : il dort, se réveille, regarde dans une direction, puis une autre */
 const look=(d,k,t)=>{if(k.zz&&performance.now()<k.zz)return -1;const c=((t/1.7+k.x)|0)%6;return c<2?-1:[0,3,1,2][(c+k.dir)%4]};/* -1 = il dort */
 const DX=[[0,1],[0,-1],[-1,0],[1,0]];
 const sees=(d,k,dir,px,py)=>{if(dir<0)return false;const[dx,dy]=DX[dir],row=MAPS['dj'+nOf(d)].rows;
  for(let s=1;s<=4;s++)for(const w of s>=2?[-1,0,1]:[0]){const x=k.x+dx*s+(dy?w:0),y=k.y+dy*s+(dx?w:0);
   const free=(a,b)=>row[b]&&row[b][a]==='m';if(!free(x,y))continue;
   let ok=true;for(let u=1;u<s;u++){const xx=k.x+dx*u+(dy?Math.sign(w)*(u>=2?1:0):0),yy=k.y+dy*u+(dx?Math.sign(w)*(u>=2?1:0):0);if(!free(xx,yy)){ok=false;break}}
   if(ok&&x===px&&y===py)return true}return false};
 let caught=false;
 const oSt=W.step;W.step=dt=>{const r=oSt(dt);const d=cur();if(d&&!caught&&!G.busy&&!S.fl.visit){const t=performance.now()/1000,H=W.H;
  for(const k of d.O.yk){if(roomOf(d,k.y,k.x)!==roomOf(d,H.y,H.x))continue;const dir=look(d,k,t);if(sees(d,k,dir,H.x,H.y)){caught=true;
   W.ev(async()=>{sfx('alert');k.alert=performance.now();await wait(500);await D.say(["Le yōkai ouvre grand les yeux et souffle un nuage d'encre froide. Tu es repoussé jusqu'à l'entrée de la salle.",T_(KG,"Il dort d'un œil. Passe quand il regarde ailleurs, et cache-toi derrière les piliers.")]);
    await UI.fade(1,300);const rr=d.O.rooms[roomOf(d,k.y,k.x)];W.load(W.map,rr.out?rr.out[0]:7,rr.out?rr.out[1]:rr.y1+1,1);W.H.cd=2;await UI.fade(0,300);caught=false});break}}}return r};
 /* interactions */
 const kanji=d=>{const ks=Object.keys(S.sp||{}).filter(k=>spK(k));return ks.length?ks[(nOf(d)*5+1)%ks.length]:'人'};
 async function door(d){const n=nOf(d),k=kanji(d);
  await D.say(["Une lourde porte de pierre. Le kanji 「"+k+"」 y est gravé, et ses sillons attendent ton pinceau."]);
  if(S.fl.visit){S.fl[F(n)+'door']=1;save();return}
  if(await D.ask('Tracer le kanji ?',['Tracer','Plus tard'])!==0)return;const r=await Trace.run(spK(k)||spK('人'),{});UI.panel('pad');
  if(r&&r.stars>=1){S.fl[F(n)+'door']=1;save();sfx('door');return D.say(["La porte glisse dans la roche. Derrière, une grande salle… et quelque chose qui respire.",J(KA,['開きました|あきました','。'],'Elle s\'est ouverte.')])}
  return D.say("Les traits s'éteignent. La porte reste close.")}
 async function boss(d){const n=nOf(d),b=d.boss;
  await D.say([`Au fond de la salle, ${b.n} se redresse.`,{jp:b.jp.concat(['！']),fr:b.n},T_(KG,"Le gardien du donjon. Il garde quelque chose. Les gardiens gardent toujours quelque chose.")]);
  const def=Object.assign(STORY.wildDef(d.z,b.kind),{n:b.n,lv:b.lv,hp:b.hp,dmg:Math.round(b.lv*1.6+8),xp:b.lv*8,big:1,gold:200+b.lv*6,clue:'Le gardien du donjon. Plus coriace qu\'un yōkai de la route.'});
  const r=await Battle.start(def,{zone:d.z});
  if(r==='win'){S.fl[F(n)+'boss']=1;save();await D.say([d.win,"Deux coffres attendent au fond de la salle."])}else{await UI.fade(1,300);W.load(W.map,7,MAPS[W.map].h-2,0);await UI.fade(0,300)}}
 const LOOT=[['ofuda','sumi'],['fude','suzu'],['bento','kemuri'],['suzu','bento']];
 async function chest(d,c){const n=nOf(d),key=F(n)+'c'+c.i;
  if(!S.fl[F(n)+'boss'])return D.say("Un coffre cerclé de fer. Il ne s'ouvrira pas tant que le gardien veille.");
  if(S.fl[key])return D.say("Le coffre est vide.");
  S.fl[key]=1;const it=LOOT[n-1][c.i],g=150*n;S.it[it]=(S.it[it]||0)+2;S.it.hagane=(S.it.hagane||0)+2;S.gold=(S.gold||0)+g;sfx('item');
  await D.say([{jp:['宝物|たからもの','だ','！'],fr:`Un trésor ! ${g} pièces, deux ${IT[it]?IT[it].n:it} et deux morceaux d'acier de kiryoku.`,x:'宝物 (たからもの) = trésor'}]);
  if(S.fl[F(n)+'c0']&&S.fl[F(n)+'c1']){S.fl['djdone'+n]=1;await D.say(["Une brise remonte du fond du donjon. Le chemin du retour est dégagé.",`(Donjon terminé : ${d.name[1]}.)`])}save()}
 const oI=window.XINT;window.XINT=(m,x,y,probe)=>{const d=m&&m.startsWith&&m.startsWith('dj')?DJ[m.slice(2)]:null;
  if(d){if(d.O.doors.some(q=>q.x===x&&q.y===y)&&!S.fl[F(nOf(d))+'door'])return probe||(()=>door(d));
   if(d.O.boss&&!S.fl[F(nOf(d))+'boss']&&solidAt(d,x,y)&&Math.abs(x-d.O.boss.x-.5)<=1&&y>=d.O.boss.y-1&&y<=d.O.boss.y)return probe||(()=>boss(d));
   const c=d.O.chests.find(q=>q.x===x&&q.y===y);if(c)return probe||(()=>chest(d,c));
   if(d.O.stele&&d.O.stele.x===x&&d.O.stele.y===y)return probe||(()=>D.say(d.lore));
   if(rockAt(d,x,y))return probe||(()=>D.say("Un gros rocher. Il bouge un peu quand on le pousse. Il y a un trou quelque part qui l'attend."))}
  return oI?oI(m,x,y,probe):null};
 /* entrée et sortie */
 const M=MAPS.world,walk=(x,y)=>{const r=M.rows[y];if(!r)return false;const c=r[x];return c!==undefined&&!SOLID.includes(c)&&c!=='G'};
 for(const n in DJ){const d=DJ[n],h=HAMS.find(q=>q.z===d.z);if(!h)continue;let best=null;const e=h.x0+h.ex;
  for(let k=0;k<10&&!best;k++)for(let dd=4;dd<24&&!best;dd++)for(const sx of [1,-1]){const x=e+sx*dd,y=h.y0+6+k;let c=0;for(let a=-1;a<=1;a++)for(let b=-1;b<=1;b++)if(walk(x+a,y+b))c++;
   if(c===9&&!(M.bld||[]).some(q=>x>=q.x-1&&x<=q.x+q.w&&y>=q.y-1&&y<=q.y+q.h+1)&&!(window.SHORTS||[]).some(s=>[s.a,s.b].some(p=>Math.abs(p[0]-x)<3&&Math.abs(p[1]-y)<3))){best=[x,y];break}}
  d.door=best;MAPS['dj'+n].warps=[{x:d.O.exit.x,y:d.O.exit.y,to:'world',tx:best?best[0]:e,ty:best?best[1]+1:h.y0+8}]}
 const atDoor=(x,y)=>Object.keys(DJ).find(n=>DJ[n].door&&DJ[n].door[0]===x&&DJ[n].door[1]===y);
 const oS2=window.XSOLID;window.XSOLID=(m,x,y)=>(oS2&&oS2(m,x,y))||(m==='world'&&!!atDoor(x,y));
 async function enter(n){const d=DJ[n];
  if(!S.fl['djseen'+n]){S.fl['djseen'+n]=1;await D.say(["Une ouverture sombre, à moitié cachée. Un escalier de pierre descend dans le noir. On entend un grondement, très loin en dessous.",T_(TN,"Un donjon ! Il y a toujours un trésor au fond d'un donjon. Et un gardien. Je te laisse le gardien.")])}
  if(await D.ask(`Descendre dans « ${d.name[1]} » ?`,['Descendre','Plus tard'])!==0)return;
  restore(d);await UI.fade(1,350);sfx('door');W.load('dj'+n,7,MAPS['dj'+n].h-2,0);W.H.cd=2;await UI.fade(0,350);W.refreshZone()}
 const oI2=window.XINT;window.XINT=(m,x,y,probe)=>{if(m==='world'){const n=atDoor(x,y);if(n)return probe||(()=>enter(n))}return oI2?oI2(m,x,y,probe):null};
 /* dessin */
 const oD=window.XDRAW;window.XDRAW=(m,L,g,X,Y,VW,VH)=>{oD&&oD(m,L,g,X,Y,VW,VH);const T=16,tt=performance.now()/1000;
  if(m==='world'){for(const n in DJ){const p=DJ[n].door;if(!p)continue;const px=p[0]*T-X,py=p[1]*T-Y;if(px<-60||px>VW+60||py<-60||py>VH+60)continue;
    L.push({y:(p[1]+1)*T,f:()=>{const im=XI.X_DJDOOR;if(im&&im.width){const w=im.width/3,h=im.height/3;g.drawImage(im,px+8-w/2,py+16-h,w,h);return}
     g.fillStyle='#4a4640';g.beginPath();g.ellipse(px+8,py+12,17,15,0,Math.PI,0);g.fill();g.fillRect(px-9,py+12,34,5);g.fillStyle='#0a0808';g.beginPath();g.ellipse(px+8,py+14,10,11,0,Math.PI,0);g.fill();g.fillRect(px-2,py+14,20,3);
     g.fillStyle='#6a645a';for(let i=0;i<4;i++)g.fillRect(px+1+i*4,py+13-i*2,4,2);const k=.6+.4*Math.sin(tt*2.5);g.fillStyle=`rgba(255,170,70,${k})`;g.fillRect(px-7,py+4,3,4);g.fillRect(px+20,py+4,3,4)}})}return}
  const d=m.startsWith&&m.startsWith('dj')?DJ[m.slice(2)]:null;if(!d)return;const n=nOf(d);
  L.push({y:-1e6,f:()=>{for(const c of d.O.crack){const px=c.x*T-X,py=c.y*T-Y;if(XI.T_DJPLANK&&XI.T_DJPLANK.width){g.drawImage(XI.T_DJPLANK,px,py,T,T);continue}g.fillStyle='#7a5a36';g.fillRect(px,py+1,T,T-2);g.fillStyle='#5a3e22';g.fillRect(px,py+5,T,1);g.fillRect(px,py+10,T,1);g.fillStyle='#1a120a';g.fillRect(px+5,py+2,1,4);g.fillRect(px+9,py+7,1,5);g.fillRect(px+3,py+11,3,1)}
   for(const h of d.O.holes){const px=h.x*T-X,py=h.y*T-Y;if(XI.T_DJHOLE&&XI.T_DJHOLE.width&&XI.T_DJFILL&&XI.T_DJFILL.width){g.drawImage(XI[filled(d,n,h)?'T_DJFILL':'T_DJHOLE'],px,py,T,T);continue}if(filled(d,n,h)){g.fillStyle='#6a645c';g.fillRect(px+1,py+1,T-2,T-2);g.fillStyle='#55504a';g.fillRect(px+3,py+4,4,3);continue}g.fillStyle='#050404';g.fillRect(px+1,py+1,T-2,T-2);g.fillStyle='#1c1814';g.fillRect(px+1,py+1,T-2,3)}}});
  for(const r of d.O.rocks){if(r.gone)continue;L.push({y:(r.y+1)*T-1,f:()=>{const px=r.x*T-X,py=r.y*T-Y,im=XI.X_DJROCK;if(im&&im.width){const w=im.width/3,h=im.height/3;g.drawImage(im,px+8-w/2,py+16-h,w,h);return}
    g.fillStyle='rgba(0,0,0,.3)';g.beginPath();g.ellipse(px+8,py+15,8,2.5,0,0,7);g.fill();g.fillStyle='#7c776e';g.beginPath();g.ellipse(px+8,py+8,8,7.5,0,0,7);g.fill();g.fillStyle='#a19b90';g.beginPath();g.ellipse(px+6,py+5,4,3,0,0,7);g.fill();g.fillStyle='#57534c';g.fillRect(px+9,py+10,4,2)}})}
  for(const k of d.O.yk){L.push({y:(k.y+1)*T,f:()=>{const dir=S.fl.visit?-1:look(d,k,tt),px=k.x*T-X,py=k.y*T-Y,im=hdcImg(RKIND[d.yk]?RKIND[d.yk].s:'karakuri',dir<0?0:dir);
    if(dir>=0){const[dx,dy]=DX[dir];g.fillStyle='rgba(255,230,120,.16)';for(let s=1;s<=4;s++)for(const w of s>=2?[-1,0,1]:[0])g.fillRect((k.x+dx*s+(dy?w:0))*T-X,(k.y+dy*s+(dx?w:0))*T-Y,T,T)}
    if(im){const w=im.width/3,h=im.height/3;g.drawImage(im,px+8-w/2,py+16-h,w,h)}else{g.fillStyle='#4a3a6a';g.fillRect(px+2,py,12,16)}
    g.fillStyle='#fff';g.font='bold 9px sans-serif';if(dir<0)g.fillText('z',px+13,py-6-Math.sin(tt*2)*3);else g.fillText(k.alert&&performance.now()-k.alert<1200?'!':'',px+6,py-10)}})}
  if(d.O.boss&&!S.fl[F(n)+'boss']){const b=d.O.boss;L.push({y:(b.y+1)*T,f:()=>{const im=hdcImg(RKIND[d.boss.kind].s,0),px=(b.x+.5)*T+8-X,py=(b.y+1)*T-Y;if(im){const k=1.9,w=im.width/3*k,h=im.height/3*k;g.drawImage(im,px-w/2,py-h+Math.sin(tt*1.5)*2,w,h)}}})}
  for(const c of d.O.chests){L.push({y:(c.y+1)*T,f:()=>{const px=c.x*T-X,py=c.y*T-Y,op=S.fl[F(n)+'c'+c.i],ci=XI.X_SEAL_PLAIN;if(ci&&ci.width&&!op){g.drawImage(ci,px+8-ci.width/6,py+16-ci.height/3,ci.width/3,ci.height/3);return}g.fillStyle=op?'#3a2a1a':'#7a4a22';g.fillRect(px+1,py+4,14,11);g.fillStyle='#d8a838';g.fillRect(px+1,py+8,14,2);g.fillRect(px+7,py+6,2,5)}})}
  if(d.O.stele){const s=d.O.stele;L.push({y:(s.y+1)*T,f:()=>{const px=s.x*T-X,py=s.y*T-Y,si=XI.X_DJSTELE;if(si&&si.width){g.drawImage(si,px+8-si.width/6,py+16-si.height/3,si.width/3,si.height/3);return}g.fillStyle='#6a6660';g.fillRect(px+2,py-6,12,21);g.fillStyle='#4a4640';g.fillRect(px+4,py-3,8,1);g.fillRect(px+4,py+1,8,1);g.fillRect(px+4,py+5,8,1)}})}
  for(const q of d.O.doors){if(S.fl[F(n)+'door'])continue;L.push({y:(q.y+1)*T,f:()=>{const px=q.x*T-X,py=q.y*T-Y,di=XI.X_LK_DOOR;if(di&&di.width){g.drawImage(di,px-16,py+16-di.height/3,48,di.height/3)}else{g.fillStyle='#5a5650';g.fillRect(px-4,py-14,24,30);g.fillStyle='#77726a';g.fillRect(px-2,py-12,20,26)}
    g.fillStyle=`rgba(120,220,255,${.6+.3*Math.sin(tt*2)})`;g.font='bold 16px serif';g.textAlign='center';g.textBaseline='middle';g.fillText(kanji(d),px+8,py+1);g.textAlign='left'}})}};
 const hdcImg=(nm,d)=>{const i=XI['C_'+nm+'_'+d+'0']||XI['C_'+nm+'_00'];return i&&i.width?i:null};
})();

/* ---------- Idée 1 : le karuta ----------
   Des cartes de mots sont étalées. On entend un mot (voix japonaise, et sa lecture en kana à l'écran si la voix
   est coupée). Il faut toucher la bonne carte avant l'adversaire. Trois champions dans le jeu, un par acte,
   et une partie libre dans le menu Jeux. Contient aussi la petite fenêtre partagée par les autres mini-jeux. */
(()=>{
 const J=(n,jp,fr,x)=>({n,jp,fr,x}),T_=(n,t)=>({n,t}),KG='影',TN=NPN.tanu;
 /* fenêtre de mini-jeu : par-dessus l'écran, au style du jeu */
 const st=document.createElement('style');st.textContent=`
 #mini{position:fixed;inset:0;z-index:60;background:rgba(8,10,22,.92);display:flex;flex-direction:column;align-items:center;justify-content:flex-start;padding:14px 10px;color:#f2ead6;font-family:inherit;overflow:auto}
 #mini h3{margin:4px 0 2px;color:var(--gold);font-size:19px;text-align:center}#mini .sub{color:var(--sub);font-size:13px;text-align:center;margin:0 0 8px}
 #mini .row{display:flex;gap:6px;flex-wrap:wrap;justify-content:center;margin:6px 0}
 #mini .card{width:78px;height:96px;border-radius:8px;background:#f4ecd6;color:#1c2038;border:3px solid var(--brass);display:flex;align-items:center;justify-content:center;text-align:center;font-size:22px;line-height:1.15;font-weight:bold;box-shadow:0 3px 0 #10131f;cursor:pointer;padding:2px;word-break:break-all}
 #mini .card.got{opacity:.18}#mini .card.me{background:#c8f0c0}#mini .card.foe{background:#f0c0c0}#mini .card.bad{animation:shk .25s}
 @keyframes shk{0%,100%{transform:none}30%{transform:translateX(-4px)}70%{transform:translateX(4px)}}
 #mini .tile{min-width:52px;padding:10px 12px;border-radius:8px;background:#f4ecd6;color:#1c2038;border:3px solid var(--brass);font-size:22px;box-shadow:0 3px 0 #10131f;cursor:pointer}
 #mini .tile.used{opacity:.25;pointer-events:none}#mini .line{min-height:56px;border-bottom:2px dashed var(--brass);width:94%;display:flex;gap:6px;flex-wrap:wrap;justify-content:center;align-items:center;padding:6px 0}
 #mini .score{display:flex;gap:18px;font-size:15px;margin:4px 0}#mini .big{font-size:40px;color:var(--gold);margin:6px 0;text-align:center}
 #mini .btn{min-height:44px;font-size:16px;margin:4px}#mini .bar{width:90%;height:8px;background:#30364e;border-radius:4px;overflow:hidden}#mini .bar i{display:block;height:100%;background:var(--cy)}`;
 document.head.appendChild(st);
 window.MiniUI={open(){let d=document.getElementById('mini');if(!d){d=document.createElement('div');d.id='mini';document.body.appendChild(d)}d.innerHTML='';d.style.display='flex';return d},
  close(){const d=document.getElementById('mini');if(d){d.style.display='none';d.innerHTML='';d.style.background=''}const L=document.getElementById('minibg');if(L)L.style.display='none'},
  wait(d,sel){return new Promise(r=>{d.onclick=e=>{const b=e.target.closest(sel);if(b)r(b)}})}};
 const shuf=a=>{for(let i=a.length-1;i>0;i--){const j=Math.floor(Math.random()*(i+1));[a[i],a[j]]=[a[j],a[i]]}return a};
 const reach=()=>{let z=1;for(let k=16;k>=1;k--)if(S.fl['ac'+k]||W.zone&&W.zone()>=k){z=k;break}return z};
 const words=z=>{let L=[];for(let k=1;k<=Math.max(2,z);k++)if(VOC[k])L=L.concat(VOC[k]);return L.filter(w=>w[0].includes('|'))};
 /* une partie : n cartes en jeu, on gagne la carte si on la touche avant l'adversaire */
 window.Karuta={async play(o){o=o||{};const z=o.z||reach(),pool=shuf(words(z).slice(-40)),N=o.n||8,ai=o.ai||0;
   const deck=pool.slice(0,N),d=MiniUI.open();let me=0,foe=0,miss=0;const rest=deck.slice();
   const draw=(msg,read)=>{d.innerHTML=`<h3>かるた · ${esc(o.who||'Partie libre')}</h3><p class="sub">${msg}</p><div class="score"><span>Toi : <b>${me}</b></span><span>${esc(o.who||'Adversaire')} : <b>${foe}</b></span></div>
     <div class="big">${read?esc(read):'…'}</div><div class="row">${deck.map((w,i)=>`<div class="card ${w.got?'got '+w.got:''}" data-i="${i}">${esc(tk(w[0])[0])}</div>`).join('')}</div>
     <button class="btn" data-q="1">Abandonner</button>`};
   draw(o.intro||'Écoute le mot, puis touche sa carte avant ton adversaire.',null);await wait(900);
   while(rest.length){const w=rest.splice(Math.floor(Math.random()*rest.length),1)[0],[k,r]=tk(w[0]);
    draw('Écoute bien…',null);await wait(600);say(r,.85);draw('Touche la bonne carte !',r);
    const t0=performance.now(),foeT=ai?Math.max(1100,4200-ai*900)+Math.random()*1500+(window.OMHAS&&OMHAS('fuda')?1200:0):1e9;let done=false,res=null;
    const foeP=new Promise(rs=>setTimeout(()=>rs('foe'),foeT));
    const meP=(async()=>{for(;;){const b=await MiniUI.wait(d,'.card,[data-q]');if(b.dataset.q)return 'quit';const c=deck[+b.dataset.i];if(c.got)continue;if(c===w)return 'me';miss++;sfx('wrong');b.classList.add('bad');setTimeout(()=>b.classList.remove('bad'),300)}})();
    res=await Promise.race([meP,foeP]);d.onclick=null;
    if(res==='quit'){MiniUI.close();return null}
    if(res==='me'){me++;w.got='me';sfx('right')}else{foe++;w.got='foe';sfx('bump')}
    draw(res==='me'?`Pris ! ${esc(k)} (${esc(r)}) = ${esc(w[1])}`:`${esc(o.who||'L\'adversaire')} a été plus rapide : ${esc(k)} (${esc(r)}) = ${esc(w[1])}`,r);await wait(1300)}
   const win=me>foe,perfect=me===N&&!miss;d.innerHTML=`<h3>Résultat</h3><div class="big">${me} – ${foe}</div><p class="sub">${win?'Victoire !':'Défaite…'}${perfect?' Sans faute !':''}</p><button class="btn" data-q="1">Continuer</button>`;
   await MiniUI.wait(d,'[data-q]');MiniUI.close();if(perfect)S.fl.karPerfect=1;S.fl.karGames=(S.fl.karGames||0)+1;save();return{me,foe,win,perfect}}};
 /* les trois champions */
 const CH=[{id:'kc1',z:4,spr:'baa',nm:'Grand-mère Karuta',ai:1,lines:[J('Grand-mère Karuta',['かるた','を','しません','か','。'],'Tu ne veux pas jouer au karuta ?','〜ませんか = tu ne veux pas… ? (invitation)'),"Soixante ans que je joue. J'ai perdu une seule fois. Contre mon chat. Il a triché."]},
  {id:'kc2',z:10,spr:'gakusei',nm:'Championne de l\'Académie',ai:2,lines:[J('Championne de l\'Académie',['勝負|しょうぶ','です','！'],'C\'est un duel !','勝負 (しょうぶ) = match, duel'),"Je suis la championne de l'Académie depuis trois ans. Je lis avec les oreilles. Et je touche avec les yeux fermés."]},
  {id:'kc3',z:14,spr:'tokei',nm:'Maître horloger',ai:3,lines:[J('Maître horloger',['速さ|はやさ','は','大切|たいせつ','です','。'],'La vitesse est importante.','大切 (たいせつ) = important'),"Une carte, c'est comme une seconde : quand on la voit passer, c'est déjà trop tard."]}];
 for(const c of CH){const h=HAMS.find(q=>q.z===c.z);if(!h)continue;NPCS.world.push({id:c.id,spr:c.spr,x:h.px+3,y:h.py-1,dir:0,wander:0,ev:'karuta',kc:c.id,nm:c.nm});PORT[c.nm]=PORT[c.nm]||'PX_'+c.spr}
 STORY.karuta=async e=>{const c=CH.find(q=>q.id===e.kc);await D.say(c.lines);
  if(S.fl[c.id])await D.say(T_(c.nm,"Tu m'as déjà battu. Mais une revanche ne se refuse pas."));
  if(await D.ask('Jouer au karuta ?',['Jouer','Plus tard'])!==0)return;
  const r=await Karuta.play({z:c.z,ai:c.ai,who:c.nm,n:8});if(!r)return;
  if(r.win){if(!S.fl[c.id]){S.fl[c.id]=1;S.gold=(S.gold||0)+150*c.ai;S.it.hagane=(S.it.hagane||0)+2;save();
    await D.say([T_(c.nm,"… Tu m'as battu. Prends ça. Et ne le dis à personne. Surtout pas à mon chat."),`(Tu gagnes ${150*c.ai} pièces et deux morceaux d'acier de kiryoku pour la forge.)`])}
   else await D.say(T_(c.nm,"Encore toi ! Bon. Bien joué."))}
  else await D.say([T_(c.nm,"Trop lent ! Écoute bien, et regarde toutes les cartes avant qu'on lise."),T_(KG,"Le secret, c'est de connaître la place des cartes avant le premier mot.")])};
})();

/* ---------- Idée 2 : les stèles effacées ----------
   Sur chaque route, Tetsu a brouillé la phrase d'une vieille stèle : les mots sont là, mais dans le désordre.
   Il faut les remettre dans l'ordre (avec les bonnes particules) pour réparer la stèle. */
(()=>{
 const T_=(n,t)=>({n,t}),KG='影';
 const P={
  1:[['田んぼ|たんぼ','に','水|みず','が','あります'],'Il y a de l\'eau dans la rizière.'],
  2:[['竹|たけ','の','森|もり','は','静か|しずか','です'],'La forêt de bambous est calme.'],
  3:[['毎朝|まいあさ','七時|しちじ','に','工場|こうじょう','へ','行きます|いきます'],'Chaque matin, je vais à l\'usine à sept heures.'],
  4:[['煙|けむり','で','空|そら','が','見えません|みえません'],'À cause de la fumée, on ne voit pas le ciel.'],
  6:[['山|やま','の','上|うえ','は','とても','寒い|さむい','です'],'En haut de la montagne, il fait très froid.'],
  7:[['旅人|たびびと','は','宿|やど','で','お茶|おちゃ','を','飲みます|のみます'],'Les voyageurs boivent du thé à l\'auberge.'],
  8:[['船|ふね','で','川|かわ','を','渡ります|わたります'],'On traverse la rivière en bateau.'],
  9:[['夜|よる','の','町|まち','に','猫|ねこ','が','たくさん','います'],'La nuit, il y a beaucoup de chats en ville.'],
  10:[['学生|がくせい','は','図書館|としょかん','で','本|ほん','を','読みます|よみます'],'Les étudiants lisent des livres à la bibliothèque.'],
  11:[['父|ちち','は','工場|こうじょう','で','働いて|はたらいて','います'],'Mon père travaille à l\'usine.'],
  12:[['明日|あした','の','船|ふね','は','何時|なんじ','に','出ます|でます','か'],'À quelle heure part le bateau de demain ?'],
  13:[['きつね','と','たぬき','は','森|もり','に','住んで|すんで','います'],'Les renards et les tanuki vivent dans la forêt.'],
  14:[['この','時計|とけい','は','少し|すこし','遅れて|おくれて','います'],'Cette horloge retarde un peu.'],
  15:[['北|きた','へ','行く|いく','道|みち','は','どこ','です','か'],'Où est le chemin qui va vers le nord ?'],
  16:[['私|わたし','の','名前|なまえ','を','返して|かえして','ください'],'Rendez-moi mon nom, s\'il vous plaît.'],
  17:[['海|うみ','の','水|みず','は','あまり','冷たく|つめたく','ない','です'],'L\'eau de la mer n\'est pas très froide.'],
  18:[['この','町|まち','で','は','金|きん','を','磨かなければ|みがかなければ','なりません'],'Dans cette ville, il faut faire briller l\'or.']};
 const M=MAPS.world,T=16,walk=(x,y)=>{const r=M.rows[y];if(!r)return false;const c=r[x];return c!==undefined&&!SOLID.includes(c)&&c!=='G'};
 const top=z=>{let y=0;while(y<M.h&&M.zone(y)!==z)y++;return y};
 const ST=[];
 for(const z in P){const t=top(+z),h=HAMS.find(q=>q.z===+z),y1=h?h.y0-4:t+80,q=PUZ.find(p=>p.z===+z),busy=(x,y)=>[...(window.SEALS||[]),...(LOCKS||[])].some(s=>Math.abs(s.x-x)<4&&Math.abs(s.y-y)<4)||(q&&y>=q.top-1&&y<q.top+41);
  let best=null;for(let y=Math.round((t+y1)/2),k=0;k<70&&!best;k++){const yy=y+(k%2?-1:1)*Math.ceil(k/2);if(yy<=t+4||yy>=y1)continue;
   for(let x=2;x<M.w-2;x++){let n=0;for(let a=-1;a<=1;a++)for(let b=-1;b<=1;b++)if(walk(x+a,yy+b))n++;if(n===9&&walk(x,yy+2)&&!busy(x,yy)){best=[x,yy];break}}}
  if(best)ST.push({z:+z,x:best[0],y:best[1],p:P[z]})}
 window.STELES=ST;
 const shuf=a=>{for(let i=a.length-1;i>0;i--){const j=Math.floor(Math.random()*(i+1));[a[i],a[j]]=[a[j],a[i]]}return a};
 const lab=w=>{const[k,r]=tk(w);return k===r?esc(k):`<ruby>${esc(k)}<rt>${esc(r)}</rt></ruby>`};
 async function puzzle(s){const toks=s.p[0],d=MiniUI.open();let order=shuf(toks.map((w,i)=>i));while(order.every((v,i)=>v===i))order=shuf(order);const got=[];
  const draw=msg=>{d.innerHTML=`<h3>La stèle effacée</h3><p class="sub">Remets les mots dans l'ordre. Sens : « ${esc(s.p[1])} »</p>
   <div class="line">${got.map(i=>`<span class="tile" data-b="1">${lab(toks[i])}</span>`).join('')}<span style="font-size:22px">。</span></div>
   <div class="row">${order.map(i=>`<span class="tile ${got.includes(i)?'used':''}" data-i="${i}">${lab(toks[i])}</span>`).join('')}</div>
   <p class="sub">${msg||'Touche un mot pour le placer ; touche la phrase pour retirer le dernier mot.'}</p><div class="row"><button class="btn" data-q="1">Plus tard</button></div>`};
  draw();for(;;){const b=await MiniUI.wait(d,'.tile,[data-q]');if(b.dataset.q){MiniUI.close();return false}
   if(b.dataset.b){got.pop();draw();continue}const i=+b.dataset.i;if(got.includes(i))continue;got.push(i);sfx('tap');
   if(got.length===toks.length){const ok=got.every((v,j)=>toks[v]===toks[j]);if(ok){sfx('right');draw('✓ La phrase est réparée !');say(toks.map(w=>tk(w)[1]).join(''),.85);await wait(1600);MiniUI.close();return true}
    sfx('wrong');draw('Ce n\'est pas tout à fait ça. Regarde où vont les particules (は, が, を, に, で…).');await wait(1400);got.length=0;draw()}else draw()}}
 async function stele(s){const key='st'+s.z;
  if(S.fl[key])return D.say([{jp:s.p[0].concat(['。']),fr:s.p[1]},'La stèle est réparée. Les mots y sont gravés bien droit.']);
  await D.say(["Une vieille stèle de pierre. Les caractères ont été arrachés et recollés n'importe comment, comme par une main pressée.",T_(KG,"Tetsu est passé par là. Il ne vole pas toujours les mots : parfois, il les mélange. C'est presque pire.")]);
  if(await puzzle(s)){S.fl[key]=1;S.gold=(S.gold||0)+30+s.z*5;S.xp=(S.xp||0)+5;save();const n=ST.filter(q=>S.fl['st'+q.z]).length;
   await D.say([{jp:s.p[0].concat(['。']),fr:s.p[1]},`(Stèle réparée : ${n} sur ${ST.length}. Tu gagnes ${30+s.z*5} pièces et 5 XP.)`])}}
 const at=(x,y)=>ST.find(s=>s.x===x&&s.y===y);
 const oS=window.XSOLID;window.XSOLID=(m,x,y)=>(oS&&oS(m,x,y))||(m==='world'&&!!at(x,y));
 const oI=window.XINT;window.XINT=(m,x,y,probe)=>{if(m==='world'){const s=at(x,y);if(s)return probe||(()=>stele(s))}return oI?oI(m,x,y,probe):null};
 const oD=window.XDRAW;window.XDRAW=(m,L,g,X,Y,VW,VH)=>{oD&&oD(m,L,g,X,Y,VW,VH);if(m!=='world')return;
  for(const s of ST){const px=s.x*T-X,py=s.y*T-Y;if(px<-40||px>VW+40||py<-60||py>VH+40)continue;
   L.push({y:(s.y+1)*T,f:()=>{const im=XI.X_STELE;if(im&&im.width){const w=im.width/3,h=im.height/3;g.drawImage(im,px+8-w/2,py+16-h,w,h)}
    else{g.fillStyle='rgba(0,0,0,.25)';g.fillRect(px,py+13,16,3);g.fillStyle='#6e6a62';g.fillRect(px+2,py-10,12,25);g.fillStyle='#8a857b';g.fillRect(px+3,py-9,10,3);g.fillStyle='#57534c';for(let i=0;i<4;i++)g.fillRect(px+5+(i%2)*3,py-4+i*4,3,2)}
    if(!S.fl['st'+s.z]){const k=.5+.5*Math.sin(performance.now()/400+s.z);g.fillStyle=`rgba(150,120,255,${.35*k})`;g.fillRect(px+1,py-11,14,27)}}})}};
})();

/* ---------- Idées 3, 4, 8, 9 : parler pour acheter, chasse aux kanji, pêche aux mots, le festival des érables ---------- */
(()=>{
 const J=(n,jp,fr,x)=>({n,jp,fr,x}),T_=(n,t)=>({n,t}),KA='Kaito',KG='影',TN=NPN.tanu;
 const M=MAPS.world,T=16,walk=(x,y)=>{const r=M.rows[y];if(!r)return false;const c=r[x];return c!==undefined&&!SOLID.includes(c)&&c!=='G'};
 const shuf=a=>{for(let i=a.length-1;i>0;i--){const j=Math.floor(Math.random()*(i+1));[a[i],a[j]]=[a[j],a[i]]}return a};
 const lab=w=>{const[k,r]=tk(w);return k===r?esc(k):`<ruby>${esc(k)}<rt>${esc(r)}</rt></ruby>`};
 const hook=(fS,fI,fD)=>{const oS=window.XSOLID;if(fS)window.XSOLID=(m,x,y)=>(oS&&oS(m,x,y))||fS(m,x,y);const oI=window.XINT;if(fI)window.XINT=(m,x,y,p)=>{const f=fI(m,x,y);if(f)return p||f;return oI?oI(m,x,y,p):null};const oD=window.XDRAW;if(fD)window.XDRAW=(m,L,g,X,Y,VW,VH)=>{oD&&oD(m,L,g,X,Y,VW,VH);fD(m,L,g,X,Y,VW,VH)}};

 /* ===== 3 · Parler pour acheter : la bonne phrase donne une remise ===== */
 const NAME={oni:'おにぎり',cha:'お茶|おちゃ'},CNT={1:['一つ|ひとつ','一本|いっぽん','一枚|いちまい'],2:['二つ|ふたつ','二本|にほん','二枚|にまい'],3:['三つ|みっつ','三本|さんぼん','三枚|さんまい']};
 window.ShopTalk=async(k,q,n)=>{const w=NAME[k]||NAME.oni,c=CNT[q]||CNT[1];
  const good=[w,'を',c[0],'ください','。'],bad1=[w,'が',c[0],'ください','。'],bad2=[w,'を',c[k==='cha'?2:1],'ください','。'];
  const opts=shuf([{jp:good,ok:1},{jp:bad1,ok:0,why:'を marque ce que l\'on demande : おにぎりを… ください.'},{jp:bad2,ok:0,why:'Pour compter des objets ronds ou sans forme précise, on dit 一つ・二つ・三つ. 〜本 sert aux objets longs, 〜枚 aux objets plats.'}]);
  const i=await D.ask({n:n||'Marchande',t:'Comment le demandes-tu ?'},opts.map(o=>({jp:o.jp,fr:''})));const o=opts[i];
  if(o.ok){sfx('right');S.fl.shopOk=(S.fl.shopOk||0)+1;await D.say(J(n||'Marchande',['お上手|おじょうず','です','ね','！'],'Vous parlez bien !','お上手 (おじょうず) = habile (compliment)')).then(()=>D.say({n:n||'Marchande',t:'Pour une demande aussi bien tournée, je te fais un dixième de moins.'}));return .9}
  sfx('wrong');await D.say([{n:n||'Marchande',t:'… Je crois comprendre ce que tu veux. Mais ça ne se dit pas comme ça.'},{jp:good,fr:'La bonne phrase.',x:o.why}]);return 1};

 /* ===== 4 · Chasse aux kanji : 5 plaques par bourg, sur les maisons ===== */
 const KH=[],N5K='一二三四五六七八九十上下左右中山川田花空日月年今時天気雨白外食飲見行来火水木金土家店駅国社学校先生語円百千万買男女子父母口目耳手足大小高安新東西南北道人友名本会車電出入休前後間半午曜毎週分何書読聞話言古長多少立',uk=new Set(),uw=new Set(),kj=w=>tk(w[0])[0].match(/[一-鿿]/g)||[],okW=w=>kj(w).every(c=>N5K.includes(c)),
 VW=VDECKS.flatMap(d=>d.w).concat(...Object.values(VOC).filter(Boolean)).filter(w=>w&&w[0]),pick=(c,L,r)=>L.find(w=>!uw.has(w[0])&&kj(w).includes(c)&&(r||okW(w))),O={気:['元気|げんき','en forme'],三:['三つ|みっつ','trois (objets)'],語:['日本語|にほんご','le japonais']};
 for(const h of HAMS){const L=(VOC[h.z]||[]).concat(VOC[h.z-1]||[]),ks=[...new Set(L.flatMap(kj))].filter(c=>N5K.includes(c)).concat([...N5K]);
  const B=(M.bld||[]).filter(b=>b.k==='h'&&b.y>=h.y0&&b.y<=h.y1&&String(b.im).startsWith('X_V_')&&!(M.warps||[]).some(w=>w.x>=b.x&&w.x<b.x+b.w&&w.y>=b.y&&w.y<=b.y+b.h));let n=0;
  for(const b of B.sort((a,c)=>(a.x*31+a.y*17)%23-(c.x*31+c.y*17)%23)){if(n>=6)break;const x=b.x+1,y=b.y+b.h-1;
   if(!walk(x,y+1)||(M.warps||[]).some(q=>q.x===x&&q.y===y)||KH.some(q=>q.x===x&&q.y===y))continue;let k,w;for(const c of ks){if(uk.has(c))continue;w=O[c]&&!uw.has(O[c][0])?O[c]:pick(c,L)||pick(c,VW)||pick(c,VW,1);if(w){k=c;break}}if(!k)break;
   uk.add(k);uw.add(w[0]);KH.push({z:h.z,x,y,k,w,id:'kh'+h.z+'_'+n});n++}}
 window.KHUNT=KH;
 const khAt=(x,y)=>KH.find(q=>q.x===x&&q.y===y);
 async function capture(q){if(!S.kh)S.kh={};const[wk,wr]=tk(q.w[0]);
  if(S.kh[q.k])return D.say([{jp:[q.w[0]],fr:q.w[1]},`Le kanji 「${q.k}」 est déjà dans ton carnet.`]);
  S.kh[q.k]=q.z;S.xp=(S.xp||0)+2;sfx('item');save();say(wr,.9);
  await D.say([`Sur le noren de la maison, un kanji brodé : 「${q.k}」.`,{jp:[q.w[0]],fr:q.w[1],x:`${wk} (${wr}) = ${q.w[1]}`},`(Kanji trouvés en ville : ${KH.filter(q=>S.kh[q.k]).length} sur ${KH.length}. +2 XP.)`])}
 hook(null,(m,x,y)=>{if(m!=='world')return null;const q=khAt(x,y);return q?()=>capture(q):null},(m,L,g,X,Y,VW,VH)=>{if(m!=='world')return;const tt=performance.now()/1000;
  for(const q of KH){const px=q.x*T-X,py=q.y*T-Y;if(px<-30||px>VW+30||py<-30||py>VH+30)continue;const got=S.kh&&S.kh[q.k];
   L.push({y:(q.y+1)*T+.6,f:()=>{const KP=XI.X_KHPLAQ,kpOk=KP&&KP.width;if(kpOk){g.globalAlpha=got?.8:1;g.drawImage(KP,px+8.5-KP.width/6,py+7-KP.height/3,KP.width/3,KP.height/3);g.globalAlpha=1}else{g.fillStyle='#3a2414';g.fillRect(px+2,py-9,13,15);g.fillStyle=got?'#c8b890':'#efe2c2';g.fillRect(px+3,py-8,11,13)}
    g.fillStyle='#7a1a14';g.font='bold 10px "Hiragino Mincho ProN","Yu Mincho","Noto Serif JP",serif';g.textAlign='center';g.textBaseline='middle';if(kpOk)g.font='bold 9px "Hiragino Mincho ProN","Yu Mincho","Noto Serif JP",serif';g.fillText(q.k,px+8.5,kpOk?py-4:py-1);g.textAlign='left';
    if(!got){const k=.5+.5*Math.sin(tt*3+q.x);g.fillStyle=`rgba(255,230,120,${.35*k})`;g.fillRect(px+1,py-10,15,17)}}})}});

 /* ===== 8 · La pêche aux mots ===== */
 const FISHZ=[1,2,8,9,13,14],FISH=[['鮒|ふな','carassin',10],['鮎|あゆ','ayu',15],['鯉|こい','carpe koï',25],['鯰|なまず','poisson-chat',35],['金の鯉|きんのこい','koï dorée',120]];
 const SP_=[];const top=z=>{let y=0;while(y<M.h&&M.zone(y)!==z)y++;return y};
 for(const z of FISHZ){const t=top(z),h=HAMS.find(q=>q.z===z),y1=h?h.y0:t+120;let best=null;
  for(let k=0;k<200&&!best;k++){const y=Math.round((t+y1)/2)+(k%2?-1:1)*Math.ceil(k/2);if(y<=t+3||y>=y1)continue;
   for(let x=2;x<M.w-2&&!best;x++){if(!walk(x,y))continue;for(const[a,b]of[[0,-1],[-1,0],[1,0]]){const r=M.rows[y+b];if(r&&r[x+a]==='~'&&walk(x,y+1)&&walk(x-1,y)+walk(x+1,y)+walk(x,y+1)>=2){best={z,x,y,wx:x+a,wy:y+b};break}}}}
  if(best)SP_.push(best)}
 window.FISHSP=SP_;
 const fAt=(x,y)=>SP_.find(s=>s.wx===x&&s.wy===y);
 async function fish(s){if(!S.fish)S.fish={};
  if(!S.fl.fish0){S.fl.fish0=1;await D.say(["Une vieille canne à pêche est posée contre un piquet, avec un seau et des vers. Un mot est gravé sur le manche : 釣り (つり), la pêche.",T_(TN,"Ici, les poissons mordent aux mots. Quand ça mord, dis vite ce que veut dire le mot, sinon il file.")])}
  const pool=[];for(let k=1;k<=s.z;k++)if(VOC[k])pool.push(...VOC[k]);if(pool.length<3)return;const d=MiniUI.open();
  d.innerHTML=`<h3>釣り · La pêche aux mots</h3><p class="sub">Tu lances ta ligne… attends que ça morde.</p><div class="big">〜〜〜 ◦ 〜〜〜</div>`;
  await wait(1400+Math.random()*2200);const rare=Math.random()<.08,w=pool[Math.floor(Math.random()*pool.length)],opts=shuf([w[1],...shuf(pool.filter(v=>v[1]!==w[1])).slice(0,2).map(v=>v[1])]);
  sfx('alert');d.innerHTML=`<h3>Ça mord !</h3><p class="sub">Que veut dire ce mot ? Vite !</p><div class="big">${lab(w[0])}</div><div class="bar"><i id="fbar" style="width:100%"></i></div>
   <div class="row">${opts.map((o,i)=>`<button class="btn" data-i="${i}">${esc(o)}</button>`).join('')}</div>`;
  const lim=(rare?3500:5000)+(window.OMHAS&&OMHAS('tsuri')?2000:0),t0=performance.now(),iv=setInterval(()=>{const b=document.getElementById('fbar');if(b)b.style.width=Math.max(0,100-(performance.now()-t0)/lim*100)+'%'},50);
  const r=await Promise.race([MiniUI.wait(d,'[data-i]').then(b=>+b.dataset.i),wait(lim).then(()=>-1)]);clearInterval(iv);d.onclick=null;
  let got=null;if(r>=0&&opts[r]===w[1]){const idx=rare?4:Math.min(3,Math.floor(Math.random()*(s.z>=8?4:3)));got=FISH[idx]}
  if(got){sfx('item');S.fish[got[1]]=(S.fish[got[1]]||0)+1;S.gold=(S.gold||0)+got[2];if(rare)S.it.hagane=(S.it.hagane||0)+1;save();
   d.innerHTML=`<h3>Pris !</h3><div class="big">${lab(got[0])}</div><p class="sub">Un ${esc(got[1])} ! ${lab(w[0])} = ${esc(w[1])}.<br>Tu le vends ${got[2]} pièces${rare?' et tu trouves un morceau d\'acier de kiryoku dans son ventre':''}.</p><button class="btn" data-q="1">Continuer</button>`}
  else{sfx('wrong');d.innerHTML=`<h3>Il s'est échappé…</h3><p class="sub">${lab(w[0])} = ${esc(w[1])}</p><button class="btn" data-q="1">Continuer</button>`}
  await MiniUI.wait(d,'[data-q]');MiniUI.close()}
 hook(null,(m,x,y)=>{if(m!=='world')return null;const s=fAt(x,y);return s?()=>fish(s):null},(m,L,g,X,Y,VW,VH)=>{if(m!=='world')return;const tt=performance.now()/1000;
  for(const s of SP_){const px=s.x*T-X,py=s.y*T-Y;if(px<-40||px>VW+40||py<-40||py>VH+40)continue;
   L.push({y:(s.y+1)*T-2,f:()=>{const im=XI.X_FISHSP;if(im&&im.width){const w=im.width/3,h=im.height/3;g.drawImage(im,px+8-w/2,py+16-h,w,h);return}
    g.fillStyle='#5a3a22';g.fillRect(px+3,py-6,2,20);g.strokeStyle='#8a6a3a';g.lineWidth=1;g.beginPath();g.moveTo(px+4,py-6);g.lineTo(px+4+(s.wx-s.x)*14,py-12+(s.wy-s.y)*10);g.stroke();
    g.fillStyle='#6a6a70';g.fillRect(px+8,py+8,6,6);const bx=(s.wx*T+8)-X,by=(s.wy*T+9)-Y+Math.sin(tt*2)*1.2;g.fillStyle='#e04030';g.fillRect(bx-1,by-1,3,3)}})}});

 /* ===== 9 · Le festival des érables, au relais (bourg 7), une seule fois dans le jeu ===== */
 const H7=HAMS.find(h=>h.z===7),inV=(y)=>H7&&y>=H7.y0&&y<=H7.y1;
 const fest=()=>S.fl.matsuri===1;
 const inB=(x,y)=>(M.bld||[]).some(q=>x>=q.x&&x<q.x+q.w&&y>=q.y-1&&y<q.y+q.h),near=(x,y)=>{for(let r=0;r<6;r++)for(let a=-r;a<=r;a++)for(let b=-r;b<=r;b++)if(walk(x+a,y+b)&&walk(x+a,y+b+1)&&!inB(x+a,y+b))return[x+a,y+b];return[x,y]};
 const STALL=H7?[{id:'m1',spr:'yatai',p:near(H7.px-5,H7.py),nm:'Stand de tir',k:'shoot'},{id:'m2',spr:'fishw',p:near(H7.px+5,H7.py),nm:'Pêche aux poissons rouges',k:'kingyo'},{id:'m3',spr:'pilgrim',p:near(H7.px,H7.py+3),nm:'Prêtresse des omikuji',k:'omikuji'}].map(s=>Object.assign(s,{x:s.p[0],y:s.p[1]})):[];
 for(const s of STALL){NPCS.world.push({id:s.id,spr:s.spr,x:s.x,y:s.y,dir:0,wander:0,ev:'matsuri',mk:s.k,nm:s.nm,cond:()=>fest()});PORT[s.nm]=PORT[s.nm]||'PX_'+s.spr}
 const KANA='あいうえおかきくけこさしすせそたちつてとなにぬねのはひふへほまみむめもやゆよらりるれろわをん'.split('');
 async function shoot(){const d=MiniUI.open();let sc=0;
  for(let r=0;r<6;r++){const k=KANA[Math.floor(Math.random()*KANA.length)],o=shuf([k,...shuf(KANA.filter(c=>c!==k)).slice(0,3)]);
   d.innerHTML=`<h3>射的 · Le tir aux kana</h3><p class="sub">Écoute le son, puis vise la bonne cible. Manche ${r+1} / 6 · Score ${sc}</p><div class="big">${S.snd?'🔊':esc(RM&&RM[k]?RM[k]:k)}</div>
    <div class="row">${o.map((c,i)=>`<button class="tile" data-i="${i}" style="border-radius:50%;width:66px;height:66px;font-size:30px;background:#fff;border:5px solid #d8432a">${c}</button>`).join('')}</div><div class="row"><button class="btn" data-s="1">Réécouter</button></div>`;
   await wait(300);say(k,.8);let b;for(;;){b=await MiniUI.wait(d,'[data-i],[data-s]');if(b.dataset.s){say(k,.8);continue}break}
   if(o[+b.dataset.i]===k){sc++;sfx('hit')}else sfx('wrong');await wait(250)}
  MiniUI.close();return sc}
 async function kingyo(){const d=MiniUI.open();let sc=0;const pool=[];for(let k=1;k<=7;k++)if(VOC[k])pool.push(...VOC[k]);
  for(let r=0;r<5;r++){const w=pool[Math.floor(Math.random()*pool.length)],o=shuf([w,...shuf(pool.filter(v=>v[1]!==w[1])).slice(0,3)]);
   d.innerHTML=`<h3>金魚すくい · Les poissons rouges</h3><p class="sub">Attrape le poisson qui porte le mot « ${esc(w[1])} ». Manche ${r+1} / 5 · Score ${sc}</p>
    <div class="row" style="background:#1e4a6a;border-radius:14px;padding:16px 8px;width:94%">${o.map((v,i)=>`<button class="tile" data-i="${i}" style="background:#ff7a3a;color:#fff;border:3px solid #fff;border-radius:40px 10px 10px 40px;animation:shk ${1.6+i*.3}s infinite">${lab(v[0])}</button>`).join('')}</div>`;
   const b=await Promise.race([MiniUI.wait(d,'[data-i]'),wait(7000).then(()=>null)]);d.onclick=null;
   if(b&&o[+b.dataset.i]===w){sc++;sfx('right')}else sfx('wrong');await wait(250)}
  MiniUI.close();return sc}
 const OMI=[['大吉|だいきち','Grande chance !',['明日|あした','は','いい','日|ひ','です','。'],'Demain sera une bonne journée.'],['中吉|ちゅうきち','Chance moyenne.',['友達|ともだち','に','会います|あいます','。'],'Tu vas rencontrer un ami.'],['小吉|しょうきち','Petite chance.',['雨|あめ','に','気をつけて|きをつけて','。'],'Fais attention à la pluie.'],['吉|きち','Chance.',['道|みち','は','長い|ながい','です','が','、','大丈夫|だいじょうぶ','です','。'],'La route est longue, mais tout ira bien.'],['末吉|すえきち','Chance à venir.',['少し|すこし','待って|まって','ください','。'],'Attends encore un peu.']];
 async function omikuji(){const o=OMI[Math.floor(Math.random()*OMI.length)];sfx('item');
  await D.say(["Tu secoues la boîte hexagonale. Un bâtonnet tombe, avec un numéro. La prêtresse te tend le papier correspondant.",{jp:[o[0]],fr:o[1]},{jp:o[2],fr:o[3]}]);
  await D.say([T_(KG,"Si c'est une mauvaise fortune, on l'attache à une branche et on la laisse là. Si c'est une bonne, on la garde. Moi, je les garde toutes. On ne sait jamais.")]);return 3}
 STORY.matsuri=async e=>{const k=e.mk,key='mk_'+k;
  if(S.fl[key])return D.say(T_(e.nm,"Tu as déjà gagné ici ! Laisse un peu de chance aux autres."));
  const intro={shoot:J('Stand de tir',['一回|いっかい','どうぞ','！'],'Une partie, je vous en prie !','一回 (いっかい) = une fois'),kingyo:J('Pêche aux poissons rouges',['金魚|きんぎょ','を','すくって','ください','！'],'Attrapez un poisson rouge !','金魚 (きんぎょ) = poisson rouge'),omikuji:J('Prêtresse des omikuji',['おみくじ','を','引きます|ひきます','か','。'],'Vous tirez un omikuji ?','引きます (ひきます) = tirer')}[k];
  await D.say(intro);if(await D.ask('Jouer ?',['Oui','Non'])!==0)return;
  const F2=window.FEST2,sc=k==='shoot'?await (F2?F2.shoot(KANA):shoot()):k==='kingyo'?await (F2?F2.kingyo():kingyo()):await (F2?F2.omikuji(OMI):omikuji()),need=k==='shoot'?4:k==='kingyo'?3:0;
  if(sc>=need){S.fl[key]=1;S.gold=(S.gold||0)+40;sfx('lvl');await D.say(`(Réussi ! ${k==='omikuji'?'':'Score : '+sc+'. '}Tu gagnes 40 pièces.)`)}else return D.say(`(Score : ${sc}. Il en fallait ${need}. Retente ta chance !)`);
  if(S.fl.mk_shoot&&S.fl.mk_kingyo&&S.fl.mk_omikuji){S.fl.matsuri=2;S.fl.yukata=1;S.fl.yukataOn=1;save();
   await D.say(["Les trois stands te font une petite ovation. La vieille aubergiste sort une tenue pliée dans du papier de soie.",J('Aubergiste',['浴衣|ゆかた','を','どうぞ','。'],'Voici un yukata, je vous en prie.','浴衣 (ゆかた) = kimono léger d\'été'),"(Tu reçois un yukata de fête. Tu peux le mettre ou l'enlever dans les Options.)",T_(TN,"Il te va bien ! Presque aussi bien qu'à moi. Presque."),"Les lanternes s'éteignent une à une. Le festival des érables est fini, jusqu'à l'année prochaine."]);W.setNight(0)}save()};
 /* déclenchement : la première fois qu'on entre au relais */
 const oT=STORY.triggers;STORY.triggers=(x,y)=>{if(W.map==='world'&&!S.fl.noscn&&!S.fl.matsuri&&inV(y)&&S.fl.ac7)return async()=>{S.fl.matsuri=1;save();W.setNight(1);
   await D.say(["Des lanternes rouges courent d'un toit à l'autre. Des tambours résonnent sur la place. Ce soir, c'est la fête des érables !",T_(TN,"Un matsuri ! Tir aux cibles, poissons rouges, omikuji… Fais les trois stands de la place : il paraît qu'il y a un cadeau pour qui les réussit tous."),J(KA,['お祭り|おまつり','です','ね','！'],'C\'est un festival !','お祭り (おまつり) = festival')]);{const H=W.H;W.load('world',H.x,H.y,H.dir)}W.refreshZone()};return oT(x,y)};
 /* la nuit de fête ne dure que dans le bourg */
 let wasIn=false;const oSt=W.step;W.step=dt=>{const r=oSt(dt);if(W.map==='world'&&fest()){const i=inV(W.H.y);if(i!==wasIn){wasIn=i;W.setNight(i?1:0)}}return r};
 hook(null,null,(m,L,g,X,Y,VW,VH)=>{if(m!=='world'||!fest())return;STALL.forEach((s,i)=>{const im=XI['X_STALL'+i];if(!im||!im.width)return;const k=.8,w=im.width/3*k,h=im.height/3*k,px=s.x*T+8-X,py=(s.y+1)*T-Y-2;if(px<-60||px>VW+60||py<-120||py>VH+60)return;
   L.push({y:(s.y+1)*T-.5,f:()=>g.drawImage(im,px-w/2,py-h,w,h)})})});
 hook(null,null,(m,L,g,X,Y,VW,VH)=>{if(m!=='world'||!fest()||!H7||window.FESTV2)return;const tt=performance.now()/1000;
  L.push({y:1e9,f:()=>{for(let r=0;r<3;r++){const yy=(H7.py-6+r*5)*T-Y;if(yy<-20||yy>VH+20)continue;g.strokeStyle='rgba(40,20,10,.7)';g.beginPath();for(let x=-20;x<VW+20;x+=8){const xx=x,y2=yy+Math.sin((x+X)/40)*6;x===-20?g.moveTo(xx,y2):g.lineTo(xx,y2)}g.stroke();
    for(let x=((-X)%32+32)%32-16;x<VW+16;x+=32){const y2=yy+Math.sin((x+X)/40)*6+4,k=.75+.25*Math.sin(tt*3+(x+X)*.37);const li=((Math.floor((x+X)/32)%3)+3)%3,im=XI['X_FEST'+li];(window.FESTL||(window.FESTL=[])).push([x,y2+7,li,x+X]);const col=['255,110,60','255,200,90','255,170,110'][li];{const gr=g.createRadialGradient(x,y2+6,1,x,y2+6,16*k);gr.addColorStop(0,`rgba(${col},${.55*k})`);gr.addColorStop(1,`rgba(${col},0)`);g.fillStyle=gr;g.fillRect(x-17,y2-11,34,34)}if(im&&im.width){const w=im.width/3,h=im.height/3;g.drawImage(im,Math.round(x-w/2),Math.round(y2),w,h)}else{g.fillStyle=li?'#f0d040':'#e8402a';g.beginPath();g.ellipse(x,y2+4,4,5,0,0,7);g.fill()}}}}})});
})();

/* ---------- Idées 6, 7, 10, 11, 12 : furigana à trois niveaux, carnet de yōkai et yōkai rares,
   forge d'équipement, voyage rapide, succès. Et le karuta dans le menu Jeux. ---------- */
(()=>{
 const J=(n,jp,fr,x)=>({n,jp,fr,x}),T_=(n,t)=>({n,t}),KG='影';
 /* l'acier de kiryoku, le matériau de la forge */
 IT.hagane={n:'Acier de kiryoku',t:['鋼|はがね'],heal:0,map:1,d:'Un acier qui garde la mémoire des mots. La forgeronne s\'en sert pour améliorer ton équipement.'};
 if(typeof S.furi==='boolean')S.furi=S.furi?1:0;
 /* ===== 7 · yōkai rares : une chance sur 25, plus forts, dorés, et ils rapportent gros ===== */
 const oW=STORY.wildDef;STORY.wildDef=(z,kind)=>{const d=oW(z,kind);if(!S.fl.visit&&Math.random()<.04){d.rare=1;d.n='★ '+d.n+' doré';d.hp=Math.round(d.hp*1.3);d.xp=d.xp*3;d.gold=(d.gold||8+d.lv)*4;setTimeout(()=>UI.toast('Un yōkai rare ! Il brille comme de l\'or.',2600),900)}return d};
 const oWin=Quests.onWin;Quests.onWin=def=>{oWin(def);if(def&&def.rare){const k=def.kind&&def.kind.s||'x';S.fl['r_'+k]=1;S.fl.rares=(S.fl.rares||0)+1;S.it.hagane=(S.it.hagane||0)+1;UI.toast('Yōkai rare vaincu ! +1 acier de kiryoku',2600)}};
 /* ===== 10 · la forge : sabre et armure, cinq niveaux chacun ===== */
 window.Forge={lvl:k=>((S.eq||{})[k]||0),cost:l=>[(l+1),(l+1)*120],
  async up(n){if(!S.eq)S.eq={s:0,a:0};
   for(;;){const s=S.eq.s||0,a=S.eq.a||0,cs=this.cost(s),ca=this.cost(a),h=S.it.hagane||0;
    const i=await D.ask({n,t:`Acier de kiryoku : ${h} · ${S.gold||0} pièces. Sabre niveau ${s}/5, armure niveau ${a}/5.`},[
     s<5?`Sabre → niveau ${s+1} (${cs[0]} acier, ${cs[1]} pièces) : +10 % de dégâts`:'Sabre : niveau maximum',
     a<5?`Armure → niveau ${a+1} (${ca[0]} acier, ${ca[1]} pièces) : −7 % de dégâts reçus`:'Armure : niveau maximum','Rien, merci']);
    if(i>1)return;const k=i?'a':'s',l=S.eq[k]||0;if(l>=5){await D.say({n,t:'On ne peut pas faire mieux. Même moi.'});continue}
    const c=this.cost(l);if(h<c[0]||(S.gold||0)<c[1]){await D.say([J(n,['足りません|たりません','よ','。'],'Ça ne suffit pas.','足りません (たりません) = ne pas suffire'),{n,t:'L\'acier de kiryoku se trouve dans les donjons, les trésors scellés, chez les champions de karuta, et parfois dans le ventre des poissons. Ou sur les yōkai dorés.'}]);continue}
    S.it.hagane-=c[0];S.gold-=c[1];S.eq[k]=l+1;sfx('lvl');save();
    if(!S.fl.hg_tetsu){S.fl.hg_tetsu=1;await D.say([{n,t:"Tu sais d'où il vient, cet acier de kiryoku ? Des donjons de Tetsu. De ses coffres. De ses machines."},{n,t:"Il ne le sait pas encore, mais il me fait des cadeaux depuis des mois. C'est l'homme le plus généreux du pays. Contre son gré."}])}
    await D.say([J(n,['できました','！'],'C\'est prêt !','できました = c\'est fait, c\'est prêt'),i?'L\'armure est plus souple et plus solide à la fois. Elle sent encore la forge.':'La lame a pris un reflet bleuté. Quand tu la tiens, tu entends presque des mots.'])}}};
 /* ===== 6 · furigana à trois niveaux ===== */
 const FL=['Jamais (touche un kanji pour voir sa lecture)','Seulement pour les kanji pas encore maîtrisés','Toujours'];
 /* ===== 12 · les succès ===== */
 const cnt=o=>Object.keys(o||{}).length,flN=p=>Object.keys(S.fl).filter(k=>k.startsWith(p)&&S.fl[k]).length;
 const ACH=[
  ['k1','Premier trait','Tracer ton premier kanji.',()=>cnt(S.sp)>=1],
  ['k50','Pinceau habile','Apprendre 50 kanji.',()=>cnt(S.sp)>=50],
  ['kh25','Œil de lynx','Trouver 25 kanji sur les maisons des bourgs.',()=>(window.KHUNT||[]).filter(q=>S.kh&&S.kh[q.k]).length>=25],
  ['khall','Toute la ville en kanji','Trouver tous les kanji des bourgs.',()=>window.KHUNT&&KHUNT.length&&KHUNT.filter(q=>S.kh&&S.kh[q.k]).length>=KHUNT.length],
  ['st10','Restaurateur','Réparer 10 stèles effacées.',()=>flN('st')>=10],
  ['kar1','Première carte','Gagner une partie de karuta contre un champion.',()=>!!(S.fl.kc1||S.fl.kc2||S.fl.kc3)],
  ['kar3','Champion de karuta','Battre les trois champions de karuta.',()=>!!(S.fl.kc1&&S.fl.kc2&&S.fl.kc3)],
  ['karp','Sans faute','Gagner une partie de karuta sans une erreur.',()=>!!S.fl.karPerfect],
  ['shop5','Client modèle','Bien demander 5 fois à la boutique.',()=>(S.fl.shopOk||0)>=5],
  ['sign','Lecteur rapide','Faire 4 sur 4 aux panneaux du train ou du bac.',()=>!!S.fl.signs4],
  ['fish10','Pêcheur de mots','Attraper 10 poissons.',()=>Object.values(S.fish||{}).reduce((a,b)=>a+b,0)>=10],
  ['koi','La koï dorée','Attraper la koï dorée.',()=>!!(S.fish&&S.fish['koï dorée'])],
  ['mat','Fête des érables','Réussir les trois stands du festival.',()=>S.fl.matsuri===2],
  ['pz','Débrouillard','Résoudre 10 énigmes de route.',()=>flN('pz')-flN('pzs')-flN('pzg')-flN('pzh')>=10],
  ['lk','Polyglotte du péage','Ouvrir 10 verrous de langue.',()=>flN('lk')>=10],
  ['sc','Chasseur de trésors','Ouvrir 10 trésors scellés.',()=>flN('sc')>=10],
  ['sh','Raccourcis','Ouvrir 5 raccourcis.',()=>flN('sh')>=5],
  ['dj1','Spéléologue','Terminer un donjon.',()=>flN('djdone')>=1],
  ['dj3','Maître des profondeurs','Terminer les trois donjons.',()=>flN('djdone')>=3],
  ['ghost','Fantôme','Traverser la salle d\'un yōkai sans te faire voir.',()=>!!S.fl.ghost],
  ['rare','Reflet d\'or','Vaincre un yōkai rare.',()=>(S.fl.rares||0)>=1],
  ['be','Encyclopédiste','Rencontrer 40 sortes de yōkai.',()=>flN('s_')>=40],
  ['eq','Lame de légende','Monter le sabre au niveau 5.',()=>((S.eq||{}).s||0)>=5],
  ['rich','Bourse pleine','Avoir 2000 pièces.',()=>(S.gold||0)>=2000]];
 window.ACHIEV=ACH;
 let acc=0;const oSt=W.step;W.step=dt=>{const r=oSt(dt);acc+=dt;if(acc>3&&!G.busy){acc=0;if(!S.ach)S.ach={};for(const a of ACH){if(S.ach[a[0]])continue;let ok=false;try{ok=a[3]()}catch(e){}if(ok){S.ach[a[0]]=1;save();sfx('lvl');UI.toast(`🏆 Succès : ${a[1]}`,3200);break}}}return r};
 /* « fantôme » : passer la salle du yōkai sans être repoussé */
 {const oA=window.XARR;let cleanRoom=null;window.XARR=(m,x,y,run)=>{const r=oA?oA(m,x,y,run):false;if(m&&m.startsWith&&m.startsWith('dj')){const d=DJ[m.slice(2)],ri=d.O.rooms.findIndex(q=>y>=q.y0&&y<=q.y1),rm=d.O.rooms[ri];
   if(rm&&rm.k.startsWith('sneak')){if(y===rm.y1)cleanRoom=ri;else if(y===rm.y0&&cleanRoom===ri){S.fl.ghost=1}}}return r};
  const oI=window.XINT;}
 /* ===== 11 · voyage rapide ===== */
 const BN=z=>(window.BOURGCARD&&BOURGCARD[z]?BOURGCARD[z][1]:'Bourg '+z);
 const canGo=z=>S.fl['ac'+z]&&HAMS.find(h=>h.z===z)&&!(typeof PART!=='undefined'&&((PART===34&&(z<12||z>16))||(PART===4&&z<17)||(PART===12&&z>11)));
 /* pages du menu */
 const oAfter=Extra.after;Extra.after=tab=>{oAfter(tab);const b=$('#mBody');if(!b)return;let h='';
  if(tab==='ca'){const zs=[];for(let z=2;z<=18;z++)if(canGo(z))zs.push(z);
   h=`<div class="sw" style="border:0;padding:10px 0 4px"><span>Voyage rapide</span></div><p style="font-size:12px;color:var(--sub);margin:0 0 6px">La diligence, le bac, le train et le dirigeable te ramènent dans un bourg que tu as déjà visité.</p>`+
    `<div class="mi"><div class="k" style="color:var(--gold)">賞</div><div class="t"><b>Salle des trophées</b>La maison de Kaito, où s'exposent tes collections.</div><button class="go" data-tro="1">Y aller</button></div>`+(zs.length?zs.map(z=>`<div class="mi"><div class="k" style="color:var(--cy)">${z}</div><div class="t"><b>${esc(BN(z))}</b>${window.repLvl?`<br><small>Réputation : ${['inconnu','apprécié ★','héros du bourg ★★'][repLvl(z)]} (${repPts(z)} pts)</small>`:''}</div><button class="go" data-ft="${z}">Y aller</button></div>`).join(''):'<p style="font-size:12px;color:var(--sub)">Aucun bourg visité pour l\'instant.</p>')}
  if(tab==='ge')h=`<div class="mi"><div class="k" style="color:var(--cy)">札</div><div class="t"><b>Le karuta</b>Écoute un mot et touche sa carte avant ton adversaire. Les champions t'attendent dans trois bourgs.</div><button class="go" data-kar="1">Jouer</button></div>`;
  if(tab==='op')h=`<div class="sw"><span>Furigana</span><button data-furi="1" class="on">${S.furi===2?'Toujours':S.furi?'Kanji non maîtrisés':'Jamais'}</button></div><p style="font-size:12px;color:var(--sub);margin:-2px 0 6px">${FL[S.furi===2?2:S.furi?1:0]}</p>`+(S.fl.yukata?`<div class="sw"><span>Yukata de fête</span><button data-yuk="1" class="${S.fl.yukataOn?'on':''}">${S.fl.yukataOn?'Oui':'Non'}</button></div>`:'')+(S.fl.legend?`<div class="sw"><span>Tenue de légende</span><button data-leg="1" class="${S.fl.legendOn?'on':''}">${S.fl.legendOn?'Oui':'Non'}</button></div>`:'');
  if(tab==='bi'){const n=ACH.filter(a=>(S.ach||{})[a[0]]).length;
   h=`<div class="sw" style="border:0;padding:10px 0 4px"><span>Succès · ${n} / ${ACH.length}</span></div>`+ACH.map(a=>{const ok=(S.ach||{})[a[0]];return `<div class="mi ${ok?'':'lock'}"><div class="k" style="font-size:22px;color:${ok?'var(--gold)':'var(--sub)'}">${ok?'🏆':'・'}</div><div class="t"><b>${esc(a[1])}</b>${esc(a[2])}</div></div>`}).join('')}
  if(tab==='be'){const F=S.fish||{},kh=(window.KHUNT||[]).filter(q=>S.kh&&S.kh[q.k]).map(q=>q.k),st=(window.STELES||[]).filter(s=>S.fl['st'+s.z]).length,sc=(window.SEALS||[]).filter(s=>S.fl[s.id]).length,rr=Object.keys(S.fl).filter(k=>k.startsWith('r_')).length;
   h=`<div class="sw" style="border:0;padding:10px 0 4px"><span>Collections</span></div>
    <div class="mi"><div class="k" style="color:var(--gold)">★</div><div class="t"><b>Yōkai dorés vaincus · ${rr}</b>Une chance sur 25 de croiser un yōkai doré sur les routes.</div></div>
    <div class="mi"><div class="k" style="color:var(--cy)">字</div><div class="t"><b>Kanji des bourgs · ${kh.length} / ${(window.KHUNT||[]).length}</b>${kh.join(' ')||'Cherche les plaques brodées sur les maisons.'}</div></div>
    <div class="mi"><div class="k" style="color:var(--cy)">魚</div><div class="t"><b>Poissons</b>${Object.keys(F).length?Object.entries(F).map(([k,v])=>`${esc(k)} × ${v}`).join(' · '):'Pas encore de prise.'}</div></div>
    <div class="mi"><div class="k" style="color:var(--cy)">材</div><div class="t"><b>Butins des yōkai</b>${Object.entries(window.RPGMAT||{}).map(([z,m])=>`${tk(m[0])[0]} ${esc(m[1])} : ${S.it['m'+z]||0} <small>(${z})</small>`).join(' · ')}</div></div>
    <div class="mi"><div class="k" style="color:var(--cy)">碑</div><div class="t"><b>Stèles réparées · ${st} / ${(window.STELES||[]).length}</b></div></div>
    <div class="mi"><div class="k" style="color:var(--cy)">宝</div><div class="t"><b>Trésors scellés · ${sc} / ${(window.SEALS||[]).length}</b></div></div>`}
  if(h)b.insertAdjacentHTML(tab==='op'||tab==='bi'?'afterbegin':'beforeend',h)};
 document.addEventListener('click',async e=>{const b=e.target.closest&&e.target.closest('#mBody [data-ft],#mBody [data-kar],#mBody [data-furi],#mBody [data-yuk],#mBody [data-leg],#mBody [data-tro]');if(!b)return;e.stopPropagation();e.preventDefault();
  if(b.dataset.furi){S.furi=S.furi===2?0:S.furi===1?2:1;save();sfx('tap');$('#mTabs button.on')&&$('#mTabs button.on').click();return}
  if(b.dataset.leg){S.fl.legendOn=S.fl.legendOn?0:1;if(S.fl.legendOn)S.fl.yukataOn=0;save();sfx('tap');$('#mTabs button.on')&&$('#mTabs button.on').click();return}
  if(b.dataset.tro){Menu.close();await wait(200);return goTrophies()}
  if(b.dataset.yuk){S.fl.yukataOn=S.fl.yukataOn?0:1;save();sfx('tap');$('#mTabs button.on')&&$('#mTabs button.on').click();return}
  if(b.dataset.kar){const r=await Karuta.play({ai:1,who:'Partie libre'});if(r&&r.win){S.xp=(S.xp||0)+3;save();UI.toast('Victoire ! +3 XP',2000)}return}
  if(b.dataset.ft){const z=+b.dataset.ft,h=HAMS.find(q=>q.z===z);if(W.map!=='world'||!h){UI.toast('Sors d\'abord à l\'air libre.',2000);return}
   Menu.close();await wait(200);G.busy=true;await UI.fade(1,400);sfx('door');W.load('world',h.px,h.py+1,0);W.H.cd=2;W.refreshZone();await UI.fade(0,400);G.busy=false;UI.toast(`Arrivée : ${BN(z)}`,2200)}},true);
})();

/* ---------- Le côté RPG : butins et artisanat, omamori, pierres de kanji, cuisine, rangs de samouraï,
   salle des trophées, techniques de Tanuki et de Kage, réputation des bourgs, arène des yōkai ---------- */
(()=>{
 const J=(n,jp,fr,x)=>({n,jp,fr,x}),T_=(n,t)=>({n,t}),KA='Kaito',KG='影',TN=NPN.tanu;
 const shuf=a=>{for(let i=a.length-1;i>0;i--){const j=Math.floor(Math.random()*(i+1));[a[i],a[j]]=[a[j],a[i]]}return a};
 const eq=()=>S.eq||(S.eq={s:0,a:0,om:[],gs:null,ga:null});
 /* ===== 3 · les butins : chaque région a son matériau, avec son nom japonais ===== */
 const MAT={1:['藁|わら','Paille'],2:['竹|たけ','Bambou'],3:['歯車|はぐるま','Rouage'],4:['煤|すす','Suie'],5:['骨|ほね','Os'],6:['氷|こおり','Glace éternelle'],7:['紅葉|もみじ','Feuille d\'érable'],8:['鱗|うろこ','Écaille'],
  9:['鈴|すず','Grelot'],10:['墨|すみ','Encre'],11:['鉄|てつ','Fer'],12:['羽|はね','Plume'],13:['葉|は','Feuille de renard'],14:['ばね','Ressort'],15:['毛|け','Poil de vent'],16:['紙|かみ','Papier'],17:['貝|かい','Coquillage'],18:['金|きん','Paillette d\'or']};
 for(const z in MAT)IT['m'+z]={n:MAT[z][1],t:[MAT[z][0]],heal:0,map:1,mat:1,d:`Un matériau laissé par les yōkai de la région. ${tk(MAT[z][0])[0]} (${tk(MAT[z][0])[1]}) = ${MAT[z][1].toLowerCase()}. Les artisans s'en servent.`};
 window.RPGMAT=MAT;
 /* ===== 2 · les omamori ===== */
 const OM={ken:['健','Santé','+15 % de PV maximum',{m1:3,m6:2}],chikara:['力','Force','+10 % de dégâts',{m3:3,m11:2}],mamori:['守','Protection','−10 % de dégâts reçus',{m8:3,m5:2}],
  kin:['金','Fortune','+50 % de pièces après les combats',{m9:3,m4:2}],gaku:['学','Étude','+20 % d\'XP',{m10:3,m2:2}],tabi:['旅','Voyage','−40 % de rencontres sur les routes',{m7:3,m15:2}],
  un:['運','Chance','Deux fois plus de yōkai dorés',{m12:3,m13:2}],iyashi:['癒','Guérison','1 PV rendu tous les 3 pas',{m2:3,m1:2}],tsuri:['釣','Pêche','+2 secondes pour répondre à la pêche',{m8:2,m6:2}],
  fuda:['札','Karuta','Les adversaires du karuta sont plus lents',{m10:2,m16:2}],sho:['商','Commerce','−10 % dans les boutiques',{m9:2,m3:2}],katsu:['勝','Victoire','+15 % de dégâts dans l\'arène, +1 récompense',null]};
 window.OMAMORI=OM;
 for(const k in OM)IT['om_'+k]={n:'Omamori '+OM[k][1],t:[OM[k][0]],heal:0,map:1,d:'Un porte-bonheur de temple. '+OM[k][2]+'. Se porte dans les emplacements d\'omamori (forge).'};
 const has=k=>eq().om.includes(k);
 const slots=()=>2+((S.rank||0)>=2?1:0);
 /* ===== 1 · pierres de kanji serties ===== */
 const known=()=>Object.keys(S.best||{}).filter(k=>(S.best[k]||0)>=2&&spK(k));
 /* une pierre s'use : elle tient (4 + 3 × nombre de traits) combats gagnés, puis se fend.
    Un kanji simple (人, 2 traits) tient 10 combats ; un kanji complexe (鉄, 13 traits) en tient 43.
    Et on ne peut pas resertir le même kanji deux fois de suite au même endroit. */
 const life=k=>{const sp=spK(k);return 4+3*((sp&&sp.s&&sp.s.length)||3)};
 window.GEMLIFE=life;
 const wear=()=>{const E=eq();for(const sl of ['gs','ga']){if(!E[sl])continue;E[sl+'n']=(E[sl+'n']==null?life(E[sl]):E[sl+'n'])-1;const n=E[sl+'n'];
   if(n===3)setTimeout(()=>UI.toast(`La pierre 「${E[sl]}」 ${sl==='gs'?'du sabre':'de l\'armure'} se fissure : encore 3 combats.`,3000),2200);
   if(n<=0){const k=E[sl];E['last'+sl]=k;E[sl]=null;E[sl+'n']=0;setTimeout(()=>UI.toast(`La pierre 「${k}」 s'est brisée. Va voir la forgeronne pour en sertir une autre.`,3400),2400)}}};
 /* ===== 4 · cuisine : bonus pour les 3 prochains combats ===== */
 const DISH={yaki:['焼き魚|やきざかな','Poisson grillé',{fish:1},'atk','+20 % de dégâts'],tempura:['天ぷら|てんぷら','Tempura',{fish:1,m13:1},'def','−20 % de dégâts reçus'],
  sushi:['寿司|すし','Sushi',{fish:2,oni:1},'xp','+50 % d\'XP'],miso:['味噌汁|みそしる','Soupe miso',{m2:1,cha:1},'hp','PV au maximum et +10 % de PV'],ramen:['ラーメン','Rāmen',{oni:1,m4:1},'gold','+50 % de pièces']};
 const buff=k=>S.buff&&S.buff.k===k&&S.buff.n>0;
 /* ===== multiplicateurs utilisés par le combat, la vie, les rencontres ===== */
 window.DMGMUL=(dir,e)=>{let m=1;const E=eq();if(dir==='out'){if(has('chikara'))m*=1.1;if(buff('atk'))m*=1.2;if(E.gs&&e){m*=(e.weak===E.gs)?1.3:1.05}m*=1+.05*(S.rank||0);if(window.ARENA_ON&&has('katsu'))m*=1.15}
  else{if(has('mamori'))m*=.9;if(buff('def'))m*=.8;if(E.ga&&e){m*=(e.res===E.ga)?.8:.96}}return m};
 window.HPMUL=()=>(has('ken')?1.15:1)*(buff('hp')?1.1:1);
 window.ENCMUL=()=>has('tabi')?.6:1;
 /* le butin et les bonus après un combat gagné */
 const oWin=Quests.onWin;Quests.onWin=def=>{oWin(def);if(!def)return;const g=def._gold||0;
  if(has('kin')&&g){S.gold=(S.gold||0)+Math.round(g*.5)}if(buff('gold')&&g)S.gold=(S.gold||0)+Math.round(g*.5);
  const xp=def.xp||0;if(has('gaku'))S.xp=(S.xp||0)+Math.round(xp*.2);if(buff('xp'))S.xp=(S.xp||0)+Math.round(xp*.5);
  if(S.buff&&S.buff.n>0){S.buff.n--;if(!S.buff.n)S.buff=null}
  wear();
  if(def.wild&&W.map==='world'){const z=W.zone(),k='m'+z;if(MAT[z]&&(def.rare||Math.random()<.3)){const n=def.rare?2:1;S.it[k]=(S.it[k]||0)+n;setTimeout(()=>UI.toast(`Butin : ${MAT[z][1]} × ${n}`,2200),1600)}}};
 /* les yōkai dorés sont deux fois plus fréquents avec l'omamori 運 ou la réputation « héros » */
 const oW=STORY.wildDef;STORY.wildDef=(z,kind)=>{const d=oW(z,kind);if(!d.rare&&!S.fl.visit&&(has('un')||repLvl(z)>=2)&&Math.random()<.04){d.rare=1;d.n='★ '+d.n+' doré';d.hp=Math.round(d.hp*1.3);d.xp*=3;d.gold=(d.gold||8+d.lv)*4;setTimeout(()=>UI.toast('Un yōkai rare ! Il brille comme de l\'or.',2600),900)}return d};
 /* guérison en marchant */
 {let st=0;const oA=window.XARR;window.XARR=(m,x,y,run)=>{const r=oA?oA(m,x,y,run):false;if(has('iyashi')&&++st%3===0&&S.hp<maxHp())S.hp++;return r}}
 /* omamori 釣 et 札 : on les applique en douce aux mini-jeux */
 window.OMHAS=has;
 /* ===== l'atelier : la forgeronne fabrique, sertit, et équipe ===== */
 const cost=r=>Object.entries(r).map(([k,n])=>`${n} ${k==='fish'?'poisson':IT[k]?IT[k].n.toLowerCase():k}`).join(', ');
 const enough=r=>Object.entries(r).every(([k,n])=>k==='fish'?fishN()>=n:(S.it[k]||0)>=n);
 const pay=r=>{for(const[k,n]of Object.entries(r)){if(k==='fish'){let left=n;for(const f in S.fish){const t=Math.min(left,S.fish[f]);S.fish[f]-=t;left-=t;if(!left)break}}else S.it[k]-=n}};
 const fishN=()=>Object.values(S.fish||{}).reduce((a,b)=>a+b,0);
 window.Atelier={async open(n){for(;;){const i=await D.ask({n,t:`Acier de kiryoku : ${S.it.hagane||0} · ${S.gold||0} pièces.`},['Améliorer le sabre ou l\'armure','Sertir une pierre de kanji','Fabriquer un omamori','Porter mes omamori','Rien, merci']);
   if(i===0)await Forge.up(n);else if(i===1)await this.gem(n);else if(i===2)await this.craft(n);else if(i===3)await this.wear(n);else return}},
  async gem(n){const E=eq(),ks=known();
   if(!ks.length)return D.say({n,t:'Une pierre de kanji ne prend que les kanji que tu sais vraiment tracer : au moins deux étoiles. Reviens quand tu en maîtriseras.'});
   const st=sl=>E[sl]?`${E[sl]}, encore ${E[sl+'n']} combat${E[sl+'n']>1?'s':''}`:'vide';
   const s=await D.ask({n,t:'Où sertir la pierre ? Une pierre s\'use : plus le kanji a de traits, plus elle dure.'},[`Sabre (${st('gs')}) : +30 % contre les yōkai faibles à ce kanji`,`Armure (${st('ga')}) : −20 % de dégâts des yōkai de cet élément`,'Plus tard']);if(s>1)return;const sl=s?'ga':'gs';
   if((S.it.hagane||0)<1||(S.gold||0)<100)return D.say({n,t:'Il me faut un morceau d\'acier de kiryoku et 100 pièces.'});
   const ch=ks.filter(c=>c!==E['last'+sl]&&c!==E[sl]).sort((a,b)=>life(b)-life(a)).slice(0,12);if(!ch.length)return D.say({n,t:'Il te faut un autre kanji que le précédent. Apprends-en de nouveaux !'});const k=await D.ask({n,t:'Quel kanji graver ? (pas le même que la dernière fois)'},ch.map(c=>({jp:[c],fr:`${spK(c).name||''} · tient ${life(c)} combats`})));
   const sp=spK(ch[k]);await D.say({n,t:`Trace-le une dernière fois, bien droit. La pierre prendra la forme de ton geste.`});const r=await Trace.run(sp,{});UI.panel('pad');
   if(!r||r.stars<2)return D.say({n,t:'La pierre s\'est fendue. Le tracé n\'était pas assez net. Rien n\'est perdu : réessaie.'});
   S.it.hagane--;S.gold-=100;E[sl]=ch[k];E[sl+'n']=life(ch[k]);sfx('lvl');save();await D.say([J(n,['できた','！'],'C\'est fait !'),`La pierre 「${ch[k]}」 brille sur ${s?'l\'armure':'la garde du sabre'}. Elle tiendra ${life(ch[k])} combats.`])},
  async craft(n){const L=Object.keys(OM).filter(k=>OM[k][3]);const i=await D.ask({n,t:'Quel omamori ? (50 pièces + matériaux)'},L.map(k=>({jp:[OM[k][0]],fr:`${OM[k][1]} : ${cost(OM[k][3])}${S.it['om_'+k]?' · déjà fabriqué':''}`})).concat(['Plus tard']));if(i>=L.length)return;
   const k=L[i],r=OM[k][3];if(!enough(r)||(S.gold||0)<50)return D.say([{n,t:`Il me faut ${cost(r)}, et 50 pièces.`},T_(KG,"Les matériaux tombent des yōkai de chaque région. Le carnet de yōkai dit qui laisse quoi.")]);
   pay(r);S.gold-=50;S.it['om_'+k]=(S.it['om_'+k]||0)+1;sfx('item');save();await D.say([{jp:['お守り|おまもり','が','できました','！'],fr:`Omamori ${OM[k][1]} : ${OM[k][2]}.`,x:'お守り (おまもり) = porte-bonheur de temple'},'(Pense à le porter : « Porter mes omamori ».)'])},
  async wear(n){const E=eq(),own=Object.keys(OM).filter(k=>S.it['om_'+k]>0);if(!own.length)return D.say({n,t:'Tu n\'as aucun omamori. Fabriques-en un, ou trouve-en dans les donjons.'});
   for(;;){const i=await D.ask({n,t:`Emplacements : ${E.om.length} / ${slots()}. Touche un omamori pour le porter ou l'enlever.`},own.map(k=>({jp:[OM[k][0]],fr:`${E.om.includes(k)?'✓ porté · ':''}${OM[k][1]} : ${OM[k][2]}`})).concat(['Terminé']));if(i>=own.length){save();return}
    const k=own[i];if(E.om.includes(k))E.om=E.om.filter(q=>q!==k);else if(E.om.length<slots())E.om.push(k);else await D.say({n,t:`Tous les emplacements sont pris (${slots()}). Enlève-en un d'abord.`})}}};
 /* l'option « Améliorer » de la forgeronne ouvre maintenant tout l'atelier */
 const oUp=Forge.up.bind(Forge);Forge.up=async n=>{if(Forge._in)return oUp(n);Forge._in=1;try{await Atelier.open(n)}finally{Forge._in=0}};
 const Fup=Forge.up;Atelier.open=async function(n){for(;;){const i=await D.ask({n,t:`Acier de kiryoku : ${S.it.hagane||0} · ${S.gold||0} pièces.`},['Améliorer le sabre ou l\'armure','Sertir une pierre de kanji','Fabriquer un omamori','Porter mes omamori','Rien, merci']);
   if(i===0)await oUp(n);else if(i===1)await this.gem(n);else if(i===2)await this.craft(n);else if(i===3)await this.wear(n);else return}};
 /* ===== 4 · la cuisine, à l'auberge ===== */
 const oInn=STORY.inn;STORY.inn=async e=>{const i=await D.ask({n:'Auberge',t:'Que fais-tu ?'},['Dormir et sauvegarder','Cuisiner (bonus pour 3 combats)','Rien']);if(i===0)return oInn(e);if(i===1)return cook();};
 async function cook(){if(!S.rec)S.rec={};const L=Object.keys(DISH);
  const i=await D.ask({n:'Auberge',t:`Le cuisinier te prête sa cuisine. Poissons : ${fishN()}.${S.buff?` (Bonus en cours : encore ${S.buff.n} combat${S.buff.n>1?'s':''}.)`:''}`},L.map(k=>({jp:[DISH[k][0]],fr:S.rec[k]?`${DISH[k][1]} : ${cost(DISH[k][2])} → ${DISH[k][4]}`:'Recette inconnue (demande au cuisinier)'})).concat(['Plus tard']));if(i>=L.length)return;
  const k=L[i],d=DISH[k];
  if(!S.rec[k]){const opts=shuf([d[1],...shuf(L.filter(q=>q!==k).map(q=>DISH[q][1])).slice(0,2)]);
   const a=await D.ask(J('Cuisinier',['これ','は','何|なん','です','か','。'],'Qu\'est-ce que c\'est ?'),opts.map(o=>o)).catch(()=>-1);
   await D.say({jp:[d[0],'？'],fr:'(Le cuisinier montre le plat du doigt.)'});
   if(opts[a]!==d[1]){sfx('wrong');return D.say([J('Cuisinier',['違います|ちがいます','。'],'Non.'),{jp:[d[0]],fr:d[1]},'(Reviens quand tu sauras lire ce nom : il te donnera la recette.)'])}
   S.rec[k]=1;sfx('right');save();await D.say([J('Cuisinier',['そうです','！'],'C\'est ça !'),`(Recette apprise : ${d[1]}.)`])}
  if(!enough(d[2]))return D.say({n:'Cuisinier',t:`Il te manque des ingrédients : ${cost(d[2])}. Les poissons se pêchent, les onigiri et le thé s'achètent, le reste tombe des yōkai.`});
  pay(d[2]);S.buff={k:d[3],n:3};if(d[3]==='hp')S.hp=maxHp();sfx('heal');save();
  await D.say([{jp:[d[0],'が','できました','！','いただきます','！'],fr:`${d[1]} ! ${d[4]} pendant 3 combats.`,x:'いただきます = ce qu\'on dit avant de manger'}])}
 /* ===== 5 · les rangs de samouraï, au dojo ===== */
 const RANK=[['見習い|みならい','Apprenti',0,0],['侍|さむらい','Samouraï',30,1500],['達人|たつじん','Maître',70,5000],['伝説|でんせつ','Légende',120,12000]];
 window.RANKS=RANK;
 const nK=()=>Object.keys(S.sp||{}).length;
 const oK=STORY.keiko;STORY.keiko=async e=>{const r=S.rank||0,nx=RANK[r+1];
  if(nx&&nK()>=nx[2]&&(S.xp||0)>=nx[3]){const i=await D.ask(J('Maître Kotoba',['昇段|しょうだん','の','試験|しけん','を','受けます|うけます','か','。'],'Tu passes l\'épreuve de rang ?','試験 (しけん) = examen'),[`Passer l'épreuve : ${nx[1]}`,'La leçon habituelle']);
   if(i===0)return trial(r+1)}
  return oK(e)};
 async function trial(r){const R=RANK[r];await D.say(["Maître Kotoba frappe deux fois dans ses mains. Les élèves s'écartent.",T_('Maître Kotoba',`Épreuve de rang : ${R[1]}. Cinq questions, puis un kanji à tracer sans trembler.`)]);
  if(!(await vocQuiz(Math.min(16,4+r*4),5,'Maître Kotoba')))return D.say(T_('Maître Kotoba',"Pas encore. Reviens quand ces mots te viendront tout seuls."));
  const ks=known();const k=ks[(r*7)%Math.max(1,ks.length)]||'人';const t=await Trace.run(spK(k)||spK('人'),{aid:3});UI.panel('pad');
  if(!t||t.stars<2)return D.say(T_('Maître Kotoba',"Le tracé tremblait. Un samouraï ne tremble pas. Recommence quand tu veux."));
  S.rank=r;sfx('lvl');save();await D.say([{jp:[R[0],'！'],fr:`Rang obtenu : ${R[1]} !`},`(+5 % de dégâts${r>=2?', un 3e emplacement d\'omamori':''}${r>=3?', et la tenue de légende (dans les Options)':''}.)`]);if(r>=3)S.fl.legend=1;save()}
 /* ===== 7 · techniques de Tanuki et de Kage (dans le sac, en combat, une fois par combat) ===== */
 IT.tech_tanu={n:'Technique : marmite de Tanuki',t:['狸|たぬき','の','鍋|なべ'],tech:1,heal:45,fx:'bento',use:['狸|たぬき','が','鍋|なべ','に','なった','！'],d:'Tanuki se change en marmite : soin et le prochain coup ne fait rien.'};
 IT.tech_kage={n:'Technique : encre de Kage',t:['影|かげ','の','墨|すみ'],tech:1,heal:0,fx:'boost',use:['影|かげ','の','墨|すみ','！'],d:'Kage aveugle le yōkai avec son encre : ton prochain kanji fait +50 % de dégâts.'};
 const techOK=k=>k==='tech_tanu'?(Object.keys(S.fl).filter(q=>q.startsWith('pzg')).length>=2):(Object.keys(S.fl).filter(q=>q.startsWith('st')&&S.fl[q]).length>=2);
 const PH=[[['いっしょに','戦います|たたかいます','！'],'On se bat ensemble !'],[['大丈夫|だいじょうぶ','です','か','。'],'Ça va ?'],[['気をつけて|きをつけて','！'],'Fais attention !'],[['今|いま','です','！'],'C\'est maintenant !']];
 window.TECHCHK=async k=>{const p=PH[Math.floor(Math.random()*PH.length)],opts=shuf([p[1],...shuf(PH.filter(q=>q!==p).map(q=>q[1])).slice(0,2)]);
  const i=await D.ask({n:k==='tech_tanu'?TN:KG,jp:p[0],fr:'(Que dit-il ? Réponds pour lancer la technique.)'},opts,{panel:false});return opts[i]===p[1]};
 const oB=Battle.start;Battle.start=async(...a)=>{for(const k of ['tech_tanu','tech_kage'])S.it[k]=techOK(k)?1:0;try{return await oB(...a)}finally{S.it.tech_tanu=0;S.it.tech_kage=0}};
 /* ===== 8 · la réputation de chaque bourg ===== */
 window.repPts=z=>{let p=0;const f=S.fl;if(f['pzg'+z])p+=2;if(f['st'+z])p+=2;if(f['lk'+z])p+=1;if(f['sc'+z])p+=1;p+=(window.KHUNT||[]).filter(q=>q.z===z&&S.kh&&S.kh[q.k]).length;p+=(f['shz'+z]||0);return p};
 const repLvl=window.repLvl=z=>{const p=repPts(z);return p>=9?2:p>=4?1:0};
 const REPN=['inconnu','apprécié','héros du bourg'];
 const oST=window.ShopTalk;window.ShopTalk=async(k,q,n)=>{let m=await oST(k,q,n);const z=W.zone();if(m<1)S.fl['shz'+z]=Math.min(3,(S.fl['shz'+z]||0)+1);const L=repLvl(z);if(L)m*=L>=2?.9:.95;if(has('sho'))m*=.9;return m};
 /* au rang « héros », la marchande a un cadeau, une fois */
 const oShop=STORY.shop;STORY.shop=async e=>{const z=e&&e.id?+String(e.id).replace('shop',''):W.zone();
  if(repLvl(z)>=2&&!S.fl['gift'+z]){S.fl['gift'+z]=1;const L=Object.keys(OM).filter(k=>OM[k][3]),k=L[z%L.length];S.it['om_'+k]=(S.it['om_'+k]||0)+1;S.it.hagane=(S.it.hagane||0)+1;save();
   await D.say([J('Marchande',['いつも','ありがとう','ございます','。'],'Merci pour tout, toujours.','いつも = toujours'),{n:'Marchande',t:`Tout le bourg parle de toi. Tiens : un omamori ${OM[k][1]} et un morceau d'acier. Et un secret : par ici, les yōkai dorés sortent deux fois plus souvent depuis que tu es là.`}])}
  return oShop(e)};
 /* ===== 9 · l'arène des yōkai, à la Cité ouvrière ===== */
 const HA=HAMS.find(h=>h.z===11);
 if(HA){NPCS.world.push({id:'arena',spr:'master',x:HA.px+3,y:HA.py+1,dir:0,wander:0,ev:'arena',nm:'Maître de l\'arène'});PORT['Maître de l\'arène']=PORT['Maître de l\'arène']||'PX_master'}
 STORY.arena=async()=>{const n='Maître de l\'arène',best=S.arena||0;
  await D.say([J(n,['挑戦者|ちょうせんしゃ','か','。'],'Un challenger ?','挑戦者 (ちょうせんしゃ) = challenger'),{n,t:`Des vagues de yōkai, sans repos entre les combats. Ton record : ${best} vague${best>1?'s':''}. Chaque nouveau record rapporte de l'acier, et la vague 10 un omamori très spécial.`}]);
  if(await D.ask('Entrer dans l\'arène ?',['Entrer','Plus tard'])!==0)return;
  window.ARENA_ON=1;let w=0;try{for(;;){const z=Math.min(16,2+w*2),def=STORY.wildDef(z);def.lv+=w;def.hp=Math.round(def.hp*(1+w*.12));def.n=`Vague ${w+1} · ${def.n}`;
    const r=await Battle.start(def,{zone:z});if(r!=='win')break;w++;UI.toast(`Vague ${w} réussie !`,1600);if(w>=15)break}}finally{window.ARENA_ON=0}
  if(S.hp<=0)S.hp=1;
  if(w>best){const g=w-best;S.arena=w;S.it.hagane=(S.it.hagane||0)+g+(has('katsu')?1:0);if(w>=10&&!S.it.om_katsu){S.it.om_katsu=1}save();
   await D.say([{n,t:`Nouveau record : ${w} vague${w>1?'s':''} !`},`(+${g+(has('katsu')?1:0)} acier de kiryoku${w>=10&&S.it.om_katsu===1?', et l\'omamori 勝 (Victoire)':''}.)`])}
  else await D.say({n,t:`${w} vague${w>1?'s':''}. Ton record reste ${best}. Reviens plus fort.`})};
 /* ===== 6 · la salle des trophées (maison de Kaito) ===== */
 MAPS.tro={w:12,h:9,inside:1,zi:1,tint:'warm',music:'village',name:['トロフィーの部屋|とろふぃーのへや','La salle des trophées'],rows:['HHHHHHHHHHHH','h1hRhgghqu2h','nnnnnnnnnnnn','pmmmmmmmmmmn','nmmmmmmmmmmn','nmmmmmmmmmmp','nnnnnnnnnnnn','nnnnnnnnnnnn','     d      '],zone:()=>99,warps:[{x:5,y:8,to:'world',ret:1}]};
 const TRO=[{x:2,y:3,t:'Pêche',ok:()=>fishN()>0,im:'魚',d:()=>'Tes plus belles prises : '+Object.entries(S.fish||{}).map(([k,v])=>`${k} × ${v}`).join(', ')},
  {x:4,y:3,t:'Karuta',ok:()=>S.fl.kc1||S.fl.kc2||S.fl.kc3,im:'札',d:()=>`Diplômes de karuta : ${['kc1','kc2','kc3'].filter(k=>S.fl[k]).length} sur 3.`},
  {x:6,y:3,t:'Donjons',ok:()=>S.fl.djdone1||S.fl.djdone2||S.fl.djdone3,im:'宝',d:()=>`Trophées des donjons : ${[1,2,3].filter(k=>S.fl['djdone'+k]).length} sur 3.`},
  {x:8,y:3,t:'Stèles',ok:()=>(window.STELES||[]).some(s=>S.fl['st'+s.z]),im:'碑',d:()=>`Une stèle miniature, gravée des ${(window.STELES||[]).filter(s=>S.fl['st'+s.z]).length} phrases que tu as réparées.`},
  {x:2,y:5,t:'Rang',ok:()=>(S.rank||0)>0,im:'段',d:()=>`Ton certificat de rang : ${RANK[S.rank||0][1]}.`},
  {x:4,y:5,t:'Yōkai doré',ok:()=>(S.fl.rares||0)>0,im:'金',d:()=>`Une statuette dorée pour chaque yōkai doré vaincu : ${S.fl.rares||0}.`},
  {x:6,y:5,t:'Yukata',ok:()=>S.fl.yukata,im:'浴',d:()=>'Ton yukata du festival des érables, sur un portant.'},
  {x:8,y:5,t:'Arène',ok:()=>(S.arena||0)>0,im:'闘',d:()=>`La ceinture de l'arène. Record : ${S.arena||0} vagues.`},
  {x:10,y:4,t:'Succès',ok:()=>true,im:'賞',d:()=>`Le tableau des succès : ${Object.keys(S.ach||{}).length} sur ${(window.ACHIEV||[]).length}.`}];
 const trAt=(x,y)=>TRO.find(t=>t.x===x&&t.y===y);
 {const oS=window.XSOLID;window.XSOLID=(m,x,y)=>(oS&&oS(m,x,y))||(m==='tro'&&!!trAt(x,y));
  const oI=window.XINT;window.XINT=(m,x,y,p)=>{if(m==='tro'){const t=trAt(x,y);if(t)return p||(()=>D.say(t.ok()?`${t.t} : ${t.d()}`:`${t.t} : un présentoir vide. Il attend un trophée.`))}return oI?oI(m,x,y,p):null};
  const oD=window.XDRAW;window.XDRAW=(m,L,g,X,Y,VW,VH)=>{oD&&oD(m,L,g,X,Y,VW,VH);if(m!=='tro')return;const T=16;
   TRO.forEach((t,ti)=>L.push({y:(t.y+1)*T,f:()=>{const px=t.x*T-X,py=t.y*T-Y,ok=t.ok(),ti_=XI['X_TRO'+ti];if(ok&&ti_&&ti_.width){const q=Math.min(1,26/(ti_.height/3)),w=ti_.width/3*q,h=ti_.height/3*q;g.drawImage(ti_,px+8-w/2,py+16-h,w,h);return}g.fillStyle='#5a3a22';g.fillRect(px+1,py+4,14,12);g.fillStyle='#7a5432';g.fillRect(px+1,py+4,14,3);
    if(ok){g.fillStyle='#e8b848';g.beginPath();g.arc(px+8,py-2,7,0,7);g.fill();g.fillStyle='#3a2414';g.font='bold 9px serif';g.textAlign='center';g.textBaseline='middle';g.fillText(t.im,px+8,py-2);g.textAlign='left'}}}))}}
 window.goTrophies=async()=>{if(W.map!=='world')return UI.toast('Sors d\'abord à l\'air libre.',2000);G.busy=true;await UI.fade(1,350);S.ret={x:W.H.x,y:W.H.y};W.load('tro',5,7,1);W.H.cd=2;W.refreshZone();await UI.fade(0,350);G.busy=false};
 /* la tenue de légende (rang 4) */
 window.LEGEND=()=>S.fl.legend&&S.fl.legendOn;
})();

/* ---------- La vie des bourgs : fumée des cheminées, poules, papillons, libellules au-dessus de l'eau ---------- */
(()=>{
 const T=16,M=()=>MAPS.world,h2=(a,b)=>{let x=(a*374761393+b*668265263)>>>0;x=((x^(x>>>13))*1274126177)>>>0;return (x^(x>>>16))>>>0};
 const CHK=[1,2,5,6,8,13,15,17],BUT=[2,7,8,10,13,14,15],NOSMOKE=[12,14,16];
 let SM=null,CH=null,BF=null;
 const free=(x,y)=>{const r=M().rows[y];if(!r)return false;const c=r[x];return (c==='.'||c==='M'||c==='='||c==='_'||c===','||c===':')&&!W.solid(x,y)&&!(M().bld||[]).some(b=>x>=b.x-1&&x<=b.x+b.w&&y>=b.y-4&&y<=b.y+b.h)};
 function init(){SM=[];CH=[];BF=[];const m=M();
  for(const b of (m.bld||[])){if(b.k!=='h'||!String(b.im).startsWith('X_V_'))continue;const z=m.zone(b.y);if(NOSMOKE.includes(z))continue;SM.push(b)}
  for(const h of HAMS){if(CHK.includes(h.z)){let n=0;for(let i=0;i<80&&n<4;i++){const x=h.x0+3+h2(i,h.z*7)%50,y=h.y0+3+h2(h.z,i*13)%(h.y1-h.y0-6);
     if([-1,0,1].every(a=>[0,1].every(b=>free(x+a,y+b)))){CH.push({x,y,s:h2(x,y)%1000});n++}}}
   if(BUT.includes(h.z))for(let i=0;i<5;i++){const x=h.x0+4+h2(i*3,h.z)%48,y=h.y0+4+h2(h.z*5,i)%(h.y1-h.y0-8);BF.push({x,y,s:h2(x+1,y)%1000,c:['#f6e27a','#ffffff','#f4a3c8','#9fd3ff'][i%4]})}}}
 /* une poule : corps blanc, crête rouge, elle picore et trottine autour de son coin */
 const AN=(k,i)=>{const im=XI['X_AN_'+k+i];return im&&im.width?im:null};
 function spr(g,im,x,y,flip){const w=im.width/3,h=im.height/3;if(flip){g.save();g.translate(x,0);g.scale(-1,1);g.drawImage(im,-w/2,y-h,w,h);g.restore()}else g.drawImage(im,x-w/2,y-h,w,h)}
 function hen(g,px,py,t,s){const ph=(t*.6+s)%6,walk=ph<2,peck=!walk&&Math.sin(t*9+s)>.3,dir=Math.floor((t*.6+s)/6)%2?1:-1,ox=walk?(ph-1)*10*dir:(dir*10),bob=walk?Math.abs(Math.sin(t*10))*1:0;
  if(AN('HEN',0)){const im=walk?AN('HEN',1+Math.floor(t*8)%3):peck?AN('HEN',4):AN('HEN',0);g.fillStyle='rgba(0,0,0,.2)';g.beginPath();g.ellipse(px+ox,py+2,5,1.6,0,0,7);g.fill();spr(g,im||AN('HEN',0),px+ox,py+2,dir<0);return}
  const x=px+ox,y=py-bob;g.fillStyle='rgba(0,0,0,.2)';g.beginPath();g.ellipse(x,py+2,5,1.6,0,0,7);g.fill();
  g.fillStyle='#e8a030';g.fillRect(x-2,y,1,3);g.fillRect(x+1,y,1,3);
  g.fillStyle='#f4f0e6';g.beginPath();g.ellipse(x,y-3,5,4,0,0,7);g.fill();g.fillStyle='#d8d2c4';g.fillRect(x-dir*4,y-4,2,3);
  const hx=x+dir*4,hy=y-(peck?3:7);g.fillStyle='#f4f0e6';g.fillRect(hx-1.5,hy,3,3);g.fillStyle='#d8302a';g.fillRect(hx-1,hy-1.5,2,1.5);g.fillStyle='#e8a030';g.fillRect(hx+dir*2-(dir<0?1:0),hy+1,1.5,1);g.fillStyle='#000';g.fillRect(hx+(dir>0?0:-1),hy+.5,1,1)}
 const oD=window.XDRAW;window.XDRAW=(m,L,g,X,Y,VW,VH)=>{oD&&oD(m,L,g,X,Y,VW,VH);if(m!=='world'||S.fxoff)return;if(!SM)init();const t=performance.now()/1000;
  /* fumée */
  const SK=smokeSpr('236,236,240');
  for(const b of SM){const im=XI[b.im];if(!im||!im.width)continue;const sc=(b.sc||1)/((typeof BHR!=='undefined'?BHR:{})[b.im]||1),w=im.width/3*sc,h=im.height/3*sc,cx=b.x*T+b.w*T/2+(b.ddx||0)-X,by=(b.y+b.h)*T+2-Y;if(by<-60||by-h>VH+40||cx<-80||cx>VW+80)continue;
   const ch_=window.chimOf?chimOf(im,b.im):null;if(!ch_)continue;const fx_=b.flip?1-ch_[0]:ch_[0],sx=cx-w/2+fx_*w,sy=by-h+ch_[1]*h+2;
   L.push({y:(b.y+b.h)*T+3,f:()=>{for(let i=0;i<4;i++){const p=((t*.22+i/4+(b.x%7)*.13)%1),r=3+p*9;g.globalAlpha=.6*(1-p);g.drawImage(SK.puff,sx-r*1.1+Math.sin(t*.8+i+b.x)*(1+p*2)+p*4,sy-p*34-r*.8,r*2.2,r*1.6)}g.globalAlpha=1}})}
  /* poules */
  for(const c of CH){const px=c.x*T+8-X,py=c.y*T+14-Y;if(px<-40||px>VW+40||py<-40||py>VH+40)continue;L.push({y:c.y*T+14,f:()=>hen(g,px,py,t,c.s)})}
  /* papillons */
  L.push({y:1e9,f:()=>{for(const b of BF){const bx=b.x*T-X+Math.sin(t*.7+b.s)*26+Math.sin(t*1.9+b.s*2)*8,by=b.y*T-Y+Math.cos(t*.5+b.s)*18-8+Math.sin(t*2.3+b.s)*5;if(bx<-20||bx>VW+20||by<-20||by>VH+20)continue;
    if(AN('BFLY',0)){spr(g,AN('BFLY',Math.floor(t*10+b.s)%3),bx,by+3,Math.cos(t*.7+b.s)<0);continue}
    const f=Math.abs(Math.sin(t*14+b.s));g.fillStyle=b.c;g.fillRect(bx-1-2*f,by-1,2*f+1,2);g.fillRect(bx+1,by-1,2*f+1,2);g.fillStyle='#3a2a1a';g.fillRect(bx,by-1,1,3)}
   /* libellules : au-dessus de l'eau visible */
   const m_=M(),y0=Math.floor(Y/T),y1=Math.ceil((Y+VH)/T);let n=0;
   for(let y=y0-((y0%3)+3)%3;y<=y1&&n<12;y+=3)for(let x=0;x<m_.w&&n<12;x+=5){const r=m_.rows[y];if(!r||r[x]!=='~'||h2(x,y)%4||[12,16,19].includes(m_.zone(y)))continue;n++;const s=h2(x,y)%1000,dx=x*T-X+8+Math.sin(t*.9+s)*20+(Math.sin(t*3.1+s)>.9?6:0),dy=y*T-Y+Math.cos(t*.7+s)*10-6;
    if(AN('DFLY',0)){spr(g,AN('DFLY',Math.floor(t*14+s)%2),dx,dy+2,Math.cos(t*.9+s)<0);continue}
    g.fillStyle='#3aa8c8';g.fillRect(dx-3,dy,7,1);g.fillStyle='rgba(220,240,255,.7)';const f=Math.sin(t*30+s)>0;g.fillRect(dx-1,dy-(f?2:1),1,f?2:1);g.fillRect(dx+1,dy-(f?2:1),1,f?2:1);g.fillRect(dx-1,dy+1,1,f?2:1);g.fillRect(dx+1,dy+1,1,f?2:1)}}})};
 /* ===== chiens, corbeaux, koï et objets animés propres à chaque bourg ===== */
 const AO={};
 const NF={lantern:6,fox:7,noren:6};const PING={chochin:1,lantern:0,crane:1,furin:1,pendulum:1,koinobori:0};
 const SPD={wheel:6,gear:6,mill:7,shishi:2,anvil:4,vent:3,gauge:3,koinobori:5,nets:2,chochin:3,noren:3,pendulum:3,sakura:2,orrery:3,basin:2,crane:1.5,furin:3,banner:5,lantern:4,fox:3};
 let OBJ=null,DOG=null,CROW=null,KOI=null;
 const big=(x,y,w)=>{for(let a=-1;a<=w;a++)for(let b=-1;b<=1;b++)if(!free(x+a,y+b))return false;return true};
 function init2(){OBJ=[];DOG=[];CROW=[];KOI=[];const m=M();
  for(const h of HAMS){const L=AO[h.z]||[];let n=0;
   for(let i=0;i<400&&n<L.length*2;i++){const x=h.x0+4+h2(i*7+3,h.z*11)%48,y=h.y0+4+h2(h.z*3,i*17+5)%(h.y1-h.y0-8),k=L[n%L.length],w=['gear','nets','noren','mill','sakura'].includes(k)?2:1;
    if(big(x,y,w)&&!'_=G'.includes(m.rows[y][x])&&!'_=G'.includes(m.rows[y][x+w-1])&&!OBJ.some(o=>Math.abs(o.x-x)<6&&Math.abs(o.y-y)<5)&&!CH.some(c=>Math.abs(c.x-x)<3&&Math.abs(c.y-y)<3)){OBJ.push({x,y,k,w,s:h2(x,y)%100});n++}}
   if(h.z!==12&&h.z!==14&&h.z!==16){for(let i=0;i<60;i++){const x=h.x0+4+h2(i,h.z*13+1)%48,y=h.y0+4+h2(h.z*7+2,i)%(h.y1-h.y0-8);if(big(x-2,y,5)){DOG.push({x,y,s:h2(x,y)%1000});break}}}
   for(let i=0;i<3;i++){const x=h.x0+4+h2(i*5,h.z*17)%48,y=h.y0+4+h2(h.z*9,i*3)%(h.y1-h.y0-8);if(free(x,y))CROW.push({x,y,s:h2(x+2,y)%1000})}}
  /* koï : dans les mares d'au moins 2×2 cases */
  for(let y=1;y<m.h-1;y++){const r=m.rows[y];for(let x=1;x<m.w-1;x++)if(![12,16,17,19,20].includes(m.zone(y))&&r[x]==='~'&&r[x+1]==='~'&&m.rows[y+1][x]==='~'&&m.rows[y+1][x+1]==='~'&&h2(x,y)%9===0&&!(typeof OY!=='undefined'&&Math.abs(x-17)<6&&Math.abs(y-(OY+86))<5)&&[0,1,2].every(a=>[0,1,2].every(b=>m.rows[y+b]&&m.rows[y+b][x+a]==='~'))&&!KOI.some(k=>Math.abs(k.x-x)<14&&Math.abs(k.y-y)<12))KOI.push({x,y,s:h2(x*3,y)%1000})}
  const bl=new Set(OBJ.flatMap(o=>Array.from({length:o.w},(_,i)=>(o.x+i)+','+o.y)));window.__AOB=bl}
 const oS=window.XSOLID;window.XSOLID=(m,x,y)=>(oS&&oS(m,x,y))||(m==='world'&&!!window.__AOB&&__AOB.has(x+','+y));
 const fr=(o,t)=>{const n=NF[o.k]||4,sp=SPD[o.k]||3,i=Math.floor(t*sp+o.s);if(PING[o.k]){const p=i%(2*n-2);return p<n?p:2*n-2-p}return i%n};
 const oD2=window.XDRAW;window.XDRAW=(m,L,g,X,Y,VW,VH)=>{oD2&&oD2(m,L,g,X,Y,VW,VH);if(m!=='world'||S.fxoff)return;if(!SM)init();if(!OBJ)init2();const t=performance.now()/1000;
  for(const o of OBJ){const px=(o.x+o.w/2)*T-X,py=(o.y+1)*T-Y;if(px<-80||px>VW+80||py<-100||py>VH+60)continue;const im=XI['X_AO_'+o.k.toUpperCase()+fr(o,t)];if(!im||!im.width)continue;
   L.push({y:(o.y+1)*T,f:()=>{const w=im.width/3,h=im.height/3;g.fillStyle='rgba(0,0,0,.2)';g.beginPath();g.ellipse(px,py-1,w*.35,2.5,0,0,7);g.fill();g.drawImage(im,px-w/2,py-h,w,h)}})}
  if(AN('DOG',0))for(const d of DOG){const ph=(t*.25+d.s)%8,walk=ph<3,dir=Math.floor((t*.25+d.s)/8)%2?1:-1,ox=walk?(ph-1.5)*12*dir:dir*18,px=d.x*T+8-X+ox,py=d.y*T+15-Y;if(px<-40||px>VW+40||py<-40||py>VH+40)continue;
   const im=walk?AN('DOG',Math.floor(t*8)%4):AN('DOG',4+(Math.floor(t*4)%2));L.push({y:d.y*T+15,f:()=>{g.fillStyle='rgba(0,0,0,.2)';g.beginPath();g.ellipse(px,py,7,2,0,0,7);g.fill();spr(g,im,px,py+1,dir<0)}})}
  if(AN('CROW',0))for(const c of CROW){const px=c.x*T+8-X,py=c.y*T+15-Y,dx=W.H.x-c.x,dy=W.H.y-c.y,near=dx*dx+dy*dy<10;if(px<-60||px>VW+60||py<-80||py>VH+40)continue;
   if(near&&!c.fl)c.fl=t;if(!near&&c.fl&&t-c.fl>6)c.fl=0;
   if(c.fl){const k=t-c.fl;if(k<4)L.push({y:1e9,f:()=>spr(g,AN('CROW',3),px+k*60,py-k*45,false)});continue}
   const hop=Math.floor(t*1.3+c.s)%5===0,im=hop?AN('CROW',1):AN('CROW',(Math.floor(t*.7+c.s)%7===0)?2:0);L.push({y:c.y*T+15,f:()=>spr(g,im,px,py,Math.floor(t*.2+c.s)%2===0)})}
  if(AN('KOI',0))L.push({y:-1e5,f:()=>{for(const k of KOI){const px=k.x*T+16-X+Math.cos(t*.5+k.s)*9,py=k.y*T+16-Y+Math.sin(t*.5+k.s)*6;if(px<-30||px>VW+30||py<-30||py>VH+30)continue;
   const im=AN('KOI',Math.floor(t*4+k.s)%4);g.save();g.globalAlpha=.85;g.translate(px,py);g.rotate(t*.5+k.s+Math.PI/2);g.drawImage(im,-im.width/6,-im.height/6,im.width/3,im.height/3);g.restore()}}})};
 window.addEventListener('jz-reset',()=>{SM=null;OBJ=null});
})();

/* ---------- Apparitions des boss des actes I et II, sur le modèle de celle de Tetsu ----------
   La caméra glisse le long du décor, le boss dort, ses yeux s'allument, il se dresse, et le combat commence. */
(()=>{
 const J=(n,jp,fr,x)=>({n,jp,fr,x}),T_=(n,t)=>({n,t}),KA='Kaito',KG='影';
 function scene(o){const host=Cine.host(),bg=new Image();bg.src=IM[o.bg];const sl=XI[o.sleep],aw=o.awake(),BW=600,BH=448;
  const cv=document.createElement('canvas');cv.width=BW;cv.height=BH;cv.style.cssText='width:100%;image-rendering:pixelated;display:block';host.appendChild(cv);
  const g=cv.getContext('2d'),t0=performance.now(),ease=p=>p<.5?2*p*p:1-Math.pow(-2*p+2,2)/2;let stop=false,ph='pan',pt=0,done=null;
  const P=[...Array(o.pages?60:34)].map(()=>({x:Math.random()*BW,y:Math.random()*BH,v:20+Math.random()*50,a:Math.random()*6}));
  const st={wake(){ph='wake';pt=performance.now()},stand(){ph='stand';pt=performance.now()},flash(){ph='flash';pt=performance.now();return new Promise(r=>done=r)},end(){stop=true;cv.remove()}};
  let last=t0;const f=()=>{if(stop)return;const now=performance.now(),t=(now-t0)/1000,dt=Math.min(.05,(now-last)/1000);last=now;
   const BGW=bg.width?Math.round(bg.width*BH/bg.height):1100,camx=(BGW-BW)*ease(Math.min(1,t/4.2)),k=(now-pt)/1000;
   g.imageSmoothingEnabled=false;g.fillStyle='#07060c';g.fillRect(0,0,BW,BH);if(bg.width){g.drawImage(bg,-camx,0,BGW,BH);if(window.CA&&CA.cv)CA.cv(g,bg,-camx,0,BGW,BH)}
   const tx=BGW*o.tx-camx,ty=BH*o.ty;
   if(ph==='pan'||ph==='wake'){if(sl&&sl.width){const h=o.sh,w=sl.width*h/sl.height,bob=Math.sin(t*1.6)*1.5;g.drawImage(sl,tx-w/2,ty-h+bob,w,h);
     if(ph==='wake'){const a=Math.min(1,k*1.5),ey=ty-h*o.ey;for(const ex of o.ex){const xx=tx+ex*w;g.fillStyle=`rgba(${o.eye},${a})`;g.fillRect(xx-3,ey-1,6,3);const r=g.createRadialGradient(xx,ey,1,xx,ey,26);r.addColorStop(0,`rgba(${o.eye},${.45*a})`);r.addColorStop(1,`rgba(${o.eye},0)`);g.fillStyle=r;g.fillRect(xx-26,ey-26,52,52)}
      if(k>.6){const s=Math.sin(k*40)*3*Math.min(1,k-.6);g.translate(s,0)}}}}
   else if(aw&&aw.width){const h=o.ah,w=aw.width*h/aw.height,a=Math.min(1,k*2.5),sc=1+.08*Math.max(0,1-k*2);g.globalAlpha=a;g.drawImage(aw,BW*.5-w*sc/2,BH*.95-h*sc,w*sc,h*sc);g.globalAlpha=1;
     if(k<.4){g.fillStyle=`rgba(${o.flash},${.65*(1-k/.4)})`;g.fillRect(0,0,BW,BH)}}
   g.setTransform(1,0,0,1,0,0);
   for(const p of P){if(o.pages){p.x+=(40+p.v)*dt*(ph==='pan'?.5:2);p.y+=Math.sin(t*2+p.a)*20*dt;p.a+=dt*3;if(p.x>BW+10){p.x=-10;p.y=Math.random()*BH}g.save();g.translate(p.x,p.y);g.rotate(p.a);g.fillStyle='rgba(240,232,210,.9)';g.fillRect(-3,-2,6,4);g.fillStyle='rgba(30,26,40,.7)';g.fillRect(-2,-1,4,1);g.restore()}
    else{p.y-=p.v*dt;p.x+=Math.sin(t+p.a)*10*dt;if(p.y<-5){p.y=BH+5;p.x=Math.random()*BW}const q=.5+.5*Math.sin(t*4+p.a);g.fillStyle=`rgba(255,${100+q*90|0},40,${.5+.4*q})`;g.fillRect(p.x|0,p.y|0,2,2)}}
   if(ph==='flash'){const p=Math.min(1,k/.9);g.fillStyle=`rgba(${o.flash},${p})`;g.fillRect(0,0,BW,BH);if(p>=1&&done){done();done=null}}
   requestAnimationFrame(f)};requestAnimationFrame(f);return st}
 const ONI={bg:'N_ONIBG',sleep:'X_ONI_SLEEP',awake:()=>{const i=new Image();i.src=IM.BT_boss;return i},tx:.79,ty:.91,sh:235,ey:.52,ex:[-.12,.12],eye:'255,210,80',ah:300,flash:'255,150,60'};
 const BAKU={bg:'N_BAKUBG',sleep:'X_BAKU0',awake:()=>{const i=new Image();i.src=IM.BT_baku;return i},tx:.80,ty:.84,sh:190,ey:.55,ex:[-.1,.1],eye:'120,200,255',ah:300,flash:'200,230,255',pages:1};
 window.__ONI=ONI;window.__BAKU=BAKU;
 window.BossCine=async(o,pre,post)=>{await UI.fade(1,500);const R=scene(o);await UI.fade(0,500);await wait(4400);
  try{R.wake();await wait(800);await D.say(pre);R.stand();sfx('boom');W.shake&&W.shake(.6);await wait(500);await D.say(post);sfx('crit');await R.flash();await wait(150)}finally{await UI.fade(1,300);R.end();Cine.hide()}await UI.fade(0,250)};
 const ok=k=>IM[k];
 /* acte I : on remplace l'illustration fixe par la scène animée (la première fois) */
 const oCS=Cine.say;Cine.say=async(k,lines)=>{
  if(k==='N_S2'&&ok('N_ONIBG')&&ok('X_ONI_SLEEP')&&!S.fl.cine_oni){S.fl.cine_oni=1;save();
   return BossCine(ONI,["Au milieu du hameau en cendres, le vieux puits fume. Tout au fond, quelque chose respire. Un souffle chaud, régulier, qui sent le charbon.",T_(KG,"Ne fais pas de bruit. Il dort.")],
    [J('？？？',['だれ','だ','！'],'Qui va là ?!'),{t:'Une locomotive à face de démon jaillit du vieux puits !'},J(KA,['大きい|おおきい','！'],'Elle est énorme !')])}
  if(k==='N_S6'&&ok('N_BAKUBG')&&!S.fl.cine_baku){S.fl.cine_baku=1;save();
   return BossCine(BAKU,["La grande halle des forges. Des milliers de feuillets tourbillonnent dans l'air brûlant, comme un essaim. Au fond, dans un berceau de fer, une masse énorme dort, roulée sur elle-même.",T_(KG,"Elle a avalé tous ces mots. Écoute : ils frappent contre la cuve pour sortir.")],lines)}
  return oCS(k,lines)};
})();

/* ---------- Onglet « Perso » du menu : la fiche de Kaito ----------
   Niveau, PV, rang, sabre et armure, pierres de kanji serties (avec leur usure), omamori portés,
   plat en cours, techniques de Tanuki et de Kage, et le bilan chiffré de tous ces bonus. */
(()=>{
 const BUFF={atk:['焼き魚','Poisson grillé','+20 % de dégâts'],def:['天ぷら','Tempura','−20 % de dégâts reçus'],xp:['寿司','Sushi','+50 % d\'XP'],hp:['味噌汁','Soupe miso','+10 % de PV'],gold:['ラーメン','Rāmen','+50 % de pièces']};
 const pct=v=>{const p=Math.round((v-1)*100);return (p>=0?'+':'−')+Math.abs(p)+' %'};
 const pips=(n,max,col)=>`<span class="pcpips">${Array.from({length:max},(_,i)=>`<i style="background:${i<n?col:'#1a2236'}"></i>`).join('')}</span>`;
 const bar=(v,max,col)=>`<span class="pcbar"><i style="width:${Math.max(0,Math.min(100,v/Math.max(1,max)*100))}%;background:${col}"></i></span>`;
 const row=(k,col,title,body,right='')=>`<div class="mi"><div class="k" style="color:${col}">${k}</div><div class="t"><b>${title}</b>${body}</div>${right}</div>`;
 const icon=(src,txt,col)=>src?`<img src="${src}" alt="" style="width:44px;height:44px;image-rendering:pixelated;background:#283048">`:`<div class="k" style="color:${col}">${txt}</div>`;
 const techOK=k=>k==='tan'?Object.keys(S.fl).filter(q=>q.startsWith('pzg')).length>=2:Object.keys(S.fl).filter(q=>q.startsWith('st')&&S.fl[q]).length>=2;
 window.CharPage=()=>{const E=S.eq||{},sw=E.s||0,ar=E.a||0,st=stage(S.xp||0),ST=STAGES[st],nx=STAGES[st+1],R=(window.RANKS||[])[S.rank||0],mh=maxHp(),om=E.om||[],OM=window.OMAMORI||{};
  const slots=2+((S.rank||0)>=2?1:0),life=window.GEMLIFE||(()=>10),img=IM['C_'+STG[st]+'_00'];
  let h=`<div class="pctop"><div class="pcimg">${img?`<img src="${img}" alt="">`:''}</div><div class="pcid">
   <b>Kaito</b><span class="pcst">${jpHtml([ST.jp])} · ${esc(ST.name)}</span>
   <span class="pcl">Niveau ${level(S.xp||0)} · ${S.xp||0} XP</span>${nx?bar((S.xp||0)-ST.need,nx.need-ST.need,'#58e0ec')+`<small>Prochaine tenue (${esc(nx.name)}) à ${nx.need} XP</small>`:'<small>Tenue ultime atteinte</small>'}
   <span class="pcl">PV ${S.hp}/${mh}</span>${bar(S.hp,mh,S.hp/mh>.5?'#5ad06a':S.hp/mh>.25?'#e8c040':'#e04a3a')}
   <small>${S.gold||0} pièces · ${S.it.hagane||0} acier de kiryoku · ${Object.keys(S.sp||{}).length} kanji connus</small></div></div>`;
  if(R)h+=row(tk(R[0])[0],'var(--gold)',`Rang : ${esc(R[1])}`,`${tk(R[0])[1]}${S.rank?` · +${5*S.rank} % de dégâts`:''}${(window.RANKS||[])[(S.rank||0)+1]?`<br><small>Rang suivant au dojo : ${RANKS[(S.rank||0)+1][2]} kanji et ${RANKS[(S.rank||0)+1][3]} XP</small>`:'<br><small>Rang le plus haut</small>'}`);
  h+=`<div class="sw" style="border:0;padding:10px 0 4px"><span>Équipement</span></div>`;
  h+=row('刀','#9fd3ff',`Sabre · niveau ${sw}/5`,`${pips(sw,5,'#9fd3ff')}<br>${sw?`+${sw*10} % de dégâts`:'Lame de paysan, sans amélioration'}${sw<5?`<br><small>Niveau ${sw+1} : ${sw+1} acier + ${(sw+1)*120} pièces, chez la forgeronne</small>`:''}`);
  h+=row('鎧','#e8b848',`Armure · niveau ${ar}/5`,`${pips(ar,5,'#e8b848')}<br>${ar?`−${ar*7} % de dégâts reçus`:'Simple kimono de voyage'}${ar<5?`<br><small>Niveau ${ar+1} : ${ar+1} acier + ${(ar+1)*120} pièces, chez la forgeronne</small>`:''}`);
  h+=`<div class="sw" style="border:0;padding:10px 0 4px"><span>Pierres de kanji serties</span></div>`;
  for(const[sl,nm,eff]of[['gs','Sur le sabre','+30 % contre les yōkai faibles à ce kanji'],['ga','Sur l\'armure','−20 % de dégâts des yōkai de cet élément']]){const k=E[sl];
   if(k){const n=E[sl+'n']==null?life(k):E[sl+'n'],L=life(k),sp=typeof spK!=='undefined'?spK(k):null;h+=row(k,n<=3?'#e04a3a':'#58e0ec',`${nm} · 「${k}」${sp&&sp.name?' '+esc(sp.name):''}`,`${eff}<br>${bar(n,L,n<=3?'#e04a3a':'#58e0ec')}<small>${n<=3?'Fissurée : ':''}encore ${n} combat${n>1?'s':''} sur ${L}</small>`)}
   else h+=row('◇','var(--sub)',`${nm} · vide`,`${E['last'+sl]?`Dernière pierre : 「${E['last'+sl]}」, brisée. `:''}La forgeronne sertit un kanji tracé à deux étoiles ou plus.`)}
  h+=`<div class="sw" style="border:0;padding:10px 0 4px"><span>Omamori portés · ${om.length} / ${slots}</span></div>`;
  for(let i=0;i<slots;i++){const k=om[i];if(k&&OM[k])h+=`<div class="mi">${icon(IM['I_OM_'+k.toUpperCase()],OM[k][0],'#e04a3a')}<div class="t"><b>${OM[k][0]} · ${esc(OM[k][1])}</b>${esc(OM[k][2])}</div></div>`;
   else h+=row('○','var(--sub)','Emplacement libre',i===2?'Débloqué au rang Maître.':'Fabrique un omamori chez la forgeronne, puis « Porter mes omamori ».')}
  if(slots<3)h+=row('🔒','var(--sub)','3e emplacement','Se débloque au rang Maître (dojo).');
  const own=Object.keys(OM).filter(k=>S.it['om_'+k]>0&&!om.includes(k));if(own.length)h+=`<p style="font-size:12px;color:var(--sub);margin:4px 0">Dans le sac : ${own.map(k=>OM[k][0]+' '+esc(OM[k][1])).join(' · ')}</p>`;
  h+=`<div class="sw" style="border:0;padding:10px 0 4px"><span>En cours</span></div>`;
  const b=S.buff&&S.buff.n>0?BUFF[S.buff.k]:null;h+=b?row('食','#f4a3c8',`Plat : ${b[1]}`,`${jpHtml([b[0]])} · ${b[2]}<br><small>encore ${S.buff.n} combat${S.buff.n>1?'s':''}</small>`):row('食','var(--sub)','Aucun plat','Cuisine à l\'auberge : un bonus pour 3 combats.');
  h+=row('狸',techOK('tan')?'#c89018':'var(--sub)','Marmite de Tanuki',techOK('tan')?'Prête : dans le sac, en combat, une fois par combat.':'Résous 2 énigmes de bourg pour l\'apprendre.');
  h+=row('影',techOK('kage')?'#9f8cff':'var(--sub)','Encre de Kage',techOK('kage')?'Prête : dans le sac, en combat, une fois par combat.':'Répare 2 stèles pour l\'apprendre.');
  const out=(1+.1*sw)*(window.DMGMUL?DMGMUL('out',null):1),inn=(1-.07*ar)*(window.DMGMUL?DMGMUL('in',null):1);
  h+=`<div class="sw" style="border:0;padding:10px 0 4px"><span>Bilan des forces</span></div><div class="pcsum">
   <div><b>${pct(out)}</b><small>dégâts infligés</small></div><div><b>${pct(inn)}</b><small>dégâts reçus</small></div><div><b>${mh}</b><small>PV max</small></div></div>
   <p style="font-size:11px;color:var(--sub);margin:4px 0 0">Sans compter les pierres de kanji, qui jouent selon le yōkai en face.</p>`;
  return h};
 const css=document.createElement('style');css.textContent=`
 .pctop{display:flex;gap:12px;align-items:stretch;padding:4px 0 10px;border-bottom:2px dashed #3a4566}
 .pcimg{width:96px;flex:none;background:radial-gradient(circle at 50% 70%,#3a4a78,#1a2236);border-radius:10px;display:flex;align-items:flex-end;justify-content:center;border:2px solid #7a5420}
 .pcimg img{width:84px;height:110px;object-fit:contain;image-rendering:pixelated}
 .pcid{flex:1;min-width:0;display:flex;flex-direction:column;gap:2px;font-size:13px}.pcid b{font-size:20px;font-weight:400}.pcid small{font-size:11px;color:var(--sub)}
 .pcst{font-size:14px}.pcl{margin-top:4px}
 .pcbar{display:block;height:7px;background:#1a2236;border-radius:4px;overflow:hidden;margin:2px 0;border:1px solid #3a4566}.pcbar i{display:block;height:100%}
 .pcpips{display:inline-flex;gap:3px;vertical-align:middle;margin:2px 0}.pcpips i{width:16px;height:8px;border-radius:2px;border:1px solid #0d1020}
 .pcsum{display:grid;grid-template-columns:repeat(3,1fr);gap:6px}.pcsum div{background:#1a2236;border:1px solid #3a4566;border-radius:8px;padding:8px 4px;text-align:center}.pcsum b{display:block;font-size:18px;color:var(--gold)}.pcsum small{font-size:11px;color:var(--sub)}`;
 document.head.appendChild(css);
})();

/* ---------- Rivage animé : le bord de l'eau devient une courbe douce, l'écume monte sur le sable et redescend ----------
   Lac du village de Kome (zone 0) et plage des naufragés (zone 17). Les bords d'eau sont regroupés en petits morceaux ;
   chacun calcule son contour arrondi (masque de l'eau flouté) la première fois qu'il passe à l'écran,
   puis sa bande de rivage est redessinée dix fois par seconde tant qu'il est visible. */
(()=>{
 const T=16;
 /* sable des coins arrondis : couleurs fixes pour Kome (dalles crème), texture de la plage pour le bourg 17 */
 const ZS={17:{sea:'T_PLA',sand:'T_PL',cream:null,amp:.34,wave:1.3,blur:16}};
 let CL=null;
 const M=()=>MAPS.world;
 function texPix(k){const im=XI[k];if(!im||!im.width)return null;const c=document.createElement('canvas');c.width=c.height=16;const x=c.getContext('2d');x.imageSmoothingEnabled=false;x.drawImage(im,0,0,16,16);return x.getImageData(0,0,16,16).data}
 function blur(a,w,h,r){const o=new Float32Array(w*h),t=new Float32Array(w*h);
  for(let y=0;y<h;y++){let s=0;for(let x=-r;x<=r;x++)s+=a[y*w+Math.min(w-1,Math.max(0,x))];for(let x=0;x<w;x++){t[y*w+x]=s/(2*r+1);s+=a[y*w+Math.min(w-1,x+r+1)]-a[y*w+Math.max(0,x-r)]}}
  for(let x=0;x<w;x++){let s=0;for(let y=-r;y<=r;y++)s+=t[Math.min(h-1,Math.max(0,y))*w+x];for(let y=0;y<h;y++){o[y*w+x]=s/(2*r+1);s+=t[Math.min(h-1,y+r+1)*w+x]-t[Math.max(0,y-r)*w+x]}}return o}
 const at=(x,y)=>{const r=M().rows[y];return r?r[x]:'T'},isW=c=>c==='~'||c==='P';
 /* les cases de rivage : de l'eau contre de la terre praticable (pas contre une falaise) */
 function init(){const m=M();CL=[];const E=[];
  for(let y=1;y<m.h-1;y++){const z=m.zone(y);if(!(z in ZS))continue;for(let x=1;x<m.w-1;x++){const c=at(x,y);if(c==='T'&&z!==17)continue;const w=isW(c);
   if([[1,0],[-1,0],[0,1],[0,-1]].some(([a,b])=>{const k=at(x+a,y+b);return (k!=='T'||z===17)&&isW(k)!==w&&m.zone(y+b)===z}))E.push([x,y,z])}}
  /* on les regroupe par blocs de 24 × 12 cases */
  const B={};for(const[x,y,z]of E){const k=z+':'+(x/24|0)+':'+(y/12|0);(B[k]||(B[k]={z,x0:1e9,y0:1e9,x1:-1,y1:-1,bx0:(x/24|0)*24,by0:(y/12|0)*12}));const b=B[k];b.x0=Math.min(b.x0,x);b.y0=Math.min(b.y0,y);b.x1=Math.max(b.x1,x);b.y1=Math.max(b.y1,y)}
  for(const b of Object.values(B)){b.x0=Math.max(0,b.x0-2);b.y0=Math.max(0,b.y0-2);b.x1=Math.min(m.w-1,b.x1+2);b.y1=Math.min(m.h-1,b.y1+2);b.W=(b.x1-b.x0+1)*T;b.H=(b.y1-b.y0+1)*T;b.ok=null;b.last=-1;CL.push(b)}}
 function build(b){const m=M(),zs=ZS[b.z],sea=texPix(zs.sea),sand=zs.sand?texPix(zs.sand):null;if(!sea||(zs.sand&&!sand)){b.ok=false;return}
  const{W,H}=b,wm=new Float32Array(W*H),skip=new Uint8Array(W*H);
  for(let cy=b.y0;cy<=b.y1;cy++)for(let cx=b.x0;cx<=b.x1;cx++){const c=at(cx,cy),v=isW(c)?1:0,sk=(c==='P'||(c==='T'&&b.z!==17)||m.zone(cy)!==b.z||(!isW(c)&&[0,1,2].some(d=>{const k=at(cx,cy+d);return 'TcobJSlDq'.includes(k)||(typeof DECM!=='undefined'&&DECM[cx+','+(cy+d)])})))?1:0;
   for(let j=0;j<T;j++)for(let i=0;i<T;i++){const k=((cy-b.y0)*T+j)*W+(cx-b.x0)*T+i;wm[k]=v;skip[k]=sk}}
  const v=blur(blur(wm,W,H,zs.blur),W,H,zs.blur),idx=[];
  for(let k=0;k<W*H;k++){if(skip[k])continue;const q=v[k];if(q>.06&&q<.85)idx.push(k)}
  const cv=document.createElement('canvas');cv.width=W;cv.height=H;const g=cv.getContext('2d');
  Object.assign(b,{ok:true,v,wm,idx:Int32Array.from(idx),cv,g,img:g.createImageData(W,H),sea,sand,zs})}
 function paint(b,t){const{W,v,idx,wm,img,sand,sea,zs}=b,d=img.data,A=zs.amp,X0=b.x0*T;
  for(let n=0;n<idx.length;n++){const k=idx[n],x=k%W,y=(k/W)|0,q=v[k],cw=wm[k]>.5,gx=X0+x,tp=((y&15)*16+(gx&15))*4;
   const ph=Math.sin(t*2.1*zs.wave+gx/42+Math.sin(gx/19)*.7),lv=.5-A*(.5+.5*ph);   /* jusqu'où l'eau monte à cet instant */
   let r=0,g_=0,bl=0,a=0;
   const fo=Math.abs(q-lv)<.026+.014*Math.sin(gx*.27+t*3)+.008*Math.sin(gx*.71-t*5),w2=.6+.2*((t*.33*zs.wave+gx/320)%1),fo2=q>.56&&Math.abs(q-w2)<.016&&Math.sin(gx/9+t*1.8)>-.1;
   if(fo){r=248;g_=252;bl=255;a=235}
   else if(q>=lv){if(!cw){r=sea[tp];g_=sea[tp+1];bl=sea[tp+2];a=150}else if(fo2){r=225;g_=245;bl=250;a=150}}       /* lame d'eau sur le sable */
   else{const wet=q>.5-A;
    if(cw){let c;if(sand)c=[sand[tp],sand[tp+1],sand[tp+2]];else{const dot=((gx*7+y*13)%11)<2;c=zs.cream[dot?1:0]}r=c[0]*(wet?.9:1);g_=c[1]*(wet?.88:1);bl=c[2]*(wet?.84:1);a=255}   /* coin d'eau carré : redevient sable */
    else if(wet){r=150;g_=120;bl=80;a=Math.round(70*(q-(.5-A))/A+25)}}                                                                   /* sable mouillé */
   const o=k*4;d[o]=r;d[o+1]=g_;d[o+2]=bl;d[o+3]=a}
  b.g.putImageData(img,0,0)}
 const oD=window.XDRAW;window.XDRAW=(mid,L,g,X,Y,VW,VH)=>{oD&&oD(mid,L,g,X,Y,VW,VH);if(mid!=='world')return;if(!CL)init();
  const now=performance.now(),t=S.fxoff?0:now/1000,fr=S.fxoff?0:Math.floor(now/100);
  for(const b of CL){const px=b.x0*T-X,py=b.y0*T-Y;if(px>VW||py>VH||px+b.W<0||py+b.H<0)continue;
   if(b.ok===null)build(b);if(!b.ok)continue;if(fr!==b.last){b.last=fr;paint(b,t)}
   const sx=(Math.max(b.bx0,b.x0)-b.x0)*T,sy=(Math.max(b.by0,b.y0)-b.y0)*T,sw=(Math.min(b.bx0+24,b.x1+1)-Math.max(b.bx0,b.x0))*T,sh=(Math.min(b.by0+12,b.y1+1)-Math.max(b.by0,b.y0))*T;if(sw>0&&sh>0)L.push({y:-1e9,f:()=>g.drawImage(b.cv,sx,sy,sw,sh,px+sx,py+sy,sw,sh)})}};
 window.RIVAGE={reset:()=>{CL=null},st:()=>CL};
})();

/* ---------- 影 : discussion libre avec le démon (IA) ---------- */
const Chat=(()=>{
 let sample=null,ready=false,turns=[],busy=false,ctl=null,prev='world',shown=[];
 (async()=>{try{sample=window.claude&&window.claude.use?await window.claude.use('sample'):null}catch(e){sample=null}ready=true})();
 const RB=/([一-龯々ヶ]+)[\[［（(]([ぁ-ゖァ-ヺー]+)[\]］）)]/g;
 const toTok=s=>{const out=[];let i=0,m;RB.lastIndex=0;while((m=RB.exec(s))){if(m.index>i)out.push(s.slice(i,m.index));out.push(m[1]+'|'+m[2]);i=RB.lastIndex}if(i<s.length)out.push(s.slice(i));return out};
 const plain=s=>jpText(toTok(s));
 function profile(){const ls=lessonsDone().map(l=>l.title+' ('+l.sub+')'),kj=SP.filter(unl).map(s=>s.k).join(' ');
  return `débutant francophone (équivalent Duolingo niveau 12 : lit les hiragana et katakana, vocabulaire de base). Niveau en jeu : ${level(S.xp)}. Leçons de grammaire suivies : ${ls.length?ls.join(' ; '):'aucune pour l\'instant (salutations, です, phrases très simples seulement)'}. Kanji appris au tracé : ${kj||'aucun'}. Phrases dans son carnet : ${Object.keys(S.ph).length}. Combats gagnés : ${Object.keys(S.wins).length}.`}
 const rules=()=>`Tu joues un personnage dans un jeu qui apprend le japonais à un francophone.
PERSONNAGE : 影 (Kage), le démon endormi à l'intérieur de Kaito, jeune paysan d'un Japon féodal steampunk (énergie : le Kiryoku 気力 ; démons : les Yōma ; sa petite sœur s'appelle Hana). Tu lui parles dans sa tête. Ton : mystérieux, taquin mais attachant, très curieux du monde des humains (la nourriture, les saisons, les sentiments, les rêves). Tu ne révèles jamais clairement qui tu es. Jamais cruel, jamais effrayant.
BUT : faire pratiquer le japonais par une vraie conversation, fluide et intéressante. Réagis à ce que dit le joueur, rebondis dessus, pose UNE question ouverte à la fois, varie les sujets, et propose de temps en temps un petit jeu (devinette, « tu préfères A ou B ? », jeu de rôle au marché ou à l'auberge).
NIVEAU DU JOUEUR : ${profile()}
ADAPTATION : écris 1 ou 2 phrases courtes en japonais simple. Reste dans la grammaire déjà apprise, avec au maximum UN élément nouveau par message. Si le joueur répond bien en japonais, monte un peu la difficulté ; s'il écrit en français ou en rōmaji, ou fait des fautes, simplifie. Chaque kanji doit être suivi de sa lecture en hiragana entre crochets, comme 漢字[かんじ].
CORRECTION : si le dernier message du joueur est en japonais ou en rōmaji et contient une erreur, donne la version corrigée et une explication d'une phrase, avec bienveillance. S'il est en français, montre comment le dire en japonais simple. S'il est correct, laisse une chaîne vide.
FORMAT : réponds uniquement par un objet JSON, sans rien autour : {"jp":"ta réplique en japonais, lectures entre crochets","ro":"la même réplique en rōmaji Hepburn, mots séparés par des espaces","fr":"sa traduction française","fix":"correction du joueur en français, ou chaîne vide","new":"le point nouveau expliqué en une courte phrase en français, ou chaîne vide","hints":[{"jp":"une réponse possible du joueur, lectures entre crochets","fr":"traduction"}]} avec exactement 3 éléments dans hints, du plus facile au plus riche.`+(S.lang&&S.lang!=='fr'?`\nLANGUE DU JOUEUR : il ne parle pas français mais ${({en:'English',es:'Spanish',it:'Italian',de:'German'})[S.lang]||'English'}. Écris les champs fr, fix, new et hints[].fr dans cette langue (garde les noms de champs).`:'');
 const hello=()=>{const d=lessonsDone().length;return d>=3?{jp:'…起[お]きたか、海斗[かいと]。今日[きょう]は何[なに]をしましたか。',ro:'… okita ka, Kaito. kyō wa nani o shimashita ka.',fr:'… Tu es réveillé, Kaito. Qu\'as-tu fait aujourd\'hui ?',fix:'',new:'',hints:[{jp:'ごはんを食[た]べました。',fr:'J\'ai mangé.'},{jp:'あなたはだれですか。',fr:'Qui es-tu ?'},{jp:'妖魔[ようま]とたたかいました。',fr:'Je me suis battu contre un Yōma.'}]}
  :{jp:'…起[お]きたか、海斗[かいと]。元気[げんき]ですか。',ro:'… okita ka, Kaito. genki desu ka.',fr:'… Tu es réveillé, Kaito. Tu vas bien ?',fix:'',new:'',hints:[{jp:'はい、元気[げんき]です。',fr:'Oui, je vais bien.'},{jp:'あなたはだれですか。',fr:'Qui es-tu ?'},{jp:'いいえ、ねむいです。',fr:'Non, j\'ai sommeil.'}]}};
 const el=id=>$('#'+id);
 /* visage du démon : 0 calme, 1 amusé, 2 pensif, 3 surpris */
 const HDK=!!(IM.K_F0&&IM.K_BG);let faceT=0;
 function face(n,back){if(!HDK)return;clearTimeout(faceT);const f=el('cFace');f.src=IM['K_F'+n];f.classList.remove('pop');void f.offsetWidth;f.classList.add('pop');el('cStage').classList.toggle('think',n===2);if(back)faceT=setTimeout(()=>face(0),back)}
 if(HDK){const st=document.createElement('div');st.id='cStage';st.innerHTML='<img id="cFace" alt=""><i></i><i></i><i></i>';$('#pChat .lh').after(st);$('#pChat').style.backgroundImage=`linear-gradient(rgba(8,8,18,0) 30%,rgba(8,8,18,.55) 46%),url(${IM.K_BG})`;$('#pChat').classList.add('hd');el('cFace').src=IM.K_F0}
 function scroll(){const l=el('cList');l.scrollTop=l.scrollHeight}
 function addD(r){const d=document.createElement('div');d.className='msg d';const tok=toTok(String(r.jp||''));
  d.innerHTML=`<div class="jp">${jpHtml(tok)}</div><div class="kn">${esc(jpKana(tok))}</div><div class="ro">${esc(r.ro||romaji(tok))}</div><div class="fr hid" title="Touche pour voir la traduction">${esc(r.fr||'')}</div>${r.fix?`<div class="fix">✎ ${esc(r.fix)}</div>`:''}${r.new?`<div class="nw">＋ ${esc(r.new)}</div>`:''}<div class="act"><button data-a="say">🔊 Écouter</button><button data-a="tr">Traduction</button><button data-a="keep">＋ Carnet</button></div>`;
  d.onclick=e=>{const b=e.target.closest('button'),fr=d.querySelector('.fr.hid,.fr.shown');if(e.target.classList.contains('hid')||(b&&b.dataset.a==='tr')){const f=d.querySelectorAll('.fr');f[f.length-1].classList.toggle('hid')}
   else if(b&&b.dataset.a==='say')say(plain(r.jp));else if(b&&b.dataset.a==='keep'){S.cp=S.cp||[];if(!S.cp.some(x=>x.j===r.jp)){S.cp.push({j:r.jp,f:r.fr});if(S.cp.length>60)S.cp.shift()}phrAdd(tok,r.fr,'démon');S.ph[jpText(tok)]=1;save();b.textContent='✓ Ajouté';sfx('item')}};
  el('cList').appendChild(d);hints(r.hints||[]);scroll();say(plain(r.jp))}
 function addMe(t){const d=document.createElement('div');d.className='msg me';d.textContent=t;el('cList').appendChild(d);scroll()}
 function sys(t){const d=document.createElement('div');d.className='msg sys';d.textContent=t;el('cList').appendChild(d);scroll();return d}
 function hints(hs){el('cHints').innerHTML=hs.slice(0,3).map((h,i)=>`<button data-i="${i}">${jpHtml(toTok(String(h.jp||'')))}<small>${esc(h.fr||'')}</small></button>`).join('');el('cHints').onclick=e=>{const b=e.target.closest('button');if(b&&!busy)send(plain(hs[+b.dataset.i].jp))}}
 const ERR={not_granted:'Le démon se tait : l\'accès à l\'IA n\'a pas été autorisé pour cette page.',sampling_disabled:'Le démon se tait : l\'IA n\'est pas disponible sur ce compte.',rate_limited:'Le démon est épuisé… Réessaie dans un moment.',session_expired:'Ta session a expiré : reconnecte-toi puis reviens.',refused:'Le démon refuse de répondre à ça. Essaie autre chose.',invalid_json:'Le démon marmonne quelque chose d\'incompréhensible. Renvoie ton message.'};
 async function send(t){t=String(t||'').trim();if(!t||busy)return;el('cIn').value='';addMe(t);el('cHints').innerHTML='';
  if(!sample){sys('Le démon ne répond pas ici : la discussion par IA ne fonctionne que dans la page publiée sur claude.ai.');return}
  busy=true;el('cSend').disabled=true;const wait_=sys('影 réfléchit…');face(2);turns.push({role:'user',content:'Joueur : '+t});if(turns.length>17)turns.splice(1,turns.length-17);
  ctl=new AbortController();
  try{const r=await sample.json(turns,{cache:false,modelTier:'quick',signal:ctl.signal});wait_.remove();
   if(!r||typeof r!=='object'||!r.jp)throw{code:'invalid_json'};turns.push({role:'assistant',content:JSON.stringify(r)});addD(r);face(r.fix?3:/[ぁ-んァ-ン]/.test(t)?1:0,r.fix?6000:5000);
   if(/[ぁ-んァ-ン]/.test(t)){Quest.add('chat');S.xp+=1;S.chatN=(S.chatN||0)+1}save()}
  catch(e){wait_.remove();turns.pop();face(0);if(e&&e.code!=='cancelled')sys(ERR[e&&e.code]||'Le lien avec le démon s\'est rompu. Renvoie ton message.')}
  busy=false;el('cSend').disabled=false}
 function reset(){if(ctl)ctl.abort();turns=[{role:'user',content:rules()+'\n\nLe joueur ouvre la conversation. Commence.'}];const h=hello();turns.push({role:'assistant',content:JSON.stringify(h)});el('cList').innerHTML='';addD(h);face(0);
  if(ready&&!sample)sys('Ici, le démon ne peut dire que cette phrase : la discussion par IA ne fonctionne que dans la page publiée sur claude.ai.')}
 function drawScene(t){g.fillStyle='#120e24';g.fillRect(0,0,SW,SH);
  for(let i=0;i<40;i++){const h=hash(i,77),x=h%SW,y=((h>>>8)%SH+SH-(t*(6+h%9))%SH)%SH;g.fillStyle=i%3?'rgba(138,88,200,.35)':'rgba(88,224,236,.3)';g.fillRect(x,Math.round(y),1+h%2,1+h%2)}
  for(let r=70;r>20;r-=10){g.fillStyle=`rgba(138,88,200,${.05+(70-r)*.004})`;g.beginPath();g.arc(120,92,r+Math.sin(t*2)*3,0,7);g.fill()}
  const im=bspr('wisp','#8a58c8'),bob=Math.round(Math.sin(t*2.2)*3);g.drawImage(im,120-40,46+bob,80,88);
  if(busy){g.fillStyle='#e8dcff';for(let i=0;i<3;i++)g.fillRect(108+i*10,150+(Math.floor(t*4)%3===i?-3:0),4,4)}}
 function open(){if(G.busy||G.scene!=='world')return;au();G.busy=true;prev=G.scene;G.scene='chat';$('#banner').classList.remove('on');UI.panel('chat');sfx('sel');music(IM.A_kage?'kage':'bamboo');if(!turns.length)reset();else scroll()}
 async function close(){if(ctl)ctl.abort();const old=S.chatX||S.xp;sfx('back');G.scene='world';G.busy=false;UI.panel('pad');W.refreshZone();save()}
 el('cForm').addEventListener('submit',e=>{e.preventDefault();send(el('cIn').value)});
 el('cQuit').onclick=close;el('cNew').onclick=()=>{if(!busy){sfx('tap');reset()}};
 $('#kDemon').onclick=()=>window.KEIKO?KEIKO.open():open();try{$('#cAv').src=HDK?IM.K_F0:bspr('wisp','#8a58c8').toDataURL()}catch(e){}
 (S.cp||[]).forEach(x=>phrAdd(toTok(x.j),x.f,'démon'));
 return{open,close,drawScene,toTok,ai:()=>!!sample}})();

/* ---------- ACTE III · bourg 12 : le port des dirigeables (décor, scènes, gardien, envol) ---------- */
/* --- le sol : planches de pont, passerelles à rambarde, caillebotis et mer de nuages --- */
HDC[12]={need:'T_AP3',base:h=>h<78?'T_AP3':h<95?'T_AP4':'T_APO',t:(c,h)=>({w:'T_APG',_:'T_AP3',',':'T_AP3'})[c]||(h<78?'T_AP3':'T_AP4')};
JZI[12]='X_P_JIZO';
(()=>{
 const T=16,z12=()=>{let y=0;while(y<MAPS.world.h&&MAPS.world.zone(y)!==12)y++;return y};let TOP=null;
 const at_=(x,y)=>{const M=MAPS.world;if(x<0||x>=M.w||y<0||y>=M.h)return ' ';return M.rows[y][x]};
 const cloud=(x,y)=>{const M=MAPS.world;if(x<0||x>=M.w||y<0||y>=M.h)return true;if(M.zone(y)!==12)return false;const c=at_(x,y);return c==='T'||c==='~'};
 const ROT=(X,im,px,py,k)=>{X.save();X.translate(px+T/2,py+T/2);X.rotate((k&3)*Math.PI/2);if(k&4)X.scale(-1,1);X.drawImage(im,-T/2,-T/2,T,T);X.restore()};
 ZT[12]=(X,c,x,y,h)=>{const px=x*T,py=y*T;
  if(c==='T'||c==='~'){if(XI.T_SKYC&&XI.T_SKYC.width)X.drawImage(XI.T_SKYC,(x%4)*48,(y%4)*48,48,48,px,py,T,T);else ROT(X,XI.T_APS,px,py,hash(x*17+5,y*29+3)%8);
   const dU=!cloud(x,y-1),dD=!cloud(x,y+1),dL=!cloud(x-1,y),dR=!cloud(x+1,y);
   /* bord du pont vu d'en haut : poutre sombre et ombre portée sur les nuages */
   if(dU){X.fillStyle='#3b2a1f';X.fillRect(px,py,T,3);X.fillStyle='#6b4e34';X.fillRect(px,py,T,1);X.fillStyle='rgba(70,80,120,.30)';X.fillRect(px,py+3,T,5);X.fillStyle='rgba(70,80,120,.14)';X.fillRect(px,py+8,T,4)}
   if(dL){X.fillStyle='#3b2a1f';X.fillRect(px,py,2,T);X.fillStyle='rgba(70,80,120,.22)';X.fillRect(px+2,py,4,T)}
   if(dR){X.fillStyle='#3b2a1f';X.fillRect(px+T-2,py,2,T);X.fillStyle='rgba(70,80,120,.12)';X.fillRect(px+T-5,py,3,T)}
   if(dD){X.fillStyle='#8a6a48';X.fillRect(px,py+T-2,T,1);X.fillStyle='#2a1d15';X.fillRect(px,py+T-1,T,1)}
   return true}
  if(c==='w'){X.drawImage(XI.T_APG,px,py,T,T);X.fillStyle='#2e3440';if(at_(x,y-1)!=='w')X.fillRect(px,py,T,1);if(at_(x,y+1)!=='w')X.fillRect(px,py+T-1,T,1);if(at_(x-1,y)!=='w')X.fillRect(px,py,1,T);if(at_(x+1,y)!=='w')X.fillRect(px+T-1,py,1,T);return true}
  if(c==='='||c==='G'){const L=cloud(x-1,y),R=cloud(x+1,y),U=cloud(x,y-1),D=cloud(x,y+1);
   /* passerelle entre deux nuages : planches et rambarde de laiton du côté du vide */
   if(L&&!R)X.drawImage(XI.T_APL,px,py,T,T);else if(R&&!L)X.drawImage(XI.T_APL2,px,py,T,T);
   else if(U&&!D){X.save();X.translate(px+T/2,py+T/2);X.rotate(Math.PI/2);X.drawImage(XI.T_APL,-T/2,-T/2,T,T);X.restore()}
   else if(D&&!U){X.save();X.translate(px+T/2,py+T/2);X.rotate(Math.PI/2);X.drawImage(XI.T_APL2,-T/2,-T/2,T,T);X.restore()}
   else X.drawImage(XI[h<7?'T_AP2':'T_AP'],px,py,T,T);
   return true}
  return false};
 /* --- objets du port, et le dirigeable amarré au bout des pontons --- */
 let SHIP=null;const ship=()=>{if(SHIP)return SHIP;const im=XI.X_P_SHIP;if(!im||!im.width)return null;const k=.62,c=document.createElement('canvas');c.width=Math.round(im.width*k/1.902*1.9);c.height=Math.round(im.height*k/1.902*1.9);const g=c.getContext('2d');g.imageSmoothingEnabled=true;g.drawImage(im,0,0,c.width,c.height);return SHIP=c};
 ZP[12]={need:'X_P_LANT',f:(add,c,x,y,h,dx,dy)=>{if(TOP===null)TOP=z12();
  if(c==='l')add(x,y,XI.X_P_LANT,0,-1,1,1);else if(c==='o')add(x,y,XI.X_P_CRATE,0,-1,0,1);else if(c==='b')add(x,y,x-RX(y)===21&&XI.X_P_SOCK&&XI.X_P_SOCK.width?XI.X_P_SOCK:XI.X_P_POST,0,-1,0,1);
  else if(c==='c')add(x,y,XI[h<50?'X_P_SACK':'X_P_CART'],0,-1,0,1);else if(c==='S')add(x,y,XI.X_P_SIGN,0,-1,0,1);
  else if(c==='~'&&x-RX(y)===4&&y===TOP+5){const s=ship();if(s)add(x,y,s,8,-2,1,1)}}};
 /* --- brumes qui glissent sur la mer de nuages --- */
 ZFX[12]=(g,P,vis,tt,hh,ya,yb,X,Y)=>{lampGlow(g,12,tt,X,Y);const SK=smokeSpr('255,255,255');g.globalAlpha=.16;for(let i=0;i<Math.round(hh/80);i++){const[px,py]=P(i+40,7,0,0);if(vis(px,py,90))g.drawImage(SK.band,px-70,py-21,140,42)}
  g.globalAlpha=1;for(let i=0;i<Math.round(hh/40);i++){const[px,py]=P(i+200,2,-1,6);if(!vis(px,py,4))continue;const k=.5+.5*Math.sin(tt*2+i*1.7);g.fillStyle=`rgba(255,248,225,${.25+.4*k})`;g.fillRect(Math.round(px),Math.round(py),1,1)}};
})();
/* --- lampadaires à lumière bleue : un halo qui respire (bourgs de l'acte III) --- */
window.LAMPS={};window.lampGlow=(g,z,tt,X,Y)=>{let L=LAMPS[z];if(!L){L=LAMPS[z]=[];const M=MAPS.world;for(const k in DECM){if(DECM[k][0]!=='lamp')continue;const[x,y]=k.split(',').map(Number);if(M.zone(y)===z)L.push([x,y])}if(z===14||z===15)for(let y=0;y<M.h;y++){if(M.zone(y)!==z)continue;for(let x=0;x<M.w;x++)if(M.rows[y][x]==='l')L.push([x,y])}}
 for(let i=0;i<L.length;i++){const[x,y]=L[i],px=x*16+5-X,py=y*16-4-Y;if(px<-40||px>500||py<-40||py>900)continue;const k=.75+.25*Math.sin(tt*1.8+i*1.3),r=g.createRadialGradient(px,py,1,px,py,26*k);r.addColorStop(0,'rgba(140,235,255,.55)');r.addColorStop(.45,'rgba(80,190,255,.22)');r.addColorStop(1,'rgba(60,160,255,0)');g.fillStyle=r;g.fillRect(px-30,py-30,60,60)}};
/* --- les bourgs reliés par les airs ne se voient pas : une mer de nuages couvre la frontière --- */
window.ZCOVER=(g,X,Y,VW,VH,zh,zoneAt)=>{if(zh<12||zh>14)return;const M=MAPS.world,T=16,tt=performance.now()/1000;let y0=Math.floor(Y/T),y1=Math.ceil((Y+VH)/T);
 for(let y=Math.max(1,y0);y<=Math.min(M.h-1,y1);y++){const a=zoneAt(y-1),b=zoneAt(y);if(a===b||Math.min(a,b)<12||Math.max(a,b)>14)continue;
  /* a = bourg du nord, b = bourg du sud ; on masque celui où le joueur n'est pas */
  const hb=y*T-Y,up=zh===b;const top=up?-10:hb-6,bot=up?hb+6:VH+10;
  const gr=g.createLinearGradient(0,up?hb+26:hb-26,0,hb);gr.addColorStop(0,'rgba(240,244,252,0)');gr.addColorStop(1,'rgba(240,244,252,.97)');g.fillStyle=gr;g.fillRect(0,up?hb:hb-26,VW,26);
  g.fillStyle='#eef2fa';g.fillRect(0,Math.max(-10,top),VW,Math.max(0,bot-top));
  g.fillStyle='rgba(255,255,255,.95)';for(let i=0;i<11;i++){const cx=((i*61+tt*(3+i%3))%(VW+80))-40,cy=hb+(up?-4-(i%3)*6:4+(i%3)*6);g.beginPath();g.ellipse(cx,cy,18+(i%4)*5,7+(i%3)*2,0,0,7);g.fill()}
  g.fillStyle='rgba(200,210,230,.5)';for(let i=0;i<6;i++){const cx=((i*97+tt*2)%(VW+80))-40,cy=(up?hb-40:hb+40)+(i%2)*30;g.beginPath();g.ellipse(cx,cy,30,8,0,0,7);g.fill()}}};
/* --- histoire --- */
(()=>{
 const J=(n,jp,fr,x)=>({n,jp,fr,x}),T_=(n,t)=>({n,t}),KG='影',KA='Kaito',HN='Lettre de Hana',CK='Capitaine Kumo',NU='Nue des nuages',TL='Lettre de Tetsu',OPP=[1,0,3,2];
 Object.assign(PORT,{[CK]:'PX_capi','Mécanicienne':'PX_meca','Chef de gare':'PX_ekichou','Vendeuse d\'ekiben':'PX_eki',[NU]:'PX_gnue',Hana:'PX_hana'});
 const H12=()=>HAMS.find(h=>h.z===12);
 {const h=H12();if(h)NPCS.world.push({id:'capi',spr:'capi',x:15,y:h.y0+11,ev:'capi',dir:0})}
 /* ouverture de l'acte III : la lettre interrompue, l'enlèvement, le port */
 async function opening(){S.fl.act3c=1;save();music(null);
  await D.say(["Au bout de la passerelle des forges, un moineau mécanique se pose sur ton épaule. Il porte une lettre. Tu reconnais l'écriture, et les taches de sauce.",
   J(HN,['お兄ちゃん|おにいちゃん','へ','。','今日|きょう','、','空|そら','が','黒く|くろく','なりました','。'],"À mon grand frère. Aujourd'hui, le ciel est devenu noir.",'黒く なりました = est devenu noir (〜くなります : devenir)'),
   J(HN,['大きい|おおきい','船|ふね','が','村|むら','の','上|うえ','に','…'],'Un grand bateau, au-dessus du village…','上 (うえ) = au-dessus'),
   "La phrase s'arrête là. L'encre a filé en travers de la page, comme si on lui avait arraché le pinceau."]);
  await Cine.say('N_S9',["Kome, trois jours plus tôt. Un dirigeable noir, marqué d'une enclume, s'arrête au-dessus des rizières.","Deux bras de fer descendent dans une colonne de lumière blanche.",
   J('Hana',['はなして','！','はなして','ください','！'],'Lâchez-moi ! Lâchez-moi !','はなして : forme en て de はなす, lâcher'),
   "Les villageois crient. Le dirigeable remonte, sans un bruit, vers le nord.",T_(KG,"… Kaito. Respire. Ton cœur cogne si fort contre moi que je n'entends plus rien d'autre.")]);
  await ActCard.show('第三幕','ACTE III','Les cieux de Tetsu');
  await Cine.say('N_S10',["Le port des dirigeables. Des quais de bois suspendus au-dessus d'une mer de nuages.","Au loin, le dirigeable noir remonte vers une forteresse posée sur un rocher volant.",
   T_(KG,"La citadelle de Tetsu. Elle est là-dedans, je le sens. Et je sens aussi… autre chose. Un morceau de lui."),
   J(KA,['花|はな','、','待って|まって','ください','。'],"Hana, attends-moi.",'待って ください = attends, s\'il te plaît'),T_(KG,"Elle ne t'entend pas. Moi, si. Et je viens aussi.")]);
  music(ZONES[12].mus);W.refreshZone();save()}
 {const o=STORY.triggers;STORY.triggers=(x,y)=>{if(W.map==='world'&&!S.fl.act3c&&(S.wins.baku||S.fl.visit)&&W.zone()===12)return opening;return o(x,y)}}
 /* une lettre sous le Jizō du port : ce n'est pas l'écriture de Hana */
 {const oJ=STORY.jizo;STORY.jizo=async e=>{if(W.zone()===12&&!S.fl.let12){S.fl.let12=1;sfx('item');
   await D.say(["Sous la statue, une enveloppe noire, scellée d'une enclume. L'écriture est magnifique. Chaque trait est parfait.",
    J(TL,['海斗|かいと','くん','へ','。'],'À Kaito.'),J(TL,['妹|いもうと','さん','は','元気|げんき','です','。'],'Ta petite sœur va bien.','妹 (いもうと) = petite sœur'),
    J(TL,['心配|しんぱい','しないで','ください','。'],"Ne t'inquiète pas.",'心配 (しんぱい) = inquiétude · 〜しないでください = ne fais pas…'),
    J(TL,['あなた','の','影|かげ','を','持って|もって','来て|きて','ください','。'],'Apporte ton ombre.','持って来ます (もってきます) = apporter'),
    T_(KG,"… Il sait que je suis là."),T_(KG,"Et il écrit bien. C'est ce qui me fait le plus peur.")]);save()}return oJ(e)}}
 /* le gardien : la Nue du mât d'amarrage */
 const PRE=["Au bout du dernier ponton, sur le mât d'amarrage, une silhouette se déplie. Une tête de singe, des pattes de tigre, une queue qui siffle comme un serpent. Dans son dos, une hélice de laiton tourne au ralenti.",
  J(NU,['ヒョー','…','ヒョー','…'],'Hyoo… hyoo…','Dans les légendes, le cri de la Nue ressemble à celui d\'un oiseau de nuit'),
  T_(KG,"Chaque cri lui rapporte un mot. Elle les garde dans sa gorge, tout au fond, avec les éclairs."),
  J(NU,['空|そら','は','私|わたし','の','です','。'],'Le ciel est à moi.','私の = à moi'),T_(NU,"On m'a posée ici avec une hélice et un ordre : que rien ne décolle. Je ne sais pas pourquoi. Je sais seulement que les mots des pilotes ont un goût de vent."),
  J(KA,['返して|かえして','ください','。'],'Rends-les, s\'il te plaît.','返します (かえします) = rendre')];
 const POST=["L'hélice s'arrête. Un long cri sort de la gorge de la Nue, et avec lui une volée de mots qui s'envolent vers les hangars.",
  J(NU,['…','空|そら','は','広い|ひろい','です','ね','。'],'… Le ciel est grand, hein.','広い (ひろい) = vaste'),
  T_(NU,"Cent ans que je ne l'avais pas regardé. J'étais trop occupée à le garder."),"Elle déplie ses ailes de toile et s'en va vers le sud, très lentement, comme on rentre chez soi."];
 {const oG=STORY.guard;STORY.guard=async(e,seen)=>{if(e.rov||e.id!=='nue'||!Gates.meets('nue'))return oG(e,seen);const H=W.H;W.faceTo(e,H);
  if(!S.fl.gp_nue){S.fl.gp_nue=1;await D.say(PRE)}else await D.say(J(NU,['ヒョー','…'],'Hyoo…'));
  const r=S.fl.visit?(await D.say('(Mode visite : la Nue te laisse passer sans combat.)'),'win'):await Battle.start(EN.nue,{zone:12});
  if(r!=='win'){delete S.wins.nue;if(r==='lose')await D.say('Tu reprends tes esprits… Tes PV sont restaurés. La Nue a gardé ton dernier mot. Révise et reviens le lui reprendre.');else{await W.walk(H,OPP[H.dir],.2);H.cd=6}save();return}
  S.wins.nue=1;W.remove(e);save();await D.say(POST);sfx('door');
  /* le capitaine accourt */
  const c=W.spawn({npc:1,spr:'capi',x:H.x,y:H.y+4,dir:1,ev:'capi'});await W.emote(c);try{await W.walkNear(c,H)}catch(x){}W.faceTo(H,c);W.faceTo(c,H);
  await D.say([J(CK,['離陸|りりく','！','離陸|りりく','！'],'Décollage ! Décollage !','離陸 (りりく) = décollage'),T_(CK,"Je l'ai ! Le mot est revenu ! Trois semaines que je l'avais sur le bout de la langue. Merci, petit. Je t'emmène où tu veux."),J(KA,['鉄|てつ','の','城|しろ','へ','行きたい|いきたい','です','。'],'Je veux aller au château de Tetsu.','城 (しろ) = château · 〜へ行きたい = vouloir aller à…'),T_(CK,"Chez Tetsu. Évidemment. Personne ne veut jamais aller dans un endroit agréable.")]);
  W.remove(c);await board()}}
 /* le capitaine, devant le hangar */
 STORY.capi=async e=>{
  if(!S.wins.nue)return D.say([J(CK,['船|ふね','は','飛びません|とびません','。'],'Le dirigeable ne vole pas.','飛びます (とびます) = voler'),T_(CK,"Il est en parfait état. C'est moi qui ne le suis pas. Depuis que la Nue crie sur le mât, je ne sais plus dire le mot. Le mot pour partir. Celui qui commence par… non. Envolé, c'est le cas de le dire."),T_(CK,"Le mât d'amarrage est au nord, au bout des pontons. Chasse-la, petit, et je t'emmène où tu veux. Même chez Tetsu. Surtout chez Tetsu : il me doit trois amarres.")]);
  if(S.fl.fly12&&!(window.Act3&&Act3.crash))return D.say([J(CK,['また','飛びましょう|とびましょう','。'],'On revolera.','〜ましょう = « faisons… »'),T_(CK,"Le ballon est en réparation. La mécanicienne a trouvé quatorze trous et un tanuki. Le tanuki dit qu'il n'y est pour rien. La suite du voyage arrive bientôt.")]);
  return board()};
 async function board(){const i=await D.ask(J(CK,['乗りますか|のりますか','。'],'Tu montes à bord ?','乗ります (のります) = monter (dans un véhicule)'),[{jp:['はい','、','乗ります|のります','。'],fr:'Oui, je monte'},{jp:['まだ','です','。'],fr:'Pas encore'}]);
  if(i!==0)return D.say(T_(CK,"Je t'attends devant le hangar. Ne traîne pas : le vent tourne, et Tetsu aussi."));return fly()}
 /* l'envol : la vue monte du port aux îles flottantes, jusqu'à l'orage */
 function flight(fast){const host=Cine.host(),BW=448,BH=1056,bg=new Image();bg.src=IM.N_FLY;const sh=XI.X_SHIPFLY;
  const cv=document.createElement('canvas'),r=host.getBoundingClientRect(),VH=Math.round(BW*Math.min(1.9,Math.max(.9,(r.height*.8)/Math.max(1,r.width))));cv.width=BW;cv.height=VH;cv.style.cssText='width:100%;image-rendering:pixelated;display:block';host.appendChild(cv);
  const g=cv.getContext('2d'),t0=performance.now(),ease=p=>p<.5?2*p*p:1-Math.pow(-2*p+2,2)/2,CLD=[[6,30,640,2,7],[3,300,560,1,-9],[0,200,470,1,12],[2,60,380,2,-6],[7,330,300,1,5],[5,150,220,1,-11],[1,100,120,1,6]];
  let stop=false,strikeT=-1,fallT=-1,puffs=[],fin=null;const done=new Promise(res=>fin=res);
  const f=()=>{if(stop)return;const t=(performance.now()-t0)/1000;
   const p=Math.min(1,t/(fast?5:26)),e=ease(p);let sy=900-640*e,sx=224+Math.sin(t*.6)*18,rot=Math.sin(t*1.3)*.03,sc=.62-.12*e;
   if(fallT>=0){const q=Math.min(1,(t-fallT)/4.5),qq=q*q;sy=260-200*qq+Math.sin(t*9)*2;sx=224-110*qq;rot=-.35*Math.min(1,q*2)+Math.sin(t*7)*.05;sc=.5-.22*qq;if(q>=1&&fin){fin();fin=null}}
   const cy=Math.max(0,Math.min(BH-VH,sy-VH*.55));
   g.imageSmoothingEnabled=false;g.fillStyle='#07060c';g.fillRect(0,0,BW,VH);if(bg.width){g.drawImage(bg,0,-cy,BW,BH);if(window.CA&&CA.cv)CA.cv(g,bg,0,-cy,BW,BH)}
   /* pluie dans le haut du ciel */
   if(cy<420){g.strokeStyle='rgba(190,200,230,.45)';g.lineWidth=1;g.beginPath();for(let i=0;i<70;i++){const x=(i*61+t*40)%BW,y=((i*97+t*420)%430)-cy;if(y<-10||y>VH)continue;g.moveTo(x,y);g.lineTo(x-3,y+9)}g.stroke()}
   CLD.forEach(([k,x0,y,zz,sp])=>{const im=XI['X_FCL'+k];if(!im||!im.width)return;const w=im.width*zz,span=BW+w,x=((x0+t*sp)%span+span)%span-w;g.globalAlpha=.85;g.drawImage(im,Math.round(x),Math.round((y-cy-VH*.5)*(1+zz*.12)+VH*.5),w,im.height*zz);g.globalAlpha=1});
   if(sh&&sh.width){const w=sh.width*sc,h=sh.height*sc,yy=sy-cy;
    if(Math.random()<(fallT>=0?.7:.18))puffs.push({x:sx+(fallT>=0?-w*.1:w*.42),y:sy-h*(fallT>=0?.82:.25),r:2+Math.random()*2,a:fallT>=0?.8:.5,d:fallT>=0?1:0});
    puffs=puffs.filter(q=>q.a>.03);for(const q of puffs){q.y-=q.d?-.4:.2;q.x+=q.d?1.2:-.5;q.r+=.15;q.a*=.96;g.fillStyle=`rgba(${q.d?'90,90,100':'240,240,245'},${q.a})`;g.beginPath();g.arc(q.x,q.y-cy,q.r,0,7);g.fill()}
    g.save();g.translate(sx,yy);g.rotate(rot);g.drawImage(sh,-w/2,-h,w,h);
    if(strikeT>=0){g.fillStyle='rgba(20,16,24,.85)';g.beginPath();g.ellipse(-w*.08,-h*.8,w*.07,h*.05,0,0,7);g.fill()}
    g.restore()}
   /* éclairs */
   if(strikeT>=0){const s=t-strikeT;const fl=s<.12||(s>.3&&s<.38)||(fallT>=0&&Math.random()<.03);if(fl){g.fillStyle='rgba(255,255,255,.75)';g.fillRect(0,0,BW,VH)}
    if(s<.6&&sh){g.strokeStyle='rgba(235,240,255,.95)';g.lineWidth=3;g.beginPath();let x=sx+40,y=-10;g.moveTo(x,y);while(y<sy-cy-sh.height*sc*.8){x+=(Math.random()-.5)*40;y+=18;g.lineTo(x,y)}g.lineTo(sx-sh.width*sc*.08,sy-cy-sh.height*sc*.8);g.stroke()}}
   g.fillStyle=`rgba(255,240,215,${.08*e})`;g.fillRect(0,0,BW,VH);requestAnimationFrame(f)};requestAnimationFrame(f);
  return{strike(){if(strikeT<0){strikeT=(performance.now()-t0)/1000;sfx('hit');W.shake&&W.shake(.4)}},fall(){if(fallT<0)fallT=(performance.now()-t0)/1000;return done},end(){stop=true;cv.remove()}}}
 async function fly(){music(null);await UI.fade(1,350);const R=flight();await UI.fade(0,300);sfx('door');
  try{
   await D.say(["Les amarres tombent. Le dirigeable glisse hors du hangar, puis le vide s'ouvre sous la coque.",J(CK,['離陸|りりく','！'],'Décollage !','離陸 (りりく) = décollage'),
    T_(CK,"Ha ! Je vais le redire, ça fait trop de bien. Décollage !"),T_(KG,"Kaito. Je n'aime pas quand ça monte. Je te l'ai déjà dit ?"),J(KA,['高い|たかい','です','ね','。'],"C'est haut, hein.",'高い (たかい) = haut'),T_(KG,"C'est exactement ce que je n'avais pas besoin d'entendre."),
    "Au-dessus des nuages, des îles de roche flottent dans la lumière du soir. L'une porte un petit sanctuaire rouge, relié aux autres par des tuyaux.",
    T_(CK,"La citadelle est au-delà de l'orage. On passe par en dessous, on contourne par le nord, et… oh. Oh non.")]);
   R.strike();await wait(700);
   await D.say(["Un éclair déchire le ciel, puis un deuxième, beaucoup trop près. Le ballon siffle comme une bouilloire géante.",J(CK,['あ','！','穴|あな','が','あります','！'],'Ah ! Il y a un trou !','穴 (あな) = trou'),
    T_(KG,"Ce n'était pas un orage. Quelqu'un, là-haut, ne veut pas de visiteurs."),T_(CK,"Accrochez-vous ! On ne tombe pas : on atterrit très vite !")]);
   await Promise.race([R.fall(),wait(6000)])}finally{await UI.fade(1,400);R.end();Cine.hide()}
  sfx('hit');await wait(500);S.fl.fly12=1;save();
  if(window.Act3&&Act3.crash)return Act3.crash();
  await ActCard.show('つづく','À SUIVRE','Une forêt suspendue dans les nuages');
  {const h=H12();W.load('world',h?h.px:W.H.x,h?h.py:W.H.y,0);W.H.cd=2}await UI.fade(0,300);music(ZONES[12].mus);W.refreshZone();save()}
 window.Act3=Object.assign(window.Act3||{},{opening,fly,flight,board});
})();
/* --- version « actes III-IV » : une nouvelle partie commence directement au port, avec le savoir des actes I-II --- */
(()=>{if(PART!==34)return;
 Act3.start=async()=>{const G11=['kakashi','karakasa','smoke','toad','boss','yuki','nuri','umi','wanyudo','kyorin','baku','baku2'];
  Object.assign(S.fl,{intro:1,act1:1,tu_intro:1,act2c:1,act2done:1,keiko:1,keiko2:1,forgk:1,tip_w:1,tip_ham:1,tip_road:1,tut_b:1,tut_p:1,start34:1});
  ['人','土','火','木','水','風','雷'].forEach(k=>{S.sp[k]=1;S.best[k]=3});G11.forEach(k=>S.wins[k]=1);
  for(let i=1;i<=24;i++)S.les['l'+i]=1;THEMES.filter(T=>T.place<=10).forEach(T=>{(S.th||(S.th={}))[T.id]=2});
  S.vw=S.vw||{};S.vd=S.vd||{};const old=D_=>+D_.id.slice(1)<=38;Vocab.ALL.filter(w=>+w.deck.slice(1)<=38).forEach(w=>{if(!S.vw[w.key])S.vw[w.key]={i:2,d:dayN()+3}});VDECKS.filter(old).forEach(D_=>S.vd[D_.id]=2);
  S.xp=Math.max(S.xp,1800);S.gold=Math.max(S.gold||0,300);S.it.oni=Math.max(S.it.oni||0,3);S.it.cha=Math.max(S.it.cha||0,2);S.hp=maxHp();
  const h=HAMS.find(q=>q.z===12),x=(h.x0||0)+(h.ex!=null?h.ex:9),y=h.y1-1;S.pos={m:'world',x,y,d:1};S.heal={m:'world',x,y};save();
  W.load('world',x,y,1);W.H.cd=2;G.scene='world';UI.panel('pad');await UI.fade(0,400);
  await D.say(["Version « acte III » : tu commences au sortir des Grandes Forges, avec tout ce que Kaito a appris pendant les actes I et II (kanji, leçons, vocabulaire, sorts).","Ta partie est sauvegardée automatiquement dans ce navigateur. Avance d'un pas vers le nord pour commencer l'acte III."]);
  W.refreshZone();save();G.busy=false;UI.panel('pad');music(ZONES[12].mus)};
})();

/* ---------- ACTE III · bourg 13 : la forêt suspendue des renards et des tanuki ---------- */
HDC[13]={need:'T_FO',base:h=>h<62?'T_FO':h<88?'T_FO2':'T_FOS',t:(c,h)=>c==='~'?null:({_:'T_FOP',G:'T_FOP'})[c]||(h<62?'T_FO':'T_FO2')};
JZI[13]='X_K_JIZO';
(()=>{
 const T=16;
 const isT=(x,y)=>{const M=MAPS.world;if(x<0||x>=M.w||y<0||y>=M.h)return true;return M.zone(y)!==13||M.rows[y][x]==='T'};
 ZT[13]=(X,c,x,y,h)=>{const px=x*T,py=y*T;
  if(c==='~'&&XI.T_RVW&&XI.T_RVW.width){waterCell(X,x,y,'#3d5a2c',14);return true}
  if(c==='T'){X.drawImage(XI.T_FOF,px,py,T,T);X.fillStyle='rgba(6,20,10,.35)';X.fillRect(px,py,T,T);if(!isT(x,y+1)){X.fillStyle='rgba(6,16,8,.45)';X.fillRect(px,py+T-5,T,5)}return true}
  return false};
 ZP[13]={need:'X_K_LANT',f:(add,c,x,y,h,dx,dy,tg)=>{
  if(c==='T'){if(!(XI.X_TR0&&XI.X_TR0.width))return;const i=h<16?0:h<30?1:h<40?2:h<52?3:h<58?4:h<70?5:h<76?6:h<84?7:h<92?8:h<95?9:10;add(x,y,XI['X_TR'+i],dx,dy-1,1,1);if(i>3&&h%3===0)add(x,y,XI['X_TR'+(h%2)],dx>0?-5:5,1,0,1)}
  else if(c===','){if(XI.X_K_GLOWM&&XI.X_K_GLOWM.width)add(x,y,XI.X_K_GLOWM,dx,-1,0)}
  else if(c==='w'&&XI.X_TG0&&XI.X_TG0.width){const i=h<40?0:h<62?1:h<82?2:3,j=hash(x+9,y+4)%100<55?0:2;add(x,y,XI['X_TG'+j],-dx*2,-8+dy,0);tg(x+y*MAPS.world.w,add(x,y,XI['X_TG'+i],dx,dy-1,0))}
  else if(c==='l')add(x,y,XI.X_K_LANT,0,-1,1,1);else if(c==='o')add(x,y,XI[h<50?'X_K_LOG':'X_K_MUSH'],0,-1,0,1);else if(c==='b')add(x,y,XI[h<50?'X_K_FOX':'X_K_TANU'],0,-1,0,1);
  else if(c==='c')add(x,y,XI[h<50?'X_K_SAKE':'X_K_ACORN'],0,-1,0,1);else if(c==='S')add(x,y,XI.X_K_SIGN,0,-1,0,1)}};
 /* lucioles et feuilles qui tombent */
 ZFX[13]=(g,P,vis,tt,hh,ya,yb,X,Y)=>{lampGlow(g,13,tt,X,Y);for(let i=0;i<Math.round(hh/22);i++){const[px,py]=P(i+300,3,-2,9);if(!vis(px,py,4))continue;const k=.5+.5*Math.sin(tt*2.6+i*1.9);if(k<.25)continue;g.fillStyle=`rgba(200,255,140,${.55*k})`;g.fillRect(Math.round(px),Math.round(py),1,1);g.fillStyle=`rgba(160,255,120,${.16*k})`;g.fillRect(Math.round(px)-1,Math.round(py)-1,3,3)}
  for(let i=0;i<Math.round(hh/40);i++){const[px,py]=P(i+600,7,14,12);if(!vis(px,py,4))continue;g.fillStyle=i%3?'rgba(196,72,40,.85)':'rgba(220,170,60,.85)';g.fillRect(Math.round(px),Math.round(py),2,1+Math.round(Math.abs(Math.sin(tt*3+i))))}};
})();
(()=>{
 const J=(n,jp,fr,x)=>({n,jp,fr,x}),T_=(n,t)=>({n,t}),KG='影',KA='Kaito',TN=NPN.tanu,CK='Capitaine Kumo',MT='Madame Tanuki',DY='Doyenne des renards',YB='Yamabiko de fer',OPP=[1,0,3,2];
 Object.assign(PORT,{[MT]:'PX_mtanu',Pon:'PX_pon',[DY]:'PX_doyen','Messagère renarde':'PX_messa','Hôtesse renarde':'PX_messa',[YB]:'PX_gyama'});
 const H13=()=>HAMS.find(h=>h.z===13),T12=()=>{let y=0;while(y<MAPS.world.h&&MAPS.world.zone(y)!==12)y++;return y};const T13=()=>{let y=0;while(y<MAPS.world.h&&MAPS.world.zone(y)!==13)y++;return y};
 {const h=H13();if(h){NPCS.world.push({id:'capi13',spr:'capi',x:19,y:h.y0+13,ev:'capi13',dir:0});
  NPCS.world.push({id:'pon13',spr:'pon',x:6,y:h.y0+14,ev:'say',wander:2,nm:'Pon',jp:['ぼく','は','ポン','です','。','七歳|ななさい','です','。'],fr:'Moi, c\'est Pon. J\'ai sept ans.',xx:'七歳 (ななさい) = sept ans · 〜歳 (さい) : pour dire son âge',t2:'Mon papa est revenu ! Il dit qu\'il a combattu des démons. Maman dit qu\'il a surtout dormi dans des trains. Je crois les deux.'})}}
 /* l'atterrissage forcé, à la fin du vol */
 async function crash(){const h=H13();W.load('world',h.px,h.py,0);W.H.cd=3;S.fl.crash13=1;save();
  await Cine.say('N_S11',["Des branches, des feuilles, un grand craquement… puis le silence. Le dirigeable pend entre deux arbres immenses, le ballon déchiré comme un drap.",
   T_(CK,"Atterrissage réussi ! … Enfin. Personne n'est mort. Chez nous, ça s'appelle un atterrissage réussi."),
   "Entre les fougères, des dizaines de petits yeux te regardent. Des tanuki. Des renards. Certains ont une feuille sur la tête.",
   J('Petit renard',['人間|にんげん','だ','！'],'Un humain !','人間 (にんげん) = être humain · だ : です en langage familier'),T_(KG,"Kaito. Ne bouge pas. Ils ne sont pas dangereux. Ils sont curieux. C'est pire.")]);
  await UI.fade(0,300);music(ZONES[13].mus);W.refreshZone();save()}
 /* les retrouvailles de Maître Tanuki */
 async function reunion(){S.fl.reun13=1;save();music(null);
  await Cine.say('N_S12',["Devant une maison ronde, sous les racines d'un arbre géant, Maître Tanuki s'arrête net.",
   J(MT,['あなた','！'],'Toi !','あなた : « toi », mais aussi « mon chéri » entre époux'),T_(MT,"Trois ans ! TROIS ANS ! « Je vais chercher du saké », il dit ! Le saké, il est où, le saké ?!"),
   T_(TN,"… J'ai fait un détour."),J(MT,['ばか','！','…','おかえり','。'],'Imbécile ! … Bon retour.','おかえり : « bienvenue à la maison », la réponse à ただいま'),
   "Le rouleau à pâtisserie retombe trois fois sur la tête du vieux tanuki. Puis elle le serre dans ses bras, si fort que sa feuille s'envole.",
   J('Pon',['お父さん|おとうさん','！'],'Papa !','お父さん (おとうさん) = papa'),T_(KG,"… Je ne sais pas pourquoi, mais j'ai les yeux qui piquent. Je n'ai pas d'yeux, Kaito."),T_(KA,"Moi non plus, je ne pleure pas.")]);
  music(ZONES[13].mus)}
 /* aller-retour en ballon de secours entre le port et la forêt */
 async function shuttle(up){music(null);await UI.fade(1,300);const R=Act3.flight(true);await UI.fade(0,250);sfx('door');await wait(5200);await UI.fade(1,300);R.end();Cine.hide();
  if(up){const h=H13();W.load('world',RX(h.y1-3)+9,h.y1-3,1)}else W.load('world',RX(T12()+4)+9,T12()+4,0);W.H.cd=3;await UI.fade(0,300);music(ZONES[up?13:12].mus);W.refreshZone();save();
  UI.toast(up?'Le ballon de secours du capitaine te dépose dans la forêt.':'Le ballon de secours te ramène au port.',2600)}
 {const o=STORY.triggers;STORY.triggers=(x,y)=>{if(W.map==='world'&&!S.fl.noscn){const z=W.zone(),h=H13(),t12=T12();
   if(h&&z===13&&S.fl.crash13&&!S.fl.reun13&&y>=h.y0+2&&y<=h.y1-8)return reunion;
   if(z===12&&y<=t12+1&&S.wins.nue){if(S.fl.crash13)return()=>shuttle(true);return async()=>{await D.say(T_(CK,"Hé ! On ne traverse pas les nuages à pied, petit. Viens me parler, je suis juste là, à côté de mon dirigeable. Je t'emmène."));await W.walk(W.H,0,.2);W.H.cd=4}}
   if(z===13&&h&&y>=t12-1)return()=>shuttle(false);
   if(z===13&&(window.NAC?NAC.isDoor(NAC.A,x,y):y<=T13()+1)&&S.wins.yamabiko)return S.fl.arr14&&Act3.hop14?()=>Act3.hop14(true):nacelle}
  return o(x,y)}}
 /* le capitaine : au port il propose la navette, dans la forêt il pleure son dirigeable */
 {const oC=STORY.capi;STORY.capi=async e=>{if(!S.fl.crash13)return oC(e);
   if(await D.ask(J(CK,['森|もり','へ','行きます|いきます','か','。'],'Tu vas à la forêt ?','森 (もり) = forêt'),[{jp:['はい'],fr:'Oui'},{jp:['いいえ'],fr:'Non'}])===0)return shuttle(true)}}
 STORY.capi13=async e=>{await D.say([T_(CK,pick(["Mon dirigeable… Regarde-le. Il a de la mousse. Il a des champignons. Un renard a fait son nid dans la cabine de pilotage.","La forgeronne m'a pris l'hélice pour faire un soufflet. Un soufflet ! C'était une hélice de compétition !","J'ai rafistolé un petit ballon de secours. Il tient deux personnes, ou un tanuki."]))]);
  if(await D.ask(J(CK,['港|みなと','へ','帰りたい|かえりたい','です','か','。'],'Tu veux retourner au port ?','帰りたい = vouloir rentrer (〜たい)'),[{jp:['はい'],fr:'Oui'},{jp:['いいえ'],fr:'Non'}])===0)return shuttle(false)};
 /* le gardien : le Yamabiko de fer */
 const PRE=["Au bout du sentier, devant le treuil de la nacelle, une montagne de mousse se lève. Un grand singe de fer, la tête hérissée de pavillons de gramophone.",
  J(KA,['すみません','。'],'Excusez-moi.'),J(YB,['すみま','…','せん','…','せん','…'],'Excusez… sez… sez…','Le yamabiko, dans les légendes, c\'est l\'écho des montagnes'),
  J(KA,['通して|とおして','ください','。'],'Laissez-moi passer.'),J(YB,['通して|とおして','…','ください','…','ださい','…','さい','…'],'Laissez… passer… sez… ssez…'),
  T_(KG,"Il répète tout. Mais regarde : chaque écho perd un morceau du mot. Tetsu lui a pris la fin de toutes les phrases."),T_(KG,"Alors on va lui en donner des entières. Bien construites. Jusqu'au bout.")];
 const POST=["Les pavillons se taisent un à un. Le cylindre dans son dos s'arrête de tourner.",J(YB,['ありがとう','ございました','。'],'Merci beaucoup.','La première phrase qu\'il prononce jusqu\'au bout'),
  T_(YB,"… Ma voix. J'ai entendu ma propre voix, en entier. Ça faisait cent ans que je n'entendais que les restes de celle des autres."),"Le grand singe se rassoit dans la mousse. Les oiseaux reviennent sur ses épaules."];
 {const oG=STORY.guard;STORY.guard=async(e,seen)=>{if(e.rov||e.id!=='yamabiko'||!Gates.meets('yamabiko'))return oG(e,seen);const H=W.H;W.faceTo(e,H);
  if(!S.fl.gp_yama){S.fl.gp_yama=1;await D.say(PRE)}else await D.say(J(YB,['ヤッホー','…','ホー','…'],'Yahoo… hoo…'));
  const r=S.fl.visit?(await D.say('(Mode visite : le Yamabiko te laisse passer sans combat.)'),'win'):await Battle.start(EN.yamabiko,{zone:13});
  if(r!=='win'){delete S.wins.yamabiko;if(r==='lose')await D.say('Tu reprends tes esprits… Tes PV sont restaurés. L\'écho a gardé la fin de ta phrase. Révise et reviens la lui reprendre.');else{await W.walk(H,OPP[H.dir],.2);H.cd=6}save();return}
  S.wins.yamabiko=1;W.remove(e);save();await D.say(POST);sfx('door');
  const d=W.spawn({npc:1,spr:'doyen',x:H.x,y:H.y+4,dir:1,ev:'say'});await W.emote(d);try{await W.walkNear(d,H)}catch(x){}W.faceTo(H,d);W.faceTo(d,H);
  await D.say([T_(DY,"Le treuil est libre. Les renards gardent cette nacelle depuis que le dieu dort. Personne ne l'a prise depuis cent ans."),J(DY,['乗りたい|のりたい','です','か','。'],'Tu veux monter ?','乗りたい = vouloir monter (〜たい)'),T_(DY,"Évidemment que tu veux. Tu as la tête de ceux qui veulent aller plus loin. Le tanuki vient avec toi : il dit qu'il a promis. Sa femme dit qu'il a intérêt à revenir.")]);
  W.remove(d);if(await D.ask(J(DY,['今|いま','、','行きます|いきます','か','。'],'Tu y vas maintenant ?'),[{jp:['はい','、','行きます|いきます','。'],fr:'Oui, j\'y vais'},{jp:['まだ','です','。'],fr:'Pas encore'}])===0)await nacelle()}}
 /* la nacelle sur la chaîne, d'une île à l'autre */
 function ride(dur,back){const host=Cine.host(),bg=new Image();bg.src=IM.N_NAC;const cab=XI.X_NACELLE,BW=600,BH=448;
  const cv=document.createElement('canvas');cv.width=BW;cv.height=BH;cv.style.cssText='width:100%;image-rendering:pixelated;display:block';host.appendChild(cv);
  const g=cv.getContext('2d'),t0=performance.now(),ease=p=>p<.5?2*p*p:1-Math.pow(-2*p+2,2)/2;let stop=false;
