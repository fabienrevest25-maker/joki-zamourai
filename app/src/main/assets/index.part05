  if(o.face){R(3,6,10,4,o.face);R(5,7,2,2,sk);R(9,7,2,2,sk);R(7,9,2,1,OL)}
  R(5,7,2,3,OL);R(9,7,2,3,OL);P(5,7,'#ffffff');P(9,7,'#ffffff');P(6,9,sd(sk));P(10,9,sd(sk));
  P(4,9,'#d89888');P(11,9,'#c88878');R(7,10,2,1,'#a86050');
 }else if(dir===1){ELc(s,8,hy,5.5,5.4,lt(hr),3);R(4,6,8,1,sd(hr));R(9,4,3,6,sd(hr));R(6,9,4,1,sd(hr))}
 else{ELc(s,8,hy-.3,5.7,5.3,hr,3.6);EL(s,10.4,hy+1.4,3.3,4.2,hr);R(5,1,4,1,lt(hr));R(5,7,2,3,OL);P(5,7,'#fff');P(3,8,sk);P(4,9,'#d89888');R(4,10,2,1,'#a86050')}
