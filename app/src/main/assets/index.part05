 'world:39,3349':{t:['影|かげ','の','森|もり','。','しずか','に','！'],fr:'Forêt de Kage : silence !',x:'影 (かげ) = ombre · 森 (もり) = forêt'},
 'world:72,3152':{t:['鉄|てつ','の','砦|とりで','。','危ない|あぶない','！'],fr:'Avant-poste de Tetsu. Danger !',x:'鉄 (てつ) = fer · 危ない = dangereux'},
 'world:40,3409':{t:['竹|たけ','の','村|むら'],fr:'Hameau des bambous',x:'竹 (たけ) = bambou · 村 (むら) = village'},
 'world:68,3217':{t:['鉄|てつ','の','町|まち'],fr:'Quartier des ouvriers',x:'町 (まち) = ville, quartier'},
 'world:40,3053':{t:['煙|けむり','の','町|まち'],fr:'Quartier des fumées',x:'煙 (けむり) = fumée'},
 'world:12,2889':{t:['灰|はい','の','村|むら'],fr:'Hameau des cendres',x:'灰 (はい) = cendre'},
 'world:12,2809':{t:['峠|とうげ','の','茶屋|ちゃや'],fr:'Refuge du col',x:'峠 (とうげ) = col de montagne · 茶屋 (ちゃや) = maison de thé'},
 'world:40,2629':{t:['街道|かいどう','の','宿場|しゅくば'],fr:'Relais de la Grand-Route',x:'街道 (かいどう) = grand-route · 宿場 (しゅくば) = bourg-relais'},
 'world:68,2449':{t:['渡し場|わたしば','の','村|むら'],fr:'Bourg des passeurs',x:'渡し場 (わたしば) = embarcadère du bac'},
 'world:40,2269':{t:['黒鉄|くろがね','の','下町|したまち'],fr:'Ville basse de Kurogane',x:'下町 (したまち) = la ville basse, le quartier populaire'},
 'world:12,2089':{t:['学生|がくせい','の','町|まち'],fr:'Quartier des étudiants',x:'学生 (がくせい) = étudiant'},
 'world:40,1909':{t:['鉄|てつ','の','町|まち'],fr:'Cité ouvrière des Grandes Forges',x:'鉄 (てつ) = fer · 町 (まち) = ville, quartier'},
 'world:68,1729':{t:['空|そら','の','港|みなと'],fr:'Port des dirigeables',x:'空 (そら) = ciel · 港 (みなと) = port'},
 'world:40,1549':{t:['狐|きつね','と','狸|たぬき','の','村|むら'],fr:'Village caché des renards et des tanuki',x:'狐 (きつね) = renard · 狸 (たぬき) = tanuki'},
 'world:12,1369':{t:['時計|とけい','の','庭|にわ'],fr:'Jardins suspendus des horlogers',x:'時計 (とけい) = horloge · 庭 (にわ) = jardin'},
 'world:40,1179':{t:['四つ|よっつ','の','風|かぜ','の','辻|つじ'],fr:'Croisée des quatre vents',x:'風 (かぜ) = vent · 辻 (つじ) = carrefour'},
 'world:68,979':{t:['鉄|てつ','の','城|しろ'],fr:'Citadelle de Tetsu',x:'城 (しろ) = château, citadelle'},
 'world:68,786':{t:['浜辺|はまべ','の','村|むら'],fr:'Plage des naufragés',x:'浜辺 (はまべ) = plage, bord de mer · 村 (むら) = village'},
 'world:40,606':{t:['金|きん','の','都|みやこ'],fr:'Ville impériale dorée',x:'金 (きん) = or · 都 (みやこ) = capitale'},
 'world:11,2749':{t:['霧|きり','の','峠|とうげ','。','足元|あしもと','に','注意|ちゅうい','！'],fr:'Col des Brumes. Attention où tu marches !',x:'霧 (きり) = brume · 峠 (とうげ) = col · 足元 (あしもと) = à tes pieds'},
 'world:39,2569':{t:['黒鉄|くろがね','街道|かいどう','。','関所|せきしょ','は','北|きた','です','。'],fr:'Grand-route de Kurogane. Le poste de contrôle est au nord.',x:'街道 (かいどう) = grand-route · 関所 (せきしょ) = poste de contrôle'},
 'world:67,2389':{t:['大川|おおかわ','。','橋|はし','は','ありません','。','渡し船|わたしぶね','は','北|きた','です','。'],fr:'Le Grand Fleuve. Il n\'y a plus de pont. Le bac est au nord.',x:'橋 (はし) = pont · 渡し船 (わたしぶね) = bac'},
 'world:39,2209':{t:['運河|うんが','の','町|まち','。','上|うえ','の','町|まち','へ','は','電車|でんしゃ','で','。'],fr:'Le quartier des canaux. Pour la ville haute, prendre le funiculaire.',x:'運河 (うんが) = canal · 電車 (でんしゃ) = tramway, train'},
 'world:11,2029':{t:['印|いん','の','学院|がくいん','。','池|いけ','に','入らないで|はいらないで','ください','。'],fr:'Académie des sceaux. Prière de ne pas entrer dans les bassins.',x:'学院 (がくいん) = académie · 池 (いけ) = bassin, étang'},
 'world:39,1849':{t:['大|おお','工場|こうじょう','。','火|ひ','に','気|き','を','つけて','ください','。'],fr:'Les Grandes Forges. Attention au feu.',x:'工場 (こうじょう) = usine · 気をつけて = faites attention'},
 'world:67,1669':{t:['飛行船|ひこうせん','の','港|みなと','。','雲|くも','の','上|うえ','を','歩かないで|あるかないで','ください','。'],fr:'Port des dirigeables. Prière de ne pas marcher sur les nuages.',x:'飛行船 (ひこうせん) = dirigeable · 雲 (くも) = nuage'},
 'world:11,1309':{t:['今|いま','、','何時|なんじ','です','か','。','だれ','も','知りません|しりません','。'],fr:'Quelle heure est-il ? Personne ne le sait.',x:'今 (いま) = maintenant · 知りません (しりません) = ne pas savoir'},
 'world:67,919':{t:['名前|なまえ','を','忘れないで|わすれないで','ください','。'],fr:'N\'oubliez pas votre nom, s\'il vous plaît.',x:'名前 (なまえ) = nom · 忘れないで = n\'oubliez pas'},
 'world:39,1109':{t:['道|みち','は','どこ','です','か','。','北|きた','は','あちら','です','。'],fr:'Où est le chemin ? Le nord, c\'est par là.',x:'道 (みち) = chemin · 北 (きた) = nord · あちら = par là'},
 'world:39,546':{t:['火曜日|かようび','は','歩かなければ|あるかなければ','なりません','。'],fr:'Le mardi, il faut marcher. (Loi n° 4 012 de l\'Empereur.)',x:'〜なければなりません = il faut, on doit'},
 'world:67,726':{t:['海|うみ','に','入らないで|はいらないで','ください','。'],fr:'Prière de ne pas entrer dans la mer.',x:'海 (うみ) = mer · 入らないで = n\'entrez pas'},
 'world:39,1489':{t:['森|もり','の','中|なか','で','、','大きい|おおきい','声|こえ','を','出さないで|ださないで','ください','。'],fr:'Dans la forêt, ne parlez pas fort, s\'il vous plaît.',x:'声 (こえ) = voix · 出さないで = ne sortez pas (ici : n\'élevez pas la voix)'}};
