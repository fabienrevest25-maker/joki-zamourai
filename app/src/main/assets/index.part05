 /* décor animé des mini-jeux : l'image de fond, puis des morceaux de la même image qui bougent (voir tools/bganim.py) */
 {const st=document.createElement('style');st.textContent='#minibg{position:fixed;inset:0;z-index:59;overflow:hidden;background:#000;pointer-events:none;display:none}#minibg .bgc{position:absolute;left:50%;top:50%;width:max(100vw,calc(100vh*768/1376));aspect-ratio:768/1376;transform:translate(-50%,-50%)}#minibg .bgc>*{position:absolute;background-repeat:no-repeat;will-change:transform,opacity}#minibg .bgo{position:absolute;inset:0;background:linear-gradient(rgba(8,8,18,.36),rgba(8,8,18,.1) 30%,rgba(8,8,18,.16) 60%,rgba(8,8,18,.48))}#mini h3,#mini .sub{text-shadow:0 1px 2px #000,0 0 6px rgba(0,0,0,.85)}'+
  '@keyframes bgSk{0%,100%{transform:skewX(calc(var(--a)*-1deg))}50%{transform:skewX(calc(var(--a)*1deg))}}@keyframes bgSw{0%,100%{transform:rotate(calc(var(--a)*-1deg))}50%{transform:rotate(calc(var(--a)*1deg))}}@keyframes bgDr{0%,100%{transform:translateX(calc(var(--a)*-1%))}50%{transform:translateX(calc(var(--a)*1%))}}'+
  '@keyframes bgGl{0%,100%{opacity:0}50%{opacity:var(--a)}}@keyframes bgGf{0%,100%{opacity:0}12%{opacity:var(--a)}20%{opacity:.1}38%{opacity:var(--a)}55%{opacity:.25}70%{opacity:var(--a)}85%{opacity:.05}}@keyframes bgPl{0%{transform:translate(0,0) scale(.85);opacity:0}15%{opacity:var(--a)}55%{opacity:calc(var(--a)*.6)}100%{transform:translate(var(--x),-150%) scale(2.6,2.3);opacity:0}}@keyframes bgFl{0%,100%{filter:brightness(1)}20%{filter:brightness(.92)}35%{filter:brightness(1.05)}60%{filter:brightness(.95)}80%{filter:brightness(1.02)}}';document.head.appendChild(st)}
 const BGM={t:'linear-gradient(to bottom,transparent,#000 28%)',b:'linear-gradient(to top,transparent,#000 28%)',l:'linear-gradient(to right,transparent,#000 30%)',r:'linear-gradient(to left,transparent,#000 30%)',tb:'linear-gradient(to bottom,transparent,#000 22%,#000 78%,transparent)',lb:'linear-gradient(to right,transparent,#000 30%),linear-gradient(to top,transparent,#000 25%)',lt:'linear-gradient(to right,transparent,#000 30%),linear-gradient(to bottom,transparent,#000 25%)'};
 const bgLayer=(u,e)=>{const[x,y,w,h]=e.r,P=(v,t)=>(v/t*100).toFixed(3)+'%',an={sk:'bgSk',sw:'bgSw',dr:'bgDr',gl:e.fl?'bgGf':'bgGl',fl:'bgFl',pl:'bgPl'}[e.t];
  let st=`left:${P(x,768)};top:${P(y,1376)};width:${P(w,768)};height:${P(h,1376)};--a:${e.a||1};animation:${an} ${e.d||4}s ${e.t==='pl'?'linear':'ease-in-out'} ${e.de||0}s infinite;`;
  if(e.o)st+=`transform-origin:${e.o};`;if(e.t==='pl')st+=`transform-origin:50% 100%;--x:${e.x||20}%;opacity:0;`;if(e.op)st+=`opacity:${e.op};`;
  if(e.k)return IM[e.k]?`<img src="${IM[e.k]}" alt="" style="${st}">`:'';
  st+=`background-image:url(${u});background-size:${P(768,w)} ${P(1376,h)};background-position:${w>=768?'0%':P(x,768-w)} ${h>=1376?'0%':P(y,1376-h)};`;
  const m=e.mk?(IM[e.mk]?`url(${IM[e.mk]})`:''):BGM[e.f];if(e.mk&&!m)return'';
  if(m)st+=`-webkit-mask-image:${m};mask-image:${m};-webkit-mask-size:100% 100%;mask-size:100% 100%;${m.includes('),')?'-webkit-mask-composite:source-in;mask-composite:intersect;':''}`;
  if(e.t==='fl')st+='animation-timing-function:steps(1,end);';
  return `<div style="${st}"></div>`};
 const mbg=(d,k)=>{let L=document.getElementById('minibg');const u=IM['BG_'+k];
  if(!u){if(L)L.style.display='none';d.style.background='';return}
  if(!L){L=document.createElement('div');L.id='minibg';document.body.appendChild(L)}
  if(L.dataset.k!==k||!L.firstChild){L.dataset.k=k;const C=BGA[k]||[],fl=C.find(e=>e.t==='fl');L.innerHTML=`<div class="bgc"><div style="inset:0;width:100%;height:100%;background:url(${u}) 0 0/100% 100%;${fl?`animation:bgFl ${fl.d}s steps(1,end) infinite`:''}"></div>${C.filter(e=>e.t!=='fl').map(e=>bgLayer(u,e)).join('')}</div><div class="bgo"></div>`}
  L.style.display='block';d.style.background='transparent'};window.MINIBG=mbg;
 const mfC=(e,c)=>{if(!e)return;e.style.animation='';e.classList.remove(c);void e.offsetWidth;e.classList.add(c)};
 /* le tambour : un kana s'affiche sur la peau du tambour, il faut taper sa lecture avant la fin du roulement ; le petit kodama danse à côté */
 async function taiko(pool,td){const d=MiniUI.open();mbg(d,'TAIKO');let sc=0,combo=0,best=0;const N=12,rs=[...new Set(pool.map(readOf))],TK=['MG_TKK_0','MG_TKK_1','MG_TKK_0','MG_TKK_2'].map(k=>IM[k]).filter(Boolean),KF=TK.length===4?TK:['00','01','00','02'].map(f=>IM['C_kodama21_'+f]).filter(Boolean);
  for(let i=0;i<N;i++){const c=pickK(pool,td),r=readOf(c),o=shuf([r,...shuf(rs.filter(x=>x!==r)).slice(0,2)]),T=Math.max(1800,3400-i*120);
   d.innerHTML=`<h3>太鼓 · Le tambour des kana</h3><p class="sub">Tape la lecture avant que le tambour ne se taise. Note ${i+1} / ${N} · Combo ${combo}</p><div style="display:flex;align-items:flex-end;justify-content:center;gap:2px;margin:6px auto"><div class="mfD" style="position:relative;width:150px;height:150px;animation:mfBeat ${(T/4000).toFixed(2)}s infinite"><img src="${IM.X_B18_DRUM||''}" alt="" style="width:150px;height:150px;object-fit:contain;image-rendering:pixelated"><span class="pk mfPop" style="position:absolute;left:0;right:0;top:calc(43% - 28px);text-align:center;font-size:46px;color:#2a1a0a">${c}</span></div>${KF.length?`<img id="tkk" src="${KF[0]}" alt="" style="height:${TK.length===4?92:66}px;${TK.length===4?'':'image-rendering:pixelated;'}animation:mfBob ${TK.length===4?'.48s':'.4s'} infinite">`:''}</div><div class="bar"><i id="tkb" style="width:100%"></i></div><div class="row">${o.map((x,j)=>`<button class="tile" data-i="${j}" style="min-width:78px">${x}</button>`).join('')}</div>`;
   const bar=d.querySelector('#tkb'),dr=d.querySelector('.mfD'),kk=d.querySelector('#tkk'),t0=performance.now();let raf,fr=0;const kt=setInterval(()=>{if(kk)kk.src=KF[fr=(fr+1)%KF.length]},TK.length===4?240:180);
   const tick=()=>{const f=1-(performance.now()-t0)/T;if(bar){bar.style.width=Math.max(0,f*100)+'%';bar.style.background=f<.3?'#e86a4a':''}if(f>0)raf=requestAnimationFrame(tick)};tick();try{sfx('tap')}catch(e){}
   const b=await Promise.race([MiniUI.wait(d,'[data-i]'),wt(T).then(()=>null)]);cancelAnimationFrame(raf);clearInterval(kt);
   if(b&&o[+b.dataset.i]===r){sc++;combo++;best=Math.max(best,combo);sfx('hit');b.style.background='#7ad07a';mfC(dr,'mfHit');mfC(kk,'mfHop');if(kk&&TK.length===4)kk.src=TK[combo%2?1:3];mfB(d,'ドン！',0,0,dr,-72,34);if(combo>=3)mfB(d,'コンボ ×'+combo,'#8ef0ff',0,d.querySelector('.row'),0,120);await wt(260)}
   else{combo=0;sfx('wrong');mfC(dr,'mfShake');if(b)b.style.background='#e88a7a';mfB(d,'…','#c8d0e0',0,dr,-72,34);const sp=d.querySelector('.pk');if(sp)sp.innerHTML=`${c}<div style="font-size:18px">${r}</div>`;await wt(650)}
   await wt(160)}
  MiniUI.close();return{sc,n:N,ok:sc>=8,best}}
 /* la pêche : on entend un son, quatre poissons portent un kana, on attrape le bon (il saute hors de l'eau) */
 async function peche(pool,td){const d=MiniUI.open();mbg(d,'PECHE');let sc=0;const N=6;
  const spl=b=>{if(!IM.MG_SPL_0||!b.parentNode)return;const e=new Image();e.alt='';e.src=IM.MG_SPL_0;e.style.cssText=`position:absolute;z-index:3;pointer-events:none;object-fit:contain;object-position:50% 100%;width:${b.offsetWidth}px;height:${Math.round(b.offsetHeight*.95)}px;left:${b.offsetLeft}px;top:${Math.round(b.offsetTop)}px`;b.parentNode.appendChild(e);[1,2].forEach((f,n)=>setTimeout(()=>{e.src=IM['MG_SPL_'+f]},130*(n+1)));setTimeout(()=>e.remove(),420)};
  for(let i=0;i<N;i++){const c=pickK(pool,td),o=shuf([c,...like(c,pool).slice(0,3)]);
   d.innerHTML=`<h3>釣り · La pêche aux kana</h3><p class="sub">Écoute le son, puis attrape le poisson qui le porte. Prise ${i+1} / ${N} · ${sc} dans le seau</p><div class="big mfPop">${S.snd?'🔊':''} « ${readOf(c)} »</div>
    <div style="position:relative;overflow:hidden;background:linear-gradient(#2a6a92,#163a5a);border-radius:14px;padding:12px 6px;width:94%;display:grid;grid-template-columns:1fr 1fr;gap:10px">${o.map((x,j)=>`<button data-i="${j}" style="position:relative;z-index:1;background:none;border:0;padding:4px;animation:proswim ${2.2+j*.35}s ease-in-out infinite"><img src="${IM['X_FISH'+((j*3+i)%8)]||''}" alt="" style="width:100%;max-width:120px;image-rendering:pixelated;animation:mfFace ${2.2+j*.35}s step-end infinite"><span class="pk" style="position:absolute;left:50%;top:50%;transform:translate(-50%,-50%);width:44px;height:44px;line-height:44px;border-radius:50%;background:rgba(255,250,235,.92);border:2px solid #c8402a;font-size:28px;color:#2a1a0a">${x}</span></button>`).join('')}${[10,28,47,66,85].map((x,k)=>`<i class="mfBub" style="left:${x}%;animation-delay:${k*.65}s"></i>`).join('')}${IM.MG_UKI?`<img id="pcu" src="${IM.MG_UKI}" alt="" style="position:absolute;right:6%;top:2px;height:34px;z-index:2;transition:transform .25s;animation:mfBob 1.6s ease-in-out infinite">`:''}</div><div class="row"><button class="btn" data-s="1">Réécouter</button></div>`;
   await wt(250);try{say(c,.8)}catch(e){}let b;for(;;){b=await MiniUI.wait(d,'[data-i],[data-s]');if(b.dataset.s){try{say(c,.8)}catch(e){}continue}break}
   if(o[+b.dataset.i]===c){sc++;sfx('item');{const u=d.querySelector('#pcu');if(u){u.style.animation='none';u.style.transform='translateY(10px)'}}spl(b);mfC(b,'mfJump');mfB(d,'パシャ！','#bff4ff',0,b,0,10);await wt(450)}else{sfx('wrong');mfC(b,'mfAway');await wt(500)}await wt(200)}
  MiniUI.close();return{sc,n:N,ok:sc>=4}}
 /* la moisson : chaque kana va dans le panier de sa ligne (la gerbe s'envole dans le panier choisi) */
 async function moisson(pool,td){const d=MiniUI.open();mbg(d,'MOISSON');let sc=0;const N=10;
  let rows=[...new Set(pool.map(rowOf).filter(r=>r&&r.length>1))];const tr=td&&rowOf(td[0]);if(tr&&tr.length>1)rows=[tr].concat(shuf(rows.filter(r=>r!==tr)));else rows=shuf(rows);rows=rows.slice(0,3);
  if(rows.length<2){MiniUI.close();return{sc:N,n:N,ok:true}}
  const items=pool.filter(c=>rows.includes(rowOf(c)));const B=['X_FBASK','X_GBASK','X_CBASK'],fill=[0,0,0],GB=!!IM.MG_GERBE,PN=!!IM.MG_PAN_0,pan=j=>PN?IM['MG_PAN_'+(fill[j]>=3?2:fill[j]?1:0)]:IM[B[j]]||'',lab=(c,rv)=>GB?`<span style="display:block;font-size:44px;line-height:60px;width:64px;height:64px;border-radius:50%;background:rgba(255,250,235,.92);border:3px solid #b8862a;color:#2a1a0a">${c}</span>${rv?`<div style="font-size:15px;background:rgba(255,250,235,.95);border-radius:8px;padding:0 6px;margin-top:4px;color:#2a1a0a">${rv}</div>`:''}`:`${c}${rv?`<div style="font-size:16px">${rv}</div>`:''}`;
  for(let i=0;i<N;i++){const c=pick(items),T=7000;
   d.innerHTML=`<h3>稲刈り · La moisson des kana</h3><p class="sub">Range ce kana dans le panier de sa ligne. Gerbe ${i+1} / ${N} · ${sc} bien rangées</p><div class="big pk" style="${GB?`position:relative;width:132px;height:146px;margin:4px auto;display:flex;flex-direction:column;align-items:center;justify-content:center;background:url(${IM.MG_GERBE}) 50% 100%/contain no-repeat;`:'font-size:58px;'}transform-origin:50% 100%;animation:mfSway 2.2s ease-in-out infinite">${lab(c)}</div><div class="bar"><i id="msb" style="width:100%"></i></div>
    <div class="row">${rows.map((r,j)=>`<button data-i="${j}" style="background:#f6ecd0;border:3px solid #8a6a3a;border-radius:12px;padding:6px;min-width:92px;animation:mfBob ${(1.6+j*.25).toFixed(2)}s ease-in-out infinite"><img src="${pan(j)}" alt="" style="width:${PN?64:46}px;${PN?'':'image-rendering:pixelated;'}display:block;margin:auto"><span class="pk" style="font-size:15px;color:#3a2a10">${[...r].join(' ')}</span></button>`).join('')}</div>`;
   const bar=d.querySelector('#msb'),t0=performance.now();let raf;const tick=()=>{const f=1-(performance.now()-t0)/T;if(bar)bar.style.width=Math.max(0,f*100)+'%';if(f>0)raf=requestAnimationFrame(tick)};tick();
   const b=await Promise.race([MiniUI.wait(d,'[data-i]'),wt(T).then(()=>null)]);cancelAnimationFrame(raf);const k=d.querySelector('.big');
   if(b&&rows[+b.dataset.i]===rowOf(c)){sc++;sfx('item');if(k){const a=k.getBoundingClientRect(),q=b.getBoundingClientRect();k.style.animation='';k.style.setProperty('--dx',Math.round(q.x+q.width/2-a.x-a.width/2)+'px');k.style.setProperty('--dy',Math.round(q.y+q.height/2-a.y-a.height/2)+'px');k.style.animation='mfFly .45s ease-in forwards'}{const j=+b.dataset.i;fill[j]++;const bi=b.querySelector('img');if(bi&&PN)setTimeout(()=>{bi.src=pan(j)},380)}mfC(b,'mfHit');mfB(d,'+1','#9ef07a',0,b,0,-4);await wt(420)}
   else{sfx('wrong');mfC(k,'mfShake');if(b)mfC(b,'mfShake');if(k)k.innerHTML=lab(c,`${readOf(c)} → ${[...rowOf(c)].join(' ')}`);await wt(900)}await wt(150)}
  MiniUI.close();return{sc,n:N,ok:sc>=7}}
 /* les koinobori : un memory, kana et lecture (ou hiragana et katakana) ; les cartes se retournent, les paires brillent */
 async function koi(pool,td){const d=MiniUI.open();mbg(d,'KOI');const kat=pool.filter(c=>ROWS_K.some(r=>r.includes(c)));const useK=kat.length>=6;
  const base=shuf(useK?kat:pool.filter(c=>[...c].length===1));const sel=[];for(const c of(td?shuf(td.filter(x=>base.includes(x))).concat(base):base))if(!sel.includes(c)&&sel.length<6)sel.push(c);
  const cards=shuf(sel.flatMap((c,i)=>[{i,t:c},{i,t:useK?String.fromCharCode(c.charCodeAt(0)-96):readOf(c)}]));let open=[],done=new Set(),moves=0;const q=j=>d.querySelector(`[data-i="${j}"]`);const KO=[0,1,2,1].map(n=>IM['MG_KOI_'+n]);let kt=0;const kiv=IM.MG_KOI_0?setInterval(()=>{kt++;d.querySelectorAll('.kcb').forEach(e=>{e.src=KO[(kt+ +e.dataset.p)%4]})},230):0;
  const draw=(fl,gl)=>{d.innerHTML=`<h3>鯉のぼり · Les koinobori</h3><p class="sub">${useK?'Associe chaque katakana à son hiragana.':'Associe chaque kana à sa lecture.'} Coups : ${moves}</p><div style="display:grid;grid-template-columns:repeat(4,1fr);gap:8px;width:94%">${cards.map((c,j)=>{const up=open.includes(j)||done.has(c.i);return `<button data-i="${j}" style="height:74px;border-radius:10px;border:3px solid ${done.has(c.i)?'#58b058':'#c8402a'};background:${up?'#fff8e6':'#2a5a8a'};padding:0;overflow:hidden">${up?`<span class="pk" style="font-size:${[...c.t].length>1&&!/[ぁ-ヿ]/.test(c.t)?22:30}px;color:#2a1a0a">${c.t}</span>`:(IM.MG_KOI_0?`<img class="kcb" data-p="${j%4}" src="${KO[j%4]}" alt="" style="width:94%;height:100%;object-fit:contain;animation:mfBob ${(1.5+j%4*.3).toFixed(1)}s ease-in-out infinite">`:`<img src="${IM.X_AO_KOINOBORI0||''}" alt="" style="width:100%;height:100%;object-fit:contain;image-rendering:pixelated;transform-origin:15% 50%;animation:mfSway ${(1.8+j%4*.3).toFixed(1)}s ease-in-out infinite">`)}</button>`}).join('')}</div>`;if(fl!=null)mfC(q(fl),'mfFlip');(gl||[]).forEach(j=>mfC(q(j),'mfGlow'))};
  draw();while(done.size<sel.length){const b=await MiniUI.wait(d,'[data-i]');const j=+b.dataset.i;if(open.includes(j)||done.has(cards[j].i))continue;open.push(j);try{if(/[ぁ-ヿ]/.test(cards[j].t))say(cards[j].t,.8)}catch(e){}draw(j);
   if(open.length===2){moves++;const[a,c]=open;if(cards[a].i===cards[c].i){done.add(cards[a].i);sfx('item');open=[];draw(null,[a,c]);mfB(d,'おなじ！','#ffe27a',0,q(c),0,-6)}else{sfx('wrong');await wt(350);mfC(q(a),'mfShake');mfC(q(c),'mfShake');await wt(450);open=[];draw()}}}
  clearInterval(kiv);mfB(d,'やった！',0,'34%');await wt(800);MiniUI.close();return{sc:moves,n:sel.length,ok:true,moves}}
 /* le gué : quatre colonnes de trois pierres ; on traverse en marchant sur les kana demandés */
 const GX=41,GY=3525,GUE={on:false,cols:[],ans:[],prog:0,cb:null};
 function gueSet(pool,td){const ws=allW.filter(w=>[...w[0]].length===4&&[...w[0]].every(c=>pool.includes(c)));let seq,word=null;
  if(ws.length&&Math.random()<.7){const w=pick(ws);seq=[...w[0]];word=w}else{seq=[];for(let i=0;i<4;i++)seq.push(pickK(pool,td))}
  GUE.cols=seq.map(c=>{const o=shuf([c,...like(c,pool).slice(0,2)]);return o});GUE.ans=seq.map((c,i)=>GUE.cols[i].indexOf(c));GUE.seq=seq;GUE.word=word;GUE.prog=0;GUE.on=true;return{seq,word}}
 window.PROGUE=GUE;const onStone=(x,y)=>x>=GX&&x<GX+4&&y>=GY&&y<GY+3;
 /* la carte agrandie (seulement pendant le prologue) */
 const PROPS=[{k:'X_B18_DRUM',x:56,y:3530,w:24},{k:'X_FBASK',x:34,y:3534,w:15},{k:'X_GBASK',x:35,y:3534,w:13},{k:'X_CBASK',x:36,y:3534,w:15},{k:'X_AO_KOINOBORI0',x:73,y:3522,w:46},{k:'X_AO_KOINOBORI0',x:77,y:3521,w:46},{k:'X_AO_LANTERN0',x:25,y:3525,w:18},{k:'X_AO_LANTERN0',x:25,y:3528,w:18}];
 function buildFields(){const R=MAPS.world.rows;if(R.__pro)return;const G=[];for(let y=3515;y<=3539;y++)G.push(R[y].split(''));
  const set=(x,y,c)=>{if(y<3515||y>3539||x<0||x>83)return;G[y-3515][x]=c},rect=(a,b,c,d,ch)=>{for(let y=b;y<=d;y++)for(let x=a;x<=c;x++)set(x,y,ch)};
  rect(27,3516,80,3538,'.');rect(23,3515,83,3515,'T');rect(81,3515,83,3539,'T');rect(27,3539,83,3539,'T');rect(27,3516,28,3520,'T');rect(27,3531,28,3538,'T');
  rect(23,3526,80,3527,'_');rect(30,3518,79,3518,'_');rect(30,3535,79,3535,'_');rect(30,3518,30,3535,'_');rect(52,3518,52,3535,'_');rect(79,3518,79,3535,'_');rect(66,3528,66,3535,'_');
  for(const[a,b,c,d]of[[32,3520,39,3524],[32,3529,39,3533],[47,3520,50,3524],[47,3529,50,3533],[54,3520,59,3524],[60,3529,64,3533],[68,3529,77,3533],[32,3536,50,3538],[54,3536,77,3538],[32,3516,50,3517]])rect(a,b,c,d,'r');
  rect(41,3520,44,3533,'~');rect(62,3520,70,3524,'~');rect(GX,GY,GX+3,GY+2,'_');
  rect(54,3516,78,3517,'w');for(const[x,y]of[[45,3521],[46,3533],[71,3521],[53,3525],[40,3519],[60,3527+1],[31,3525]])set(x,y,',');
  for(let y=3515;y<=3539;y++)R[y]=G[y-3515].join('');R.__pro=1}
 const propAt=(x,y)=>PROPS.find(p=>p.x===x&&p.y===y);
 for(const k in GI){const g=GI[k];NPCS.world.push({id:'pro_'+g.id,spr:g.spr,x:g.p[0],y:g.p[1],ev:'pro',dir:0,wander:0,nm:g.who,cond:()=>!!window.PRO})}
 const oPS=window.PROSTART;window.PROSTART=async()=>{buildFields();return oPS()};
 {const oS=window.XSOLID;window.XSOLID=(m,x,y)=>(window.PRO&&m==='world'&&!!propAt(x,y))||(oS?oS(m,x,y):false)}
 {const oA=window.XARR;window.XARR=(m,x,y,run)=>{if(window.PRO&&m==='world'&&GUE.on){
   if(onStone(x,y)){const col=x-GX,row=y-GY;/* une pierre n'est jugée qu'au moment où l'on entre dans sa colonne : les colonnes déjà franchies servent à changer de rangée (sinon la traversée était impossible dès que deux bonnes pierres n'étaient pas alignées) */if(col<GUE.prog||(col===GUE.prog&&row===GUE.ans[col])){if(col===GUE.prog){GUE.prog++;sfx('tap')}return oA?oA(m,x,y,run):false}
    GUE.on=false;W.ev(async()=>{sfx('wrong');UI.toast('Plouf !',1200);await wt(350);W.load('world',GX-1,GY+1,3);G.busy=false;await D.say([T_(GI.gue.who,pick(["Plouf ! Ha ha ! Pardon. Ha ha. Pardon.","Les poissons te disent bonjour. Et adieu. Recommence.","C'était la pierre d'à côté. Elle est vexée. Les pierres ont de la mémoire."])),`(Le kana demandé : ${GUE.seq[col]} · ${readOf(GUE.seq[col])})`]);if(GUE.cb)await GUE.cb(false)});return true}
   if(x===GX+4&&GUE.prog>=4){GUE.on=false;W.ev(async()=>{sfx('item');if(GUE.cb)await GUE.cb(true)});return true}}
  return oA?oA(m,x,y,run):false}}
 {const oD=window.XDRAW;window.XDRAW=(m,L_,g,X,Y,VW,VH)=>{oD&&oD(m,L_,g,X,Y,VW,VH);if(!window.PRO||m!=='world')return;const T=16;
  for(const p of PROPS){const im=XI[p.k];if(!im||!im.width)continue;const px=p.x*T-X,py=p.y*T-Y;if(px<-60||px>VW+60||py<-80||py>VH+60)continue;const h=im.height*p.w/im.width;L_.push({y:(p.y+1)*T,f:()=>g.drawImage(im,Math.round(px+8-p.w/2),Math.round(py+15-h),p.w,Math.round(h))})}
  const st=XI.T_STONE;for(let i=0;i<4;i++)for(let j=0;j<3;j++){const px=(GX+i)*T-X,py=(GY+j)*T-Y;if(px<-20||px>VW+20||py<-20||py>VH+20)continue;
   if(st&&st.width)g.drawImage(st,px+1,py+1,14,14);if(GUE.on&&GUE.cols[i]){const c=GUE.cols[i][j],ok=i<GUE.prog&&j===GUE.ans[i];g.fillStyle=ok?'#c8901c':'#2a1a0a';g.font=`bold ${[...c].length>1?6:9}px ${FX}`;g.textAlign='center';g.textBaseline='middle';g.fillText(c,px+8,py+8.5);g.textAlign='left'}}}}
 /* parler à un maître d'épreuve : l'épreuve de la leçon, ou de l'entraînement libre */
 const RUN={taiko,peche,moisson,koi};window.PROMINI=RUN;
 /* ===== 影の稽古 · l'entraînement de Kage : des jeux sur ce que Kaito a déjà appris =====
    Remplace la discussion libre avec le démon, qui demande l'IA (absente de l'APK). Quand l'IA répond (pages en ligne),
    « Parler librement » reste proposé. Chaque jeu ne pioche que dans ce qui est acquis : kana, mots appris, phrases des leçons
    terminées, kanji brodés trouvés. */
 const KEIKO=window.KEIKO=(()=>{
  const cap=s=>s?s.charAt(0).toUpperCase()+s.slice(1):s,ST=()=>S.keiko||(S.keiko={b:{},n:0,kn:0});
  const kp=()=>{const k=known(),h=[...ROWS_H.join('')];return[...new Set(k.length>=40?k:h.concat(k))]};
  const words=()=>{try{return Vocab.known()}catch(e){return[]}};
  const PUN=/^[。、！？!?…「」『』（）()・]+$/;
  const sents=()=>{const o=[],seen=new Set();try{lessonsDone().forEach(L=>(L.cards||[]).forEach(c=>(c.ex||[]).forEach(e=>{if(!e||!e.t||!e.fr)return;const t=e.t.filter(x=>!PUN.test(x)),k=t.join('');if(t.some(x=>/[→⇒＝=\/〜~]/.test(x))||String(e.fr).trim().split(/\s+/).length<2)return;if(t.length>=3&&t.length<=8&&!seen.has(k)){seen.add(k);o.push({t,fr:e.fr})}})))}catch(e){}return o};
  const kjs=()=>(window.KHUNT||[]).filter(q=>S.kh&&S.kh[q.k]&&window.KMEMO&&KMEMO[q.k]);
  const PR=()=>window.ORALP||[];
  const mw=k=>{const M=KMEMO[k];return M?(M[1]||'').split('|'):['','','']};
  const loadMN=async k=>{if(!IM['MN_'+k]&&location.protocol!=='file:'&&!window.__MNT){window.__MNT=1;try{const r=await fetch('kmemo_img.txt');if(r.ok)Object.assign(IM,await r.json())}catch(e){}}};
  const box=(h,st)=>`<div style="font-size:17px;background:rgba(255,250,235,.95);color:#2a1a0a;border-radius:10px;padding:6px 10px;margin-top:8px;${st||''}">${h}</div>`;
  const timer=(d,id,T)=>{const bar=d.querySelector('#'+id),t0=performance.now();let raf;const tick=()=>{const f=1-(performance.now()-t0)/T;if(bar){bar.style.width=Math.max(0,f*100)+'%';bar.style.background=f<.3?'#e86a4a':''}if(f>0)raf=requestAnimationFrame(tick)};tick();return()=>cancelAnimationFrame(raf)};
  const KL={hi:["Tu t'ennuies ? Moi aussi. Alors on s'entraîne. Pas de bavardage : des exercices.","Je t'ai préparé des jeux. Ne me remercie pas, c'est surtout pour me distraire.","Choisis. Et ne prends pas le plus facile, je le verrai.","Les ombres n'ont pas de mémoire. Toi, si. Prouve-le.","On révise ce que tu sais déjà. Ce que tu ne sais pas, ce sera pour une autre vie."],
   good:["Pas mal. Je dirais même… non, « pas mal », c'est déjà beaucoup.","Tu progresses. C'est agaçant.","Bien. Je note. Dans ma tête. Qui est aussi la tienne.","Voilà qui mérite presque un compliment. Presque."],
   bad:["Hmm. On recommencera. J'ai l'éternité, toi tu as des révisions.","J'ai vu mieux. J'ai aussi vu pire. Surtout de ta part.","Ce n'est rien. Tu te souviendras de tes erreurs. Moi, en tout cas, oui.","On reprend quand tu veux. Les ombres sont patientes. Pas très, mais un peu."]};

  /* les koinobori avec d'autres paires : mot ↔ sens, kanji ↔ sens */
  async function koiP(P,sub){const d=MiniUI.open();mbg(d,'KOI');const cards=shuf(P.flatMap((p,i)=>[{i,h:p[0],s:p[2]},{i,h:p[1]}]));let open=[],done=new Set(),moves=0;const q=j=>d.querySelector(`[data-i="${j}"]`);
   const KO=[0,1,2,1].map(n=>IM['MG_KOI_'+n]);let kt=0;const kiv=IM.MG_KOI_0?setInterval(()=>{kt++;d.querySelectorAll('.kcb').forEach(e=>{e.src=KO[(kt+ +e.dataset.p)%4]})},230):0;
   const back=j=>IM.MG_KOI_0?`<img class="kcb" data-p="${j%4}" src="${KO[j%4]}" alt="" style="width:94%;height:100%;object-fit:contain">`:`<img src="${IM.X_AO_KOINOBORI0||''}" alt="" style="width:100%;height:100%;object-fit:contain;image-rendering:pixelated">`;
   const draw=(fl,gl)=>{d.innerHTML=`<h3>鯉のぼり · Les koinobori</h3><p class="sub">${sub} Coups : ${moves}</p><div style="display:grid;grid-template-columns:repeat(3,1fr);gap:8px;width:94%">${cards.map((c,j)=>{const up=open.includes(j)||done.has(c.i);return `<button data-i="${j}" style="height:72px;border-radius:10px;border:3px solid ${done.has(c.i)?'#58b058':'#c8402a'};background:${up?'#fff8e6':'#2a5a8a'};padding:2px;overflow:hidden;color:#2a1a0a;font-size:${/[a-zà-ÿ]/i.test(c.h.replace(/<[^>]*>/g,''))?14:26}px;line-height:1.15">${up?c.h:back(j)}</button>`}).join('')}</div>`;if(fl!=null)mfC(q(fl),'mfFlip');(gl||[]).forEach(j=>mfC(q(j),'mfGlow'))};
   draw();while(done.size<P.length){const b=await MiniUI.wait(d,'[data-i]');const j=+b.dataset.i;if(open.includes(j)||done.has(cards[j].i))continue;open.push(j);if(cards[j].s)try{say(cards[j].s,.85)}catch(e){}draw(j);
    if(open.length===2){moves++;const[a,c]=open;if(cards[a].i===cards[c].i){done.add(cards[a].i);sfx('item');open=[];draw(null,[a,c]);mfB(d,'おなじ！','#ffe27a',0,q(c),0,-6)}else{sfx('wrong');await wt(500);mfC(q(a),'mfShake');mfC(q(c),'mfShake');await wt(550);open=[];draw()}}}
   clearInterval(kiv);mfB(d,'やった！',0,'34%');await wt(800);MiniUI.close();return{sc:moves,n:P.length,ok:moves<=P.length*2+2,moves}}
  async function koiMix(){const m=['a'];if(words().length>=6)m.push('w');if(kjs().length>=6)m.push('k');const st=ST(),md=m[(st.kn=(st.kn||0)+1)%m.length];
   if(md==='a')return RUN.koi(kp(),null);
   if(md==='w'){const W=[];for(const w of shuf(words()))if(W.length<6&&!W.some(x=>x.fr===w.fr||x.key===w.key))W.push(w);return koiP(W.map(w=>[`<span class="jp">${jpHtml([w.t])}</span>`,esc(cap(w.fr)),w.kana]),'Associe chaque mot à son sens.')}
   const K=shuf(kjs()).slice(0,6);return koiP(K.map(q=>[`<span style="font-family:${FX};font-size:34px">${q.k}</span>`,esc(cap(mw(q.k)[2]||'')),mw(q.k)[1]]),'Associe chaque kanji à son sens.')}

  /* 市場 · le marché des mots : un client demande un objet (en français ou en japonais), on lui tend la bonne lanterne */
  async function marche(){const A=words(),W=shuf(A),N=Math.min(10,W.length),d=MiniUI.open();mbg(d,'MARCHE');let sc=0;
   const PX=['PX_girl','PX_jii','PX_kid','PX_fisher','PX_baa','PX_weaver','PX_eng','PX_forg'].filter(k=>IM[k]);
   for(let i=0;i<N;i++){const w=W[i],rev=i%3===2,o=shuf([w,...shuf(A.filter(x=>x.key!==w.key&&x.fr!==w.fr&&x.kana!==w.kana)).slice(0,3)]),T=Math.max(5500,9500-i*400),px=PX[i%Math.max(1,PX.length)];
    d.innerHTML=`<h3>市場 · Le marché des mots</h3><p class="sub">Client ${i+1} / ${N} · ${sc} ¥ gagnés</p>
     <div style="display:flex;align-items:center;gap:10px;justify-content:center;margin:6px 0"><img id="mkc" class="mfPop" src="${IM[px]||''}" alt="" style="width:76px;height:76px;object-fit:cover;border-radius:50%;border:3px solid #b8862a;image-rendering:pixelated;background:#f3e6c4"><div style="font-size:19px;background:#fff8e6;color:#2a1a0a;border-radius:12px;padding:8px 12px;max-width:62%">${rev?`<span class="jp" style="font-size:26px">${jpHtml([w.t])}</span> ?<div style="font-size:13px;opacity:.75">Qu'est-ce que c'est ?</div>`:`Comment dit-on…<br><b>« ${esc(w.fr)} »</b> ?`}</div></div>
     <div class="bar"><i id="mkb" style="width:100%"></i></div>
     <div style="display:grid;grid-template-columns:1fr 1fr;gap:10px;width:92%">${o.map((x,j)=>`<button data-i="${j}" style="min-height:64px;border-radius:14px 14px 24px 24px;border:3px solid #8a2a1a;background:radial-gradient(#fff3c8,#f2b84a);color:#2a1a0a;font-size:${rev?16:24}px;padding:6px">${rev?esc(cap(x.fr)):`<span class="jp">${jpHtml([x.t])}</span>`}</button>`).join('')}</div>`;
    if(rev)try{say(w.kana,.85)}catch(e){}
    const stop=timer(d,'mkb',T);const b=await Promise.race([MiniUI.wait(d,'[data-i]'),wt(T).then(()=>null)]);stop();
    const cu=d.querySelector('#mkc'),gi=o.indexOf(w),gb=d.querySelector(`[data-i="${gi}"]`),ok=!!b&&+b.dataset.i===gi;try{Vocab.mark(w,ok)}catch(e){}
    if(ok){sc++;sfx('item');b.style.background='#7ad07a';mfC(cu,'mfHop');mfB(d,'ありがとう！','#ffe27a',0,cu,0,-4);if(!rev)try{say(w.kana,.9)}catch(e){}await wt(800)}
    else{sfx('wrong');if(b)b.style.background='#e88a7a';if(gb)gb.style.outline='4px solid #7ad07a';mfC(cu,'mfAway');try{say(w.kana,.9)}catch(e){}await wt(1400)}}
   MiniUI.close();return{sc,n:N,ok:sc>=Math.ceil(N*.7)}}

  /* 文の橋 · le pont des phrases : remettre dans l'ordre les morceaux d'une phrase des leçons ; chaque phrase juste pose une planche */
  async function pont(){const A=shuf(sents()),N=Math.min(6,A.length),d=MiniUI.open();mbg(d,'PONT');let sc=0;
   for(let i=0;i<N;i++){const s=A[i],pool=shuf(s.t.map((t,j)=>({t,j})));let ans=[];if(pool.every((x,j)=>x.j===j))pool.push(pool.shift());
    const tile=(x,k,a)=>`<button data-${a}="${k}" class="tile" style="font-size:20px;padding:4px 8px;min-width:0"><span class="jp">${jpHtml([x.t])}</span></button>`;
    const draw=()=>{d.innerHTML=`<h3>文の橋 · Le pont des phrases</h3><p class="sub">Planche ${i+1} / ${N} · ${sc} posée${sc>1?'s':''}</p><div style="font-size:17px;background:#fff8e6;color:#2a1a0a;border-radius:12px;padding:8px 12px;width:88%">${esc(s.fr)}</div>
     <div id="pa" style="min-height:60px;width:92%;display:flex;flex-wrap:wrap;gap:6px;justify-content:center;align-items:center;border-bottom:4px solid #8a6a3a;padding:6px;margin-top:6px">${ans.map((x,k)=>tile(x,k,'a')).join('')||'<span style="opacity:.65">Touche les morceaux dans l\'ordre.</span>'}</div>
     <div style="display:flex;flex-wrap:wrap;gap:6px;justify-content:center;width:92%;margin-top:10px">${pool.map((x,k)=>tile(x,k,'p')).join('')}</div>
     <div class="row"><button class="btn" data-v="1" ${pool.length?'disabled style="opacity:.45"':''}>Poser la planche</button></div>`};
    draw();for(;;){const b=await MiniUI.wait(d,'[data-p],[data-a],[data-v]');
     if(b.dataset.p!=null){sfx('tap');ans.push(pool.splice(+b.dataset.p,1)[0]);draw();continue}
     if(b.dataset.a!=null){sfx('tap');pool.push(ans.splice(+b.dataset.a,1)[0]);draw();continue}
     if(b.dataset.v&&!pool.length)break}
    const ok=ans.map(x=>x.t).join('')===s.t.join(''),pa=d.querySelector('#pa');d.querySelector('[data-v]').remove();
    if(ok){sc++;sfx('item');mfC(pa,'mfGlow');mfB(d,'ぴったり！','#9ef07a',0,pa,0,-10)}else{sfx('wrong');mfC(pa,'mfShake')}
    pa.insertAdjacentHTML('afterend',box(`<span class="jp" style="font-size:20px">${jpHtml(s.t)}</span>${ok?'':'<div style="font-size:13px">← la phrase juste</div>'}`));
    try{say(jpKana(s.t),.85)}catch(e){}await wt(ok?1500:2800)}
   MiniUI.close();return{sc,n:N,ok:sc>=Math.ceil(N*.6)}}

  /* 漢字の影 · les ombres des kanji : l'image mnémotechnique sort de l'ombre peu à peu ; plus on la reconnaît tôt, plus on gagne */
  async function ombres(){const K=kjs(),N=Math.min(8,K.length),Q=shuf(K).slice(0,N),d=MiniUI.open();mbg(d,'OMBRES');let sc=0,pts=0;await loadMN(Q[0].k);
   const ALLK=Object.keys(KMEMO);
   for(let i=0;i<N;i++){const q=Q[i],im=IM['MN_'+q.k],rev=!im||i%3===2,wd=mw(q.k),T=7000,
     o=shuf([q.k,...shuf(K.map(x=>x.k).filter(x=>x!==q.k)).concat(shuf(ALLK.filter(x=>x!==q.k))).filter((x,j,a)=>a.indexOf(x)===j&&mw(x)[2]!==wd[2]).slice(0,3)]);
    d.innerHTML=`<h3>漢字の影 · Les ombres des kanji</h3><p class="sub">Ombre ${i+1} / ${N} · ${pts} point${pts>1?'s':''}</p>
     ${rev?`<div class="mfPop" style="font-size:96px;line-height:1.15;font-family:${FX};color:#fff8e6;text-shadow:0 0 12px #000">${q.k}</div><p class="sub">Que veut dire ce kanji ?</p>`
      :`<div style="width:190px;height:190px;margin:6px auto;border-radius:16px;overflow:hidden;background:#f3efe6"><img id="omb" src="${im}" alt="" style="width:100%;height:100%;object-fit:contain;filter:brightness(0);transition:filter ${T/1000}s linear"></div><p class="sub">Quel kanji sort de l'ombre ? Plus tu réponds tôt, plus tu gagnes.</p>`}
     <div style="display:grid;grid-template-columns:1fr 1fr;gap:10px;width:86%">${o.map((x,j)=>`<button data-i="${j}" class="tile" style="min-height:58px;${rev?'font-size:16px':'font-size:40px;font-family:'+FX}">${rev?esc(cap(mw(x)[2]||'')):x}</button>`).join('')}</div>`;
    const om=d.querySelector('#omb');if(om){void om.offsetWidth;om.style.filter='brightness(1)'}const t0=performance.now();
    const b=await MiniUI.wait(d,'[data-i]'),el=(performance.now()-t0)/T,gi=o.indexOf(q.k),ok=+b.dataset.i===gi,gb=d.querySelector(`[data-i="${gi}"]`);
    if(om){om.style.transition='filter .2s';om.style.filter='none'}
    if(ok){sc++;const p=rev?2:el<.35?3:el<.7?2:1;pts+=p;sfx('item');b.style.background='#7ad07a';mfB(d,'+'+p,'#ffe27a',0,b,0,-6)}else{sfx('wrong');b.style.background='#e88a7a';if(gb)gb.style.outline='4px solid #7ad07a'}
    d.insertAdjacentHTML('beforeend',box(`<b style="font-size:26px;font-family:${FX}">${q.k}</b> · <span class="jp">${esc(wd[0]||'')}</span>（${esc(wd[1]||'')}）= ${esc(wd[2]||'')}`));
    try{say(wd[1]||'',.85)}catch(e){}if(i+1<N)loadMN(Q[i+1].k);await wt(ok?1600:2600)}
   MiniUI.close();return{sc,n:N,ok:sc>=Math.ceil(N*.7),pts}}

  /* 影の声 · l'écho de Kage : Kage murmure un mot appris ; on choisit son sens (ou, pour les paires piégeuses, le mot entendu) */
  async function echo(){const d=MiniUI.open(),W=words(),P=PR(),N=8;mbg(d,'ECHO');let sc=0;
   for(let i=0;i<N;i++){const pair=P.length>=4&&(i%3===1||W.length<6);let sayT,ans,q,w=null;
    if(pair){const p=pick(P),a=Math.random()<.5?0:2;sayT=p[a];ans=p[a];
     q=shuf([[p[0],p[1]],[p[2],p[3]]]).map((x,j)=>`<button data-i="${j}" data-v="${esc(x[0])}" class="tile" style="min-height:70px"><span class="jp" style="font-size:24px">${esc(x[0])}</span><br><span style="font-size:13px">${esc(x[1])}</span></button>`).join('')}
    else{w=pick(W);sayT=w.kana;ans=w.kana;q=shuf([w,...shuf(W.filter(x=>x.key!==w.key&&x.fr!==w.fr&&x.kana!==w.kana)).slice(0,3)]).map((x,j)=>`<button data-i="${j}" data-v="${esc(x.kana)}" class="tile" style="min-height:58px;font-size:16px">${esc(cap(x.fr))}</button>`).join('')}
    d.innerHTML=`<h3>影の声 · L'écho de Kage</h3><p class="sub">Écho ${i+1} / ${N} · ${sc} compris</p><img id="ekg" src="${IM.K_F0||''}" alt="" style="width:110px;height:110px;object-fit:cover;object-position:50% 30%;border-radius:50%;border:3px solid #8a5ac8;animation:mfBob 1.2s ease-in-out infinite"><p class="sub">${pair?'Quel mot as-tu entendu ?':'Que veut dire ce que Kage murmure ?'}</p><div style="display:grid;grid-template-columns:1fr 1fr;gap:10px;width:90%">${q}</div><div class="row"><button class="btn" data-r="1">Réécouter</button></div>`;
    await wt(300);try{say(sayT,.8)}catch(e){}let b;for(;;){b=await MiniUI.wait(d,'[data-i],[data-r]');if(b.dataset.r){try{say(sayT,.7)}catch(e){}continue}break}
    const ok=b.dataset.v===ans,gb=[...d.querySelectorAll('[data-i]')].find(x=>x.dataset.v===ans);
    if(ok){sc++;sfx('item');b.style.background='#7ad07a';mfB(d,'聞こえた！','#d8c0ff',0,d.querySelector('#ekg'),0,-6)}else{sfx('wrong');b.style.background='#e88a7a';if(gb)gb.style.outline='4px solid #7ad07a'}
    if(w){try{Vocab.mark(w,ok)}catch(e){}d.insertAdjacentHTML('beforeend',box(`<span class="jp">${jpHtml([w.t])}</span> = ${esc(w.fr)}`))}
    await wt(ok?1200:2200)}
   MiniUI.close();return{sc,n:N,ok:sc>=6}}

  const GM=[
   {id:'taiko',jp:'太鼓',nm:'Le tambour des kana',what:'Lire les kana vite',ic:['X_B18_DRUM'],ok:()=>kp().length>=10,run:()=>RUN.taiko(kp(),null)},
   {id:'peche',jp:'釣り',nm:'La pêche aux sons',what:'Reconnaître un kana à l\'oreille',ic:['X_FISH2'],ok:()=>S.snd&&kp().length>=10,why:'Active le son dans les options.',run:()=>RUN.peche(kp(),null)},
   {id:'moisson',jp:'稲刈り',nm:'La moisson des lignes',what:'Ranger les kana par ligne',ic:['MG_PAN_2','X_GBASK'],ok:()=>kp().length>=10,run:()=>RUN.moisson(kp(),null)},
   {id:'koi',jp:'鯉のぼり',nm:'Les koinobori',what:'Retrouver les paires',ic:['MG_KOI_1','X_AO_KOINOBORI0'],ok:()=>true,run:koiMix},
   {id:'marche',jp:'市場',nm:'Le marché des mots',what:'Vocabulaire',ic:['X_IT_LANT'],ok:()=>words().length>=6,why:'Apprends d\'abord 6 mots (paquets de vocabulaire).',run:marche},
   {id:'pont',jp:'文の橋',nm:'Le pont des phrases',what:'Construire une phrase',gl:'橋',ok:()=>sents().length>=3,why:'Termine d\'abord une leçon de grammaire.',run:pont},
   {id:'ombres',jp:'漢字の影',nm:'Les ombres des kanji',what:'Reconnaître un kanji',gl:'影',ok:()=>kjs().length>=4,why:'Trouve d\'abord 4 kanji brodés sur les maisons.',run:ombres},
   {id:'echo',jp:'影の声',nm:'L\'écho de Kage',what:'Comprendre à l\'oral',ic:['K_F0'],ok:()=>S.snd&&(words().length>=6||PR().length>=4),why:'Active le son dans les options.',run:echo}];
  const icon=g=>{const k=(g.ic||[]).find(k=>IM[k]);return k?`<img src="${IM[k]}" alt="" style="width:50px;height:50px;object-fit:contain;flex:none;${k==='K_F0'?'border-radius:50%;object-fit:cover;object-position:50% 30%':''}">`:`<span style="width:50px;flex:none;text-align:center;font-size:38px;font-family:${FX};color:#e8d8ff">${g.gl||'影'}</span>`};
  const rec=(g,b)=>b==null?g.what:g.id==='koi'?`Record : ${b} coups`:`Record : ${b}`;
  async function loop(){let line=pick(KL.hi);for(;;){const d=MiniUI.open(),ai=typeof Chat!=='undefined'&&Chat.ai&&Chat.ai();mbg(d,'KEIKO');
    d.innerHTML=`<h3>影の稽古 · L'entraînement de Kage</h3><div style="display:flex;gap:10px;align-items:center;width:94%;margin:4px 0 8px"><img src="${IM.K_F0||''}" alt="" style="width:62px;height:62px;object-fit:cover;object-position:50% 30%;border-radius:50%;border:2px solid #8a5ac8;flex:none"><div style="font-size:14px;background:rgba(26,22,48,.9);color:#ece6ff;border-radius:10px;padding:8px 10px;text-align:left">${esc(line)}</div></div>
     <div style="display:grid;grid-template-columns:1fr 1fr;gap:8px;width:94%">${GM.map((g,j)=>{const on=g.ok();return `<button data-g="${j}" style="display:flex;gap:8px;align-items:center;text-align:left;padding:7px;border-radius:12px;border:2px solid ${on?'#8a5ac8':'#4a4458'};background:${on?'rgba(40,30,70,.94)':'rgba(30,28,40,.8)'};color:${on?'#f4eeff':'#9a94a8'};min-height:74px">${icon(g)}<span style="min-width:0"><b style="font-family:${FX};font-size:16px">${g.jp}</b><br><span style="font-size:13px">${g.nm}</span><br><span style="font-size:11px;opacity:.85">${on?rec(g,ST().b[g.id]):'🔒 '+(g.why||'Pas encore')}</span></span></button>`}).join('')}</div>
     <div class="row">${ai?'<button class="btn" data-c="1">Parler librement</button>':''}<button class="btn" data-q="1">Quitter</button></div>`;
    const b=await MiniUI.wait(d,'[data-g],[data-c],[data-q]');try{sfx('tap')}catch(e){}
    if(b.dataset.q)return null;if(b.dataset.c)return'chat';
    const g=GM[+b.dataset.g];if(!g.ok()){line=g.why||'Pas encore. Reviens plus tard.';continue}
    let r=null;try{r=await g.run()}catch(e){console.error(e);MiniUI.close()}
    if(!r){line=pick(KL.bad);continue}
    const st=ST(),v=g.id==='koi'?r.moves:r.pts!=null?r.pts:r.sc;if(v!=null&&(st.b[g.id]==null||(g.id==='koi'?v<st.b[g.id]:v>st.b[g.id])))st.b[g.id]=v;
    const xp=r.ok?3:1;S.xp+=xp;st.n=(st.n||0)+1;try{Quest.add('chat');Quest.add('dojo')}catch(e){}try{save()}catch(e){}
    line=pick(r.ok?KL.good:KL.bad)+` (+${xp} XP)`}}
  async function open(){if(G.busy||G.scene!=='world')return;try{au()}catch(e){}G.busy=true;try{music(IM.A_kage?'kage':'bamboo')}catch(e){}let r=null;
   try{r=await loop()}finally{MiniUI.close();G.busy=false;try{W.refreshZone()}catch(e){}try{save()}catch(e){}}
   if(r==='chat'&&typeof Chat!=='undefined')Chat.open()}
  return{open,GM,kp,words,sents,kjs}})();

 let play=async function(k,pool,td){if(window.PROTEST_OK)return{ok:true,sc:10,n:10,moves:6};if(k!=='gue')return RUN[k](pool,td);
  const{seq,word}=gueSet(pool,td);await D.say([T_(GI.gue.who,word?`Le mot du jour : « ${word[1]} ». Traverse en marchant sur ses kana, dans l'ordre, de gauche à droite.`:"Traverse en marchant sur ces sons, dans l'ordre, de gauche à droite :"),{n:GI.gue.who,t:seq.map(readOf).join(' · ')},"(Une pierre par colonne. Une mauvaise pierre, et c'est la baignade.)"]);
  const f=window.__PROFIN;GUE.cb=async ok=>{GUE.cb=null;await f({ok,sc:ok?1:0,n:1})};return{wait:1}}
 let station=async function(k){const g=GI[k],p=P(),l=L[p.l],st=l&&steps(l)[p.st];const lesson=st==='game'&&GAME_OF(p.l).k===k;
  if(k==='gue'&&GUE.on)return D.say(T_(g.who,"Tu es déjà en train de traverser. Les pierres t'attendent. Elles ne bougent pas, elles. Enfin, pas trop."));
  const kn=known();if(!lesson&&kn.length<5)return D.say(T_(g.who,{gue:"Mes pierres parlent en kana. Reviens quand le vieux tanuki t'en aura appris quelques-uns.",taiko:"Don ! …Don ? Reviens quand tu sauras lire un peu. Don.",peche:"Mes poissons ne mordent qu'aux lecteurs. Va d'abord à l'école.",moisson:"Le riz n'est pas encore mûr. Toi non plus. Reviens après ta leçon.",koi:"Mes koinobori attendent quelqu'un qui sait lire. Pas encore toi, mon garçon.",dictee:"Les messages arrivent en kana. Reviens quand tu sauras en lire quelques-uns, c'est urgent. Enfin, pas tant que ça.",panneaux:"Hé hé, mes panneaux sont écrits en kana. Va d'abord à l'école, sinon c'est trop facile de te piéger.",intrus:"Trouver l'intrus, ça demande de connaître la famille. Apprends d'abord quelques kana.",shiri:"Le shiritori demande beaucoup de kana. Reviens plus tard."}[k]));
  const intro={gue:"Le gué des kana ! Une pierre par colonne. Si tu te trompes, tu nages. Je compte les éclaboussures.",taiko:"Don ! Don ! Je frappe un kana, tu cries sa lecture. Plus vite, plus fort. Don !",peche:"Mes poissons ont chacun un kana sur le dos. J'appelle un son, tu attrapes le bon. Pas avec les mains, avec les yeux.",moisson:"Chaque gerbe porte un kana. Mets-la dans le panier de sa ligne. Le panier de gauche est le plus lourd : c'est là que je cache le goûter.",koi:"Retourne deux cartes, trouve les paires. Le vent souffle : ne traîne pas.",dictee:"Un message arrive ! J'entends le mot, mais les kana sont tout mélangés. Remets-les dans l'ordre, vite, vite.",panneaux:"Hé hé ! Tu veux jouer à cache-cache avec mes panneaux ? Je te préviens : je triche.",intrus:"Cinq kana, un intrus. Comme dans une famille de renards : il y en a toujours un qui n'est pas vraiment un renard.",shiri:"Shiritori. Le dernier kana devient le premier. Le mot en ん met fin à tout. Comme la sieste."}[k];
  const c=await D.ask({n:g.who,t:intro},[lesson?"C'est parti !":"S'entraîner",'Plus tard']);if(c!==0)return;
  const pool=lesson?[...new Set(known())]:kn,td=lesson?today():null;const fin=async r=>{UI.panel('pad');
  const best=(p.best=p.best||{});const sc=k==='koi'?-r.moves:r.sc;const rec=r.ok&&(best[k]==null||sc>best[k]);if(rec)best[k]=sc;save();
  if(r.none&&!lesson)return D.say(T_(g.who,"Pas encore assez de mots pour une partie. Reviens après d'autres leçons."));const res=k==='koi'?`Toutes les paires en ${r.moves} coups.`:(k==='gue'||k==='panneaux'||!r.n)?'':`${r.sc} sur ${r.n}.`;
  if(lesson&&r.ok){p.st++;save();sfx('item');return D.say([T_(g.who,G_PASS[k]),res?`(${res})`:'',{n:KA,t:"Épreuve réussie ! Maintenant, la page : "+NAMES[l.npc]+" l'attend."}].filter(Boolean))}
  if(lesson)return D.say([T_(g.who,"Presque ! Encore un essai, et ce sera la bonne."),res?`(${res})`:''].filter(Boolean));
  return D.say([T_(g.who,r.ok?G_PASS[k]:"Pas mal ! Reviens t'entraîner quand tu veux."),(res?res:'')+(rec?' Nouveau record !':'')].filter(Boolean))};
  window.__PROFIN=fin;const r=await play(k,pool,td);if(r&&r.wait)return;return fin(r)}
 const oSP=STORY.pro;STORY.pro=async e=>{const k=e.id.slice(4);const g=Object.keys(GI).find(q=>GI[q].id===k);if(g){W.faceTo&&W.faceTo(e,W.H);return station(g)}return oSP(e)};
 /* ===== quatre épreuves de plus : la dictée de Hato, les panneaux de Pon, l'intrus de Kon, le shiritori du moine Shiri ===== */
 Object.assign(GI,{dictee:{nm:'la dictée de la messagère',who:'Hato la messagère',id:'hato',spr:'messa',px:'PX_messa',p:[31,3528]},
  panneaux:{nm:'les panneaux de Pon',who:'Pon',id:'ponpon',spr:'pon',px:'PX_pon',p:[53,3528]},
  intrus:{nm:"l'intrus de Kon",who:'Petite Kon',id:'kon',spr:'kidg',px:'PX_kidg',p:[46,3519]},
  shiri:{nm:'le shiritori',who:'Moine Shiri',id:'shiri',spr:'bozu',px:'PX_bozu',p:[78,3534]}});
 for(const k of['dictee','panneaux','intrus','shiri']){const g=GI[k];if(IM[g.px])PORT[g.who]=g.px;NPCS.world.push({id:'pro_'+g.id,spr:g.spr,x:g.p[0],y:g.p[1],ev:'pro',dir:0,wander:0,nm:g.who,cond:()=>!!window.PRO})}
 G5.splice(0,G5.length,'gue','taiko','peche','dictee','moisson','panneaux','koi','intrus','shiri');
 Object.assign(G_TALK,{dictee:"Hato, la messagère du village, attend près de l'entrée des rizières. Elle reçoit des messages en morceaux : tu entends le mot, tu remets ses kana dans l'ordre. Elle dit que c'est urgent. Elle dit toujours que c'est urgent.",
  panneaux:"Le petit Pon, un tanuki farceur, a planté des panneaux partout dans les rizières, avec un kana sur chacun. Il va te demander des sons : trouve les bons panneaux. Il triche, évidemment. C'est un tanuki.",
  intrus:"La petite Kon joue au nord du ruisseau. Elle glisse un kana qui n'a rien à faire là au milieu des autres. Trouve l'intrus. Kon adore les intrus : à l'école, c'était toujours elle.",
  shiri:"Le moine Shiri médite à l'est, au bout des rizières. Il joue au shiritori : chaque mot commence par le dernier kana du mot d'avant. Et surtout, jamais de mot qui finit par ん. Sinon, c'est perdu."});
 Object.assign(G_PASS,{dictee:"Message reçu en entier ! Hato repart en courant. Dans la mauvaise direction, mais vite.",panneaux:"Tu as trouvé tous mes panneaux ! …Bon, j'en ai planté un dans le riz, tu ne l'as pas vu. Ça compte quand même.",intrus:"Tu as démasqué tous les intrus. Kon est vexée. Elle va se déguiser en kana, pour la prochaine fois.",shiri:"La chaîne ne s'est jamais rompue. Le moine Shiri ouvre un œil. C'est sa façon d'applaudir."});
 Object.assign(GI.gue,{});
 /* mots de tous les jours, en hiragana, pour la dictée et le shiritori */
 const KW=[['テレビ','télévision'],['バス','bus'],['ゴリラ','gorille'],['ラジオ','radio'],['オレンジ','orange'],['ジュース','jus de fruits'],['スプーン','cuillère'],['ナイフ','couteau'],['クッキー','biscuit'],['キウイ','kiwi'],['イルカ','dauphin'],['カメラ','appareil photo'],['ラーメン','ramen'],['メロン','melon'],['ノート','cahier'],['トマト','tomate'],['トイレ','toilettes'],['レモン','citron'],['ペン','stylo'],['パン','pain'],['ピアノ','piano'],['ホテル','hôtel'],['ケーキ','gâteau'],['チーズ','fromage'],['シャツ','chemise'],['アイス','glace'],['スキー','ski'],['ゲーム','jeu vidéo'],['コーヒー','café'],['タクシー','taxi'],['ミルク','lait'],['ベッド','lit'],['ドア','porte'],['アニメ','dessin animé'],['メモ','note, mémo'],['ネクタイ','cravate'],['イス','chaise'],['スイカ','pastèque'],['カレー','curry'],['レストラン','restaurant']];
 const SHW0=[['あめ','pluie'],['めがね','lunettes'],['ねこ','chat'],['こえ','voix'],['えき','gare'],['きつね','renard'],['ねずみ','souris'],['みみ','oreille'],['みず','eau'],['すいか','pastèque'],['かさ','parapluie'],['さる','singe'],['るす','absent de chez soi'],['すし','sushi'],['しま','île'],['まど','fenêtre'],['どうぐ','outil'],['ぐんて','gants de travail'],['てがみ','lettre'],['みち','chemin'],['ちず','carte'],['ずぼん','pantalon'],['とり','oiseau'],['りんご','pomme'],['ごはん','riz, repas'],['いぬ','chien'],['ぬいぐるみ','peluche'],['うみ','mer'],['くつ','chaussure'],['つくえ','bureau'],['えんぴつ','crayon'],['つき','lune'],['きく','écouter'],['くち','bouche'],['ちかてつ','métro'],['なつ','été'],['つる','grue (oiseau)'],['るり','bleu lapis'],['りす','écureuil'],['すずめ','moineau'],['かお','visage'],['おかし','gâteau, friandise'],['しお','sel'],['おにぎり','boulette de riz'],['りか','sciences'],['かめ','tortue'],['めだか','petit poisson de rizière'],['やま','montagne'],['まち','ville'],['ちち','père'],['たまご','œuf'],['ごみ','déchets'],['みかん','mandarine'],['はな','fleur, nez'],['なす','aubergine'],['いえ','maison'],['えほん','livre d\'images'],['あさ','matin'],['さかな','poisson'],['なまえ','nom'],['えいが','film'],['がっこう','école'],['うし','vache'],['しか','cerf'],['こども','enfant'],['もも','pêche (fruit)'],['もり','forêt'],['すき','aimer'],['きもの','kimono'],['のり','algue nori'],['ふね','bateau'],['ねつ','fièvre'],['つばめ','hirondelle'],['はし','baguettes, pont'],['しろ','blanc, château'],['ろうそく','bougie'],['くも','nuage, araignée'],['もち','mochi'],['ちょう','papillon'],['うさぎ','lapin'],['ぎんこう','banque'],['うた','chanson'],['たぬき','tanuki'],['きって','timbre'],['てんき','temps (météo)'],['きのこ','champignon'],['こま','toupie'],['まくら','oreiller'],['らいねん','l\'an prochain'],['かぜ','vent, rhume'],['ぜんぶ','tout'],['ぶた','cochon'],['たけ','bambou'],['けむり','fumée'],['りゅう','dragon'],['うどん','udon']];
 const SHW=SHW0.concat(KW,allW.filter(w=>!SHW0.some(x=>x[0]===w[0])&&!KW.some(x=>x[0]===w[0])));
 const h2=c=>c&&c.charCodeAt(0)>=0x30A1&&c.charCodeAt(0)<=0x30F6?String.fromCharCode(c.charCodeAt(0)-96):c;
 const last=w=>{let a=[...w];let c=a[a.length-1];if(c==='ー')c=a[a.length-2];c=h2(c);const sm={'ゃ':'や','ゅ':'ゆ','ょ':'よ','っ':'つ'};return sm[c]||c};
 const first=w=>h2([...w][0]);
 const canUse=(c,kn)=>kn.includes(c)||('ゃゅょっ'.includes(c)&&kn.includes('きゃ'))||('ャュョッ'.includes(c)&&kn.includes('キャ'))||(c==='ー'&&kn.includes('ケーキ'));
 const kanaOK=(w,kn)=>[...w].every(c=>kn.includes(c)||c==='ー'||(c==='っ'&&kn.includes('きっ'[1]))||'ゃゅょっ'.includes(c)&&kn.some(x=>x.includes(c)));
 /* la dictée : on entend un mot, on remet ses kana dans l'ordre (sans voix japonaise disponible, la lecture s'affiche) */
 const hear=()=>{try{return !!S.snd&&(window.AndroidTTS?(!AndroidTTS.ready||!!AndroidTTS.ready()):(TTS.ok&&!!TTS.voice))}catch(e){return false}};
 async function dictee(pool,td){const kn=pool,ws=shuf(SHW.filter(w=>[...w[0]].length>=2&&[...w[0]].length<=6&&[...w[0]].every(c=>canUse(c,kn))));const d=MiniUI.open();let sc=0;const N=Math.min(5,ws.length);
  if(N<2){MiniUI.close();return{sc:1,n:1,ok:true}}
  for(let i=0;i<N;i++){const w=ws[i],ch=[...w[0]],ex=shuf(like(pick(ch),kn).filter(c=>!ch.includes(c))).slice(0,3),tiles=shuf(ch.concat(ex));let got=[];
   const draw=()=>{d.innerHTML=`<h3>手紙 · La dictée de la messagère</h3><p class="sub">Écoute le mot et remets ses kana dans l'ordre. Message ${i+1} / ${N} · ${sc} bien reçus</p><div class="sub">« ${esc(w[1])} »${hear()?'':' · '+ch.map(readOf).join('-')}</div>
    <div class="big pk" style="min-height:58px;letter-spacing:6px;border-bottom:3px solid #c8901c;min-width:60%">${got.map(j=>tiles[j]).join('')||'＿'}</div>
    <div class="row">${tiles.map((c,j)=>`<button class="tile pk" data-i="${j}" style="font-size:26px;min-width:52px;${got.includes(j)?'opacity:.25':''}">${c}</button>`).join('')}</div><div class="row"><button class="btn" data-s="1">🔊 Réécouter</button><button class="btn" data-b="1">⌫ Effacer</button></div>`};
   draw();await wt(250);try{say(w[0],.8)}catch(e){}
   while(got.length<ch.length){const b=await MiniUI.wait(d,'[data-i],[data-s],[data-b]');if(b.dataset.s){try{say(w[0],.8)}catch(e){}continue}if(b.dataset.b){got.pop();draw();continue}const j=+b.dataset.i;if(got.includes(j))continue;got.push(j);sfx('tap');draw()}
   const ok=got.map(j=>tiles[j]).join('')===w[0];if(ok){sc++;sfx('item')}else{sfx('wrong');const k=d.querySelector('.big');if(k)k.innerHTML=`${w[0]}<div style="font-size:15px">${ch.map(readOf).join('-')}</div>`;await wt(1300)}await wt(250)}
  MiniUI.close();return{sc,n:N,ok:sc>=N-1}}
 /* l'intrus : quatre kana vont ensemble, un seul n'a rien à faire là */
 async function intrus(pool,td){const d=MiniUI.open();let sc=0;const N=8;const rowsH=ROWS_H.filter(r=>[...r].every(c=>pool.includes(c))),rowsK=ROWS_K.filter(r=>[...r].every(c=>pool.includes(c)));
  const kinds=[];if(rowsH.length+rowsK.length>=2)kinds.push('row');if(rowsH.length&&rowsK.length)kinds.push('script');if(rowsH.filter(r=>r.length===5).length>=4)kinds.push('vowel');if(!kinds.length){MiniUI.close();return{sc:N,n:N,ok:true}}
  for(let i=0;i<N;i++){const kd=pick(kinds);let grp,odd,why;
   if(kd==='row'){const R=shuf(rowsH.concat(rowsK));const a=R[0],b=R[1];grp=shuf([...a]).slice(0,4);odd=pick([...b]);why=`${odd} (${readOf(odd)}) n'est pas de la ligne ${[...a].join('')}.`}
   else if(kd==='script'){const k=Math.random()<.5;const r=pick(k?rowsK:rowsH),o=pick(k?rowsH:rowsK);grp=shuf([...r]).slice(0,4);odd=pick([...o]);why=`${odd} est un ${k?'hiragana':'katakana'}, les autres sont des ${k?'katakana':'hiragana'}.`}
   else{const v=Math.floor(Math.random()*5),R5=shuf(rowsH.filter(r=>r.length===5));grp=R5.slice(0,4).map(r=>r[v]);let w;do{w=Math.floor(Math.random()*5)}while(w===v);odd=R5[4%R5.length][w];if(grp.includes(odd))odd=R5[0][w];why=`${odd} (${readOf(odd)}) ne finit pas par le même son que les autres.`}
   const o=shuf(grp.concat([odd]));
   d.innerHTML=`<h3>仲間外れ · L'intrus de Kon</h3><p class="sub">Un de ces kana n'a rien à faire avec les autres. Lequel ? Manche ${i+1} / ${N} · ${sc} trouvés</p><div class="row" style="margin-top:18px">${o.map((c,j)=>`<button class="tile pk" data-i="${j}" style="font-size:34px;min-width:60px;height:66px">${c}</button>`).join('')}</div><div class="bar"><i id="itb" style="width:100%"></i></div>`;
   const T=9000,bar=d.querySelector('#itb'),t0=performance.now();let raf;const tick=()=>{const f=1-(performance.now()-t0)/T;if(bar)bar.style.width=Math.max(0,f*100)+'%';if(f>0)raf=requestAnimationFrame(tick)};tick();
   const b=await Promise.race([MiniUI.wait(d,'[data-i]'),wt(T).then(()=>null)]);cancelAnimationFrame(raf);
   if(b&&o[+b.dataset.i]===odd){sc++;sfx('item')}else{sfx('wrong');d.querySelector('.bar').outerHTML=`<p class="sub" style="color:#f0cf7a">${esc(why)}</p>`;await wt(1700)}await wt(200)}
  MiniUI.close();return{sc,n:N,ok:sc>=6}}
 /* le shiritori : le mot suivant commence par le dernier kana du précédent ; un mot en ん fait perdre */
 async function shiri(pool,td){const W_=SHW.filter(w=>[...w[0]].every(c=>canUse(c,pool)));const d=MiniUI.open();let sc=0;const N=6;
  const start=shuf(W_.filter(w=>last(w[0])!=='ん'&&W_.some(x=>first(x[0])===last(w[0])&&x[0]!==w[0])));if(!start.length){MiniUI.close();return{sc:0,n:0,ok:true,none:1}}
  let cur=start[0];const used=new Set([cur[0]]);
  for(let i=0;i<N;i++){const L0=last(cur[0]);const good=shuf(W_.filter(x=>first(x[0])===L0&&!used.has(x[0])&&last(x[0])!=='ん'&&W_.some(y=>first(y[0])===last(x[0])&&!used.has(y[0])&&y[0]!==x[0])));if(!good.length){if(i===0){MiniUI.close();return{sc:0,n:0,ok:true,none:1}}MiniUI.close();return{sc,n:i,ok:sc>=i-1}}
   const ok=good[0],trap=shuf(W_.filter(x=>first(x[0])===L0&&last(x[0])==='ん'&&!used.has(x[0])))[0],oth=shuf(W_.filter(x=>first(x[0])!==L0&&x!==ok&&x!==trap)).slice(0,trap?1:2);const o=shuf([ok].concat(trap?[trap]:[],oth));
   d.innerHTML=`<h3>しりとり · Le shiritori du moine</h3><p class="sub">Choisis le mot qui commence par le dernier kana. Jamais de mot en ん ! Maillon ${i+1} / ${N} · ${sc} réussis</p>
    <div class="big pk">${[...cur[0]].slice(0,-1).join('')}<span style="color:#e0703a">${[...cur[0]].slice(-1)[0]}</span></div><p class="sub">« ${esc(cur[1])} » · dernier kana : ${L0} (${readOf(L0)})</p>
    <div class="row">${o.map((x,j)=>`<button class="tile" data-i="${j}" style="min-width:120px;display:flex;flex-direction:column;align-items:center"><span class="pk" style="font-size:24px">${x[0]}</span><small style="font-size:11px;opacity:.75">${esc(x[1])}</small></button>`).join('')}</div>`;
   try{say(cur[0],.85)}catch(e){}const b=await MiniUI.wait(d,'[data-i]');const ch=o[+b.dataset.i];
   if(ch===ok){sc++;sfx('item');used.add(ok[0]);cur=ok}else{sfx('wrong');const msg=ch===trap?`${ch[0]} finit par ん : au shiritori, c'est perdu ! Il fallait ${ok[0]}.`:`${ch[0]} ne commence pas par ${L0}. Il fallait ${ok[0]}.`;d.querySelector('.row').outerHTML=`<p class="sub" style="color:#f0cf7a">${esc(msg)}</p>`;used.add(ok[0]);cur=ok;await wt(1800)}await wt(200)}
  MiniUI.close();return{sc,n:N,ok:sc>=N-1}}
 /* les panneaux de Pon : six panneaux dans les rizières, il faut aller lire les bons */
 const SIGNS=[[31,3519],[51,3521],[59,3528],[71,3525],[40,3534],[78,3519]],PON={on:false,k:[],want:[],got:0,cb:null};window.PROPON=PON;
 for(const[x,y]of SIGNS)PROPS.push({k:'X_SIGN0',x,y,w:16,sign:1});
 function ponSet(pool,td){const ks=[];const src=shuf(td?td.concat(shuf(pool)):pool.slice());for(const c of src)if(!ks.includes(c)&&ks.length<SIGNS.length)ks.push(c);while(ks.length<SIGNS.length)ks.push(pick(pool));PON.k=shuf(ks);PON.want=shuf(PON.k.slice()).slice(0,3);PON.got=0;PON.on=true}
 async function panneaux(pool,td){ponSet(pool,td);await D.say([T_(GI.panneaux.who,"Hé hé ! J'ai planté six panneaux dans les rizières. Trouve ceux qui se lisent :"),{n:GI.panneaux.who,t:PON.want.map(readOf).join(' · ')+' (dans cet ordre !)'},"(Va lire les panneaux : touche A devant un panneau.)"]);
  const f=window.__PROFIN;PON.cb=async ok=>{PON.cb=null;await f({ok,sc:3,n:3})};return{wait:1}}
 Object.assign(RUN,{dictee,intrus,shiri});
 {const oP=play;play=async(k,pool,td)=>{if(window.PROTEST_OK)return{ok:true,sc:10,n:10,moves:6};if(k==='panneaux')return panneaux(pool,td);return oP(k,pool,td)}}
 {const oD=window.XDRAW;window.XDRAW=(m,L_,g,X,Y,VW,VH)=>{oD&&oD(m,L_,g,X,Y,VW,VH);if(!window.PRO||m!=='world'||!PON.on)return;const T=16;
  SIGNS.forEach(([x,y],i)=>{const px=x*T-X,py=y*T-Y;if(px<-20||px>VW+20||py<-40||py>VH+20)return;const c=PON.k[i];L_.push({y:(y+1)*T+1,f:()=>{g.fillStyle='#2a1a0a';g.font=`bold ${[...c].length>1?6:9}px ${FX}`;g.textAlign='center';g.textBaseline='middle';g.fillText(c,px+8,py-2);g.textAlign='left'}})})}}
 {const oI=window.XINT;window.XINT=(m,x,y,p)=>{if(window.PRO&&m==='world'){const i=SIGNS.findIndex(s=>s[0]===x&&s[1]===y);if(i>=0)return p||(async()=>{
   if(!PON.on)return D.say("Un panneau de bois tout neuf, planté de travers. Pon est passé par là.");const c=PON.k[i],w=PON.want[PON.got];
   if(c===w){PON.got++;sfx('item');if(PON.got>=PON.want.length){PON.on=false;await D.say([`Le panneau dit : ${c} (${readOf(c)}). C'est le dernier !`]);if(PON.cb)await PON.cb(true)}else UI.toast(`${c} · ${readOf(c)} ✓ (${PON.got} / ${PON.want.length}) · suivant : « ${readOf(PON.want[PON.got])} »`,2600)}
   else{sfx('wrong');await D.say([`Le panneau dit : ${c} (${readOf(c)}).`,T_(GI.panneaux.who,pick(["Hé hé ! Raté ! Ce panneau-là, c'est un faux. Enfin, un vrai, mais pas le bon.","Pas celui-là ! Je l'ai planté exprès pour te piéger. Je suis un génie.","Nan ! Cherche encore. Les rizières sont grandes, et moi je suis petit."])),`(Tu cherches : « ${readOf(w)} ».)`])}})}return oI?oI(m,x,y,p):null}}
 {const oSt=station;station=async k=>{if(k==='panneaux'&&PON.on)return D.say(T_(GI.panneaux.who,`Tu cherches encore ! Le prochain son : « ${readOf(PON.want[PON.got])} ». Hé hé.`));
   if(k==='shiri'&&!window.PROTEST_OK){const kn=known();if(!SHW.some(w=>[...w[0]].every(c=>canUse(c,kn))&&last(w[0])!=='ん'&&SHW.some(x=>first(x[0])===last(w[0])&&[...x[0]].every(c=>canUse(c,kn)))))return D.say(T_(GI.shiri.who,"Le shiritori demande beaucoup de kana. Reviens quand tu en connaîtras davantage. La patience est une vertu. La mienne est infinie."))}
   return oSt(k)}}
 Object.assign(window,{PROSHW:SHW});

 /* en prologue, l'eau ne sert qu'à l'étang de Tante Unagi */
 {const oI=window.XINT;window.XINT=(m,x,y,p)=>{if(window.PRO&&m==='world'){const r=MAPS.world.rows[y];if(r&&r[x]==='~')return p||(()=>D.say(x>=62&&y<=3524?T_(GI.peche.who,"Hé ! C'est mon étang. Viens me voir, je te prête une canne."):"L'eau est fraîche. Un têtard te regarde d'un air de défi."));if(propAt(x,y)){const q=propAt(x,y);return p||(()=>D.say(q.k==='X_B18_DRUM'?"Un grand tambour de fête. Don-chan le garde jalousement.":/BASK/.test(q.k)?"Un panier de Mamie Mochi. Il sent le riz nouveau.":/KOINOBORI/.test(q.k)?"Un koinobori claque au vent. Monsieur Hirari les coud lui-même.":"Une lanterne de pierre marque l'entrée des grandes rizières."))}}return oI?oI(m,x,y,p):null}}

})();

/* ---------- combat : effets en images (sorts, coup de lame, impact) et poses de Kaito (repos, attaque, touché) ----------
   Les images viennent de planches dessinées (fond magenta découpé). Dans les pages en ligne, elles sont dans fx_img.txt,
   chargé au démarrage ; tant qu'elles manquent, le combat garde ses anciens effets. */
window.BFX=(()=>{
 // nom, alignement (b : posé au sol, c : centré), taille / hauteur de la cible, durée de chaque étape, vole depuis Kaito, cible (e ennemi, m Kaito)
 const FX={'火':['KA','b',1.05,[170,200,380,300],1],'水':['SUI','b',1.1,[200,230,400,300]],'木':['MOKU','b',.95,[200,240,380,280]],
  '土':['DOH','b',.8,[170,220,400,300]],'山':['YAMA','b',.95,[170,220,400,300]],'風':['FUU','c',.95,[180,200,360,280],1],
  '雷':['RAI','b',1.55,[200,140,340,260]],'人':['HITO','b',1.0,[180,220,400,320],0,'m'],slash:['ZAN','c',.95,[60,70,120,150]],hit:['HIT','c',.6,[50,60,110,150]],
  // attaques ennemies (sur Kaito) : 1 = part de l'ennemi et vole vers Kaito, dernier champ = image retournée (l'ennemi tire vers la gauche)
  eFLAM:['EFLAM','c',.85,[110,150,300,240],1,'m',1],eGIVR:['EGIVR','c',.95,[120,170,320,260],1,'m'],eVAG:['EVAG','b',1.0,[120,170,330,260],0,'m',1],
  eENCR:['EENCR','c',.95,[120,160,300,240],1,'m',1],eFOUD:['EFOUD','c',1.1,[110,140,320,240],0,'m'],eVENT:['EVENT','c',1.0,[130,170,320,240],1,'m'],
  eSON:['ESON','c',.9,[110,150,300,240],1,'m',1],ePAP:['EPAP','c',1.0,[120,170,320,260],1,'m'],eOR:['EOR','b',1.05,[120,160,320,260],0,'m'],
  eBOUE:['EBOUE','c',.9,[110,160,300,240],1,'m'],eGRIF:['EGRIF','c',.8,[90,120,260,200],0,'m',1],eCHOC:['ECHOC','b',.85,[110,150,300,240],0,'m'],
  // attaques génériques (planches B13-B27) : actives dès que leurs images sont là
  eONIB:['EONIB','c',.85,[110,150,300,240],1,'m'],eBRAI:['EBRAI','c',.9,[110,150,300,240],1,'m'],eVAPE:['EVAPE','c',.95,[110,160,300,240],1,'m',1],
  eJETO:['EJETO','b',1.05,[120,170,320,260],0,'m'],eBULL:['EBULL','c',.85,[110,160,300,240],1,'m'],eRONC:['ERONC','b',.95,[120,170,320,260],0,'m'],
  eFEUI:['EFEUI','c',.95,[110,150,300,240],1,'m'],eROCH:['EROCH','b',1.0,[110,160,320,260],0,'m'],ePICS:['EPICS','b',.95,[110,150,320,260],0,'m'],
  eECLA:['EECLA','b',1.2,[110,140,320,240],0,'m'],eLAME:['ELAME','c',.85,[100,130,280,220],1,'m'],eMORS:['EMORS','c',.75,[110,130,300,220],0,'m'],
  ePOIN:['EPOIN','c',.75,[90,120,280,200],0,'m'],eROUA:['EROUA','c',.95,[110,150,300,240],1,'m',1],eSUIE:['ESUIE','c',1.0,[120,170,320,260],1,'m']};
 const BIG={'火':1,'水':1,'土':1,'山':1,'雷':1,eFLAM:1,eVAG:1,eFOUD:1,eCHOC:1,eOR:1};
 const MH={farm:1.017,trav:1.013,appr:1.06,r4:1.033,r5:1.093,r6:1.033,r7:1.113}; // hauteur de l'image / hauteur du corps au repos
 {const st=document.createElement('style');st.textContent='#bscene .bfx{position:absolute;pointer-events:none;z-index:3;image-rendering:pixelated;transition:left .26s ease-in,top .26s ease-in,opacity .18s}#bscene.bfxS{animation:jzShake .3s}';document.head.appendChild(st)}
 if(location.protocol!=='file:'&&!IM.FX_KA_0){try{fetch('fx_img.txt').then(r=>r.ok?r.json():null).then(j=>{if(j)for(const k in j)if(!IM[k])IM[k]=j[k]}).catch(()=>{})}catch(e){}}
 const wt=ms=>new Promise(r=>setTimeout(r,ms));
 const has=k=>{const f=FX[k];return !!(f&&IM['FX_'+f[0]+'_0'])};
 const box=(sc,id)=>{const R=sc.getBoundingClientRect(),T=document.getElementById(id).getBoundingClientRect();return{x:T.left-R.left,y:T.top-R.top,w:T.width,h:T.height}};
 async function play(k,o){o=o||{};const f=FX[k];if(!f||!IM['FX_'+f[0]+'_0'])return false;const sc=document.getElementById('bscene');if(!sc||sc.classList.contains('hidden'))return false;
  const run=async()=>{const src=i=>IM['FX_'+f[0]+'_'+i],e=new Image();e.className='bfx';e.alt='';e.src=src(0);try{await e.decode()}catch(_){}
   const tg=(o.at||f[5]),T=box(sc,tg==='m'?'bsMe':'bsEn'),h=Math.max(40,T.h*f[2]*(o.s||1)),w=h*(e.naturalWidth||1)/(e.naturalHeight||1);
   const cx=T.x+T.w/2,top=f[1]==='c'?T.y+T.h*.5-h/2:T.y+T.h-h*.96;
   const put=(x,y)=>{e.style.left=Math.round(x-w/2)+'px';e.style.top=Math.round(y)+'px'};e.style.width=Math.round(w)+'px';e.style.height=Math.round(h)+'px';if(f[6])e.style.transform='scaleX(-1)';
   if(f[4]){const M=box(sc,tg==='m'?'bsEn':'bsMe');e.style.transition='none';if(tg==='m')put(M.x+M.w*.35,M.y+M.h*.45-h/2);else put(M.x+M.w*.6,M.y+M.h*.3-h/2);sc.appendChild(e);void e.offsetWidth;e.style.transition='';put(cx,top);await wt(270)}
   else{put(cx,top);sc.appendChild(e)}
   for(let i=0;i<(o.stop||4);i++){if(i)e.src=src(i);if(i===2&&BIG[k]){sc.classList.remove('bfxS');void sc.offsetWidth;sc.classList.add('bfxS')}await wt(f[3][i])}
   e.style.opacity='0';await wt(190);e.remove();sc.classList.remove('bfxS')};
  if(o.nowait){run();return true}await run();return true}
 const rk=()=>STG[stage(S.xp)],hero=p=>IM['BTP_'+rk()+'_'+p]||null;
 function fit(me){if(!me||!me.dataset.btp)return;me.style.height='';me.style.left='';const cs=getComputedStyle(me),h0=parseFloat(cs.height),l0=parseFloat(cs.left);if(!(h0>0))return;
  const old=XI['BT_'+rk()],asp=old&&old.width?old.width/old.height:.62,n=me.naturalWidth&&me.naturalHeight?me.naturalWidth/me.naturalHeight:asp,h=h0*(MH[rk()]||1),w=h*n;
  me.style.height=Math.round(h)+'px';me.style.left=Math.round(l0+h0*asp/2-w/2)+'px'}
 function setup(me){const u=hero(0);if(!me)return;if(u){me.dataset.btp=1;me.onload=()=>fit(me);me.src=u;if(me.complete)fit(me)}else{delete me.dataset.btp;me.style.height='';me.style.left=''}}
 function pose(p){const me=document.getElementById('bsMe'),u=hero(p);if(me&&u&&me.dataset.btp&&me.src!==u)me.src=u}
 // ---- répertoire d'attaques : chaque ennemi a 4 ou 5 attaques (sa signature, son élément, sa famille) ; il en tire une à chaque tour ----
 const NM={FLAM:'Souffle de flammes',GIVR:'Souffle glacé',VAG:'Raz-de-marée',ENCR:"Jet d'encre",FOUD:'Foudre rouge',VENT:'Bourrasque',SON:'Onde sonore',PAP:'Tempête de feuillets',
  OR:'Pluie de pièces',BOUE:'Giclée de boue',GRIF:'Coup de griffes',CHOC:'Charge',ONIB:'Feu follet',BRAI:'Gerbe de braises',VAPE:'Jet de vapeur',JETO:'Geyser',BULL:'Bulles',
  RONC:'Ronces',FEUI:'Feuilles tranchantes',ROCH:'Éboulement',PICS:'Pics de pierre',ECLA:'Éclair',LAME:'Lames de vent',MORS:'Morsure',POIN:'Coup puissant',ROUA:'Pluie de rouages',SUIE:'Nuage de suie'};
 // boss : choisis à la main pour coller à ce qu'ils sont (la première est leur attaque signature, celle qui porte leur nom d'attaque)
 const BOSSP={doro2:'BOUE CHOC ROCH ONIB PICS',chochin2:'FLAM ONIB BRAI VAPE CHOC',karakuri2:'CHOC ROUA VAPE ONIB',kamado2:'FLAM BRAI VAPE SUIE CHOC',boss:'CHOC GRIF VAPE BRAI FLAM',
  yuki:'GIVR VENT ONIB LAME',nuri2:'CHOC POIN ROCH PICS',umi2:'VAG JETO BULL VAPE CHOC',wanyudo3:'FLAM ONIB CHOC PAP BRAI',kyorin2:'ENCR PAP ONIB SON VENT',
  baku:'PAP VENT CHOC VAPE SUIE',baku2:'PAP FLAM BRAI CHOC SUIE',nue:'SON ECLA GRIF MORS VENT',yamabiko:'SON POIN CHOC ROCH RONC',ungai:'GRIF ROUA ONIB LAME SON',
  kaze:'VENT LAME FEUI POIN VAPE',tetsu:'ENCR LAME ROUA SUIE',tetsu2:'ENCR SUIE VENT LAME FOUD',ushioni:'GRIF VAG CHOC BULL VAPE',kinko:'OR PAP ROUA CHOC VAPE',
  daitengu:'VENT LAME FEUI ECLA CHOC',mukade:'GRIF MORS ROCH ROUA PICS',tetsuf:'FOUD ENCR LAME ROUA FLAM'};
 // yōkai : une signature quand elle va de soi, puis deux attaques de leur élément et deux de leur famille (bête, objet, esprit)
 const YSIG={suzuri:'ENCR',ashig:'ENCR',mushi:'ENCR',kamikiri:'PAP',noppera:'PAP',ittan:'PAP',byobu:'PAP',zeni:'OR',kanedama:'OR',soroban:'OR',jinda:'SON',karasu:'SON',
  tengu:'VENT',karasu4:'VENT',uneri:'VENT',kamai:'ONIB',nekomata:'GRIF',heikegani:'GRIF',itachi:'LAME',tsuru:'LAME',kasha:'FLAM',hitokage:'FLAM',kamado:'FLAM',oni:'GIVR',
  yukidama:'VAPE',tsuchi:'ECLA',ashigaru:'VAPE',rokuro:'VAPE',yuzaru:'VAPE',braise:'BRAI',ippon:'BRAI',hitodama:'ONIB',chochin:'ONIB',toro:'ONIB',okuri:'ONIB',mokumoku:'ONIB',
  smoke:'SUIE',nobusuma:'SUIE',kemuri:'SUIE',kabi:'SUIE',yoma:'SUIE',tayoma:'BOUE',kappa:'JETO',namazu:'BULL',akaname:'BULL',kawauso:'BULL',toad:'BULL',funa:'VAG',isonade:'VAG',
  raiju:'ECLA',kirin:'ECLA',abura:'BOUE',doro:'BOUE',jubokko:'RONC',kodama:'RONC',takenoko:'RONC',ishigumo:'PICS',yamaarashi:'PICS',koma:'ROCH',nurikabe:'CHOC',mikoshi:'CHOC',
  oboro:'CHOC',tsurube:'CHOC',sazae:'CHOC',beto:'VENT',ashi:'MORS',hone:'CHOC',gasha:'MORS',karakuri:'ROUA',tenome:'ROUA',okubi:'ROUA',zori:'RONC',hikyaku:'ROUA',sune:'FLAM',ashinaga:'POIN',jorogumo:'GRIF'};
 const BEAST='kamai itachi okuri nekomata kasha raiju kitsune koma tesso nobusuma yuzaru kawauso isonade heikegani kappa namazu tsuchi kemuri kirin yamaarashi ishigumo jorogumo oni toad tsuru karasu tengu sune beto ashi hitokage mushi kamikiri sazae gasha'.split(' ');
 const SPIRIT='yoma tayoma smoke braise hitodama funa hone noppera kabi uneri akaname mokumoku jubokko kodama rokuro ashinaga tenome ippon abura zori ittan chochin toro'.split(' ');
 const ELP={'火':'FLAM BRAI VAPE','水':'VAG JETO BULL GIVR','木':'RONC FEUI VENT','土':'BOUE ROCH PICS','山':'ROCH PICS CHOC','雷':'ECLA FOUD','風':'VENT LAME FEUI','人':'POIN CHOC'};
 const FAMP={beast:'GRIF MORS CHOC',object:'CHOC ROUA POIN',spirit:'ONIB SUIE SON'};
 const ok=n=>!!(FX['e'+n]&&IM['FX_E'+n+'_0']),hs=t=>{let h=7;for(const c of t)h=(h*31+c.charCodeAt(0))>>>0;return h};
 function pool(def){const K=def.kind,bt=K?(K.bt||K.s):(def.bt||def.id),id=String(def.wild&&!K?'yoma':bt).replace(/\d+$/,''),boss=!K&&!def.wild;let L=[],sig=null;
  if(boss&&BOSSP[bt]){L=BOSSP[bt].split(' ');sig=L[0]}
  else{sig=YSIG[id]||null;const h=hs(id),rot=(a,k)=>a.length?a.slice(k%a.length).concat(a.slice(0,k%a.length)):a,el=rot((ELP[def.res]||'').split(' ').filter(ok),h),
    fam=rot(FAMP[BEAST.includes(id)?'beast':SPIRIT.includes(id)?'spirit':'object'].split(' ').filter(ok),h>>3);L=[sig,...el.slice(0,2),...fam.slice(0,2)]}
  L=[...new Set(L.filter(n=>n&&ok(n)))];if(sig&&!ok(sig))sig=null;
  if(L.length<2)for(const n of['CHOC','GRIF','VENT'])if(ok(n)&&!L.includes(n))L.push(n);
  return{L:L.slice(0,boss||def.big?5:4),sig}}
 function pick(def,B){const P=pool(def);if(!P.L.length)return null;const last=B&&B.lastAv;let c=P.L.filter(n=>n!==last||P.L.length<2);
  let n=P.sig&&c.includes(P.sig)&&Math.random()<.38?P.sig:c[Math.floor(Math.random()*c.length)];if(B)B.lastAv=n;
  const sigName=n===P.sig&&!def.wild&&!def.kind&&def.atk;return{n,nm:sigName||NM[n]||def.atk}}
 // attaque d'un ennemi : son effet sur Kaito (parée : l'effet s'arrête net avant l'impact)
 async function enemy(def,ok_,av){if(!def)return false;const v=av||pick(def,null);if(!v)return false;const k='e'+v.n;if(!FX[k]||!IM['FX_E'+v.n+'_0'])return false;
  await play(k,ok_?{stop:2,s:.8}:{});return true}
 const fam=id=>{id=String(id||'').replace(/\d+$/,'');return BEAST.includes(id)?'beast':SPIRIT.includes(id)?'spirit':'object'};
return{has,play,setup,pose,fit,enemy,pick,pool,NM,fam}})();

/* ---------- combat : poses des boss (repos, attaque, touché), planches dessinées découpées (tools/cutboss.py) ----------
   Les 3 poses partagent un même canevas (pied et centre du corps au même endroit) ; l'image du boss est agrandie pour que
   le corps au repos garde la taille et la place de l'ancienne image. Sans poses pour un ennemi, rien ne change. */
/* ---------- ennemis vivants au repos : rien n'est dessiné, l'image du yōkai respire, flotte ou se dandine selon sa famille ----------
   bête : elle respire (le torse gonfle, les pieds restent au sol) · esprit : il flotte et ondule · objet (tsukumogami) : il se dandine
   boss : souffle lent et puissant · Kaito : respiration discrète. Les animations de coup, d'attaque, d'entrée et de K.O. gardent la main. */
/* ---------- intérieurs et donjons vivants : les lumières du décor (lanternes, braseros, cristaux, lampes rouges) vacillent ou pulsent ----------
   Rien n'est dessiné : chaque bande de décor est lue une fois, ses pixels les plus lumineux sont recopiés (cœur + halo flouté de ces mêmes pixels)
   et rejoués en mode additif. chaud : flamme qui vacille · froid (cristaux) : lente pulsation · rouge : battement lent. */
window.LITE=(()=>{
 const LS={};let cur=null;
 const kind=(r,g,b)=>{const L=(r+g+b)/3;if(r>=228&&b<=150&&r-b>=95&&r-g>=30&&L>=160)return 1;if(b>=195&&g>=165&&r<=160&&L>=150)return 2;if(r>=228&&g<=95&&b<=105)return 3;return 0};
 function strip(m,si,cv,y0){const W=cv.width,H=cv.height;if(!W||!H)return;const K=W/(MAPS[m].w*16);let d;try{d=cv.getContext('2d').getImageData(0,0,W,H).data}catch(e){return}
  const C=6,GW=Math.ceil(W/C),GH=Math.ceil(H/C),G=new Uint8Array(GW*GH),N=new Uint16Array(GW*GH);
  for(let y=0;y<H;y++)for(let x=0;x<W;x++){const i=(y*W+x)*4,k=kind(d[i],d[i+1],d[i+2]);if(k){const q=(y/C|0)*GW+(x/C|0);if(!G[q]||G[q]===k)G[q]=k;N[q]++}}
  const seen=new Uint8Array(GW*GH),out=[];
  for(let q0=0;q0<G.length;q0++){if(!G[q0]||seen[q0])continue;const k=G[q0],st=[q0];seen[q0]=1;let x0=1e9,y0_=1e9,x1=-1,y1=-1,n=0,cells=0;
   while(st.length){const q=st.pop(),gx=q%GW,gy=q/GW|0;cells++;n+=N[q];if(gx<x0)x0=gx;if(gx>x1)x1=gx;if(gy<y0_)y0_=gy;if(gy>y1)y1=gy;
    for(let dy=-1;dy<=1;dy++)for(let dx=-1;dx<=1;dx++){const nx=gx+dx,ny=gy+dy;if(nx<0||ny<0||nx>=GW||ny>=GH)continue;const r=ny*GW+nx;if(!seen[r]&&G[r]===k){seen[r]=1;st.push(r)}}}
   const bw=(x1-x0+1)*C,bh=(y1-y0_+1)*C;if(n<6||bw>34*K||bh>34*K||cells>260)continue;out.push({k,x0:x0*C,y0:y0_*C,w:bw,h:bh})}
  const L=[];for(const o of out.slice(0,60)){const M_=Math.round(9*K),x=Math.max(0,o.x0-M_),y=Math.max(0,o.y0-M_),w=Math.min(W-x,o.w+2*M_),h=Math.min(H-y,o.h+2*M_);
   const c=document.createElement('canvas');c.width=w;c.height=h;const g=c.getContext('2d'),im=g.createImageData(w,h),a=im.data;
   for(let yy=0;yy<h;yy++)for(let xx=0;xx<w;xx++){const s=((y+yy)*W+x+xx)*4,t=(yy*w+xx)*4,r=d[s],gg=d[s+1],b=d[s+2];if(kind(r,gg,b)===o.k){a[t]=r;a[t+1]=gg;a[t+2]=b;a[t+3]=255}}
   g.putImageData(im,0,0);const c2=document.createElement('canvas');c2.width=w;c2.height=h;const g2=c2.getContext('2d');g2.filter=`blur(${Math.round(3.2*K)}px)`;g2.drawImage(c,0,0);g2.drawImage(c,0,0);g2.filter='none';g2.globalAlpha=.8;g2.drawImage(c,0,0);g2.globalAlpha=1;g2.globalCompositeOperation='destination-in';g2.translate(w/2,h/2);g2.scale(w/2,h/2);{const gr=g2.createRadialGradient(0,0,0,0,0,1);gr.addColorStop(0,'#fff');gr.addColorStop(.6,'#fff');gr.addColorStop(1,'rgba(255,255,255,0)');g2.fillStyle=gr;g2.fillRect(-1,-1,2,2)}
   L.push({k:o.k,x:x/K,y:y0+y/K,w:w/K,h:h/K,c:c2,ph:(x*.37+y*.71)%6.28})}
  LS[m+'_'+si]=L}
 const draw=(m,g,X,Y,VW,VH)=>{if(window.S&&S.fxoff)return;const t=performance.now()/1000;g.save();g.globalCompositeOperation='lighter';
  for(const kk in LS){if(!kk.startsWith(m+'_'))continue;for(const o of LS[kk]){const px=o.x-X,py=o.y-Y;if(px>VW||py>VH||px+o.w<0||py+o.h<0)continue;
   const a=o.k===1?Math.max(0,.34+.2*Math.sin(t*5.1+o.ph)+.1*Math.sin(t*12.7+o.ph*2)+.06*Math.sin(t*23+o.ph)):o.k===2?.12+.3*(.5+.5*Math.sin(t*1.25+o.ph)):.1+.38*Math.pow(.5+.5*Math.sin(t*2.1+o.ph),2);
   if(a<=.01)continue;g.globalAlpha=Math.min(1,a);g.drawImage(o.c,px,py,o.w,o.h)}}g.restore()};
 const oD=window.XDRAW;window.XDRAW=(m,L,g,X,Y,VW,VH)=>{oD&&oD(m,L,g,X,Y,VW,VH);if(m!=='world')draw(m,g,X,Y,VW,VH)};
 return{strip,draw,get LS(){return LS}}})();
/* ---------- donjons : murs moins répétitifs ----------
   L'intérieur des murs (mine, racines) répétait la même tuile assombrie, d'où des bandes régulières. On compose une fois, par donjon,
   une grande texture de roche (6 × 6 cases) avec des morceaux de la partie haute de la tuile de mur elle-même (retournés, décalés, fondus),
   raccordée sur ses bords ; chaque case de mur en prend sa part. Les faces de mur ordinaires sont retournées une fois sur deux, au hasard.
   Les égouts (briques) gardent leur appareillage régulier. */
(()=>{
 const N=6,MC={},FL={},cellC={};
 const rnd=sd=>()=>{sd=(sd*1103515245+12345)>>>0;return(sd>>>8)/16777216};
 function macro(n,src){if(MC[n])return MC[n];const t=src.width,k=t/48,r0=Math.round((n===3?0:5)*k),r1=Math.round((n===3?27:33)*k),W=t*N,H=t*N;
  const c=document.createElement('canvas');c.width=W;c.height=H;const g=c.getContext('2d');g.imageSmoothingEnabled=false;const R=rnd(n*7919+13);
  /* rangées de hauteur et de décalage variables, morceaux de largeur variable retournés au hasard : plus aucune bande régulière */
  const seg=(sx,sy,sw,sh,dx,dy,f)=>{for(const ox of[-W,0,W])for(const oy of[-H,0,H]){const X=dx+ox,Y=dy+oy;if(X>=W||Y>=H||X+sw<=0||Y+sh<=0)continue;g.save();g.translate(X+(f?sw:0),Y);g.scale(f?-1:1,1);g.drawImage(src,sx,sy,sw,sh,0,0,sw,sh);g.restore()}};
  const rows=(a0,a1)=>{for(let y=0;y<H;){const sh=Math.min(Math.round((14*k+R()*(a1-a0-14*k))),a1-a0),sy=a0+Math.floor(R()*(a1-a0-sh+1));let x=-Math.floor(R()*t);
   while(x<W){const sw=Math.round(t*(.5+.5*R())),sx=Math.floor(R()*(t-sw+1));seg(sx,sy,sw,sh,x,y,R()<.5);x+=sw}y+=sh}};
  if(n!==3)rows(r0,r1);
  else{/* racines : la terre (bas de la tuile, assombrie) en fond, puis les racines seules (fond sombre retiré), semées dans tous les sens */
   rows(Math.round(29*k),t);g.fillStyle='rgba(0,0,0,.45)';g.fillRect(0,0,W,H);
   const RS=[];for(let q=0;q<5;q++){const sw=Math.round(t*(.55+.45*R())),sh=Math.round((r1-r0)*(.7+.3*R())),sx=Math.floor(R()*(t-sw+1)),sy=r0+Math.floor(R()*(r1-r0-sh+1)),rc=document.createElement('canvas');rc.width=sw;rc.height=sh;const rg=rc.getContext('2d');rg.drawImage(src,sx,sy,sw,sh,0,0,sw,sh);
    try{const id=rg.getImageData(0,0,sw,sh),d=id.data;for(let i=0;i<d.length;i+=4){const L=(d[i]+d[i+1]+d[i+2])/3;d[i+3]=L<22?0:L<30?140:255}rg.putImageData(id,0,0)}catch(_){}RS.push(rc)}
   const cnt=Math.round(N*N*2.2);for(let q=0;q<cnt;q++){const rc=RS[Math.floor(R()*RS.length)],x=Math.floor(R()*W),y=Math.floor(R()*H),rot=Math.floor(R()*4),f=R()<.5;
    for(const ox of[-W,0,W])for(const oy of[-H,0,H]){const X=x+ox,Y=y+oy,m=Math.max(rc.width,rc.height);if(X-m>W||Y-m>H||X+m<0||Y+m<0)continue;g.save();g.translate(X,Y);g.rotate(rot*Math.PI/2);g.scale(f?-1:1,1);g.drawImage(rc,-rc.width/2,-rc.height/2);g.restore()}}}
  /* lumière inégale à grande échelle (raccordée sur les bords) : des creux et des bosses dans la roche */
  try{const id=g.getImageData(0,0,W,H),d=id.data,P=Math.PI*2,a=R()*P,b=R()*P,e=R()*P;
   for(let y=0;y<H;y++)for(let x=0;x<W;x++){const u=x/W,v=y/H,m=.84+.11*Math.sin(P*2*u+a)*Math.sin(P*2*v+b)+.07*Math.sin(P*(3*u+2*v)+e)+.04*Math.sin(P*(5*v-u*1))
